{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Perawatan preventif</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0}\na{color:#1F2B4D}a:hover{color:#000}\nbutton:disabled{opacity:.55;cursor:not-allowed}\n\n/* tampilan desktop (layar lebar) */\n@media (min-width: 1000px){\n  header[data-hero]{padding-left:32px !important;padding-right:32px !important;padding-top:22px !important}\n  header[data-hero] > div, main{max-width:1180px !important}\n  main{padding-left:32px !important;padding-right:32px !important}\n  header[data-hero] img[alt=\"Rentalaja\"]{visibility:hidden}\n  header[data-hero] [data-scrollx]{overflow:visible !important;margin:0 !important;padding:0 !important;flex-wrap:wrap}\n  header[data-hero] [data-scrollx] > *{flex:1 1 150px !important;min-width:0 !important}\n  main [data-scrollx]{overflow:visible !important;scroll-snap-type:none !important;flex-wrap:wrap}\n  span[data-noprint]{display:none}\n  main > section:first-child [data-scrollx]{display:grid !important;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));margin:0 !important;padding:2px 0 6px !important}\n  main > section:first-child [data-scrollx] > button{width:auto !important;min-width:0 !important;max-width:none !important;flex:none !important}\n  main [role=\"tablist\"]{max-width:520px}\n}\n</style>\n</helmet>\n<div style=\"min-height: 100vh; box-sizing: border-box; background: #F4F6F9; color: #1F2B4D; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; flex-direction: column\">\n\n  <header data-hero=\"1\" style=\"background: linear-gradient(160deg, #1F2B4D 0%, #2E3F6B 100%); padding: 14px 16px 56px; color: #FFFFFF\">\n    <div style=\"max-width: 720px; margin: 0 auto; display: flex; flex-direction: column; gap: 10px\">\n      <div style=\"display: flex; justify-content: space-between; align-items: center\"><img src=\"logo.png\" alt=\"Rentalaja\" style=\"height: 26px; width: auto; background: #FFFFFF; border-radius: 8px; padding: 4px 8px; display: block\"><button type=\"button\" data-noprint=\"1\" onClick=\"{{cetak}}\" style=\"height: 32px; padding: 0 12px; border-radius: 16px; border: 0; background: #FFFFFF; color: #1F2B4D; font: 800 12px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">⎙ Cetak / PDF</button></div>\n      <div style=\"display: flex; align-items: center; gap: 14px\">\n        <div style=\"{{ring}}\"><div style=\"width: 74px; height: 74px; border-radius: 37px; background: #24335A; display: flex; flex-direction: column; align-items: center; justify-content: center\"><b style=\"font-size: 22px; line-height: 24px\">{{comp}}</b><span style=\"font-size: 10px; opacity: 0.85\">patuh jadwal</span></div></div>\n        <div style=\"flex: 1; min-width: 0\"><div style=\"font-size: 13px; opacity: 0.9\">Perawatan preventif · {{today}}</div><div style=\"font-size: 20px; font-weight: 800; line-height: 25px\">{{headline}}</div><div style=\"font-size: 12px; opacity: 0.85; margin-top: 2px\">{{sub}}</div></div>\n      </div>\n    </div>\n  </header>\n  <main style=\"width: 100%; max-width: 720px; margin: 0 auto; box-sizing: border-box; padding: 0 16px 16px; display: flex; flex-direction: column; gap: 12px\">\n    <section style=\"margin-top: -40px; position: relative; background: #FFFFFF; border-radius: 16px; box-shadow: 0 2px 10px rgba(31,43,77,0.05); padding: 14px; display: flex; flex-direction: column; gap: 10px; box-shadow: 0 8px 24px rgba(31,43,77,0.12)\">\n      <div style=\"display: flex; justify-content: space-between; align-items: center\"><b style=\"font-size: 16px\">Per kategori</b><span data-noprint=\"1\" style=\"font-size: 11px; color: #4A5468\">geser →</span></div>\n      <div data-scrollx=\"1\" style=\"display: flex; gap: 10px; overflow-x: auto; scroll-snap-type: x mandatory; margin: 0 -14px; padding: 2px 14px 6px\">\n        <sc-for list=\"{{cats}}\" as=\"c\"><button type=\"button\" onClick=\"{{c.pick}}\" style=\"{{c.style}}\">\n          <div style=\"display: flex; justify-content: space-between; align-items: baseline; gap: 6px\"><b style=\"font-size: 15px\">{{c.name}}</b><span style=\"font-size: 20px; font-weight: 800; color: {{c.color}}\">{{c.pct}}</span></div>\n          <div style=\"height: 6px; border-radius: 3px; background: #E2E6EC\"><div style=\"{{c.bar}}\"></div></div>\n          <div style=\"display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 4px; text-align: center\"><div><b style=\"font-size: 16px; color: #A12A1F\">{{c.over}}</b><div style=\"font-size: 10px; color: #4A5468\">lewat</div></div><div><b style=\"font-size: 16px; color: #8A4B00\">{{c.soon}}</b><div style=\"font-size: 10px; color: #4A5468\">7 hari lagi</div></div><div><b style=\"font-size: 16px; color: #077A70\">{{c.wo}}</b><div style=\"font-size: 10px; color: #4A5468\">dirawat</div></div></div>\n          <span style=\"font-size: 11px; line-height: 15px; color: #4A5468; text-align: left\">{{c.rule}}</span>\n        </button></sc-for>\n      </div>\n    </section>\n    <div role=\"tablist\" data-noprint=\"1\" style=\"background: #FFFFFF; border-radius: 14px; padding: 4px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 4px; box-shadow: 0 2px 10px rgba(31,43,77,0.05)\"><sc-for list=\"{{tabs}}\" as=\"t\"><button type=\"button\" role=\"tab\" aria-selected=\"{{t.on}}\" onClick=\"{{t.pick}}\" style=\"{{t.style}}\">{{t.label}}</button></sc-for></div>\n    <sc-if value=\"{{catSel}}\"><div style=\"display: flex; justify-content: space-between; align-items: center; font-size: 13px; padding: 0 4px\"><span>Kategori: <b>{{catSel}}</b></span><button type=\"button\" onClick=\"{{clearCat}}\" data-noprint=\"1\" style=\"border: 0; background: none; font: 800 12px 'Plus Jakarta Sans', sans-serif; color: #077A70; cursor: pointer\">Semua kategori ✕</button></div></sc-if>\n    <sc-for list=\"{{groups}}\" as=\"g\"><section style=\"background: #FFFFFF; border-radius: 16px; box-shadow: 0 2px 10px rgba(31,43,77,0.05); padding: 14px; display: flex; flex-direction: column; gap: 10px; border-left: 4px solid {{g.bar}}\">\n      <div style=\"display: flex; justify-content: space-between; align-items: flex-start; gap: 8px\"><div style=\"min-width: 0\"><b style=\"font-size: 15px\">{{g.title}}</b><div style=\"font-size: 12px; line-height: 16px; color: #4A5468\">{{g.sub}}</div></div><span style=\"{{g.chip}}\">{{g.mode}}</span></div>\n      <sc-for list=\"{{g.rows}}\" as=\"r\"><a href=\"{{r.href}}\" style=\"display: flex; justify-content: space-between; gap: 8px; font-size: 13px; padding: 6px 0; border-top: 1px solid #EEF0F3; text-decoration: none; color: #1F2B4D\"><span style=\"min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap\">{{r.name}}</span><b style=\"white-space: nowrap; color: {{r.c}}\">{{r.why}}</b></a></sc-for>\n      <sc-if value=\"{{g.more}}\"><span style=\"font-size: 12px; color: #4A5468\">{{g.more}}</span></sc-if>\n      <sc-if value=\"{{g.act}}\"><button type=\"button\" data-noprint=\"1\" onClick=\"{{g.act}}\" disabled=\"{{busy}}\" style=\"height: 42px; border-radius: 12px; border: 0; background: {{g.btnBg}}; color: #FFFFFF; font: 800 14px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">{{g.actLabel}}</button></sc-if>\n    </section></sc-for>\n    <sc-if value=\"{{empty}}\"><div style=\"background: #FFFFFF; border-radius: 16px; box-shadow: 0 2px 10px rgba(31,43,77,0.05); padding: 14px; display: flex; flex-direction: column; gap: 10px; text-align: center; font-size: 14px; color: #1E6B45; font-weight: 700\">{{empty}}</div></sc-if>\n    <div style=\"font-size: 12px; line-height: 17px; color: #4A5468; padding: 0 4px\">Aturan bertanda <b>Tegas</b>: unit yang lewat jadwal otomatis dikunci (tidak bisa disewa) setiap pagi dan dibuatkan work order. Aturan bisa diubah di Servis → Aturan perawatan.</div>\n  </main>\n</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{\"$preview\":{\"width\":390,\"height\":844}}'>\nclass Component extends DCLogic {\nstate = { tab: 'over', cat: null, d: null };\nasync componentDidMount() { await RA.staff(); await this.reload(); }\nasync reload() {\n  const [ru, un, wo] = await Promise.all([\n    RA.from('maintenance_rules').select('id,category_id,label,every_km,every_days,every_rentals,work,missed_action,is_active,categories(name)').eq('is_active', true).eq('on_every_return', false),\n    RA.from('units').select('id,code,asset_no,plate_or_serial,status,odometer_km,last_service_km,last_service_at,rentals_since_service,created_at,branch_id,branches(name),products!inner(name,category_id)').is('archived_at', null).not('status', 'in', '(inactive,draft)').limit(5000),\n    RA.from('work_orders').select('unit_id,status').in('status', ['queued', 'working', 'waiting_part', 'qc']).limit(2000)\n  ]);\n  if (!RA_ALIVE(this)) return;\n  this.setState({ d: { ru: ru.data || [], un: un.data || [], wo: new Set((wo.data || []).map(w => w.unit_id)) } });\n}\nasync schedule(rule) { const n = await RA.call('maintenance_schedule', { p_rule: rule.id }); RA.ok((n || 0) + ' unit dijadwalkan servis' + (rule.missed_action === 'block' ? ' & dikunci' : '')); await this.reload(); }\nrenderVals() {\nconst s = this.state, d = s.d, now = new Date();\nconst days = x => Math.floor((now - new Date(x)) / 864e5);\nconst R = [], cats = {};\nif (d) d.ru.forEach(m => { const cn = (m.categories || {}).name || 'Lainnya'; cats[cn] = cats[cn] || { units: new Set(), over: new Set(), soon: new Set(), wo: new Set(), rules: [] }; cats[cn].rules.push(m);\n  const us = d.un.filter(u => u.products.category_id === m.category_id); const over = [], soon = [];\n  us.forEach(u => { cats[cn].units.add(u.id); if (d.wo.has(u.id)) { cats[cn].wo.add(u.id); return; }\n    const kmU = m.every_km && u.odometer_km != null ? m.every_km - ((+u.odometer_km || 0) - (+u.last_service_km || 0)) : null;\n    const dL = m.every_days ? m.every_days - days(u.last_service_at || u.created_at) : null;\n    const rL = m.every_rentals ? m.every_rentals - (+u.rentals_since_service || 0) : null;\n    const why = [kmU != null ? (kmU <= 0 ? 'lewat ' + RA.num(-kmU) + ' km' : 'sisa ' + RA.num(kmU) + ' km') : null, dL != null ? (dL <= 0 ? 'lewat ' + (-dL) + ' hari' : 'sisa ' + dL + ' hari') : null, rL != null ? (rL <= 0 ? 'lewat ' + (-rL) + ' sewa' : 'sisa ' + rL + ' sewa') : null].filter(Boolean);\n    const isOver = (kmU != null && kmU <= 0) || (dL != null && dL <= 0) || (rL != null && rL <= 0);\n    const isSoon = !isOver && ((dL != null && dL <= 7) || (kmU != null && kmU <= 300) || (rL != null && rL <= 1));\n    const row = { u, why: why.join(' · '), score: Math.min(dL == null ? 999 : dL, kmU == null ? 999 : kmU / 50, rL == null ? 999 : rL * 3) };\n    if (isOver) { over.push(row); cats[cn].over.add(u.id); } else if (isSoon) { soon.push(row); cats[cn].soon.add(u.id); } });\n  R.push({ m, cn, over: over.sort((a, b) => a.score - b.score), soon: soon.sort((a, b) => a.score - b.score) }); });\nconst every = m => [m.every_km ? 'tiap ' + RA.num(m.every_km) + ' km' : '', m.every_days ? 'tiap ' + m.every_days + ' hari' : '', m.every_rentals ? 'tiap ' + m.every_rentals + ' sewa' : ''].filter(Boolean).join(' / ');\nconst tot = Object.values(cats).reduce((a, c) => a + c.units.size, 0), ov = Object.values(cats).reduce((a, c) => a + c.over.size, 0), sn = Object.values(cats).reduce((a, c) => a + c.soon.size, 0);\nconst cp = tot ? Math.round((1 - ov / tot) * 100) : null;\nconst col = x => x >= 95 ? '#1E6B45' : x >= 85 ? '#8A4B00' : '#A12A1F';\nconst tab = s.tab, cat = s.cat;\nconst uN = u => (u.products.name || 'Unit') + ' · ' + (u.plate_or_serial || u.asset_no || u.code) + ' · ' + ((u.branches || {}).name || '');\nconst groups = R.filter(g => !cat || g.cn === cat).map(g => { const rows = tab === 'over' ? g.over : tab === 'soon' ? g.soon : []; const tegas = g.m.missed_action === 'block';\n  if (tab !== 'rule' && !rows.length) return null;\n  return { title: g.cn + ' · ' + g.m.label, sub: every(g.m) + (g.m.work ? ' — ' + g.m.work : ''), mode: tegas ? '🔒 Tegas' : '🔔 Pengingat', chip: 'display: inline-flex; align-items: center; height: 24px; padding: 0 10px; border-radius: 12px; font-size: 12px; font-weight: 800; white-space: nowrap; flex-shrink: 0; ' + (tegas ? 'background: #FDECEA; color: #A12A1F' : 'background: #E8EEF8; color: #1F2B4D'),\n    bar: tab === 'over' ? '#E5534B' : tab === 'soon' ? '#F2C14E' : '#09BEAF',\n    rows: rows.slice(0, 8).map(r => ({ name: uN(r.u), why: r.why, c: tab === 'over' ? '#A12A1F' : '#8A4B00', href: 'AsetUnit.dc.html?id=' + r.u.id })),\n    more: rows.length > 8 ? '+' + (rows.length - 8) + ' unit lainnya' : tab === 'rule' ? g.over.length + ' lewat jadwal · ' + g.soon.length + ' dalam 7 hari' : '',\n    act: tab === 'over' && RA.can('mgmt.assets') ? this.act(() => this.schedule(g.m)) : null, actLabel: tegas ? '🔒 Kunci ' + rows.length + ' unit & buat work order' : 'Jadwalkan servis ' + rows.length + ' unit', btnBg: tegas ? '#A12A1F' : '#1F2B4D' }; }).filter(Boolean);\nconst tabS = on => 'height: 40px; border: 0; border-radius: 10px; background: ' + (on ? '#1F2B4D' : 'transparent') + '; color: ' + (on ? '#FFFFFF' : '#1F2B4D') + '; font: 800 13px \\'Plus Jakarta Sans\\', sans-serif; cursor: pointer';\nreturn {\n  today: RA.HARIL[now.getDay()] + ', ' + RA.date(now), comp: cp == null ? '—' : cp + '%', busy: !!s.busy, cetak: () => window.print(),\n  ring: 'width: 84px; height: 84px; border-radius: 42px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; background: conic-gradient(' + (cp == null || cp >= 95 ? '#09BEAF' : cp >= 85 ? '#F2C14E' : '#E5534B') + ' ' + (cp || 0) * 3.6 + 'deg, rgba(255,255,255,0.18) 0)',\n  headline: !d ? 'Memuat…' : ov ? ov + ' unit lewat jadwal perawatan' : 'Semua unit sesuai jadwal 👍', sub: d ? sn + ' unit jatuh tempo dalam 7 hari · ' + tot + ' unit dipantau' : '',\n  cats: Object.keys(cats).map(n => { const c = cats[n]; const pc = c.units.size ? Math.round((1 - c.over.size / c.units.size) * 100) : 100; return { name: n, pct: pc + '%', color: col(pc), over: String(c.over.size), soon: String(c.soon.size), wo: String(c.wo.size), v: pc,\n    bar: 'height: 6px; border-radius: 3px; width: ' + Math.max(3, pc) + '%; background: ' + (pc >= 95 ? '#1E9E6A' : pc >= 85 ? '#F2C14E' : '#E5534B'), rule: c.rules.map(m => (m.missed_action === 'block' ? '🔒 ' : '🔔 ') + m.label + ' ' + every(m)).join(' · '),\n    style: 'flex: 0 0 74%; max-width: 270px; scroll-snap-align: start; text-align: left; background: ' + (cat === n ? '#F3FBFA' : '#F6F7F9') + '; border: ' + (cat === n ? '2px solid #077A70' : '1px solid transparent') + '; border-radius: 14px; padding: 12px; display: flex; flex-direction: column; gap: 8px; cursor: pointer; font-family: inherit; color: #1F2B4D',\n    pick: () => this.setState({ cat: cat === n ? null : n }) }; }).sort((a, b) => a.v - b.v),\n  tabs: [['over', 'Lewat (' + ov + ')'], ['soon', '7 hari (' + sn + ')'], ['rule', 'Aturan']].map(([k, l]) => ({ label: l, on: tab === k ? 'true' : 'false', style: tabS(tab === k), pick: () => this.setState({ tab: k }) })),\n  catSel: cat || '', clearCat: () => this.setState({ cat: null }), groups,\n  empty: d && !groups.length ? (tab === 'over' ? '✓ Tidak ada unit yang lewat jadwal perawatan.' : '✓ Tidak ada yang jatuh tempo 7 hari ke depan.') : ''\n};\n}\n}\n</script>\n</body>\n</html>\n"}