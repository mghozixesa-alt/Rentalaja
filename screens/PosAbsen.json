{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Panel cabang · Absen dan target</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>summary::-webkit-details-marker{display:none}\nbody{margin:0}\na{color:#1F2B4D}a:hover{color:#000}\n</style>\n</helmet>\n<div style=\"min-height: 100vh; box-sizing: border-box; display: flex; flex-wrap: wrap; align-items: stretch; background: #F6F7F9; color: #1F2B4D; font-family: 'Plus Jakarta Sans', system-ui, sans-serif\">\n<aside style=\"flex: 1 1 232px; box-sizing: border-box; background: #FFFFFF; border-right: 1px solid #E6E8EC; padding: 20px 16px; display: flex; flex-direction: column; gap: 20px\">\n  <img src=\"logo.png\" alt=\"Rentalaja\" style=\"height: 28px; width: auto; align-self: flex-start; display: block\">\n  <sc-if value=\"{{nav.multi}}\"><label style=\"display: flex; flex-direction: column; gap: 4px; font-size: 12px; font-weight: 700; color: #4A5468\">Cabang\n    <select aria-label=\"Pilih cabang\" onChange=\"{{nav.pickBranch}}\" style=\"height: 44px; border: 1px solid #D5D9E0; border-radius: 10px; padding: 0 10px; font: 700 14px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; background: #FFFFFF\">\n      <sc-for list=\"{{nav.branches}}\" as=\"b\"><option value=\"{{b.id}}\" selected=\"{{b.on}}\">{{b.name}}</option></sc-for>\n    </select>\n  </label></sc-if>\n  <sc-if value=\"{{nav.multi}}\" not><div style=\"display: flex; flex-direction: column; gap: 4px; font-size: 12px; font-weight: 700; color: #4A5468\">Cabang<div style=\"height: 44px; display: flex; align-items: center; font: 700 14px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D\">{{nav.branchName}}</div></div></sc-if>\n  <nav aria-label=\"Menu\" style=\"display: flex; flex-direction: column; gap: 14px\"><sc-if value=\"{{nav.gTransaksi}}\"><div role=\"group\" aria-label=\"Transaksi\" style=\"display: flex; flex-direction: column; gap: 2px\"><div style=\"font-size: 11px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #8A93A6; padding: 0 12px 2px\">Transaksi</div><sc-if value=\"{{nav.cPosHariIni}}\"><a href=\"PosHariIni.dc.html\" style=\"min-height: 40px; box-sizing: border-box; padding: 0 12px; border-radius: 10px; background: transparent; color: #1F2B4D; font: 600 14px 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; align-items: center; gap: 10px; text-decoration: none\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4A5468\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"4\" y=\"5\" width=\"16\" height=\"15\" rx=\"2\"/><path d=\"M8 3v4M16 3v4M4 10h16\"/></svg><span>Hari ini</span></a></sc-if><sc-if value=\"{{nav.cPosVerifikasi}}\"><a href=\"PosVerifikasi.dc.html\" style=\"min-height: 40px; box-sizing: border-box; padding: 0 12px; border-radius: 10px; background: transparent; color: #1F2B4D; font: 600 14px 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; align-items: center; gap: 10px; text-decoration: none\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4A5468\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z\"/><path d=\"M9 12l2 2 4-4\"/></svg><span>Verifikasi</span><sc-if value=\"{{nav.nPosVerifikasi}}\"><span style=\"margin-left: auto; min-width: 22px; height: 22px; padding: 0 6px; box-sizing: border-box; border-radius: 11px; background: #1F2B4D; color: #FFFFFF; font-size: 12px; font-weight: 800; display: flex; align-items: center; justify-content: center\">{{nav.nPosVerifikasi}}</span></sc-if></a></sc-if><sc-if value=\"{{nav.cPosSerahTerima}}\"><a href=\"PosSerahTerima.dc.html\" style=\"min-height: 40px; box-sizing: border-box; padding: 0 12px; border-radius: 10px; background: transparent; color: #1F2B4D; font: 600 14px 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; align-items: center; gap: 10px; text-decoration: none\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4A5468\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 8h13l-3-3M20 16H7l3 3\"/></svg><span>Serah-terima</span></a></sc-if><sc-if value=\"{{nav.cPosKasir}}\"><a href=\"PosKasir.dc.html\" style=\"min-height: 40px; box-sizing: border-box; padding: 0 12px; border-radius: 10px; background: transparent; color: #1F2B4D; font: 600 14px 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; align-items: center; gap: 10px; text-decoration: none\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4A5468\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"9\" cy=\"20\" r=\"1.5\"/><circle cx=\"18\" cy=\"20\" r=\"1.5\"/><path d=\"M3 4h2l2.5 11h11L21 8H7\"/></svg><span>Kasir walk-in</span></a></sc-if><sc-if value=\"{{nav.cPosPelanggan}}\"><a href=\"PosPelanggan.dc.html\" style=\"min-height: 40px; box-sizing: border-box; padding: 0 12px; border-radius: 10px; background: transparent; color: #1F2B4D; font: 600 14px 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; align-items: center; gap: 10px; text-decoration: none\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4A5468\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"9\" cy=\"8\" r=\"3.5\"/><path d=\"M2.5 20c1-3.5 3.5-5.5 6.5-5.5s5.5 2 6.5 5.5\"/><path d=\"M16 4.5a3.5 3.5 0 0 1 0 7M18.5 14.5c1.6.8 2.6 2.6 3 5.5\"/></svg><span>Pelanggan</span></a></sc-if></div></sc-if><sc-if value=\"{{nav.gAset}}\"><div role=\"group\" aria-label=\"Aset\" style=\"display: flex; flex-direction: column; gap: 2px\"><div style=\"font-size: 11px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #8A93A6; padding: 0 12px 2px\">Aset</div><sc-if value=\"{{nav.cPosUnit}}\"><a href=\"PosUnit.dc.html\" style=\"min-height: 40px; box-sizing: border-box; padding: 0 12px; border-radius: 10px; background: transparent; color: #1F2B4D; font: 600 14px 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; align-items: center; gap: 10px; text-decoration: none\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4A5468\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 7l9-4 9 4v10l-9 4-9-4z\"/><path d=\"M3 7l9 4 9-4M12 11v10\"/></svg><span>Unit dan stok</span></a></sc-if><sc-if value=\"{{nav.cPosQC}}\"><a href=\"PosQC.dc.html\" style=\"min-height: 40px; box-sizing: border-box; padding: 0 12px; border-radius: 10px; background: transparent; color: #1F2B4D; font: 600 14px 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; align-items: center; gap: 10px; text-decoration: none\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4A5468\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z\"/><path d=\"M9 12l2 2 4-4\"/></svg><span>Quality control</span><sc-if value=\"{{nav.nPosQC}}\"><span style=\"margin-left: auto; min-width: 22px; height: 22px; padding: 0 6px; box-sizing: border-box; border-radius: 11px; background: #1F2B4D; color: #FFFFFF; font-size: 12px; font-weight: 800; display: flex; align-items: center; justify-content: center\">{{nav.nPosQC}}</span></sc-if></a></sc-if></div></sc-if><sc-if value=\"{{nav.gShift}}\"><div role=\"group\" aria-label=\"Shift\" style=\"display: flex; flex-direction: column; gap: 2px\"><div style=\"font-size: 11px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #8A93A6; padding: 0 12px 2px\">Shift</div><sc-if value=\"{{nav.cPosShift}}\"><a href=\"PosShift.dc.html\" style=\"min-height: 40px; box-sizing: border-box; padding: 0 12px; border-radius: 10px; background: transparent; color: #1F2B4D; font: 600 14px 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; align-items: center; gap: 10px; text-decoration: none\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4A5468\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"/><path d=\"M3 10h18M7 15h4\"/></svg><span>Tutup shift</span></a></sc-if><sc-if value=\"{{nav.cPosAbsen}}\"><a href=\"PosAbsen.dc.html\" aria-current=\"page\" style=\"min-height: 40px; box-sizing: border-box; padding: 0 12px; border-radius: 10px; background: #E3F7F5; color: #1F2B4D; font: 800 14px 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; align-items: center; gap: 10px; text-decoration: none\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1F2B4D\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 20V10M10 20V4M16 20v-7M22 20H2\"/></svg><span>Absen dan target</span></a></sc-if></div></sc-if></nav>\n  <div style=\"margin-top: auto; display: flex; align-items: center; gap: 10px; padding-top: 16px; border-top: 1px solid #E6E8EC\">\n    <div style=\"width: 36px; height: 36px; border-radius: 18px; background: #1F2B4D; color: #09BEAF; font-size: 13px; font-weight: 800; display: flex; align-items: center; justify-content: center; flex-shrink: 0\">{{nav.initials}}</div>\n    <div style=\"display: flex; flex-direction: column\"><span style=\"font-size: 13px; font-weight: 700\">{{nav.name}}</span><span style=\"font-size: 12px; color: #4A5468\">{{nav.roleLine}}</span></div>\n    <button type=\"button\" onClick=\"{{nav.signOut}}\" style=\"margin-left: auto; height: 32px; padding: 0 10px; border-radius: 8px; border: 1px solid #D5D9E0; background: #FFFFFF; color: #4A5468; font: 700 12px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">Keluar</button>\n  </div>\n</aside>\n<main style=\"flex: 999 1 560px; min-width: 0; box-sizing: border-box; padding: 24px 28px 40px; display: flex; flex-direction: column; gap: 20px\">\n<details data-wa-share style=\"background: #FFFFFF; border: 1px solid #E6E8EC; border-radius: 14px\">\n<summary style=\"list-style: none; cursor: pointer; display: flex; flex-wrap: wrap; gap: 10px; align-items: center; justify-content: space-between; padding: 8px 10px 8px 14px\">\n  <span style=\"font-size: 13px; color: #4A5468\">Laporan <b style=\"color: #1F2B4D\">Absen dan target</b> · {{wa.sched}}</span>\n  <span style=\"display: inline-flex; align-items: center; gap: 8px; height: 36px; padding: 0 14px; border-radius: 10px; background: #09BEAF; color: #1F2B4D; font-size: 14px; font-weight: 800\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 12a8 8 0 0 1-11.8 7L4 20l1.1-4A8 8 0 1 1 20 12z\"/><path d=\"M9 9.5c0 2.5 2 5 5 5.5l1.2-1.2-1.6-.9-.8.6c-1-.4-1.8-1.2-2.2-2.2l.6-.8-.9-1.6z\"/></svg>Bagikan ke WhatsApp</span>\n</summary>\n<div style=\"display: flex; flex-wrap: wrap; gap: 16px; padding: 4px 14px 16px; border-top: 1px solid #E6E8EC\">\n  <div style=\"flex: 1 1 340px; background: #E7F3EE; border-radius: 12px; padding: 12px; margin-top: 12px\"><div style=\"background: #FFFFFF; border-radius: 10px; padding: 10px 12px; font-size: 13.5px; line-height: 20px; box-shadow: 0 1px 1px rgba(0,0,0,0.08)\"><b>Absen dan target</b> · Rentalaja<br><sc-for list=\"{{wa.lines}}\" as=\"l\">• {{l}}<br></sc-for></div></div>\n  <div style=\"flex: 1 1 360px; display: flex; flex-direction: column; gap: 10px; margin-top: 12px\">\n    <div style=\"display: flex; flex-direction: column; gap: 6px\"><span style=\"font-size: 12px; font-weight: 700; color: #4A5468\">Penerima</span><div style=\"display: flex; flex-wrap: wrap; gap: 6px\"><sc-for list=\"{{wa.to}}\" as=\"r\"><span style=\"display: inline-flex; align-items: center; height: 30px; padding: 0 10px; border-radius: 15px; font-size: 12px; font-weight: 800; border: 1.5px solid #1F2B4D; background: #E3F7F5; color: #1F2B4D\">{{r}}</span></sc-for><span style=\"display: inline-flex; align-items: center; height: 30px; padding: 0 10px; border-radius: 15px; font-size: 12px; font-weight: 700; border: 1px solid #D5D9E0; background: #FFFFFF; color: #1F2B4D\">+ Tambah penerima</span></div></div>\n    <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 10px\">\n      <label style=\"display: flex; flex-direction: column; gap: 4px; font-size: 12px; font-weight: 700; color: #4A5468\">Jadwal kirim<select style=\"height: 40px; border: 1px solid #D5D9E0; border-radius: 10px; padding: 0 10px; font: 600 13px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; background: #FFFFFF\"><option selected>Harian 07.00</option><option>Tidak terjadwal</option><option>Mingguan · Senin 07.00</option><option>Bulanan · tanggal 1</option></select></label>\n      <label style=\"display: flex; flex-direction: column; gap: 4px; font-size: 12px; font-weight: 700; color: #4A5468\">Isi<select style=\"height: 40px; border: 1px solid #D5D9E0; border-radius: 10px; padding: 0 10px; font: 600 13px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; background: #FFFFFF\"><option>Ringkasan + link PDF</option><option>Ringkasan saja</option><option>Ringkasan + gambar grafik</option></select></label>\n    </div>\n    <div style=\"font-size: 12px; line-height: 18px; color: #4A5468\">Nomor dan dokumen pelanggan tidak pernah ikut terkirim. Bagikan manual membuka WhatsApp untuk memilih chat atau grup.</div>\n    <div style=\"display: flex; gap: 8px; flex-wrap: wrap\"><button type=\"button\" style=\"height: 44px; padding: 0 16px; border-radius: 10px; border: none; background: #09BEAF; color: #1F2B4D; font: 800 14px 'Plus Jakarta Sans', sans-serif; cursor: pointer\" onClick=\"{{wa.send}}\">Kirim sekarang</button><button type=\"button\" style=\"height: 44px; padding: 0 16px; border-radius: 10px; border: 1px solid #1F2B4D; background: #FFFFFF; color: #1F2B4D; font: 700 14px 'Plus Jakarta Sans', sans-serif; cursor: pointer\" onClick=\"{{wa.share}}\">Bagikan manual</button><button type=\"button\" style=\"height: 44px; padding: 0 16px; border-radius: 10px; border: 1px solid #D5D9E0; background: #FFFFFF; color: #1F2B4D; font: 700 14px 'Plus Jakarta Sans', sans-serif; cursor: pointer\" onClick=\"{{wa.save}}\">Simpan jadwal</button></div>\n  </div>\n</div>\n</details>\n\n<header style=\"display: flex; flex-direction: column; gap: 4px\">\n  <h1 style=\"margin: 0; font-size: 28px; line-height: 34px; font-weight: 800; letter-spacing: -0.01em\">Absen dan target shift</h1>\n  <div style=\"font-size: 14px; line-height: 20px; color: #4A5468\">{{subtitle}}</div>\n</header>\n\n<div style=\"display: flex; flex-wrap: wrap; gap: 20px; align-items: flex-start\">\n  <section style=\"flex: 1 1 300px; min-width: 0; background: #FFFFFF; border: 1px solid #E6E8EC; border-radius: 16px; padding: 18px; display: flex; flex-direction: column; gap: 12px\">\n    <h2 style=\"margin: 0; font-size: 17px; font-weight: 800\">Absen</h2>\n    <sc-if value=\"{{out}}\" hint-placeholder-val=\"{{true}}\">\n      <div style=\"display: flex; flex-direction: column; gap: 12px\">\n        <label style=\"height: 180px; border-radius: 12px; background: #1F2B4D; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; color: #DDE3EE; cursor: pointer; overflow: hidden; position: relative\"><input type=\"file\" accept=\"image/*\" capture=\"user\" onChange=\"{{pickSelfie}}\" aria-label=\"Ambil selfie\" style=\"position: absolute; opacity: 0; width: 1px; height: 1px\"><sc-if value=\"{{selfie}}\"><img src=\"{{selfie}}\" alt=\"Selfie\" style=\"width: 100%; height: 100%; object-fit: cover\"></sc-if><sc-if value=\"{{selfie}}\" not>{{selfieText}}</sc-if></label>\n        <div style=\"{{locStyle}}\"><sc-if value=\"{{locOk}}\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1E6B45\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12l5 5 9-10\"/></svg></sc-if>{{locText}}<sc-if value=\"{{locRetry}}\"> <button type=\"button\" onClick=\"{{locRetry}}\" style=\"border: none; background: none; padding: 0; color: #077A70; font: 700 13px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">Coba lagi</button></sc-if></div>\n        <button type=\"button\" onClick=\"{{clockIn}}\" disabled=\"{{busy}}\" style=\"{{inStyle}}\">Masuk shift · {{clock}}</button>\n      </div>\n    </sc-if>\n    <sc-if value=\"{{isIn}}\" hint-placeholder-val=\"{{false}}\">\n      <div style=\"display: flex; flex-direction: column; gap: 10px\">\n        <div style=\"background: #E4F2EA; border-radius: 12px; padding: 14px 16px; font-size: 14px; line-height: 20px; color: #1F3D2D\"><b>Masuk {{inTime}}</b> · {{inNote}}</div>\n        <div style=\"display: flex; justify-content: space-between; gap: 12px; font-size: 14px\"><span style=\"color: #4A5468\">Rekan shift</span><span style=\"font-weight: 700\">{{mates}}</span></div>\n        <div style=\"display: flex; justify-content: space-between; gap: 12px; font-size: 14px\"><span style=\"color: #4A5468\">{{outLabel}}</span><span style=\"font-weight: 700\">{{outTime}}</span></div>\n        <sc-if value=\"{{shiftOpen}}\"><a href=\"PosShift.dc.html\" style=\"height: 44px; padding: 0 16px; border-radius: 10px; border: 1px solid #1F2B4D; background: #FFFFFF; color: #1F2B4D; font: 700 14px 'Plus Jakarta Sans', sans-serif; cursor: pointer; display: flex; align-items: center; justify-content: center; text-decoration: none\">Tutup shift lalu keluar</a></sc-if>\n        <sc-if value=\"{{canOut}}\"><button type=\"button\" onClick=\"{{clockOut}}\" disabled=\"{{busy}}\" style=\"height: 44px; padding: 0 16px; border-radius: 10px; border: 1px solid #1F2B4D; background: #FFFFFF; color: #1F2B4D; font: 700 14px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">Absen keluar · {{clock}}</button></sc-if>\n      </div>\n    </sc-if>\n    <div style=\"font-size: 12px; line-height: 18px; color: #4A5468\">Absen hanya bisa dari HP atau tablet cabang, dengan selfie dan lokasi. Keluar shift wajib lewat tutup shift supaya kas dan KTP tercatat.</div>\n  </section>\n\n  <section style=\"flex: 1 1 320px; min-width: 0; background: #FFFFFF; border: 1px solid #E6E8EC; border-radius: 16px; padding: 18px; display: flex; flex-direction: column; gap: 14px\">\n    <h2 style=\"margin: 0; font-size: 17px; font-weight: 800\">Target shift ini</h2>\n    <sc-for list=\"{{targets}}\" as=\"g\"><div style=\"display: flex; flex-direction: column; gap: 6px\">\n      <div style=\"display: flex; justify-content: space-between; gap: 12px; font-size: 14px\"><span>{{g.label}}</span><b>{{g.text}}</b></div>\n      <div style=\"height: 10px; border-radius: 5px; background: #EEF0F3; overflow: hidden\"><div style=\"{{g.bar}}\"></div></div>\n    </div></sc-for>\n    <sc-if value=\"{{noTargets}}\"><div style=\"font-size: 14px; color: #4A5468\">Target belum diatur untuk cabang ini.</div></sc-if>\n    <sc-if value=\"{{verText}}\"><div style=\"display: flex; justify-content: space-between; gap: 12px; font-size: 14px\"><span>Verifikasi rata-rata</span><b style=\"{{verStyle}}\">{{verText}}</b></div></sc-if>\n    <div style=\"display: flex; justify-content: space-between; gap: 12px; font-size: 14px\"><span>Poin hari ini</span><b>{{myPts}}</b></div>\n    <sc-if value=\"{{badges}}\"><div style=\"display: flex; flex-wrap: wrap; gap: 6px\">\n      <sc-for list=\"{{badges}}\" as=\"x\"><span style=\"{{x.style}}\">{{x.t}}</span></sc-for>\n    </div></sc-if>\n    <div style=\"display: flex; flex-direction: column; gap: 6px; padding-top: 8px; border-top: 1px solid #E6E8EC\">\n      <div style=\"font-size: 13px; font-weight: 800\">Cara dapat poin</div>\n      <sc-for list=\"{{rules}}\" as=\"r\"><div style=\"display: flex; gap: 10px; font-size: 13px; line-height: 19px\"><b style=\"{{r.style}}\">{{r.v}}</b><span>{{r.t}}</span></div></sc-for>\n      <sc-if value=\"{{noRules}}\"><div style=\"font-size: 13px; line-height: 19px; color: #4A5468\">Aturan poin belum diatur di Pengaturan.</div></sc-if>\n    </div>\n  </section>\n\n  <section style=\"flex: 1 1 340px; min-width: 0; background: #FFFFFF; border: 1px solid #E6E8EC; border-radius: 16px; padding: 18px; display: flex; flex-direction: column; gap: 12px\">\n    <h2 style=\"margin: 0; font-size: 17px; font-weight: 800\">Papan peringkat minggu ini</h2>\n    <div role=\"group\" aria-label=\"Jenis peringkat\" style=\"display: flex; flex-wrap: wrap; gap: 6px\">\n        <sc-for list=\"{{tabs}}\" as=\"t\" hint-placeholder-count=\"4\">\n          <button type=\"button\" onClick=\"{{t.pick}}\" aria-pressed=\"{{t.on}}\" style=\"{{t.style}}\">{{t.label}}</button>\n        </sc-for>\n      </div>\n    <ol style=\"margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 8px\">\n      <sc-for list=\"{{board}}\" as=\"b\" hint-placeholder-count=\"4\">\n        <li style=\"{{b.style}}\">\n          <span style=\"{{b.rankStyle}}\">{{b.rank}}</span>\n          <span style=\"flex-grow: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px\"><span style=\"font-size: 14px; font-weight: 800\">{{b.name}}</span><span style=\"font-size: 12px; color: #4A5468\">{{b.sub}}</span></span>\n          <span style=\"text-align: right; display: flex; flex-direction: column; gap: 2px\"><span style=\"font-size: 14px; font-weight: 800\">{{b.pts}} poin</span><span style=\"font-size: 12px; color: #4A5468\">{{b.pct}}</span></span>\n        </li>\n      </sc-for>\n    </ol>\n    <sc-if value=\"{{noBoard}}\"><div style=\"font-size: 14px; color: #4A5468\">Belum ada poin minggu ini.</div></sc-if>\n    <div style=\"font-size: 12px; line-height: 18px; color: #4A5468\">Peringkat memakai poin, bukan omzet mentah, supaya cabang kecil juga bisa juara.{{prizeText}}</div>\n  </section>\n</div>\n</main>\n</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{\"$preview\":{\"width\":1280,\"height\":900}}'>\n/* ===== bagian bersama panel cabang (sidebar, cabang aktif, laporan WA). Sama di semua layar Pos*. ===== */\nconst PNL = {\n  ROLE: { owner: 'Owner', finance: 'Keuangan', viewer: 'Pemantau', asset_manager: 'Manajer aset', experience_manager: 'Manajer operasional', branch_head: 'Manajemen',\n    cs: 'CS', cs_experience: 'CS Experience', cashier: 'Kasir', staff: 'Kasir + Teknisi', qc: 'Petugas QC', technician: 'Teknisi', runner: 'Runner', driver: 'Sopir' },\n  PERM: { PosHariIni: 'pos.bookings', PosVerifikasi: 'pos.verify', PosSerahTerima: 'pos.handover', PosKasir: 'pos.cashier', PosPelanggan: 'pos.customers',\n    PosUnit: 'pos.units', PosQC: 'pos.qc', PosShift: 'pos.shift', PosAbsen: null },\n  day(d) { const s = new Date(d || Date.now()); s.setHours(0, 0, 0, 0); const e = new Date(s); e.setDate(e.getDate() + 1); return [s, e]; },\n  esc(s) { return String(s == null ? '' : s); },\n  async boot(c) {\n    const st = await RA.staff();\n    if (!st) return null;\n    const br = RA.staffBranch();\n    const cnt = r => (r && r.count) || 0;\n    const none = Promise.resolve({ data: null, count: 0 });\n    const [sch, sh, vq, qq, mates, owners] = await Promise.all([\n      RA.from('shift_schedules').select('shift,starts,ends').eq('staff_id', st.user_id).eq('day', RA.iso(new Date())).limit(1),\n      br ? RA.from('shifts').select('id,label,opened_at,cash_open,branch_id').eq('staff_id', st.user_id).eq('branch_id', br.id).eq('status', 'open').order('opened_at', { ascending: false }).limit(1) : none,\n      br && RA.can('pos.verify') ? RA.from('bookings').select('id', { count: 'exact' }).eq('branch_id', br.id).eq('status', 'pending_verification').limit(1) : none,\n      br && RA.can('pos.qc') ? RA.from('qc_inspections').select('id', { count: 'exact' }).eq('branch_id', br.id).is('done_at', 'null').limit(1) : none,\n      br ? RA.from('staff_branches').select('staff_id,staff(user_id,name,phone,role,is_active)').eq('branch_id', br.id) : none,\n      RA.from('staff').select('user_id,name,phone,role').eq('role', 'owner').eq('is_active', true)\n    ]);\n    const team = (mates.data || []).map(x => x.staff).filter(x => x && x.is_active);\n    const heads = team.filter(x => x.role === 'branch_head').concat(owners.data || []);\n    const p = { st, br, sched: (sch.data || [])[0] || null, shift: (sh.data || [])[0] || null, vCount: cnt(vq), qCount: cnt(qq), team, heads };\n    if (RA_ALIVE(c)) c.setState({ pnl: p });\n    return p;\n  },\n  /* nilai untuk sidebar + blok laporan WA. active = nama layar ini; wa = {title, lines[]} */\n  vals(c, active, wa) {\n    const p = c.state.pnl || {};\n    const st = p.st || RA._staff || {};\n    const br = RA.staffBranch() || p.br || {};\n    const bs = st.branches || [];\n    const can = n => { const k = PNL.PERM[n]; return !k || RA.can(k); };\n    const nav = {\n      multi: bs.length > 1, branchName: br.name || 'Belum ada cabang',\n      branches: bs.map(b => ({ id: b.id, name: b.name, on: b.id === br.id })),\n      pickBranch: e => { RA.setStaffBranch(e.target.value); RA.go(active); },\n      initials: RA.initials(st.name), name: st.name || '—',\n      roleLine: (PNL.ROLE[st.role] || 'Staf') + (p.sched && p.sched.shift ? ' · shift ' + p.sched.shift : p.shift ? ' · shift buka' : ''),\n      signOut: () => { RA.signOut(); RA.go('Masuk'); },\n      nPosVerifikasi: p.vCount || 0, nPosQC: p.qCount || 0,\n      gTransaksi: ['PosHariIni', 'PosVerifikasi', 'PosSerahTerima', 'PosKasir', 'PosPelanggan'].some(can),\n      gAset: ['PosUnit', 'PosQC'].some(can), gShift: true\n    };\n    Object.keys(PNL.PERM).forEach(n => { nav['c' + n] = can(n); });\n    wa = wa || { title: '', lines: [] };\n    const heads = p.heads || [];\n    const text = '*' + wa.title + '* · Rentalaja ' + (br.name || '') + '\\n' + (wa.lines || []).map(l => '• ' + l).join('\\n');\n    const open = ph => window.open('https://wa.me/' + (ph || '') + '?text=' + encodeURIComponent(text), '_blank', 'noopener');\n    return {\n      nav,\n      wa: {\n        lines: wa.lines || [], to: heads.length ? heads.map(h => h.name) : ['Manajemen'],\n        sched: heads.length ? 'kirim ke ' + heads.map(h => h.name).join(', ') : 'bagikan manual',\n        send: () => { const h = heads.find(x => x.phone && x.user_id !== st.user_id) || heads.find(x => x.phone); if (!h) return RA.toast('Nomor penerima belum diisi. Pakai Bagikan manual.'); open(h.phone); },\n        share: () => open(''),\n        save: () => RA.toast('Jadwal kirim otomatis diatur owner di Laporan WhatsApp (panel manajemen).')\n      }\n    };\n  },\n  chip(tone) { return RA.chip(tone).replace('padding: 0 10px', 'padding: 0 9px').replace('border-radius: 999px', 'border-radius: 12px').replace('font-weight: 700', 'font-weight: 800') + ';'; },\n  num(v) { const n = parseInt(String(v == null ? '' : v).replace(/[^0-9]/g, ''), 10); return isNaN(n) ? null : n; },\n  mins(a, b) { return Math.round((new Date(b) - new Date(a)) / 60000); },\n  dur(m) { m = Math.max(0, Math.round(m)); if (m < 60) return m + ' menit'; const h = Math.floor(m / 60), r = m % 60; if (h < 24) return h + ' jam' + (r ? ' ' + r + ' menit' : ''); const d = Math.floor(h / 24); return d + ' hari' + (h % 24 ? ' ' + (h % 24) + ' jam' : ''); },\n  items(b) {\n    const g = {};\n    (b.booking_items || []).forEach(it => { const n = (it.products && it.products.name) || 'Barang'; g[n] = (g[n] || 0) + (it.quantity || 1); });\n    const k = Object.keys(g); return k.length ? k.map(n => g[n] > 1 ? n + ' × ' + g[n] : n).join(', ') : '—';\n  },\n  /* unggah foto dari <input type=file> (kamera tablet) ke bucket operasional */\n  async upPhoto(file, prefix, n) {\n    const ext = (file.type && file.type.split('/')[1] || 'jpg').replace('jpeg', 'jpg');\n    const path = prefix + '/' + Date.now() + '-' + (n == null ? Math.random().toString(36).slice(2, 6) : n) + '.' + ext;\n    await RA.upload('operasional', path, file);\n    return path;\n  },\n  /* ===== pembayaran di cabang (QRIS di layar / link ke WA / tunai ke shift) — state: method, pay, linkSent =====\n     o = { booking, due, kind, onPaid } ; komponen wajib punya state.pnl (shift terbuka) */\n  payVals(c, o) {\n    const s = c.state, b = o.booking || {}, due = Math.max(0, Math.round(o.due || 0));\n    const method = s.method || 'qris';\n    const opt = on => 'min-height: 44px; padding: 0 10px; border-radius: 10px; cursor: pointer; font: 700 13px \"Plus Jakarta Sans\", sans-serif; color: #1F2B4D; ' + (on ? 'border: 2px solid #1F2B4D; background: #E3F7F5;' : 'border: 1px solid #D5D9E0; background: #FFFFFF;');\n    const canCash = RA.can('pos.cashier');\n    const methods = [{ id: 'qris', label: 'QRIS Xendit' }, { id: 'edc', label: 'EDC BCA' }, { id: 'cash', label: 'Tunai' }, { id: 'link', label: 'Link ke WA' }]\n      .map(m => ({ ...m, on: method === m.id ? 'true' : 'false', pick: () => c.setState({ method: m.id }), style: opt(method === m.id) }));\n    const pay = s.pay && s.pay.status === 'pending' && s.pay.booking_id === b.id ? s.pay : null;\n    const shift = s.pnl && s.pnl.shift;\n    const me = (RA._staff || {}).name || 'staf';\n    const phone = b.guest_phone || (b.customers && b.customers.phone);\n    const appLink = location.origin + location.pathname + '#/Bayar?id=' + b.id;\n    const poll = () => {\n      clearInterval(c._payPoll);\n      c._payPoll = setInterval(async () => {\n        if (!RA_ALIVE(c)) return clearInterval(c._payPoll);\n        const cur = c.state.pay; if (!cur) return clearInterval(c._payPoll);\n        const { data } = await RA.from('payments').select('id,status').eq('id', cur.id).maybeSingle();\n        if (data && data.status !== 'pending') { clearInterval(c._payPoll); c.setState({ pay: null }); if (data.status === 'paid') { RA.ok('Pembayaran diterima'); o.onPaid && o.onPaid(); } }\n      }, 3000);\n    };\n    const create = async m => {\n      const pm = await RA.call('create_payment', { p_booking: b.id, p_kind: o.kind || 'settlement', p_method: m });\n      let extra = {};\n      if (m !== 'cash' && m !== 'edc') { try { const r = await RA.fn('pay', { payment_id: pm.id }); extra = (r && r.payment) || {}; } catch (e) { console.warn(e); } }\n      const row = { ...pm, ...extra, id: pm.id, status: 'pending', booking_id: b.id };\n      c.setState({ pay: row });\n      if (m !== 'cash' && m !== 'edc') poll();\n      return row;\n    };\n    return {\n      methods: canCash ? methods : methods.filter(m => m.id === 'link'), dueShort: RA.rp(due),\n      showQr: due > 0 && canCash && method === 'qris', qrReady: !!(pay && pay.method === 'qris'),\n      qrText: pay ? (pay.qr_string ? 'Kode ' + String(pay.qr_string).slice(0, 18) + '…' : pay.code || '') + ' · ' + RA.rp(pay.amount) : '',\n      makeQr: c.act(() => create('qris')),\n      showLink: due > 0 && method === 'link', linkSent: !!(pay && pay.method === 'link'),\n      linkText: pay && pay.method === 'link' ? 'Link bayar dikirim ke email pelanggan. Status berubah otomatis begitu dibayar.' : 'Link bayar ' + RA.rp(due) + ' dikirim ke email pelanggan.',\n      sendLink: c.act(async () => {\n        if (!phone) throw new Error('Nomor WhatsApp pelanggan belum ada.');\n        const w = window.open('', '_blank');\n        const row = await create('link');\n        const url = row.payment_url || appLink;\n        const msg = 'Halo ' + (b.guest_name || '') + ', tagihan ' + b.code + ' sebesar ' + RA.rp(row.amount) + '. Bayar di sini: ' + url;\n        const href = 'https://wa.me/' + phone + '?text=' + encodeURIComponent(msg);\n        if (w) w.location = href; else window.open(href, '_blank', 'noopener');\n      }),\n      showCash: due > 0 && canCash && method === 'cash', hasShift: !!shift,\n      showEdc: due > 0 && canCash && method === 'edc', edcRef: c.state.edcRef || '', setEdcRef: e => c.setState({ edcRef: e.target.value }),\n      edcText: shift ? 'Proses di mesin EDC BCA sebesar ' + RA.rp(due) + ' (QRIS atau kartu), lalu isi nomor approval dari struk EDC.' : 'Pembayaran EDC harus masuk shift kasir. Buka shift dulu.',\n      payEdc: c.act(async () => {\n        if (!shift) throw new Error('Buka shift dulu sebelum menerima pembayaran EDC.');\n        const ref = String(c.state.edcRef || '').replace(/\\s+/g, '');\n        if (ref.length < 4) throw new Error('Isi nomor approval dari struk EDC (minimal 4 karakter).');\n        const row = await create('edc');\n        await RA.call('mark_payment_paid', { p_payment: row.id, p_provider_ref: 'EDC BCA ' + ref });\n        c.setState({ pay: null, edcRef: '' }); RA.ok('EDC BCA ' + RA.rp(row.amount) + ' tercatat · approval ' + ref);\n        o.onPaid && o.onPaid();\n      }),\n      cashText: shift ? 'Tunai tetap dicatat atas nama ' + me + ' dan masuk setoran shift. Disarankan hanya kalau QRIS gagal.' : 'Tunai harus masuk shift kasir. Buka shift Anda dulu di Tutup shift, lalu kembali ke sini.',\n      payCash: c.act(async () => {\n        if (!shift) throw new Error('Buka shift dulu sebelum menerima tunai.');\n        const row = await create('cash');\n        await RA.call('mark_payment_paid', { p_payment: row.id });\n        c.setState({ pay: null }); RA.ok('Tunai ' + RA.rp(row.amount) + ' tercatat di shift Anda');\n        o.onPaid && o.onPaid();\n      }),\n      waiting: !!pay && pay.method !== 'cash' && pay.method !== 'edc' && due > 0, pendingText: pay ? RA.rp(pay.amount) : '',\n      canSim: RA.simulation() && !!pay,\n      simulate: c.act(async () => { await RA.fn('pay', { payment_id: pay.id, action: 'simulate' }); clearInterval(c._payPoll); c.setState({ pay: null }); RA.ok('Pembayaran (simulasi) diterima'); o.onPaid && o.onPaid(); })\n    };\n  }\n};\nclass Component extends DCLogic {\nstate = { att: undefined, kind: 'shift', selfie: null, selfiePath: null, loc: null, locErr: null, board: null, targets: [], pays: null, bks: null, vers: null, myPts: 0, weekPts: [], mates: [], now: Date.now() };\nasync componentDidMount() {\n  await PNL.boot(this);\n  if (!RA_ALIVE(this)) return;\n  this.timer = setInterval(() => this.setState({ now: Date.now() }), 30000);\n  this.locate();\n  await this.load();\n}\ncomponentWillUnmount() { clearInterval(this.timer); }\nlocate() {\n  if (!navigator.geolocation) return this.setState({ locErr: 'Perangkat ini tidak mendukung lokasi.' });\n  this.setState({ locErr: null });\n  navigator.geolocation.getCurrentPosition(p => { if (RA_ALIVE(this)) this.setState({ loc: { lat: p.coords.latitude, lng: p.coords.longitude, acc: p.coords.accuracy } }); },\n    () => { if (RA_ALIVE(this)) this.setState({ locErr: 'Lokasi belum terbaca. Izinkan akses lokasi.' }); }, { enableHighAccuracy: true, timeout: 10000 });\n}\nasync load() {\n  const br = RA.staffBranch(); const me = (RA._staff || {}).user_id; if (!br) return this.setState({ att: null });\n  const day = RA.iso(new Date()); const month = day.slice(0, 7);\n  const [S, E] = PNL.day();\n  const wk = new Date(S); wk.setDate(wk.getDate() - ((wk.getDay() + 6) % 7));\n  const none = { data: null };\n  const [att, tg, pts, sch, board, brow] = await Promise.all([\n    RA.from('attendance').select('*').eq('staff_id', me).eq('day', day).limit(1),\n    RA.from('targets').select('metric,period,value,line').eq('branch_id', br.id).in('period', [day, month]),\n    RA.from('staff_points').select('delta,reason,at').eq('staff_id', me).gte('at', wk.toISOString()),\n    RA.from('shift_schedules').select('staff_id,shift,starts,ends,staff(name,role)').eq('branch_id', br.id).eq('day', day),\n    RA.rpc('pos_leaderboard', { p_branch: br.id }),\n    RA.from('branches').select('lat,lng').eq('id', br.id).limit(1)\n  ]);\n  const targets = (tg.data || []).filter(t => t.value != null);\n  const usesDay = targets.some(t => t.period === day);\n  const from = usesDay ? S : new Date(S.getFullYear(), S.getMonth(), 1);\n  const [pays, bks, vers] = await Promise.all([\n    targets.some(t => t.metric === 'omzet') && RA.can('pos.cashier') ? RA.from('payments').select('amount,kind').eq('branch_id', br.id).eq('status', 'paid').gte('paid_at', from.toISOString()).lt('paid_at', E.toISOString()) : none,\n    targets.some(t => t.metric === 'bundling') && RA.can('pos.bookings') ? RA.from('bookings').select('id', { count: 'exact' }).eq('branch_id', br.id).gt('bundle_discount', 0).gte('created_at', from.toISOString()).limit(1) : none,\n    RA.can('pos.verify') ? RA.from('bookings').select('verification_seconds').eq('branch_id', br.id).gte('verified_at', S.toISOString()).not('verification_seconds', 'is', 'null') : none\n  ]);\n  if (!RA_ALIVE(this)) return;\n  const wp = pts.data || [];\n  this.setState({ att: (att.data || [])[0] || null, targets: targets.filter(t => !usesDay || t.period === day), period: usesDay ? 'hari' : 'bulan',\n    pays: pays.data, bundles: bks.data ? bks.count || 0 : null, vers: vers.data, weekPts: wp, myPts: wp.filter(p => new Date(p.at) >= S).reduce((a, p) => a + p.delta, 0),\n    mates: (sch.data || []).filter(x => x.staff_id !== me), mySch: (sch.data || []).find(x => x.staff_id === me) || null, board: board.data || null, brLoc: (brow.data || [])[0] || null });\n}\nasync pickSelfie(e) {\n  const f = e.target.files && e.target.files[0]; if (!f) return;\n  const src = URL.createObjectURL(f); this.setState({ selfie: src, selfiePath: null, up: true });\n  try {\n    const me = (RA._staff || {}).user_id; const day = RA.iso(new Date());\n    const path = 'absen/' + me + '/' + day + (this.state.att ? '-keluar' : '') + '.jpg';\n    await RA.upload('operasional', path, f);\n    if (RA_ALIVE(this)) this.setState({ selfiePath: path, up: false });\n  } catch (err) { RA.err(err); this.setState({ selfie: null, up: false }); }\n}\nrenderVals() {\n  const s = this.state, br = RA.staffBranch() || {}, me = RA._staff || {};\n  const tab = on => 'height: 36px; padding: 0 12px; border-radius: 9px; cursor: pointer; font: 700 13px \"Plus Jakarta Sans\", sans-serif; color: #1F2B4D; ' + (on ? 'border: 1.5px solid #1F2B4D; background: #E3F7F5;' : 'border: 1px solid #D5D9E0; background: #FFFFFF;');\n  const chip = (bg, fg) => 'display: inline-flex; align-items: center; height: 24px; padding: 0 9px; border-radius: 12px; font-size: 12px; font-weight: 800; white-space: nowrap; background: ' + bg + '; color: ' + fg + ';';\n  const now = new Date(s.now); const hm = t => t ? String(t).slice(0, 5).replace(':', '.') : '';\n  const sch = s.mySch || (s.pnl || {}).sched;\n  const subtitle = [sch && sch.shift ? 'Shift ' + sch.shift : 'Tanpa jadwal shift', RA.HARIL[now.getDay()] + ', ' + RA.date(now), sch && sch.starts ? hm(sch.starts) + '–' + hm(sch.ends) : '', br.name].filter(Boolean).join(' · ');\n  // lokasi\n  const radius = RA.setting('attendance_radius_m'); const bl = s.brLoc;\n  let locOk = false, locText, locColor = '#4A5468';\n  if (s.locErr) { locText = s.locErr; locColor = '#A12A1F'; }\n  else if (!s.loc) locText = 'Membaca lokasi…';\n  else if (radius == null || !bl || bl.lat == null) { locOk = true; locText = 'Lokasi terbaca' + (radius == null ? ' (radius absen belum diatur)' : ' (titik cabang belum diatur)'); locColor = '#1E6B45'; }\n  else { const R = 6371000, toR = x => x * Math.PI / 180; const dLat = toR(bl.lat - s.loc.lat), dLng = toR(bl.lng - s.loc.lng);\n    const dist = 2 * R * Math.asin(Math.sqrt(Math.sin(dLat / 2) ** 2 + Math.cos(toR(s.loc.lat)) * Math.cos(toR(bl.lat)) * Math.sin(dLng / 2) ** 2));\n    locOk = dist <= radius; locText = locOk ? 'Lokasi di dalam area cabang' : 'Di luar area cabang (' + Math.round(dist) + ' m)'; locColor = locOk ? '#1E6B45' : '#A12A1F'; }\n  const a = s.att;\n  const isIn = !!(a && a.clock_in);\n  const ready = !!s.selfiePath && !!s.loc && !s.up;\n  const lateTxt = a ? (a.late_minutes > 0 ? 'telat ' + PNL.dur(a.late_minutes) : a.status === 'tanpa_jadwal' ? 'tanpa jadwal shift' : 'tepat waktu') : '';\n  const pl = s.weekPts.find(p => a && /^Telat masuk/.test(p.reason) && new Date(p.at) >= new Date(a.clock_in) - 60000);\n  // target\n  const T = { omzet: 'Omzet', bundling: 'Booking bundling', verifikasi: 'Verifikasi' };\n  const omzet = s.pays ? s.pays.reduce((x, p) => x + (p.kind === 'refund' ? -1 : 1) * +p.amount, 0) : null;\n  const targets = s.targets.filter(t => t.metric !== 'verifikasi').map(t => {\n    const cur = t.metric === 'omzet' ? omzet : t.metric === 'bundling' ? s.bundles : null; if (cur == null) return null;\n    const pct = t.value ? Math.min(100, Math.round(cur * 100 / t.value)) : 0;\n    return { label: (T[t.metric] || t.metric) + (s.period === 'bulan' ? ' bulan ini' : ''), text: t.metric === 'omzet' ? RA.rpShort(cur) + ' / ' + RA.rpShort(t.value) : cur + ' / ' + t.value, bar: 'width: ' + pct + '%; height: 10px; background: #09BEAF' };\n  }).filter(Boolean);\n  const vt = RA.setting('verification_target_minutes');\n  const vs = (s.vers || []).map(v => v.verification_seconds); const avg = vs.length ? Math.round(vs.reduce((x, y) => x + (+y || 0), 0) / vs.length) : null;\n  const fmt = x => Math.floor(x / 60) + ':' + String(x % 60).padStart(2, '0');\n  const verText = avg == null ? '' : fmt(avg) + (vt != null ? ' · target ' + vt + ':00' : '');\n  // lencana dari poin minggu ini\n  const badges = [];\n  if (s.weekPts.some(p => p.reason === 'Verifikasi cepat')) badges.push({ t: 'Verifikasi Kilat', style: chip('#E3F7F5', '#077A70') });\n  const pas = s.weekPts.filter(p => p.reason === 'Kas pas').length; if (pas) badges.push({ t: 'Kas Pas ' + pas + ' hari', style: chip('#E8EEF8', '#1F2B4D') });\n  const sv = k => RA.setting(k);\n  const rules = [[sv('pts_per_100k'), 'per Rp100.000 omzet', 1], [sv('pts_bundling'), 'per booking bundling', 1], [sv('pts_fast_verify'), 'verifikasi' + (vt != null ? ' di bawah ' + vt + ' menit' : ' cepat'), 1],\n    [sv('pts_cash_exact'), 'kas pas saat tutup shift', 1], [sv('pts_late'), 'telat masuk shift', -1], [sv('pts_cash_diff'), 'selisih kas tanpa catatan', -1]]\n    .filter(r => r[0] != null).map(([v, t, sg]) => ({ v: (sg > 0 ? '+' : '−') + Math.abs(v), t, style: 'min-width: 32px; color: ' + (sg > 0 ? '#1E6B45' : '#A12A1F') }));\n  const medal = ['#C79A2C', '#8A93A6', '#B0723A'];\n  const bd = s.board || { staff: [], shift: [] };\n  const list = s.kind === 'shift' ? bd.shift.map(x => ({ name: x.label, sub: x.names, pts: x.pts, pct: '', me: x.me })) : bd.staff.map(x => ({ name: x.name, sub: (PNL.ROLE[x.role] || x.role) + ' · ' + (x.branch || '—'), pts: x.pts, pct: '', me: x.me }));\n  const board = list.map((b, i) => ({ ...b, pts: RA.num(b.pts), rank: String(i + 1),\n    rankStyle: 'width: 32px; height: 32px; border-radius: 16px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 800; ' + (i < 3 ? 'background: ' + medal[i] + '; color: #FFFFFF;' : 'background: #EEF0F3; color: #4A5468;'),\n    style: 'display: flex; gap: 12px; align-items: center; border-radius: 12px; padding: 10px 12px; ' + (b.me ? 'background: #F3FBFA; border: 1.5px solid #09BEAF;' : 'border: 1px solid #E6E8EC;') }));\n  const prize = RA.setting('weekly_prize');\n  const shiftOpen = !!((s.pnl || {}).shift);\n  const wa = { title: 'Absen dan target', lines: [(me.name || '') + ' · ' + (a ? 'masuk ' + RA.time(a.clock_in) + ' (' + lateTxt + ')' : 'belum absen') + ' · poin hari ini ' + s.myPts] };\n  return {\n    ...PNL.vals(this, 'PosAbsen', wa), busy: !!s.busy, subtitle,\n    out: s.att !== undefined && !isIn, isIn,\n    selfie: s.selfie, selfieText: s.up ? 'Mengunggah…' : 'Ketuk untuk selfie di cabang', pickSelfie: e => this.pickSelfie(e),\n    locOk, locText, locStyle: 'display: flex; gap: 8px; align-items: center; font-size: 14px; font-weight: 700; color: ' + locColor, locRetry: s.locErr ? () => this.locate() : null,\n    clock: RA.time(now),\n    inStyle: 'height: 48px; padding: 0 18px; border-radius: 12px; border: none; font: 800 15px \"Plus Jakarta Sans\", sans-serif; ' + (ready ? 'background: #09BEAF; color: #1F2B4D; cursor: pointer;' : 'background: #E6E8EC; color: #6B7385; cursor: not-allowed;'),\n    clockIn: this.act(async () => {\n      if (!s.selfiePath) throw new Error('Ambil selfie dulu.');\n      if (!s.loc && !s.locErr) throw new Error('Tunggu lokasi terbaca.');\n      const r = await RA.call('clock_in', { p_branch: br.id, p_selfie: s.selfiePath, p_lat: s.loc ? s.loc.lat : null, p_lng: s.loc ? s.loc.lng : null });\n      RA.ok(r.late_minutes > 0 ? 'Masuk, telat ' + r.late_minutes + ' menit' : 'Masuk tepat waktu');\n      this.setState({ selfie: null, selfiePath: null }); await this.load(); PNL.boot(this);\n    }),\n    inTime: a && a.clock_in ? RA.time(a.clock_in) : '', inNote: lateTxt + (a && a.late_minutes > 0 && pl ? ', ' + pl.delta + ' poin telat' : '') + (a && a.clock_out ? ' · keluar ' + RA.time(a.clock_out) : ''),\n    mates: s.mates.length ? s.mates.map(m => ((m.staff && m.staff.name) || 'Staf') + ' · ' + (PNL.ROLE[m.staff && m.staff.role] || '').toLowerCase() + ' · ' + m.shift).join(', ') : '—',\n    outLabel: a && a.clock_out ? 'Keluar' : 'Jadwal keluar', outTime: a && a.clock_out ? RA.time(a.clock_out) : sch && sch.ends ? hm(sch.ends) : '—',\n    shiftOpen, canOut: isIn && !a.clock_out && !shiftOpen,\n    clockOut: this.act(async () => { await RA.call('clock_out', {}); RA.ok('Absen keluar tercatat'); await this.load(); }),\n    targets, noTargets: s.att !== undefined && !targets.length, verText, verStyle: 'color: ' + (avg != null && vt != null && avg > vt * 60 ? '#A12A1F' : '#1E6B45'),\n    myPts: RA.num(s.myPts), badges: badges.length ? badges : null, rules, noRules: !rules.length,\n    tabs: [['shift', 'Per shift'], ['staff', 'Per orang']].map(([id, label]) => ({ id, label, on: s.kind === id ? 'true' : 'false', pick: () => this.setState({ kind: id }), style: tab(s.kind === id) })),\n    board, noBoard: s.board !== null && !board.length, prizeText: prize ? ' Juara mingguan dapat ' + prize + '.' : ''\n  };\n}\n}\n</script>\n</body>\n</html>"}