{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Data tamu dan bayar</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0}\na{color:#1F2B4D}a:hover{color:#000}\n</style>\n</helmet>\n<div style=\"width: 390px; min-height: 920px; box-sizing: border-box; background: #F4F6F9; color: #1F2B4D; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; flex-direction: column; position: relative\">\n<header style=\"display: flex; align-items: center; gap: 8px; padding: 10px 12px; background: #FFFFFF; border-bottom: 1px solid #E6E8EC; position: sticky; top: 0; z-index: 6\">\n    <a href=\"{{backHref}}\" aria-label=\"Kembali\" style=\"width: 44px; height: 44px; display: flex; align-items: center; justify-content: center\">\n      <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1F2B4D\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M15 6l-6 6 6 6\"/></svg>\n    </a>\n    <div style=\"display: flex; flex-direction: column; flex: 1; min-width: 0\"><div style=\"font-size: 18px; font-weight: 800\">{{headTitle}}</div><div style=\"font-size: 12px; color: #4A5468\">{{headSub}}</div></div>\n  </header>\n  <sc-if value=\"{{missing}}\"><section style=\"padding: 24px 16px; display: flex; flex-direction: column; gap: 12px; align-items: flex-start\"><div style=\"font-size: 15px; color: #4A5468\">{{missing}}</div><a href=\"Menginap.dc.html\" style=\"height: 48px; padding: 0 20px; border-radius: 12px; background: #09BEAF; color: #1F2B4D; font-weight: 800; display: flex; align-items: center; text-decoration: none\">Lihat Experience</a></section></sc-if>\n  <sc-if value=\"{{ready}}\">\n  <div style=\"display: flex; align-items: center; gap: 6px; padding: 12px 20px 0\">\n    <sc-for list=\"{{steps}}\" as=\"x\"><span style=\"{{x.dot}}\">{{x.n}}</span><span style=\"{{x.lbl}}\">{{x.t}}</span><sc-if value=\"{{x.line}}\"><i style=\"flex: 1; height: 2px; border-radius: 1px; background: #D5D9E0; min-width: 10px\"></i></sc-if></sc-for>\n  </div>\n\n  <section style=\"padding: 12px 16px 0\">\n    <div style=\"background: #FFFFFF; border-radius: 20px; box-shadow: 0 2px 12px rgba(31,43,77,.06); overflow: hidden\">\n      <div style=\"display: flex; gap: 12px; align-items: center; padding: 12px\">\n        <span style=\"width: 64px; height: 64px; border-radius: 14px; overflow: hidden; background: #DCE3EE; flex-shrink: 0\"><sc-if value=\"{{photo}}\"><img src=\"{{photo}}\" alt=\"\" style=\"width: 100%; height: 100%; object-fit: cover; display: block\"></sc-if></span>\n        <div style=\"min-width: 0; flex: 1\"><div style=\"font-size: 10.5px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: #077A70\">{{kindLabel}}</div><b style=\"font-size: 15.5px; line-height: 20px; display: block\">{{pname}}</b><sc-if value=\"{{bookingCode}}\"><span style=\"font-size: 12px; color: #4A5468\">Kode booking <b style=\"color: #1F2B4D\">{{bookingCode}}</b></span></sc-if></div>\n        <sc-if value=\"{{editHref}}\"><a href=\"{{editHref}}\" style=\"font-size: 13px; font-weight: 800; color: #077A70; text-decoration: none; padding: 8px 4px\">Ubah</a></sc-if>\n      </div>\n      <div style=\"display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid #F0F2F5\">\n        <sc-for list=\"{{facts}}\" as=\"f\"><div style=\"padding: 9px 10px; display: flex; flex-direction: column; gap: 1px; border-right: 1px solid #F0F2F5\"><span style=\"font-size: 10.5px; font-weight: 800; letter-spacing: .06em; color: #8A93A6\">{{f.k}}</span><b style=\"font-size: 13px; line-height: 17px\">{{f.v}}</b></div></sc-for>\n      </div>\n    </div>\n  </section>\n\n  <sc-if value=\"{{editGuest}}\">\n  <section style=\"padding: 16px 16px 0\">\n    <div style=\"background: #FFFFFF; border-radius: 20px; box-shadow: 0 2px 12px rgba(31,43,77,.06); padding: 14px; display: flex; flex-direction: column; gap: 12px\">\n      <div><h2 style=\"margin: 0; font-size: 16px; font-weight: 800\">Data pemesan</h2><div style=\"font-size: 12.5px; color: #4A5468; margin-top: 2px\">Tanpa daftar akun. Cukup nama, nomor HP, dan email.</div></div>\n      <label style=\"display: flex; flex-direction: column; gap: 6px; font-size: 12.5px; font-weight: 700; color: #4A5468\">Nama lengkap<input type=\"text\" autocomplete=\"name\" value=\"{{name}}\" onChange=\"{{setName}}\" placeholder=\"Nama sesuai pemesan\" style=\"height: 50px; box-sizing: border-box; border: 1.5px solid #D5D9E0; border-radius: 12px; padding: 0 14px; font: 600 16px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; background: #FFFFFF; width: 100%\"></label>\n      <label style=\"display: flex; flex-direction: column; gap: 6px; font-size: 12.5px; font-weight: 700; color: #4A5468\">Nomor HP\n        <span style=\"display: flex; align-items: center; height: 50px; box-sizing: border-box; border: 1.5px solid #D5D9E0; border-radius: 12px; background: #FFFFFF; overflow: hidden\"><span style=\"height: 100%; padding: 0 12px; display: flex; align-items: center; gap: 6px; background: #F4F6F9; border-right: 1px solid #E1E5EB; font: 800 14px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path fill=\"#25D366\" d=\"M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2z\"/><path fill=\"#FFFFFF\" d=\"M8.6 7.3c.2-.4.4-.4.7-.4h.5c.2 0 .4 0 .6.5l.8 1.9c.1.2 0 .4-.1.6l-.5.6c-.1.2-.2.3 0 .6.6 1 1.6 2 2.7 2.5.3.1.4.1.6-.1l.7-.8c.2-.2.3-.2.6-.1l1.8.9c.3.1.4.2.4.4 0 .5-.2 1.2-.6 1.5-.5.4-1.4.7-2.6.3-1.6-.5-3.7-1.9-5-4-.7-1.2-.9-2.2-.6-3l.4-.5z\"/></svg>+62</span><input type=\"tel\" autocomplete=\"tel\" value=\"{{phone}}\" onChange=\"{{setPhone}}\" placeholder=\"812 3456 7890\" style=\"flex: 1; min-width: 0; height: 100%; border: 0; padding: 0 12px; font: 600 16px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; background: transparent; outline: none\"></span></label>\n          <label style=\"display: flex; flex-direction: column; gap: 6px; font-size: 12.5px; font-weight: 700; color: #4A5468\">Email (tiket &amp; konfirmasi dikirim ke sini)<input type=\"email\" inputmode=\"email\" autocomplete=\"email\" value=\"{{email}}\" onChange=\"{{setEmail}}\" placeholder=\"nama@gmail.com\" style=\"height: 50px; box-sizing: border-box; border: 1.5px solid #D5D9E0; border-radius: 12px; padding: 0 14px; font: 600 16px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; background: #FFFFFF; width: 100%\"></label>\n      <div style=\"display: flex; gap: 8px; align-items: flex-start; font-size: 12px; line-height: 17px; color: #4A5468\"><span>💬</span><span>{{waNote}}</span></div>\n    </div>\n  </section>\n  </sc-if>\n\n  <section style=\"padding: 16px 16px 0\">\n    <div style=\"background: #FFFFFF; border-radius: 20px; box-shadow: 0 2px 12px rgba(31,43,77,.06); padding: 14px; display: flex; flex-direction: column; gap: 10px\">\n      <h2 style=\"margin: 0; font-size: 16px; font-weight: 800\">Pembayaran</h2>\n      <sc-for list=\"{{opts}}\" as=\"o\" hint-placeholder-count=\"1\">\n        <button type=\"button\" onClick=\"{{o.pick}}\" aria-pressed=\"{{o.on}}\" style=\"{{o.style}}\">\n          <span style=\"{{o.radio}}\"></span>\n          <span style=\"display: flex; flex-direction: column; gap: 2px; text-align: left; flex: 1\"><b style=\"font-size: 14px\">{{o.name}}</b><span style=\"font-size: 12px; color: #4A5468\">{{o.sub}}</span></span>\n          <b style=\"white-space: nowrap; font-size: 14.5px\">{{o.now}}</b>\n        </button>\n      </sc-for>\n      <div style=\"display: flex; gap: 12px; align-items: center; background: #F4F6F9; border-radius: 14px; padding: 10px 12px\">\n        <span style=\"width: 40px; height: 40px; border-radius: 12px; background: #FFFFFF; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 900; color: #0060AF; letter-spacing: .02em; flex-shrink: 0; box-shadow: 0 1px 3px rgba(31,43,77,.1)\">{{methodIc}}</span>\n        <div style=\"font-size: 12.5px; line-height: 18px; color: #4A5468\"><b style=\"color: #1F2B4D; font-size: 13.5px\">{{methodName}}</b><br>{{methodSub}}</div>\n      </div>\n      <sc-if value=\"{{holdText}}\"><div style=\"display: flex; justify-content: space-between; gap: 12px; font-size: 13px; background: #FFF6E5; border-radius: 12px; padding: 9px 12px; color: #5C3A00\"><span>⏳ Bayar sebelum</span><b>{{holdText}}</b></div></sc-if>\n    </div>\n  </section>\n\n  <section style=\"padding: 16px 16px 0\">\n    <sc-if value=\"{{affOpen}}\" not><button type=\"button\" onClick=\"{{openAff}}\" style=\"width: 100%; min-height: 50px; border-radius: 16px; border: 1.5px dashed #C5CBD4; background: #FFFFFF; display: flex; align-items: center; gap: 10px; padding: 0 14px; font: 700 14px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; cursor: pointer\"><span style=\"font-size: 17px\">🏷️</span><span style=\"flex: 1; text-align: left\">Punya kode mitra atau teman?</span><span style=\"color: #077A70; font-weight: 800\">Pakai</span></button></sc-if>\n    <sc-if value=\"{{affOpen}}\">\n    <div style=\"background: #FFFFFF; border-radius: 20px; box-shadow: 0 2px 12px rgba(31,43,77,.06); padding: 14px; display: flex; flex-direction: column; gap: 8px\">\n      <label for=\"affmini\" style=\"font-size: 13px; font-weight: 800\">🏷️ Kode mitra atau teman</label>\n      <div style=\"display: flex; gap: 8px\"><input id=\"affmini\" type=\"text\" value=\"{{affmInput}}\" onChange=\"{{affmSet}}\" placeholder=\"Contoh: VKTEH\" style=\"flex: 1; min-width: 0; height: 48px; box-sizing: border-box; border: 1.5px solid #D5D9E0; border-radius: 12px; padding: 0 12px; font: 800 15px 'Plus Jakarta Sans', sans-serif; letter-spacing: 0.06em; color: #1F2B4D; background: #FFFFFF; text-transform: uppercase\"><button type=\"button\" onClick=\"{{affmApply}}\" style=\"height: 48px; padding: 0 16px; border: 0; border-radius: 12px; background: #1F2B4D; color: #FFFFFF; font: 800 14px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">{{affmBtn}}</button></div>\n      <sc-if value=\"{{affmOk}}\"><div style=\"padding: 10px 12px; border-radius: 10px; background: #E3F7F5; font-size: 13px; line-height: 19px; color: #055C55\"><b>{{affmTitle}}</b> · {{affmSub}}</div></sc-if>\n      <sc-if value=\"{{affmBad}}\"><div style=\"padding: 10px 12px; border-radius: 10px; background: #FFF1D6; font-size: 13px; line-height: 19px; color: #5C3A00\">{{affmBad}}</div></sc-if>\n    </div>\n    </sc-if>\n  </section>\n\n  <sc-if value=\"{{sim}}\">\n  <section style=\"padding: 16px 16px 0\">\n    <div style=\"border: 2px solid #1F2B4D; border-radius: 16px; padding: 14px 16px; display: flex; flex-direction: column; gap: 10px; background: #FFFFFF\">\n      <div style=\"font-size: 14px; line-height: 20px\"><b>Tagihan {{simCode2}} dibuat · {{simAmount}}</b><br><span style=\"color: #4A5468\">Pembayaran masih mode simulasi. Tekan tombol di bawah untuk mencatat pembayaran berhasil.</span></div>\n      <button type=\"button\" onClick=\"{{simulate}}\" disabled=\"{{busy}}\" style=\"height: 48px; border-radius: 12px; border: 1px solid #1F2B4D; background: #FFFFFF; color: #1F2B4D; font: 700 15px 'Plus Jakarta Sans', sans-serif; cursor: pointer; width: 100%\">Simulasikan pembayaran berhasil</button>\n    </div>\n  </section>\n  </sc-if>\n\n  <section style=\"padding: 16px 16px 0\">\n    <div style=\"background: #FFFFFF; border-radius: 20px; padding: 4px 14px\">\n      <sc-for list=\"{{policy}}\" as=\"r\"><div style=\"display: flex; gap: 12px; align-items: flex-start; padding: 11px 0; border-bottom: 1px solid #F0F2F5\"><span style=\"font-size: 17px; width: 24px; text-align: center; line-height: 20px\">{{r.ic}}</span><div style=\"font-size: 13px; line-height: 18px\"><b>{{r.h}}</b><br><span style=\"color: #4A5468\">{{r.t}}</span></div></div></sc-for>\n    </div>\n  </section>\n  <sc-if value=\"{{error}}\"><div role=\"alert\" style=\"margin: 14px 16px 0; font-size: 13px; line-height: 19px; color: #A12A1F; background: #FDECEA; border-radius: 12px; padding: 10px 12px\">{{error}}</div></sc-if>\n  <div style=\"height: 22px\"></div>\n  <div style=\"position: sticky; bottom: 0; z-index: 5; margin-top: auto; background: #FFFFFF; border-top: 1px solid #E6E8EC; box-shadow: 0 -6px 18px rgba(31,43,77,.06); padding: 12px 16px 14px; display: flex; flex-direction: column; gap: 8px\">\n    <div style=\"display: flex; align-items: center; gap: 12px\"><div style=\"flex: 1; min-width: 0\"><div style=\"font-size: 11.5px; color: #4A5468\">{{payLabel}}</div><b style=\"font-size: 19px\">{{payNowText}}</b></div><button type=\"button\" onClick=\"{{go}}\" disabled=\"{{cant}}\" style=\"{{btnStyle}}\">{{btnLabel}}</button></div>\n    <div style=\"font-size: 11px; line-height: 15px; color: #6B7385; text-align: center\">🔒 Dengan memesan, Anda setuju dengan <a href=\"Bantuan.dc.html?tab=syarat\">ketentuan</a> dan <a href=\"Bantuan.dc.html?tab=privasi\">kebijakan privasi</a>.</div>\n  </div>\n  </sc-if>\n</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{\"$preview\":{\"width\":390,\"height\":1300}}'>\nclass Component extends DCLogic {\n/* Pembayaran untuk Experience & mobil + sopir.\n   Tanpa ?id → draf dari RA.ctx().stay (penginapan) atau RA.ctx().exp (mobil + sopir, dari MobilSopirPaket): isi nama + WA, OTP bila belum masuk,\n   create_booking → set_payment_option → create_payment → pay.  Dengan ?id=<booking> → bayar booking yang sudah ada (DP/lunas/sisa). */\nstate = { mode: null, missing: null, draft: null, q: null, b: null, full: true, name: '', phone: '', code: '', otpStep: false, norm: null, simCodeOtp: '', sim: null, error: '' };\nasync componentDidMount() {\n  const id = this.params.id;\n  const cust = RA.isLoggedIn() ? await RA.customer().catch(() => null) : null;\n  if (cust) this.setState({ name: cust.name || '', phone: cust.phone ? String(cust.phone).replace(/^62/, '') : '' });\n  if (id) return this.loadBooking(id);\n  const c = RA.ctx();\n  if (c.exp && c.exp.kind === 'car' && this.params.kind === 'car') return this.loadDraft(c.exp);\n  if (c.stay && c.stay.product_id) return this.loadStayDraft(c.stay);\n  this.setState({ missing: 'Belum ada pesanan untuk dibayar. Pilih penginapan atau paket dulu.' });\n}\nasync loadStayDraft(st) {\n  const list = await RA.call('experience_catalog', { p_category: 'penginapan' }).catch(() => []);\n  const p = list.find(x => x.id === st.product_id);\n  if (!p || !p.branch) { this.setState({ missing: 'Penginapan tidak ditemukan.' }); return; }\n  const s = new Date(st.in + 'T' + p.checkin + ':00+07:00');\n  const o = new Date(st.in + 'T00:00:00'); o.setDate(o.getDate() + Math.max(1, st.nights || 1));\n  const e = new Date(RA.iso(o) + 'T' + p.checkout + ':00+07:00');\n  const addons = await RA.call('stay_addons', { p_product: p.id }).catch(() => []);\n  const ids = (st.addons || []).filter(id => addons.some(a => a.id === id && a.same_branch));\n  this.loadDraft({ kind: 'stay', product: p, branch_id: p.branch.id, start_at: s.toISOString(), end_at: e.toISOString(), guests: st.guests,\n    items: [{ product_id: p.id, quantity: 1 }].concat(ids.map(x => ({ product_id: x, quantity: 1 }))), nights: RA.nights(st.in + 'T00:00:00', o) });\n}\nasync loadDraft(d) {\n  const q = await RA.rpc('quote', { p: { branch_id: d.branch_id, start_at: d.start_at, end_at: d.end_at, items: d.items } });\n  if (!RA_ALIVE(this)) return;\n  if (q.error) { this.setState({ missing: q.error.message }); return; }\n  this.setState({ mode: 'draft', draft: d, q: q.data, full: q.data.dp_percent == null });\n}\nasync loadBooking(id) {\n  if (!RA.isLoggedIn()) { RA.setCtx({ next: 'InapBayar?id=' + id }); RA.go('Login'); return; }\n  const { data: b } = await RA.from('bookings').select('*,booking_items(product_id,unit_id,status,line_total,products(name,photos,categories(slug))),branches(name,code)').eq('id', id).maybeSingle();\n  if (!RA_ALIVE(this)) return;\n  if (!b) { this.setState({ missing: 'Booking tidak ditemukan.' }); return; }\n  if (+b.paid_amount >= +b.total + +b.late_fee + +b.damage_fee && b.status !== 'awaiting_payment') return this.toTicket(b);\n  this.setState({ mode: 'booking', b, name: b.guest_name || this.state.name, full: +b.dp_amount >= +b.total });\n}\nkindOf(code) { return /^RM-/.test(code || '') ? 'stay' : /^JP-/.test(code || '') ? 'jeep' : /^MS-/.test(code || '') ? 'car' : 'other'; }\nasync toTicket(b) {\n  RA.setCtx({ exp: null });\n  const k = this.kindOf(b.code);\n  if (k === 'stay') return RA.go('InapTiket', { id: b.id });\n  if (k === 'jeep') return RA.go('JeepTiket', { id: b.id });\n  if (k === 'car') {\n    const { data: rs } = await RA.from('trip_requests').select('id').eq('booking_id', b.id).limit(1); const r = (rs || [])[0];\n    return RA.go('MobilSopirStatus', r ? { id: r.id } : { booking: b.id });\n  }\n  return RA.go('Status', { id: b.id });\n}\nasync login() {\n  const s = this.state;\n  if (!s.otpStep) {\n    const n = RA.normPhone(s.phone);\n    if (!n) throw new Error('Nomor HP tidak valid. Contoh: 0812 3456 7890');\n    const r = await RA.requestOtp(n, 'login');\n    this.setState({ otpStep: true, norm: n, simCodeOtp: r.simulation ? r.code : '', code: '' });\n    return false;\n  }\n  const code = String(s.code).replace(/\\D/g, '');\n  if (code.length !== 6) throw new Error('Kode terdiri dari 6 angka.');\n  await RA.verifyOtp(s.norm, code, 'login');\n  await RA.ensureCustomer(s.name.trim(), null);\n  this.setState({ otpStep: false });\n  return true;\n}\nasync submit() {\n  const s = this.state;\n  this.setState({ error: '' });\n  let b = s.b;\n  if (s.mode === 'draft') {\n    if (s.name.trim().length < 3) throw new Error('Isi nama pemesan (minimal 3 huruf).');\n    const n = RA.normPhone(s.phone);\n    if (!n) throw new Error('Nomor HP tidak valid. Contoh: 812 3456 7890');\n    const em = String(s.email || '').trim().toLowerCase();\n      if (em && !/^[^@\\s]+@[^@\\s]+\\.[^@\\s]{2,}$/.test(em)) throw new Error('Format email belum benar.');\n      if (!em && !RA.isLoggedIn()) throw new Error('Isi email. Tiket dan konfirmasi dikirim ke email.');\n      if (!RA.isLoggedIn()) await RA.guestSession();\n    { const c = await RA.customer().catch(() => null); if (!c || !c.name) await RA.ensureCustomer(s.name.trim(), null); }\n      if (em) await RA.call('set_my_email', { p_email: em }).catch(() => {});\n    const d = s.draft;\n    await RA.call('record_consent', { p_kinds: ['terms', 'privacy'], p_ua: navigator.userAgent }).catch(() => {});\n    const res = await RA.call('create_booking', { p: { branch_id: d.branch_id, start_at: d.start_at, end_at: d.end_at, items: d.items,\n      guests: d.guests || null, guest_name: s.name.trim(), guest_phone: n, pickup_point: d.pickup_point || null, notes: d.notes || null, source: 'web', ...RA.affParams() } });\n    if (d.unit_id) await RA.call('set_booking_unit', { p_booking: res.id, p_unit: d.unit_id }).catch(e => RA.toast(RA.friendly(e.message)));\n    if (d.kind === 'stay') RA.setCtx({ stay: Object.assign({}, RA.ctx().stay, { addons: [] }) });\n    RA.setCtx({ exp: null });\n    try { history.replaceState(null, '', '#/InapBayar?id=' + res.id); } catch (e) {}\n    const { data } = await RA.from('bookings').select('*,booking_items(product_id,unit_id,status,line_total,products(name,photos,categories(slug))),branches(name,code)').eq('id', res.id).single();\n    b = data; this.setState({ mode: 'booking', b });\n  }\n  if (b.status === 'awaiting_payment' && +b.paid_amount === 0 && b.dp_percent != null) {\n    const r = await RA.call('set_payment_option', { p_booking: b.id, p_full: !!this.state.full });\n    b = Object.assign({}, b, { dp_amount: r.dp_amount }); this.setState({ b });\n  }\n  if (b.status === 'awaiting_payment' && !RA.simulation()) return RA.go('Bayar', { 