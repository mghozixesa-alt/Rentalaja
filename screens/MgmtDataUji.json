{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Hapus data uji</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0}\n#okRoot{max-width:1180px;margin:0 auto;padding:24px 24px 48px;box-sizing:border-box;display:flex;flex-direction:column;gap:16px}\n#okRoot h1{margin:0;font-size:28px;font-weight:800;letter-spacing:-.01em}\n#okRoot h2{margin:0 0 10px;font-size:17px;font-weight:800}\n#okRoot .ok-sub{color:#4A5468;font-size:14px;margin-top:4px}\n#okRoot .ok-row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}\n#okRoot .ok-btn{height:40px;padding:0 14px;border-radius:12px;border:1px solid #1F2B4D;background:#FFFFFF;color:#1F2B4D;font:700 14px 'Plus Jakarta Sans',system-ui,sans-serif;cursor:pointer;display:inline-flex;align-items:center;gap:6px;text-decoration:none}\n#okRoot .ok-btn.pri{background:#09BEAF;border-color:#09BEAF;color:#1F2B4D}\n#okRoot .ok-btn.sm{height:32px;padding:0 10px;font-size:13px;border-radius:10px;border-color:#D5D9E0}\n#okRoot .ok-btn.sm.pri{border-color:#09BEAF}\n#okRoot .ok-tabs{display:flex;gap:6px;background:#FFFFFF;border:1px solid #E6E8EC;border-radius:14px;padding:5px;width:max-content;max-width:100%;overflow-x:auto}\n#okRoot .ok-tab{height:36px;padding:0 16px;border-radius:10px;border:0;background:transparent;color:#4A5468;font:700 14px 'Plus Jakarta Sans',system-ui,sans-serif;cursor:pointer;white-space:nowrap;display:inline-flex;align-items:center;gap:6px}\n#okRoot .ok-tab.on{background:#1F2B4D;color:#FFFFFF}\n#okRoot .ok-tab i{font-style:normal;background:#D93025;color:#FFFFFF;border-radius:9px;font-size:11px;padding:1px 6px}\n#okRoot .ok-wk{width:100%;border-collapse:separate;border-spacing:4px;table-layout:fixed}\n#okRoot .ok-wk th{text-align:center;border:0;padding:2px}#okRoot .ok-wk th:first-child{text-align:left;width:150px}\n#okRoot .ok-wk th small{display:block;font-weight:600;color:#8A93A3}#okRoot .ok-wk th.today{color:#077A70}\n#okRoot .ok-wk td{border:0;padding:0}\n#okRoot .ok-wk td.nm{font-weight:800;font-size:13.5px;padding-right:6px;vertical-align:middle}#okRoot .ok-wk td.nm small{display:block;font-weight:600;color:#4A5468;font-size:11.5px}\n#okRoot .ok-wk tr.grp td{padding:10px 2px 2px;font-size:11.5px;font-weight:800;color:#8A93A3;letter-spacing:.05em;text-transform:uppercase}\n#okRoot .ok-cell{display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;box-sizing:border-box;width:100%;min-height:46px;border-radius:10px;border:1.5px dashed #D5D9E0;background:#FFFFFF;font:700 12.5px/16px 'Plus Jakarta Sans',system-ui,sans-serif;color:#8A93A3;cursor:pointer;padding:5px 2px}\n#okRoot .ok-cell.P{background:#E3F7F5;color:#077A70;border:0}#okRoot .ok-cell.S{background:#E5EEF9;color:#1E5AA8;border:0}#okRoot .ok-cell.M{background:#EDE7FB;color:#5B3FB0;border:0}\n#okRoot .ok-cell.L{background:#F4F6F9;color:#9AA2B1;border:0}#okRoot .ok-cell.C{background:#FFF6E0;color:#7A5200;border:0;cursor:default}#okRoot .ok-cell.H{background:#FBE9E7;color:#A12A1F;border:0}\n#okRoot .ok-cell small{display:block;font-weight:600;font-size:11px;opacity:.85}\n#okRoot .ok-warn{background:#FFF6E0;color:#7A5200;font-size:13px;border-radius:10px;padding:8px 12px;margin-top:6px}\n#okRoot .ok-leg{display:flex;gap:12px;flex-wrap:wrap;font-size:12px;color:#4A5468;margin-top:10px;align-items:center}#okRoot .ok-leg i{width:14px;height:14px;border-radius:4px;display:inline-block;vertical-align:-2px;margin-right:4px}\n#okRoot .ok-trk{display:flex;align-items:center;gap:4px;margin-top:6px;font-size:11px;font-weight:700;flex-wrap:wrap}#okRoot .ok-trk em{font-style:normal;padding:2px 8px;border-radius:999px;background:#EEF0F3;color:#8A93A3}#okRoot .ok-trk em.d{background:#E3F7F5;color:#077A70}#okRoot .ok-trk em.n{background:#1F2B4D;color:#FFFFFF}\n#okRoot .ok-av{width:36px;height:36px;border-radius:18px;background:#E3F7F5;color:#077A70;font-weight:800;font-size:12.5px;display:flex;align-items:center;justify-content:center;flex-shrink:0}\n#okRoot .ok-kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}\n#okRoot .ok-kpi{background:#FFFFFF;border:1px solid #E6E8EC;border-radius:16px;padding:14px 16px}\n#okRoot .ok-kpi span{font-size:13px;font-weight:700;color:#4A5468}#okRoot .ok-kpi b{display:block;font-size:26px;font-weight:800;margin:2px 0}#okRoot .ok-kpi small{font-size:12.5px;color:#4A5468}\n#okRoot .ok-card{background:#FFFFFF;border:1px solid #E6E8EC;border-radius:18px;padding:18px}\n#okRoot .ok-card.hot{border-color:#09BEAF;background:#F1FBFA}\n#okRoot .ok-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:16px}\n#okRoot table{width:100%;border-collapse:collapse;font-size:14px}\n#okRoot th{text-align:left;font-size:12.5px;color:#4A5468;font-weight:700;padding:8px 10px;border-bottom:1px solid #E6E8EC}\n#okRoot td{padding:10px;border-bottom:1px solid #EEF0F3;vertical-align:top}\n#okRoot .ok-scroll{overflow-x:auto}\n#okRoot .ok-chip{display:inline-flex;align-items:center;padding:3px 9px;border-radius:999px;font-size:12px;font-weight:700;background:#EEF0F3;color:#4A5468;white-space:nowrap}\n#okRoot .ok-chip.g{background:#E3F7F5;color:#077A70}#okRoot .ok-chip.y{background:#FFF6E0;color:#7A5200}#okRoot .ok-chip.r{background:#FBE9E7;color:#A12A1F}#okRoot .ok-chip.b{background:#E5EEF9;color:#1E5AA8}\n#okRoot .ok-li{display:flex;gap:10px;align-items:center;flex-wrap:wrap;padding:10px 0;border-top:1px solid #EEF0F3}#okRoot .ok-li:first-child{border-top:0}\n#okRoot .ok-mut{color:#4A5468;font-size:12.5px}\n#okRoot details summary{cursor:pointer;list-style:none}#okRoot details summary::-webkit-details-marker{display:none}\n.ok-modal{position:fixed;inset:0;background:rgba(31,43,77,.45);display:flex;align-items:center;justify-content:center;z-index:1000;padding:16px}\n.ok-modal form{background:#FFFFFF;border-radius:18px;padding:20px;width:100%;max-width:480px;max-height:90vh;overflow:auto;display:flex;flex-direction:column;gap:12px;font-family:'Plus Jakarta Sans',system-ui,sans-serif;color:#1F2B4D}\n.ok-modal h3{margin:0;font-size:18px;font-weight:800}\n.ok-modal label{display:flex;flex-direction:column;gap:5px;font-size:13px;font-weight:700}\n.ok-modal input,.ok-modal select,.ok-modal textarea{height:42px;border:1px solid #D5D9E0;border-radius:10px;padding:0 10px;font:500 14px 'Plus Jakarta Sans',system-ui,sans-serif;color:#1F2B4D;background:#FFFFFF}\n.ok-modal textarea{height:auto;padding:10px}\n.ok-modal .g2{display:grid;grid-template-columns:1fr 1fr;gap:10px}\n.ok-modal .act{display:flex;gap:10px;justify-content:flex-end}\n.ok-modal .act button{height:42px;padding:0 16px;border-radius:12px;border:1px solid #D5D9E0;background:#FFFFFF;font:700 14px 'Plus Jakarta Sans',system-ui,sans-serif;cursor:pointer;color:#1F2B4D}\n.ok-modal .act button.pri{background:#09BEAF;border-color:#09BEAF}\n.ok-modal .err{color:#A12A1F;font-size:13px;font-weight:700}\n@media (max-width:900px){#okRoot{padding:16px 16px 96px}#okRoot .ok-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}#okRoot .ok-grid{grid-template-columns:minmax(0,1fr)}#okRoot h1{font-size:23px}}\n</style>\n</helmet>\n<div style=\"min-height: 100vh; box-sizing: border-box; background: #F4F6F9; color: #1F2B4D; font-family: 'Plus Jakarta Sans', system-ui, sans-serif\">\n  <div id=\"okRoot\"><div style=\"padding: 40px; color: #4A5468\">Memuat…</div></div>\n</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{}'>\nclass Component extends DCLogic {\nstate = {};\nrenderVals() { return {}; }\ncomponentDidMount() { this.sel = {}; this.f = 'uji'; this.q = ''; this.paid = false; this.load(); }\nesc(s) { return String(s == null ? '' : s).replace(/[&<>\"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c])); }\nbox() { return document.getElementById('okRoot'); }\ndt(t) { if (!t) return '—'; const d = new Date(t); return d.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', timeZone: 'Asia/Jakarta' }) + ' ' + d.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Jakarta' }).replace(':', '.'); }\nasync load() {\n  const st = await RA.staff(); const el = this.box(); if (!el) return;\n  this.own = !!st && (st.role === 'owner' || st.realRole === 'owner');\n  if (!st || !(this.own || RA.can('pos.bookings') || RA.can('exp.bookings'))) { el.innerHTML = '<div class=\"ok-card\">Anda tidak punya akses ke halaman ini.</div>'; return; }\n  const r = await RA.from('bookings').select('id,code,status,channel,created_at,start_at,total,paid_amount,guest_name,branches(name),booking_items(products(name)),payments(status,amount)').order('created_at', { ascending: false }).limit(300);\n  if (r.error) { el.innerHTML = '<div class=\"ok-card\">Gagal memuat: ' + this.esc(r.error.message) + '</div>'; return; }\n  this.B = r.data || []; this.draw();\n}\nlbl(s) { return ({ draft: 'Draf', awaiting_payment: 'Belum bayar', pending_verification: 'Cek data', confirmed: 'Terkonfirmasi', active: 'Sedang dipakai', returned: 'Sudah kembali', completed: 'Selesai', cancelled: 'Dibatalkan', expired: 'Kedaluwarsa', rejected: 'Ditolak' })[s] || s; }\nlocked(b) { return ['active', 'returned', 'completed'].indexOf(b.status) > -1; }\npaidOf(b) { return (b.payments || []).filter(p => p.status === 'paid').reduce((a, p) => a + (+p.amount || 0), 0); }\nlist() {\n  const q = this.q.trim().toLowerCase();\n  return (this.B || []).filter(b => {\n    if (this.f === 'uji' && ['cancelled', 'expired', 'rejected', 'draft'].indexOf(b.status) < 0) return false;\n    if (this.f === 'belum' && ['awaiting_payment', 'pending_verification'].indexOf(b.status) < 0) return false;\n    if (!q) return true;\n    return (b.code + ' ' + (b.guest_name || '') + ' ' + ((b.branches || {}).name || '')).toLowerCase().indexOf(q) > -1; });\n}\ndraw() {\n  const el = this.box(); if (!el) return; const L = this.list(), S = this.sel;\n  const picked = (this.B || []).filter(b => S[b.id]), nPaid = picked.filter(b => this.paidOf(b) > 0).length;\n  const F = [['uji', 'Batal & kedaluwarsa'], ['belum', 'Belum bayar'], ['semua', 'Semua']];\n  const rows = L.map(b => { const lk = this.locked(b), pd = this.paidOf(b), it = (b.booking_items || []).map(i => i.products && i.products.name).filter(Boolean).join(', ');\n    return '<tr style=\"' + (lk ? 'opacity:.5' : '') + '\"><td style=\"padding:10px 8px;border-bottom:1px solid #EEF0F3;width:28px\"><input type=\"checkbox\" data-id=\"' + b.id + '\"' + (S[b.id] ? ' checked' : '') + (lk ? ' disabled title=\"Sedang berjalan / selesai — tidak bisa dihapus\"' : '') + ' style=\"width:18px;height:18px\"></td>'\n      + '<td style=\"padding:10px 8px;border-bottom:1px solid #EEF0F3\"><b>' + this.esc(b.code) + '</b><div class=\"ok-mut\" style=\"font-size:12px\">masuk ' + this.dt(b.created_at) + ' · ' + this.esc(b.channel || '') + '</div></td>'\n      + '<td style=\"padding:10px 8px;border-bottom:1px solid #EEF0F3\">' + this.esc(it || '—') + '<div class=\"ok-mut\" style=\"font-size:12px\">' + this.esc((b.branches || {}).name || '') + ' · mulai ' + this.dt(b.start_at) + '</div></td>'\n      + '<td style=\"padding:10px 8px;border-bottom:1px solid #EEF0F3\">' + this.esc(b.guest_name || '—') + '</td>'\n      + '<td style=\"padding:10px 8px;border-bottom:1px solid #EEF0F3;white-space:nowrap\">' + RA.rp(b.total || 0) + (pd ? '<div style=\"font-size:12px;font-weight:800;color:#A12A1F\">sudah bayar ' + RA.rp(pd) + '</div>' : '') + '</td>'\n      + '<td style=\"padding:10px 8px;border-bottom:1px solid #EEF0F3\"><span style=\"display:inline-flex;height:24px;align-items:center;padding:0 9px;border-radius:12px;font-size:12px;font-weight:800;background:' + (lk ? '#EEF0F3' : b.status === 'confirmed' ? '#E4F2EA' : '#FFF1D6') + ';color:' + (lk ? '#4A5468' : b.status === 'confirmed' ? '#1E6B45' : '#8A4B00') + '\">' + this.lbl(b.status) + '</span></td></tr>'; }).join('');\n  const can = L.filter(b => !this.locked(b)), allOn = can.length && can.every(b => S[b.id]);\n  el.innerHTML = '<div><h1>Hapus data uji</h1><div class=\"ok-sub\">Untuk membersihkan booking percobaan. Booking yang sedang dipakai, sudah kembali, atau selesai tidak bisa dihapus. ' + (this.own ? 'Sebagai owner, penghapusan langsung dijalankan.' : 'Penghapusan diajukan dulu dan baru dijalankan setelah disetujui owner di Kotak Persetujuan.') + ' Semua penghapusan tercatat di Log audit.</div></div>'\n    + '<div class=\"ok-card ok-row\" style=\"justify-content:space-between\"><div class=\"ok-row\"><div class=\"ok-tabs\">' + F.map(([k, l]) => '<button class=\"ok-tab' + (this.f === k ? ' on' : '') + '\" data-f=\"' + k + '\">' + l + '</button>').join('') + '</div>'\n    + '<input id=\"bq\" placeholder=\"Cari kode, nama, cabang\" value=\"' + this.esc(this.q) + '\" style=\"height:40px;border:1px solid #D5D9E0;border-radius:12px;padding:0 12px;font:500 14px \\'Plus Jakarta Sans\\',sans-serif;min-width:220px\"></div>'\n    + '<label class=\"ok-row\" style=\"font-size:14px;font-weight:700;gap:6px\"><input type=\"checkbox\" id=\"ball\"' + (allOn ? ' checked' : '') + ' style=\"width:18px;height:18px\"> Pilih semua yang tampil (' + can.length + ')</label></div>'\n    + '<div class=\"ok-card\" style=\"overflow-x:auto;padding:6px 14px\"><table style=\"width:100%;min-width:760px;border-collapse:collapse;font-size:14px\"><thead><tr style=\"text-align:left;color:#4A5468;font-size:12px\"><th></th><th style=\"padding:8px\">Booking</th><th style=\"padding:8px\">Barang</th><th style=\"padding:8px\">Pelanggan</th><th style=\"padding:8px\">Total</th><th style=\"padding:8px\">Status</th></tr></thead><tbody>' + (rows || '<tr><td colspan=\"6\" style=\"padding:22px;text-align:center;color:#4A5468\">Tidak ada booking di pilihan ini.</td></tr>') + '</tbody></table></div>'\n    + (picked.length ? '<div class=\"ok-card hot\" style=\"position:sticky;bottom:12px;display:flex;flex-direction:column;gap:10px;border:1.5px solid #E5534B\"><b style=\"font-size:15px\">' + picked.length + ' booking dipilih' + (nPaid ? ' · ' + nPaid + ' sudah ada pembayaran' : '') + '</b>'\n      + (nPaid ? '<label class=\"ok-row\" style=\"font-size:13px;gap:6px;color:#A12A1F;font-weight:700\"><input type=\"checkbox\" id=\"bpaid\"' + (this.paid ? ' checked' : '') + '> Termasuk yang sudah bayar (pastikan memang data uji; uang yang sudah tercatat di Keuangan Pokama dibatalkan terpisah)</label>' : '')\n      + (this.own ? '' : '<input id=\"bwhy\" placeholder=\"Alasan, mis. booking percobaan saat uji sistem\" value=\"' + this.esc(this.why || '') + '\" style=\"height:40px;border:1px solid #D5D9E0;border-radius:12px;padding:0 12px;font:500 14px \\'Plus Jakarta Sans\\',sans-serif\">')\n      + '<div class=\"ok-row\"><input id=\"bok\" placeholder=\"Ketik HAPUS untuk konfirmasi\" style=\"height:40px;border:1px solid #D5D9E0;border-radius:12px;padding:0 12px;font:600 14px \\'Plus Jakarta Sans\\',sans-serif;width:240px\"><button class=\"ok-btn\" id=\"bgo\" style=\"background:#A12A1F;border-color:#A12A1F;color:#FFFFFF\">' + (this.own ? 'Hapus permanen' : 'Ajukan hapus ke owner') + '</button><button class=\"ok-btn sm\" id=\"bclr\">Batal pilih</button></div></div>' : '');\n  el.onclick = ev => this.click(ev); el.oninput = ev => { if (ev.target.id === 'bwhy') { this.why = ev.target.value; return; } if (ev.target.id === 'bq') { this.q = ev.target.value; clearTimeout(this._t); this._t = setTimeout(() => { this.draw(); const i = document.getElementById('bq'); if (i) { i.focus(); i.setSelectionRange(i.value.length, i.value.length); } }, 250); } };\n  el.onchange = ev => { const t = ev.target;\n    if (t.dataset && t.dataset.id) { if (t.checked) this.sel[t.dataset.id] = 1; else delete this.sel[t.dataset.id]; this.draw(); }\n    else if (t.id === 'ball') { can.forEach(b => { if (t.checked) this.sel[b.id] = 1; else delete this.sel[b.id]; }); this.draw(); }\n    else if (t.id === 'bpaid') this.paid = t.checked; };\n}\nasync click(ev) {\n  const t = ev.target.closest('button'); if (!t) return;\n  if (t.dataset.f) { this.f = t.dataset.f; return this.draw(); }\n  if (t.id === 'bclr') { this.sel = {}; return this.draw(); }\n  if (t.id === 'bgo') {\n    const ok = (document.getElementById('bok') || {}).value; if (String(ok || '').trim().toUpperCase() !== 'HAPUS') return RA.toast('Ketik HAPUS dulu untuk konfirmasi.', 'bad');\n    if (!this.own && !String(this.why || '').trim()) return RA.toast('Tulis alasan penghapusan.', 'bad');\n    t.disabled = true;\n    const r = await RA.rpc('request_booking_purge', { p_ids: Object.keys(this.sel), p_reason: this.why || null, p_include_paid: !!this.paid });\n    if (r.error) { t.disabled = false; return RA.toast(RA.friendly ? RA.friendly(r.error.message) : r.error.message, 'bad'); }\n    if (r.data && r.data.deleted != null) RA.toast(r.data.deleted + ' booking dihapus', 'good');\n    else RA.toast((r.data && r.data.requested) + ' booking diajukan · menunggu persetujuan owner', 'good');\n    this.sel = {}; this.paid = false; this.why = ''; this.load();\n  }\n}\n}\n</script>\n</body>\n</html>"}