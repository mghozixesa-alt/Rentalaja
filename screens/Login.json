{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Masuk atau daftar</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0}\na{color:#1F2B4D}a:hover{color:#000}\n</style>\n</helmet>\n<div style=\"width: 390px; height: 844px; box-sizing: border-box; background: #F4F6F9; color: #1F2B4D; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; flex-direction: column; position: relative; overflow: hidden\">\n<header style=\"display: flex; align-items: center; gap: 8px; padding: 10px 12px; border-bottom: 1px solid #E6E8EC\">\n    <a href=\"{{backHref}}\" aria-label=\"Kembali\" style=\"width: 44px; height: 44px; display: flex; align-items: center; justify-content: center\">\n      <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1F2B4D\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M15 6l-6 6 6 6\"/></svg>\n    </a>\n    <div style=\"display: flex; flex-direction: column\"><div style=\"font-size: 18px; font-weight: 800\">Masuk atau daftar</div></div>\n  </header>\n  <sc-if value=\"{{isPhone}}\" hint-placeholder-val=\"{{true}}\">\n    <section style=\"padding: 28px 20px 0; display: flex; flex-direction: column; gap: 18px\">\n      <img src=\"logo.png\" alt=\"Rentalaja\" style=\"height: 34px; width: auto; align-self: flex-start; display: block\">\n      <div style=\"display: flex; flex-direction: column; gap: 8px\">\n        <h1 style=\"margin: 0; font-size: 26px; line-height: 32px; font-weight: 800\">{{phoneTitle}}</h1>\n        <p style=\"margin: 0; font-size: 15px; line-height: 22px; color: #4A5468\">{{phoneIntro}}</p>\n      </div>\n      <sc-if value=\"{{hasGoogle}}\" hint-placeholder-val=\"{{false}}\">\n        <button type=\"button\" onClick=\"{{google}}\" disabled=\"{{busy}}\" style=\"height: 52px; border-radius: 12px; border: 1px solid #D5D9E0; background: #FFFFFF; color: #1F2B4D; font: 800 16px 'Plus Jakarta Sans', sans-serif; display: flex; align-items: center; justify-content: center; gap: 10px; cursor: pointer; width: 100%\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 48 48\" aria-hidden=\"true\"><path fill=\"#FFC107\" d=\"M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z\"/><path fill=\"#FF3D00\" d=\"M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z\"/><path fill=\"#4CAF50\" d=\"M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z\"/><path fill=\"#1976D2\" d=\"M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z\"/></svg>Masuk dengan Google</button>\n        <div style=\"display: flex; align-items: center; gap: 10px; font-size: 12px; font-weight: 700; color: #8A93A6\"><span style=\"flex: 1; height: 1px; background: #E6E8EC\"></span>atau pakai kode lewat email<span style=\"flex: 1; height: 1px; background: #E6E8EC\"></span></div>\n      </sc-if>\n      <label style=\"display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 700; color: #4A5468\">Email\n        <input type=\"email\" inputmode=\"email\" autocomplete=\"email\" autocapitalize=\"off\" spellcheck=\"false\" placeholder=\"nama@gmail.com\" value=\"{{phone}}\" onChange=\"{{setPhone}}\" style=\"height: 48px; box-sizing: border-box; border: 1px solid #D5D9E0; border-radius: 10px; padding: 0 12px; font: 600 16px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; background: #FFFFFF; width: 100%\">\n      </label>\n      <sc-if value=\"{{error}}\"><div role=\"alert\" style=\"font-size: 13px; font-weight: 600; color: #A12A1F; background: #FDECEA; border-radius: 10px; padding: 10px 12px\">{{error}}</div></sc-if>\n      <button type=\"button\" onClick=\"{{toOtp}}\" disabled=\"{{busy}}\" style=\"height: 52px; border-radius: 12px; border: none; background: #09BEAF; color: #1F2B4D; font: 800 16px 'Plus Jakarta Sans', sans-serif; display: flex; align-items: center; justify-content: center; text-decoration: none; cursor: pointer; width: 100%\">{{sendLabel}}</button>\n      <div style=\"font-size: 12px; line-height: 18px; color: #4A5468\">Dengan lanjut, kamu setuju dengan <a href=\"Bantuan.dc.html\">syarat sewa dan kebijakan privasi</a> Rentalaja.</div>\n    </section>\n  </sc-if>\n\n  <sc-if value=\"{{isOtp}}\" hint-placeholder-val=\"{{false}}\">\n    <section style=\"padding: 28px 20px 0; display: flex; flex-direction: column; gap: 18px\">\n      <div style=\"display: flex; flex-direction: column; gap: 8px\">\n        <h1 style=\"margin: 0; font-size: 26px; line-height: 32px; font-weight: 800\">Masukkan kode</h1>\n        <p style=\"margin: 0; font-size: 15px; line-height: 22px; color: #4A5468\">6 digit dikirim ke email {{masked}}. Cek juga folder Spam/Promosi. <button type=\"button\" onClick=\"{{toPhone}}\" style=\"border: none; background: none; padding: 0; color: #077A70; font: 700 15px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">Ganti email</button></p>\n      </div>\n      <sc-if value=\"{{simCode}}\"><div style=\"font-size: 13px; line-height: 19px; color: #8A4B00; background: #FFF1D6; border-radius: 10px; padding: 10px 12px\"><b>Mode uji:</b> WhatsApp belum tersambung, jadi kodenya ditampilkan di sini: <b style=\"letter-spacing: 0.15em\">{{simCode}}</b></div></sc-if>\n      <label style=\"display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 700; color: #4A5468\">Kode masuk\n        <input type=\"text\" inputmode=\"numeric\" autocomplete=\"one-time-code\" maxlength=\"6\" value=\"{{code}}\" onChange=\"{{setCode}}\" style=\"height: 48px; box-sizing: border-box; border: 1px solid #D5D9E0; border-radius: 10px; padding: 0 12px; font: 600 16px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; background: #FFFFFF; width: 100%; height: 60px; font-size: 26px; letter-spacing: 0.5em; text-align: center\">\n      </label>\n      <sc-if value=\"{{error}}\"><div role=\"alert\" style=\"font-size: 13px; font-weight: 600; color: #A12A1F; background: #FDECEA; border-radius: 10px; padding: 10px 12px\">{{error}}</div></sc-if>\n      <button type=\"button\" onClick=\"{{verify}}\" disabled=\"{{busy}}\" style=\"height: 52px; border-radius: 12px; border: none; background: #09BEAF; color: #1F2B4D; font: 800 16px 'Plus Jakarta Sans', sans-serif; display: flex; align-items: center; justify-content: center; text-decoration: none; cursor: pointer; width: 100%\">{{verifyLabel}}</button>\n      <div style=\"display: flex; justify-content: space-between; font-size: 13px; color: #4A5468\">\n        <sc-if value=\"{{canResend}}\" not><span>Kirim ulang dalam {{resend}}</span></sc-if>\n        <sc-if value=\"{{canResend}}\"><button type=\"button\" onClick=\"{{toOtp}}\" style=\"border: none; background: none; padding: 0; color: #077A70; font: 700 13px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">Kirim ulang kode</button></sc-if>\n      </div>\n    </section>\n  </sc-if>\n\n  <sc-if value=\"{{isWa}}\" hint-placeholder-val=\"{{false}}\">\n    <section style=\"padding: 28px 20px 0; display: flex; flex-direction: column; gap: 18px\">\n      <div style=\"display: flex; flex-direction: column; gap: 8px\">\n        <h1 style=\"margin: 0; font-size: 26px; line-height: 32px; font-weight: 800\">Nomor HP</h1>\n        <p style=\"margin: 0; font-size: 15px; line-height: 22px; color: #4A5468\">Untuk kabar booking dan dihubungi cabang saat serah terima. Tidak ada kode yang dikirim.</p>\n      </div>\n      <label style=\"display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 700; color: #4A5468\">Nomor HP\n        <input type=\"tel\" inputmode=\"tel\" autocomplete=\"tel\" placeholder=\"0812 xxxx xxxx\" value=\"{{phone}}\" onChange=\"{{setPhone}}\" style=\"height: 48px; box-sizing: border-box; border: 1px solid #D5D9E0; border-radius: 10px; padding: 0 12px; font: 600 16px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; background: #FFFFFF; width: 100%\">\n      </label>\n      <sc-if value=\"{{error}}\"><div role=\"alert\" style=\"font-size: 13px; font-weight: 600; color: #A12A1F; background: #FDECEA; border-radius: 10px; padding: 10px 12px\">{{error}}</div></sc-if>\n      <button type=\"button\" onClick=\"{{saveWa}}\" disabled=\"{{busy}}\" style=\"height: 52px; border-radius: 12px; border: none; background: #09BEAF; color: #1F2B4D; font: 800 16px 'Plus Jakarta Sans', sans-serif; display: flex; align-items: center; justify-content: center; cursor: pointer; width: 100%\">Lanjut</button>\n    </section>\n  </sc-if>\n\n  <sc-if value=\"{{isWait}}\" hint-placeholder-val=\"{{false}}\">\n    <section style=\"padding: 60px 20px 0; display: flex; flex-direction: column; gap: 12px; align-items: center; text-align: center\">\n      <div style=\"font-size: 16px; font-weight: 700; color: #4A5468\">Menyiapkan akun…</div>\n      <sc-if value=\"{{error}}\"><div role=\"alert\" style=\"font-size: 13px; font-weight: 600; color: #A12A1F; background: #FDECEA; border-radius: 10px; padding: 10px 12px\">{{error}}</div></sc-if>\n    </section>\n  </sc-if>\n\n  <sc-if value=\"{{isName}}\" hint-placeholder-val=\"{{false}}\">\n    <section style=\"padding: 28px 20px 0; display: flex; flex-direction: column; gap: 18px\">\n      <div style=\"display: flex; flex-direction: column; gap: 8px\">\n        <h1 style=\"margin: 0; font-size: 26px; line-height: 32px; font-weight: 800\">Selamat datang</h1>\n        <p style=\"margin: 0; font-size: 15px; line-height: 22px; color: #4A5468\">Akun ini baru di Rentalaja. Isi nama sesuai KTP supaya verifikasi cepat.</p>\n      </div>\n      <label style=\"display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 700; color: #4A5468\">Nama sesuai KTP\n        <input type=\"text\" autocomplete=\"name\" placeholder=\"Nama lengkap\" value=\"{{name}}\" onChange=\"{{setName}}\" style=\"height: 48px; box-sizing: border-box; border: 1px solid #D5D9E0; border-radius: 10px; padding: 0 12px; font: 600 16px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; background: #FFFFFF; width: 100%\">\n      </label>\n      <label style=\"display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 700; color: #4A5468\">Kota domisili\n        <input type=\"text\" placeholder=\"Contoh: Garut\" value=\"{{city}}\" onChange=\"{{setCity}}\" style=\"height: 48px; box-sizing: border-box; border: 1px solid #D5D9E0; border-radius: 10px; padding: 0 12px; font: 600 16px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; background: #FFFFFF; width: 100%\">\n      </label>\n      <sc-if value=\"{{error}}\"><div role=\"alert\" style=\"font-size: 13px; font-weight: 600; color: #A12A1F; background: #FDECEA; border-radius: 10px; padding: 10px 12px\">{{error}}</div></sc-if>\n      <button type=\"button\" onClick=\"{{saveName}}\" disabled=\"{{busy}}\" style=\"height: 52px; border-radius: 12px; border: none; background: #09BEAF; color: #1F2B4D; font: 800 16px 'Plus Jakarta Sans', sans-serif; display: flex; align-items: center; justify-content: center; text-decoration: none; cursor: pointer; width: 100%\">Lanjut</button>\n      <div style=\"font-size: 12px; line-height: 18px; color: #4A5468\">Pelanggan lama langsung masuk tanpa langkah ini.</div>\n    </section>\n  </sc-if>\n\n</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{\"$preview\":{\"width\":390,\"height\":844}}'>\nclass Component extends DCLogic {\nstate = { step: 'phone', left: 45, phone: '', code: '', name: '', city: '', error: '', sim: '', norm: null };\ncomponentDidMount() {\n  this.timer = setInterval(() => { if (this.state.step === 'otp' && this.state.left > 0) this.setState({ left: this.state.left - 1 }); }, 1000);\n  RA.settings().then(() => { if (RA_ALIVE(this)) this.forceUpdate(); }).catch(() => {});\n  const p = this.params || {};\n  if (p.gerr) { this.setState({ error: 'Login Google gagal: ' + p.gerr }); return; }\n  if (p.google && RA.isLoggedIn()) { this.setState({ step: 'wait' }); this.afterGoogle().catch(e => this.setState({ step: 'phone', error: RA.friendly(e.message) })); return; }\n  if (RA.isLoggedIn()) RA.customer().then(c => { if (c && c.name) RA.afterLogin('Akun'); });\n}\nasync afterGoogle() {\n  await RA.rpc('claim_my_access', {}).catch(() => {});\n  const me = RA.me() || {};\n  const c = await RA.ensureCustomer(null, null);\n  if (!RA_ALIVE(this)) return;\n  if (!c || !c.phone) { this.setState({ step: 'wa', name: (c && c.name) || me.name || '' }); return; }\n  if (!c.name) { this.setState({ step: 'name', name: me.name || '' }); return; }\n  RA.afterLogin('Akun');\n}\nasync saveWa() {\n  const c = await RA.call('set_my_phone', { p_phone: this.state.phone });\n  RA._cust = c;\n  if (!c.name) { this.setState({ step: 'name', error: '' }); return; }\n  RA.afterLogin('Akun');\n}\ncomponentWillUnmount() { clearInterval(this.timer); }\nasync send() {\n  const v = String(this.state.phone || '').trim().toLowerCase();\n  const n = v.indexOf('@') > 0 ? null : RA.normPhone(v);\n  if (!n && !/^[^@\\s]+@[^@\\s]+\\.[^@\\s]{2,}$/.test(v)) { this.setState({ error: 'Isi email yang benar. Contoh: nama@gmail.com' }); return; }\n  this.setState({ error: '' });\n  const r = await RA.requestOtp(n, 'login', n ? undefined : v);\n  this.setState({ step: 'otp', left: 45, norm: r.phone || n, sentTo: r.sent_to || '', sim: r.simulation ? (r.code || '') : '', code: '', error: (r.simulation && !r.code) ? 'WhatsApp Rentalaja belum tersambung, jadi kode tidak terkirim. Minta kode masuk ke admin Rentalaja.' : '' });\n}\nasync check() {\n  const code = String(this.state.code).replace(/\\D/g, '');\n  if (code.length !== 6) { this.setState({ error: 'Kode terdiri dari 6 angka.' }); return; }\n  this.setState({ error: '' });\n  const r = await RA.verifyOtp(this.state.norm, code, 'login');\n  if (r.user && r.user.staff) { RA.toast('Masuk sebagai ' + r.user.staff.name); }\n  const c = await RA.ensureCustomer(null, null);\n  if (!c || !c.name) { this.setState({ step: 'name' }); return; }\n  RA.afterLogin('Akun');\n}\nasync save() {\n  const name = this.state.name.trim();\n  if (name.length < 3) { this.setState({ error: 'Isi nama sesuai KTP (minimal 3 huruf).' }); return; }\n  await RA.ensureCustomer(name, this.state.city.trim() || null);\n  RA.afterLogin('Akun');\n}\nrenderVals() {\n  const s = this.state;\n  const wrap = fn => this.act(async () => { try { await fn.call(this); } catch (e) { this.setState({ error: RA.friendly(e.message) }); } });\n  return {\n    isPhone: s.step === 'phone', isOtp: s.step === 'otp', isName: s.step === 'name', isWa: s.step === 'wa', isWait: s.step === 'wait',\n    hasGoogle: RA.setting('login_google') === true,\n    phoneTitle: RA.setting('login_google') === true ? 'Masuk ke Rentalaja' : 'Masuk ke Rentalaja',\n    phoneIntro: RA.setting('login_google') === true ? 'Paling cepat pakai akun Google. Atau isi email, kode masuk dikirim ke sana.' : 'Tanpa password. Isi email kamu, kode masuk dikirim ke sana. Belum punya akun? Nanti diminta nomor HP sekali saja.',\n    google: () => { this.setState({ busy: true }); RA.googleLogin(); }, saveWa: wrap(this.saveWa),\n    phone: s.phone, code: s.code, name: s.name, city: s.city, error: s.error, busy: !!s.busy,\n    masked: s.sentTo || 'kamu', simCode: s.sim,\n    sendLabel: s.busy ? 'Mengirim…' : 'Kirim kode ke email', verifyLabel: s.busy ? 'Memeriksa…' : 'Masuk',\n    resend: '0:' + String(s.left).padStart(2, '0'), canResend: s.left === 0,\n    backHref: (RA.ctx().next || '').indexOf('Checkout') === 0 ? 'Checkout.dc.html' : 'Home.dc.html',\n    setPhone: e => this.setState({ phone: e.target.value }), setCode: e => this.setState({ code: e.target.value }),\n    setName: e => this.setState({ name: e.target.value }), setCity: e => this.setState({ city: e.target.value }),\n    toOtp: wrap(this.send), verify: wrap(this.check), saveName: wrap(this.save),\n    toPhone: () => this.setState({ step: 'phone', error: '' })\n  };\n}\n}\n</script>\n</body>\n</html>\n"}