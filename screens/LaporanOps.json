{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Laporan operasional</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0}\n.lo-card{background:#FFFFFF;border-radius:20px;box-shadow:0 8px 24px rgba(31,43,77,0.08);padding:16px;display:flex;flex-direction:column;gap:6px}\n.lo-h{font-size:12px;font-weight:800;letter-spacing:0.06em;text-transform:uppercase}\n.lo-k{background:#FFFFFF;border-radius:16px;padding:12px;box-shadow:0 6px 18px rgba(31,43,77,0.06)}\n.lo-k div:first-child{font-size:11px;font-weight:700;color:#4A5468}\n.lo-k b{display:block;font-size:18px;line-height:24px}\n.lo-grid{display:grid;grid-template-columns:minmax(0,1.5fr) repeat(3,minmax(0,1fr));gap:6px;padding:9px 0;border-bottom:1px solid #EEF0F3;font-size:13px}\n.lo-in{width:100%;box-sizing:border-box;border-radius:12px;border:1px solid #CBD2DE;padding:10px 12px;font:500 13px 'Plus Jakarta Sans',sans-serif;line-height:18px;color:#1F2B4D;resize:vertical}\n.lo-chip{min-height:36px;padding:0 12px;border-radius:999px;border:1px solid #CBD2DE;background:#FFFFFF;color:#1F2B4D;font:700 12px 'Plus Jakarta Sans',sans-serif;cursor:pointer}\n@media (min-width:1000px){.lo-wrap{padding-top:24px}}\n</style>\n</helmet>\n<div style=\"min-height: 100vh; box-sizing: border-box; background: #F3F5F8; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; color: #1F2B4D; padding-bottom: 110px\">\n <div class=\"lo-wrap\" style=\"max-width: 560px; margin: 0 auto; display: flex; flex-direction: column; gap: 14px\">\n  <header style=\"background: #1F2B4D; color: #FFFFFF; padding: 20px 16px 22px; border-radius: 0 0 24px 24px; display: flex; flex-direction: column; gap: 4px\">\n    <div style=\"font-size: 12px; font-weight: 700; color: #B9C3D9\">{{sentTxt}}</div>\n    <div style=\"font-size: 20px; line-height: 26px; font-weight: 800\">{{dayTxt}}</div>\n    <div style=\"display: flex; gap: 6px; flex-wrap: wrap; margin-top: 6px\">\n      <span style=\"{{openChip}}\">{{openTxt}}</span>\n      <span style=\"font-size: 11px; font-weight: 800; padding: 4px 10px; border-radius: 999px; background: rgba(255,255,255,0.14); color: #FFFFFF\">{{taskTxt}}</span>\n    </div>\n    <sc-if value=\"{{hasDays}}\"><div style=\"display: flex; gap: 6px; overflow-x: auto; margin-top: 10px\"><sc-for list=\"{{days}}\" as=\"x\"><a href=\"{{x.href}}\" style=\"{{x.style}}\">{{x.label}}</a></sc-for></div></sc-if>\n  </header>\n\n  <sc-if value=\"{{loading}}\" hint-placeholder-val=\"{{false}}\"><div class=\"lo-card\" style=\"margin: 0 16px\"><span style=\"font-size: 13px; color: #4A5468\">Memuat laporan…</span></div></sc-if>\n  <sc-if value=\"{{ready}}\" hint-placeholder-val=\"{{true}}\">\n  <div style=\"display: flex; flex-direction: column; gap: 14px\">\n  <div class=\"lo-h\" style=\"margin: 0 16px -6px; color: #4A5468\">Kemarin · {{ydayTxt}}</div>\n  <section aria-label=\"Angka utama\" style=\"margin: 0 16px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px\">\n    <div class=\"lo-k\"><div>Omzet</div><b>{{omzet}}</b><span style=\"{{omzetStyle}}\">{{omzetSub}}</span></div>\n    <div class=\"lo-k\"><div>Utilisasi</div><b>{{util}}</b><span style=\"font-size: 11px; color: #4A5468\">{{utilSub}}</span></div>\n    <div class=\"lo-k\"><div>Serah terima tepat waktu</div><b>{{hand}}</b><span style=\"font-size: 11px; color: #4A5468\">{{handSub}}</span></div>\n    <div class=\"lo-k\"><div>Selisih kas</div><b>{{cash}}</b><span style=\"{{cashStyle}}\">{{cashSub}}</span></div>\n  </section>\n\n  <section aria-label=\"Naik ke CEO\" class=\"lo-card\" style=\"margin: 0 16px\">\n    <span class=\"lo-h\" style=\"color: #C0392B\">Naik ke Bapak ({{escN}})</span>\n    <sc-if value=\"{{noEsc}}\"><span style=\"font-size: 13px; color: #4A5468\">Tidak ada yang naik ke CEO kemarin.</span></sc-if>\n    <sc-for list=\"{{esc}}\" as=\"e\" hint-placeholder-count=\"1\"><div style=\"padding: 6px 0\"><b style=\"display: block; font-size: 13.5px; line-height: 18px\">{{e.title}}</b><span style=\"font-size: 12px; line-height: 16px; color: #4A5468\">{{e.sub}}</span></div></sc-for>\n  </section>\n\n  <section aria-label=\"Per cabang\" class=\"lo-card\" style=\"margin: 0 16px; gap: 0\">\n    <span class=\"lo-h\" style=\"color: #077A70; margin-bottom: 6px\">Per cabang</span>\n    <div class=\"lo-grid\" style=\"font-size: 11px; font-weight: 800; color: #4A5468; padding: 6px 0\"><span>Cabang</span><span style=\"text-align: right\">Omzet</span><span style=\"text-align: right\">Util.</span><span style=\"text-align: right\">Masalah</span></div>\n    <sc-for list=\"{{rows}}\" as=\"r\" hint-placeholder-count=\"3\"><div class=\"lo-grid\"><span style=\"font-weight: 700\">{{r.n}}</span><span style=\"text-align: right\">{{r.o}}</span><span style=\"text-align: right\">{{r.u}}</span><span style=\"{{r.ts}}\">{{r.t}}</span></div></sc-for>\n  </section>\n\n  <section aria-label=\"Disiplin tim\" class=\"lo-card\" style=\"margin: 0 16px\">\n    <span class=\"lo-h\" style=\"color: #9A5B00\">Disiplin tim</span>\n    <span style=\"font-size: 13px; line-height: 19px\">{{disc}}</span>\n  </section>\n\n  <section aria-label=\"Hari ini\" class=\"lo-card\" style=\"margin: 0 16px\">\n    <span class=\"lo-h\" style=\"color: #077A70\">Hari ini</span>\n    <span style=\"font-size: 13px; line-height: 19px\">{{todayTxt}}</span>\n    <sc-for list=\"{{todayItems}}\" as=\"t\" hint-placeholder-count=\"2\"><div style=\"font-size: 12.5px; line-height: 18px; color: #4A5468\">• <b style=\"color: #1F2B4D\">{{t.label}}</b>: {{t.sub}}{{t.note}}</div></sc-for>\n    <sc-if value=\"{{hasNote}}\"><div style=\"background: #F3F5F8; border-radius: 12px; padding: 10px 12px; font-size: 12.5px; line-height: 18px; white-space: pre-line\"><b>Catatan manajer:</b> {{note}}</div></sc-if>\n  </section>\n\n  <sc-if value=\"{{hasReply}}\"><section class=\"lo-card\" style=\"margin: 0 16px; background: #E8EEF8\">\n    <span class=\"lo-h\" style=\"color: #1F2B4D\">Tanggapan CEO · {{replyAt}}</span>\n    <span style=\"font-size: 13.5px; line-height: 19px; white-space: pre-line\">{{replyText}}</span>\n  </section></sc-if>\n\n  <sc-if value=\"{{canReply}}\"><section aria-label=\"Tanggapi manajer\" class=\"lo-card\" style=\"margin: 0 16px; gap: 10px\">\n    <label for=\"lo-r\" class=\"lo-h\" style=\"color: #077A70\">{{replyLabel}}</label>\n    <div style=\"display: flex; gap: 6px; flex-wrap: wrap\"><sc-for list=\"{{quick}}\" as=\"q\"><button type=\"button\" class=\"lo-chip\" onClick=\"{{q.pick}}\">{{q.t}}</button></sc-for></div>\n    <textarea id=\"lo-r\" class=\"lo-in\" rows=\"3\" placeholder=\"Tulis tanggapan untuk manajer operasional\" onInput=\"{{setReply}}\">{{reply}}</textarea>\n    <label style=\"display: flex; align-items: center; gap: 10px; min-height: 44px; font-size: 13px; font-weight: 700\"><input type=\"checkbox\" checked=\"{{wa}}\" onChange=\"{{toggleWa}}\" style=\"width: 20px; height: 20px; accent-color: #077A70\">Kirim juga lewat WA ke manajer</label>\n    <div style=\"font-size: 11.5px; line-height: 16px; color: #4A5468; margin-top: -6px\">Tanggapan muncul di beranda manajer dan tercatat di laporan ini. Kalau WA dicentang, manajer juga menerima WA.</div>\n    <div style=\"display: flex; gap: 8px\">\n      <button type=\"button\" onClick=\"{{send}}\" style=\"flex: 1; min-height: 48px; border-radius: 14px; border: 0; background: #077A70; color: #FFFFFF; font: 800 14px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">{{sendTxt}}</button>\n      <a href=\"OpsBeranda.dc.html\" style=\"flex: 1; min-height: 48px; border-radius: 14px; border: 1px solid #CBD2DE; background: #FFFFFF; color: #1F2B4D; font-size: 14px; font-weight: 700; display: flex; align-items: center; justify-content: center; text-decoration: none\">Buka dashboard</a>\n    </div>\n  </section></sc-if>\n  </div>\n  </sc-if>\n </div>\n</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{\"$preview\":{\"width\":390,\"height\":1300}}'>\nclass Component extends DCLogic {\nstate = { r: null, reply: '', wa: true, busy: false, day: null };\nasync componentDidMount() { await RA.staff(); this.load(); }\nasync load() {\n  const day = RA.param ? RA.param('d') : null;\n  try { const r = await RA.call('ops_report', { p_day: day || null }); if (!RA_ALIVE(this)) return; this.setState({ r, day }); } catch (e) { RA.err(e); }\n}\nasync send() {\n  const r = this.state.r; if (!r || this.state.busy) return; this.setState({ busy: true });\n  try { const n = await RA.call('ops_reply', { p_day: r.day, p_text: this.state.reply, p_wa: !!this.state.wa }); RA.toast(this.state.wa ? (n > 0 ? 'Tanggapan terkirim + WA ke ' + n + ' manajer' : 'Tanggapan tersimpan (manajer belum punya nomor WA)') : 'Tanggapan tersimpan', 'ok'); this.setState({ reply: '' }); await this.load(); } catch (e) { RA.err(e); }\n  if (RA_ALIVE(this)) this.setState({ busy: false });\n}\nrenderVals() {\n  const s = this.state, r = s.r;\n  const rp = n => RA.rpShort(n || 0);\n  if (!r) return { loading: true, ready: false, sentTxt: 'Laporan operasional', dayTxt: '', openTxt: '', taskTxt: '', days: [], esc: [], rows: [], todayItems: [], quick: [] };\n  const D = x => new Date(x + 'T00:00:00');\n  const fmt = x => D(x).toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });\n  const ho = r.handover || {}, re = r.returns || {}, hn = (ho.n || 0) + (re.n || 0), hk = (ho.ok || 0) + (re.ok || 0);\n  const c = r.cash || {}, t = r.tasks || {};\n  const disc = [].concat((r.late_shift || []).map(x => 'Shift ' + x), r.verif_slow ? [r.verif_slow + ' verifikasi lewat 30 mnt'] : []);\n  const items = ((r.today && r.today.items) || []).filter(i => !(i.n === 0));\n  const quick = ['Oke, lanjut', 'Setuju usulannya', 'Telepon saya', 'Tolong dikejar hari ini'].map(q => ({ t: q, pick: () => this.setState({ reply: (this.state.reply ? this.state.reply.trim() + ' ' : '') + q + '.' }) }));\n  return {\n    loading: false, ready: true,\n    sentTxt: 'Laporan operasional · ' + (r.report_sent_at ? 'terkirim ' + RA.time(r.report_sent_at) : 'terkirim otomatis 10.00'),\n    dayTxt: fmt(r.day), ydayTxt: D(r.yday).toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'short' }),\n    openTxt: r.opened_at ? 'Dibuka manajer ' + RA.time(r.opened_at) : 'Belum dicek manajer',\n    openChip: 'font-size: 11px; font-weight: 800; padding: 4px 10px; border-radius: 999px; ' + (r.opened_at ? 'background: #3DD6C3; color: #0B3B36' : 'background: #F2C14E; color: #3D2600'),\n    taskTxt: 'Tugas kemarin ' + (t.done || 0) + '/' + (t.n || 0) + ' beres',\n    hasDays: (r.days || []).length > 1,\n    days: (r.days || []).slice(0, 10).map(x => ({ label: D(x).toLocaleDateString('id-ID', { day: 'numeric', month: 'short' }), href: 'LaporanOps.dc.html?d=' + x,\n      style: 'flex: none; height: 32px; padding: 0 12px; border-radius: 16px; display: flex; align-items: center; text-decoration: none; font-size: 12px; font-weight: 800; ' + (x === r.day ? 'background: #FFFFFF; color: #1F2B4D' : 'background: rgba(255,255,255,0.14); color: #FFFFFF') })),\n    omzet: RA.rp(r.omzet || 0), omzetSub: r.target ? Math.round(100 * (r.omzet || 0) / r.target) + '% dari target ' + rp(r.target) : 'rata-rata 7 hari ' + rp(r.omzet7),\n    omzetStyle: 'font-size: 11px; font-weight: 700; color: ' + (r.target && r.omzet >= r.target ? '#055C55' : '#9A5B00'),\n    util: r.util != null ? r.util + '%' : '—', utilSub: (r.used || 0) + ' dari ' + (r.units || 0) + ' unit · nganggur ≈ ' + rp(r.idle_value),\n    hand: hn ? hk + '/' + hn : '—', handSub: hn ? Math.round(100 * hk / hn) + '% ambil & kembali ≤30 mnt' : 'belum ada data',\n    cash: rp(c.sum || 0), cashSub: c.n ? c.n + ' shift · ' + (c.where || '') + (r.notes && r.notes.cash ? ' · ada catatan' : '') : 'semua cocok',\n    cashStyle: 'font-size: 11px; font-weight: 700; color: ' + (c.n ? '#9B2C20' : '#055C55'),\n    escN: (r.escalated || []).length, noEsc: !(r.escalated || []).length,\n    esc: (r.escalated || []).map(e => ({ title: e.title + (e.branch ? ' · ' + e.branch : ''), sub: (e.done ? '✓ Sudah beres' : 'Masih terbuka') + (e.ack ? ' · ' + e.ack : '') + (e.sub ? ' · ' + e.sub : '') })),\n    rows: (r.branches || []).map(b => ({ n: b.name, o: rp(b.omzet), u: b.util != null ? b.util + '%' : '—', t: b.tasks ? (b.tasks - b.open) + '/' + b.tasks : '0', ts: 'text-align: right; font-weight: 800; color: ' + (b.open ? '#9B2C20' : '#055C55') })),\n    disc: disc.length ? disc.join(' · ') : 'Semua shift tepat waktu, verifikasi cepat.',\n    todayTxt: ((r.today && r.today.bookings) || 0) + ' booking hari ini · ' + ((r.today && r.today.open_left) || 0) + ' hal belum siap',\n    todayItems: items.map(i => ({ label: i.label, sub: i.sub, note: i.note_text ? ' — catatan: ' + i.note_text : '' })),\n    hasNote: !!r.note, note: r.note || '',\n    hasReply: !!r.reply, replyText: r.reply || '', replyAt: r.reply_at ? RA.time(r.reply_at) + (r.reply_wa ? ' · + WA' : '') : '',\n    canReply: !!r.can_reply, replyLabel: r.reply ? 'Ubah tanggapan' : 'Tanggapi manajer', quick,\n    reply: s.reply, setReply: e => this.setState({ reply: e.target.value }),\n    wa: !!s.wa, toggleWa: e => this.setState({ wa: e.target.checked }),\n    send: () => this.send(), sendTxt: s.busy ? 'Mengirim…' : 'Kirim tanggapan'\n  };\n}\n}\n</script>\n</body>\n</html>\n"}