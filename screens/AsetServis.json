{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Papan servis</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0}\na{color:#1F2B4D}a:hover{color:#000}\nbutton:disabled{opacity:.55;cursor:not-allowed}\n\n/* tampilan desktop (layar lebar) */\n@media (min-width: 1000px){\n  header[data-hero]{padding-left:32px !important;padding-right:32px !important;padding-top:22px !important}\n  header[data-hero] > div, main{max-width:1180px !important}\n  main{padding-left:32px !important;padding-right:32px !important}\n  header[data-hero] img[alt=\"Rentalaja\"]{visibility:hidden}\n  header[data-hero] [data-scrollx]{overflow:visible !important;margin:0 !important;padding:0 !important;flex-wrap:wrap}\n  header[data-hero] [data-scrollx] > *{flex:1 1 150px !important;min-width:0 !important}\n  main [data-scrollx]{overflow:visible !important;scroll-snap-type:none !important;flex-wrap:wrap}\n  span[data-noprint]{display:none}\n  main{padding-top:20px !important}\n  main > div:first-child{padding:0 !important}\n  main > [data-scrollx]{display:grid !important;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));padding:0 0 6px !important;align-items:start}\n  main > [data-scrollx] > section{flex:none !important;max-width:none !important;min-width:0 !important}\n  main > section{margin:0 !important}\n}\n</style>\n</helmet>\n<div style=\"min-height: 100vh; box-sizing: border-box; background: #F4F6F9; color: #1F2B4D; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; flex-direction: column\">\n\n  <header data-hero=\"1\" style=\"background: linear-gradient(160deg, #1F2B4D 0%, #2E3F6B 100%); padding: 14px 16px 18px; color: #FFFFFF\">\n    <div style=\"max-width: 1100px; margin: 0 auto; display: flex; flex-direction: column; gap: 12px\">\n      <div style=\"display: flex; justify-content: space-between; align-items: center\"><div><div style=\"font-size: 13px; opacity: 0.9\">Papan servis · {{month}}</div><div style=\"font-size: 20px; font-weight: 800\">{{headline}}</div></div><button type=\"button\" data-noprint=\"1\" onClick=\"{{cetak}}\" style=\"height: 32px; padding: 0 12px; border-radius: 16px; border: 0; background: #FFFFFF; color: #1F2B4D; font: 800 12px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">⎙ Cetak / PDF</button></div>\n      <div data-scrollx=\"1\" style=\"display: flex; gap: 8px; overflow-x: auto; margin: 0 -16px; padding: 0 16px\"><sc-for list=\"{{kpi}}\" as=\"k\"><div style=\"flex: 0 0 auto; min-width: 116px; background: rgba(255,255,255,0.12); border-radius: 12px; padding: 10px 12px\"><div style=\"font-size: 20px; font-weight: 800; color: {{k.c}}\">{{k.v}}</div><div style=\"font-size: 11px; opacity: 0.9\">{{k.l}}</div></div></sc-for></div>\n    </div>\n  </header>\n  <main style=\"width: 100%; max-width: 1100px; margin: 0 auto; box-sizing: border-box; padding: 12px 0 16px; display: flex; flex-direction: column; gap: 12px\">\n    <div style=\"display: flex; justify-content: space-between; align-items: center; padding: 0 16px\"><b style=\"font-size: 16px\">Papan kerja</b><span data-noprint=\"1\" style=\"font-size: 11px; color: #4A5468\">geser ke kanan untuk tahap berikutnya →</span></div>\n    <div data-scrollx=\"1\" style=\"display: flex; gap: 10px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 0 16px 6px; align-items: flex-start\">\n      <sc-for list=\"{{cols}}\" as=\"c\"><section style=\"flex: 0 0 82%; max-width: 300px; scroll-snap-align: start; background: #ECEFF3; border-radius: 16px; padding: 10px; display: flex; flex-direction: column; gap: 8px\">\n        <div style=\"display: flex; justify-content: space-between; align-items: center; padding: 2px 4px\"><b style=\"font-size: 14px\">{{c.icon}} {{c.label}}</b><span style=\"min-width: 24px; height: 24px; padding: 0 8px; box-sizing: border-box; border-radius: 12px; background: {{c.color}}; color: #FFFFFF; font-size: 12px; font-weight: 800; display: inline-flex; align-items: center; justify-content: center\">{{c.n}}</span></div>\n        <sc-if value=\"{{c.none}}\"><div style=\"font-size: 12px; color: #6B7486; text-align: center; padding: 12px 0\">{{c.none}}</div></sc-if>\n        <sc-for list=\"{{c.cards}}\" as=\"w\"><a href=\"{{w.href}}\" style=\"text-decoration: none; color: #1F2B4D; background: #FFFFFF; border-radius: 12px; padding: 10px; display: flex; flex-direction: column; gap: 4px; border-left: 4px solid {{w.bar}}\">\n          <div style=\"display: flex; justify-content: space-between; gap: 6px; font-size: 11px; font-weight: 800\"><span style=\"color: #4A5468\">{{w.code}}</span><span style=\"color: {{w.ac}}\">{{w.age}}</span></div>\n          <b style=\"font-size: 14px; line-height: 18px\">{{w.unit}}</b>\n          <span style=\"font-size: 12px; line-height: 16px; color: #3A4458\">{{w.what}}</span>\n          <div style=\"display: flex; justify-content: space-between; gap: 6px; font-size: 11px; color: #4A5468\"><span>👷 {{w.who}}</span><span>{{w.cost}}</span></div>\n        </a></sc-for>\n        <sc-if value=\"{{c.more}}\"><span style=\"font-size: 12px; color: #4A5468; text-align: center\">{{c.more}}</span></sc-if>\n      </section></sc-for>\n    </div>\n    <section style=\"margin: 0 16px; background: #FFFFFF; border-radius: 16px; box-shadow: 0 2px 10px rgba(31,43,77,0.05); padding: 14px; display: flex; flex-direction: column; gap: 10px\">\n      <div style=\"display: flex; justify-content: space-between; align-items: center\"><b style=\"font-size: 16px\">Teknisi bulan ini</b><span data-noprint=\"1\" style=\"font-size: 11px; color: #4A5468\">geser →</span></div>\n      <div data-scrollx=\"1\" style=\"display: flex; gap: 8px; overflow-x: auto; margin: 0 -14px; padding: 0 14px 4px\"><sc-for list=\"{{techs}}\" as=\"t\"><div style=\"flex: 0 0 auto; min-width: 150px; background: #F6F7F9; border-radius: 12px; padding: 10px; display: flex; flex-direction: column; gap: 2px\"><b style=\"font-size: 14px\">{{t.medal}} {{t.name}}</b><span style=\"font-size: 22px; font-weight: 800\">{{t.done}} <span style=\"font-size: 12px; font-weight: 700; color: #4A5468\">selesai</span></span><span style=\"font-size: 11px; color: #4A5468\">{{t.sub}}</span></div></sc-for></div>\n      <sc-if value=\"{{noTech}}\"><span style=\"font-size: 13px; color: #4A5468\">{{noTech}}</span></sc-if>\n    </section>\n    <div data-noprint=\"1\" style=\"display: flex; gap: 8px; padding: 0 16px; flex-wrap: wrap\"><a href=\"MgmtServis.dc.html\" style=\"height: 40px; padding: 0 14px; border-radius: 10px; border: 1px solid #D5D9E0; background: #FFFFFF; color: #1F2B4D; font-size: 13px; font-weight: 800; display: inline-flex; align-items: center; text-decoration: none\">Detail work order & aturan perawatan →</a><a href=\"AsetPreventif.dc.html\" style=\"height: 40px; padding: 0 14px; border-radius: 10px; border: 1px solid #D5D9E0; background: #FFFFFF; color: #1F2B4D; font-size: 13px; font-weight: 800; display: inline-flex; align-items: center; text-decoration: none\">Preventif →</a></div>\n  </main>\n</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{\"$preview\":{\"width\":390,\"height\":844}}'>\nclass Component extends DCLogic {\nstate = { d: null };\nasync componentDidMount() { await RA.staff(); this.stop = RA.poll(this, () => this.reload(), 90000); }\ncomponentWillUnmount() { if (this.stop) this.stop(); }\nasync reload() {\n  const m0 = new Date(); m0.setDate(1); m0.setHours(0, 0, 0, 0);\n  const [wo, dn, sf] = await Promise.all([\n    RA.from('work_orders').select('id,code,unit_id,status,source,complaint,target_at,created_at,started_at,technician_id,vendor_name,total_cost,units(code,asset_no,plate_or_serial,products(name)),branches(name)').in('status', ['queued', 'working', 'waiting_part', 'qc']).order('created_at').limit(500),\n    RA.from('work_orders').select('id,code,unit_id,status,complaint,created_at,started_at,finished_at,target_at,technician_id,vendor_name,total_cost,units(code,asset_no,plate_or_serial,products(name))').eq('status', 'done').gte('finished_at', m0.toISOString()).order('finished_at', { ascending: false }).limit(500),\n    RA.from('staff').select('user_id,name')\n  ]);\n  if (!RA_ALIVE(this)) return;\n  const nm = {}; (sf.data || []).forEach(x => { nm[x.user_id] = x.name; });\n  this.setState({ d: { wo: wo.data || [], dn: dn.data || [], nm } });\n}\nrenderVals() {\nconst s = this.state, d = s.d, now = new Date();\nconst hrs = x => Math.max(0, (now - new Date(x)) / 36e5); const dur = h => h < 48 ? Math.round(h) + ' jam' : Math.round(h / 24) + ' hari';\nconst uN = u => ((u || {}).products || {}).name ? u.products.name + ' ' + (u.plate_or_serial || u.asset_no || u.code || '') : 'Unit';\nconst who = w => w.vendor_name ? 'Bengkel ' + w.vendor_name : (d.nm[w.technician_id] || 'belum ditugaskan');\nconst card = (w, done) => { const late = !done && w.target_at && new Date(w.target_at) < now; return { code: w.code + (w.source === 'scheduled' ? ' · preventif' : ''), unit: uN(w.units), what: w.complaint || '—', who: who(w), cost: w.total_cost ? RA.rp(w.total_cost) : '',\n  age: done ? 'selesai ' + RA.date(w.finished_at) : late ? 'lewat ' + dur(hrs(w.target_at)) : dur(hrs(w.created_at)), ac: late ? '#A12A1F' : done ? '#1E6B45' : '#4A5468', bar: late ? '#E5534B' : done ? '#1E9E6A' : w.source === 'scheduled' ? '#09BEAF' : '#B4BCC8', href: 'AsetUnit.dc.html?id=' + w.unit_id }; };\nconst COLS = [['queued', '📥', 'Antre', '#1F2B4D'], ['working', '🔧', 'Dikerjakan', '#077A70'], ['waiting_part', '📦', 'Tunggu part', '#8A4B00'], ['qc', '✅', 'QC', '#077A70'], ['done', '🏁', 'Selesai bulan ini', '#1E6B45']];\nconst cols = COLS.map(([k, icon, label, color]) => { const ws = d ? (k === 'done' ? d.dn : d.wo.filter(w => w.status === k)) : []; const sorted = k === 'done' ? ws : ws.slice().sort((a, b) => ((b.target_at && new Date(b.target_at) < now) - (a.target_at && new Date(a.target_at) < now)) || new Date(a.created_at) - new Date(b.created_at));\n  return { icon, label, color, n: d ? String(ws.length) : '—', cards: sorted.slice(0, 15).map(w => card(w, k === 'done')), more: ws.length > 15 ? '+' + (ws.length - 15) + ' lainnya' : '', none: d && !ws.length ? 'Kosong' : '' }; });\nlet kpi = [], techs = [], open = 0, late = 0;\nif (d) { open = d.wo.length; late = d.wo.filter(w => w.target_at && new Date(w.target_at) < now).length;\n  const hs = d.dn.map(w => (new Date(w.finished_at) - new Date(w.started_at || w.created_at)) / 36e5).filter(h => h >= 0); const avg = hs.length ? hs.reduce((a, b) => a + b, 0) / hs.length : null;\n  const ot = d.dn.length ? Math.round(100 * d.dn.filter(w => !w.target_at || new Date(w.finished_at) <= new Date(w.target_at)).length / d.dn.length) : null;\n  const cost = d.dn.reduce((a, w) => a + (+w.total_cost || 0), 0);\n  kpi = [[String(open), 'servis berjalan', '#FFFFFF'], [String(late), 'lewat target', late ? '#FFB4AD' : '#FFFFFF'], [String(d.dn.length), 'selesai bulan ini', '#9EF0E6'], [ot == null ? '—' : ot + '%', 'tepat waktu', '#FFFFFF'], [avg == null ? '—' : dur(avg), 'rata-rata servis', '#FFFFFF'], [RA.rpShort ? RA.rpShort(cost) : RA.rp(cost), 'biaya servis', '#FFFFFF']].map(([v, l, c]) => ({ v, l, c }));\n  const t = {}; d.dn.forEach(w => { const k = w.vendor_name ? 'v:' + w.vendor_name : w.technician_id; if (!k) return; t[k] = t[k] || { done: 0, ot: 0, open: 0, name: w.vendor_name ? 'Bengkel ' + w.vendor_name : d.nm[w.technician_id] || 'Teknisi' }; t[k].done++; if (!w.target_at || new Date(w.finished_at) <= new Date(w.target_at)) t[k].ot++; });\n  d.wo.forEach(w => { const k = w.vendor_name ? 'v:' + w.vendor_name : w.technician_id; if (!k) return; t[k] = t[k] || { done: 0, ot: 0, open: 0, name: w.vendor_name ? 'Bengkel ' + w.vendor_name : d.nm[w.technician_id] || 'Teknisi' }; t[k].open++; });\n  techs = Object.values(t).sort((a, b) => b.done - a.done).map((x, i) => ({ medal: ['🥇', '🥈', '🥉'][i] || '', name: x.name, done: String(x.done), sub: (x.done ? Math.round(100 * x.ot / x.done) + '% tepat waktu · ' : '') + x.open + ' sedang dipegang' })); }\nreturn { month: RA.BULAN[now.getMonth()], headline: !d ? 'Memuat…' : late ? late + ' servis lewat target' : open ? open + ' servis berjalan, semua sesuai target' : 'Tidak ada servis berjalan', kpi, cols, techs, noTech: d && !techs.length ? 'Belum ada servis tercatat bulan ini.' : '', cetak: () => window.print() };\n}\n}\n</script>\n</body>\n</html>\n"}