{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Dashboard Manajemen</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0}\na{color:#1F2B4D}a:hover{color:#000}\nbutton:disabled{opacity:.55;cursor:not-allowed}\n\n/* tampilan desktop (layar lebar) */\n.kb-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch}\n.kb{width:100%;border-collapse:collapse;font-size:12.5px}\n.kb-cards{display:none}\n@media (max-width: 699px){.kb-wrap{display:none}.kb-cards{display:flex;flex-direction:column;gap:8px}}\n.kb th{font-size:11px;font-weight:800;color:#4A5468;text-align:right;padding:6px 4px;border-bottom:1px solid #EEF0F3;white-space:nowrap}\n.kb th:first-child,.kb th:nth-child(2){text-align:left}\n.kb td{padding:9px 4px;border-bottom:1px solid #EEF0F3;text-align:right;white-space:nowrap;vertical-align:middle}\n.kb td:first-child,.kb td:nth-child(2){text-align:left}\n.kb tr:last-child td{border-bottom:0}\n.kd-grid{display:grid;grid-template-columns:1fr;gap:12px}\n@media (min-width: 1000px){\n  .kd-grid{grid-template-columns:1.5fr 1fr}\n  header[data-hero]{padding:22px 32px 64px !important}\n  header[data-hero] > div{max-width:1180px !important}\n  header[data-hero] img[alt=\"Rentalaja\"]{visibility:hidden}\n  #screen main{max-width:1180px !important;padding:0 32px 32px !important;gap:16px !important}\n  #screen main [style*=\"overflow-x: auto\"]{overflow:visible !important;flex-wrap:wrap !important;scroll-snap-type:none !important;margin:0 !important;padding-left:0 !important;padding-right:0 !important}\n  #screen main [style*=\"overflow-x: auto\"] > a, #screen main [style*=\"overflow-x: auto\"] > div{flex:1 1 200px !important;max-width:none !important}\n}\n</style>\n</helmet>\n<div style=\"min-height: 100vh; box-sizing: border-box; background: #F4F6F9; color: #1F2B4D; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; flex-direction: column\">\n\n  <header data-hero=\"1\" style=\"background: linear-gradient(160deg, #09BEAF 0%, #077A70 100%); padding: 14px 16px 60px; color: #FFFFFF; position: relative; overflow: hidden\">\n    <svg width=\"220\" height=\"220\" viewBox=\"0 0 220 220\" aria-hidden=\"true\" style=\"position: absolute; right: -60px; top: -70px; opacity: 0.18\"><circle cx=\"110\" cy=\"110\" r=\"100\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"30\"/></svg>\n    <div style=\"max-width: 720px; margin: 0 auto; display: flex; flex-direction: column; gap: 12px; position: relative\">\n      <div style=\"display: flex; justify-content: space-between; align-items: center; gap: 8px\"><img src=\"logo.png\" alt=\"Rentalaja\" style=\"height: 26px; width: auto; background: #FFFFFF; border-radius: 8px; padding: 4px 8px; display: block\"><sc-if value=\"{{apprN}}\"><a href=\"{{apprHref}}\" style=\"height: 32px; padding: 0 12px; border-radius: 16px; background: #FFFFFF; color: #077A70; font-size: 12px; font-weight: 800; display: inline-flex; align-items: center; gap: 6px; text-decoration: none\">{{apprN}} persetujuan →</a></sc-if></div>\n      <div><div style=\"font-size: 13px; opacity: 0.92\">{{hello}} · {{today}}</div><div style=\"font-size: 22px; font-weight: 800; line-height: 28px\">{{headline}}</div><div style=\"font-size: 13px; opacity: 0.92; margin-top: 2px\">Dashboard Manajemen · {{scope}}</div></div>\n    </div>\n  </header>\n\n  <main style=\"width: 100%; max-width: 720px; margin: 0 auto; box-sizing: border-box; padding: 0 16px 16px; display: flex; flex-direction: column; gap: 12px\">\n    <section aria-label=\"Metrik operasional\" style=\"margin-top: -40px; position: relative; display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px\">\n      <sc-for list=\"{{mets}}\" as=\"x\"><a href=\"{{x.href}}\" style=\"background: #FFFFFF; border-radius: 16px; box-shadow: 0 8px 24px rgba(31,43,77,0.10); padding: 12px 14px; display: flex; flex-direction: column; gap: 4px; text-decoration: none; color: #1F2B4D; min-width: 0\">\n        <span style=\"display: flex; justify-content: space-between; font-size: 12px; font-weight: 700; color: #4A5468\">{{x.l}}<b style=\"color: #077A70\">›</b></span>\n        <b style=\"font-size: 23px; line-height: 28px; font-weight: 800; color: {{x.c}}\">{{x.v}}</b>\n        <span style=\"font-size: 11.5px; line-height: 15px; color: #4A5468\">{{x.sub}}</span>\n        <span style=\"display: flex; gap: 4px; flex-wrap: wrap\"><sc-for list=\"{{x.pills}}\" as=\"q\"><span style=\"{{q.st}}\">{{q.t}}</span></sc-for></span>\n      </a></sc-for>\n    </section>\n    <div class=\"kd-grid\">\n    <section aria-label=\"Papan cabang\" style=\"background: #FFFFFF; border-radius: 20px; box-shadow: 0 8px 24px rgba(31,43,77,0.10); padding: 16px; display: flex; flex-direction: column; gap: 8px; min-width: 0\">\n      <div style=\"display: flex; justify-content: space-between; align-items: baseline; gap: 8px\"><span style=\"font-size: 12px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: #077A70\">Papan cabang · hari ini</span><span style=\"font-size: 11px; color: #4A5468\">{{kb.note}}</span></div>\n      <div class=\"kb-wrap\"><table class=\"kb\"><thead><tr><th>Cabang</th><th>Status</th><th>Ambil</th><th>Kembali</th><th>Verif</th><th>Masuk</th><th>Masalah</th></tr></thead><tbody>\n        <sc-for list=\"{{kb.rows}}\" as=\"b\"><tr><td><b style=\"font-size: 13px\">{{b.name}}</b><div style=\"font-size: 11px; color: #4A5468\">{{b.who}}</div></td><td><span style=\"{{b.chip}}\">{{b.status}}</span></td><td>{{b.out}}</td><td>{{b.back}}</td><td style=\"color: {{b.vc}}; font-weight: 800\">{{b.ver}}</td><td>{{b.money}}</td><td style=\"color: {{b.pc}}; font-weight: 800\">{{b.prob}}</td></tr></sc-for>\n      </tbody></table></div>\n      <div class=\"kb-cards\"><sc-for list=\"{{kb.rows}}\" as=\"b\"><div style=\"background: #F6F7F9; border-radius: 14px; padding: 10px 12px; display: flex; flex-direction: column; gap: 6px\">\n        <div style=\"display: flex; justify-content: space-between; align-items: center; gap: 8px\"><span style=\"min-width: 0\"><b style=\"font-size: 14px\">{{b.name}}</b><span style=\"display: block; font-size: 11px; color: #4A5468\">{{b.who}}</span></span><span style=\"{{b.chip}}\">{{b.status}}</span></div>\n        <div style=\"display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 4px; text-align: center\">\n          <span><b style=\"display: block; font-size: 14px\">{{b.out}}</b><span style=\"font-size: 10px; color: #4A5468\">ambil</span></span>\n          <span><b style=\"display: block; font-size: 14px\">{{b.back}}</b><span style=\"font-size: 10px; color: #4A5468\">kembali</span></span>\n          <span><b style=\"display: block; font-size: 14px; color: {{b.vc}}\">{{b.ver}}</b><span style=\"font-size: 10px; color: #4A5468\">verif</span></span>\n          <span><b style=\"display: block; font-size: 14px\">{{b.money}}</b><span style=\"font-size: 10px; color: #4A5468\">masuk</span></span>\n          <span><b style=\"display: block; font-size: 14px; color: {{b.pc}}\">{{b.prob}}</b><span style=\"font-size: 10px; color: #4A5468\">masalah</span></span>\n        </div></div></sc-for></div>\n      <sc-if value=\"{{kb.stuckTxt}}\"><a href=\"PosHariIni.dc.html\" style=\"display: block; background: #FDECEA; color: #A12A1F; border-radius: 12px; padding: 10px 12px; font-size: 13px; line-height: 18px; font-weight: 800; text-decoration: none\">{{kb.stuckTxt}} <span style=\"font-weight: 600; color: #3A4458\">{{kb.stuckSub}}</span></a></sc-if>\n    </section>\n    \n    </div>\n    <section aria-label=\"Target pendapatan\" style=\"position: relative; background: #FFFFFF; border-radius: 20px; box-shadow: 0 8px 24px rgba(31,43,77,0.12); padding: 16px; display: flex; flex-direction: column; gap: 12px\">\n      <div style=\"display: flex; justify-content: space-between; align-items: center; gap: 8px\"><span style=\"font-size: 12px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: #077A70\">{{tg.title}}</span><span style=\"{{tg.chip}}\">{{tg.status}}</span></div>\n      <sc-if value=\"{{tg.has}}\">\n        <div style=\"display: flex; align-items: baseline; gap: 6px; flex-wrap: wrap\"><span style=\"font-size: 30px; line-height: 34px; font-weight: 800; color: #1F2B4D\">{{tg.actual}}</span><span style=\"font-size: 14px; font-weight: 700; color: #4A5468\">dari {{tg.target}}</span></div>\n        <div style=\"position: relative; height: 14px; border-radius: 7px; background: #EEF0F3; overflow: visible\">\n          <div style=\"{{tg.bar}}\"></div>\n          <div title=\"Seharusnya sudah sampai sini hari ini\" style=\"{{tg.pace}}\"></div>\n        </div>\n        <div style=\"display: flex; justify-content: space-between; font-size: 12px; font-weight: 700; color: #4A5468\"><span>{{tg.pct}} tercapai</span><span>▲ jalur hari ini {{tg.pacePct}}</span></div>\n        <div style=\"background: {{tg.boxBg}}; border-radius: 12px; padding: 10px 12px; font-size: 14px; line-height: 19px; font-weight: 800; color: {{tg.boxFg}}\">{{tg.headline}} <span style=\"font-weight: 600; color: #3A4458\">{{tg.sub}}</span></div>\n        <div style=\"display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px\"><sc-for list=\"{{tg.mini}}\" as=\"m\"><div style=\"background: #F6F7F9; border-radius: 12px; padding: 10px; min-width: 0\"><div style=\"font-size: 16px; font-weight: 800; line-height: 20px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis\">{{m.v}}</div><div style=\"font-size: 11px; line-height: 14px; color: #4A5468\">{{m.l}}</div></div></sc-for></div>\n        <sc-if value=\"{{tg.demo}}\"><div style=\"display: flex; justify-content: space-between; align-items: center; gap: 8px; background: #FFF6E0; border-radius: 12px; padding: 8px 10px; font-size: 12px; line-height: 16px; color: #7A4B00\"><span>Contoh tampilan · target asli belum diisi</span><sc-if value=\"{{tg.setHref}}\"><a href=\"{{tg.setHref}}\" style=\"font-weight: 800; color: #1F2B4D; white-space: nowrap\">Isi target →</a></sc-if></div></sc-if>\n        <div style=\"display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 8px\">\n          <sc-for list=\"{{tg.br}}\" as=\"b\"><div style=\"min-width: 0; background: #F6F7F9; border-radius: 12px; padding: 10px; display: flex; flex-direction: column; gap: 4px\"><b style=\"font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis\">{{b.name}}</b><span style=\"font-size: 18px; font-weight: 800; color: {{b.color}}\">{{b.pctTxt}}</span><div style=\"height: 5px; border-radius: 3px; background: #E2E6EC\"><div style=\"{{b.bar}}\"></div></div><span style=\"font-size: 11px; color: #4A5468; white-space: nowrap\">{{b.txt}}</span></div></sc-for>\n        </div>\n        <sc-if value=\"{{tg.hasActs}}\"><div style=\"display: flex; justify-content: space-between; align-items: center\"><span style=\"font-size: 12px; font-weight: 800; color: #4A5468\">Cara mengejar target</span><span style=\"font-size: 11px; color: #4A5468\">geser →</span></div>\n          <div style=\"display: flex; gap: 8px; overflow-x: auto; scroll-snap-type: x mandatory; margin: 0 -16px; padding: 0 16px 4px\">\n            <sc-for list=\"{{tg.acts}}\" as=\"a\"><a href=\"{{a.href}}\" style=\"flex: 0 0 72%; max-width: 260px; scroll-snap-align: start; text-decoration: none; background: #F3FBFA; border: 1px solid #CDEFEA; border-radius: 14px; padding: 12px; color: #1F2B4D; display: flex; flex-direction: column; gap: 6px\"><span style=\"font-size: 18px; font-weight: 800; color: #077A70\">{{a.v}}</span><b style=\"font-size: 14px; line-height: 18px\">{{a.t}}</b><span style=\"font-size: 12px; line-height: 16px; color: #4A5468\">{{a.s}}</span></a></sc-for>\n          </div>\n        </sc-if>\n      </sc-if>\n      <sc-if value=\"{{tg.has}}\" not><div style=\"font-size: 14px; line-height: 20px; color: #4A5468\">{{tg.empty}}</div><sc-if value=\"{{tg.setHref}}\"><a href=\"{{tg.setHref}}\" style=\"align-self: flex-start; height: 40px; padding: 0 14px; border-radius: 10px; background: #1F2B4D; color: #FFFFFF; font-size: 14px; font-weight: 800; display: inline-flex; align-items: center; text-decoration: none\">Isi target bulan ini →</a></sc-if></sc-if>\n    </section>\n    <a href=\"OpsManajer.dc.html\" style=\"display: flex; align-items: center; justify-content: space-between; gap: 12px; background: #FFFFFF; border-radius: 16px; box-shadow: 0 6px 20px rgba(31,43,77,0.10); padding: 16px; text-decoration: none; color: #1F2B4D\"><span><b style=\"display: block; font-size: 15px\">Daftar yang perlu ditangani</b><span style=\"font-size: 12.5px; color: #4A5468\">Booking telat, shift, verifikasi, tagihan — ada di Tugas hari ini</span></span><span style=\"font-size: 13px; font-weight: 800; color: #077A70; white-space: nowrap\">Buka Tugas →</span></a>\n  </main>\n</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{\"$preview\":{\"width\":390,\"height\":844}}'>\nclass Component extends DCLogic {\nstate = { tab: 'aksi', d: null };\nasync componentDidMount() {\n  await RA.staff();\n  this.stop = RA.poll(this, () => this.reload(), 60000);\n}\ncomponentWillUnmount() { if (this.stop) this.stop(); }\nasync reload() {\n  const t0 = new Date(); t0.setHours(0, 0, 0, 0); const t2 = new Date(t0.getTime() + 2 * 864e5), back = new Date(t0.getTime() - 30 * 864e5);\n  const SEL = 'id,code,status,start_at,end_at,guest_name,guest_phone,guests,channel,ota_ref,driver_status,trip_status,pickup_point,total,paid_amount,late_fee,damage_fee,delivery_mode,delivery_address,return_mode,branch_id,branches(name),booking_items(products(name,categories(kind)),units(code,asset_no,plate_or_serial))';\n  const can = p => RA.can(p);\n  const m0 = new Date(t0.getFullYear(), t0.getMonth(), 1); const per = m0.getFullYear() + '-' + String(m0.getMonth() + 1).padStart(2, '0');\n  const [bk, rt, un, ap, py, tg, rd, bn, ok, md, sh, pv, tb, sf] = await Promise.all([\n    RA.from('bookings').select(SEL).in('status', ['confirmed', 'active', 'awaiting_payment']).lt('start_at', new Date(t0.getTime() + 4 * 864e5).toISOString()).gt('end_at', back.toISOString()).order('start_at').limit(500),\n    RA.from('runner_tasks').select('id,booking_id,kind,status,note,done_at,scheduled_at,runner_id,bookings(code)').in('status', ['scheduled', 'on_the_way', 'arrived', 'failed']).gte('scheduled_at', new Date(t0.getTime() - 7 * 864e5).toISOString()).limit(300),\n    RA.from('units').select('id,code,status,branch_id,branches(name),products(name,categories(slug))').eq('status', 'qc').is('archived_at', null).limit(200),\n    can('mgmt.approvals') || can('finance.approve') ? RA.from('approvals').select('id', { count: 'exact', head: true }).eq('status', 'pending') : { count: 0 },\n    RA.from('payments').select('branch_id,amount,kind,paid_at,booking_id').eq('status', 'paid').gte('paid_at', m0.toISOString()).limit(5000),\n    RA.from('targets').select('branch_id,value').eq('metric', 'omzet').eq('period', per).is('line', 'null'),\n    RA.from('units').select('branch_id,products(categories(kind))').eq('status', 'ready').is('archived_at', null).limit(2000),\n    RA.from('branches').select('id,name,kind,open_time,close_time,is_active,archived_at').order('sort'),\n    RA.rpc('ops_pending_all', {}).then(x => x, () => ({ data: [] })),\n    RA.rpc('ops_dash', {}).then(x => x, () => ({ data: null })),\n    RA.from('shifts').select('id,branch_id,staff_id,opened_at,closed_at,status').gte('opened_at', t0.toISOString()).limit(100),\n    RA.from('bookings').select('id,branch_id,created_at').eq('status', 'pending_verification').limit(300),\n    RA.from('bookings').select('id,code,status,branch_id,start_at,end_at,booking_items(products(categories(kind)))').in('status', ['active', 'returned', 'completed', 'confirmed', 'awaiting_payment']).or('and(start_at.gte.' + t0.toISOString() + ',start_at.lt.' + new Date(t0.getTime() + 864e5).toISOString() + '),and(end_at.gte.' + t0.toISOString() + ',end_at.lt.' + new Date(t0.getTime() + 864e5).toISOString() + ')').limit(500),\n    RA.from('staff').select('user_id,name').limit(300)\n  ]);\n  if (!RA_ALIVE(this)) return;\n  const kd = b => { const ks = (b.booking_items || []).map(i => i.products && i.products.categories && i.products.categories.kind); return ks.indexOf('stay') > -1 ? 'inap' : ks.indexOf('trip') > -1 ? 'jeep' : 'rental'; };\n  this.setState({ d: { bk: (bk.data || []).map(b => Object.assign({ _k: kd(b) }, b)), bn: bn.data || [], py: py.data || [], tg: tg.data || [], rd: (rd.data || []).filter(u => u.products && u.products.categories && ['rental', 'car_driver'].indexOf(u.products.categories.kind) > -1), rt: rt.data || [], un: (un.data || []).filter(u => u.products && u.products.categories && u.products.categories.slug === 'penginapan'), ap: ap.count || 0, ok: Array.isArray(ok && ok.data) ? ok.data : [], md: (md && md.data) || null, sh: sh.data || [], pv: pv.data || [], tb: (tb.data || []).map(b => Object.assign({ _k: kd(b) }, b)), sf: sf.data || [] } });\n}\nrenderVals() {\nconst s = this.state, d = s.d, now = new Date(), st = RA._staff || {};\nconst t0 = new Date(now); t0.setHours(0, 0, 0, 0); const t1 = new Date(t0.getTime() + 864e5);\nconst T = (type, c) => ({ type, chip: 'display: inline-flex; align-items: center; height: 22px; padding: 0 8px; border-radius: 11px; font-size: 11px; font-weight: 800; white-space: nowrap; background: ' + c[0] + '; color: ' + c[1], bar: c[2] });\nconst RED = ['#FDECEA', '#A12A1F', '#E5534B'], AMB = ['#FFF1D6', '#8A4B00', '#F2C14E'], BLU = ['#E8EEF8', '#1F2B4D', '#1F2B4D'], TEA = ['#E3F7F5', '#077A70', '#09BEAF'], GRY = ['#EEF0F3', '#4A5468', '#B4BCC8'];\nconst item = b => { const it = (b.booking_items || [])[0]; if (!it) return '—'; const u = it.units || {}; return ((it.products || {}).name || '') + (u.plate_or_serial || u.asset_no || u.code ? ' · ' + (u.plate_or_serial || u.asset_no || u.code) : '') + ((b.booking_items || []).length > 1 ? ' +' + (b.booking_items.length - 1) : ''); };\nconst ph = b => String(b.guest_phone || '').replace(/\\D/g, '');\nconst wa = (b, m) => ph(b) ? 'https://wa.me/' + ph(b) + '?text=' + encodeURIComponent(m) : '';\nconst hrs = x => { const v = Math.round((now - new Date(x)) / 36e5); return v > 0 ? v : 0; };\nconst dur = h => h < 48 ? h + ' jam' : Math.round(h / 24) + ' hari';\nconst inDay = x => { const t = new Date(x); return t >= t0 && t < t1; };\nconst br = b => (b.branches || {}).name || '';\nconst act = [], today = [];\nlet late = 0, out = 0, back = 0, cin = 0, jeep = 0;\nif (d) {\n  const tBy = {}; d.rt.forEach(t => { (tBy[t.booking_id] = tBy[t.booking_id] || []).push(t); });\n  d.bk.forEach(b => {\n    if (b._k === 'inap') {\n      if (inDay(b.start_at) && ['confirmed', 'awaiting_payment', 'active'].indexOf(b.status) > -1) { cin++; today.push(Object.assign({ at: new Date(b.start_at) }, T('Check-in', TEA), { title: '±' + RA.time(b.start_at) + ' · ' + item(b).replace(/ · .*$/, ''), sub: (b.guest_name || '—') + ' · ' + (b.guests || '?') + ' org · ' + (b.channel === 'ota' ? 'OTA ' + (b.ota_ref || '') : (b.channel || 'web')), right: '', rightColor: '#077A70' })); }\n      if (inDay(b.end_at) && b.status === 'active') today.push(Object.assign({ at: new Date(b.end_at) }, T('Check-out', GRY), { title: RA.time(b.end_at) + ' · ' + item(b).replace(/ · .*$/, ''), sub: (b.guest_name || '—') + ' · ' + b.code, right: '', rightColor: '#4A5468' }));\n      return;\n    }\n    if (b._k === 'jeep') {\n      if (['confirmed', 'awaiting_payment'].indexOf(b.status) > -1 && new Date(b.start_at) >= t0 && b.driver_status !== 'accepted') act.push(Object.assign({ pri: 2, at: new Date(b.start_at) }, T('Jeep tanpa sopir', RED), { title: b.code + ' · ' + (b.guest_name || '—'), sub: item(b) + ' · ' + RA.dayTime(b.sta