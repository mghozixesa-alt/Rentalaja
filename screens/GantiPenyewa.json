{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Ganti penyewa</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0}\n.cp-card{background:#FFFFFF;border-radius:20px;box-shadow:0 2px 12px rgba(31,43,77,.06);padding:16px;display:flex;flex-direction:column;gap:12px}\n.cp-in{height:50px;box-sizing:border-box;border:2px solid #CDEFEA;border-radius:14px;padding:0 14px;font:700 16px 'Plus Jakarta Sans',sans-serif;color:#1F2B4D;background:#FFFFFF;width:100%}\n.cp-btn{height:50px;border:0;border-radius:14px;background:linear-gradient(135deg,#12B5A6,#077A70);color:#FFFFFF;font:800 15px 'Plus Jakarta Sans',sans-serif;cursor:pointer;display:flex;align-items:center;justify-content:center;text-decoration:none;width:100%}\n.cp-btn2{height:46px;border:1.5px solid #E3E7ED;border-radius:14px;background:#FFFFFF;color:#1F2B4D;font:800 14px 'Plus Jakarta Sans',sans-serif;cursor:pointer;display:flex;align-items:center;justify-content:center;text-decoration:none}\n.cp-st{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}\n.cp-st div{background:#F6F7F9;border-radius:14px;padding:10px 12px}\n.cp-st b{display:block;font-size:20px;line-height:26px}\n.cp-st span{font-size:12px;color:#4A5468}\n.cp-kv{display:flex;justify-content:space-between;gap:10px;font-size:13.5px;padding:9px 0;border-bottom:1px solid #EEF0F3}\n.cp-kv:last-child{border-bottom:0}.cp-kv span{color:#5B6577}.cp-kv b{text-align:right}\n.cp-rad{display:flex;align-items:center;gap:10px;min-height:48px;border:1.5px solid #E3E7ED;border-radius:14px;padding:0 14px;font:700 14px 'Plus Jakarta Sans',sans-serif;color:#1F2B4D;background:#FFFFFF;cursor:pointer;text-align:left;width:100%}\n.cp-rad i{width:18px;height:18px;border-radius:50%;border:2px solid #B4BCC8;flex:none;box-sizing:border-box}\n.cp-rad.on{border-color:#077A70;background:#F2FBFA}.cp-rad.on i{border:6px solid #077A70}\n</style>\n</helmet>\n<div style=\"min-height: 100vh; box-sizing: border-box; background: #F4F6F9; color: #1F2B4D; font-family: 'Plus Jakarta Sans', system-ui, sans-serif\">\n <header style=\"background: linear-gradient(170deg, #0A9E92 0%, #077A70 100%); color: #FFFFFF; padding: 16px\">\n  <div style=\"max-width: 640px; margin: 0 auto; display: flex; gap: 12px; align-items: center\"><a href=\"{{backHref}}\" aria-label=\"Kembali\" style=\"width: 38px; height: 38px; border-radius: 12px; background: rgba(255,255,255,.18); color: #FFFFFF; font-size: 22px; font-weight: 800; display: flex; align-items: center; justify-content: center; text-decoration: none\">‹</a>\n  <span><b style=\"display: block; font-size: 19px\">Ganti penyewa</b><span style=\"font-size: 13px; opacity: .9\">{{bkSub}}</span></span></div>\n </header>\n <main style=\"max-width: 640px; margin: 0 auto; padding: 16px 16px 28px; display: flex; flex-direction: column; gap: 12px\">\n  <sc-if value=\"{{loading}}\"><div class=\"cp-card\" style=\"text-align: center; color: #4A5468\">Memuat…</div></sc-if>\n  <sc-if value=\"{{blocked}}\"><div class=\"cp-card\" style=\"background: #FDECEA; color: #A12A1F; font-weight: 700; font-size: 14px; line-height: 20px\">{{blocked}}</div></sc-if>\n  <sc-if value=\"{{ready}}\">\n  <section class=\"cp-card\"><span style=\"font-size: 13px; font-weight: 700; color: #5B6577\">Penyewa sekarang</span>\n   <div style=\"display: flex; gap: 12px; align-items: center\"><span style=\"width: 46px; height: 46px; border-radius: 14px; background: #E3F6F4; color: #077A70; font-weight: 800; display: flex; align-items: center; justify-content: center\">{{cur.ini}}</span><span><b style=\"font-size: 16px; display: block\">{{cur.name}}</b><span style=\"font-size: 12.5px; color: #4A5468\">{{cur.sub}}</span></span></div>\n  </section>\n  <div style=\"text-align: center; color: #077A70; font-weight: 800; margin: -4px 0\">↓</div>\n\n  <sc-if value=\"{{pending}}\"><section class=\"cp-card\" style=\"border: 2px solid #F7DDB0\">\n   <b style=\"font-size: 15px\">Penyewa baru menunggu verifikasi</b>\n   <div style=\"font-size: 13.5px; line-height: 19px; color: #7A4B00; background: #FFF6E5; border-radius: 12px; padding: 10px 12px; font-weight: 700\">Serah terima terkunci sampai KTP + KK penyewa baru dicek. Minta penyewa unggah dokumen lewat link, atau foto di kasir (Verifikasi di tempat).</div>\n   <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 8px\"><a class=\"cp-btn2\" href=\"{{waNew}}\" target=\"_blank\" rel=\"noopener\">Kirim link unggah</a><button type=\"button\" class=\"cp-btn\" style=\"height: 46px; font-size: 14px\" onClick=\"{{verify}}\" disabled=\"{{busy}}\">Dokumen sudah dicek</button></div>\n   <div style=\"font-size: 12px; color: #6B7486\">{{verifyNote}}</div>\n  </section></sc-if>\n\n  <sc-if value=\"{{canChange}}\">\n  <section class=\"cp-card\"><span style=\"font-size: 13px; font-weight: 700; color: #5B6577\">Penyewa baru · nomor WhatsApp</span>\n   <input class=\"cp-in\" type=\"tel\" inputmode=\"tel\" placeholder=\"0812 xxxx xxxx\" value=\"{{phone}}\" onInput=\"{{setPhone}}\" autocomplete=\"off\">\n   <sc-if value=\"{{cand}}\"><div style=\"display: flex; gap: 12px; align-items: center\"><span style=\"width: 46px; height: 46px; border-radius: 14px; background: {{cand.bg}}; color: {{cand.fg}}; font-weight: 800; display: flex; align-items: center; justify-content: center\">{{cand.ini}}</span><span style=\"flex: 1; min-width: 0\"><b style=\"font-size: 15px; display: block\">{{cand.name}}</b><span style=\"font-size: 12.5px; color: #4A5468\">{{cand.sub}}</span></span><span style=\"{{cand.chip}}\">{{cand.tag}}</span></div></sc-if>\n   <sc-if value=\"{{askName}}\"><input class=\"cp-in\" style=\"border-color: #E3E7ED\" type=\"text\" placeholder=\"Nama sesuai KTP\" value=\"{{name}}\" onInput=\"{{setName}}\"></sc-if>\n   <sc-if value=\"{{lookNote}}\"><div style=\"font-size: 12.5px; color: #5B6577\">{{lookNote}}</div></sc-if>\n  </section>\n  <section class=\"cp-card\"><span style=\"font-size: 13px; font-weight: 700; color: #5B6577\">Alasan</span>\n   <sc-for list=\"{{reasons}}\" as=\"r\"><button type=\"button\" class=\"{{r.cls}}\" onClick=\"{{r.pick}}\"><i></i>{{r.label}}</button></sc-for>\n   <sc-if value=\"{{other}}\"><input class=\"cp-in\" style=\"border-color: #E3E7ED; font-weight: 600; font-size: 14px\" type=\"text\" placeholder=\"Tulis alasan\" value=\"{{otherTxt}}\" onInput=\"{{setOther}}\"></sc-if>\n  </section>\n  <sc-if value=\"{{warn}}\"><div style=\"background: #FFF6E5; color: #7A4B00; border-radius: 14px; padding: 12px 14px; font-size: 13.5px; line-height: 19px; font-weight: 700\">{{warn}}</div></sc-if>\n  <button type=\"button\" class=\"cp-btn\" onClick=\"{{submit}}\" disabled=\"{{busy}}\">{{submitLabel}}</button>\n  </sc-if>\n\n  <sc-if value=\"{{done}}\"><section class=\"cp-card\" style=\"border: 2px solid #CDEFEA\">\n   <b style=\"font-size: 16px; color: #1E6B45\">✓ Penyewa diganti</b>\n   <div style=\"font-size: 13.5px; line-height: 19px; color: #3A4458\">{{doneText}}</div>\n   <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 8px\"><a class=\"cp-btn2\" href=\"{{waNew}}\" target=\"_blank\" rel=\"noopener\">WA penyewa baru</a><a class=\"cp-btn2\" href=\"{{waOld}}\" target=\"_blank\" rel=\"noopener\">WA penyewa lama</a></div>\n  </section></sc-if>\n\n  <section class=\"cp-card\" style=\"gap: 6px\"><b style=\"font-size: 15px\">Riwayat di booking</b>\n   <sc-for list=\"{{hist}}\" as=\"h\"><div style=\"font-size: 13px; line-height: 19px; color: #3A4458\"><b>{{h.at}}</b> · {{h.t}}</div></sc-for>\n   <sc-if value=\"{{noHist}}\"><div style=\"font-size: 13px; color: #6B7486\">Belum ada pergantian penyewa.</div></sc-if>\n   <div style=\"font-size: 12px; color: #6B7486; margin-top: 4px\">Booking, pembayaran, dan unit tetap; hanya penyewanya yang pindah. Setelah unit keluar, ganti penyewa hanya oleh kepala cabang.</div>\n  </section>\n  </sc-if>\n </main>\n</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{\"$preview\":{\"width\":390,\"height\":844}}'>\nclass Component extends DCLogic {\nstate = { b: null, ev: [], phone: '', name: '', look: null, reason: 'kk', otherTxt: '', busy: false, done: null };\nasync componentDidMount() { await RA.staff(); this.load(); }\nasync load() {\n  const id = this.params.id; if (!id) return this.setState({ b: false });\n  const [b, ev] = await Promise.all([\n    RA.from('bookings').select('id,code,status,start_at,end_at,branch_id,guest_name,guest_phone,customer_id,tenant_check,paid_amount,total,customers(name,phone,verified_at),booking_items(products(name),units(plate_or_serial,code))').eq('id', id).maybeSingle(),\n    RA.from('booking_events').select('kind,label,data,at').eq('booking_id', id).in('kind', ['tenant_changed', 'verified']).order('at', { ascending: false }).limit(10)\n  ]);\n  if (RA_ALIVE(this)) this.setState({ b: b.data || false, ev: ev.data || [] });\n}\nasync lookup(v) {\n  const d = String(v || '').replace(/\\D/g, ''); if (d.length < 10) return this.setState({ look: null });\n  const seq = this._s = (this._s || 0) + 1;\n  try { const r = await RA.call('cs_check_customer', { p_q: d, p_mode: 'phone' }); if (RA_ALIVE(this) && seq === this._s) this.setState({ look: r }); } catch (e) { if (RA_ALIVE(this)) this.setState({ look: { err: e.message } }); }\n}\nrenderVals() {\n  const s = this.state, b = s.b, role = (RA._staff || {}).role;\n  const ini = n => String(n || '?').split(/\\s+/).filter(Boolean).slice(0, 2).map(x => x[0]).join('').toUpperCase();\n  const mask = p => { const d = String(p || '').replace(/\\D/g, ''); return d ? '0' + d.replace(/^62/, '').replace(/^(\\d{3})\\d+(\\d{4})$/, '$1 •••• $2') : '—'; };\n  if (!b) return { loading: b === null, blocked: b === false ? 'Booking tidak ditemukan. Buka dari Kelola booking.' : '', ready: false, backHref: 'PusatCS.dc.html', bkSub: '' };\n  const it = (b.booking_items || [])[0] || {};\n  const item = ((it.products || {}).name || '') + ((it.units || {}).plate_or_serial ? ' · ' + it.units.plate_or_serial : '');\n  const head = ['owner', 'branch_head'].indexOf(role) > -1;\n  const closed = ['returned', 'completed', 'cancelled', 'expired', 'rejected', 'no_show'].indexOf(b.status) > -1;\n  const lk = s.look, c0 = lk && lk.list && lk.list[0];\n  const L = { aman: ['Terverifikasi', '#E4F4E9', '#1E7A3F'], hati: ['Hati-hati', '#FFF0DC', '#9A5B00'], tolak: ['Ditolak', '#FDE8E6', '#C0392B'], baru: ['Perlu verifikasi', '#FFF0DC', '#9A5B00'] };\n  const cand = c0 ? (l => ({ ini: ini(c0.name), name: c0.name, sub: c0.done ? c0.done + '× sewa selesai' : 'Belum pernah sewa', tag: l[0], bg: l[1], fg: l[2], chip: 'flex: none; height: 26px; padding: 0 10px; border-radius: 13px; font-size: 12px; font-weight: 800; display: flex; align-items: center; background: ' + l[1] + '; color: ' + l[2] }))(L[c0.label] || L.aman)\n    : lk && lk.found === false ? { ini: '?', name: lk.blacklist ? 'Nomor ini diblokir' : 'Nomor baru', sub: lk.blacklist ? (lk.blacklist.reason || '') : 'Belum pernah sewa · isi nama sesuai KTP', tag: lk.blacklist ? 'Diblokir' : 'Perlu verifikasi', bg: lk.blacklist ? '#FDE8E6' : '#FFF0DC', fg: lk.blacklist ? '#C0392B' : '#9A5B00', chip: 'flex: none; height: 26px; padding: 0 10px; border-radius: 13px; font-size: 12px; font-weight: 800; display: flex; align-items: center; background: ' + (lk.blacklist ? '#FDE8E6; color: #C0392B' : '#FFF0DC; color: #9A5B00') } : null;\n  const needV = c0 ? !c0.verified : !!(lk && lk.found === false);\n  const bad = (c0 && c0.label === 'tolak') || (lk && lk.blacklist);\n  const R = [['kk', 'Diwakilkan keluarga se-KK'], ['salah', 'Salah input nama / nomor'], ['lain', 'Lainnya (tulis)']];\n  const reasonTxt = s.reason === 'lain' ? String(s.otherTxt || '').trim() : (R.find(x => x[0] === s.reason) || [])[1];\n  const nm = c0 ? c0.name : s.name || 'penyewa baru';\n  const site = location.origin + location.pathname;\n  const d = s.done;\n  const newPh = d ? d.phone : '';\n  const waNew = 'https://wa.me/' + String(newPh || (b.tenant_check === 'pending' ? b.guest_phone : '')).replace(/\\D/g, '') + '?text=' + encodeURIComponent('Halo Kak ' + (d ? d.name : b.guest_name || '') + ', booking ' + b.code + ' (' + item + ') sekarang atas nama Kakak. Mohon unggah foto KTP + KK di sini supaya bisa diserahkan: ' + site + '#/UploadKtp');\n  const waOld = d ? 'https://wa.me/' + String(d.old_phone || '').replace(/\\D/g, '') + '?text=' + encodeURIComponent('Halo Kak ' + (d.old_name || '') + ', booking ' + b.code + ' (' + item + ') sudah dipindahkan atas nama ' + d.name + ' sesuai permintaan. Terima kasih.') : '#';\n  const fmt = x => { const t = new Date(x); return t.getDate() + ' ' + RA.BULAN[t.getMonth()].slice(0, 3) + ' ' + RA.time(t); };\n  return {\n    loading: false, ready: true, backHref: 'PusatCS.dc.html', bkSub: b.code + ' · ' + item,\n    blocked: closed ? 'Booking ini sudah selesai atau batal, penyewa tidak bisa diganti.' : b.status === 'active' && !head ? 'Unit sudah keluar. Ganti penyewa setelah serah terima perlu kepala cabang.' : '',\n    cur: { ini: ini(b.guest_name), name: b.guest_name || '—', sub: mask(b.guest_phone) + (b.customers && b.customers.verified_at ? ' · terverifikasi' : ' · belum terverifikasi') },\n    pending: b.tenant_check === 'pending' && !d, verify: this.act(async () => { await RA.call('booking_tenant_verify', { p_booking: b.id }); RA.ok('Penyewa baru lolos verifikasi. Serah terima bisa dilanjut.'); await this.load(); }),\n    verifyNote: RA.can('pos.verify') ? 'Tekan setelah KTP asli + KK dicocokkan. Minimal 2 dokumen sudah diunggah.' : 'Kasir/CS dengan akses verifikasi yang menekan tombol ini.',\n    canChange: !closed && (b.status !== 'active' || head) && !d,\n    phone: s.phone, setPhone: e => { this.setState({ phone: e.target.value }); clearTimeout(this._t); const v = e.target.value; this._t = setTimeout(() => this.lookup(v), 350); },\n    cand, askName: !!(lk && lk.found === false && !lk.blacklist), name: s.name, setName: e => this.setState({ name: e.target.value }),\n    lookNote: lk && lk.err ? lk.err : !lk ? 'Ketik nomor WA penyewa baru, sistem langsung cek riwayatnya.' : '',\n    reasons: R.map(([k, l]) => ({ label: l, cls: 'cp-rad' + (s.reason === k ? ' on' : ''), pick: () => this.setState({ reason: k }) })), other: s.reason === 'lain', otherTxt: s.otherTxt, setOther: e => this.setState({ otherTxt: e.target.value }),\n    warn: bad ? 'Penyewa baru diblokir / punya tunggakan. Tidak bisa dipakai.' : needV && (c0 || lk) ? nm + ' wajib unggah KTP + KK. Serah terima terkunci sampai verifikasi lolos.' : '',\n    busy: !!s.busy, submitLabel: 'Ganti penyewa',\n    submit: this.act(async () => {\n      if (!lk || lk.err) throw new Error('Ketik nomor WA penyewa baru dulu.');\n      if (bad) throw new Error('Penyewa baru tidak bisa dipakai (diblokir / tunggakan).');\n      if (!reasonTxt || reasonTxt.length < 3) throw new Error('Isi alasan.');\n      const r = await RA.call('booking_change_customer', { p_booking: b.id, p_phone: s.phone, p_name: s.name, p_reason: reasonTxt });\n      this.setState({ done: r }); RA.ok('Penyewa diganti ke ' + r.name); await this.load();\n    }),\n    done: !!d, doneText: d ? 'Booking ' + b.code + ' sekarang atas nama ' + d.name + '. ' + (d.need_verify ? 'Penyewa baru wajib unggah KTP + KK; serah terima terkunci sampai dicek.' : 'Penyewa baru sudah terverifikasi, serah terima bisa langsung.') + ' Kirim kabar ke kedua pihak:' : '',\n    waNew, waOld,\n    hist: (s.ev || []).map(e => ({ at: fmt(e.at), t: e.label + (e.data && e.data.by ? ' oleh ' + e.data.by : '') + (e.data && e.data.reason ? '. Alasan: ' + e.data.reason : '') })), noHist: !(s.ev || []).length\n  };\n}\n}\n</script>\n</body>\n</html>\n"}