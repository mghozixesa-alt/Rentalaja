{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Pusat CS</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0}\na{color:#1F2B4D}a:hover{color:#000}\nbutton:disabled{opacity:.55;cursor:not-allowed}\n\n/* tampilan desktop (layar lebar) */\n@media (min-width: 1000px){\n  header[data-hero]{padding:22px 32px 64px !important}\n  header[data-hero] > div{max-width:1180px !important}\n  header[data-hero] img[alt=\"Rentalaja\"]{visibility:hidden}\n  #screen main{max-width:1180px !important;padding:0 32px 32px !important;gap:16px !important}\n  #screen main [style*=\"overflow-x: auto\"]{overflow:visible !important;flex-wrap:wrap !important;scroll-snap-type:none !important;margin:0 !important;padding-left:0 !important;padding-right:0 !important}\n  #screen main [style*=\"overflow-x: auto\"] > a, #screen main [style*=\"overflow-x: auto\"] > div{flex:1 1 200px !important;max-width:none !important}\n}\n</style>\n</helmet>\n<div style=\"min-height: 100vh; box-sizing: border-box; background: #F4F6F9; color: #1F2B4D; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; flex-direction: column\">\n\n  <header data-hero=\"1\" style=\"background: linear-gradient(160deg, #09BEAF 0%, #077A70 100%); padding: 14px 16px 60px; color: #FFFFFF; position: relative; overflow: hidden\">\n    <svg width=\"220\" height=\"220\" viewBox=\"0 0 220 220\" aria-hidden=\"true\" style=\"position: absolute; right: -60px; top: -70px; opacity: 0.18\"><circle cx=\"110\" cy=\"110\" r=\"100\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"30\"/></svg>\n    <div style=\"max-width: 720px; margin: 0 auto; display: flex; flex-direction: column; gap: 12px; position: relative\">\n      <div style=\"display: flex; justify-content: space-between; align-items: center\"><img src=\"logo.png\" alt=\"Rentalaja\" style=\"height: 26px; width: auto; background: #FFFFFF; border-radius: 8px; padding: 4px 8px; display: block\"><a href=\"LaporanShift.dc.html\" style=\"height: 32px; padding: 0 12px; border-radius: 16px; background: #FFFFFF; color: #077A70; font-size: 12px; font-weight: 800; display: inline-flex; align-items: center; gap: 6px; text-decoration: none\">Laporan →</a></div>\n      <div><div style=\"font-size: 13px; opacity: 0.92\">{{hello}} · {{today}}</div><div style=\"font-size: 22px; font-weight: 800; line-height: 28px\">{{headline}}</div></div>\n      <div style=\"position: relative\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#5B6577\" stroke-width=\"2.4\" aria-hidden=\"true\" style=\"position: absolute; left: 14px; top: 15px\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"M20 20l-3.5-3.5\"/></svg><input type=\"search\" aria-label=\"Cari booking atau pelanggan\" placeholder=\"Cari kode booking, nama, atau no. HP\" value=\"{{sq}}\" onInput=\"{{setSq}}\" style=\"height: 48px; width: 100%; box-sizing: border-box; border: 0; border-radius: 14px; padding: 0 14px 0 40px; font: 500 14px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; background: #FFFFFF\"></div>\n    </div>\n  </header>\n\n  <main style=\"width: 100%; max-width: 720px; margin: 0 auto; box-sizing: border-box; padding: 0 16px 16px; display: flex; flex-direction: column; gap: 12px\">\n    <div role=\"tablist\" style=\"margin-top: -34px; position: relative; background: #FFFFFF; border-radius: 16px; box-shadow: 0 6px 20px rgba(31,43,77,0.10); padding: 5px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 4px\">\n      <sc-for list=\"{{tabs}}\" as=\"t\"><button type=\"button\" role=\"tab\" aria-selected=\"{{t.on}}\" onClick=\"{{t.pick}}\" style=\"{{t.style}}\">{{t.label}}<sc-if value=\"{{t.n}}\"><span style=\"margin-left: 6px; min-width: 20px; height: 20px; padding: 0 6px; box-sizing: border-box; border-radius: 10px; background: {{t.nbg}}; color: #FFFFFF; font-size: 11px; display: inline-flex; align-items: center; justify-content: center\">{{t.n}}</span></sc-if></button></sc-for>\n    </div>\n\n    <sc-if value=\"{{sOpen}}\"><section style=\"background: #FFFFFF; border-radius: 20px; padding: 14px 16px; display: flex; flex-direction: column; gap: 4px\">\n      <div style=\"display: flex; justify-content: space-between; align-items: center\"><b style=\"font-size: 15px\">Hasil cari</b><button type=\"button\" onClick=\"{{clearSq}}\" style=\"border: 0; background: none; color: #4A5468; font: 700 13px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">Tutup ✕</button></div>\n      <sc-if value=\"{{sNone}}\"><div style=\"font-size: 13px; color: #4A5468; padding: 6px 0\">{{sNone}}</div></sc-if>\n      <sc-for list=\"{{sres}}\" as=\"r\"><div style=\"padding: 10px 0; border-top: 1px solid #EEF0F3; display: flex; flex-direction: column; gap: 6px\">\n        <div style=\"display: flex; justify-content: space-between; gap: 8px\"><b style=\"font-size: 14px\">{{r.title}}</b><span style=\"{{r.chip}}\">{{r.st}}</span></div>\n        <div style=\"font-size: 12px; line-height: 17px; color: #4A5468\">{{r.sub}}</div>\n        <div style=\"font-size: 12px; font-weight: 800; color: {{r.payColor}}\">{{r.pay}}</div>\n        <div style=\"display: flex; gap: 6px; flex-wrap: wrap\"><sc-if value=\"{{r.wa}}\"><a href=\"{{r.wa}}\" target=\"_blank\" rel=\"noopener\" style=\"{{btnWa}}\">WA</a></sc-if><button type=\"button\" onClick=\"{{r.copy}}\" style=\"{{btnO}}\">Salin link pesanan</button><sc-if value=\"{{r.href}}\"><a href=\"{{r.href}}\" style=\"{{btnO}}\">{{r.hrefLabel}}</a></sc-if></div>\n      </div></sc-for>\n    </section></sc-if>\n\n    <sc-if value=\"{{loading}}\"><div style=\"background: #FFFFFF; border-radius: 16px; padding: 18px; text-align: center; font-size: 14px; color: #4A5468\">Memuat…</div></sc-if>\n    <sc-if value=\"{{hint}}\"><div style=\"font-size: 12px; line-height: 17px; color: #4A5468; padding: 0 4px\">{{hint}}</div></sc-if>\n    <sc-if value=\"{{empty}}\"><div style=\"background: #FFFFFF; border-radius: 16px; padding: 22px 16px; text-align: center; font-size: 14px; line-height: 20px; color: #1E6B45; font-weight: 700\">{{empty}}</div></sc-if>\n\n    <sc-for list=\"{{items}}\" as=\"r\"><div style=\"background: #FFFFFF; border-radius: 16px; box-shadow: 0 2px 10px rgba(31,43,77,0.05); padding: 12px 14px; display: flex; flex-direction: column; gap: 6px; border-left: 4px solid {{r.bar}}\">\n      <div style=\"display: flex; justify-content: space-between; gap: 8px; align-items: center\"><span style=\"{{r.chip}}\">{{r.type}}</span><span style=\"font-size: 12px; font-weight: 800; color: {{r.rightColor}}; white-space: nowrap\">{{r.right}}</span></div>\n      <div style=\"font-size: 14px; font-weight: 800; line-height: 19px\">{{r.title}}</div>\n      <sc-if value=\"{{r.sub}}\"><div style=\"font-size: 12px; line-height: 17px; color: #4A5468\">{{r.sub}}</div></sc-if>\n      <div style=\"display: flex; gap: 6px; flex-wrap: wrap\">\n        <sc-if value=\"{{r.wa}}\"><a href=\"{{r.wa}}\" target=\"_blank\" rel=\"noopener\" onClick=\"{{r.sent}}\" style=\"{{btnWa}}\">Kirim WA</a></sc-if>\n        <sc-if value=\"{{r.act}}\"><button type=\"button\" onClick=\"{{r.act}}\" disabled=\"{{busy}}\" style=\"{{btnD}}\">{{r.actLabel}}</button></sc-if>\n        <sc-for list=\"{{r.res}}\" as=\"x\"><button type=\"button\" onClick=\"{{x.pick}}\" disabled=\"{{busy}}\" style=\"{{x.style}}\">{{x.label}}</button></sc-for>\n        <sc-if value=\"{{r.href}}\"><a href=\"{{r.href}}\" style=\"{{btnO}}\">{{r.hrefLabel}}</a></sc-if>\n      </div>\n    </div></sc-for>\n    <sc-if value=\"{{more}}\"><div style=\"font-size: 12px; color: #4A5468; text-align: center\">{{more}}</div></sc-if>\n  </main>\n</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{\"$preview\":{\"width\":1280,\"height\":1100}}'>\nclass Component extends DCLogic {\nstate = { tab: 'tugas', d: null, sq: '', sres: null };\nasync componentDidMount() {\n  await RA.staff();\n  this.stop = RA.poll(this, () => this.reload(), 60000);\n}\ncomponentWillUnmount() { if (this.stop) this.stop(); }\nasync reload() {\n  const t0 = new Date(); t0.setHours(0, 0, 0, 0);\n  const t3 = new Date(t0.getTime() + 4 * 864e5), back = new Date(t0.getTime() - 45 * 864e5);\n  const can = p => RA.can(p);\n  const SEL = 'id,code,status,line,channel,ota_ref,start_at,end_at,guest_name,guest_phone,guests,total,paid_amount,late_fee,damage_fee,hold_expires_at,created_at,dp_amount,delivery_mode,delivery_address,return_mode,driver_id,driver_status,trip_status,pickup_point,branch_id,branches(name),booking_items(products(name,categories(kind,slug)))';\n  const [bk, rt, un, tk, wa, tr, fu] = await Promise.all([\n    RA.from('bookings').select(SEL).in('status', ['pending_verification', 'awaiting_payment', 'confirmed', 'active', 'returned']).lt('start_at', t3.toISOString()).gt('end_at', back.toISOString()).order('start_at').limit(500),\n    RA.from('runner_tasks').select('id,booking_id,kind,status,note,done_at,scheduled_at,bookings(code,guest_name,guest_phone)').eq('status', 'failed').gte('done_at', new Date(t0.getTime() - 7 * 864e5).toISOString()).order('done_at', { ascending: false }).limit(50),\n    RA.from('units').select('id,code,status,products(name,categories(slug))').eq('status', 'qc').is('archived_at', null).limit(200),\n    can('mgmt.complaints') || can('pos.bookings') ? RA.from('tickets').select('id,code,category,priority,summary,status,sla_due_at,created_at,division,pic_id').in('status', ['open', 'in_progress', 'resolved']).order('sla_due_at', { nullsFirst: false }).limit(50) : { data: [] },\n    can('mgmt.inbox') ? RA.from('wa_conversations').select('id,phone,status,last_in_at,last_out_at,customers(name)').eq('status', 'open').order('last_in_at', { ascending: false }).limit(100) : { data: [] },\n    can('mgmt.offers') ? RA.from('trip_requests').select('id,code,kind,pickup_location,depart_at,pax,status,created_at').in('status', ['new', 'change_requested']).order('created_at').limit(50) : { data: [] },\n    can('mgmt.followup') ? RA.from('followups').select('id,rule_key,reason,amount,status,created_at,contacted_at,assigned_to,customers(name,phone),bookings(code)').in('status', ['open', 'contacted']).order('created_at').limit(80) : { data: [] }\n  ]);\n  if (!RA_ALIVE(this)) return;\n  this.setState({ d: { bk: bk.data || [], rt: rt.data || [], dirty: (un.data || []).filter(u => u.products && u.products.categories && u.products.categories.slug === 'penginapan'), tk: tk.data || [], wa: (wa.data || []).filter(c => c.last_in_at && (!c.last_out_at || new Date(c.last_in_at) > new Date(c.last_out_at))), tr: tr.data || [], fu: fu.data || [] } });\n}\nasync search(q) {\n  q = String(q || '').trim().replace(/[,()%*]/g, ' ').trim(); if (q.length < 3) { this.setState({ sres: null }); return; }\n  const dig = q.replace(/\\D/g, '').replace(/^0/, '62');\n  const ors = ['code.ilike.%' + q + '%', 'guest_name.ilike.%' + q + '%'].concat(dig.length >= 5 ? ['guest_phone.ilike.%' + dig.slice(-9) + '%'] : []).join(',');\n  const { data } = await RA.from('bookings').select('id,code,status,start_at,end_at,guest_name,guest_phone,total,paid_amount,late_fee,damage_fee,branches(name),booking_items(products(name,categories(kind)))').or(ors).order('created_at', { ascending: false }).limit(10);\n  if (RA_ALIVE(this) && this.state.sq.trim().replace(/[,()%*]/g, ' ').trim() === q) this.setState({ sres: data || [] });\n}\nasync fuSet(f, status) {\n  const now = new Date().toISOString(); const patch = { status };\n  if (status === 'contacted') patch.contacted_at = now; else { patch.result_at = now; if (!f.contacted_at) patch.contacted_at = now; }\n  const { error } = await RA.from('followups').update(patch).eq('id', f.id); if (error) throw new Error(error.message);\n  RA.ok({ contacted: 'Tercatat sudah dihubungi', won: 'Mantap! Pelanggan sewa lagi 🎉', no_answer: 'Tercatat tidak menjawab', not_interested: 'Tercatat belum berminat' }[status]);\n  await this.reload();\n}\nasync cash(b) {\n  const pm = await RA.call('create_payment', { p_booking: b.id, p_kind: null, p_method: 'cash', p_amount: null });\n  await RA.call('mark_payment_paid', { p_payment: pm.id, p_provider_ref: null, p_raw: null });\n  if (b.status === 'returned') { try { await RA.call('complete_booking', { p_booking: b.id }); } catch (e) { /* biarkan */ } }\n  RA.ok('Pelunasan tunai ' + RA.rp(pm.amount) + ' tercatat · ' + b.code);\n  await this.reload();\n}\nrenderVals() {\nconst s = this.state, d = s.d, now = new Date(), st = RA._staff || {};\nconst t0 = new Date(now); t0.setHours(0, 0, 0, 0); const t1 = new Date(t0.getTime() + 864e5);\nconst chip = (bg, fg) => 'display: inline-flex; align-items: center; height: 24px; padding: 0 9px; border-radius: 12px; font-size: 12px; font-weight: 800; white-space: nowrap; background: ' + bg + '; color: ' + fg;\nconst pill = on => 'height: 34px; padding: 0 14px; border-radius: 17px; border: 0; background: ' + (on ? '#FFFFFF' : 'rgba(255,255,255,0.22)') + '; color: ' + (on ? '#077A70' : '#FFFFFF') + '; font: 800 13px \\'Plus Jakarta Sans\\', sans-serif; cursor: pointer; white-space: nowrap; flex-shrink: 0';\nconst kindOf = b => { const ks = (b.booking_items || []).map(i => i.products && i.products.categories && i.products.categories.kind); return ks.indexOf('stay') > -1 ? 'inap' : ks.indexOf('trip') > -1 ? 'jeep' : 'rental'; };\nconst LN = { rental: 'Rental', inap: 'Penginapan', jeep: 'Jeep' };\nconst bal = b => Math.max(0, +b.total + +(b.late_fee || 0) + +(b.damage_fee || 0) - +(b.paid_amount || 0));\nconst item = b => ((b.booking_items || [])[0] || {}).products ? b.booking_items[0].products.name + ((b.booking_items || []).length > 1 ? ' +' + (b.booking_items.length - 1) : '') : '—';\nconst ph = b => String(b.guest_phone || '').replace(/\\D/g, '');\nconst wa = (b, msg) => ph(b) ? 'https://wa.me/' + ph(b) + '?text=' + encodeURIComponent(msg) : '';\nconst mins = x => { const v = Math.round((now - new Date(x)) / 6e4); return v > 0 ? v : 0; };\nconst ago = x => { const m = mins(x); return m < 60 ? m + ' mnt lalu' : m < 1440 ? Math.round(m / 60) + ' jam lalu' : Math.round(m / 1440) + ' hari lalu'; };\nconst inDay = (x, a, z) => { const t = new Date(x); return t >= a && t < z; };\nlet total = 0;\nconst me = (RA.me() || {}).id, isOwner = st.role === 'owner' || st.realRole === 'owner';\nconst RL = { unpaid: ['Belum bayar', '#FFF1D6', '#8A4B00'], doc_rejected: ['Dokumen ditolak', '#FDECEA', '#A12A1F'], dormant: ['Lama tidak sewa', '#E8EEF8', '#1F2B4D'], after_rental: ['Habis sewa', '#E3F7F5', '#077A70'], after_stay: ['Habis menginap/trip', '#E3F7F5', '#077A70'], near_level: ['Hampir naik level', '#F3E8FF', '#6B21A8'] };\nconst fuMsg = (f, nm) => { const c = (f.bookings || {}).code || ''; const r = f.reason || '';\n  return { unpaid: 'Halo Kak ' + nm + ', booking ' + c + ' sudah siap, tinggal pembayaran DP ya. Bisa langsung di halaman Pesanan Rentalaja. Ada kendala? Kami bantu 🙏',\n    doc_rejected: 'Halo Kak ' + nm + ', dokumen untuk booking ' + c + ' belum bisa kami terima (' + r.replace(/^Dokumen ditolak:?\\s*/, '') + '). Boleh dikirim ulang foto KTP yang jelas? Kami bantu sampai beres 🙏',\n    dormant: 'Halo Kak ' + nm + ', kangen nih 😊 Sudah lama belum sewa di Rentalaja. Ada rencana jalan atau acara dalam waktu dekat? Kami siapkan unit terbaik, dan poin member Kakak bisa dipakai potong harga.',\n    after_rental: 'Halo Kak ' + nm + ', terima kasih sudah sewa di Rentalaja 🙏 Gimana pengalamannya kemarin? Kalau ada rencana lagi, kabari kami ya, booking berikutnya bisa pakai poin member.',\n    after_stay: 'Halo Kak ' + nm + ', terima kasih sudah ' + (/Trip/.test(r) ? 'ikut trip jeep' : 'menginap') + ' bersama Rentalaja 🙏 Boleh minta ulasannya? Untuk kunjungan berikutnya, kabari kami ya, ada harga khusus pelanggan lama.',\n    near_level: 'Halo Kak ' + nm + ', tinggal 1 sewa lagi Kakak naik level member Rentalaja 🎉 Benefitnya diskon & poin lebih besar. Ada rencana sewa dalam waktu dekat?' }[f.rule_key] || ('Halo Kak ' + nm + ', ');\n};\nconst fuRows = d ? d.fu.filter(f => isOwner || !f.assigned_to || f.assigned_to === me) : [];\nconst fus = fuRows.slice(0, 12).map(f => { const c = f.customers || {}; const nm = c.name || 'Kak'; const r = RL[f.rule_key] || [f.rule_key, '#EEF0F3', '#4A5468'];\n  const ph = String(c.phone || '').replace(/\\D/g, '').replace(/^0/, '62');\n  const btn = (label, k, on) => ({ label, style: 'height: 34px; padding: 0 10px; border-radius: 9px; border: 1px solid ' + (on ? '#1E6B45' : '#D5D9E0') + '; background: ' + (on ? '#E4F2EA' : '#FFFFFF') + '; color: ' + (on ? '#1E6B45' : '#1F2B4D') + '; font: 700 12px \\'Plus Jakarta Sans\\', sans-serif; cursor: pointer', pick: this.act(() => this.fuSet(f, k)) });\n  return { name: nm + ((f.bookings || {}).code ? ' · ' + f.bookings.code : ''), kind: r[0], chip: 'display: inline-flex; align-items: center; height: 22px; padding: 0 8px; border-radius: 11px; font-size: 11px; font-weight: 800; white-space: nowrap; background: ' + r[1] + '; color: ' + r[2],\n    sub: (f.reason || '') + (f.amount ? ' · ' + RA.rp(f.amount) : '') + (f.status === 'contacted' ? ' · sudah dihubungi ' + RA.dayTime(f.contacted_at) + ', tunggu jawaban' : ' · masuk ' + RA.dayTime(f.created_at)),\n    wa: ph ? 'https://wa.me/' + ph + '?text=' + encodeURIComponent(fuMsg(f, nm)) : '', sent: () => { if (f.status === 'open') this.fuSet(f, 'contacted').catch(() => {}); },\n    res: [btn('Sewa lagi ✓', 'won', true), btn('Tidak jawab', 'no_answer'), btn('Belum minat', 'not_interested')] }; });\nconst sres = s.sres;\nconst KS = { pending_verification: ['Verifikasi', '#FFF1D6', '#8A4B00'], awaiting_payment: ['Belum bayar', '#FFF1D6', '#8A4B00'], confirmed: ['Terkonfirmasi', '#E8EEF8', '#1F2B4D'], active: ['Berjalan', '#E3F7F5', '#077A70'], returned: ['Kembali', '#EEF0F3', '#4A5468'], completed: ['Selesai', '#E4F2EA', '#1E6B45'], cancelled: ['Batal', '#EEF0F3', '#6B7486'], expired: ['Kedaluwarsa', '#EEF0F3', '#6B7486'], rejected: ['Ditolak', '#FDECEA', '#A12A1F'] };\nlet loading = !d; const tasks = [], today = [];\nconst T = (type, bg, fg, bar) => ({ type, chip: 'display: inline-flex; align-items: center; height: 22px; padding: 0 8px; border-radius: 11px; font-size: 11px; font-weight: 800; white-space: nowrap; background: ' + bg + '; color: ' + fg, bar });\nconst RED = ['#FDECEA', '#A12A1F', '#E5534B'], AMB = ['#FFF1D6', '#8A4B00', '#F2C14E'], BLU = ['#E8EEF8', '#1F2B4D', '#1F2B4D'], TEA = ['#E3F7F5', '#077A70', '#09BEAF'], GRY = ['#EEF0F3', '#4A5468', '#B4BCC8'];\nconst add = (pri, t, o) => tasks.push(Object.assign({ pri, at: o.at || 0 }, T(t[0], t[1][0], t[1][1], t[1][2]), o));\nif (d) {\n  const all = d.bk.map(b => Object.assign({ _k: kindOf(b) }, b));\n  const LBL = b => LN[b._k] + (b.branches ? ' · ' + b.branches.name : '');\n  // keluhan\n  d.tk.forEach(t => { const o = t.status !== 'resolved' && t.sla_due_at && new Date(t.sla_due_at) < now;\n    if (t.status === 'resolved') add(9, ['Keluhan · tanya puas', AMB], { title: t.code + ' · ' + (t.category || 'Keluhan'), sub: (t.summary || '').slice(0, 90), right: 'sudah ditangani PIC', rightColor: '#8A4B00', href: 'TiketCS.dc.html', hrefLabel: 'Buka tiket' });\n    else if (o || t.status === 'open') add(1, ['Keluhan', RED], { title: t.code + ' · ' + (t.category || 'Keluhan'), sub: (t.summary || '').slice(0, 90), right: t.status === 'open' ? 'belum dieskalasi' : 'lewat batas waktu', rightColor: '#A12A1F', href: 'TiketCS.dc.html', hrefLabel: 'Tangani' }); });\n  // telat kembali\n  all.filter(b => b._k !== 'inap' && b._k !== 'jeep' && b.status === 'active' && new Date(b.end_at) < now).forEach(b => add(2, ['Telat kembali', RED], { at: new Date(b.end_at), title: b.code + ' · ' + (b.guest_name || '—'), sub: item(b) + ' · seharusnya ' + RA.dayTime(b.end_at), right: 'telat ' + Math.round(mins(b.end_at) / 60) + ' jam', rightColo