{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Laporan aset</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0}\na{color:#1F2B4D}a:hover{color:#000}\nbutton:disabled{opacity:.55;cursor:not-allowed}\n[data-card]{background:#FFFFFF;border-radius:16px;box-shadow:0 2px 10px rgba(31,43,77,0.05);padding:14px;display:flex;flex-direction:column;gap:10px}\n[data-row]{display:flex;align-items:center;gap:10px;padding:10px 0;border-top:1px solid #EEF0F3;text-decoration:none;color:#1F2B4D}\n[data-row]:first-of-type{border-top:0}\n[data-btn]{height:36px;padding:0 14px;border-radius:10px;border:0;font:800 13px 'Plus Jakarta Sans',sans-serif;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;white-space:nowrap}\n[data-sheet] input{height:44px;width:100%;box-sizing:border-box;border:1px solid #D9DDE4;border-radius:10px;padding:0 12px;font:500 15px 'Plus Jakarta Sans',sans-serif;color:#1F2B4D;background:#FFFFFF}\n[data-sheet] label{display:flex;flex-direction:column;gap:4px;font-size:12px;font-weight:700;color:#4A5468}\n\n/* tampilan desktop (layar lebar) */\n@media (min-width: 1000px){\n  header[data-hero]{padding-left:32px !important;padding-right:32px !important;padding-top:22px !important}\n  header[data-hero] > div, main{max-width:1180px !important}\n  main{padding-left:32px !important;padding-right:32px !important}\n  header[data-hero] [data-scrollx]{overflow:visible !important;margin:0 !important;padding:0 !important;flex-wrap:wrap}\n  header[data-hero] [data-scrollx] > *{flex:1 1 140px !important;min-width:0 !important}\n  main{display:grid !important;grid-template-columns:1fr 1fr;align-items:start}\n  main > [role=\"tablist\"], main > [data-full]{grid-column:1 / -1}\n  main [role=\"tablist\"]{max-width:720px}\n  [data-sheet] > div{max-width:520px !important}\n}\n@media print{[data-sheet]{display:none !important}}\n@media (max-width:999px){[data-print]{display:none !important}}\n@media (min-width:1000px){[data-kgrid]{grid-template-columns:repeat(auto-fit,minmax(150px,1fr)) !important}}\n</style>\n</helmet>\n<div style=\"min-height: 100vh; box-sizing: border-box; background: #F4F6F9; color: #1F2B4D; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; flex-direction: column\">\n\n  <header data-hero=\"1\" style=\"background: linear-gradient(160deg, #1F2B4D 0%, #2E3F6B 100%); padding: 14px 16px 18px; color: #FFFFFF\">\n    <div style=\"max-width: 720px; margin: 0 auto; display: flex; flex-direction: column; gap: 12px\">\n      <div style=\"display: flex; justify-content: space-between; align-items: center; gap: 10px\"><div><div style=\"font-size: 13px; opacity: 0.9\">{{pageTitle}} · {{today}}</div><div style=\"font-size: 20px; font-weight: 800; line-height: 25px\">{{headline}}</div></div><button type=\"button\" data-noprint=\"1\" data-print=\"1\" onClick=\"{{cetak}}\" style=\"height: 32px; padding: 0 12px; border-radius: 16px; border: 0; background: #FFFFFF; color: #1F2B4D; font: 800 12px 'Plus Jakarta Sans', sans-serif; cursor: pointer; flex-shrink: 0\">⎙ Cetak / PDF</button></div>\n      <div data-kgrid=\"1\" style=\"display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px\"><sc-for list=\"{{kpi}}\" as=\"k\"><button type=\"button\" onClick=\"{{k.go}}\" style=\"min-width: 0; text-align: left; border: 0; cursor: pointer; color: #FFFFFF; font-family: inherit; background: rgba(255,255,255,0.12); border-radius: 12px; padding: 10px 12px\"><div style=\"font-size: 20px; font-weight: 800; color: {{k.c}}\">{{k.v}}</div><div style=\"font-size: 11px; opacity: 0.9\">{{k.l}}</div><div style=\"font-size: 10px; opacity: 0.75\">{{k.t}}</div></button></sc-for></div>\n    </div>\n  </header>\n\n  <main style=\"width: 100%; max-width: 720px; margin: 0 auto; box-sizing: border-box; padding: 12px 16px 24px; display: flex; flex-direction: column; gap: 12px\">\n    <sc-if value=\"{{hasTabs}}\"><div role=\"tablist\" data-noprint=\"1\" style=\"background: #FFFFFF; border-radius: 14px; padding: 4px; display: grid; grid-template-columns: {{tabCols}}; gap: 4px; box-shadow: 0 2px 10px rgba(31,43,77,0.05)\"><sc-for list=\"{{tabs}}\" as=\"t\"><button type=\"button\" role=\"tab\" aria-selected=\"{{t.on}}\" onClick=\"{{t.pick}}\" style=\"{{t.style}}\">{{t.label}}<sc-if value=\"{{t.n}}\"> <span style=\"{{t.badge}}\">{{t.n}}</span></sc-if></button></sc-for></div></sc-if>\n\n    <sc-if value=\"{{loading}}\"><div data-card=\"1\" data-full=\"1\" style=\"text-align: center; color: #4A5468; font-size: 14px\">Memuat data aset…</div></sc-if>\n    <sc-if value=\"{{error}}\"><div data-card=\"1\" data-full=\"1\" style=\"text-align: center; color: #A12A1F; font-size: 14px\">{{error}} <button type=\"button\" data-btn=\"1\" onClick=\"{{reload}}\" style=\"background: #1F2B4D; color: #FFFFFF; margin-left: 8px\">Coba lagi</button></div></sc-if>\n\n    <!-- ============ BENTROK ============ -->\n    <sc-if value=\"{{tBentrok}}\">\n      <div data-full=\"1\" style=\"font-size: 13px; line-height: 19px; color: #4A5468; padding: 0 4px\">{{bentrokIntro}}</div>\n      <sc-if value=\"{{bentrokEmpty}}\"><div data-card=\"1\" data-full=\"1\" style=\"text-align: center; font-size: 14px; color: #077A70\">{{bentrokEmpty}}</div></sc-if>\n      <sc-for list=\"{{conflicts}}\" as=\"c\"><section data-card=\"1\" style=\"border-left: 4px solid {{c.bar}}\">\n        <div style=\"display: flex; justify-content: space-between; gap: 10px; align-items: flex-start\"><div style=\"min-width: 0\"><div style=\"font-size: 12px; color: #4A5468\">{{c.code}} · {{c.guest}}</div><b style=\"font-size: 15px; line-height: 20px\">{{c.unit}}</b><div style=\"font-size: 12px; color: #4A5468\">{{c.branch}} · {{c.when}}</div></div><span style=\"{{c.chip}}\">{{c.tag}}</span></div>\n        <div style=\"font-size: 13px; line-height: 19px; background: {{c.bg}}; color: {{c.fg}}; border-radius: 10px; padding: 8px 10px\">{{c.why}}</div>\n        <div style=\"font-size: 12px; color: #4A5468\">{{c.altText}}</div>\n        <div style=\"display: flex; gap: 8px; flex-wrap: wrap\" data-noprint=\"1\"><sc-if value=\"{{c.canSwap}}\"><button type=\"button\" data-btn=\"1\" onClick=\"{{c.swap}}\" disabled=\"{{c.busy}}\" style=\"background: #09BEAF; color: #1F2B4D\">⇄ Ganti ke unit siap</button></sc-if><a data-btn=\"1\" href=\"{{c.hrefUnit}}\" style=\"background: #EEF0F3; color: #1F2B4D\">Buka unit</a><a data-btn=\"1\" href=\"{{c.hrefBook}}\" style=\"background: #EEF0F3; color: #1F2B4D\">Lihat di kalender</a></div>\n      </section></sc-for>\n    </sc-if>\n\n    <!-- ============ LAPORAN PADAT ============ -->\n    <sc-if value=\"{{tRep}}\">\n      <section data-card=\"1\" data-full=\"1\">\n        <div style=\"display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap\"><b style=\"font-size: 15px\">Kinerja aset · {{repPeriod}}</b><div style=\"display: flex; gap: 6px\" data-noprint=\"1\"><sc-for list=\"{{pers}}\" as=\"p\"><button type=\"button\" onClick=\"{{p.pick}}\" style=\"{{p.style}}\">{{p.label}}</button></sc-for></div></div>\n        <sc-if value=\"{{repLoading}}\"><span style=\"font-size: 13px; color: #4A5468\">Memuat…</span></sc-if>\n        <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 8px\"><sc-for list=\"{{repStats}}\" as=\"x\"><div style=\"background: #F6F7F9; border-radius: 10px; padding: 10px 12px\"><div style=\"font-size: 18px; font-weight: 800; color: {{x.c}}\">{{x.v}}</div><div style=\"font-size: 11px; color: #4A5468\">{{x.l}}</div><div style=\"font-size: 10px; color: #8A93A6\">{{x.t}}</div></div></sc-for></div>\n        <span style=\"font-size: 12px; line-height: 17px; color: #4A5468\">Utilisasi = hari unit disewa ÷ hari unit tersedia. Hasil bersih = pendapatan sewa − biaya servis − cicilan leasing di periode ini.</span>\n      </section>\n      <section data-card=\"1\" data-full=\"1\">\n        <b style=\"font-size: 15px\">Per kategori</b>\n        <div style=\"overflow-x: auto\"><table style=\"width: 100%; border-collapse: collapse; font-size: 12.5px; min-width: 560px\"><thead><tr style=\"text-align: left; color: #4A5468; font-size: 11.5px\"><th style=\"padding: 6px 4px\">Kategori</th><th style=\"padding: 6px 4px\">Unit</th><th style=\"padding: 6px 4px; width: 26%\">Utilisasi</th><th style=\"padding: 6px 4px; text-align: right\">Pendapatan</th><th style=\"padding: 6px 4px; text-align: right\">Servis</th><th style=\"padding: 6px 4px; text-align: right\">Bersih</th><th style=\"padding: 6px 4px; text-align: right\">Nganggur</th></tr></thead>\n          <tbody><sc-for list=\"{{repCat}}\" as=\"r\"><tr style=\"border-top: 1px solid #EEF0F3\"><td style=\"padding: 8px 4px; font-weight: 800\">{{r.name}}</td><td style=\"padding: 8px 4px\">{{r.units}}</td><td style=\"padding: 8px 4px\"><div style=\"display: flex; align-items: center; gap: 6px\"><div style=\"flex: 1; height: 7px; border-radius: 4px; background: #EEF0F3; overflow: hidden\"><div style=\"height: 100%; width: {{r.w}}; background: {{r.bar}}\"></div></div><b style=\"width: 38px; text-align: right; color: {{r.uc}}\">{{r.util}}</b></div></td><td style=\"padding: 8px 4px; text-align: right\">{{r.rev}}</td><td style=\"padding: 8px 4px; text-align: right; color: #A12A1F\">{{r.svc}}</td><td style=\"padding: 8px 4px; text-align: right; font-weight: 800; color: {{r.nc}}\">{{r.net}}</td><td style=\"padding: 8px 4px; text-align: right\">{{r.idle}}</td></tr></sc-for></tbody></table></div>\n      </section>\n      <section data-card=\"1\">\n        <b style=\"font-size: 15px\">Per cabang</b>\n        <sc-for list=\"{{repBr}}\" as=\"r\"><div style=\"display: flex; flex-direction: column; gap: 4px\"><div style=\"display: flex; justify-content: space-between; font-size: 13px; gap: 8px\"><b>{{r.name}}</b><span style=\"color: #4A5468; text-align: right\">{{r.units}} unit · {{r.util}} · {{r.rev}}</span></div><div style=\"height: 7px; background: #EEF0F3; border-radius: 4px; overflow: hidden\"><div style=\"height: 100%; width: {{r.w}}; background: {{r.bar}}\"></div></div></div></sc-for>\n      </section>\n      <section data-card=\"1\">\n        <b style=\"font-size: 15px\">Biaya servis tertinggi</b>\n        <sc-if value=\"{{topSvcEmpty}}\"><span style=\"font-size: 13px; color: #4A5468\">Belum ada biaya servis di periode ini.</span></sc-if>\n        <div><sc-for list=\"{{topSvc}}\" as=\"t\"><a data-row=\"1\" href=\"{{t.href}}\"><span style=\"flex: 1; min-width: 0\"><b style=\"font-size: 13.5px; display: block\">{{t.unit}}</b><span style=\"font-size: 12px; color: #4A5468\">{{t.sub}}</span></span><b style=\"font-size: 13.5px; color: #A12A1F\">{{t.svc}}</b></a></sc-for></div>\n      </section>\n      <section data-card=\"1\">\n        <b style=\"font-size: 15px\">Kandidat dijual / diganti</b>\n        <sc-if value=\"{{sellEmpty}}\"><span style=\"font-size: 13px; color: #4A5468\">{{sellEmpty}}</span></sc-if>\n        <div><sc-for list=\"{{sell}}\" as=\"t\"><a data-row=\"1\" href=\"{{t.href}}\"><span style=\"flex: 1; min-width: 0\"><b style=\"font-size: 13.5px; display: block\">{{t.unit}}</b><span style=\"font-size: 12px; color: #A12A1F\">{{t.why}}</span></span><span style=\"font-size: 12px; color: #4A5468; text-align: right; white-space: nowrap\">{{t.right}}</span></a></sc-for></div>\n      </section>\n      <section data-card=\"1\">\n        <b style=\"font-size: 15px\">Unit nganggur (tidak disewa sama sekali)</b>\n        <sc-if value=\"{{idleEmpty}}\"><span style=\"font-size: 13px; color: #4A5468\">{{idleEmpty}}</span></sc-if>\n        <div><sc-for list=\"{{idle}}\" as=\"t\"><a data-row=\"1\" href=\"{{t.href}}\"><span style=\"flex: 1; min-width: 0\"><b style=\"font-size: 13.5px; display: block\">{{t.unit}}</b><span style=\"font-size: 12px; color: #4A5468\">{{t.sub}}</span></span><span style=\"font-size: 12px; font-weight: 800; color: #8A4B00\">{{t.right}}</span></a></sc-for></div>\n        <span style=\"font-size: 12px; color: #4A5468\">Pertimbangkan mutasi ke cabang yang lebih ramai (lihat Utilisasi & mutasi).</span>\n      </section>\n    </sc-if>\n\n    <!-- ============ DOWNTIME ============ -->\n    <sc-if value=\"{{tDown}}\"><div id=\"sec-down\" data-full=\"1\" style=\"height: 0\"></div>\n      <section data-card=\"1\" data-full=\"1\">\n        <b style=\"font-size: 15px\">Unit tertahan servis · {{month}}</b>\n        <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 8px\"><sc-for list=\"{{downStats}}\" as=\"x\"><div style=\"background: #F6F7F9; border-radius: 10px; padding: 10px 12px\"><div style=\"font-size: 18px; font-weight: 800; color: {{x.c}}\">{{x.v}}</div><div style=\"font-size: 11px; color: #4A5468\">{{x.l}}</div><div style=\"font-size: 10px; color: #8A93A6\">{{x.t}}</div></div></sc-for></div>\n        <div style=\"font-size: 12px; line-height: 17px; color: #4A5468\">Potensi = hari tertahan × harga sewa harian. Anggapannya unit selalu laku, jadi ini batas atas, bukan kerugian pasti. {{downNote}}</div>\n      </section>\n      <section data-card=\"1\">\n        <b style=\"font-size: 15px\">Per kategori</b>\n        <sc-if value=\"{{downEmpty}}\"><div style=\"font-size: 13px; color: #4A5468\">Belum ada servis tercatat bulan ini.</div></sc-if>\n        <sc-for list=\"{{byCat}}\" as=\"x\"><div style=\"display: flex; flex-direction: column; gap: 4px\"><div style=\"display: flex; justify-content: space-between; font-size: 13px\"><b>{{x.name}}</b><span style=\"color: #4A5468\">{{x.days}} · {{x.value}}</span></div><div style=\"height: 8px; background: #EEF0F3; border-radius: 4px; overflow: hidden\"><div style=\"height: 100%; width: {{x.w}}; background: #E5534B; border-radius: 4px\"></div></div></div></sc-for>\n      </section>\n      <section data-card=\"1\">\n        <b style=\"font-size: 15px\">Per cabang</b>\n        <sc-if value=\"{{downEmpty}}\"><div style=\"font-size: 13px; color: #4A5468\">Belum ada servis tercatat bulan ini.</div></sc-if>\n        <sc-for list=\"{{byBranch}}\" as=\"x\"><div style=\"display: flex; flex-direction: column; gap: 4px\"><div style=\"display: flex; justify-content: space-between; font-size: 13px\"><b>{{x.name}}</b><span style=\"color: #4A5468\">{{x.days}} · {{x.value}}</span></div><div style=\"height: 8px; background: #EEF0F3; border-radius: 4px; overflow: hidden\"><div style=\"height: 100%; width: {{x.w}}; background: #1F2B4D; border-radius: 4px\"></div></div></div></sc-for>\n      </section>\n      <section data-card=\"1\" data-full=\"1\">\n        <b style=\"font-size: 15px\">Unit paling lama tertahan</b>\n        <div><sc-for list=\"{{topDown}}\" as=\"t\"><a data-row=\"1\" href=\"{{t.href}}\"><span style=\"font-size: 13px; font-weight: 800; width: 24px; color: #8A93A6\">{{t.no}}</span><span style=\"flex: 1; min-width: 0\"><b style=\"font-size: 14px; display: block\">{{t.unit}}</b><span style=\"font-size: 12px; color: #4A5468\">{{t.cat}} · {{t.branch}}</span></span><span style=\"text-align: right\"><b style=\"font-size: 14px; display: block; color: {{t.c}}\">{{t.days}}</b><span style=\"font-size: 12px; color: #4A5468\">{{t.value}}</span></span></a></sc-for></div>\n      </section>\n    </sc-if>\n\n    <!-- ============ JATUH TEMPO ============ -->\n    <sc-if value=\"{{tTempo}}\"><div id=\"sec-tempo\" data-full=\"1\" style=\"height: 0\"></div>\n      <sc-for list=\"{{dueGroups}}\" as=\"g\"><section data-card=\"1\">\n        <div style=\"display: flex; justify-content: space-between; align-items: center\"><b style=\"font-size: 15px; color: {{g.c}}\">{{g.title}}</b><span style=\"font-size: 12px; color: #4A5468\">{{g.n}} item</span></div>\n        <div><sc-for list=\"{{g.rows}}\" as=\"r\"><button type=\"button\" data-row=\"1\" onClick=\"{{r.edit}}\" style=\"width: 100%; background: none; border-left: 0; border-right: 0; border-bottom: 0; font-family: inherit; text-align: left; cursor: pointer\"><img src=\"{{r.ico}}\" alt=\"\" style=\"width: 22px; height: 22px; flex-shrink: 0\"><span style=\"flex: 1; min-width: 0\"><b style=\"font-size: 14px; display: block\">{{r.kind}} · {{r.unit}}</b><span style=\"font-size: 12px; color: #4A5468\">{{r.branch}} · {{r.date}}</span></span><span style=\"font-size: 12px; font-weight: 800; color: {{r.c}}; white-space: nowrap\">{{r.left}}</span></button></sc-for></div>\n      </section></sc-for>\n      <sc-if value=\"{{dueEmpty}}\"><div data-card=\"1\" style=\"text-align: center; font-size: 14px; color: #4A5468\">Tidak ada STNK, pajak, asuransi, atau garansi yang jatuh tempo dalam 60 hari. {{dueHint}}</div></sc-if>\n      <section data-card=\"1\">\n        <div style=\"display: flex; justify-content: space-between; align-items: center\"><b style=\"font-size: 15px\">Cicilan leasing 30 hari</b><span style=\"font-size: 13px; font-weight: 800\">{{loanTotal}}</span></div>\n        <sc-if value=\"{{loanEmpty}}\"><div style=\"font-size: 13px; color: #4A5468\">Belum ada cicilan aktif yang tercatat untuk unit.</div></sc-if>\n        <div><sc-for list=\"{{loans}}\" as=\"l\"><div data-row=\"1\"><span style=\"flex: 1; min-width: 0\"><b style=\"font-size: 14px; display: block\">{{l.lender}}</b><span style=\"font-size: 12px; color: #4A5468\">{{l.units}} · {{l.date}}</span></span><span style=\"text-align: right\"><b style=\"font-size: 14px; display: block\">{{l.amount}}</b><span style=\"font-size: 12px; font-weight: 800; color: {{l.c}}\">{{l.left}}</span></span></div></sc-for></div>\n      </section>\n      <section data-card=\"1\">\n        <div style=\"display: flex; justify-content: space-between; align-items: center\"><b style=\"font-size: 15px\">Baterai iPhone di bawah 85%</b><span style=\"font-size: 12px; color: #4A5468\">{{batN}} unit</span></div>\n        <sc-if value=\"{{batEmpty}}\"><div style=\"font-size: 13px; color: #4A5468\">{{batEmpty}}</div></sc-if>\n        <div><sc-for list=\"{{battery}}\" as=\"b\"><div data-row=\"1\"><span style=\"font-size: 18px; font-weight: 800; color: {{b.c}}; width: 52px; flex-shrink: 0\">{{b.pct}}</span><span style=\"flex: 1; min-width: 0\"><b style=\"font-size: 14px; display: block\">{{b.unit}}</b><span style=\"font-size: 12px; color: #4A5468\">{{b.branch}} · dicek {{b.at}}</span></span><button type=\"button\" data-btn=\"1\" data-noprint=\"1\" onClick=\"{{b.wo}}\" disabled=\"{{b.busy}}\" style=\"background: #1F2B4D; color: #FFFFFF; height: 32px; font-size: 12px\">Ganti baterai</button></div></sc-for></div>\n      </section>\n    </sc-if>\n\n    <!-- ============ LENGKAPI DATA ============ -->\n    <sc-if value=\"{{tData}}\"><div id=\"sec-data\" data-full=\"1\" style=\"height: 0\"></div>\n      <section data-card=\"1\" data-full=\"1\">\n        <div style=\"display: flex; justify-content: space-between; align-items: baseline\"><b style=\"font-size: 15px\">Kelengkapan data aset</b><span style=\"font-size: 22px; font-weight: 800; color: {{compC}}\">{{comp}}</span></div>\n        <div style=\"height: 10px; background: #EEF0F3; border-radius: 5px; overflow: hidden\"><div style=\"height: 100%; width: {{comp}}; background: {{compC}}\"></div></div>\n        <div style=\"font-size: 13px; font-weight: 700\">{{compSub}}</div>\n        <div style=\"font-size: 12px; line-height: 17px; color: #4A5468\">Tanpa data ini, jatuh tempo dan perawatan berbasis km tidak bisa dihitung. Ketuk unit untuk mengisi.</div>\n      </section>\n      <sc-for list=\"{{gaps}}\" as=\"g\"><section data-card=\"1\">\n        <button type=\"button\" onClick=\"{{g.toggle}}\" style=\"display: flex; align-items: center; gap: 10px; border: 0; background: none; padding: 0; cursor: pointer; font-family: inherit; color: #1F2B4D; text-align: left\"><img src=\"{{g.ico}}\" alt=\"\" style=\"width: 24px; height: 24px; flex-shrink: 0\"><span style=\"flex: 1\"><b style=\"font-size: 14px; display: block\">{{g.title}}</b><span style=\"font-size: 12px; color: #4A5468\">{{g.desc}}</span></span><span style=\"font-size: 18px; font-weight: 800; color: {{g.c}}\">{{g.n}}</span><span style=\"color: #8A93A6\">{{g.arrow}}</span></button>\n        <sc-if value=\"{{g.open}}\"><div><sc-for list=\"{{g.rows}}\" as=\"r\"><button type=\"button\" data-row=\"1\" onClick=\"{{r.edit}}\" style=\"width: 100%; background: none; border-left: 0; border-right: 0; border-bottom: 0; font-family: inherit; text-align: left; cursor: pointer\"><span style=\"flex: 1; min-width: 0\"><b style=\"font-size: 13px; display: block\">{{r.unit}}</b><span style=\"font-size: 12px; color: #4A5468\">{{r.branch}}</span></span><span style=\"font-size: 12px; font-weight: 800; color: #077A70\">Isi ›</span></button></sc-for><sc-if value=\"{{g.more}}\"><div style=\"font-size: 12px; color: #4A5468; padding-top: 8px\">{{g.more}}</div></sc-if></div></sc-if>\n        <sc-if value=\"{{g.link}}\"><a href=\"{{g.link}}\" style=\"font-size: 13px; font-weight: 800; color: #077A70; text-decoration: none\">{{g.linkText}} ›</a></sc-if>\n      </section></sc-for>\n    </sc-if>\n  </main>\n\n  <!-- ============ LEMBAR ISI DATA UNIT ============ -->\n  <sc-if value=\"{{sheet}}\"><div data-sheet=\"1\" style=\"position: fixed; inset: 0; z-index: 70; background: rgba(31,43,77,0.45); display: flex; align-items: flex-end; justify-content: center\">\n    <div style=\"width: 100%; max-width: 430px; background: #FFFFFF; border-radius: 20px 20px 0 0; padding: 16px; box-sizing: border-box; display: flex; flex-direction: column; gap: 12px; max-height: 88vh; overflow-y: auto\">\n      <div style=\"display: flex; justify-content: space-between; align-items: flex-start; gap: 10px\"><div><div style=\"font-size: 12px; color: #4A5468\">Isi data unit</div><b style=\"font-size: 16px\">{{sheet.title}}</b><div style=\"font-size: 12px; color: #4A5468\">{{sheet.sub}}</div></div><button type=\"button\" onClick=\"{{closeSheet}}\" aria-label=\"Tutup\" style=\"width: 32px; height: 32px; border-radius: 16px; border: 0; background: #EEF0F3; font-size: 16px; cursor: pointer\">✕</button></div>\n      <sc-if value=\"{{sheet.loading}}\"><div style=\"font-size: 14px; color: #4A5468\">Memuat…</div></sc-if>\n      <sc-for list=\"{{sheet.fields}}\" as=\"f\"><label>{{f.label}}<input type=\"{{f.type}}\" value=\"{{f.value}}\" onInput=\"{{f.set}}\" placeholder=\"{{f.ph}}\" inputmode=\"{{f.im}}\"><span style=\"font-weight: 500; color: #8A93A6\">{{f.hint}}</span></label></sc-for>\n      <div style=\"display: flex; gap: 8px\"><button type=\"button\" data-btn=\"1\" onClick=\"{{closeSheet}}\" style=\"flex: 1; height: 44px; background: #EEF0F3; color: #1F2B4D\">Batal</button><button type=\"button\" data-btn=\"1\" onClick=\"{{saveSheet}}\" disabled=\"{{sheet.busy}}\" style=\"flex: 2; height: 44px; background: #09BEAF; color: #1F2B4D\">{{sheet.btn}}</button></div>\n      <a href=\"{{sheet.href}}\" style=\"font-size: 13px; font-weight: 700; color: #077A70; text-align: center; text-decoration: none\">Buka rekam jejak unit ›</a>\n    </div>\n  </div></sc-if>\n</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{\"$preview\":{\"width\":390,\"height\":844}}'>\nclass Component extends DCLogic {\nP = { doc: '<path d=\"M6 3h9l4 4v14H6z\"/><path d=\"M14 3v5h5M9 13h7M9 17h5\"/>', shield: '<path d=\"M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z\"/>', road: '<path d=\"M5 21L9 3M19 21L15 3M12 6v2M12 11v2M12 16v2\"/>', battery: '<rect x=\"2\" y=\"7\" width=\"17\" height=\"10\" rx=\"2\"/><path d=\"M22 11v2M6 10v4\"/>', money: '<rect x=\"2\" y=\"6\" width=\"20\" height=\"12\" rx=\"2\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/>', wrench: '<path d=\"M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.4-.6-.6-2.4z\"/>' };\nic(n, c) { return 'data:image/svg+xml;utf8,' + encodeURIComponent('<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"' + (c || '#1F2B4D') + '\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">' + this.P[n] + '</svg>'); }\nMODE = 'lap';\nTABS = { all: ['bentrok', 'tempo', 'down', 'data'], lap: ['down', 'tempo'], data: ['data'] };\nstate = { per: 30, rep: null, tab: '', d: null, err: '', open: {}, busy: {}, sheet: null };\nasync componentDidMount() {\n  const ok = this.TABS[this.MODE], t = (RA.params && RA.params().tab) || ''; this.setState({ tab: ok.indexOf(t) > -1 ? t : ok[0] });\n  await RA.staff(); this.stop = RA.poll(this, () => this.reload(), 120000);\n}\ncomponentWillUnmount() { if (this.stop) this.stop(); }\nasync loadRep() {\n  if (this.MODE !== 'lap') return; const per = this.state.per; const to = new Date(Date.now() + 7 * 36e5); const fr = per === 'm' ? new Date(Date.UTC(to.getUTCFullYear(), to.getUTCMonth(), 1)) : new Date(to.getTime() - (per - 1) * 864e5);\n  try { const rep = await RA.call('asset_report', { p_from: fr.toISOString().slice(0, 10), p_to: to.toISOString().slice(0, 10) }); if (RA_ALIVE(this) && this.state.per === per) this.setState({ rep }); } catch (e) { if (RA_ALIVE(this)) this.setState({ rep: { err: (e && e.message) || 'Gagal' } }); }\n}\nasync reload() {\n  this.loadRep();\n  try { const d = await RA.call('asset_risk', {}); if (!RA_ALIVE(this)) return; this.setState({ d, err: '' }); }\n  catch (e) { if (RA_ALIVE(this)) this.setState({ err: (e && e.message) || 'Gagal memuat' }); }\n}\nasync swap(c) {\n  if (!confirm('Pindahkan booking ' + c.code + ' dari ' + c.unit + ' ke unit lain yang siap di jadwal yang sama?')) return;\n  this.setState({ busy: Object.assign({}, this.state.busy, { [c.item_id]: 1 }) });\n  try { const r = await RA.call('asset_swap_unit', { p_item: c.item_id }); RA.ok('Booking ' + r.booking + ' dipindah ke ' + r.to); await this.reload(); }\n  catch (e) { RA.err(e); }\n  if (RA_ALIVE(this)) this.setState({ busy: Object.assign({}, this.state.busy, { [c.item_id]: 0 }) });\n}\nasync batteryWo(b) {\n  if (!confirm('Buat servis \"ganti baterai\" untuk ' + b.unit + '? Unit akan masuk antrean servis.')) return;\n  this.setState({ busy: Object.assign({}, this.state.busy, { ['b' + b.unit_id]: 1 }) });\n  try { await RA.call('wo_create', { p_unit: b.unit_id, p_source: 'routine', p_complaint: 'Ganti baterai — kesehatan baterai ' + b.pct + '%' }); RA.ok('Servis ganti baterai dibuat'); await this.reload(); }\n  catch (e) { RA.err(e); }\n  if (RA_ALIVE(this)) this.setState({ busy: Object.assign({}, this.state.busy, { ['b' + b.unit_id]: 0 }) });\n}\nasync openSheet(id, label) {\n  this.setState({ sheet: { id, title: label || 'Unit', loading: true, v: {}, u: null } });\n  const r = await RA.from('units').select('id,code,plate_or_serial,stnk_due,stnk_tax_due,insurance_due,warranty_until,odometer_km,health,branch_id,products(name,categories(slug,name))').eq('id', id).maybeSingle();\n  if (!RA_ALIVE(this) || !this.state.sheet || this.state.sheet.id !== id) return;\n  if (r.error || !r.data) { RA.err(r.error || 'Unit tidak ditemukan'); this.setState({ sheet: null }); return; }\n  const u = r.data, h = u.health || {};\n  this.setState({ sheet: Object.assign({}, this.state.sheet, { loading: false, u, v: { stnk_tax_due: u.stnk_tax_due || '', stnk_due: u.stnk_due || '', insurance_due: u.insurance_due || '', warranty_until: u.warranty_until || '', odometer_km: u.odometer_km ? String(u.odometer_km) : '', battery: h.battery != null ? String(h.battery) : '' } }) });\n}\nasync saveSheet() {\n  const sh = this.state.sheet; if (!sh || !sh.u) return;\n  const u = sh.u, v = sh.v, h = u.health || {}, p = {};\n  ['stnk_tax_due', 'stnk_due', 'insurance_due', 'warranty_until'].forEach(k => { if ((v[k] || '') !== (u[k] || '')) p[k] = v[k] || ''; });\n  if (v.odometer_km && +v.odometer_km !== +(u.odometer_km || 0)) {\n    if (+v.odometer_km < +(u.odometer_km || 0)) { RA.err('Kilometer tidak boleh lebih kecil dari catatan terakhir (' + RA.num(u.odometer_km) + ' km)'); return; }\n    p.odometer_km = v.odometer_km;\n  }\n  if ((v.battery || '') !== (h.battery != null ? String(h.battery) : '')) p.battery = v.battery || '';\n  if (!Object.keys(p).length) { this.setState({ sheet: null }); return; }\n  this.setState({ sheet: Object.assign({}, sh, { busy: true }) });\n  try { await RA.call('unit_set_dues', { p_unit: u.id, p }); RA.ok('Data ' + sh.title + ' tersimpan'); this.setState({ sheet: null }); await this.reload(); }\n  catch (e) { RA.err(e); if (RA_ALIVE(this)) this.setState({ sheet: Object.assign({}, this.state.sheet, { busy: false }) }); }\n}\nrenderVals() {\nconst s = this.state, d = s.d, now = new Date();\nconst det = id => 'AsetUnit.dc.html?id=' + id;\nconst rpS = n => RA.rpShort ? RA.rpShort(n) : RA.rp(n);\nconst hari = n => (Math.round(n * 10) / 10).toString().replace('.', ',') + ' hari';\nconst left = days => days < 0 ? 'lewat ' + (-days) + ' hr' : days === 0 ? 'hari ini' : days + ' hr lagi';\nconst leftC = days => days < 0 ? '#A12A1F' : days <= 7 ? '#B4540A' : days <= 30 ? '#8A4B00' : '#4A5468';\nconst chip = (bg, fg) => 'display: inline-flex; align-items: center; height: 24px; padding: 0 10px; border-radius: 12px; font-size: 12px; font-weight: 800; white-space: nowrap; flex-shrink: 0; background: ' + bg + '; color: ' + fg;\nconst go = t => () => { if (this.MODE === 'all') { this.setState({ tab: t }); return; } const el = document.getElementById('sec-' + t); if (el && el.scrollIntoView) el.scrollIntoView({ behavior: 'smooth', block: 'start' }); };\nlet o = { conflicts: [], dueGroups: [], loans: [], battery: [], byCat: [], byBranch: [], topDown: [], downStats: [], gaps: [], kpi: [] };\nlet head = 'Memuat…', nConf = 0, nDue = 0, nGap = 0;\nif (d) {\n  /* ---- bentrok booking ---- */\n  const ST = { service: 'sedang diservis', waiting_part: 'menunggu part', qc: 'menunggu QC', inactive: 'tidak aktif' };\n  o.conflicts = (d.conflicts || []).map(c => {\n    const st = new Date(c.start), en = new Date(c.end), soon = (st - now) / 36e5 < 48;\n    const rest = [c.days_left != null ? 'sisa ' + c.days_left + ' hari' : '', c.rentals_left != null ? 'sisa ' + c.rentals_left + ' sewa' : '', c.km_left != null ? 'sisa ' + RA.num(c.km_left) + ' km' : ''].filter(Boolean).join(', ');\n    const why = c.kind === 'status' ? 'Unit ' + (ST[c.ustatus] || c.ustatus) + ', padahal dijadwalkan disewa.' : c.kind === 'overdue' ? 'Sudah lewat jadwal perawatan \"' + (c.rule || 'servis berkala') + '\". Servis dulu sebelum diserahkan.' : 'Perawatan \"' + (c.rule || 'servis berkala') + '\" jatuh tempo selama masa sewa' + (rest ? ' (' + rest + ')' : '') + '. Servis sebelum serah-terima atau ganti unit.';\n    const red = c.kind !== 'during';\n    return { item_id: c.item_id, code: c.code, guest: c.guest || 'Tamu', unit: c.unit, branch: c.branch || '—',\n      when: RA.dayTime(st) + ' → ' + RA.date(en), tag: soon ? '≤ 48 jam' : RA.date(st), chip: soon ? chip('#FDECEA', '#A12A1F') : chip('#FFF4E5', '#8A4B00'),\n      bar: red ? '#E5534B' : '#F0A43A', bg: red ? '#FDECEA' : '#FFF4E5', fg: red ? '#A12A1F' : '#8A4B00', why,\n      altText: c.alt ? c.alt + ' unit pengganti yang sama siap & kosong di jadwal itu' : 'Tidak ada unit pengganti yang siap — percepat servis atau hubungi pelanggan.',\n      canSwap: c.alt > 0 && !!c.item_id, busy: !!s.busy[c.item_id], swap: () => this.swap(c), hrefUnit: det(c.unit_id), hrefBook: 'AsetKalender.dc.html?cat=' + encodeURIComponent(c.cat || '') };\n  });\n  nConf = o.conflicts.length;\n  o.bentrokIntro = 'Booking 14 hari ke depan yang unitnya sedang diservis, lewat jadwal perawatan, atau perawatannya jatuh tempo saat disewa.';\n  o.bentrokEmpty = nConf ? '' : 'Tidak ada bentrok. ' + (d.upcoming_bookings || 0) + ' booking dengan unit terpasang dalam 14 hari ke depan sudah dicek.';\n\n  /* ---- jatuh tempo ---- */\n  const ICO = { 'Pajak STNK': this.ic('doc', '#8A4B00'), 'STNK 5 tahunan': this.ic('doc', '#8A4B00'), 'Asuransi': this.ic('shield', '#8A4B00'), 'Garansi': this.ic('shield', '#8A4B00') };\n  const rows = (d.dues || []).map(x => ({ kind: x.kind, unit: x.unit, branch: x.branch || '—', date: RA.date(x.date) + ' ' + String(x.date).slice(0, 4), left: left(x.days), c: leftC(x.days), ico: ICO[x.kind] || this.ic('doc', '#8A4B00'), days: x.days, edit: () => this.openSheet(x.unit_id, x.unit) }));\n  const grp = [['Lewat jatuh tempo', r => r.days < 0, '#A12A1F'], ['7 hari ke depan', r => r.days >= 0 && r.days <= 7, '#B4540A'], ['8–30 hari', r => r.days > 7 && r.days <= 30, '#8A4B00'], ['31–60 hari', r => r.days > 30, '#1F2B4D']];\n  o.dueGroups = grp.map(([title, f, c]) => { const rr = rows.filter(f); return { title, c, n: rr.length, rows: rr }; }).filter(g => g.n);\n  nDue = rows.filter(r => r.days <= 30).length;\n  const over = rows.filter(r => r.days < 0).length;\n  o.dueEmpty = !rows.length; o.dueHint = (d.gaps.no_tax || []).length ? (d.gaps.no_tax || []).length + ' kendaraan belum punya tanggal pajak — isi di tab Data.' : '';\n  o.loans = (d.loans || []).map(l => ({ lender: l.lender || 'Leasing', units: l.units + ' unit', date: RA.date(l.date), amount: RA.rp(l.amount), left: left(l.days), c: leftC(l.days) }));\n  const loanSum = (d.loans || []).reduce((a, l) => a + (+l.amount || 0), 0);\n  o.loanTotal = loanSum ? RA.rp(loanSum) : ''; o.loanEmpty = !o.loans.length;\n  o.battery = (d.battery || []).map(b => ({ unit: b.unit, branch: b.branch || '—', pct: b.pct + '%', c: b.pct < 80 ? '#A12A1F' : '#B4540A', at: b.at ? RA.date(b.at) : '—', busy: !!s.busy['b' + b.unit_id], wo: () => this.batteryWo(b) }));\n  o.batN = o.battery.length;\n  o.batEmpty = o.battery.length ? '' : ((d.gaps.no_battery || []).length ? 'Belum bisa dinilai: ' + d.gaps.no_battery.length + ' iPhone belum diisi kesehatan baterainya (tab Data).' : 'Semua iPhone di atas 85%.');\n\n  /* ---- downtime ---- */\n  const dt = d.downtime || {};\n  const dm = +dt.days_m || 0, dp = +dt.days_p || 0;\n  o.downStats = [[hari(dm), 'hari unit tertahan', dp ? (dm > dp ? '▲' : '▼') + ' bln lalu ' + hari(dp) : 'bulan lalu belum ada data', 