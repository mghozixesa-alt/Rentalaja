{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Sewa untuk kantor dan acara</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0}\na{color:#1F2B4D}a:hover{color:#000}\n</style>\n</helmet>\n<div style=\"background: #FFFFFF; color: #1F2B4D; font-family: 'Plus Jakarta Sans', system-ui, sans-serif\">\n  <header style=\"border-bottom: 1px solid #E6E8EC\">\n    <div style=\"width: 100%; max-width: 1200px; margin: 0 auto; padding: 0 24px; box-sizing: border-box; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; min-height: 72px; padding-top: 10px; padding-bottom: 10px\">\n      <a href=\"SeoMotorGarut.dc.html\" aria-label=\"Rentalaja\"><img src=\"logo.png\" alt=\"Rentalaja\" style=\"height: 34px; width: auto; display: block\"></a>\n      <nav aria-label=\"Menu\" style=\"display: flex; flex-wrap: wrap; gap: 6px 22px; font-size: 15px; font-weight: 700\">\n        <a href=\"SeoMotorGarut.dc.html\" style=\"text-decoration: none\">Sewa motor</a>\n        <a href=\"Cari.dc.html\" style=\"text-decoration: none\">Sewa gadget</a>\n        <a href=\"Korporat.dc.html\" aria-current=\"page\" style=\"text-decoration: none; color: #077A70\">Untuk perusahaan</a>\n      </nav>\n      <sc-if value=\"{{waHref}}\"><a href=\"{{waHref}}\" style=\"height: 44px; padding: 0 18px; border-radius: 10px; border: 1px solid #1F2B4D; font-size: 14px; font-weight: 700; display: inline-flex; align-items: center; text-decoration: none\">Chat tim bisnis</a></sc-if>\n    </div>\n  </header>\n\n  <section style=\"background: #1F2B4D; color: #FFFFFF\">\n    <div style=\"width: 100%; max-width: 1200px; margin: 0 auto; padding: 0 24px; box-sizing: border-box; padding-top: 56px; padding-bottom: 56px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(420px, 100%), 1fr)); gap: 40px; align-items: center\">\n      <div style=\"display: flex; flex-direction: column; gap: 16px\">\n        <h1 style=\"margin: 0; font-size: clamp(32px, 4vw, 48px); line-height: 1.12; font-weight: 800; letter-spacing: -0.02em\">Sewa untuk kantor, acara, dan rombongan</h1>\n        <p style=\"margin: 0; font-size: 18px; line-height: 28px; color: #DDE3EE\">Motor untuk tim lapangan, iPhone dan kamera untuk produksi konten, proyektor dan PS untuk acara, perlengkapan camping untuk gathering. Satu penawaran, satu invoice.</p>\n        <a href=\"#form\" style=\"height: 52px; padding: 0 22px; border-radius: 12px; background: #09BEAF; color: #1F2B4D; font: 800 16px 'Plus Jakarta Sans', sans-serif; display: inline-flex; align-items: center; justify-content: center; text-decoration: none; border: none; cursor: pointer; align-self: flex-start\">Minta penawaran</a>\n      </div>\n      <div style=\"height: 320px; border-radius: 20px; background: #34406A; display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 700; color: #DDE3EE; text-align: center; padding: 20px; box-sizing: border-box\">Foto belum diunggah</div>\n    </div>\n  </section>\n\n  <section style=\"width: 100%; max-width: 1200px; margin: 0 auto; padding: 0 24px; box-sizing: border-box; padding-top: 48px; padding-bottom: 16px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); gap: 16px\"><div style=\"background: #FFFFFF; border: 1px solid #E6E8EC; border-radius: 16px; padding: 20px; display: flex; flex-direction: column; gap: 6px\"><b style=\"font-size: 17px\">Invoice atas nama perusahaan</b><span style=\"font-size: 14px; line-height: 21px; color: #4A5468\">Lengkap dengan faktur pajak, bisa dibayar per termin.</span></div><div style=\"background: #FFFFFF; border: 1px solid #E6E8EC; border-radius: 16px; padding: 20px; display: flex; flex-direction: column; gap: 6px\"><b style=\"font-size: 17px\">Harga khusus volume</b><span style=\"font-size: 14px; line-height: 21px; color: #4A5468\">Diskon bertingkat untuk banyak unit atau sewa panjang.</span></div><div style=\"background: #FFFFFF; border: 1px solid #E6E8EC; border-radius: 16px; padding: 20px; display: flex; flex-direction: column; gap: 6px\"><b style=\"font-size: 17px\">Antar dan pasang di lokasi</b><span style=\"font-size: 14px; line-height: 21px; color: #4A5468\">Runner mengantar, mengecek, dan menjemput semua unit.</span></div><div style=\"background: #FFFFFF; border: 1px solid #E6E8EC; border-radius: 16px; padding: 20px; display: flex; flex-direction: column; gap: 6px\"><b style=\"font-size: 17px\">Satu PIC untuk semua</b><span style=\"font-size: 14px; line-height: 21px; color: #4A5468\">Satu kontak dari penawaran sampai pengembalian.</span></div></section>\n\n  <section style=\"width: 100%; max-width: 1200px; margin: 0 auto; padding: 0 24px; box-sizing: border-box; padding-top: 32px; padding-bottom: 16px; display: flex; flex-direction: column; gap: 18px\">\n    <h2 style=\"margin: 0; font-size: 28px; line-height: 36px; font-weight: 800; letter-spacing: -0.01em\">Alurnya</h2>\n    <div style=\"display: flex; flex-wrap: wrap; gap: 16px\"><div style=\"flex: 1 1 160px; display: flex; gap: 10px; align-items: center\"><span style=\"width: 34px; height: 34px; border-radius: 17px; background: #1F2B4D; color: #09BEAF; font-weight: 800; display: flex; align-items: center; justify-content: center; flex-shrink: 0\">1</span><span style=\"font-size: 15px; font-weight: 700\">Ajukan kebutuhan</span></div><div style=\"flex: 1 1 160px; display: flex; gap: 10px; align-items: center\"><span style=\"width: 34px; height: 34px; border-radius: 17px; background: #1F2B4D; color: #09BEAF; font-weight: 800; display: flex; align-items: center; justify-content: center; flex-shrink: 0\">2</span><span style=\"font-size: 15px; font-weight: 700\">Terima penawaran</span></div><div style=\"flex: 1 1 160px; display: flex; gap: 10px; align-items: center\"><span style=\"width: 34px; height: 34px; border-radius: 17px; background: #1F2B4D; color: #09BEAF; font-weight: 800; display: flex; align-items: center; justify-content: center; flex-shrink: 0\">3</span><span style=\"font-size: 15px; font-weight: 700\">Setujui dan bayar DP</span></div><div style=\"flex: 1 1 160px; display: flex; gap: 10px; align-items: center\"><span style=\"width: 34px; height: 34px; border-radius: 17px; background: #1F2B4D; color: #09BEAF; font-weight: 800; display: flex; align-items: center; justify-content: center; flex-shrink: 0\">4</span><span style=\"font-size: 15px; font-weight: 700\">Unit diantar dan dipasang</span></div><div style=\"flex: 1 1 160px; display: flex; gap: 10px; align-items: center\"><span style=\"width: 34px; height: 34px; border-radius: 17px; background: #1F2B4D; color: #09BEAF; font-weight: 800; display: flex; align-items: center; justify-content: center; flex-shrink: 0\">5</span><span style=\"font-size: 15px; font-weight: 700\">Invoice pelunasan</span></div></div>\n  </section>\n\n  <section id=\"form\" style=\"width: 100%; max-width: 1200px; margin: 0 auto; padding: 0 24px; box-sizing: border-box; padding-top: 40px; padding-bottom: 64px\">\n    <div style=\"background: #F6F7F9; border-radius: 20px; padding: clamp(20px, 3vw, 36px); display: flex; flex-direction: column; gap: 18px\">\n      <h2 style=\"margin: 0; font-size: 28px; line-height: 36px; font-weight: 800; letter-spacing: -0.01em\">Ceritakan kebutuhanmu</h2>\n      <sc-if value=\"{{open}}\">\n        <form style=\"display: flex; flex-direction: column; gap: 16px\">\n          <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); gap: 14px\">\n            <label style=\"display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 700; color: #4A5468\">Nama perusahaan atau instansi<input type=\"text\" value=\"{{f.company}}\" onChange=\"{{set.company}}\" placeholder=\"PT Contoh Maju\" style=\"height: 48px; box-sizing: border-box; border: 1px solid #D5D9E0; border-radius: 10px; padding: 0 12px; font: 600 15px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; background: #FFFFFF; width: 100%\"></label>\n            <label style=\"display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 700; color: #4A5468\">Nama PIC<input type=\"text\" autocomplete=\"name\" value=\"{{f.pic_name}}\" onChange=\"{{set.pic_name}}\" style=\"height: 48px; box-sizing: border-box; border: 1px solid #D5D9E0; border-radius: 10px; padding: 0 12px; font: 600 15px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; background: #FFFFFF; width: 100%\"></label>\n            <label style=\"display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 700; color: #4A5468\">Nomor WhatsApp<input type=\"tel\" autocomplete=\"tel\" value=\"{{f.pic_phone}}\" onChange=\"{{set.pic_phone}}\" style=\"height: 48px; box-sizing: border-box; border: 1px solid #D5D9E0; border-radius: 10px; padding: 0 12px; font: 600 15px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; background: #FFFFFF; width: 100%\"></label>\n            <label style=\"display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 700; color: #4A5468\">Email untuk invoice<input type=\"email\" autocomplete=\"email\" value=\"{{f.email}}\" onChange=\"{{set.email}}\" style=\"height: 48px; box-sizing: border-box; border: 1px solid #D5D9E0; border-radius: 10px; padding: 0 12px; font: 600 15px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; background: #FFFFFF; width: 100%\"></label>\n            <label style=\"display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 700; color: #4A5468\">Kebutuhan<select onChange=\"{{set.need}}\" style=\"height: 48px; box-sizing: border-box; border: 1px solid #D5D9E0; border-radius: 10px; padding: 0 12px; font: 600 15px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; background: #FFFFFF; width: 100%\"><sc-for list=\"{{needs}}\" as=\"o\"><option value=\"{{o.v}}\" selected=\"{{o.sel}}\">{{o.v}}</option></sc-for></select></label>\n            <label style=\"display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 700; color: #4A5468\">Kota<select onChange=\"{{set.city}}\" style=\"height: 48px; box-sizing: border-box; border: 1px solid #D5D9E0; border-radius: 10px; padding: 0 12px; font: 600 15px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; background: #FFFFFF; width: 100%\"><sc-for list=\"{{cities}}\" as=\"o\"><option value=\"{{o.v}}\" selected=\"{{o.sel}}\">{{o.v}}</option></sc-for></select></label>\n            <label style=\"display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 700; color: #4A5468\">Mulai<input type=\"date\" value=\"{{f.start_date}}\" min=\"{{today}}\" onChange=\"{{set.start_date}}\" style=\"height: 48px; box-sizing: border-box; border: 1px solid #D5D9E0; border-radius: 10px; padding: 0 12px; font: 600 15px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; background: #FFFFFF; width: 100%\"></label>\n            <label style=\"display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 700; color: #4A5468\">Selesai<input type=\"date\" value=\"{{f.end_date}}\" min=\"{{f.start_date}}\" onChange=\"{{set.end_date}}\" style=\"height: 48px; box-sizing: border-box; border: 1px solid #D5D9E0; border-radius: 10px; padding: 0 12px; font: 600 15px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; background: #FFFFFF; width: 100%\"></label>\n          </div>\n          <div style=\"display: flex; flex-direction: column; gap: 10px\">\n            <div style=\"font-size: 15px; font-weight: 800\">Barang yang dibutuhkan</div>\n            <sc-for list=\"{{rows}}\" as=\"r\"><div style=\"display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 1fr); gap: 10px\">\n          <label style=\"display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 700; color: #4A5468\">Barang<select onChange=\"{{r.setProduct}}\" style=\"height: 48px; box-sizing: border-box; border: 1px solid #D5D9E0; border-radius: 10px; padding: 0 12px; font: 600 15px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; background: #FFFFFF; width: 100%\"><option value=\"\">Pilih barang</option><sc-for list=\"{{r.opts}}\" as=\"o\"><option value=\"{{o.id}}\" selected=\"{{o.sel}}\">{{o.name}}</option></sc-for></select></label>\n          <label style=\"display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 700; color: #4A5468\">Jumlah<input type=\"number\" inputmode=\"numeric\" min=\"1\" value=\"{{r.qty}}\" onChange=\"{{r.setQty}}\" style=\"height: 48px; box-sizing: border-box; border: 1px solid #D5D9E0; border-radius: 10px; padding: 0 12px; font: 600 15px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; background: #FFFFFF; width: 100%\"></label>\n        </div></sc-for>\n            <button type=\"button\" onClick=\"{{addRow}}\" style=\"align-self: flex-start; height: 40px; padding: 0 14px; border-radius: 10px; border: 1px dashed #B4BCC8; cursor: pointer; background: #FFFFFF; color: #1F2B4D; font: 700 13px 'Plus Jakarta Sans', sans-serif\">+ Tambah barang</button>\n          </div>\n          <label style=\"display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 700; color: #4A5468\">Lokasi antar<input type=\"text\" value=\"{{f.delivery_location}}\" onChange=\"{{set.delivery_location}}\" placeholder=\"Alamat acara atau kantor\" style=\"height: 48px; box-sizing: border-box; border: 1px solid #D5D9E0; border-radius: 10px; padding: 0 12px; font: 600 15px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; background: #FFFFFF; width: 100%\"></label>\n          <label style=\"display: flex; gap: 10px; align-items: center; font-size: 15px\"><input type=\"checkbox\" checked=\"{{f.needs_tax_invoice}}\" onChange=\"{{toggleTax}}\" style=\"width: 18px; height: 18px; accent-color: #1F2B4D; margin: 0\">Butuh faktur pajak (lampirkan NPWP saat penawaran disetujui)</label>\n          <sc-if value=\"{{error}}\"><div style=\"font-size: 14px; color: #A12A1F; font-weight: 700\">{{error}}</div></sc-if>\n          <button type=\"button\" onClick=\"{{send}}\" disabled=\"{{busy}}\" style=\"height: 52px; padding: 0 22px; border-radius: 12px; background: #09BEAF; color: #1F2B4D; font: 800 16px 'Plus Jakarta Sans', sans-serif; display: inline-flex; align-items: center; justify-content: center; text-decoration: none; border: none; cursor: pointer; align-self: flex-start\">{{sendLabel}}</button>\n          <sc-if value=\"{{ruleText}}\"><div style=\"font-size: 13px; line-height: 19px; color: #4A5468\">{{ruleText}}</div></sc-if>\n        </form>\n      </sc-if>\n      <sc-if value=\"{{sent}}\">\n        <div style=\"background: #E4F2EA; border-radius: 14px; padding: 18px 20px; font-size: 16px; line-height: 24px; color: #1F3D2D\"><b>Permintaan terkirim.</b> Tim bisnis menghubungi PIC lewat WhatsApp dengan penawaran dan ketersediaan unit. Unit belum dikunci sampai penawaran disetujui.</div>\n      </sc-if>\n    </div>\n  </section>\n</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{\"$preview\":{\"width\":1440,\"height\":1900}}'>\nclass Component extends DCLogic {\nstate = { f: { company: '', pic_name: '', pic_phone: '', email: '', need: 'Acara atau gathering', city: '', start_date: '', end_date: '', delivery_location: '', needs_tax_invoice: false },\n  rows: [{ product_id: '', qty: '1' }, { product_id: '', qty: '1' }, { product_id: '', qty: '1' }], products: [], branches: [], branch: null, sent: false, error: '' };\nasync componentDidMount() {\n  const [prods, bs, br, c] = await Promise.all([\n    RA.from('products').select('id,name,categories(kind,line)').eq('status', 'active').order('rent_count', { ascending: false }),\n    RA.branches(), RA.branch(), RA.isLoggedIn() ? RA.customer() : null\n  ]);\n  if (!RA_ALIVE(this)) return;\n  const f = Object.assign({}, this.state.f, { city: (br && br.city) || '' });\n  if (c) { f.pic_name = c.name || ''; f.pic_phone = c.phone ? '0' + String(c.phone).slice(2) : ''; f.email = c.email || ''; }\n  this.setState({ products: (prods.data || []).filter(p => !p.categories || p.categories.kind !== 'stay'), branches: bs || [], branch: br, f });\n}\nasync submit() {\n  const f = this.state.f;\n  const phone = RA.normPhone(f.pic_phone);\n  if (f.company.trim().length < 3) throw new Error('Isi nama perusahaan atau instansi.');\n  if (!f.pic_name.trim()) throw new Error('Isi nama PIC.');\n  if (!phone) throw new Error('Nomor WhatsApp tidak valid. Contoh: 0812 3456 7890');\n  if (f.email && !/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(f.email)) throw new Error('Format email belum benar.');\n  if (f.start_date && f.end_date && f.end_date < f.start_date) throw new Error('Tanggal selesai harus setelah tanggal mulai.');\n  const items = this.state.rows.filter(r => r.product_id && +r.qty > 0).map(r => ({ product_id: r.product_id, name: (this.state.products.find(p => p.id === r.product_id) || {}).name, qty: Math.round(+r.qty) }));\n  if (!items.length) throw new Error('Pilih minimal satu barang dan jumlahnya.');\n  const body = { company: f.company.trim(), pic_name: f.pic_name.trim(), pic_phone: phone, email: f.email.trim() || null, need: f.need, city: f.city || null,\n    start_date: f.start_date || null, end_date: f.end_date || null, items, delivery_location: f.delivery_location.trim() || null, needs_tax_invoice: !!f.needs_tax_invoice, status: 'new' };\n  // lewat fungsi server: pengunjung tidak punya izin baca tabel ini\n  await RA.call('submit_corporate_request', { p: body });\n  this.setState({ sent: true, error: '' });\n}\nrenderVals() {\n  const s = this.state, f = s.f;\n  const set = {};\n  Object.keys(f).forEach(k => { set[k] = e => this.setState({ f: Object.assign({}, this.state.f, { [k]: e.target.value }), error: '' }); });\n  const cities = Array.from(new Set(s.branches.filter(b => b.kind !== 'experience').map(b => b.city).filter(Boolean))).concat(['Lainnya']).map(v => ({ v, sel: v === f.city }));\n  const needs = ['Acara atau gathering', 'Rombongan wisata', 'Produksi konten', 'Operasional kantor'].map(v => ({ v, sel: v === f.need }));\n  const rows = s.rows.map((r, i) => ({ qty: r.qty, opts: s.products.map(p => ({ id: p.id, name: p.name, sel: p.id === r.product_id })),\n    setProduct: e => { const rs = this.state.rows.slice(); rs[i] = Object.assign({}, rs[i], { product_id: e.target.value }); this.setState({ rows: rs, error: '' }); },\n    setQty: e => { const rs = this.state.rows.slice(); rs[i] = Object.assign({}, rs[i], { qty: e.target.value }); this.setState({ rows: rs }); } }));\n  const hrs = RA.setting('corporate_response_hours'), rule = RA.setting('corporate_rule');\n  const ruleText = [hrs != null ? 'Penawaran dikirim ke email dalam ' + hrs + ' jam kerja.' : 'Penawaran dikirim ke email.', rule ? 'Harga volume, DP, dan termin pembayaran: ' + rule + '.' : ''].filter(Boolean).join(' ');\n  const br = s.branch || {};\n  const d = new Date();\n  return {\n    f, set, cities, needs, rows, today: RA.iso(d),\n    addRow: () => this.setState({ rows: s.rows.concat([{ product_id: '', qty: '1' }]) }),\n    toggleTax: () => this.setState({ f: Object.assign({}, f, { needs_tax_invoice: !f.needs_tax_invoice }) }),\n    ruleText, error: s.error, busy: !!s.busy, sendLabel: s.busy ? 'Mengirim…' : 'Kirim permintaan penawaran',\n    send: this.act(async () => { try { await this.submit(); } catch (e) { this.setState({ error: RA.friendly(e.message) }); } }),\n    open: !s.sent, sent: s.sent,\n    waHref: br.phone ? 'https://wa.me/' + br.phone + '?text=' + encodeURIComponent('Halo tim bisnis Rentalaja, saya mau tanya sewa untuk perusahaan.') : ''\n  };\n}\n}\n</script>\n</body>\n</html>\n"}