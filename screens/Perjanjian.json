{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Perjanjian sewa</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0}\na{color:#1F2B4D}a:hover{color:#000}\n</style>\n</helmet>\n<div style=\"width: 390px; height: 1100px; box-sizing: border-box; background: #F4F6F9; color: #1F2B4D; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; flex-direction: column; position: relative; overflow: hidden\">\n<header style=\"display: flex; align-items: center; gap: 8px; padding: 10px 12px; border-bottom: 1px solid #E6E8EC\">\n    <a href=\"{{backHref}}\" aria-label=\"Kembali\" style=\"width: 44px; height: 44px; display: flex; align-items: center; justify-content: center\">\n      <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1F2B4D\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M15 6l-6 6 6 6\"/></svg>\n    </a>\n    <div style=\"display: flex; flex-direction: column\"><div style=\"font-size: 18px; font-weight: 800\">Perjanjian sewa</div><div style=\"font-size: 12px; color: #4A5468\">{{sub}}</div></div>\n  </header>\n<div style=\"flex: 1; overflow: hidden; display: flex; flex-direction: column\">\n<sc-if value=\"{{missing}}\"><section style=\"padding: 24px 16px; font-size: 15px; line-height: 22px; color: #4A5468\">{{missing}} <a href=\"Akun.dc.html\" style=\"font-weight: 700\">Lihat booking saya</a></section></sc-if>\n<sc-if value=\"{{s0}}\">\n  <section style=\"padding: 16px 16px 0; display: flex; flex-direction: column; gap: 10px\">\n    <div style=\"background: #E3F7F5; border-radius: 12px; padding: 12px 14px; font-size: 13px; line-height: 19px\">Baca perjanjian ini sebelum serah-terima, lalu tanda tangani di bawah.</div>\n    <div style=\"background: #FFFFFF; border: 0; border-radius: 20px; box-shadow: 0 2px 12px rgba(31,43,77,0.07); padding: 14px; display: flex; flex-direction: column; gap: 8px; font-size: 14px\">\n      <div style=\"display: flex; justify-content: space-between; gap: 8px\"><span style=\"color: #4A5468\">Pihak pertama</span><b style=\"text-align: right\">PT Popo Karya Investama (Rentalaja)</b></div>\n      <div style=\"display: flex; justify-content: space-between; gap: 8px\"><span style=\"color: #4A5468\">Penyewa</span><b style=\"text-align: right\">{{renter}}</b></div>\n      <div style=\"display: flex; justify-content: space-between; gap: 8px\"><span style=\"color: #4A5468\">Unit</span><b style=\"text-align: right\">{{unit}}</b></div>\n      <div style=\"display: flex; justify-content: space-between; gap: 8px\"><span style=\"color: #4A5468\">Masa sewa</span><b style=\"text-align: right\">{{period}}</b></div>\n      <div style=\"display: flex; justify-content: space-between; gap: 8px\"><span style=\"color: #4A5468\">Total · DP</span><b style=\"text-align: right\">{{money}}</b></div>\n      <div style=\"display: flex; justify-content: space-between; gap: 8px\"><span style=\"color: #4A5468\">Kondisi unit</span><b style=\"text-align: right\">{{condition}}</b></div>\n    </div>\n    <sc-if value=\"{{photoNote}}\"><div style=\"font-size: 12px; line-height: 18px; color: #4A5468\">{{photoNote}}</div></sc-if>\n  </section>\n  <sc-if value=\"{{showCond}}\"><section style=\"padding: 16px 16px 0; display: flex; flex-direction: column; gap: 10px\">\n    <h2 style=\"margin: 0; font-size: 17px; font-weight: 800\">Cek kondisi unit</h2>\n    <div style=\"font-size: 13px; line-height: 19px; color: #4A5468\">Cocokkan unit yang Anda terima dengan foto kondisi di bawah. Kalau ada lecet atau kekurangan yang tidak ada di foto, pilih <b>Ada yang beda</b> dan foto bagian itu, supaya tidak ditagihkan ke Anda saat kembali.</div>\n    <sc-for list=\"{{condUnits}}\" as=\"u\"><div style=\"font-size: 13px\"><b>{{u.t}}</b> <span style=\"color: #6B7385\">· {{u.sub}}</span></div></sc-for>\n    <sc-if value=\"{{hasCondPics}}\"><div style=\"display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px\"><sc-for list=\"{{condPics}}\" as=\"ph\"><a href=\"{{ph}}\" target=\"_blank\" rel=\"noopener\"><img src=\"{{ph}}\" alt=\"Foto kondisi unit\" style=\"width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 10px; border: 1px solid #E6E8EC; display: block\"></a></sc-for></div></sc-if>\n    <sc-if value=\"{{noCondPics}}\"><div style=\"font-size: 13px; line-height: 19px; color: #8A4B00; background: #FFF1D6; border-radius: 10px; padding: 10px 12px\">Foto kondisi unit ini belum ada. Cek unit bersama staf saat serah-terima; kalau ada kekurangan, pilih Ada yang beda lalu foto.</div></sc-if>\n    <sc-if value=\"{{canChooseCond}}\"><div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 8px\">\n      <button type=\"button\" onClick=\"{{pickSesuai}}\" style=\"{{sesuaiStyle}}\">Sesuai foto</button>\n      <button type=\"button\" onClick=\"{{pickBeda}}\" style=\"{{bedaStyle}}\">Ada yang beda</button>\n    </div></sc-if>\n    <sc-if value=\"{{isBeda}}\"><div style=\"display: flex; flex-direction: column; gap: 8px\">\n      <textarea rows=\"3\" placeholder=\"Contoh: lecet kecil di bodi kiri, helm hanya 1\" value=\"{{diffNote}}\" onChange=\"{{setDiffNote}}\" style=\"box-sizing: border-box; border: 1px solid #D5D9E0; border-radius: 10px; padding: 10px 12px; font: 500 14px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; resize: vertical\"></textarea>\n      <label style=\"height: 44px; border-radius: 10px; border: 1.5px dashed #B4BCC8; display: flex; align-items: center; justify-content: center; gap: 8px; font: 700 13px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; cursor: pointer\">{{diffBtn}}<input type=\"file\" accept=\"image/*\" capture=\"environment\" onChange=\"{{diffPick}}\" style=\"display: none\"></label>\n      <sc-if value=\"{{hasDiffPics}}\"><div style=\"display: flex; gap: 6px; flex-wrap: wrap\"><sc-for list=\"{{diffPics}}\" as=\"dp\"><img src=\"{{dp}}\" alt=\"Foto dari Anda\" style=\"width: 72px; height: 72px; object-fit: cover; border-radius: 8px; border: 1px solid #E6E8EC\"></sc-for></div></sc-if>\n    </div></sc-if>\n  </section></sc-if>\n  <section style=\"padding: 16px 16px 0; display: flex; flex-direction: column; gap: 10px\"><h2 style=\"margin: 0; font-size: 17px; font-weight: 800\">Isi perjanjian</h2><sc-for list=\"{{clauses}}\" as=\"k\"><details style=\"border-bottom: 1px solid #E6E8EC; padding: 10px 0\"><summary style=\"cursor: pointer; font-size: 14px; font-weight: 700; list-style: none; display: flex; justify-content: space-between\">{{k.title}}<span style=\"color: #8A93A6\">▾</span></summary><div style=\"font-size: 13px; line-height: 19px; color: #4A5468; padding-top: 6px\">{{k.text}}</div></details></sc-for><a href=\"Bantuan.dc.html\" style=\"font-size: 13px; font-weight: 700\">Baca syarat dan ketentuan lengkap</a></section>\n  <section style=\"padding: 16px 16px 0; display: flex; flex-direction: column; gap: 10px; padding-bottom: 16px\">\n    <h2 style=\"margin: 0; font-size: 17px; font-weight: 800\">Tanda tangan</h2>\n    <div aria-label=\"Area tanda tangan\" style=\"height: 140px; border-radius: 14px; border: 1.5px dashed #8A93A6; background: #FAFBFC; position: relative; overflow: hidden\">\n      <sc-if value=\"{{unsigned}}\"><span style=\"position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font: 700 14px 'Plus Jakarta Sans', sans-serif; color: #8A93A6; pointer-events: none\">Tanda tangan di sini dengan jari</span></sc-if>\n      <canvas ref=\"{{padRef}}\" style=\"position: absolute; inset: 0; width: 100%; height: 140px; touch-action: none; cursor: crosshair\"></canvas>\n    </div>\n    <div style=\"display: flex; justify-content: space-between; font-size: 12px; color: #4A5468\"><span>{{signLine}}</span><button type=\"button\" onClick=\"{{clear}}\" style=\"border: none; background: none; font: 700 12px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; text-decoration: underline; cursor: pointer; padding: 0\">Ulangi</button></div>\n    <label style=\"display: flex; gap: 10px; align-items: center; font-size: 14px; line-height: 20px; min-height: 32px\"><input type=\"checkbox\" checked=\"{{agree}}\" onChange=\"{{toggle}}\" style=\"width: 18px; height: 18px; accent-color: #1F2B4D; margin: 0; flex-shrink: 0\"> Saya sudah membaca dan setuju dengan isi perjanjian ini</label>\n    <button type=\"button\" onClick=\"{{next}}\" disabled=\"{{notReady}}\" style=\"{{nextStyle}}\">{{nextLabel}}</button>\n  </section>\n</sc-if>\n<sc-if value=\"{{s1}}\">\n  <section style=\"padding: 16px 16px 0; display: flex; flex-direction: column; gap: 10px; align-items: center; text-align: center; padding-top: 40px\">\n    <h2 style=\"margin: 0; font-size: 17px; font-weight: 800\">Konfirmasi dengan kode dari email</h2>\n    <div style=\"font-size: 14px; line-height: 20px; color: #4A5468\">Kode 6 angka dikirim ke {{masked}}. Kode ini membuktikan tanda tangan dibuat dari nomor Anda.</div>\n    <sc-if value=\"{{simCode}}\"><div style=\"font-size: 13px; line-height: 19px; color: #8A4B00; background: #FFF1D6; border-radius: 10px; padding: 10px 12px; text-align: left\"><b>Mode uji:</b> WhatsApp belum tersambung, jadi kodenya ditampilkan di sini: <b style=\"letter-spacing: 0.15em\">{{simCode}}</b></div></sc-if>\n    <input type=\"text\" inputmode=\"numeric\" autocomplete=\"one-time-code\" maxlength=\"6\" value=\"{{code}}\" onChange=\"{{setCode}}\" aria-label=\"Kode 6 angka\" placeholder=\"••••••\" style=\"width: 100%; max-width: 300px; height: 56px; box-sizing: border-box; border-radius: 10px; border: 1.5px solid #1F2B4D; text-align: center; font: 800 24px 'Plus Jakarta Sans', sans-serif; letter-spacing: 0.5em; color: #1F2B4D\">\n    <button type=\"button\" onClick=\"{{confirm}}\" disabled=\"{{busy}}\" style=\"height: 52px; border-radius: 12px; border: none; background: #09BEAF; color: #1F2B4D; font: 800 16px 'Plus Jakarta Sans', sans-serif; display: flex; align-items: center; justify-content: center; text-decoration: none; cursor: pointer; width: 100%\">{{confirmLabel}}</button>\n    <button type=\"button\" onClick=\"{{resend}}\" disabled=\"{{busy}}\" style=\"border: none; background: none; font: 700 13px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; text-decoration: underline; cursor: pointer\">Kirim ulang kode</button>\n  </section>\n</sc-if>\n<sc-if value=\"{{s2}}\">\n  <section style=\"padding: 16px 16px 0; display: flex; flex-direction: column; gap: 10px; align-items: center; text-align: center; padding-top: 40px\"><div style=\"width: 56px; height: 56px; border-radius: 28px; background: #09BEAF; display: flex; align-items: center; justify-content: center\"><svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1F2B4D\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12l5 5 9-10\"/></svg></div>\n    <h2 style=\"margin: 0; font-size: 17px; font-weight: 800\">Perjanjian ditandatangani</h2>\n    <div style=\"font-size: 14px; line-height: 20px; color: #4A5468\">Perjanjian tersimpan di booking {{code0}}. Staf cabang sudah bisa menyerahkan unit.</div>\n    <div style=\"background: #FFFFFF; border: 0; border-radius: 20px; box-shadow: 0 2px 12px rgba(31,43,77,0.07); padding: 12px 14px; font-size: 13px; line-height: 19px; text-align: left; width: 100%; box-sizing: border-box\">{{record}}</div>\n    <a href=\"{{aktifHref}}\" style=\"height: 52px; border-radius: 12px; border: none; background: #09BEAF; color: #1F2B4D; font: 800 16px 'Plus Jakarta Sans', sans-serif; display: flex; align-items: center; justify-content: center; text-decoration: none; cursor: pointer; width: 100%\">{{doneLabel}}</a>\n  </section>\n</sc-if>\n</div>\n</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{\"$preview\":{\"width\":390,\"height\":1100}}'>\nclass Component extends DCLogic {\nstate = { s: 0, b: null, c: null, missing: null, units: [], hand: null, agr: null, signed: false, agree: false, code: '', sim: '' };\nstrokes = [];\nasync componentDidMount() {\n  const id = this.params.id;\n  if (!id) { this.setState({ missing: 'Pilih booking dulu dari halaman Akun.' }); return; }\n  const [c, bk] = await Promise.all([\n    RA.customer(),\n    RA.from('bookings').select('id,code,status,line,branch_id,start_at,end_at,total,dp_amount,paid_amount,branches(name),booking_items(id,product_id,status,products(name))').eq('id', id).maybeSingle()\n  ]);\n  const b = bk.data;\n  if (!RA_ALIVE(this)) return;\n  if (!b) { this.setState({ missing: 'Booking tidak ditemukan.' }); return; }\n  const [units, hand, agr] = await Promise.all([\n    RA.rpc('my_booking_units', { p_booking: b.id }),\n    RA.from('handovers').select('direction,km,fuel,photos,at').eq('booking_id', b.id).eq('direction', 'out').order('at', { ascending: false }).limit(1),\n    RA.from('agreements').select('id,signed_at,otp_verified_at,signed_branch_id').eq('booking_id', b.id).limit(1)\n  ]);\n  if (!RA_ALIVE(this)) return;\n  const a = (agr.data || [])[0] || null;\n  this.setState({ b, c, units: units.data || [], hand: (hand.data || [])[0] || null, agr: a, s: a && a.signed_at ? 2 : 0 });\n  if (!a || !a.signed_at) {\n    if (['confirmed', 'active'].indexOf(b.status) < 0) this.setState({ missing: 'Perjanjian bisa ditandatangani setelah booking terkonfirmasi. Status sekarang: ' + (RA.STATUS[b.status] || [b.status])[0].toLowerCase() + '.' , b: null });\n  }\n}\ndraw(cv) {\n  const ctx = cv.getContext('2d'); const r = cv.getBoundingClientRect(); const k = window.devicePixelRatio || 1;\n  cv.width = Math.max(1, r.width * k); cv.height = Math.max(1, r.height * k);\n  ctx.setTransform(k, 0, 0, k, 0, 0); ctx.lineWidth = 2.6; ctx.lineCap = 'round'; ctx.lineJoin = 'round'; ctx.strokeStyle = '#1F2B4D';\n  this.strokes.forEach(st => { ctx.beginPath(); st.forEach((p, i) => { const x = p[0] * r.width, y = p[1] * r.height; i ? ctx.lineTo(x, y) : ctx.moveTo(x, y); }); if (st.length === 1) ctx.lineTo(st[0][0] * r.width + 0.1, st[0][1] * r.height); ctx.stroke(); });\n}\npad(cv) {\n  if (!cv) return;\n  requestAnimationFrame(() => this.draw(cv));\n  let cur = null;\n  const pt = e => { const r = cv.getBoundingClientRect(); return [(e.clientX - r.left) / r.width, (e.clientY - r.top) / r.height]; };\n  cv.addEventListener('pointerdown', e => { e.preventDefault(); cv.setPointerCapture && cv.setPointerCapture(e.pointerId); cur = [pt(e)]; this.strokes.push(cur); this.draw(cv); });\n  cv.addEventListener('pointermove', e => { if (!cur) return; cur.push(pt(e)); this.draw(cv); });\n  const up = () => { if (!cur) return; cur = null; if (!this.state.signed) this.setState({ signed: true }); };\n  cv.addEventListener('pointerup', up); cv.addEventListener('pointercancel', up); cv.addEventListener('pointerleave', up);\n}\npng() {\n  const W = 600, H = 200, cv = document.createElement('canvas'); cv.width = W; cv.height = H;\n  const ctx = cv.getContext('2d'); ctx.fillStyle = '#FFFFFF'; ctx.fillRect(0, 0, W, H);\n  ctx.lineWidth = 4; ctx.lineCap = 'round'; ctx.lineJoin = 'round'; ctx.strokeStyle = '#1F2B4D';\n  this.strokes.forEach(st => { ctx.beginPath(); st.forEach((p, i) => i ? ctx.lineTo(p[0] * W, p[1] * H) : ctx.moveTo(p[0] * W, p[1] * H)); ctx.stroke(); });\n  return new Promise(res => cv.toBlob(res, 'image/png'));\n}\nclauses() {\n  const b = this.state.b; const out = [];\n  const region = RA.setting('rental_region');\n  out.push(['Pemakaian', 'Unit hanya dipakai oleh penyewa' + (region ? ' di wilayah ' + region : '') + ', tidak disewakan ulang, dipindahtangankan, atau digadaikan.']);\n  const pct = RA.setting('late_fee_percent_per_hour'), maxd = RA.setting('late_fee_max');\n  out.push(['Pengembalian dan denda', 'Dikembalikan ' + RA.dayTime(b.end_at) + '.' + (pct != null ? ' Telat dikenai ' + pct + '% tarif harian per jam' + (maxd != null ? ', maksimal ' + RA.num(maxd) + '× tarif harian' : '') + '.' : '')]);\n  const inc = RA.setting('incident_cost_rule');\n  out.push(['Kerusakan dan kehilangan', 'Kerusakan atau kehilangan karena kelalaian penyewa ditanggung penyewa sesuai biaya perbaikan atau penggantian.' + (inc ? ' ' + inc + '.' : '')]);\n  out.push(['Tilang dan kecelakaan', 'Tilang selama masa sewa tanggung jawab penyewa. Kecelakaan atau kehilangan wajib segera dilaporkan ke cabang lewat menu Lapor kendala.']);\n  if (RA.setting('ktp_original_deposit') === true) out.push(['Jaminan', 'KTP asli dititipkan di cabang dan dikembalikan saat unit kembali dalam kondisi baik.']);\n  return out.map((x, i) => ({ title: (i + 1) + '. ' + x[0], text: x[1] }));\n}\nrenderVals() {\n  const s = this.state, b = s.b, c = s.c || {};\n  if (!b) return { missing: s.missing, sub: s.missing ? '' : 'Memuat…', backHref: 'Akun.dc.html', s0: false, s1: false, s2: false };\n  const names = Array.from(new Set((b.booking_items || []).filter(i => i.status !== 'released').map(i => i.products && i.products.name).filter(Boolean)));\n  const plates = s.units.map(u => u.plate || u.unit_code).filter(x => x && x !== '—');\n  const h = s.hand;\n  const nph = h ? (h.photos || []).length : 0;\n  const condition = h ? [nph ? nph + ' foto' : 'Tanpa foto', h.km != null ? 'KM ' + RA.num(h.km) : '', h.fuel ? 'bensin ' + h.fuel : ''].filter(Boolean).join(' · ') : 'Dicek saat serah-terima';\n  if (!this._condReq) { this._condReq = 1; RA.fn('unit-kondisi', { action: 'view', booking_id: b.id }).then(r => { if (RA_ALIVE(this)) this.setState({ cond: r.items || [] }); }).catch(() => { if (RA_ALIVE(this)) this.setState({ cond: [] }); }); }\n  const cond = s.cond || [];\n  const condPics = [].concat(...cond.map(u => u.photos || []));\n  const condOkReady = s.condOk === 'sesuai' || (s.condOk === 'beda' && String(s.diffNote || '').trim().length >= 3);\n  const ready = s.signed && s.agree && condOkReady;\n  const optSt = on => 'height: 46px; border-radius: 12px; font: 800 14px \"Plus Jakarta Sans\", sans-serif; cursor: pointer; ' + (on ? 'border: 2px solid #077A70; background: #077A70; color: #FFFFFF;' : 'border: 1.5px solid #D5D9E0; background: #FFFFFF; color: #1F2B4D;');\n  const clauses = this.clauses();\n  const today = new Date();\n  const ag = s.agr;\n  const br = (b.branches && b.branches.name) || '';\n  return {\n    s0: s.s === 0, s1: s.s === 1, s2: s.s === 2, missing: null,\n    showCond: s.s === 0 && s.cond !== undefined, condUnits: cond.map(u => ({ t: u.product + (u.plate ? ' · ' + u.plate : u.unit_code ? ' · ' + u.unit_code : ''), sub: u.condition_at ? 'foto kondisi ' + RA.dateY(u.condition_at) : 'belum ada foto kondisi' })),\n    condPics, hasCondPics: condPics.length > 0, noCondPics: s.cond !== undefined && !condPics.length, canChooseCond: true,\n    pickSesuai: () => this.setState({ condOk: 'sesuai' }), pickBeda: () => this.setState({ condOk: 'beda' }),\n    sesuaiStyle: optSt(s.condOk === 'sesuai'), bedaStyle: optSt(s.condOk === 'beda'), isBeda: s.condOk === 'beda',\n    diffNote: s.diffNote || '', setDiffNote: e => this.setState({ diffNote: e.target.value }),\n    diffPics: (s.diffPrev || []), hasDiffPics: (s.diffPrev || []).length > 0, diffBtn: s.diffUp ? 'Mengunggah foto…' : '+ Foto bagian yang beda',\n    diffPick: async e => { const f = e.target.files && e.target.files[0]; if (!f) return; this.setState({ diffUp: true });\n      try { const path = await RA.upload('dokumen', c.id + '/beda-' + b.id + '-' + Date.now() + '.jpg', f);\n        this.setState({ diffPaths: (this.state.diffPaths || []).concat(path), diffPrev: (this.state.diffPrev || []).concat(URL.createObjectURL(f)) });\n      } catch (er) { RA.toast('Foto gagal diunggah: ' + er.message); } finally { this.setState({ diffUp: false }); } },\n    sub: b.code + (b.status === 'confirmed' ? ' · sebelum serah-terima' : ''), backHref: 'Status.dc.html?id=' + b.id, code0: b.code,\n    renter: c.name || '—', unit: names.join(' + ') + (plates.length ? ' · ' + plates.join(', ') : ''),\n    period: RA.day(b.start_at) + ' ' + RA.time(b.start_at) + ' – ' + RA.day(b.end_at) + ' ' + RA.time(b.end_at),\n    money: RA.rp(b.total) + ' · ' + (+b.dp_amount > 0 ? RA.rp(b.dp_amount) : 'tanpa DP'), condition,\n    photoNote: nph ? nph + ' foto kondisi unit saat serah-terima tersimpan di cabang.' : '',\n    clauses, signed: s.signed, unsigned: !s.signed, agree: s.agree,\n    signLine: (c.name || '') + ' · ' + RA.dateY(today),\n    padRef: cv => this.pad(cv),\n    clear: () => { this.strokes = []; this.setState({ signed: false, tick: Date.now() }); },\n    toggle: () => this.setState({ agree: !s.agree }),\n    notReady: !ready || !!s.busy, nextLabel: s.busy ? 'Mengirim kode…' : 'Tanda tangani',\n    nextStyle: 'height: 52px; border-radius: 12px; border: none; font: 800 16px \"Plus Jakarta Sans\", sans-serif; width: 100%; ' + (ready ? 'background: #09BEAF; color: #1F2B4D; cursor: pointer;' : 'background: #E6E8EC; color: #6B7385;'),\n    next: this.act(async () => {\n      if (!ready) return;\n      if (!c.phone) throw new Error('Nomor HP akun belum ada. Hubungi cabang.');\n      const r = await RA.requestOtp(c.phone, 'agreement');\n      this.setState({ s: 1, sim: r.simulation ? r.code : '', code: '' });\n    }),\n    masked: RA.maskPhone(c.phone), simCode: s.sim, code: s.code, busy: !!s.busy,\n    setCode: e => this.setState({ code: e.target.value }),\n    resend: this.act(async () => { const r = await RA.requestOtp(c.phone, 'agreement'); this.setState({ sim: r.simulation ? r.code : '' }); RA.ok('Kode baru dikirim'); }),\n    confirmLabel: s.busy ? 'Memeriksa…' : 'Konfirmasi',\n    confirm: this.act(async () => {\n      const code = String(s.code).replace(/\\D/g, '');\n      if (code.length !== 6) throw new Error('Kode terdiri dari 6 angka.');\n      const v = await RA.verifyOtp(c.phone, code, 'agreement');\n      if (!v || !v.verified) throw new Error('Kode belum terverifikasi. Coba la