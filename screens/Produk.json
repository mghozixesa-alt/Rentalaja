{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Detail produk</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0}\na{color:#1F2B4D}a:hover{color:#000}\n.ra-gal{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;height:100%}\n.ra-gal{width:100%}.ra-gal img{flex:0 0 100%;width:100%;height:100%;object-fit:contain;padding:28px 28px 44px;box-sizing:border-box;scroll-snap-align:start;filter:drop-shadow(0 10px 18px rgba(31,43,77,0.18))}\n</style>\n</helmet>\n<div style=\"width: 390px; height: 1720px; box-sizing: border-box; background: #F4F6F9; color: #1F2B4D; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; flex-direction: column; position: relative; overflow: hidden\">\n\n  <div style=\"height: 320px; background: radial-gradient(120% 90% at 50% 30%, #FFFFFF 0%, #E6F4F2 70%, #D3EEEA 100%); position: relative; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 600; color: #6B7385\">\n    <sc-if value=\"{{hasPhotos}}\"><div class=\"ra-gal\"><sc-for list=\"{{photos}}\" as=\"ph\"><img src=\"{{ph}}\" alt=\"{{p.name}}\"></sc-for></div></sc-if>\n    <sc-if value=\"{{hasPhotos}}\" not>{{photoNote}}</sc-if>\n    <a href=\"Katalog.dc.html\" aria-label=\"Kembali\" style=\"position: absolute; top: 12px; left: 12px; width: 42px; height: 42px; border-radius: 21px; background: #FFFFFF; box-shadow: 0 2px 10px rgba(31,43,77,0.12); display: flex; align-items: center; justify-content: center\">\n      <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1F2B4D\" stroke-width=\"2.2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M15 6l-6 6 6 6\"/></svg>\n    </a>\n    <sc-if value=\"{{photoCount}}\"><span style=\"position: absolute; right: 14px; bottom: 36px; font-size: 11px; font-weight: 700; color: #FFFFFF; background: rgba(31,43,77,0.55); padding: 3px 9px; border-radius: 10px\">{{photoCount}}</span></sc-if>\n  </div>\n\n  <sc-if value=\"{{missing}}\">\n    <section style=\"padding: 40px 20px; display: flex; flex-direction: column; gap: 12px; align-items: flex-start\">\n      <h1 style=\"margin: 0; font-size: 22px; font-weight: 800\">{{missing}}</h1>\n      <a href=\"Katalog.dc.html\" style=\"height: 48px; padding: 0 20px; border-radius: 12px; background: #09BEAF; color: #1F2B4D; font-weight: 800; display: flex; align-items: center; text-decoration: none\">Lihat katalog</a>\n    </section>\n  </sc-if>\n\n  <sc-if value=\"{{ready}}\">\n  <section style=\"margin-top: -24px; position: relative; background: #FFFFFF; border-radius: 24px 24px 0 0; padding: 20px 16px 18px; display: flex; flex-direction: column; gap: 10px; box-shadow: 0 -6px 18px rgba(31,43,77,0.06)\">\n    <div style=\"font-size: 12px; font-weight: 700; color: #077A70\">{{catName}} · {{branchName}}</div>\n    <h1 style=\"margin: 0; font-size: 24px; line-height: 30px; font-weight: 800; letter-spacing: -0.02em\">{{p.name}}</h1>\n    <div style=\"display: flex; flex-wrap: wrap; gap: 6px\">\n      <sc-if value=\"{{soldText}}\"><span style=\"height: 26px; padding: 0 10px; border-radius: 13px; background: #F1F4F7; display: flex; align-items: center; gap: 5px; font-size: 12px; font-weight: 700; color: #3A4558\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#077A70\" stroke-width=\"2.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6L9 17l-5-5\"/></svg>{{soldText}}</span></sc-if>\n      <sc-if value=\"{{availText}}\"><span style=\"{{availPill}}\"><span style=\"width: 7px; height: 7px; border-radius: 4px; background: currentColor\"></span>{{availText}}</span></sc-if>\n      <sc-if value=\"{{p.short_desc}}\"><span style=\"height: 26px; padding: 0 10px; border-radius: 13px; background: #F1F4F7; display: flex; align-items: center; font-size: 12px; font-weight: 600; color: #3A4558\">{{p.short_desc}}</span></sc-if>\n    </div>\n    <sc-if value=\"{{unitPrice}}\"><div style=\"display: flex; align-items: baseline; gap: 4px; margin-top: 2px\"><span style=\"font-size: 26px; font-weight: 800; color: #1F2B4D\">{{unitPrice}}</span><span style=\"font-size: 14px; font-weight: 600; color: #5B6577\">{{unitSuf}}</span></div></sc-if>\n    <sc-if value=\"{{promoBanner}}\"><div style=\"display: flex; align-items: center; gap: 10px; background: #F2FBF6; border: 1.5px dashed #6FCF97; border-radius: 14px; padding: 10px 12px\">\n      <span style=\"width: 34px; height: 34px; flex-shrink: 0; border-radius: 17px; background: #FFFFFF; display: flex; align-items: center; justify-content: center; font-size: 17px\">🏷️</span>\n      <span style=\"display: flex; flex-direction: column\"><b style=\"font-size: 14px; color: #0E8A4F\">{{promoBanner}}</b><span style=\"font-size: 12px; color: #4A5468\">{{promoSub}}</span></span>\n    </div></sc-if>\n  </section>\n\n  <sc-if value=\"{{hasSizes}}\">\n  <section style=\"margin: 12px 16px 0; background: #FFFFFF; border-radius: 20px; box-shadow: 0 2px 12px rgba(31,43,77,0.07); padding: 16px; display: flex; flex-direction: column; gap: 10px\">\n    <div style=\"display: flex; justify-content: space-between; align-items: center\">\n      <div style=\"font-size: 16px; font-weight: 800\">Pilih ukuran</div>\n      <sc-if value=\"{{hasGuide}}\"><button type=\"button\" onClick=\"{{toggleGuide}}\" style=\"border: none; background: none; padding: 0 4px; min-height: 44px; font: 700 13px 'Plus Jakarta Sans', sans-serif; color: #077A70; cursor: pointer\">Panduan ukuran</button></sc-if>\n    </div>\n    <div style=\"display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px\">\n      <sc-for list=\"{{sizes}}\" as=\"z\" hint-placeholder-count=\"4\">\n        <button type=\"button\" onClick=\"{{z.pick}}\" disabled=\"{{z.out}}\" aria-pressed=\"{{z.on}}\" style=\"{{z.style}}\"><span style=\"{{z.labelStyle}}\">{{z.label}}</span><span style=\"font-size: 11px; font-weight: 600\">{{z.left}}</span></button>\n      </sc-for>\n    </div>\n    <sc-if value=\"{{showGuide}}\">\n      <div style=\"border: 1px solid #E3E7ED; border-radius: 14px; padding: 12px 14px; display: flex; flex-direction: column; gap: 8px\">\n        <div style=\"font-size: 13px; font-weight: 800\">Cara memilih ukuran sepatu</div>\n        <div style=\"font-size: 13px; line-height: 1.6; color: #3A4558\">Pakai ukuran yang biasa kamu pakai untuk sepatu olahraga. Untuk mendaki, pilih yang pas atau setengah nomor lebih besar supaya muat kaus kaki tebal. Ragu di antara dua ukuran? Pilih yang lebih besar. Kamu boleh mencoba dulu saat ambil di toko.</div>\n      </div>\n    </sc-if>\n    <div style=\"font-size: 12px; color: #5B6577\">{{sizeNote}}</div>\n  </section>\n  </sc-if>\n\n  <section style=\"margin: 12px 16px 0; background: #FFFFFF; border-radius: 20px; box-shadow: 0 2px 12px rgba(31,43,77,0.07); padding: 16px; display: flex; flex-direction: column; gap: 14px\">\n    <div style=\"font-size: 16px; font-weight: 800\">Mau sewa berapa lama?</div>\n    <div style=\"{{durGrid}}\">\n      <sc-for list=\"{{durs}}\" as=\"d\" hint-placeholder-count=\"4\">\n        <button type=\"button\" onClick=\"{{d.pick}}\" style=\"{{d.style}}\"><span style=\"font-size: 14px; font-weight: 800\">{{d.label}}</span><sc-if value=\"{{d.sub}}\"><span style=\"{{d.subStyle}}\">{{d.sub}}</span></sc-if></button>\n      </sc-for>\n    </div>\n    <sc-if value=\"{{outHours}}\" hint-placeholder-val=\"{{false}}\"><div style=\"background: #FFF1D6; border-radius: 10px; padding: 10px 12px; font-size: 13px; line-height: 19px; color: #5C3A00\">Jam kembali di luar jam buka cabang. Ubah jam ambil lewat kalender.</div></sc-if>\n    <a href=\"{{calHref}}\" style=\"display: flex; align-items: center; gap: 10px; background: #F4F6F9; border-radius: 14px; padding: 10px 12px; text-decoration: none; color: #1F2B4D\">\n      <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#077A70\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" style=\"flex-shrink: 0\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"3\"/><path d=\"M8 3v4M16 3v4M3 10h18\"/></svg>\n      <span style=\"flex: 1; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 6px; min-width: 0\">\n        <span style=\"display: flex; flex-direction: column; min-width: 0\"><span style=\"font-size: 11px; color: #5B6577\">Ambil</span><b style=\"font-size: 13px; line-height: 17px\">{{pickDate}}</b></span>\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#8A93A3\" stroke-width=\"2.2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg>\n        <span style=\"display: flex; flex-direction: column; min-width: 0\"><span style=\"font-size: 11px; color: #5B6577\">Kembali</span><b style=\"font-size: 13px; line-height: 17px\">{{returnDate}}</b></span>\n      </span>\n      <span style=\"font-size: 12px; font-weight: 800; color: #077A70\">Ubah</span>\n    </a>\n  </section>\n\n  <section style=\"margin: 12px 16px 0; background: #FFFFFF; border-radius: 20px; box-shadow: 0 2px 12px rgba(31,43,77,0.07); padding: 16px; display: flex; flex-direction: column; gap: 10px\">\n    <div style=\"font-size: 16px; font-weight: 800\">Rincian biaya</div>\n    <sc-if value=\"{{noPrice}}\"><div style=\"font-size: 14px; color: #8A4B00; background: #FFF1D6; border-radius: 10px; padding: 10px 12px\">Harga untuk tanggal ini belum diatur cabang. Silakan pilih barang lain atau hubungi cabang.</div></sc-if>\n    <sc-if value=\"{{noPrice}}\" not>\n    <div style=\"display: flex; justify-content: space-between; font-size: 14px; color: #3A4558\"><span>{{rentLabel}}</span><span style=\"font-weight: 700; color: #1F2B4D\">{{rent}}</span></div>\n    <sc-if value=\"{{seasonNote}}\"><div style=\"display: flex; justify-content: space-between; font-size: 13px; color: #8A4B00\"><span>{{seasonNote}}</span><span>termasuk</span></div></sc-if>\n    <sc-for list=\"{{promoLines}}\" as=\"pl\"><div style=\"display: flex; justify-content: space-between; font-size: 14px; color: #0E8A4F; font-weight: 700\"><span>{{pl.label}}</span><span>−{{pl.amount}}</span></div></sc-for>\n    <div style=\"height: 1px; background: #EEF0F3\"></div>\n    <div style=\"display: flex; justify-content: space-between; align-items: center\"><span style=\"font-size: 14px; font-weight: 700\">Total sewa</span><span style=\"text-align: right\"><sc-if value=\"{{wasTotal}}\"><s style=\"display: block; font-size: 12.5px; color: #9AA2B1\">{{wasTotal}}</s></sc-if><span style=\"font-size: 22px; font-weight: 800\">{{rentTotal}}</span></span></div>\n    <sc-if value=\"{{saveText}}\"><div style=\"font-size: 13px; font-weight: 800; padding: 8px 12px; border-radius: 12px; background: #E6F7EE; color: #0E8A4F; border: 1.5px dashed #6FCF97;\">🎉 {{saveText}}</div></sc-if>\n    <div style=\"display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin-top: 2px\">\n      <sc-if value=\"{{dpShort}}\"><div style=\"background: #F4F6F9; border-radius: 12px; padding: 8px 10px; display: flex; flex-direction: column\"><span style=\"font-size: 11px; color: #5B6577\">Bayar di awal</span><b style=\"font-size: 13px\">{{dpShort}}</b></div></sc-if>\n      <sc-if value=\"{{lateText}}\"><div style=\"background: #F4F6F9; border-radius: 12px; padding: 8px 10px; display: flex; flex-direction: column\"><span style=\"font-size: 11px; color: #5B6577\">Telat kembali</span><b style=\"font-size: 13px\">{{lateText}}/jam</b></div></sc-if>\n    </div>\n    <sc-if value=\"{{cityRule}}\"><div style=\"display: flex; gap: 8px; align-items: flex-start; margin-top: 8px; font-size: 12.5px; line-height: 18px; font-weight: 600; color: #7A4100; background: #FFF4E5; border-radius: 12px; padding: 8px 10px\"><span>📍</span><span>{{cityRule}}</span></div></sc-if>\n    </sc-if>\n  </section>\n\n  <section style=\"margin: 12px 16px 0; background: #FFFFFF; border-radius: 20px; box-shadow: 0 2px 12px rgba(31,43,77,0.07); padding: 16px; display: flex; flex-direction: column; gap: 10px\">\n    <div style=\"font-size: 16px; font-weight: 800\">Cara terima barang</div>\n    <label style=\"{{pickupBox}}\">\n      <input type=\"radio\" name=\"terima\" checked=\"{{isPickup}}\" onChange=\"{{choosePickup}}\" style=\"margin: 3px 0 0; accent-color: #077A70; width: 16px; height: 16px\">\n      <span><b>Ambil di cabang {{branchName}}</b><br><span style=\"color: #5B6577; font-size: 13px\">{{branchInfo}}</span></span>\n    </label>\n    <sc-if value=\"{{canDeliver}}\">\n    <label style=\"{{deliverBox}}\">\n      <input type=\"radio\" name=\"terima\" checked=\"{{isDelivery}}\" onChange=\"{{chooseDelivery}}\" style=\"margin: 3px 0 0; accent-color: #077A70; width: 16px; height: 16px\">\n      <span><b>🛵 Antar-jemput ke alamatmu</b><br><span style=\"color: #5B6577; font-size: 13px\">{{deliverSub}}</span></span>\n    </label>\n    </sc-if>\n  </section>\n\n  <section style=\"margin: 12px 16px 0; background: #FFFFFF; border-radius: 20px; box-shadow: 0 2px 12px rgba(31,43,77,0.07); padding: 16px; display: flex; flex-direction: column; gap: 12px\">\n    <div style=\"font-size: 16px; font-weight: 800\">Kenapa sewa di Rentalaja</div>\n    <div style=\"display: flex; gap: 12px; align-items: flex-start\"><span style=\"width: 36px; height: 36px; flex-shrink: 0; border-radius: 12px; background: #E3F7F5; display: flex; align-items: center; justify-content: center\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#077A70\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 3l8 3v6c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V6z\"/><path d=\"M8.5 12l2.5 2.5 4.5-5\"/></svg></span><span style=\"display: flex; flex-direction: column; gap: 2px\"><b style=\"font-size: 14px\">Bayar DP setelah lolos verifikasi</b><span style=\"font-size: 13px; line-height: 18px; color: #5B6577\">Pesan dulu, bayar setelah dicek cabang.</span></span></div>\n    <sc-if value=\"{{soldText}}\"><div style=\"display: flex; gap: 12px; align-items: flex-start\"><span style=\"width: 36px; height: 36px; flex-shrink: 0; border-radius: 12px; background: #FFF1CC; display: flex; align-items: center; justify-content: center\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"#E08A00\" aria-hidden=\"true\"><path d=\"M12 2l3 6.5 7 .8-5.2 4.8 1.4 7L12 17.6 5.8 21.1l1.4-7L2 9.3l7-.8z\"/></svg></span><span style=\"display: flex; flex-direction: column; gap: 2px\"><b style=\"font-size: 14px\">Sudah {{soldText}}</b><span style=\"font-size: 13px; line-height: 18px; color: #5B6577\">Salah satu barang favorit pelanggan Rentalaja.</span></span></div></sc-if>\n    <div style=\"display: flex; gap: 12px; align-items: flex-start\"><span style=\"width: 36px; height: 36px; flex-shrink: 0; border-radius: 12px; background: #E8EEFB; display: flex; align-items: center; justify-content: center\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#3B5BA9\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"4\" y=\"3\" width=\"16\" height=\"18\" rx=\"2.5\"/><path d=\"M8 8h8M8 12h8M8 16h4\"/></svg></span><span style=\"display: flex; flex-direction: column; gap: 2px\"><b style=\"font-size: 14px\">Siapkan dokumen</b><sc-for list=\"{{reqs}}\" as=\"r\"><span style=\"font-size: 13px; line-height: 18px; color: #5B6577\">{{r}}</span></sc-for><a href=\"Bantuan.dc.html\" style=\"font-size: 12px; font-weight: 700; color: #077A70\">Kenapa kami minta ini?</a></span></div>\n  </section>\n\n  <sc-if value=\"{{p.includes}}\">\n  <section style=\"margin: 12px 16px 0; background: #FFFFFF; border-radius: 20px; box-shadow: 0 2px 12px rgba(31,43,77,0.07); padding: 16px; display: flex; flex-direction: column; gap: 6px\">\n    <div style=\"font-size: 16px; font-weight: 800\">Termasuk dalam sewa</div>\n    <div style=\"font-size: 14px; line-height: 21px; color: #3A4558\">{{p.includes}}</div>\n  </section>\n  </sc-if>\n  <sc-if value=\"{{p.description}}\">\n  <section style=\"margin: 12px 16px 0; background: #FFFFFF; border-radius: 20px; box-shadow: 0 2px 12px rgba(31,43,77,0.07); padding: 16px; display: flex; flex-direction: column; gap: 6px\">\n    <div style=\"font-size: 16px; font-weight: 800\">Tentang barang ini</div>\n    <div style=\"font-size: 14px; line-height: 21px; color: #3A4558; white-space: pre-line\">{{p.description}}</div>\n  </section>\n  </sc-if>\n  <sc-if value=\"{{hasRelated}}\">\n  <section style=\"margin: 18px 16px 0; padding: 14px 0 14px 14px; border-radius: 22px; background: linear-gradient(160deg,#E8F8F6 0%,#F5FBFA 60%,#FFFFFF 100%); border: 1px solid #D4EFEB; display: flex; flex-direction: column; gap: 12px\">\n    <div style=\"display: flex; flex-direction: column; gap: 2px; padding-right: 16px\"><h2 style=\"margin: 0; font-size: 17px; font-weight: 800; color: #1F2B4D\">Lengkapi sewamu ✨</h2><span style=\"font-size: 12.5px; color: #4A5468\">{{relSub}}</span></div>\n    <div style=\"display: flex; gap: 10px; overflow-x: auto; padding: 2px 14px 4px 0; scroll-snap-type: x mandatory\">\n      <sc-for list=\"{{related}}\" as=\"x\"><div style=\"width: 158px; flex-shrink: 0; scroll-snap-align: start; background: #FFFFFF; border-radius: 18px; box-shadow: 0 4px 16px rgba(31,43,77,0.09); overflow: hidden; display: flex; flex-direction: column\">\n          <div style=\"position: relative; height: 112px; background: linear-gradient(160deg,#F3F6F9,#E9EEF3); display: flex; align-items: center; justify-content: center; font-size: 10px; font-weight: 600; color: #6B7385; overflow: hidden\"><sc-if value=\"{{x.photo}}\"><img src=\"{{x.photo}}\" alt=\"\" loading=\"lazy\" style=\"width: 100%; height: 100%; object-fit: cover; display: block\"></sc-if><sc-if value=\"{{x.photo}}\" not>Foto belum diunggah</sc-if>\n            <sc-if value=\"{{x.badge}}\"><span style=\"position: absolute; left: 8px; top: 8px; height: 22px; padding: 0 8px; border-radius: 11px; background: rgba(31,43,77,0.86); color: #FFFFFF; font-size: 10.5px; font-weight: 800; display: inline-flex; align-items: center; gap: 3px; backdrop-filter: blur(4px)\">{{x.badge}}</span></sc-if></div>\n          <div style=\"padding: 10px 10px 12px; display: flex; flex-direction: column; gap: 4px; flex-grow: 1\">\n            <div style=\"font-size: 13.5px; font-weight: 800; line-height: 17px; color: #1F2B4D; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 34px\">{{x.name}}</div>\n            <div style=\"font-size: 12px; color: #4A5468\"><b style=\"font-size: 14px; color: #077A70\">{{x.priceBig}}</b>{{x.priceUnit}}</div>\n            <button type=\"button\" onClick=\"{{x.toggle}}\" style=\"{{x.btnStyle}}\">{{x.btn}}</button>\n          </div>\n        </div></sc-for>\n    </div>\n  </section>\n  </sc-if>\n  <div style=\"height: 24px\"></div>\n  </sc-if>\n\n  <sc-if value=\"{{ready}}\">\n  <div style=\"position: absolute; left: 0; right: 0; bottom: 0; background: #FFFFFF; box-shadow: 0 -6px 20px rgba(31,43,77,0.10); border-radius: 20px 20px 0 0; padding: 12px 16px 16px; display: flex; align-items: center; gap: 10px\">\n    <div style=\"display: flex; flex-direction: column; flex: 1; min-width: 0\">\n      <span style=\"font-size: 11px; color: #5B6577; white-space: nowrap; overflow: hidden; text-overflow: ellipsis\">{{barNote}}</span>\n      <span style=\"font-size: 20px; font-weight: 800\">{{rentTotal}}</span><sc-if value=\"{{barSave}}\"><span style=\"align-self: flex-start; font-size: 10.5px; font-weight: 800; white-space: nowrap; border-radius: 6px; padding: 1px 6px; background: #E6F7EE; color: #0E8A4F; border: 1.5px dashed #6FCF97;\">{{barSave}}</span></sc-if>\n    </div>\n    <button type=\"button\" onClick=\"{{addOnly}}\" disabled=\"{{cantBook}}\" aria-label=\"Tambah ke keranjang\" style=\"{{addBtn}}\"><svg width=\"23\" height=\"23\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"9\" cy=\"20\" r=\"1.5\"/><circle cx=\"18\" cy=\"20\" r=\"1.5\"/><path d=\"M3 4h2l2.5 11h11L21 8H7\"/></svg><span style=\"position: absolute; top: -7px; right: -7px; width: 20px; height: 20px; border-radius: 10px; background: #09BEAF; color: #1F2B4D; font-size: 15px; font-weight: 800; line-height: 20px; text-align: center; border: 2px solid #FFFFFF\">+</span></button>\n    <button type=\"button\" onClick=\"{{addCart}}\" disabled=\"{{cantBook}}\" style=\"{{cartBtn}}\">{{cartLabel}}</button>\n  </div>\n  </sc-if>\n\n</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{\"$preview\":{\"width\":390,\"height\":1720}}'>\nclass Component extends DCLogic {\nstate = { p: null, missing: null, price: null, avail: null, related: [], branch: null, zones: [], sizes: [], size: null, guideOpen: false };\nasync componentDidMount() {\n  const id = this.params.id, slug = this.params.slug;\n  if (!id && !slug) { this.setState({ missing: 'Pilih barang dari katalog dulu.' }); return; }\n  let q = RA.from('products').select('*,categories(slug,name,line,kind,price_unit,docs_required)');\n  q = id ? q.eq('id', id) : q.eq('slug', slug);\n  const { data: p } = await q.maybeSingle();\n  if (!p) { this.setState({ missing: 'Barang ini sudah tidak tersedia.' }); return; }\n  const kind = p.categories && p.categories.kind;\n  if (kind === 'stay') return RA.go('Penginapan', { id: p.id });\n  if (kind === 'trip') return RA.go('JeepJadwal', { id: p.id });\n  if (kind === 'car_driver') return RA.go('MobilSopirPaket', { id: p.id });\n  const branch = await RA.branch();\n  const [prices, zones, rel] = await Promise.all([\n    RA.from('product_prices').select('basis,price,dp_percent,late_fee_per_hour,branch_id').eq('product_id', p.id),\n    branch ? RA.from('delivery_zones').select('code,max_km,fee').eq('branch_id', branch.id).order('code') : { data: [] },\n    RA.from('product_relations').select('related_id,pct').eq('product_id', p.id)\n  ]);\n  let related = [];\n  const relPct = {}; (rel.data || []).forEach(r => { relPct[r.related_id] = r.pct; });\n  const relIds = (rel.data || []).map(r => r.related_id);\n  if (relIds.length) {\n    const { data } = await RA.from('products').select('id,name,slug,photos,status,product_prices(basis,price,branch_id)').in('id', relIds).eq('status', 'active');\n    related = (data || []).map(x => { const pp = (x.product_prices || []).filter(z => z.price != null && (!z.branch_id || (branch && z.branch_id === branch.id))); const d = pp.find(z => z.basis === 'day' && z.branch_id) || pp.find(z => z.basis === 'day' || z.basis === 'night' || z.basis === 'trip');\n      return { id: x.id, name: x.name, photo: RA.photo ? RA.photo(x.photos) : '', pct: relPct[x.id] || 0, price: d ? +d.price : null, unit: d ? (d.basis === 'day' ? '/hari' : d.basis === 'night' ? '/malam' : '/trip') : '' }; })\n      .sort((a, b) => (b.pct || 0) - (a.pct || 0));\n  }\n  this.setState({ p, branch, prices: (prices.data || []).filter(x => !x.branch_id || (branch && x.branch_id === branch.id)), zones: zones.data || [], related });\n  this.refreshQuote();\n}\nasync refreshQuote() {\n  const c = RA.ctx(), p = this.state.p; if (!p || !this.state.branch) return;\n  const [q, a] = await Promise.all([\n    RA.rpc('price_item', { p_product: p.id, p_branch: this.state.branch.id, p_start: c.start_at, p_end: c.end_at, p_quantity: 1, p_trips: 1 }),\n    RA.rpc('availability', { p_product: p.id, p_branch: this.state.branch.id, p_start: c.start_at, p_end: c.end_at })\n  ]);\n  try { const zs = await RA.rpc('availability_sizes', { p_product: p.id, p_branch: this.state.branch.id, p_start: c.start_at, p_end: c.end_at });\n    if (RA_ALIVE(this)) { const list = (zs && zs.data) || []; const keep = list.some(z => z.size === this.state.size && z.free > 0) ? this.state.size : null; this.setState({ sizes: list, size: keep }); } } catch (e) {}\n  if (!RA_ALIVE(this)) return;\n  let qt = null, fr = null;\n  fr = await RA.promoFree(this.state.branch && this.state.branch.id); // sumber tunggal: sudah cek aktif, tanggal, cabang\n  try { const r = await RA.rpc('quote', { p: { branch_id: this.state.branch.id, start_at: c.start_at, end_at: c.end_at, items: [{ product_id: p.id, quantity: 1 }] } }); qt = r && r.data; } catch (e) {}\n  if (!RA_ALIVE(this)) return;\n  this.setState({ price: q.data, quote: qt, freeRule: fr, avail: a.data == null ? null : a.data, tick: Date.now() });\n}\nsetDays(d) { this.setHours(d * 24); }\nsetHours(h) {\n  const c = RA.ctx(); const s = new Date(c.start_at); const e = new Date(s.getTime() + h * 3600000);\n  RA.setCtx({ end_at: e.toISOString() }); this.refreshQuote(); this.forceUpdate();\n}\nrenderVals() {\n  const s = this.state, p = s.p;\n  if (!p) return { ready: false, missing: s.missing, hasPhotos: false, photoNote: s.missing ? '' : 'Memuat…' };\n  const c = RA.ctx(), cat = p.categories || {};\n  const days = RA.days(c.start_at, c.end_at);\n  const base = 'height: 44px; border-radius: 10px; font: 700 14px \"Plus Jakarta Sans\", sans-serif; cursor: pointer;';\n  const hrsNow = Math.round((new Date(c.end_at) - new Date(c.start_at)) / 3600000);\n  const has = b => (s.prices || []).some(x => x.basis === b && x.price != null);\n  const durOpts = [];\n  if (has('two_hour')) durOpts.push({ label: '2 jam', h: 2 });\n  if (has('half_day')) durOpts.push({ label: '½ hari', h: 12 });\n  const frR = s.freeRule, freeFor = d => { if (!frR || !s.price || s.price.price_unit !== 'hari') return 0; const cat = p.category_id; if (frR.category_ids && frR.category_ids.indexOf(cat) < 0) return 0; if (frR.exclude_category_ids && frR.exclude_category_ids.indexOf(cat) > -1) return 0; const r = frR.rule || {}; const T = (r.tiers || []).concat(r.buy_days ? [{ buy: r.buy_days, free: r.free_days }] : []); return T.reduce((m, t) => Math.max(m, Math.floor(d / (t.buy + t.free)) * t.free), 0); };\n  const promoOn = freeFor(3) > 0;\n  durOpts.length = 0;\n  if (promoOn) {\n    if (has('two_hour')) durOpts.push({ label: '2 jam', h: 2 }); else if (has('half_day')) durOpts.push({ label: '½ hari', h: 12 });\n    durOpts.push({ label: '1 hari', h: 24 }, { label: '1½ hari', h: 36 });\n    [3, 5].forEach(d => durOpts.push({ label: d + ' hari · bayar ' + (d - freeFor(d)), h: d * 24, hot: true }));\n  } else {\n    if (has('half_day')) durOpts.push({ label: '½ hari', h: 12 }); else if (has('two_hour')) durOpts.push({ label: '2 jam', h: 2 });\n    const lr = (p.categories || {}).slug === 'motor';\n    durOpts.push({ label: '1 hari', h: 24 }, { label: '1½ hari', h: 36 }, { label: '2 hari', h: 48, span: lr ? 3 : 0 }, lr ? { label: '3 hari', h: 72, hot: true, sub: 'hemat 10% · ambil Sen–Jum' } : { label: '3 hari', h: 72 });\n  }\n  const durs = durOpts.map(o => { const on = hrsNow === o.h, m = /^(\\d+ hari) · bayar (\\d+)$/.exec(o.label);\n    return { label: m ? m[1] : o.label, sub: m ? 'cukup bayar ' + m[2] + ' hari' : (o.sub || ''), pick: () => this.setHours(o.h),\n      subStyle: 'font-size: 11px; font-weight: 700; color: ' + (on ? '#CFF5EF' : '#8A5A00'),\n      style: (durOpts.some(x => x.hot) ? 'grid-column: span ' + (o.span || (o.hot ? 3 : 2)) + '; ' : '') + 'min-height: ' + (m || o.sub ? 56 : 44) + 'px; border-radius: 14px; font-family: \"Plus Jakarta Sans\", sans-serif; cursor: pointer; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1px; padding: 6px; ' + (on ? 'border: 2px solid #077A70; background: #077A70; color: #FFFFFF; box-shadow: 0 4px 12px rgba(7,122,112,0.25);' : (m || o.hot) ? 'border: 1.5px solid #F2C14E; background: #FFF9EA; color: #1F2B4D;' : 'border: 1.5px solid #E1E5EA; background: #FFFFFF; color: #1F2B4D;') }; });\n  const durGrid = 'display: grid; grid-template-columns: repeat(' + (durOpts.some(o => o.hot) ? 6 : 4) + ', minmax(0, 1fr)); gap: 8px';\n  const toMin = t => { if (!t) return null; const z = String(t).split(/[:.]/); return (+z[0]) * 60 + (+z[1] || 0); };\n  const enD = new Date(c.end_at), enMin = enD.getHours() * 60 + enD.getMinutes();\n  const bro = s.branch || {}, oM = toMin(bro.open_time), cM = toMin(bro.close_time);\n  const outHours = hrsNow < 24 && oM != null && cM != null && cM > oM && (enMin < oM || enMin > cM);\n  const day = s.prices && s.prices.find(x => x.basis === 'day');\n  const q = s.price;\n  const dpPct = (day && day.dp_percent != null) ? day.dp_percent : (q && q.season_dp != null ? q.season_dp : RA.setting('dp_percent'));\n  const latePct = RA.setting('late_fee_percent_per_hour');\n  const lateText = day && day.late_fee_per_hour != null ? RA.rp(day.late_fee_per_hour) : (latePct != null && day && day.price != null ? RA.rp(Math.round(day.price * latePct / 100)) + ' (' + latePct + '%)' : '');\n  const fees = s.zones.filter(z => z.fee != null).map(z => +z.fee);\n  const deliveryShort = fees.length ? 'mulai ' + RA.rp(Math.min.apply(null, fees)) : 'ongkir dikonfirmasi cabang';\n  const docs = cat.docs_required || RA.setting('docs_required');\n  const opts = (RA.setting('supporting_doc_options') || []).map(x => x.toUpperCase()).join(', ');\n  const reqs = [];\n  if (docs && docs.indexOf('ktp') > -1) reqs.push(docs.indexOf('pendukung') > -1 ? 'KTP dan 1 dokumen pendukung' + (opts ? ': ' + opts : '') + ' (diunggah sekali)' : 'Foto KTP (diunggah sekali)');\n  else reqs.push('Dokumen identitas sesuai syarat cabang (diunggah sekali)');\n  if (RA.setting('ktp_original_deposit') === true) reqs.push('KTP asli dititipkan di cabang selama sewa');\n  const delivery = (c.delivery && c.delivery.mode) === 'delivery';\n  const box = on => 'display: flex; gap: 10px; align-items: flex-start; font-size: 14px; line-height: 20px; border: ' + (on ? '2px solid #077A70; background: #F2FBFA' : '1.5px solid #E1E5EA') + '; border-radius: 14px; padding: 12px; cursor: pointer';\n  const br = s.branch || {};\n  const hours = br.open_time ? 'buka ' + br.open_time.slice(0, 5).replace(':', '.') + '–' + (br.close_time || '').slice(0, 5).replace(':', '.') : '';\n  const noPrice = !q;\n  const avail = s.avail;\n  const SZ = s.sizes || [], needSize = SZ.length > 0 && !s.size;\n  const cantBook = noPrice || avail === 0 || needSize;\n  const numeric = SZ.length > 0 && SZ.every(z => /^\\d+(\\.\\d+)?$/.test(z.size));\n  const lines = { hub: 'Hub', transportation: 'Transportation', experience: 'Experience' };\n  const phone = br.phone;\n  const msg = encodeURIComponent('Halo Rentalaja ' + (br.name || '') + ', saya mau tanya ' + p.name + ' untuk ' + RA.day(c.start_at) + ' – ' + RA.day(c.end_at));\n  const photos = (p.photos || []).map(x => RA.publicUrl(x));\n  const saveAmt = s.quote && q ? (+s.quote.free_days_discount || 0) + (+s.quote.member_discount || 0) + (+s.quote.bundle_discount || 0) : 0;\n  const f3 = freeFor(3), f5 = freeFor(5);\n  return {\n    catName: cat.name || (lines[cat.line] || ''), soldText: p.rent_count ? RA.num(p.rent_count) + '× disewa' : '',\n    availPill: 'height: 26px; padding: 0 10px; border-radius: 13px; display: flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 700; ' + (avail > 0 ? 'background: #E4F6EC; color: #1E7A47' : 'background: #FBE6E1; color: #A12A1F'),\n    unitPrice: day && day.price != null ? RA.rp(day.price) : '', unitSuf: '/hari',\n    promoBanner: promoOn ? 'Sewa ' + 3 + ' hari, cukup bayar ' + (3 - f3) + ' hari' : '', promoSub: promoOn ? (f5 > f3 ? 'Sewa 5 hari cukup bayar ' + (5 - f5) + ' · ' : '') + 'potongan otomatis' : '',\n    saveText: saveAmt > 0 ? 'Kamu hemat ' + RA.rp(saveAmt) : '', barSave: saveAmt > 0 ? 'Hemat ' + RA.rp(saveAmt) : '', wasTotal: saveAmt > 0 ? RA.rp(q.line_total) : '',\n    dpShort: dpPct == null ? 'Lunas setelah lolos' : 'DP ' + dpPct + '% saja', photoCount: '',\n    ready: true, p, photos, hasPhotos: photos.length > 0, photoNote: 'Foto belum diunggah',\n    lineLabel: lines[cat.line] || '', branchName: br.name || '—',\n    subline: (p.rent_count ? 'Disewa ' + RA.num(p.rent_count) + ' kali' : 'Baru di Rentalaja') + (p.short_desc ? ' · ' + p.short_desc : ''),\n    durs, durGrid, outHours, pickDate: RA.dayTime(c.start_at), returnDate: RA.dayTime(c.end_at), calHref: 'Kalender.dc.html?id=' + p.id,\n    availText: avail == null ? '' : avail > 0 ? (avail === 1 ? 'Sisa 1 unit' : 'Tersedia di tanggalmu') : 'Habis di tanggal ini',\n    availStyle: 'font-size: 13px; font-weight: 700; color: ' + (avail > 0 ? '#1E6B45' : '#A12A1F'),\n    noPrice, rent: q ? RA.rp(q.line_total) : '—',\n    rentTotal: s.quote && s.quote.total != null && q ? RA.rp(s.quote.total) : (q ? RA.rp(q.line_total) : '—'),\n    promoLines: !s.quote || !q ? [] : [].concat((s.quote.packs_applied || []).filter(x => +x.amount > 0).map(x => ({ label: x.name, amount: RA.rp(x.amount) })), +s.quote.free_days_discount > 0 ? [{ label: 'Promo gratis hari sewa', amount: RA.rp(s.quote.free_days_discount) }] : [],\n      +s.quote.member_discount > 0 ? [{ label: (s.quote.member_label || 'Diskon member ' + (+s.quote.member_percent) + '%'), amount: RA.rp(s.quote.member_discount) }] : []),\n    rentLabel: q ? (q.basis === 'day' ? (q.qty % 1 ? 'Sewa ' + RA.durText(c.start_at, c.end_at) + ' (' + Math.floor(q.qty) + ' hari + ½ hari)' : 'Sewa ' + RA.durText(c.start_at, c.end_at) + ' × ' + RA.rp(q.unit_price)) : q.basis === 'week' ? 'Sewa ' + RA.durText(c.start_at, c.end_at) + ' (tarif mingguan)' : q.basis === 'month' ? 'Sewa ' + RA.durText(c.start_at, c.end_at) + ' (tarif bulanan)' : 'Sewa ' + RA.durText(c.start_at, c.end_at) + '') : '',\n    seasonNote: q && q.season_increase ? 'Harga musim +' + q.season_increase + '%' : '',\n    dpText: dpPct == null ? 'Bayar lunas setelah lolos verifikasi' : 'DP ' + dpPct + '% setelah lolos verifikasi',\n    cityRule: cat.slug === 'motor' ? 'Motor hanya untuk pemakaian di dalam ' + (/bandung/i.test(br.name || '') ? 'Kota Bandung' : 'Kabupaten Garut') + ', tidak boleh dibawa ke luar kota.' : '',\n    lateText, deliveryText: br.delivery_enabled ? deliveryShort : '', canDeliver: !!br.delivery_enabled, deliveryShort, deliverSub: delivery && c.delivery.address ? 'Ke ' + c.delivery.address + (c.delivery.return_pickup ? ' · dijemput saat selesai' : '') + ' · Ubah' : 'Rumah, kos, atau hotel · ' + deliveryShort,\n    reqs, isPickup: !delivery, isDelivery: delivery, pickupBox: box(!delivery), deliverBox: box(delivery),\n    branchInfo: [br.address, hours].filter(Boolean).join(' · ') || 'Alamat cabang belum diisi',\n    choosePickup: () => { RA.setCtx({ delivery: { mode: 'pickup' } }); this.forceUpdate(); },\n    chooseDelivery: () => { RA.setCtx({ delivery: Object.assign({}, RA.ctx().delivery || {}, { mode: 'delivery' }) }); RA.go('Antar', { back: 'Produk', id: p.id }); },\n    hasRelated: s.related.length > 0, relSub: 'Sering disewa bareng ' + p.name,\n    related: s.related.map(x => { const has = (RA.ctx().cart || []).some(i => i.product_id === x.id); const kp = n => n == null ? '' : n >= 1000 ? 'Rp' + (Math.round(n / 100) / 10).toString().replace('.', ',').replace(/,0$/, '') + 'rb' : RA.rp(n);\n      return { photo: x.photo, name: x.name, badge: x.pct >= 5 ? '🔥 ' + x.pct + '% ikut sewa' : '', priceBig: x.price != null ? kp(x.price) : 'Cek harga', priceUnit: x.price != null ? x.unit : '',\n        btn: has ? '✓ Di keranjang' : '+ Tambah', btnStyle: (has ? 'height: 36px; border-radius: 11px; border: 0; background: #077A70; color: #FFFFFF;' : 'height: 36px; border-radius: 11px; border: 1.5px solid #09BEAF; background: #FFFFFF; color: #077A70;') + ' font: 800 13px \"Plus Jakarta Sans\", sans-serif; cursor: pointer; margin-top: 4px; width: 100%',\n        toggle: () => { if (has) return RA.go('Keranjang'); RA.addToCart({ product_id: x.id }); RA.ok(x.name + ' masuk keranjang ✓'); this.forceUpdate(); } }; }),\n    barNote: 'Total ' + RA.durText(c.start_at, c.end_at) + (dpPct == null ? '' : ' · DP ' + dpPct + '%'),\n    hasSizes: SZ.length > 0, hasGuide: numeric, showGuide: numeric && s.guideOpen, toggleGuide: () => this.setState({ guideOpen: !s.guideOpen }),\n    sizes: SZ.map(z => { const on = s.size === z.size, out = z.free <= 0;\n      return { label: z.size, out, on: on ? 'true' : 'false', left: out ? 'Penuh' : z.free === 1 ? 'Sisa 1' : 'Sisa ' + z.free,\n        pick: () => { if (!out) this.setState({ size: z.size }); },\n        labelStyle: 'font-size: 17px; font-weight: 800;' + (out ? ' text-decoration: line-through' : ''),\n        style: 'min-height: 56px; border-radius: 12px; font-family: inherit; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; ' + (out ? 'border: 1.5px dashed #C4CBD6; background: #F7F8FA; color: #6B7385; cursor: not-allowed' : on ? 'border: 2px solid #077A70; background: #E7F7F5; color: #06433D; cursor: pointer' : 'border: 1.5px solid #D5DBE3; background: #FFFFFF; color: #1F2B4D; cursor: pointer') }; }),\n    sizeNote: s.size ? 'Ukuran ' + s.size + ' dikunci untukmu. Kasir menyiapkan unit ukuran ini saat serah terima.' : 'Sisa unit dihitung untuk tanggal yang kamu pilih.',\n    cantBook, cartLabel: avail === 0 ? 'Habis' : needSize ? 'Pilih ukuran' : 'Sewa sekarang',\n    cartBtn: 'height: 50px; flex-shrink: 0; padding: 0 20px; white-space: nowrap; border-radius: 14px; border: 0; background: ' + (cantBook ? '#C5CBD4' : '#09BEAF') + '; color: #1F2B4D; font: 800 16px \"Plus Jakarta Sans\", sans-serif; cursor: ' + (cantBook ? 'not-allowed' : 'pointer'),\n    addCart: () => { if (cantBook) return; RA.addToCart(Object.assign({ product_id: p.id }, s.size ? { sizes: [s.size] } : {})); RA.go('Keranjang'); },\n    addOnly: () => { if (cantBook) return; RA.addToCart(Object.assign({ product_id: p.id }, s.size ? { sizes: [s.size] } : {})); RA.ok('Masuk keranjang ✓' + (s.size ? ' · ukuran ' + s.size : '')); this.forceUpdate(); },\n    addBtn: 'position: relative; width: 50px; height: 50px; flex-shrink: 0; padding: 0; display: flex; align-items: center; justify-content: center; border-radius: 14px; background: #FFFFFF; border: 1.5px solid ' + (cantBook ? '#D5D9E0' : '#09BEAF') + '; color: ' + (cantBook ? '#9AA2B1' : '#077A70') + '; font: 800 14px \"Plus Jakarta Sans\", sans-serif; cursor: ' + (cantBook ? 'not-allowed' : 'pointer'),\n    waHref: phone ? 'https://wa.me/' + phone + '?text=' + msg : ''\n  };\n}\n}\n</script>\n</body>\n</html>\n"}