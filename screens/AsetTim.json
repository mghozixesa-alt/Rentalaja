{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Performa tim aset</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0}\na{color:#1F2B4D}a:hover{color:#000}\nbutton:disabled{opacity:.55;cursor:not-allowed}\n\n/* tampilan desktop (layar lebar) */\n@media (min-width: 1000px){\n  header[data-hero]{padding-left:32px !important;padding-right:32px !important;padding-top:22px !important}\n  header[data-hero] > div, main{max-width:1180px !important}\n  main{padding-left:32px !important;padding-right:32px !important}\n  header[data-hero] img[alt=\"Rentalaja\"]{visibility:hidden}\n  header[data-hero] [data-scrollx]{overflow:visible !important;margin:0 !important;padding:0 !important;flex-wrap:wrap}\n  header[data-hero] [data-scrollx] > *{flex:1 1 150px !important;min-width:0 !important}\n  main [data-scrollx]{overflow:visible !important;scroll-snap-type:none !important;flex-wrap:wrap}\n  span[data-noprint]{display:none}\n  main{display:grid !important;grid-template-columns:1fr 1fr;align-items:start}\n  main > [role=\"tablist\"], main > div{grid-column:1 / -1}\n  main [role=\"tablist\"]{max-width:520px}\n  main section [data-scrollx]{margin:0 !important;padding:0 !important}\n  main section [data-scrollx] > div{flex:1 1 92px !important}\n}\n</style>\n</helmet>\n<div style=\"min-height: 100vh; box-sizing: border-box; background: #F4F6F9; color: #1F2B4D; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; flex-direction: column\">\n\n  <header data-hero=\"1\" style=\"background: linear-gradient(160deg, #1F2B4D 0%, #2E3F6B 100%); padding: 14px 16px 18px; color: #FFFFFF\">\n    <div style=\"max-width: 720px; margin: 0 auto; display: flex; flex-direction: column; gap: 12px\">\n      <div style=\"display: flex; justify-content: space-between; align-items: center\"><div><div style=\"font-size: 13px; opacity: 0.9\">Performa tim aset · {{month}}</div><div style=\"font-size: 20px; font-weight: 800; line-height: 25px\">{{headline}}</div></div><button type=\"button\" data-noprint=\"1\" onClick=\"{{cetak}}\" style=\"height: 32px; padding: 0 12px; border-radius: 16px; border: 0; background: #FFFFFF; color: #1F2B4D; font: 800 12px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">⎙ Cetak / PDF</button></div>\n      <div data-scrollx=\"1\" style=\"display: flex; gap: 8px; overflow-x: auto; margin: 0 -16px; padding: 0 16px\"><sc-for list=\"{{kpi}}\" as=\"k\"><div style=\"flex: 0 0 auto; min-width: 118px; background: rgba(255,255,255,0.12); border-radius: 12px; padding: 10px 12px\"><div style=\"font-size: 20px; font-weight: 800; color: {{k.c}}\">{{k.v}}</div><div style=\"font-size: 11px; opacity: 0.9\">{{k.l}}</div><div style=\"font-size: 10px; opacity: 0.75\">{{k.t}}</div></div></sc-for></div>\n    </div>\n  </header>\n  <main style=\"width: 100%; max-width: 720px; margin: 0 auto; box-sizing: border-box; padding: 12px 16px 16px; display: flex; flex-direction: column; gap: 12px\">\n    <div role=\"tablist\" data-noprint=\"1\" style=\"background: #FFFFFF; border-radius: 14px; padding: 4px; display: grid; grid-template-columns: 1fr 1fr; gap: 4px; box-shadow: 0 2px 10px rgba(31,43,77,0.05)\"><sc-for list=\"{{tabs}}\" as=\"t\"><button type=\"button\" role=\"tab\" aria-selected=\"{{t.on}}\" onClick=\"{{t.pick}}\" style=\"{{t.style}}\">{{t.label}}</button></sc-for></div>\n    <sc-if value=\"{{empty}}\"><div style=\"background: #FFFFFF; border-radius: 16px; box-shadow: 0 2px 10px rgba(31,43,77,0.05); padding: 14px; display: flex; flex-direction: column; gap: 10px; text-align: center; font-size: 14px; color: #4A5468\">{{empty}}</div></sc-if>\n    <sc-for list=\"{{people}}\" as=\"p\"><section style=\"background: #FFFFFF; border-radius: 16px; box-shadow: 0 2px 10px rgba(31,43,77,0.05); padding: 14px; display: flex; flex-direction: column; gap: 10px; border-left: 4px solid {{p.bar}}\">\n      <div style=\"display: flex; align-items: center; gap: 10px\"><span style=\"width: 42px; height: 42px; border-radius: 21px; background: #1F2B4D; color: #09BEAF; font-weight: 800; display: flex; align-items: center; justify-content: center; flex-shrink: 0\">{{p.ini}}</span><div style=\"flex: 1; min-width: 0\"><b style=\"font-size: 15px\">{{p.medal}} {{p.name}}</b><div style=\"font-size: 12px; color: #4A5468\">{{p.role}}</div></div><span style=\"{{p.chip}}\">{{p.grade}}</span></div>\n      <div data-scrollx=\"1\" style=\"display: flex; gap: 8px; overflow-x: auto; margin: 0 -14px; padding: 0 14px 2px\"><sc-for list=\"{{p.stats}}\" as=\"x\"><div style=\"flex: 0 0 auto; min-width: 92px; background: #F6F7F9; border-radius: 10px; padding: 8px 10px\"><div style=\"font-size: 17px; font-weight: 800; color: {{x.c}}\">{{x.v}}</div><div style=\"font-size: 11px; color: #4A5468\">{{x.l}}</div></div></sc-for></div>\n      <sc-if value=\"{{p.note}}\"><span style=\"font-size: 12px; line-height: 17px; color: {{p.noteC}}\">{{p.note}}</span></sc-if>\n    </section></sc-for>\n    <div style=\"font-size: 12px; line-height: 17px; color: #4A5468; padding: 0 4px\">Nilai: <b>Bagus</b> bila ≥ 80% tepat waktu & tidak ada servis molor; <b>Perlu dibina</b> bila di bawah 60% atau ada servis lewat target lebih dari 3 hari.</div>\n  </main>\n</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{\"$preview\":{\"width\":390,\"height\":844}}'>\nclass Component extends DCLogic {\nstate = { tab: 'tek', d: null };\nasync componentDidMount() { await RA.staff(); await this.reload(); }\nasync reload() {\n  const t = new Date(); const m0 = new Date(t.getFullYear(), t.getMonth(), 1), p0 = new Date(t.getFullYear(), t.getMonth() - 1, 1);\n  const [wo, qc, sf] = await Promise.all([\n    RA.from('work_orders').select('id,status,technician_id,vendor_name,created_at,started_at,finished_at,target_at,total_cost').or('finished_at.gte.' + p0.toISOString() + ',status.in.(queued,working,waiting_part,qc)').limit(3000),\n    RA.from('qc_inspections').select('id,inspector_id,passed,source,done_at,work_order_id').gte('done_at', p0.toISOString()).limit(5000),\n    RA.from('staff').select('user_id,name,role,is_active,extra_roles')\n  ]);\n  if (!RA_ALIVE(this)) return;\n  this.setState({ d: { wo: wo.data || [], qc: qc.data || [], sf: sf.data || [], m0, p0 } });\n}\nrenderVals() {\nconst s = this.state, d = s.d, now = new Date();\nconst dur = h => h == null ? '—' : h < 24 ? h.toFixed(1).replace('.', ',') + ' jam' : (h / 24).toFixed(1).replace('.', ',') + ' hari';\nconst pc = (a, b) => b ? Math.round(100 * a / b) : null;\nlet people = [], kpi = [], head = '';\nif (d) {\n  const SF = {}; d.sf.forEach(x => { SF[x.user_id] = x; });\n  const inM = x => x && new Date(x) >= d.m0, inP = x => x && new Date(x) >= d.p0 && new Date(x) < d.m0;\n  const doneM = d.wo.filter(w => w.status === 'done' && inM(w.finished_at)), doneP = d.wo.filter(w => w.status === 'done' && inP(w.finished_at));\n  const open = d.wo.filter(w => ['queued', 'working', 'waiting_part', 'qc'].indexOf(w.status) > -1);\n  const ot = ws => ws.filter(w => !w.target_at || new Date(w.finished_at) <= new Date(w.target_at)).length;\n  const avgH = ws => { const h = ws.map(w => (new Date(w.finished_at) - new Date(w.started_at || w.created_at)) / 36e5).filter(x => x >= 0); return h.length ? h.reduce((a, b) => a + b, 0) / h.length : null; };\n  const qcSvc = d.qc.filter(q => inM(q.done_at) && q.work_order_id); const fp = pc(qcSvc.filter(q => q.passed).length, qcSvc.length);\n  const lateOpen = open.filter(w => w.target_at && new Date(w.target_at) < now).length;\n  kpi = [[String(doneM.length), 'servis selesai', doneP.length ? (doneM.length >= doneP.length ? '▲ ' : '▼ ') + 'bln lalu ' + doneP.length : '', '#FFFFFF'], [pc(ot(doneM), doneM.length) == null ? '—' : pc(ot(doneM), doneM.length) + '%', 'tepat waktu', '', pc(ot(doneM), doneM.length) >= 80 || !doneM.length ? '#9EF0E6' : '#FFB4AD'], [dur(avgH(doneM)), 'rata-rata servis', '', '#FFFFFF'], [fp == null ? '—' : fp + '%', 'lolos QC pertama', '', '#FFFFFF'], [String(lateOpen), 'servis molor', '', lateOpen ? '#FFB4AD' : '#FFFFFF'], [RA.rpShort ? RA.rpShort(doneM.reduce((a, w) => a + (+w.total_cost || 0), 0)) : '—', 'biaya servis', '', '#FFFFFF']].map(([v, l, t, c]) => ({ v, l, t, c }));\n  if (s.tab === 'tek') {\n    const ids = {}; d.sf.filter(x => x.is_active && (x.role === 'technician' || (x.extra_roles || []).indexOf('technician') > -1)).forEach(x => { ids[x.user_id] = 1; }); d.wo.forEach(w => { if (w.technician_id) ids[w.technician_id] = 1; });\n    const vend = {}; d.wo.forEach(w => { if (w.vendor_name) vend['v:' + w.vendor_name] = w.vendor_name; });\n    people = Object.keys(ids).concat(Object.keys(vend)).map(k => { const mine = w => k.indexOf('v:') === 0 ? w.vendor_name === vend[k] : w.technician_id === k;\n      const dm = doneM.filter(mine), dp = doneP.filter(mine), op = open.filter(mine), lt = op.filter(w => w.target_at && new Date(w.target_at) < now), lt3 = lt.filter(w => (now - new Date(w.target_at)) / 864e5 > 3);\n      const o = pc(ot(dm), dm.length); const q = d.qc.filter(x => inM(x.done_at) && x.work_order_id && dm.some(w => w.id === x.work_order_id)); const f = pc(q.filter(x => x.passed).length, q.length);\n      const good = dm.length && (o == null || o >= 80) && !lt.length, bad = (o != null && o < 60) || lt3.length;\n      const name = k.indexOf('v:') === 0 ? 'Bengkel ' + vend[k] : (SF[k] || {}).name || 'Teknisi';\n      return { k, n: dm.length, name, ini: RA.initials(name), role: k.indexOf('v:') === 0 ? 'Bengkel rekanan' : 'Teknisi', grade: bad ? 'Perlu dibina' : good ? 'Bagus' : dm.length ? 'Cukup' : 'Belum ada data',\n        chip: 'display: inline-flex; align-items: center; height: 24px; padding: 0 10px; border-radius: 12px; font-size: 12px; font-weight: 800; white-space: nowrap; flex-shrink: 0; ' + (bad ? 'background: #FDECEA; color: #A12A1F' : good ? 'background: #E4F2EA; color: #1E6B45' : 'background: #EEF0F3; color: #4A5468'), bar: bad ? '#E5534B' : good ? '#1E9E6A' : '#B4BCC8',\n        stats: [[String(dm.length), 'selesai', '#1F2B4D'], [o == null ? '—' : o + '%', 'tepat waktu', o == null || o >= 80 ? '#1E6B45' : '#A12A1F'], [dur(avgH(dm)), 'rata-rata', '#1F2B4D'], [f == null ? '—' : f + '%', 'lolos QC', f == null || f >= 80 ? '#1E6B45' : '#8A4B00'], [String(op.length), 'dipegang', '#1F2B4D'], [String(lt.length), 'molor', lt.length ? '#A12A1F' : '#1F2B4D']].map(([v, l, c]) => ({ v, l, c })),\n        note: lt.length ? '⚠ ' + lt.length + ' servis lewat target' + (lt3.length ? ', ' + lt3.length + ' di antaranya > 3 hari' : '') : dp.length ? 'Bulan lalu ' + dp.length + ' servis selesai' + (dm.length > dp.length ? ' — sudah lebih banyak 👏' : '') : '', noteC: lt.length ? '#A12A1F' : '#4A5468' }; });\n  } else {\n    const ids = {}; d.qc.forEach(q => { if (q.inspector_id) ids[q.inspector_id] = 1; });\n    people = Object.keys(ids).map(k => { const qm = d.qc.filter(q => q.inspector_id === k && inM(q.done_at)), qp = d.qc.filter(q => q.inspector_id === k && inP(q.done_at)); const fail = qm.filter(q => !q.passed).length;\n      const name = (SF[k] || {}).name || 'Petugas';\n      return { k, n: qm.length, name, ini: RA.initials(name), role: 'Pemeriksa QC', grade: qm.length ? 'Aktif' : 'Belum ada data', chip: 'display: inline-flex; align-items: center; height: 24px; padding: 0 10px; border-radius: 12px; font-size: 12px; font-weight: 800; white-space: nowrap; flex-shrink: 0; background: #E3F7F5; color: #077A70', bar: '#09BEAF',\n        stats: [[String(qm.length), 'unit dicek', '#1F2B4D'], [String(fail), 'ditolak (temuan)', fail ? '#8A4B00' : '#1F2B4D'], [String(qm.filter(q => q.source === 'return').length), 'setelah kembali', '#1F2B4D'], [String(qm.filter(q => q.source !== 'return').length), 'setelah servis', '#1F2B4D']].map(([v, l, c]) => ({ v, l, c })),\n        note: qp.length ? 'Bulan lalu ' + qp.length + ' unit dicek' : '', noteC: '#4A5468' }; });\n  }\n  people.sort((a, b) => b.n - a.n); people.forEach((p, i) => { p.medal = p.n ? ['🥇', '🥈', '🥉'][i] || '' : ''; });\n  const badN = people.filter(p => p.grade === 'Perlu dibina').length;\n  head = badN ? badN + ' orang perlu dibina' : people.length ? 'Tim berjalan baik 👍' : 'Belum ada data tim';\n}\nconst tabS = on => 'height: 40px; border: 0; border-radius: 10px; background: ' + (on ? '#1F2B4D' : 'transparent') + '; color: ' + (on ? '#FFFFFF' : '#1F2B4D') + '; font: 800 13px \\'Plus Jakarta Sans\\', sans-serif; cursor: pointer';\nreturn { month: RA.BULAN[now.getMonth()], headline: !d ? 'Memuat…' : head, kpi, people, cetak: () => window.print(),\n  tabs: [['tek', 'Teknisi & bengkel'], ['qc', 'Petugas QC']].map(([k, l]) => ({ label: l, on: s.tab === k ? 'true' : 'false', style: tabS(s.tab === k), pick: () => this.setState({ tab: k }) })),\n  empty: d && !people.length ? (s.tab === 'tek' ? 'Belum ada teknisi atau servis tercatat. Tambahkan teknisi di Staf & akses.' : 'Belum ada pemeriksaan QC bulan ini.') : '' };\n}\n}\n</script>\n</body>\n</html>\n"}