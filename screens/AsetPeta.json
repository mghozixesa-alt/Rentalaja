{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Peta armada GPS</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0}\n.cp-card{background:#FFFFFF;border-radius:20px;box-shadow:0 2px 12px rgba(31,43,77,.06);padding:16px;display:flex;flex-direction:column;gap:10px}\n.cp-btn{height:44px;border:0;border-radius:12px;background:linear-gradient(135deg,#12B5A6,#077A70);color:#FFFFFF;font:800 14px 'Plus Jakarta Sans',sans-serif;cursor:pointer;display:flex;align-items:center;justify-content:center;text-decoration:none;padding:0 14px}\n.cp-btn2{height:40px;border:1.5px solid #E3E7ED;border-radius:12px;background:#FFFFFF;color:#1F2B4D;font:800 13px 'Plus Jakarta Sans',sans-serif;cursor:pointer;display:flex;align-items:center;justify-content:center;text-decoration:none;padding:0 12px;white-space:nowrap}\n.cp-in{height:44px;box-sizing:border-box;border:1.5px solid #E3E7ED;border-radius:12px;padding:0 12px;font:700 14px 'Plus Jakarta Sans',sans-serif;color:#1F2B4D;background:#FFFFFF;width:100%}\n.kp{background:#FFFFFF;border-radius:16px;padding:12px 14px;box-shadow:0 2px 12px rgba(31,43,77,.05);display:flex;flex-direction:column;gap:2px}\n.kp span{font-size:12px;color:#4A5468;font-weight:700}.kp b{font-size:24px;line-height:30px}.kp i{font-style:normal;font-size:11.5px;color:#6B7486}\n.map{position:relative;width:100%;aspect-ratio:16/9;border-radius:16px;overflow:hidden;background:#E8EDF3}\n.map img.t{position:absolute;display:block;max-width:none}\n.pin{position:absolute;transform:translate(-50%,-50%);display:flex;align-items:center;gap:4px;text-decoration:none;color:#1F2B4D}\n.pin s{width:14px;height:14px;border-radius:50%;border:3px solid #FFFFFF;box-shadow:0 1px 4px rgba(0,0,0,.35);display:block}\n.pin em{font-style:normal;background:#FFFFFF;border-radius:6px;padding:1px 5px;font-size:10.5px;font-weight:800;white-space:nowrap;box-shadow:0 1px 3px rgba(0,0,0,.2)}\n.row{display:flex;gap:10px;align-items:flex-start;padding:11px 0;border-bottom:1px solid #EEF0F3}\n.row:last-child{border-bottom:0}\n.dot{width:10px;height:10px;border-radius:50%;flex:none;margin-top:5px}\n</style>\n</helmet>\n<div style=\"min-height: 100vh; box-sizing: border-box; background: #F4F6F9; color: #1F2B4D; font-family: 'Plus Jakarta Sans', system-ui, sans-serif\">\n <main style=\"max-width: 1100px; margin: 0 auto; padding: 18px 16px 28px; display: flex; flex-direction: column; gap: 14px\">\n  <div style=\"display: flex; justify-content: space-between; align-items: flex-end; gap: 10px; flex-wrap: wrap\">\n   <div><div style=\"font-size: 13px; font-weight: 700; color: #5B6577\">{{scope}}</div><h1 style=\"margin: 2px 0 0; font-size: 26px; line-height: 32px\">Peta armada GPS</h1>\n    <div style=\"font-size: 13px; color: #4A5468; margin-top: 4px\">{{updated}}</div></div>\n   <button type=\"button\" class=\"cp-btn2\" onClick=\"{{reload}}\">↻ Muat ulang</button>\n  </div>\n  <div style=\"display: flex; gap: 6px; overflow-x: auto\"><sc-for list=\"{{brs}}\" as=\"t\"><button type=\"button\" onClick=\"{{t.pick}}\" style=\"{{t.style}}\">{{t.label}}</button></sc-for></div>\n  <sc-if value=\"{{loading}}\"><div class=\"cp-card\" style=\"text-align: center; color: #4A5468\">Memuat…</div></sc-if>\n  <sc-if value=\"{{ready}}\">\n  <sc-if value=\"{{banner}}\"><div style=\"background: #FFF6E5; color: #7A4B00; border-radius: 14px; padding: 12px 14px; font-size: 13.5px; line-height: 19px; font-weight: 700\">{{banner}}</div></sc-if>\n  <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px\">\n   <sc-for list=\"{{kpis}}\" as=\"k\"><div class=\"kp\"><span>{{k.l}}</span><b style=\"color: {{k.c}}\">{{k.v}}</b><i>{{k.s}}</i></div></sc-for>\n  </div>\n  <div style=\"display: flex; flex-wrap: wrap; gap: 14px; align-items: flex-start\">\n   <section class=\"cp-card\" style=\"flex: 999 1 520px; min-width: 0; padding: 10px\">\n    <sc-if value=\"{{map}}\">\n     <div class=\"map\">\n      <sc-for list=\"{{map.tiles}}\" as=\"t\"><img class=\"t\" alt=\"\" src=\"{{t.src}}\" style=\"{{t.style}}\" loading=\"lazy\"></sc-for>\n      <sc-for list=\"{{map.rings}}\" as=\"r\"><div style=\"{{r.style}}\"></div></sc-for>\n      <sc-for list=\"{{map.pins}}\" as=\"p\"><a class=\"pin\" href=\"{{p.href}}\" style=\"{{p.pos}}\"><s style=\"background: {{p.c}}\"></s><em>{{p.label}}</em></a></sc-for>\n      <span style=\"position: absolute; right: 6px; bottom: 4px; font-size: 10px; background: rgba(255,255,255,.85); padding: 1px 5px; border-radius: 4px\">© OpenStreetMap</span>\n     </div>\n    </sc-if>\n    <sc-if value=\"{{map}}\" not><div style=\"aspect-ratio: 16/9; border-radius: 16px; background: #EEF1F5; display: flex; align-items: center; justify-content: center; text-align: center; padding: 20px; box-sizing: border-box; color: #4A5468; font-size: 14px; font-weight: 700\">Belum ada unit yang mengirim posisi.<br>Sambungkan alat GPS dulu (daftar di bawah).</div></sc-if>\n    <div style=\"display: flex; flex-wrap: wrap; gap: 12px; font-size: 12px; padding: 4px 6px; color: #4A5468\">\n     <span>🟢 Siap di cabang</span><span>🔵 Disewa</span><span>🟠 Perlu dicek</span><span>⚪ Sinyal hilang</span><span>◯ Area cabang</span>\n    </div>\n   </section>\n   <section class=\"cp-card\" style=\"flex: 1 1 340px; min-width: 0; max-height: 640px; overflow-y: auto\">\n    <div style=\"display: flex; justify-content: space-between; align-items: center\"><b style=\"font-size: 17px\">Perlu dicek</b><span style=\"font-size: 12px; color: #6B7486\">{{alertSub}}</span></div>\n    <sc-if value=\"{{noAlert}}\"><div style=\"color: #1E6B45; font-weight: 700; font-size: 14px; padding: 8px 0\">✓ Tidak ada peringatan aktif.</div></sc-if>\n    <div>\n    <sc-for list=\"{{alerts}}\" as=\"a\"><div class=\"row\">\n     <span class=\"dot\" style=\"background: {{a.c}}\"></span>\n     <div style=\"flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px\">\n      <div style=\"display: flex; justify-content: space-between; gap: 8px\"><b style=\"font-size: 14px\">{{a.title}}</b><span style=\"font-size: 12px; color: #6B7486; white-space: nowrap\">{{a.ago}}</span></div>\n      <span style=\"font-size: 13px\">{{a.unit}}</span><span style=\"font-size: 12.5px; color: #4A5468\">{{a.detail}}</span>\n      <sc-if value=\"{{a.state}}\"><span style=\"font-size: 12px; color: #1E6B45; font-weight: 700\">{{a.state}}</span></sc-if>\n      <div style=\"display: flex; gap: 6px; flex-wrap: wrap; margin-top: 2px\"><a class=\"cp-btn2\" href=\"{{a.href}}\">Lihat unit</a><sc-if value=\"{{a.gmap}}\"><a class=\"cp-btn2\" href=\"{{a.gmap}}\" target=\"_blank\" rel=\"noopener\">Google Maps ↗</a></sc-if><sc-if value=\"{{a.open}}\"><button type=\"button\" class=\"cp-btn2\" onClick=\"{{a.done}}\">Sudah dicek</button></sc-if></div>\n     </div>\n    </div></sc-for>\n    </div>\n   </section>\n  </div>\n  <section class=\"cp-card\">\n   <div style=\"display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap\"><b style=\"font-size: 17px\">Unit kendaraan</b>\n    <div style=\"display: flex; gap: 6px; overflow-x: auto\"><sc-for list=\"{{tabs}}\" as=\"t\"><button type=\"button\" onClick=\"{{t.pick}}\" style=\"{{t.style}}\">{{t.label}}</button></sc-for></div></div>\n   <input class=\"cp-in\" type=\"search\" placeholder=\"Cari plat / kode aset\" value=\"{{q}}\" onInput=\"{{setQ}}\">\n   <sc-if value=\"{{noRows}}\"><div style=\"color: #4A5468; font-size: 14px; padding: 8px 0\">{{noRows}}</div></sc-if>\n   <div><sc-for list=\"{{rows}}\" as=\"r\"><a class=\"row\" href=\"{{r.href}}\" style=\"text-decoration: none; color: #1F2B4D\">\n    <span class=\"dot\" style=\"background: {{r.c}}\"></span>\n    <span style=\"flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px\"><b style=\"font-size: 14px\">{{r.label}} <span style=\"font-weight: 600; color: #6B7486\">· {{r.product}}</span></b><span style=\"font-size: 12.5px; color: #4A5468\">{{r.sub}}</span></span>\n    <span style=\"text-align: right; font-size: 12px; color: #4A5468; white-space: nowrap\"><b style=\"display: block; font-size: 13px; color: {{r.c2}}\">{{r.tag}}</b>{{r.right}}</span>\n   </a></sc-for></div>\n  </section>\n  <sc-if value=\"{{isOwner}}\"><section class=\"cp-card\">\n   <div style=\"display: flex; justify-content: space-between; align-items: baseline\"><b style=\"font-size: 17px\">Pengaturan server GPS</b><span style=\"font-size: 12px; color: #6B7486\">khusus owner</span></div>\n   <span style=\"font-size: 12.5px; line-height: 18px; color: #4A5468\">Alamat yang dimasukkan ke perintah SMS saat menyambungkan alat. Uji coba: host &amp; port channel flespi. Setelah lulus: domain server Traccar Rentalaja (port GT06 = 5023). URL &amp; token penerima data ada di menu Pengingat kendaraan.</span>\n   <div style=\"display: grid; grid-template-columns: 2fr 1fr; gap: 8px\">\n    <label style=\"display: flex; flex-direction: column; gap: 4px; font-size: 12px; font-weight: 700; color: #4A5468\">Host / domain<input class=\"cp-in\" type=\"text\" placeholder=\"gps.rentalaja.co.id\" value=\"{{sv.host}}\" onInput=\"{{sv.setHost}}\"></label>\n    <label style=\"display: flex; flex-direction: column; gap: 4px; font-size: 12px; font-weight: 700; color: #4A5468\">Port<input class=\"cp-in\" type=\"text\" inputmode=\"numeric\" value=\"{{sv.port}}\" onInput=\"{{sv.setPort}}\"></label>\n   </div>\n   <button type=\"button\" style=\"{{sv.syncStyle}}\" onClick=\"{{sv.toggleSync}}\">{{sv.syncLabel}}</button>\n   <span style=\"font-size: 12px; color: #6B7486\">Km otomatis memengaruhi pengingat ganti oli dan penguncian unit preventif. Nyalakan setelah km GPS terbukti cocok dengan odometer.</span>\n   <button type=\"button\" class=\"cp-btn\" onClick=\"{{sv.save}}\" disabled=\"{{busy}}\">Simpan pengaturan</button>\n  </section></sc-if>\n  </sc-if>\n </main>\n</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{\"$preview\":{\"width\":1100,\"height\":900}}'>\nclass Component extends DCLogic {\nstate = { d: null, br: '', tab: 'perlu', q: '', sv: null, at: null };\nasync componentDidMount() { await RA.staff(); this.load(); this._t = setInterval(() => { if (RA_ALIVE(this)) this.load(true); else clearInterval(this._t); }, 60000); }\ncomponentWillUnmount() { clearInterval(this._t); }\nasync load(quiet) {\n  try { const d = await RA.call('gps_fleet', { p_branch: this.state.br || null }); if (RA_ALIVE(this)) this.setState({ d, at: new Date(), sv: this.state.sv || Object.assign({ sync: !!d.sync_odo }, d.server || {}) }); }\n  catch (e) { if (!quiet) RA.err(e); }\n}\nmapOf(pins, rings) {\n  const W = 640, H = 360, ok = p => p && p.lat != null && p.lng != null && Math.abs(p.lat) > 0.01;\n  const all = pins.filter(ok).concat(rings.filter(ok)); if (!all.length) return null;\n  const X = (g, z) => (g + 180) / 360 * 256 * Math.pow(2, z);\n  const Y = (t, z) => { const s = Math.sin(t * Math.PI / 180); return (0.5 - Math.log((1 + s) / (1 - s)) / (4 * Math.PI)) * 256 * Math.pow(2, z); };\n  let z = 16;\n  for (; z > 4; z--) { const xs = all.map(p => X(p.lng, z)), ys = all.map(p => Y(p.lat, z)); if (Math.max(...xs) - Math.min(...xs) < W - 90 && Math.max(...ys) - Math.min(...ys) < H - 70) break; }\n  const xs = all.map(p => X(p.lng, z)), ys = all.map(p => Y(p.lat, z));\n  const x0 = (Math.max(...xs) + Math.min(...xs)) / 2 - W / 2, y0 = (Math.max(...ys) + Math.min(...ys)) / 2 - H / 2, n = Math.pow(2, z);\n  const pc = (v, t) => (v / t * 100).toFixed(3) + '%', tiles = [];\n  for (let tx = Math.floor(x0 / 256); tx <= Math.floor((x0 + W) / 256); tx++) for (let ty = Math.floor(y0 / 256); ty <= Math.floor((y0 + H) / 256); ty++) {\n    if (ty < 0 || ty >= n) continue;\n    tiles.push({ src: 'https://tile.openstreetmap.org/' + z + '/' + (((tx % n) + n) % n) + '/' + ty + '.png', style: 'left: ' + pc(tx * 256 - x0, W) + '; top: ' + pc(ty * 256 - y0, H) + '; width: ' + pc(256, W) + '; height: ' + pc(256, H) });\n  }\n  const mpp = 156543.03 * Math.cos(all[0].lat * Math.PI / 180) / n;\n  return { tiles,\n    pins: pins.filter(ok).map(p => Object.assign({}, p, { pos: 'left: ' + pc(X(p.lng, z) - x0, W) + '; top: ' + pc(Y(p.lat, z) - y0, H) + (p.top ? '; z-index: 2' : '') })),\n    rings: rings.filter(ok).map(r => { const d = 2 * r.m / mpp; return { style: 'position: absolute; border: 2px dashed #1F2B4D; background: rgba(31,43,77,.06); border-radius: 50%; transform: translate(-50%,-50%); left: ' + pc(X(r.lng, z) - x0, W) + '; top: ' + pc(Y(r.lat, z) - y0, H) + '; width: ' + pc(d, W) + '; aspect-ratio: 1' }; }) };\n}\nrenderVals() {\n  const s = this.state, d = s.d, me = RA._staff || {}, isOwner = me.role === 'owner';\n  const chip = on => 'flex: none; height: 36px; padding: 0 14px; border-radius: 18px; cursor: pointer; font: 800 13px \\'Plus Jakarta Sans\\', sans-serif; ' + (on ? 'border: 0; background: #1F2B4D; color: #FFFFFF' : 'border: 1.5px solid #E3E7ED; background: #FFFFFF; color: #1F2B4D');\n  const base = { scope: 'Aset · GPS live · ' + RA.HARIL[new Date().getDay()] + ', ' + RA.date(new Date()), reload: () => this.load(), q: s.q, setQ: e => this.setState({ q: e.target.value }), isOwner, busy: !!s.busy };\n  if (!d) return Object.assign(base, { loading: true, ready: false, brs: [], updated: '' });\n  const now = Date.now(), ago = x => { if (!x) return '—'; const m = Math.round((now - new Date(x)) / 60000); return m < 1 ? 'baru saja' : m < 60 ? m + ' mnt lalu' : m < 1440 ? Math.round(m / 60) + ' jam lalu' : Math.round(m / 1440) + ' hari lalu'; };\n  const geo = 0.5, U = d.units || [], K = d.kpi || {};\n  const st = u => { if (!u.connected) return 'none'; if (u.alert) return 'cek'; if (!u.online_at || now - new Date(u.online_at) > 30 * 60000) return 'off'; if (u.booking) return 'sewa'; return 'siap'; };\n  const COL = { siap: '#1E9E62', sewa: '#2F6FB5', cek: '#E06A1B', off: '#9AA3B2', none: '#D5DCE6' };\n  const brs = [{ id: '', name: 'Semua cabang' }].concat(d.branches || []).map(b => ({ label: b.name, style: chip((s.br || '') === b.id), pick: () => { this.setState({ br: b.id, d: null }); setTimeout(() => this.load(), 0); } }));\n  const gm = (la, lo) => la != null ? 'https://www.google.com/maps?q=' + la + ',' + lo : '';\n  const href = id => 'AsetGps.dc.html?id=' + id;\n  const pins = U.filter(u => u.connected && u.lat != null).map(u => { const k = st(u); return { lat: u.lat, lng: u.lng, c: COL[k], label: u.label, href: href(u.id), top: k === 'cek' }; });\n  const rings = (d.branches || []).filter(b => !s.br || b.id === s.br).map(b => ({ lat: b.lat, lng: b.lng, m: 500 }));\n  const conn = U.filter(u => u.connected).length;\n  const kpis = [\n    { l: 'Alat terhubung', v: (K.terhubung || 0) + ' / ' + (K.kendaraan || 0), s: (K.data_alat || 0) + ' sudah ada IMEI', c: '#1F2B4D' },\n    { l: 'Online (≤10 mnt)', v: String(K.online || 0), s: 'dari ' + (K.terhubung || 0) + ' terhubung', c: '#1E9E62' },\n    { l: 'Disewa & terpantau', v: String(K.disewa || 0), s: 'booking aktif', c: '#2F6FB5' },\n    { l: 'Siap di cabang', v: String(K.di_cabang || 0), s: 'dalam radius 500 m', c: '#1E9E62' },\n    { l: 'Peringatan aktif', v: String(K.peringatan || 0), s: 'keluar area / sinyal / telat', c: (K.peringatan || 0) ? '#C0392B' : '#1F2B4D' },\n    { l: 'Sinyal hilang', v: String(K.sinyal_hilang || 0), s: '> 30 menit', c: (K.sinyal_hilang || 0) ? '#9A5B00' : '#1F2B4D' },\n    { l: 'Km hari ini', v: Math.round(K.km_hari_ini || 0).toLocaleString('id-ID') + ' km', s: 'total armada terpantau', c: '#1F2B4D' },\n    { l: 'Belum tersambung', v: String((K.kendaraan || 0) - (K.terhubung || 0)), s: 'masih aplikasi lama / belum ada alat', c: '#4A5468' }];\n  const A = (d.alerts || []).slice(0, 40);\n  const alerts = A.map(a => ({ title: a.title, unit: a.label + ' · ' + (a.product || '') + (a.branch ? ' · ' + a.branch : ''), detail: a.detail || '', ago: ago(a.at), c: !a.open ? '#B4BCC8' : a.sev === 'tinggi' ? '#C0392B' : '#E06A1B',\n    open: a.open, state: a.open ? '' : a.handled_at ? 'Sudah dicek' + (a.note ? ': ' + a.note : '') : 'Selesai sendiri', href: href(a.unit_id), gmap: gm(a.lat, a.lng),\n    done: this.act(async () => { const note = window.prompt('Catatan pengecekan (opsional), mis. \"dibawa teknisi ke bengkel\"', '') ; if (note === null) return; await RA.call('gps_alert_done', { p_id: a.id, p_note: note }); RA.ok('Ditandai sudah dicek'); await this.load(); }) }));\n  const q = String(s.q || '').toLowerCase().replace(/\\s/g, '');\n  const pass = u => !q || [u.label, u.asset_no].join('|').toLowerCase().replace(/\\s/g, '').indexOf(q) > -1;\n  const groups = { perlu: u => st(u) === 'cek' || st(u) === 'off', sewa: u => st(u) === 'sewa', siap: u => st(u) === 'siap', belum: u => !u.connected, semua: () => true };\n  const cnt = k => U.filter(groups[k]).length;\n  const tabs = [['perlu', 'Perlu dicek'], ['sewa', 'Disewa'], ['siap', 'Siap'], ['belum', 'Belum tersambung'], ['semua', 'Semua']].map(([k, l]) => ({ label: l + ' ' + cnt(k), style: chip(s.tab === k), pick: () => this.setState({ tab: k }) }));\n  const TAG = { siap: 'Siap', sewa: 'Disewa', cek: 'Perlu dicek', off: 'Sinyal hilang', none: 'Belum tersambung' };\n  const rows = U.filter(groups[s.tab] || groups.semua).filter(pass).slice(0, 120).map(u => { const k = st(u);\n    const sub = !u.connected ? (u.branch || '—') + ' · ' + (u.provider ? 'GPS ' + u.provider + ', belum diarahkan ke server baru' : 'data alat GPS belum diisi')\n      : (u.alert ? u.alert.title + ' · ' : '') + (u.booking ? u.booking + (u.guest ? ' · ' + u.guest : '') + ' · ' : '') + (u.dist_km != null ? u.dist_km.toLocaleString('id-ID') + ' km dari cabang · ' : '') + (u.ign ? 'mesin hidup' : 'mesin mati') + (u.speed ? ' · ' + Math.round(u.speed) + ' km/jam' : '');\n    return { label: u.label, product: u.product || '', sub, href: href(u.id), c: COL[k], c2: k === 'cek' ? '#C0392B' : k === 'off' ? '#9A5B00' : '#1F2B4D', tag: TAG[k],\n      right: u.connected ? ago(u.online_at) + (u.km_today ? ' · ' + u.km_today + ' km' : '') : (u.branch || '') }; });\n  const sv = s.sv || {}, setSv = k => e => this.setState({ sv: Object.assign({}, sv, { [k]: e.target.value }) });\n  const banner = !d.server || !d.server.ok ? 'Server GPS belum diatur, jadi perintah SMS untuk menyambungkan alat belum bisa dibuat.' + (isOwner ? ' Isi host & port di Pengaturan server GPS (paling bawah).' : ' Minta owner mengisinya.') : conn === 0 ? 'Belum ada alat yang diarahkan ke server baru. Mulai uji coba dari halaman unit → GPS live → Sambungkan ke server baru.' : '';\n  return Object.assign(base, { loading: false, ready: true, brs, kpis, banner,\n    updated: 'Diperbarui ' + (s.at ? RA.time(s.at) : '') + ' · otomatis tiap 1 menit', map: this.mapOf(pins, rings),\n    alerts, noAlert: !A.some(a => a.open), alertSub: A.filter(a => a.open).length + ' aktif · 3 hari terakhir',\n    tabs, rows, noRows: rows.length ? '' : s.tab === 'perlu' ? '✓ Tidak ada unit yang perlu dicek.' : 'Tidak ada unit.',\n    sv: { host: sv.host || '', port: sv.port != null ? String(sv.port) : '', setHost: setSv('host'), setPort: setSv('port'),\n      syncLabel: (sv.sync ? '☑' : '☐') + ' Isi km odometer otomatis dari GPS', syncStyle: 'min-height: 44px; border-radius: 12px; text-align: left; padding: 0 12px; cursor: pointer; font: 800 13.5px \\'Plus Jakarta Sans\\', sans-serif; color: #1F2B4D; ' + (sv.sync ? 'border: 1.5px solid #077A70; background: #F2FBFA' : 'border: 1.5px solid #E3E7ED; background: #FFFFFF'),\n      toggleSync: () => this.setState({ sv: Object.assign({}, sv, { sync: !sv.sync }) }),\n      save: this.act(async () => { const port = parseInt(String(sv.port || '').replace(/\\D/g, ''), 10); await RA.call('gps_settings_save', { p: { server: { host: String(sv.host || '').trim(), port: port || 5023 }, sync_odometer: !!sv.sync } }); RA.ok('Pengaturan GPS disimpan'); await this.load(); }) } });\n}\n}\n</script>\n</body>\n</html>\n"}