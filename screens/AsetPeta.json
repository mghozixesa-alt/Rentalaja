{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Peta armada GPS</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0}\n.cp-card{background:#FFFFFF;border-radius:20px;box-shadow:0 2px 12px rgba(31,43,77,.06);padding:16px;display:flex;flex-direction:column;gap:10px}\n.cp-btn{height:44px;border:0;border-radius:12px;background:linear-gradient(135deg,#12B5A6,#077A70);color:#FFFFFF;font:800 14px 'Plus Jakarta Sans',sans-serif;cursor:pointer;display:flex;align-items:center;justify-content:center;text-decoration:none;padding:0 14px}\n.cp-btn2{height:40px;border:1.5px solid #E3E7ED;border-radius:12px;background:#FFFFFF;color:#1F2B4D;font:800 13px 'Plus Jakarta Sans',sans-serif;cursor:pointer;display:flex;align-items:center;justify-content:center;text-decoration:none;padding:0 12px;white-space:nowrap}\n.cp-in{height:44px;box-sizing:border-box;border:1.5px solid #E3E7ED;border-radius:12px;padding:0 12px;font:700 14px 'Plus Jakarta Sans',sans-serif;color:#1F2B4D;background:#FFFFFF;width:100%}\n.kp{background:#FFFFFF;border-radius:16px;padding:12px 14px;min-width:0;box-shadow:0 2px 12px rgba(31,43,77,.05);display:flex;flex-direction:column;gap:2px}\n.kp span{font-size:12px;color:#4A5468;font-weight:700}.kp b{font-size:24px;line-height:30px}.kp i{font-style:normal;font-size:11.5px;color:#6B7486}\n.map{position:relative;width:100%;aspect-ratio:16/9;border-radius:16px;overflow:hidden;background:#E8EDF3}\n.map img.t{position:absolute;display:block;max-width:none}\n.kgrid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px}\n@media(max-width:1000px){.kgrid{grid-template-columns:repeat(3,minmax(0,1fr))}}\n.kp.hi{background:linear-gradient(135deg,#12B5A6,#077A70)}.kp.hi span,.kp.hi i{color:#DDF6F2}\n.g4{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;align-items:start}.s2{grid-column:span 2}\n@media(max-width:1000px){.g4{grid-template-columns:repeat(2,minmax(0,1fr))}}\n@media(max-width:720px){.g4{grid-template-columns:minmax(0,1fr)}.s2{grid-column:auto}}\n.hd{display:flex;justify-content:space-between;align-items:baseline;gap:8px;flex-wrap:wrap}.hd b{font-size:16px}.hd span{font-size:12px;color:#6B7486}\n.seg{display:flex;gap:4px;background:#F1F3F6;border-radius:12px;padding:4px}.seg button{height:32px;border:0;border-radius:9px;padding:0 12px;font:800 12px 'Plus Jakarta Sans',sans-serif;cursor:pointer;background:transparent;color:#4A5468}.seg button.on{background:#FFFFFF;color:#1F2B4D;box-shadow:0 1px 3px rgba(0,0,0,.08)}\n.dgrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px 18px}@media(max-width:720px){.dgrid{grid-template-columns:minmax(0,1fr)}}\n.dl{display:flex;justify-content:space-between;gap:6px;font-size:12.5px}.bar{height:8px;border-radius:4px;background:#F1F3F6;overflow:hidden}.bar div{height:8px;border-radius:4px}\n.sm2{font-size:11.5px;color:#6B7486}\n.chips{display:flex;gap:8px;flex-wrap:wrap;font-size:12px}.chips span{background:#F4F6F9;border-radius:10px;padding:6px 10px}\n.jam{display:flex;align-items:flex-end;gap:4px;height:90px}.jam div{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;gap:3px;height:100%}.jam i{display:block;width:100%;background:#2F6FB5;border-radius:4px 4px 0 0}.jam span{font-size:10px;color:#6B7486}\n.kv{display:flex;justify-content:space-between;gap:8px;font-size:13px}\n.tiles{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.tiles div{border-radius:12px;padding:10px}.tiles b{font-size:20px}.tiles span{display:block;font-size:11.5px;color:#33405C}\n.li{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:7px 0;border-bottom:1px solid #EEF0F3;font-size:13px}.li:last-child{border-bottom:0}\n.tag{height:22px;padding:0 8px;border-radius:11px;font-size:11px;font-weight:800;display:inline-flex;align-items:center;white-space:nowrap}\n.bnav{display:none}\n@media(max-width:720px){.bnav{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));position:sticky;bottom:0;z-index:6;background:#FFFFFF;border-top:1px solid #E3E7ED;margin:0 -16px -28px;padding:6px 6px 12px}.bnav button{min-height:46px;border:0;background:none;font:800 12px 'Plus Jakarta Sans',sans-serif;color:#4A5468;cursor:pointer}}\n.pin{position:absolute;transform:translate(-50%,-50%);display:flex;align-items:center;gap:4px;border:0;background:none;padding:0;cursor:pointer;font:inherit;color:#1F2B4D;z-index:1}\n.pin s{min-width:16px;height:16px;border-radius:999px;border:3px solid #FFFFFF;box-shadow:0 1px 4px rgba(0,0,0,.35);display:flex;align-items:center;justify-content:center;text-decoration:none;color:#FFFFFF;font:800 11px 'Plus Jakarta Sans',sans-serif;box-sizing:content-box;padding:0 2px}\n.pin em{font-style:normal;background:#FFFFFF;border-radius:6px;padding:2px 6px;font-size:11px;font-weight:800;white-space:nowrap;box-shadow:0 1px 3px rgba(0,0,0,.2)}\n.pin s:empty{padding:0;width:16px;min-width:0}\n.pop{position:absolute;z-index:5;width:270px;max-width:80%;background:#FFFFFF;border-radius:14px;box-shadow:0 8px 28px rgba(31,43,77,.22);padding:10px 12px;display:flex;flex-direction:column;gap:6px;font-size:12.5px}\n.pop .it{display:flex;gap:8px;align-items:flex-start;padding:6px 0;border-bottom:1px solid #EEF0F3}.pop .it:last-child{border-bottom:0}\n.mapbar{position:absolute;left:10px;top:10px;z-index:3;background:rgba(255,255,255,.94);border-radius:10px;padding:6px 10px;font-size:12px;font-weight:800;box-shadow:0 1px 4px rgba(0,0,0,.12)}\n.sm{height:32px !important;font-size:12.5px !important;padding:0 10px !important;border-radius:10px !important}\n.row{display:flex;gap:10px;align-items:flex-start;padding:11px 0;border-bottom:1px solid #EEF0F3}\n.row:last-child{border-bottom:0}\n.dot{width:10px;height:10px;border-radius:50%;flex:none;margin-top:5px}\n.mapctl{position:absolute;right:10px;top:10px;z-index:3;display:flex;gap:4px;background:rgba(255,255,255,.94);border-radius:12px;padding:4px;box-shadow:0 1px 4px rgba(0,0,0,.14)}\n.mapctl button{height:30px;border:0;border-radius:9px;padding:0 10px;font:800 12px 'Plus Jakarta Sans',sans-serif;cursor:pointer;background:transparent;color:#4A5468;white-space:nowrap}\n.mapctl button.on{background:#1F2B4D;color:#FFFFFF}\n.lg{display:inline-flex;align-items:center;gap:6px}.lg i{width:10px;height:10px;border-radius:50%;display:inline-block;border:2px solid #FFFFFF;box-shadow:0 0 0 1px rgba(0,0,0,.15)}\n.outs{display:flex;gap:6px;flex-wrap:wrap;align-items:center;padding:6px 6px 0;font-size:12px;color:#4A5468}\n.outs a{display:inline-flex;align-items:center;gap:6px;height:30px;padding:0 10px;border-radius:15px;background:#F4F6F9;border:1px solid #E3E7ED;color:#1F2B4D;text-decoration:none;font-weight:800}\n.src{display:flex;align-items:center;gap:8px;flex-wrap:wrap;font-size:12.5px;color:#4A5468;margin-top:6px}\n.src b{display:inline-flex;align-items:center;gap:6px;height:26px;padding:0 10px;border-radius:13px;font-size:12px}\n.hist{border:0;background:none;padding:10px 0 2px;font:800 13px 'Plus Jakarta Sans',sans-serif;color:#077A70;cursor:pointer;text-align:left}\n@media(max-width:720px){.kp{padding:10px 12px}.kp i{display:none}.kp b{font-size:21px;line-height:26px}.map{aspect-ratio:4/3}.mapctl{left:10px;right:auto;top:auto;bottom:22px}.mapbar{font-size:11px}}\n</style>\n</helmet>\n<div style=\"min-height: 100vh; box-sizing: border-box; background: #F4F6F9; color: #1F2B4D; font-family: 'Plus Jakarta Sans', system-ui, sans-serif\">\n <main style=\"max-width: 1100px; margin: 0 auto; padding: 18px 16px 28px; display: flex; flex-direction: column; gap: 14px\">\n  <div style=\"display: flex; justify-content: space-between; align-items: flex-end; gap: 10px; flex-wrap: wrap\">\n   <div><div style=\"font-size: 13px; font-weight: 700; color: #5B6577\">{{scope}}</div><h1 style=\"margin: 2px 0 0; font-size: 26px; line-height: 32px\">Peta armada GPS</h1>\n    <div style=\"font-size: 13px; color: #4A5468; margin-top: 4px\">{{updated}}</div>\n    <sc-if value=\"{{src}}\"><div class=\"src\"><b style=\"background: {{src.bg}}; color: {{src.fg}}\">● {{src.label}}</b><span>{{src.sub}}</span></div></sc-if></div>\n   <button type=\"button\" class=\"cp-btn2\" onClick=\"{{reload}}\">↻ Muat ulang</button>\n  </div>\n  <div style=\"display: flex; gap: 6px; overflow-x: auto\"><sc-for list=\"{{brs}}\" as=\"t\"><button type=\"button\" onClick=\"{{t.pick}}\" style=\"{{t.style}}\">{{t.label}}</button></sc-for></div>\n  <sc-if value=\"{{loading}}\"><div class=\"cp-card\" style=\"text-align: center; color: #4A5468\">Memuat…</div></sc-if>\n  <sc-if value=\"{{ready}}\">\n  <sc-if value=\"{{syncWarn}}\"><div style=\"background: #FDECEA; color: #8E1F14; border-radius: 14px; padding: 12px 14px; font-size: 13.5px; line-height: 19px; font-weight: 700\">{{syncWarn}}</div></sc-if>\n  <sc-if value=\"{{banner}}\"><div style=\"background: #FFF6E5; color: #7A4B00; border-radius: 14px; padding: 12px 14px; font-size: 13.5px; line-height: 19px; font-weight: 700\">{{banner}}</div></sc-if>\n  <div class=\"kgrid\">\n   <sc-for list=\"{{kpis}}\" as=\"k\"><div class=\"{{k.cls}}\"><span>{{k.l}}</span><b style=\"color: {{k.c}}\">{{k.v}}</b><i>{{k.s}}</i></div></sc-for>\n  </div>\n  <div style=\"display: flex; flex-wrap: wrap; gap: 14px; align-items: flex-start\">\n   <section class=\"cp-card\" id=\"ra-peta\" style=\"flex: 999 1 520px; min-width: 0; padding: 12px\">\n    <div class=\"hd\" style=\"padding: 0 4px\"><b>{{mapTitle}}</b><div class=\"seg\"><sc-for list=\"{{modes}}\" as=\"m\"><button type=\"button\" class=\"{{m.cls}}\" onClick=\"{{m.pick}}\">{{m.label}}</button></sc-for></div></div>\n    <sc-if value=\"{{map}}\">\n     <div class=\"map\">\n      <sc-for list=\"{{map.tiles}}\" as=\"t\"><img class=\"t\" alt=\"\" src=\"{{t.src}}\" style=\"{{t.style}}\" loading=\"lazy\"></sc-for>\n      <sc-for list=\"{{map.rings}}\" as=\"r\"><div style=\"{{r.style}}\"></div><span style=\"{{r.lstyle}}\">{{r.name}}</span></sc-for>\n      <sc-for list=\"{{map.spots}}\" as=\"sp\"><div style=\"{{sp.style}}\"></div><span style=\"{{sp.lstyle}}\">{{sp.label}}</span></sc-for>\n      <sc-for list=\"{{map.pins}}\" as=\"p\"><button type=\"button\" class=\"pin\" style=\"{{p.pos}}\" onClick=\"{{p.pick}}\" aria-label=\"{{p.aria}}\"><s style=\"background: {{p.c}}\">{{p.n}}</s><sc-if value=\"{{p.label}}\"><em>{{p.label}}</em></sc-if></button></sc-for>\n      <div class=\"mapbar\">{{mapbar}}</div>\n      <sc-if value=\"{{views}}\"><div class=\"mapctl\"><sc-for list=\"{{views}}\" as=\"v\"><button type=\"button\" class=\"{{v.cls}}\" onClick=\"{{v.pick}}\">{{v.label}}</button></sc-for></div></sc-if>\n      <sc-if value=\"{{pop}}\"><div class=\"pop\" style=\"{{pop.pos}}\">\n       <div style=\"display: flex; justify-content: space-between; align-items: center\"><b style=\"font-size: 13.5px\">{{pop.title}}</b><button type=\"button\" onClick=\"{{pop.close}}\" aria-label=\"Tutup\" style=\"border: 0; background: #F1F3F6; border-radius: 8px; width: 28px; height: 28px; cursor: pointer; font-weight: 800\">×</button></div>\n       <div style=\"max-height: 230px; overflow-y: auto\"><sc-for list=\"{{pop.items}}\" as=\"i\"><div class=\"it\"><span class=\"dot\" style=\"background: {{i.c}}; margin-top: 4px\"></span>\n        <div style=\"flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px\"><b>{{i.label}} <span style=\"font-weight: 600; color: #6B7486\">· {{i.product}}</span></b><span style=\"color: #4A5468\">{{i.sub}}</span>\n        <div style=\"display: flex; gap: 6px; margin-top: 2px\"><a class=\"cp-btn2 sm\" href=\"{{i.href}}\">Lihat unit</a><sc-if value=\"{{i.gmap}}\"><a class=\"cp-btn2 sm\" href=\"{{i.gmap}}\" target=\"_blank\" rel=\"noopener\">Maps ↗</a></sc-if></div></div></div></sc-for></div>\n      </div></sc-if>\n      <span style=\"position: absolute; right: 6px; bottom: 4px; font-size: 10px; background: rgba(255,255,255,.85); padding: 1px 5px; border-radius: 4px\">© OpenStreetMap</span>\n     </div>\n    </sc-if>\n    <sc-if value=\"{{map}}\" not><div style=\"aspect-ratio: 16/9; border-radius: 16px; background: #EEF1F5; display: flex; align-items: center; justify-content: center; text-align: center; padding: 20px; box-sizing: border-box; color: #4A5468; font-size: 14px; font-weight: 700\">Belum ada unit yang mengirim posisi.<br>Sambungkan alat GPS dulu (daftar di bawah).</div></sc-if>\n    <div style=\"display: flex; flex-wrap: wrap; gap: 12px; font-size: 12px; padding: 4px 6px; color: #4A5468\">\n     <span class=\"lg\"><i style=\"background: #1E9E62\"></i>Siap</span><span class=\"lg\"><i style=\"background: #2F6FB5\"></i>Disewa</span><span class=\"lg\"><i style=\"background: #E06A1B\"></i>Perlu dicek</span><span class=\"lg\"><i style=\"background: #9AA3B2\"></i>Sinyal hilang &gt; 30 mnt</span><span class=\"lg\"><i style=\"background: rgba(18,181,166,.18); border: 2px dashed #077A70; box-shadow: none\"></i>Area cabang</span>\n    </div>\n    <sc-if value=\"{{outs}}\"><div class=\"outs\"><span style=\"font-weight: 800\">{{outs.title}}</span><sc-for list=\"{{outs.items}}\" as=\"o\"><a href=\"{{o.href}}\"><span class=\"dot\" style=\"background: {{o.c}}; margin: 0\"></span>{{o.label}} <span style=\"font-weight: 600; color: #6B7486\">{{o.sub}}</span></a></sc-for></div></sc-if>\n   </section>\n   <section class=\"cp-card\" id=\"ra-tindakan\" style=\"flex: 1 1 340px; min-width: 0; max-height: 640px; overflow-y: auto\">\n    <div style=\"display: flex; justify-content: space-between; align-items: center\"><b style=\"font-size: 17px\">Perlu tindakan</b><span style=\"font-size: 12px; color: #6B7486\">{{alertSub}}</span></div>\n    <sc-if value=\"{{noAlert}}\"><div style=\"color: #1E6B45; font-weight: 700; font-size: 14px; padding: 8px 0\">✓ Tidak ada peringatan aktif.</div></sc-if>\n    <div>\n    <sc-for list=\"{{alertsOpen}}\" as=\"a\"><div class=\"row\">\n     <span class=\"dot\" style=\"background: {{a.c}}\"></span>\n     <div style=\"flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px\">\n      <div style=\"display: flex; justify-content: space-between; gap: 8px\"><b style=\"font-size: 14px\">{{a.title}}</b><span style=\"font-size: 12px; color: #6B7486; white-space: nowrap\">{{a.ago}}</span></div>\n      <span style=\"font-size: 13px\">{{a.unit}}</span><span style=\"font-size: 12.5px; color: #4A5468\">{{a.detail}}</span>\n      <sc-if value=\"{{a.state}}\"><span style=\"font-size: 12px; color: #1E6B45; font-weight: 700\">{{a.state}}</span></sc-if>\n      <div style=\"display: flex; gap: 6px; flex-wrap: wrap; margin-top: 2px\"><a class=\"cp-btn2 sm\" href=\"{{a.href}}\">Lihat unit</a><sc-if value=\"{{a.gmap}}\"><a class=\"cp-btn2 sm\" href=\"{{a.gmap}}\" target=\"_blank\" rel=\"noopener\">Maps ↗</a></sc-if><sc-if value=\"{{a.open}}\"><button type=\"button\" class=\"cp-btn2 sm\" style=\"border-color: #077A70; color: #077A70\" onClick=\"{{a.done}}\">✓ Sudah dicek</button></sc-if></div>\n     </div>\n    </div></sc-for>\n    <sc-if value=\"{{histBtn}}\"><button type=\"button\" class=\"hist\" onClick=\"{{toggleHist}}\">{{histBtn}}</button></sc-if>\n    <sc-if value=\"{{showHist}}\">    <sc-for list=\"{{alertsHist}}\" as=\"a\"><div class=\"row\">\n     <span class=\"dot\" style=\"background: {{a.c}}\"></span>\n     <div style=\"flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px\">\n      <div style=\"display: flex; justify-content: space-between; gap: 8px\"><b style=\"font-size: 14px\">{{a.title}}</b><span style=\"font-size: 12px; color: #6B7486; white-space: nowrap\">{{a.ago}}</span></div>\n      <span style=\"font-size: 13px\">{{a.unit}}</span><span style=\"font-size: 12.5px; color: #4A5468\">{{a.detail}}</span>\n      <sc-if value=\"{{a.state}}\"><span style=\"font-size: 12px; color: #1E6B45; font-weight: 700\">{{a.state}}</span></sc-if>\n      <div style=\"display: flex; gap: 6px; flex-wrap: wrap; margin-top: 2px\"><a class=\"cp-btn2 sm\" href=\"{{a.href}}\">Lihat unit</a><sc-if value=\"{{a.gmap}}\"><a class=\"cp-btn2 sm\" href=\"{{a.gmap}}\" target=\"_blank\" rel=\"noopener\">Maps ↗</a></sc-if><sc-if value=\"{{a.open}}\"><button type=\"button\" class=\"cp-btn2 sm\" style=\"border-color: #077A70; color: #077A70\" onClick=\"{{a.done}}\">✓ Sudah dicek</button></sc-if></div>\n     </div>\n    </div></sc-for></sc-if>\n    </div>\n   </section>\n  </div>\n  <sc-if value=\"{{ins}}\">\n  <div class=\"g4\">\n   <section class=\"cp-card s2\" id=\"ra-tujuan\">\n    <div class=\"hd\"><b>Penyewa dibawa ke mana</b><span>{{tj.sub}}</span></div>\n    <sc-if value=\"{{tj.empty}}\"><div style=\"font-size: 13px; color: #4A5468; line-height: 19px\">{{tj.empty}}</div></sc-if>\n    <div class=\"dgrid\"><sc-for list=\"{{tj.items}}\" as=\"t\"><div style=\"display: flex; flex-direction: column; gap: 4px\"><div class=\"dl\"><span>{{t.place}}</span><b>{{t.pct}}</b></div><div class=\"bar\"><div style=\"{{t.bar}}\"></div></div><span class=\"sm2\">{{t.sub}}</span></div></sc-for></div>\n    <div class=\"chips\"><sc-for list=\"{{tj.chips}}\" as=\"c\"><span>{{c}}</span></sc-for></div>\n    <div style=\"display: flex; flex-direction: column; gap: 4px\"><span style=\"font-size: 12px; font-weight: 800; color: #4A5468\">Jam ambil unit · 30 hari</span>\n     <div class=\"jam\"><sc-for list=\"{{jam}}\" as=\"j\"><div><i style=\"{{j.style}}\"></i><span>{{j.h}}</span></div></sc-for></div></div>\n   </section>\n   <section class=\"cp-card\">\n    <div class=\"hd\"><b>Telat kembali</b><span>30 hari</span></div>\n    <div style=\"display: flex; flex-direction: column; gap: 7px\">\n     <div class=\"kv\"><span>Sewa kembali</span><b>{{ug.kembali}}</b></div>\n     <div class=\"kv\"><span>Telat &gt; 15 mnt</span><b>{{ug.telat}}</b></div>\n     <div class=\"kv\"><span>Didenda</span><b style=\"color: #1E7A4C\">{{ug.denda}}</b></div>\n     <div class=\"kv\"><span>Lolos tanpa denda</span><b style=\"color: #B03A2E\">{{ug.lolos}}</b></div>\n     <div class=\"kv\"><span>Jam telat tak didenda</span><b>{{ug.jamLolos}}</b></div>\n    </div>\n    <div class=\"bar\" style=\"display: flex; height: 10px\"><div style=\"{{ug.bar1}}\"></div><div style=\"{{ug.bar2}}\"></div></div>\n    <span class=\"sm2\">{{ug.rate}}</span>\n    <div><sc-for list=\"{{ug.list}}\" as=\"x\"><div class=\"li\"><span><b>{{x.label}}</b><br><span class=\"sm2\">{{x.code}} · {{x.branch}}</span></span><b style=\"color: #B03A2E; white-space: nowrap\">{{x.jam}}</b></div></sc-for></div>\n   </section>\n   <section class=\"cp-card\" id=\"ra-aki\">\n    <div class=\"hd\"><b>Kondisi aki</b><span>{{ak.sub}}</span></div>\n    <div class=\"tiles\"><sc-for list=\"{{ak.tiles}}\" as=\"t\"><div style=\"background: {{t.bg}}\"><b style=\"color: {{t.c}}\">{{t.v}}</b><span>{{t.l}}</span></div></sc-for></div>\n    <div><sc-for list=\"{{ak.rows}}\" as=\"r\"><a class=\"li\" href=\"{{r.href}}\" style=\"text-decoration: none; color: #1F2B4D\"><span><b>{{r.label}}</b><br><span class=\"sm2\">{{r.note}}</span></span><span style=\"text-align: right\"><b>{{r.v}}</b><br><span class=\"tag\" style=\"background: {{r.bg}}; color: {{r.c}}\">{{r.st}}</span></span></a></sc-for></div>\n    <span class=\"sm2\" style=\"line-height: 17px\">{{ak.note}}</span>\n   </section>\n  </div>\n  <div class=\"g4\">\n   <section class=\"cp-card s2\">\n    <div class=\"hd\"><b>Dipakai tanpa sewa</b><span>7 hari</span></div>\n    <div class=\"tiles\" style=\"grid-template-columns: repeat(2, minmax(0, 1fr))\"><div style=\"background: {{ts.bg}}\"><b style=\"color: {{ts.c}}\">{{ts.n}}</b><span>kejadian bergerak / di luar cabang tanpa booking</span></div><div style=\"background: #F4F6F9\"><b>{{ts.u}}</b><span>unit terlibat</span></div></div>\n    <div class=\"chips\"><sc-for list=\"{{ts.units}}\" as=\"c\"><span>{{c}}</span></sc-for></div>\n    <span class=\"sm2\" style=\"line-height: 17px\">Bisa berarti dipakai staf, disewakan di luar sistem, atau sekadar diparkir di tempat lain. Minta penjelasan PIC cabang lewat tombol di \"Perlu tindakan\".</span>\n   </section>\n   <section class=\"cp-card s2\">\n    <div class=\"hd\"><b>Aset &amp; biaya GPS</b><span>unit tidur · langganan boros</span></div>\n    <div class=\"g4\" style=\"grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px\">\n     <div style=\"display: flex; flex-direction: column; min-width: 0\"><span style=\"font-size: 12px; font-weight: 800; color: #4A5468\">{{as.tidurT}}</span>\n      <sc-for list=\"{{as.tidur}}\" as=\"t\"><div class=\"li\"><span><b>{{t.label}}</b> <span class=\"sm2\">· {{t.branch}}</span><br><span class=\"sm2\">{{t.hari}}</span></span></div></sc-for></div>\n     <div style=\"display: flex; flex-direction: column; gap: 7px; min-width: 0\">\n      <div class=\"kv\"><span>Alat GPS aktif tanpa unit</span><b style=\"color: #B03A2E\">{{as.tanpaUnit}}</b></div>\n      <div class=\"kv\"><span>Alat mati &gt; 30 hari</span><b>{{as.mati}}</b></div>\n      <div class=\"kv\"><span>Langganan menunggak</span><b>{{as.nunggak}}</b></div>\n      <div class=\"kv\"><span>Kendaraan tanpa GPS</span><b>{{as.tanpaGps}}</b></div>\n      <span class=\"sm2\" style=\"line-height: 17px\">{{as.names}}</span>\n     </div>\n    </div>\n   </section>\n  </div>\n  </sc-if>\n  <section class=\"cp-card\">\n   <div style=\"display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap\"><b style=\"font-size: 17px\">Unit kendaraan</b>\n    <div style=\"display: flex; gap: 6px; overflow-x: auto\"><sc-for list=\"{{tabs}}\" as=\"t\"><button type=\"button\" onClick=\"{{t.pick}}\" style=\"{{t.style}}\">{{t.label}}</button></sc-for></div></div>\n   <input class=\"cp-in\" type=\"search\" placeholder=\"Cari plat / kode aset\" value=\"{{q}}\" onInput=\"{{setQ}}\">\n   <sc-if value=\"{{noRows}}\"><div style=\"color: #4A5468; font-size: 14px; padding: 8px 0\">{{noRows}}</div></sc-if>\n   <div><sc-for list=\"{{rows}}\" as=\"r\"><a class=\"row\" href=\"{{r.href}}\" style=\"text-decoration: none; color: #1F2B4D\">\n    <span class=\"dot\" style=\"background: {{r.c}}\"></span>\n    <span style=\"flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px\"><b style=\"font-size: 14px\">{{r.label}} <span style=\"font-weight: 600; color: #6B7486\">· {{r.product}}</span></b><span style=\"font-size: 12.5px; color: #4A5468\">{{r.sub}}</span></span>\n    <span style=\"text-align: right; font-size: 12px; color: #4A5468; white-space: nowrap\"><b style=\"display: block; font-size: 13px; color: {{r.c2}}\">{{r.tag}}</b>{{r.right}}</span>\n   </a></sc-for></div>\n  </section>\n  <sc-if value=\"{{isOwner}}\"><section class=\"cp-card\">\n   <div style=\"display: flex; justify-content: space-between; align-items: baseline\"><b style=\"font-size: 17px\">Pengaturan server GPS</b><span style=\"font-size: 12px; color: #6B7486\">khusus owner</span></div>\n   <span style=\"font-size: 12.5px; line-height: 18px; color: #4A5468\">Alamat yang dimasukkan ke perintah SMS saat menyambungkan alat. Uji coba: host &amp; port channel flespi. Setelah lulus: domain server Traccar Rentalaja (port GT06 = 5023). URL &amp; token penerima data ada di menu Pengingat kendaraan.</span>\n   <div style=\"display: grid; grid-template-columns: 2fr 1fr; gap: 8px\">\n    <label style=\"display: flex; flex-direction: column; gap: 4px; font-size: 12px; font-weight: 700; color: #4A5468\">Host / domain<input class=\"cp-in\" type=\"text\" placeholder=\"gps.rentalaja.co.id\" value=\"{{sv.host}}\" onInput=\"{{sv.setHost}}\"></label>\n    <label style=\"display: flex; flex-direction: column; gap: 4px; font-size: 12px; font-weight: 700; color: #4A5468\">Port<input class=\"cp-in\" type=\"text\" inputmode=\"numeric\" value=\"{{sv.port}}\" onInput=\"{{sv.setPort}}\"></label>\n   </div>\n   <label style=\"display: flex; flex-direction: column; gap: 4px; font-size: 12px; font-weight: 700; color: #4A5468\">Denda telat per jam (kosong = rata-rata yang biasa dikenakan kasir)<input class=\"cp-in\" type=\"text\" inputmode=\"numeric\" placeholder=\"{{sv.ratePh}}\" value=\"{{sv.rate}}\" onInput=\"{{sv.setRate}}\"></label>\n   <button type=\"button\" style=\"{{sv.syncStyle}}\" onClick=\"{{sv.toggleSync}}\">{{sv.syncLabel}}</button>\n   <span style=\"font-size: 12px; color: #6B7486\">Km otomatis memengaruhi pengingat ganti oli dan penguncian unit preventif. Nyalakan setelah km GPS terbukti cocok dengan odometer.</span>\n   <button type=\"button\" class=\"cp-btn\" onClick=\"{{sv.save}}\" disabled=\"{{busy}}\">Simpan pengaturan</button>\n  </section></sc-if>\n  </sc-if>\n <sc-if value=\"{{ready}}\"><nav class=\"bnav\" aria-label=\"Lompat ke bagian\"><sc-for list=\"{{jumps}}\" as=\"j\"><button type=\"button\" onClick=\"{{j.go}}\">{{j.label}}</button></sc-for></nav></sc-if>\n </main>\n</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{\"$preview\":{\"width\":1100,\"height\":900}}'>\nclass Component extends DCLogic {\nstate = { d: null, br: '', tab: 'perlu', q: '', sv: null, at: null, sel: null, view: '', hist: false, sync: null, ins: null, mode: 'pos' };\nasync componentDidMount() { await RA.staff(); this.load(); this._t = setInterval(() => { if (RA_ALIVE(this)) this.load(true); else clearInterval(this._t); }, 60000); }\ncomponentWillUnmount() { clearInterval(this._t); }\nasync load(quiet) {\n  try { const [d, sync, ins] = await Promise.all([RA.call('gps_fleet', { p_branch: this.state.br || null }), RA.call('gps_sync_status').catch(() => null), RA.call('gps_insight', { p_branch: this.state.br || null }).catch(() => null)]);\n    if (RA_ALIVE(this)) this.setState({ d, sync, ins, at: new Date(), sv: this.state.sv || Object.assign({ sync: !!d.sync_odo, rate: ins && ins.uang && ins.uang.rate_src === 'aturan' ? ins.uang.rate : '' }, d.server || {}) }); }\n  catch (e) { if (!quiet) RA.err(e); }\n}\nmapOf(pins, rings, spots) {\n  spots = spots || [];\n  const W = 640, H = 360, ok = p => p && p.lat != null && p.lng != null && Math.abs(p.lat) > 0.01;\n  const all = pins.filter(ok).concat(rings.filter(ok), spots.filter(ok)); if (!all.length) return null;\n  const X = (g, z) => (g + 180) / 360 * 256 * Math.pow(2, z);\n  const Y = (t, z) => { const s = Math.sin(t * Math.PI / 180); return (0.5 - Math.log((1 + s) / (1 - s)) / (4 * Math.PI)) * 256 * Math.pow(2, z); };\n  let z = 16;\n  for (; z > 4; z--) { const xs = all.map(p => X(p.lng, z)), ys = all.map(p => Y(p.lat, z)); if (Math.max(...xs) - Math.min(...xs) < W - 90 && Math.max(...ys) - Math.min(...ys) < H - 70) break; }\n  const xs = all.map(p => X(p.lng, z)), ys = all.map(p => Y(p.lat, z));\n  const x0 = (Math.max(...xs) + Math.min(...xs)) / 2 - W / 2, y0 = (Math.max(...ys) + Math.min(...ys)) / 2 - H / 2, n = Math.pow(2, z);\n  const pc = (v, t) => (v / t * 100).toFixed(3) + '%', tiles = [];\n  for (let tx = Math.floor(x0 / 256); tx <= Math.floor((x0 + W) / 256); tx++) for (let ty = Math.floor(y0 / 256); ty <= Math.floor((y0 + H) / 256); ty++) {\n    if (ty < 0 || ty >= n) continue;\n    tiles.push({ src: 'https://tile.openstreetmap.org/' + z + '/' + (((tx % n) + n) % n) + '/' + ty + '.png', style: 'left: ' + pc(tx * 256 - x0, W) + '; top: ' + pc(ty * 256 - y0, H) + '; width: ' + pc(256, W) + '; height: ' + pc(256, H) });\n  }\n  const mpp = 156543.03 * Math.cos(all[0].lat * Math.PI / 180) / n;\n  const mx = Math.max(1, ...spots.map(p => p.n || 1));\n  return { tiles,\n    spots: spots.filter(ok).map(p => { const d = 22 + Math.round(34 * (p.n || 1) / mx), cx = X(p.lng, z) - x0, cy = Y(p.lat, z) - y0;\n      return { label: p.label, style: 'position: absolute; border-radius: 50%; transform: translate(-50%,-50%); background: rgba(224,106,27,.30); border: 2px solid rgba(224,106,27,.75); left: ' + pc(cx, W) + '; top: ' + pc(cy, H) + '; width: ' + d + 'px; height: ' + d + 'px',\n        lstyle: 'position: absolute; transform: translate(-50%, 0); left: ' + pc(cx, W) + '; top: calc(' + pc(cy, H) + ' + ' + Math.round(d / 2 + 2) + 'px); font-size: 10.5px; font-weight: 800; color: #8A3B00; background: rgba(255,255,255,.9); padding: 0 5px; border-radius: 5px; white-space: nowrap; z-index: 2' }; }),\n    pins: (() => { const cl = []; pins.filter(ok).forEach(p => { const x = X(p.lng, z) - x0, y = Y(p.lat, z) - y0; const c = cl.find(q => Math.hypot(q.x - x, q.y - y) < 26); if (c) { c.m.push(p); c.x = (c.x * (c.m.length - 1) + x) / c.m.length; c.y = (c.y * (c.m.length - 1) + y) / c.m.length; } else cl.push({ x, y, m: [p] }); });\n      return cl.map(c => ({ m: c.m, xp: c.x / W, pos: 'left: ' + pc(c.x, W) + '; top: ' + pc(c.y, H) + (c.m.some(p => p.top) ? '; z-index: 2' : ''), yp: c.y / H })); })(),\n    rings: (() => { const placed = []; return rings.filter(ok).map(r => { const real = 2 * r.m / mpp, d = Math.max(real, 26), cx = X(r.lng, z) - x0, cy = Y(r.lat, z) - y0;\n      const near = placed.find(q => Math.hypot(q.x - cx, q.y - cy) < 70); let name = r.name || '';\n      if (real < 20) name = ''; else if (near) { near.o.name += ' · ' + name.split(/\\s*·\\s*/).pop(); name = ''; }\n      const o = { name, style: 'position: absolute; border: 2px dashed #077A70; background: rgba(18,181,166,.10); border-radius: 50%; transform: translate(-50%,-50%); left: ' + pc(cx, W) + '; top: ' + pc(cy, H) + '; width: ' + pc(d, W) + '; aspect-ratio: 1', lstyle: 'position: absolute; transform: translate(-50%, 0); left: ' + pc(cx, W) + '; top: calc(' + pc(cy, H) + ' - ' + Math.round(d / 2 + 18) + 'px); z-index: 0; font-size: 10.5px; font-weight: 800; color: #077A70; background: rgba(255,255,255,.85); padding: 0 5px; border-radius: 5px; white-space: nowrap' }; if (o.name) placed.push({ x: cx, y: cy, o }); return o; }); })() };\n}\nrenderVals() {\n  const s = this.state, d = s.d, me = RA._staff || {}, isOwner = me.role === 'owner';\n  const chip = on => 'flex: none; height: 36px; padding: 0 14px; border-radius: 18px; cursor: pointer; font: 800 13px \\'Plus Jakarta Sans\\', sans-serif; ' + (on ? 'border: 0; background: #1F2B4D; color: #FFFFFF' : 'border: 1.5px solid #E3E7ED; background: #FFFFFF; color: #1F2B4D');\n  const base = { scope: 'Aset · GPS live · ' + RA.HARIL[new Date().getDay()] + ', ' + RA.date(new Date()), reload: () => this.load(), q: s.q, setQ: e => this.setState({ q: e.target.value }), isOwner, busy: !!s.busy };\n  if (!d) return Object.assign(base, { loading: true, ready: false, brs: [], updated: '' });\n  const now = Date.now(), ago = x => { if (!x) return '—'; const m = Math.round((now - new Date(x)) / 60000); return m < 1 ? 'baru saja' : m < 60 ? m + ' mnt lalu' : m < 1440 ? Math.round(m / 60) + ' jam lalu' : Math.round(m / 1440) + ' hari lalu'; };\n  const geo = 0.5, U = d.units || [], K = d.kpi || {};\n  const st = u => { if (!u.connected) return 'none'; if (u.alert) return 'cek'; if (!u.online_at || now - new Date(u.online_at) > 30 * 60000) return 'off'; if (u.booking) return 'sewa'; return 'siap'; };\n  const COL = { siap: '#1E9E62', sewa: '#2F6FB5', cek: '#E06A1B', off: '#9AA3B2', none: '#D5DCE6' };\n  const brs = [{ id: '', name: 'Semua cabang' }].concat(d.branches || []).map(b => ({ label: b.name, style: chip((s.br || '') === b.id), pick: () => { this.setState({ br: b.id, d: null, sel: null, view: '' }); setTimeout(() => this.load(), 0); } }));\n  const gm = (la, lo) => la != null ? 'https://www.google.com/maps?q=' + la + ',' + lo : '';\n  const href = id => 'AsetGps.dc.html?id=' + id;\n  const RANK = { cek: 4, off: 3, sewa: 2, siap: 1 };\n  const pins = U.filter(u => u.connected && u.lat != null).map(u => { const k = st(u); return { lat: u.lat, lng: u.lng, k, u, top: k === 'cek' }; });\n  const rings = (d.branches || []).filter(b => !s.br || b.id === s.br).map(b => ({ lat: b.lat, lng: b.lng, m: 500, name: b.name }));\n  const conn = U.filter(u => u.connected).length;\n  const SY = s.sync || null;\n  const lastOk = SY && SY.last_ok ? new Date(SY.last_ok) : null, errAt = SY && SY.last_err ? new Date(SY.last_err.at) : null;\n  const syncBad = SY && SY.micodus > 0 && (!lastOk || now - lastOk > 30 * 60000 || (errAt && errAt > lastOk));\n  const src = SY && (SY.micodus || SY.own) ? { label: (SY.micodus ? 'MiCODUS ' + SY.micodus + ' unit' : '') + (SY.micodus && SY.own ? ' · ' : '') + (SY.own ? 'Server sendiri ' + SY.own + ' unit' : ''),\n    sub: SY.micodus ? 'posisi diambil dari MiCODUS tiap 10 menit' + (lastOk ? ' · terakhir ' + RA.time(lastOk) + ' (' + ago(lastOk) + ')' : '') : 'langsung dari alat',\n    bg: syncBad ? '#FDECEA' : '#E7F6EE', fg: syncBad ? '#8E1F14' : '#1E6B45' } : null;\n  const syncWarn = syncBad ? 'Sinkron MiCODUS bermasalah' + (errAt && (!lastOk || errAt > lastOk) ? ' sejak ' + RA.time(errAt) + ': ' + (SY.last_err.note || '') : ' — data terakhir ' + (lastOk ? ago(lastOk) : 'belum ada')) + '. Posisi di peta mungkin sudah lama.' : '';\n  const noVolt = SY && !SY.volt;\n  const I = s.ins || null, tjTop = I && I.tujuan ? (I.tujuan.top || []) : [];\n  const spotsAll = tjTop.filter(t => t.lat != null).map(t => ({ lat: t.lat, lng: t.lng, n: t.n, label: String(t.place).split(' · ')[0] + ' · ' + t.n }));\n  const tjMode = s.mode === 'tujuan';\n  const rp = n => 'Rp ' + Math.round(n || 0).toLocaleString('id-ID');\n  const rpS = n => (n || 0) >= 1e6 ? 'Rp ' + (Math.round(n / 1e5) / 10).toLocaleString('id-ID') + ' jt' : rp(n);\n  const UG = (I && I.uang) || {}, AK = (I && I.aki) || {}, CFG = AK.cfg || {};\n  const akiOf = u => { const r = u.s || {}, rest = r.rest != null ? +r.rest : +u.v, run = r.run != null ? +r.run : null;\n    if (r.cut_at) return ['Kabel diputus', '#FDF1EF', '#8E1F14', 'cek kabel GPS / aki di unit'];\n    if (rest < (CFG.kritis || 11.5)) return ['Kritis', '#FDF1EF', '#8E1F14', 'jangan disewakan · ganti aki'];\n    if (rest < (CFG.lemah || 12)) return ['Lemah', '#FFF4E5', '#8A4B00', 'cas dulu sebelum disewakan'];\n    if (run != null && run < (CFG.isi_min || 12.9)) return ['Ngecas kurang', '#FDF1EF', '#8E1F14', 'cek kiprok / spul'];\n    return ['Sehat', '#E7F6EE', '#1E6B45', 'normal']; };\n  const akRows = (AK.units || []).map(u => { const k = akiOf(u); return { label: u.label, v: (+u.v).toLocaleString('id-ID', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + ' V', st: k[0], bg: k[1], c: k[2], note: (u.branch || '') + ' · ' + k[3], href: 'AsetGps.dc.html?id=' + u.id, bad: k[0] !== 'Sehat' }; })\n    .sort((a, b) => (b.bad ? 1 : 0) - (a.bad ? 1 : 0));\n  const akBad = akRows.filter(r => r.bad).length + (AK.alerts || []).filter(a => !akRows.some(r => r.bad && r.label === a.label)).length;\n  const nOpen = (d.alerts || []).filter(a => a.open).length;\n  const kpis = [\n    { cls: 'kp', l: 'Terpantau GPS', v: (K.terhubung || 0) + ' / ' + (K.kendaraan || 0), s: U.filter(u => u.connected && u.online_at && now - new Date(u.online_at) < 15 * 60000).length + ' online ≤ 15 mnt', c: '#1F2B4D' },\n    { cls: 'kp', l: 'Disewa', v: String(K.disewa || 0), s: 'sedang di jalan', c: '#2F6FB5' },\n    { cls: 'kp', l: 'Siap di cabang', v: String(K.di_cabang || 0), s: 'dalam radius 500 m', c: '#1E7A4C' },\n    { cls: 'kp', l: 'Perlu dicek', v: String(nOpen), s: (K.sinyal_hilang || 0) + ' sinyal hilang', c: nOpen ? '#B03A2E' : '#1F2B4D' },\n    { cls: 'kp', l: 'Aki bermasalah', v: AK.ada_data ? String(akBad) : '—', s: AK.ada_data ? 'dari ' + AK.ada_data + ' terpantau tegangan' : 'belum ada data tegangan', c: akBad ? '#8A4B00' : '#1F2B4D' },\n    { cls: 'kp hi', l: 'Telat tanpa denda', v: (UG.telat_tanpa || 0) + ' sewa', s: '30 hari · ± ' + rpS(UG.belum), c: '#FFFFFF' }];\n  const TAGS = { siap: 'Siap di cabang', sewa: 'Disewa', cek: 'Perlu dicek', off: 'Sinyal hilang' };\n  // Wilayah: cabang yang berdekatan (< 20 km) digabung, mis. Bandung Hub + Jackal, Garut Kota + Wanaraja\n  const km = (a, b) => { const r = Math.PI / 180, x = Math.sin((b.lat - a.lat) * r / 2) ** 2 + Math.cos(a.lat * r) * Math.cos(b.lat * r) * Math.sin((b.lng - a.lng) * r / 2) ** 2; return 12742 * Math.as