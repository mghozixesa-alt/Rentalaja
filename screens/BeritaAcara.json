{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Berita acara</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0}\n.ba-row{display:flex;justify-content:space-between;gap:12px;padding:9px 0;border-bottom:1px solid #EEF0F3;font-size:14px}\n.ba-row:last-child{border-bottom:0}\n.ba-row span{color:#5B6577}\n.ba-row b{text-align:right;color:#1F2B4D}\n</style>\n</helmet>\n<div style=\"min-height: 100vh; box-sizing: border-box; background: #F4F6F9; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; color: #1F2B4D; padding-bottom: 40px\">\n <div style=\"max-width: 560px; margin: 0 auto\">\n  <div style=\"background: linear-gradient(160deg, #09BEAF, #077A70); padding: 20px 16px 22px; color: #FFFFFF\">\n    <div style=\"display: flex; align-items: center; justify-content: space-between\">\n      <span style=\"background: #FFFFFF; border-radius: 10px; padding: 6px 10px; display: inline-flex\"><img src=\"/img/email/logo-rentalaja.png\" alt=\"Rentalaja\" style=\"height: 22px\"></span>\n      <sc-if value=\"{{d}}\"><span style=\"background: #FFFFFF; color: #077A70; font-size: 12px; font-weight: 800; border-radius: 99px; padding: 5px 12px\">{{badge}}</span></sc-if>\n    </div>\n    <h1 style=\"margin: 16px 0 0; font-size: 22px; line-height: 28px; font-weight: 800\">{{title}}</h1>\n    <sc-if value=\"{{d}}\"><div style=\"font-size: 13.5px; color: #DDF7F3; margin-top: 4px\">Kode booking <b style=\"color: #FFFFFF\">{{code}}</b> · {{branch}}</div></sc-if>\n  </div>\n\n  <sc-if value=\"{{msg}}\"><div style=\"margin: 20px 16px 0; font-size: 15px; line-height: 22px; color: #4A5468\">{{msg}}</div></sc-if>\n\n  <sc-if value=\"{{d}}\">\n  <div style=\"padding: 16px; display: flex; flex-direction: column; gap: 14px\">\n    <div style=\"font-size: 15px; line-height: 22px\">{{intro}}</div>\n    <sc-for list=\"{{cards}}\" as=\"c\" hint-placeholder-count=\"3\">\n      <section style=\"background: #FFFFFF; border: 1px solid #E3E7ED; border-radius: 16px; padding: 14px 16px\">\n        <div style=\"font-size: 15px; font-weight: 800; margin-bottom: 4px\">{{c.title}}</div>\n        <sc-for list=\"{{c.rows}}\" as=\"r\"><div class=\"ba-row\"><span>{{r.k}}</span><b style=\"{{r.st}}\">{{r.v}}</b></div></sc-for>\n        <sc-if value=\"{{c.hasPh}}\">\n          <div style=\"display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin-top: 10px\">\n            <sc-for list=\"{{c.photos}}\" as=\"p\"><a href=\"{{p}}\" target=\"_blank\" rel=\"noopener\"><img src=\"{{p}}\" alt=\"Foto unit\" style=\"width: 100%; height: 130px; object-fit: cover; border-radius: 10px; background: #DDE3EA; display: block\"></a></sc-for>\n          </div>\n          <div style=\"font-size: 12px; color: #5B6577; margin-top: 6px\">Ketuk foto untuk memperbesar. Foto bisa dibuka selama 30 hari.</div>\n        </sc-if>\n      </section>\n    </sc-for>\n    <sc-if value=\"{{noteTxt}}\"><div style=\"{{noteSt}}\">{{noteTxt}}</div></sc-if>\n    <div style=\"display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px\">\n      <a href=\"{{waHref}}\" style=\"height: 48px; border-radius: 12px; border: 1.5px solid #1F2B4D; color: #1F2B4D; display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 800; text-decoration: none\">Chat CS</a>\n      <a href=\"{{ctaHref}}\" style=\"height: 48px; border-radius: 12px; background: #077A70; color: #FFFFFF; display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 800; text-decoration: none\">{{ctaTxt}}</a>\n    </div>\n    <div style=\"font-size: 12px; line-height: 18px; color: #8A94A3; text-align: center\">Halaman ini bukti {{what}} dari Rentalaja. Simpan link-nya sampai sewa selesai.<br>{{addr}}</div>\n  </div>\n  </sc-if>\n </div>\n</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{\"$preview\":{\"width\":390,\"height\":1200}}'>\nclass Component extends DCLogic {\nstate = { d: null, msg: 'Memuat berita acara…' };\nasync componentDidMount() {\n  const p = this.params || {};\n  if (!p.id || !p.t) { this.setState({ msg: 'Link berita acara tidak lengkap. Buka lagi dari pesan WhatsApp atau email dari Rentalaja.' }); return; }\n  try {\n    const C = window.RA_CONFIG || {};\n    const r = await fetch(C.url + '/functions/v1/ra-mail?id=' + encodeURIComponent(p.id) + '&t=' + encodeURIComponent(p.t), { headers: { apikey: C.key } });\n    const j = await r.json().catch(() => ({}));\n    if (!RA_ALIVE(this)) return;\n    if (!j || !j.ok) { this.setState({ msg: 'Berita acara tidak ditemukan atau link-nya sudah tidak berlaku. Chat CS Rentalaja kalau butuh salinannya.' }); return; }\n    this.setState({ d: j.ba, msg: '' });\n  } catch (e) { if (RA_ALIVE(this)) this.setState({ msg: 'Gagal memuat. Periksa koneksi lalu buka ulang link-nya.' }); }\n}\nrenderVals() {\n  const s = this.state, d = s.d;\n  if (!d) return { d: false, msg: s.msg, title: 'Berita acara', cards: [] };\n  const H = ['Min', 'Sen', 'Sel', 'Rab', 'Kam', 'Jum', 'Sab'], B = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];\n  const wib = x => { if (!x) return '-'; const t = new Date(new Date(x).getTime() + 7 * 3600e3); const q = n => String(n).padStart(2, '0'); return H[t.getUTCDay()] + ' ' + t.getUTCDate() + ' ' + B[t.getUTCMonth()] + ' ' + t.getUTCFullYear() + ', ' + q(t.getUTCHours()) + '.' + q(t.getUTCMinutes()); };\n  const rp = n => 'Rp' + Math.round(+n || 0).toLocaleString('id-ID');\n  const km = n => n == null || n === '' ? null : Math.round(+n).toLocaleString('id-ID') + ' km';\n  const FU = { full: 'Penuh' }; const fu = f => f ? (FU[f] || f) : '-';\n  const R = (k, v, st) => ({ k, v: v == null ? '-' : String(v), st: st || '' });\n  const items = (d.items || []).map(i => i.product + (i.plate ? ' (' + i.plate + ')' : '')).join(', ') || '-';\n  const out = d.out || {}, inn = d.in || {}, isOut = d.kind === 'out';\n  const cards = [];\n  const motor = (d.items || []).some(i => i.category === 'motor' || i.category === 'mobil');\n  let noteTxt = '', noteSt = '';\n  if (isOut) {\n    const sisa = +d.total - +d.paid;\n    cards.push({ title: 'Yang disewa', rows: [R('Barang', items), R('Diambil', wib(d.actual_start_at || out.at)), R('Kembali paling lambat', wib(d.end_at), 'font-weight: 800; color: #9B2C20')], photos: [], hasPh: false });\n    const cr = []; if (km(out.km)) cr.push(R('Kilometer', km(out.km))); if (out.fuel) cr.push(R('Bensin', fu(out.fuel))); if (out.damage_note) cr.push(R('Catatan', out.damage_note));\n    if (cr.length || (d.photos_out || []).length) cards.push({ title: 'Kondisi saat diserahkan', rows: cr, photos: d.photos_out || [], hasPh: (d.photos_out || []).length > 0 });\n    cards.push({ title: 'Pembayaran', rows: [R('Total sewa', rp(d.total)), R('Sudah dibayar', rp(d.paid), 'color: #1E7A3F'), R('Sisa', sisa > 0 ? rp(sisa) : 'Rp0 · Lunas', 'font-weight: 800')], photos: [], hasPh: false });\n    noteTxt = 'Kembalikan paling lambat ' + wib(d.end_at) + '. ' + (d.late_pp ? 'Telat dikenakan ' + rp(d.late_pp) + ' per jam. ' : 'Telat dikenakan denda per jam. ') + (motor ? 'Kendaraan hanya dipakai di dalam ' + (/bandung/i.test((d.branch || {}).name || '') ? 'Kota Bandung' : 'Kabupaten Garut') + '. ' : '') + (out.ktp_held ? 'KTP asli disimpan di cabang dan dikembalikan saat unit kembali. ' : '') + 'Ada kendala di jalan? Langsung chat CS, jangan diperbaiki sendiri.';\n    noteSt = 'background: #FFF6E5; color: #6B4300; border-radius: 14px; padding: 14px 16px; font-size: 13.5px; line-height: 20px';\n  } else {\n    const tot = +d.late_fee + +d.damage_fee, bal = +d.total + tot - +d.paid, lm = +inn.late_minutes || 0;\n    cards.push({ title: 'Yang dikembalikan', rows: [R('Barang', items), R('Jadwal kembali', wib(d.end_at)), R('Dikembalikan', wib(d.actual_end_at || inn.at), 'font-weight: 800')], photos: [], hasPh: false });\n    const cr = []; if (km(out.km) || km(inn.km)) cr.push(R('Kilometer', (km(out.km) || '-') + ' → ' + (km(inn.km) || '-'))); if (out.fuel || inn.fuel) cr.push(R('Bensin', fu(out.fuel) + ' → ' + fu(inn.fuel))); cr.push(R('Kerusakan', inn.damage_note || 'Tidak ada'));\n    cards.push({ title: 'Kondisi saat kembali', rows: cr, photos: d.photos_in || [], hasPh: (d.photos_in || []).length > 0 });\n    const tr = [lm > 0 ? R('Keterlambatan (' + Math.floor(lm / 60) + ' jam ' + (lm % 60) + ' mnt)', rp(d.late_fee)) : R('Keterlambatan', 'Tepat waktu'), R('Kerusakan', rp(d.damage_fee)), R('Total tambahan', rp(tot), 'font-weight: 800')];\n    if (d.pay_method) tr.push(R('Dibayar lewat', d.pay_method));\n    tr.push(R('Status', bal <= 0 ? 'Lunas' : 'Belum lunas · sisa ' + rp(bal), 'font-weight: 800; color: ' + (bal <= 0 ? '#1E7A3F' : '#B42318')));\n    cards.push({ title: 'Rincian tagihan akhir', rows: tr, photos: [], hasPh: false });\n    noteTxt = (inn.ktp_returned ? 'KTP asli sudah dikembalikan. ' : '') + 'Terima kasih sudah sewa di Rentalaja.' + (+d.points > 0 ? ' Kamu dapat ' + d.points + ' poin dari sewa ini.' : '');\n    noteSt = 'background: #E7F7F5; color: #06433D; border-radius: 14px; padding: 14px 16px; font-size: 13.5px; line-height: 20px';\n  }\n  const wa = String((d.branch || {}).phone || '').replace(/\\D/g, '');\n  return {\n    d: true, msg: '', badge: isOut ? 'Unit diserahkan' : 'Sewa selesai', title: isOut ? 'Berita acara serah terima' : 'Berita acara pengembalian',\n    code: d.code, branch: (d.branch || {}).name || '', cards, noteTxt, noteSt,\n    intro: 'Halo' + (d.name ? ' ' + d.name : '') + ', ' + (isOut ? 'unit sudah kami serahkan. Ini berita acara serah terimanya.' : 'unit sudah kami terima kembali. Ini berita acara pengembalian dan tagihan akhirnya.'),\n    waHref: wa ? 'https://wa.me/' + wa + '?text=' + encodeURIComponent('Halo admin, saya mau tanya soal booking ' + d.code) : '#/Bantuan',\n    ctaHref: isOut ? '#/Status?id=' + d.booking_id : '#/Ulasan?id=' + d.booking_id, ctaTxt: isOut ? 'Status sewa' : 'Beri ulasan',\n    what: isOut ? 'serah terima unit' : 'pengembalian unit', addr: (d.branch || {}).address || ''\n  };\n}\n}\n</script>\n</body>\n</html>\n"}