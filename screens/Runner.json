{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Tugas runner</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0}\na{color:#1F2B4D}a:hover{color:#000}\nbutton:disabled{opacity:.55;cursor:not-allowed}\n</style>\n</helmet>\n<div style=\"width: 390px; height: 1000px; box-sizing: border-box; background: #FFFFFF; color: #1F2B4D; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; flex-direction: column; position: relative; overflow: hidden\">\n\n  <header style=\"display: flex; align-items: center; justify-content: space-between; padding: 14px 16px; border-bottom: 1px solid #E6E8EC\">\n    <img src=\"logo.png\" alt=\"Rentalaja\" style=\"height: 28px; width: auto; display: block\">\n    <div style=\"text-align: right\"><div style=\"font-size: 14px; font-weight: 800\">{{who}}</div><div style=\"font-size: 12px; color: #4A5468\">{{today}}</div></div>\n  </header>\n\n  <section style=\"padding: 14px 16px 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px\">\n    <div style=\"background: #F6F7F9; border-radius: 12px; padding: 12px\"><div style=\"font-size: 12px; color: #4A5468\">Tugas hari ini</div><div style=\"font-size: 20px; font-weight: 800\">{{doneText}}</div></div>\n    <div style=\"background: #F6F7F9; border-radius: 12px; padding: 12px\"><div style=\"font-size: 12px; color: #4A5468\">Ongkir terkumpul</div><div style=\"font-size: 15px; font-weight: 800; line-height: 26px\">{{earned}}</div></div>\n  </section>\n\n  <section style=\"padding: 14px 16px 0; display: flex; flex-direction: column; gap: 10px\">\n    <sc-if value=\"{{empty}}\"><div style=\"border: 1px dashed #D5D9E0; border-radius: 16px; padding: 16px 14px; font-size: 13px; line-height: 19px; color: #4A5468; text-align: center\">{{empty}}</div></sc-if>\n    <sc-for list=\"{{tasks}}\" as=\"t\">\n    <sc-if value=\"{{t.sel}}\" not>\n    <button type=\"button\" onClick=\"{{t.pick}}\" style=\"{{t.box}}\">\n      <div style=\"text-align: left\"><div style=\"font-size: 13px; font-weight: 800\">{{t.head}}</div><div style=\"font-size: 13px; color: #4A5468\">{{t.line}}</div></div>\n      <span style=\"{{t.chip}}\">{{t.st}}</span>\n    </button>\n    </sc-if>\n    <sc-if value=\"{{t.sel}}\">\n    <div style=\"border: 2px solid #1F2B4D; border-radius: 16px; padding: 14px; display: flex; flex-direction: column; gap: 12px\">\n      <div style=\"display: flex; justify-content: space-between; gap: 10px; align-items: baseline\">\n        <div style=\"font-size: 16px; font-weight: 800\">{{t.head}}</div>\n        <span style=\"{{t.chip}}\">{{t.st}}</span>\n      </div>\n      <div style=\"font-size: 14px; line-height: 20px\"><b>{{t.unit}}</b> {{t.forWho}}<br><span style=\"color: #4A5468\">{{t.addr}}</span></div>\n      <div style=\"{{t.pay.style}}\"><div style=\"display: flex; justify-content: space-between; gap: 8px; font-size: 14px; font-weight: 800\"><span>{{t.pay.head}}</span><span>{{t.pay.amt}}</span></div><div style=\"font-size: 12px; line-height: 17px\">{{t.pay.lines}}</div></div>\n      <div style=\"display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px\">\n        <a href=\"{{t.nav}}\" style=\"height: 44px; border-radius: 10px; background: #1F2B4D; color: #FFFFFF; font-size: 13px; font-weight: 700; display: flex; align-items: center; justify-content: center; text-decoration: none\">Navigasi</a>\n        <a href=\"{{t.tel}}\" style=\"height: 44px; border-radius: 10px; border: 1px solid #1F2B4D; font-size: 13px; font-weight: 700; display: flex; align-items: center; justify-content: center; text-decoration: none\">Telepon</a>\n        <a href=\"{{t.wa}}\" style=\"height: 44px; border-radius: 10px; border: 1px solid #1F2B4D; font-size: 13px; font-weight: 700; display: flex; align-items: center; justify-content: center; text-decoration: none\">WA</a>\n      </div>\n      <sc-if value=\"{{notYet}}\"><div style=\"background: #EEF0F3; border-radius: 12px; padding: 12px 14px; font-size: 13px; line-height: 19px; color: #4A5468\"><b>Belum bisa dijemput.</b> {{notYet}}</div></sc-if>\n      <sc-if value=\"{{onWay}}\">\n        <sc-if value=\"{{canStart}}\"><button type=\"button\" onClick=\"{{start}}\" disabled=\"{{busy}}\" style=\"height: 52px; border-radius: 12px; border: none; background: #1F2B4D; color: #FFFFFF; font: 800 16px 'Plus Jakarta Sans', system-ui, sans-serif; cursor: pointer\">Mulai berangkat</button>\n        <div style=\"font-size: 12px; line-height: 17px; color: #4A5468\">Tekan saat berangkat. Kirim kabar ke pelanggan lewat tombol WA (pesan sudah terisi).</div></sc-if>\n        <sc-if value=\"{{canStart}}\" not><button type=\"button\" onClick=\"{{arrive}}\" disabled=\"{{busy}}\" style=\"height: 52px; border-radius: 12px; border: none; background: #09BEAF; color: #1F2B4D; font: 800 16px 'Plus Jakarta Sans', system-ui, sans-serif; cursor: pointer\">Sudah tiba di lokasi</button></sc-if>\n      </sc-if>\n      <sc-if value=\"{{handover}}\">\n        <div style=\"display: flex; flex-direction: column; gap: 8px; padding-top: 4px; border-top: 1px solid #E6E8EC\">\n          <sc-if value=\"{{hasUnits}}\"><div style=\"display: flex; flex-direction: column; gap: 10px; background: #F6F7F9; border-radius: 12px; padding: 10px 12px\">\n            <div style=\"font-size: 12px; line-height: 17px; font-weight: 700; color: #4A5468\">{{unitHint}}</div>\n            <sc-for list=\"{{units}}\" as=\"u\"><div style=\"display: flex; flex-direction: column; gap: 6px\">\n              <div style=\"font-size: 13px; line-height: 18px\"><b>{{u.asset}}</b> · {{u.name}}{{u.plate}}</div>\n              <sc-if value=\"{{u.ok}}\"><div style=\"font-size: 12px; font-weight: 800; color: #1E6B45\">✓ Cocok: {{u.ok}}</div></sc-if>\n              <sc-if value=\"{{u.ok}}\" not><sc-if value=\"{{u.typing}}\" not><div style=\"display: flex; flex-direction: column; gap: 4px\"><button type=\"button\" onClick=\"{{u.same}}\" style=\"height: 44px; border-radius: 10px; border: none; background: #1F2B4D; color: #FFFFFF; font: 800 14px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">{{u.sameLabel}}</button><button type=\"button\" onClick=\"{{u.type}}\" style=\"height: 28px; border: none; background: transparent; color: #4A5468; font: 700 12px 'Plus Jakarta Sans', sans-serif; cursor: pointer; align-self: flex-start; padding: 0; text-decoration: underline\">Unit beda? Ketik nomor aset/plat</button></div></sc-if><sc-if value=\"{{u.typing}}\"><div style=\"display: flex; gap: 6px\"><input type=\"text\" autocomplete=\"off\" placeholder=\"No. aset / plat di unit\" aria-label=\"Nomor aset atau plat unit\" value=\"{{u.val}}\" onInput=\"{{u.set}}\" style=\"flex: 1; min-width: 0; height: 40px; box-sizing: border-box; border: 1px solid #B4BCC8; border-radius: 10px; padding: 0 10px; font: 700 14px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; text-transform: uppercase; background: #FFFFFF\"><button type=\"button\" onClick=\"{{u.check}}\" disabled=\"{{busy}}\" style=\"height: 40px; padding: 0 12px; border-radius: 10px; border: 1px solid #1F2B4D; background: #FFFFFF; color: #1F2B4D; font: 700 13px 'Plus Jakarta Sans', sans-serif; cursor: pointer; flex-shrink: 0\">Cocokkan</button></div></sc-if></sc-if>\n              <sc-if value=\"{{u.canDmg}}\"><sc-if value=\"{{u.dmgOpen}}\" not><button type=\"button\" onClick=\"{{u.openDmg}}\" style=\"height: 30px; border: none; background: transparent; color: #A12A1F; font: 700 12px 'Plus Jakarta Sans', sans-serif; cursor: pointer; align-self: flex-start; padding: 0\">Ada kerusakan / kekurangan?</button></sc-if>\n              <sc-if value=\"{{u.dmgOpen}}\"><div style=\"display: flex; flex-direction: column; gap: 6px\"><textarea rows=\"2\" placeholder=\"Contoh: spion kiri patah, lensa tergores, charger tidak ada\" value=\"{{dmgNote}}\" onInput=\"{{setDmg}}\" style=\"width: 100%; box-sizing: border-box; border: 1px solid #B4BCC8; border-radius: 10px; padding: 8px 10px; font: 500 13px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; resize: vertical; background: #FFFFFF\"></textarea>\n                <div style=\"display: flex; gap: 6px; justify-content: flex-end\"><button type=\"button\" onClick=\"{{u.closeDmg}}\" style=\"height: 40px; padding: 0 12px; border-radius: 10px; border: 1px solid #1F2B4D; background: #FFFFFF; color: #1F2B4D; font: 700 13px 'Plus Jakarta Sans', sans-serif; cursor: pointer; flex-shrink: 0; border-color: #D5D9E0; color: #5B6577\">Batal</button><button type=\"button\" onClick=\"{{u.sendDmg}}\" disabled=\"{{busy}}\" style=\"height: 40px; padding: 0 12px; border-radius: 10px; border: 1px solid #1F2B4D; background: #FFFFFF; color: #1F2B4D; font: 700 13px 'Plus Jakarta Sans', sans-serif; cursor: pointer; flex-shrink: 0; background: #A12A1F; border-color: #A12A1F; color: #FFFFFF\">Kirim ke tim aset</button></div>\n                <div style=\"font-size: 11px; line-height: 16px; color: #6B7486\">Foto 4 sisi di bawah ikut dilampirkan. Tim aset memutuskan, unit bisa langsung masuk servis.</div></div></sc-if></sc-if>\n              <sc-if value=\"{{u.reported}}\"><div style=\"font-size: 12px; font-weight: 800; color: #A12A1F\">Laporan kerusakan terkirim ke tim aset</div></sc-if>\n            </div></sc-for>\n          </div></sc-if>\n          <label style=\"display: flex; gap: 10px; align-items: center; font-size: 14px; line-height: 20px; min-height: 32px\"><input type=\"checkbox\" checked=\"{{ktp}}\" onChange=\"{{toggleKtp}}\" style=\"width: 18px; height: 18px; accent-color: #1F2B4D; margin: 0; flex-shrink: 0\">{{ktpLabel}}</label>\n          <label style=\"display: flex; gap: 10px; align-items: center; font-size: 14px; line-height: 20px; min-height: 32px\"><input type=\"checkbox\" checked=\"{{photosOk}}\" disabled style=\"width: 18px; height: 18px; accent-color: #1F2B4D; margin: 0; flex-shrink: 0\">Foto unit (1 cukup, tambahan bila ada lecet)</label>\n          <div style=\"display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px\"><sc-for list=\"{{shots}}\" as=\"f\"><label style=\"{{f.box}}\"><sc-if value=\"{{f.url}}\"><img src=\"{{f.url}}\" alt=\"{{f.label}}\" style=\"width: 100%; height: 100%; object-fit: cover\"></sc-if><sc-if value=\"{{f.url}}\" not>{{f.label}}</sc-if><input type=\"file\" accept=\"image/*\" capture=\"environment\" onChange=\"{{f.pick}}\" style=\"display: none\"></label></sc-for></div>\n          <sc-if value=\"{{showPay}}\">\n          <label style=\"display: flex; gap: 10px; align-items: center; font-size: 14px; line-height: 20px; min-height: 32px\"><input type=\"checkbox\" checked=\"{{paid}}\" disabled style=\"width: 18px; height: 18px; accent-color: #1F2B4D; margin: 0; flex-shrink: 0\">{{payLabel}}</label>\n          <sc-if value=\"{{canPay}}\"><div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 8px\"><button type=\"button\" onClick=\"{{payQris}}\" disabled=\"{{busy}}\" style=\"height: 44px; border-radius: 10px; border: 1px solid #1F2B4D; background: #FFFFFF; color: #1F2B4D; font: 700 14px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">QRIS di HP ini</button><button type=\"button\" onClick=\"{{payCash}}\" disabled=\"{{busy}}\" style=\"height: 44px; border-radius: 10px; border: 1px solid #1F2B4D; background: #FFFFFF; color: #1F2B4D; font: 700 14px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">Terima tunai</button><button type=\"button\" onClick=\"{{payLink}}\" disabled=\"{{busy}}\" style=\"height: 44px; border-radius: 10px; border: 1px solid #1F2B4D; background: #FFFFFF; color: #1F2B4D; font: 700 14px 'Plus Jakarta Sans', sans-serif; cursor: pointer; grid-column: 1 / -1\">Transfer bank / VA / e-wallet (link bayar)</button></div></sc-if>\n          <sc-if value=\"{{qris}}\"><div style=\"background: #F6F7F9; border-radius: 12px; padding: 12px 14px; display: flex; flex-direction: column; gap: 8px; font-size: 13px; line-height: 19px\"><span>{{qris.text}}</span><sc-if value=\"{{qris.link}}\"><div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 8px\"><sc-if value=\"{{qris.wa}}\"><a href=\"{{qris.wa}}\" target=\"_blank\" rel=\"noopener\" style=\"display: flex; align-items: center; justify-content: center; height: 42px; border-radius: 10px; text-decoration: none; font: 800 14px 'Plus Jakarta Sans', sans-serif; background: #09BEAF; color: #1F2B4D\">Kirim ke WA pelanggan</a></sc-if><a href=\"{{qris.link}}\" target=\"_blank\" rel=\"noopener\" style=\"display: flex; align-items: center; justify-content: center; height: 42px; border-radius: 10px; text-decoration: none; font: 800 14px 'Plus Jakarta Sans', sans-serif; border: 1px solid #1F2B4D; color: #1F2B4D; background: #FFFFFF\">Buka link bayar</a></div></sc-if><sc-if value=\"{{qris.img}}\"><img src=\"{{qris.img}}\" alt=\"Kode QRIS untuk dipindai pelanggan\" style=\"width: 230px; height: 230px; align-self: center; background: #FFFFFF; border-radius: 8px; display: block\"></sc-if><sc-if value=\"{{qris.sim}}\"><button type=\"button\" onClick=\"{{qris.simulate}}\" disabled=\"{{busy}}\" style=\"height: 40px; border-radius: 10px; border: 1px dashed #1F2B4D; background: #FFFFFF; color: #1F2B4D; font: 700 13px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">Simulasi: pelanggan sudah bayar</button></sc-if></div></sc-if>\n          </sc-if>\n          <sc-if value=\"{{sigOpen}}\" not><button type=\"button\" onClick=\"{{openSig}}\" style=\"height: 30px; border: none; background: transparent; color: #4A5468; font: 700 12px 'Plus Jakarta Sans', sans-serif; cursor: pointer; align-self: flex-start; padding: 0; text-decoration: underline\">+ Tanda tangan pelanggan (opsional)</button></sc-if>\n          <sc-if value=\"{{sigOpen}}\"><div style=\"height: 90px; border-radius: 12px; border: 1.5px dashed #B4BCC8; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; color: #6B7385; position: relative; overflow: hidden\"><canvas ref=\"{{sigRef}}\" width=\"320\" height=\"90\" aria-label=\"Tanda tangan pelanggan\" style=\"position: absolute; inset: 0; width: 100%; height: 100%; touch-action: none; cursor: crosshair\"></canvas><sc-if value=\"{{hasSig}}\" not><span style=\"pointer-events: none\">Tanda tangan pelanggan di sini</span></sc-if></div>\n          <sc-if value=\"{{hasSig}}\"><button type=\"button\" onClick=\"{{clearSig}}\" style=\"height: 32px; border: none; background: transparent; color: #4A5468; font: 700 12px 'Plus Jakarta Sans', sans-serif; cursor: pointer; align-self: flex-end\">Ulangi tanda tangan</button></sc-if></sc-if>\n          <button type=\"button\" onClick=\"{{finish}}\" disabled=\"{{busy}}\" style=\"height: 52px; border-radius: 12px; border: none; background: #09BEAF; color: #1F2B4D; font: 800 16px 'Plus Jakarta Sans', system-ui, sans-serif; cursor: pointer\">Selesai serah-terima</button>\n        </div>\n      </sc-if>\n      <sc-if value=\"{{afterPay}}\">\n        <div style=\"display: flex; flex-direction: column; gap: 8px; padding-top: 4px; border-top: 1px solid #E6E8EC\">\n          <div style=\"background: #FFF1D6; border-radius: 12px; padding: 12px 14px; font-size: 13px; line-height: 19px; color: #5C3600\">{{afterNote}}</div>\n          <sc-if value=\"{{canPay}}\"><div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 8px\"><button type=\"button\" onClick=\"{{payQris}}\" disabled=\"{{busy}}\" style=\"height: 44px; border-radius: 10px; border: 1px solid #1F2B4D; background: #FFFFFF; color: #1F2B4D; font: 700 14px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">QRIS di HP ini</button><button type=\"button\" onClick=\"{{payCash}}\" disabled=\"{{busy}}\" style=\"height: 44px; border-radius: 10px; border: 1px solid #1F2B4D; background: #FFFFFF; color: #1F2B4D; font: 700 14px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">Terima tunai</button><button type=\"button\" onClick=\"{{payLink}}\" disabled=\"{{busy}}\" style=\"height: 44px; border-radius: 10px; border: 1px solid #1F2B4D; background: #FFFFFF; color: #1F2B4D; font: 700 14px 'Plus Jakarta Sans', sans-serif; cursor: pointer; grid-column: 1 / -1\">Transfer bank / VA / e-wallet (link bayar)</button></div></sc-if>\n          <sc-if value=\"{{qris}}\"><div style=\"background: #F6F7F9; border-radius: 12px; padding: 12px 14px; display: flex; flex-direction: column; gap: 8px; font-size: 13px; line-height: 19px\"><span>{{qris.text}}</span><sc-if value=\"{{qris.link}}\"><div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 8px\"><sc-if value=\"{{qris.wa}}\"><a href=\"{{qris.wa}}\" target=\"_blank\" rel=\"noopener\" style=\"display: flex; align-items: center; justify-content: center; height: 42px; border-radius: 10px; text-decoration: none; font: 800 14px 'Plus Jakarta Sans', sans-serif; background: #09BEAF; color: #1F2B4D\">Kirim ke WA pelanggan</a></sc-if><a href=\"{{qris.link}}\" target=\"_blank\" rel=\"noopener\" style=\"display: flex; align-items: center; justify-content: center; height: 42px; border-radius: 10px; text-decoration: none; font: 800 14px 'Plus Jakarta Sans', sans-serif; border: 1px solid #1F2B4D; color: #1F2B4D; background: #FFFFFF\">Buka link bayar</a></div></sc-if><sc-if value=\"{{qris.img}}\"><img src=\"{{qris.img}}\" alt=\"Kode QRIS untuk dipindai pelanggan\" style=\"width: 230px; height: 230px; align-self: center; background: #FFFFFF; border-radius: 8px; display: block\"></sc-if><sc-if value=\"{{qris.sim}}\"><button type=\"button\" onClick=\"{{qris.simulate}}\" disabled=\"{{busy}}\" style=\"height: 40px; border-radius: 10px; border: 1px dashed #1F2B4D; background: #FFFFFF; color: #1F2B4D; font: 700 13px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">Simulasi: pelanggan sudah bayar</button></sc-if></div></sc-if>\n          <button type=\"button\" onClick=\"{{closeTask}}\" disabled=\"{{busy}}\" style=\"height: 48px; border-radius: 12px; border: 1px solid #1F2B4D; background: #FFFFFF; color: #1F2B4D; font: 700 14px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">{{closeLabel}}</button>\n        </div>\n      </sc-if>\n<sc-if value=\"{{canFail}}\">\n        <sc-if value=\"{{failOpen}}\" not><button type=\"button\" onClick=\"{{openFail}}\" style=\"height: 34px; border: none; background: transparent; color: #A12A1F; font: 700 13px 'Plus Jakarta Sans', sans-serif; cursor: pointer; align-self: flex-start; padding: 0\">Tugas tidak bisa diselesaikan?</button></sc-if>\n        <sc-if value=\"{{failOpen}}\"><div style=\"background: #FDECEA; border-radius: 12px; padding: 12px; display: flex; flex-direction: column; gap: 8px\">\n          <div style=\"font-size: 13px; font-weight: 800; color: #A12A1F\">Alasan tugas gagal</div>\n          <div style=\"display: flex; flex-wrap: wrap; gap: 6px\"><sc-for list=\"{{failWhys}}\" as=\"w\"><button type=\"button\" onClick=\"{{w.pick}}\" aria-pressed=\"{{w.on}}\" style=\"{{w.style}}\">{{w.label}}</button></sc-for></div>\n          <textarea rows=\"2\" placeholder=\"Keterangan, mis. sudah ditelepon 3x tidak diangkat\" value=\"{{failNote}}\" onInput=\"{{setFailNote}}\" style=\"width: 100%; box-sizing: border-box; border: 1px solid #B4BCC8; border-radius: 10px; padding: 8px 10px; font: 500 13px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; resize: vertical; background: #FFFFFF\"></textarea>\n          <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 8px\"><button type=\"button\" onClick=\"{{closeFail}}\" style=\"height: 44px; border-radius: 10px; border: 1px solid #D5D9E0; background: #FFFFFF; color: #5B6577; font: 700 14px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">Batal</button><button type=\"button\" onClick=\"{{submitFail}}\" disabled=\"{{busy}}\" style=\"height: 44px; border-radius: 10px; border: none; background: #A12A1F; color: #FFFFFF; font: 800 14px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">Tandai gagal</button></div>\n        </div></sc-if>\n      </sc-if>\n      <sc-if value=\"{{failed}}\">\n        <div style=\"background: #FDECEA; border-radius: 12px; padding: 14px 16px; font-size: 14px; line-height: 20px; color: #7A1F16\"><b>Tugas gagal.</b> {{failText}} Cabang melihat status ini dan akan menjadwalkan ulang.</div>\n      </sc-if>\n      <sc-if value=\"{{done}}\">\n        <div style=\"background: #E4F2EA; border-radius: 12px; padding: 14px 16px; font-size: 14px; line-height: 20px; color: #1F3D2D\"><b>Selesai.</b> {{doneNote}}</div>\n      </sc-if>\n    </div>\n    </sc-if>\n    </sc-for>\n    <div style=\"font-size: 12px; line-height: 18px; color: #4A5468\">Serah-terima cukup: cek unit ✓, cek KTP ✓, 1 foto, lunas. Uang tunai disetor ke cabang sebelum shift ditutup.</div>\n  </section>\n\n</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{\"$preview\":{\"width\":390,\"height\":1000}}'>\nclass Component extends DCLogic {\nstate = { tasks: null, books: {}, pays: [], sel: null, ktp: false, shots: [null, null, null, null], hasSig: false, pay: null, after: null, earned: null, match: {}, matched: {}, typing: {}, sigOpen: false, failOpen: false, failWhy: '', failNote: '', dmgUnit: null, dmgNote: '', reported: {} };\nasync componentDidMount() {\n  await RA.staff();\n  this.stop = RA.poll(this, () => { const t = this.cur(); if (t && (t.status === 'arrived' || this.state.pay)) return; return this.reload(); }, 45000);\n}\ncomponentWillUnmount() { if (this.stop) this.stop(); clearTimeout(this._pt); }\nasync reload() {\n  const me = (RA.me() || {}).id;\n  const a = new Date(); a.setHours(0, 0, 0, 0); const b = new Date(a); b.setDate(b.getDate() + 2);\n  const cols = 'id,booking_id,branch_id,kind,status,scheduled_at,address,landmark,lat,lng,runner_share,cash_collected,ktp_collected,done_at,note';\n  const [x, y] = await Promise.all([\n    RA.from('runner_tasks').select(cols).eq('runner_id', me).gte('scheduled_at', a.toISOString()).lt('scheduled_at', b.toISOString()).order('scheduled_at'),\n    RA.from('runner_tasks').select(cols).eq('runner_id', me).in('status', ['scheduled', 'on_the_way', 'arrived']).lt('scheduled_at', a.toISOString()).order('scheduled_at')\n  ]);\n  const tasks = (y.data || []).concat((x.data || []).filter(t => t.status !== 'cancelled'));\n  const ids = Array.from(new Set(tasks.map(t => t.booking_id)));\n  const books = {};\n  if (ids.length) {\n    const { data } = await RA.from('bookings').select('id,code,status,start_at,end_at,guest_name,guest_phone,total,paid_amount,late_fee,damage_fee,dp_amount,delivery_address,delivery_landmark,delivery_lat,delivery_lng,booking_items(id,status,units(id,asset_no,code,plate_or_serial),products(name))').in('id', ids);\n    (data || []).forEach(bk => books[bk.id] = bk);\n  }\n  const pq = ids.length ? await RA.from('payments').select('booking_id,amount,method,bank,kind,paid_at').in('booking_id', ids).eq('status', 'paid').order('paid_at') : { data: [] };\n  const earned = tasks.filter(t => t.status === 'done' && t.done_at && new Date(t.done_at) >= a);\n  if (!RA_ALIVE(this)) return;\n  let sel = this.state.sel;\n  if (!sel || !tasks.some(t => t.id === sel)) { const nx = tasks.find(t => ['scheduled', 'on_the_way', 'arrived'].indexOf(t.status) > -1); sel = nx ? nx.id : (tasks[0] && tasks[0].id) || null; }\n  this.setState({ tasks, books, pays: pq.data || [], sel, earned: earned.reduce((s, t) => s + (+t.runner_share || 0), 0) });\n}\ncur() { return (this.state.tasks || []).find(t => t.id === this.state.sel) || null; }\nbal(bk) { return bk ? (+bk.total + +bk.late_fee + +bk.damage_fee - +bk.paid_amount) : 0; }\npick(t) { if (this.state.sel === t.id) return; this._sig = null; this.setState({ sel: t.id, ktp: false, shots: [null, null, null, null], hasSig: false, pay: null, after: null, match: {}, matched: {}, typing: {}, sigOpen: false, failOpen: false, failWhy: '', failNote: '', dmgUnit: null, dmgNote: '' }); }\nnk(x) { const s = String(x || '').toUpperCase().replace(/[^A-Z0-9]/g, ''); const m = s.match(/^([A-Z]{3})0*(\\d{1,4})$/); return m ? m[1] + (+m[2]) : s; }\nitems(bk) { return ((bk && bk.booking_items) || []).filter(it => it.units && ['cancelled', 'rejected', 'expired'].indexOf(it.status) < 0); }\nasync checkUnit(it) {\n  const s = this.state, t = this.cur(); const val = String(s.match[it.id] || '').trim();\n  if (!val) throw new Error('Ketik nomor aset atau plat yang tertempel di unit.');\n  const u = it.units || {};\n  if ([u.asset_no, u.plate_or_serial].some(x => x && x !== '—' && this.nk(x) === this.nk(val))) { this.setState({ matched: Object.assign({}, s.matched, { [it.id]: u.asset_no || val.toUpperCase() }) }); return; }\n  if (t.kind === 'pickup') throw new Error('Bukan unit yang disewa. Tercatat ' + (u.asset_no || '—') + (u.plate_or_serial && u.plate_or_serial !== '—' ? ' / ' + u.plate_or_serial : '') + '. Cek lagi atau hubungi cabang.');\n  const r = await RA.fn('kasir', { action: 'swap_unit', item_id: it.id, code: val, reason: 'Dicocokkan runner saat antar' });\n  await this.refreshBooking(t.booking_id);\n  this.setState({ matched: Object.assign({}, this.state.matched, { [it.id]: r.to }) });\n  RA.ok(r.same ? 'Cocok' : 'Unit tercatat diganti: ' + r.from + ' → ' + r.to);\n}\nasync sendDmg(it) {\n  const s = this.state, t = this.cur(), bk = s.books[t.booking_id] || {}; const note = String(s.dmgNote || '').trim();\n  if (note.length < 3) throw new Error('Tulis kerusakan atau kekurangannya.');\n  if (s.shots.some(x => x && x.busy)) throw new Error('Tunggu foto selesai diunggah.');\n  await RA.fn('kasir', { action: 'asset_report', kind: 'rusak', unit_id: (it.units || {}).id, note: 'Saat dijemput (' + (bk.code || '') + '): ' + note, photos: s.shots.filter(x => x && x.path).map(x => x.path) });\n  this.setState({ dmgUnit: null, dmgNote: '', reported: Object.assign({}, this.state.reported, { [it.id]: true }) });\n  RA.ok('Laporan terkirim ke tim aset');\n}\nasync submitFail() {\n  const s = this.state; const note = String(s.failNote || '').trim();\n  if (!s.failWhy) throw new Error('Pilih alasan.');\n  if (note.length < 3) throw new Error('Isi keterangan singkat.');\n  await this.setTask({ status: 'failed', done_at: new Date().toISOString(), note: s.failWhy + ' — ' + note });\n  this.setState({ failOpen: false });\n  RA.ok('Tugas ditandai gagal. Cabang akan menindaklanjuti.');\n}\nasync shrink(f) {\n  try {\n    if (!/^image\\//.test(f.type) || f.size < 600000 || !window.createImageBitmap) return f;\n    const bm = await createImageBitmap(f); const k = Math.min(1, 1600 / Math.max(bm.width, bm.height));\n    const c = document.createElement('canvas'); c.width = Math.round(bm.width * k); c.height = Math.round(bm.height * k);\n    c.getContext('2d').drawImage(bm, 0, 0, c.width, c.height);\n    const bl = await new Promise(r => c.toBlob(r, 'image/jpeg', 0.8));\n    return bl && bl.size < f.size ? new File([bl], 'foto.jpg', { type: 'image/jpeg' }) : f;\n  } catch (e) { return f; }\n}\nasync setTask(patch) {\n  const t = this.cur(); const { error } = await RA.from('runner_tasks').update(patch).eq('id', t.id);\n  if (error) throw new Error(error.message);\n  this.setState({ tasks: this.state.tasks.map(x => x.id === t.id ? Object.assign({}, x, patch) : x) });\n}\nasync arrive() { await this.setTask({ status: 'arrived' }); }\nasync upload(i, e) {\n  const f = e.target.files && e.target.files[0]; if (!f) return;\n  const t = this.cur(); const shots = this.state.shots.slice(); shots[i] = { url: URL.createObjectURL(f), busy: true }; this.setState({ shots });\n  try {\n    const path = 'serah/' + t.booking_id + '/' + (t.kind === 'pickup' ? 'jemput' : 'antar') + '-' + Date.now() + '-' + i + '.jpg';\n    await RA.upload('operasional', path, await this.shrink(f));\n    const s2 = this.state.shots.slice(); s2[i] = { url: shots[i].url, path }; this.setState({ shots: s2 });\n  } catch (err) { const s2 = this.state.shots.slice(); s2[i] = null; this.setState({ shots: s2 }); RA.err(err); }\n}\nsigRef(el) {\n  if (!el) return; const ctx = el.getContext('2d');\n  if (this._sig) { const im = new Image(); im.onload = () => ctx.drawImage(im, 0, 0); im.src = this._sig; }\n  let down = false;\n  const pos = e => { const r = el.getBoundingClientRect(); return [(e.clientX - r.left) * el.width / r.width, (e.clientY - r.top) * el.height / r.height]; };\n  el.addEventListener('pointerdown', e => { down = true; el.setPointerCapture && el.setPointerCapture(e.pointerId); const p = pos(e); ctx.lineWidth = 2.2; ctx.lineCap = 'round'; ctx.strokeStyle = '#1F2B4D'; ctx.beginPath(); ctx.moveTo(p[0], p[1]); });\n  el.addEventListener('pointermove', e => { if (!down) return; const p = pos(e); ctx.lineTo(p[0], p[1]); ctx.stroke(); this._dirty = true; });\n  const up = () => { if (!down) return; down = false; if (this._dirty) { this._sig = el.toDataURL('image/png'); if (!this.state.hasSig) this.setState({ hasSig: true }); } };\n  el.addEventListener('pointerup', up); el.addEventListener('pointerleave', up);\n}\nasync startPay(method) {\n  const t = this.cur(), bk = this.state.books[t.booking_id];\n  const pm = await RA.call('create_payment', { p_booking: bk.id, p_kind: null, p_method: method, p_amount: null });\n  if (method === 'cash') {\n    await RA.call('mark_payment_paid', { p_payment: pm.id, p_provider_ref: null, p_raw: null });\n    await this.setTask({ cash_collected: (+t.cash_collected || 0) + +pm.amount });\n    RA.ok('Tunai ' + RA.rp(pm.amount) + ' tercatat atas nama Anda');\n    await this.refreshBooking(bk.id);\n    return;\n  }\n  const r = await RA.fn('pay', { payment_id: pm.id });\n  this.setState({ pay: { id: pm.id, amount: pm.amount, qr: r && r.payment && r.payment.qr_string, url: (r && (r.url || (r.payment && r.payment.payment_url))) || pm.payment_url || '', phone: bk.guest_phone || '', code: bk.code || '', sim: RA.simulation() } });\n  this.watchPay();\n}\nwatchPay() {\n  clearTimeout(this._pt);\n  this._pt = setTimeout(async () => {\n    const p = this.state.pay; if (!p || !RA_ALIVE(this)) return;\n    const { data } = await RA.from('payments').select('status').eq('id', p.id).maybeSingle();\n    if (data && data.status === 'paid') { this.setState({ pay: null }); RA.ok('QRIS ' + RA.rp(p.amount) + ' diterima'); const t = this.cur(); if (t) await this.refreshBooking(t.booking_id); }\n    else this.watchPay();\n  }, 3000);\n}\nasync simulate() { const p = this.state.pay; await RA.fn('pay', { payment_id: p.id, action: 'simulate' }); clearTimeout(this._pt); this.setState({ pay: null }); RA.ok('QRIS ' + RA.rp(p.amount) + ' diterima'); await this.refreshBooking(this.cur().booking_id); }\nasync refreshBooking(id) {\n  const { data } = await RA.from('bookings').select('id,code,status,start_at,end_at,guest_name,guest_phone,total,paid_amount,late_fee,damage_fee,dp_amount,delivery_address,delivery_landmark,delivery_lat,delivery_lng,booking_items(id,status,units(id,asset_no,code,plate_or_serial),products(name))').eq('id', id).maybeSingle();\n  const pq = await RA.from('payments').select('booking_id,amount,method,bank,kind,paid_at').in('booking_id', [id]).eq('status', 'paid').order('paid_at');\n  if (data && RA_ALIVE(this)) { const books = Object.assign({}, this.state.books); books[id] = data; this.setState({ books, pays: (this.state.pays || []).filter(p => p.booking_id !== id).concat(pq.data || []) }); }\n}\nasync finish() {\n  const s = this.state, t = this.cur(), bk = s.books[t.booking_id];\n  if (!bk) throw new Error('Data booking tidak terbaca.');\n  if (!s.ktp) throw new Error(t.kind === 'pickup' ? 'Centang pengembalian KTP dulu.' : 'Cek KTP pelanggan dulu.');\n  if (s.shots.some(x => x && x.busy)) throw new Error('Tunggu foto selesai diunggah.');\n  const photos = s.shots.filter(x => x && x.path).map(x => x.path);\n  if (photos.length < 1) throw new Error('Ambil 1 foto unit dulu.');\n  if (t.kind !== 'pickup' && this.bal(bk) > 0) throw new Error('Sisa bayar ' + RA.rp(this.bal(bk)) + ' belum lunas.');\n  const need = this.items(bk).filter(it => !s.matched[it.id]);\n  if (need.length) throw new Error('Cocokkan nomor aset/plat unit dulu: ' + need.map(it => (it.units || {}).asset_no || (it.products || {}).name).join(', ') + '.');\n  let sig = null;\n  if (this._sig) { const blob = await (await fetch(this._sig)).blob(); sig = 'serah/' + bk.id + '/ttd-' + (t.kind === 'pickup' ? 'jemput' : 'antar') + '-' + Date.now() + '.png'; await RA.upload('operasional', sig, new File([blob], 'ttd.png', { type: 'image/png' })); }\n  const keep = RA.setting('ktp_original_deposit') === true;\n  let res;\n  if (t.kind === 'pickup') res = await RA.call('handover_in', { p_booking: bk.id, p: { photos, ktp_returned: keep ? true : null, signature_path: sig, checklist: { foto_unit: true, unit_dicocokkan: true } } });\n  else res = await RA.call('handover_out', { p_booking: bk.id, p: { photos, ktp_held: keep ? true : null, signature_path: sig, checklist: { ktp_dicek: true, foto_unit: true, unit_dicocokkan: true } } });\n  const { data: h } = await RA.from('handovers').select('id').eq('booking_id', bk.id).eq('direction', t.kind === 'pickup' ? 'in' : 'out').order('at', { ascending: false }).limit(1);\n  const hid = h && h[0] ? h[0].id : null;\n  await this.refreshBooking(bk.id);\n  if (t.kind === 'pickup' && res && +res.balance > 0) {\n    await this.setTask({ handover_id: hid, ktp_collected: keep ? false : null });\n    this.setState({ after: 'pay' });\n    return;\n  }\n  await this.setTask({ status: 'done', done_at: new Date().toISOString(), handover_id: hid, ktp_collected: t.kind === 'pickup' ? (keep ? false : null) : (keep ? true : null) });\n  this._sig = null; this.setState({ hasSig: false });\n  RA.ok('Serah-terima selesai');\n  this.reload();\n}\nasync closeTask() {\n  const t = this.cur();\n  await this.setTask({ status: 'done', done_at: new Date().toISOString() });\n  this.setState({ after: null }); this._sig = null;\n  this.reload();\n}\nrenderVals() {\nconst chip = (bg, fg) => 'display: inline-flex; align-items: center; height: 24px; padding: 0 9px; border-radius: 12px; font-size: 12px; font-weight: 800; white-space: nowrap; background: ' + bg + '; color: ' + fg + ';';\nconst TONE = { good: chip('#E4F2EA', '#1E6B45'), warn: chip('#FFF1D6', '#8A4B00'), bad: chip('#FDECEA', '#A12A1F'), info: chip('#E8EEF8', '#1F2B4D'), mute: chip('#EEF0F3', '#4A5468'), teal: chip('#E3F7F5', '#077A70') };\nconst s = this.state, now = new Date(), st = RA._staff || {};\nconst tasks0 = s.tasks || [];\nconst t = this.cur(); const bk = t ? s.books[t.booking_id] : null;\nconst KIND = { deliver: 'Antar', pickup: 'Jemput', swap: 'Tukar unit', rescue: 'Bantuan' };\nconst ST = { scheduled: ['Nanti', 'mute'], on_the_way: ['Dalam perjalanan', 'warn'], arrived: ['Serah-terima', 'teal'], done: ['Selesai', 'good'], failed: ['Gagal', 'bad'], cancelled: ['Batal', 'mute'] };\nconst unitOf = b => { const it = b && (b.booking_items || [])[0]; return it ? [(it.products || {}).name, ((it.units || {}).asset_no || (it.units || {}).code)].filter(Boolean).join(' ') + ((b.booking_items || []).length > 1 ? ' +' + ((b.booking_items || []).length - 1) : '') : '—'; };\nconst box = done => 'border: 1px solid #E6E8EC; border-radius: 16px; padding: 12px 14px; display: flex; justify-content: space-between; gap: 10px; background: #FFFFFF; cursor: pointer; font: inherit; color: #1F2B4D; width: 100%' + (done ? '; opacity: 0.7' : '');\nconst tasks = tasks0.map(x => { const b = s.books[x.booking_id] || {}; const sel = x.id === s.sel;\n  let stt = ST[x.status] || ST.scheduled;\n  const tAt = (x.kind === 'pickup' ? b.end_at : b.start_at) || x.scheduled_at;\n  const sched = tAt ? (new Date(tAt).toDateString() === now.toDateString() ? RA.time(tAt) : RA.dayTime(tAt)) : '—';\n  const addr = x.address || b.delivery_address; const lm = x.landmark || b.delivery_landmark;\n  const lat = x.lat || b.delivery_lat, lng = x.lng || b.delivery_lng;\n  const ph = String(b.guest_phone || '').replace(/\\D/g, '');\n  const pi = RA.payInfo(b, s.pays, x.kind === 'pickup' ? 'Tagihan tambahan (telat/kerusakan), tagih saat jemput' : 'Wajib lunas sebelum unit diserahkan');\n  return { sel, pay: pi, head: sched + ' · ' + (KIND[x.kind] || x.kind), line: unitOf(b) + ' · ' + (b.guest_name || '—') + (b.id ? ' · ' + pi.short : ''), st: stt[0], chip: TONE[stt[1]], box: box(x.status === 'done'), pick: () => this.pick(x),\n    unit: unitOf(b), forWho: (x.kind === 'pickup' ? 'dari ' : 'untuk ') + (b.guest_name || '—') + (b.code ? ' · ' + b.code : ''),\n    addr: (addr || '⚠ Alamat belum dilengkapi pelanggan — hubungi lewat WA sebelum berangkat') + (lm ? ' · patokan: ' + lm : ''),\n    nav: lat && lng ? 'https://www.google.com/maps/dir/?api=1&destination=' + lat + ',' + lng : 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(addr || ''),\n    tel: ph ? 'tel:+' + ph : 'tel:', wa: 'https://wa.me/' + ph + '?text=' + encodeURIComponent('Halo Kak ' + (b.guest_name || '') + ', saya ' + (st.name || 'petugas') + ' dari Rentalaja. ' + (x.kind === 'pickup' ? 'Saya akan menjemput ' : 'Saya sedang menuju lokasi untuk mengantar ') + unitOf(b) + (b.code ? ' (' + b.code + ')' : '') + '. ' + (addr ? 'Alamat: ' + addr + '. ' : 'Boleh dibagikan lokasi/share loc-nya? ') + 'Terima kasih.') }; });\nconst stage = !t ? '' : t.status === 'done' ? 'done' : t.status === 'failed' ? 'failed' : s.after === 'pay' ? 'after' : t.status === 'arrived' ? 'serah' : 'jalan';\nconst keep = RA.setting('ktp_original_deposit') === true;\nconst bal = this.bal(bk);\nconst sbox = 'height: 64px; border-radius: 10px; border: 1.5px dashed #B4BCC8; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 700; color: #6B7385; text-align: center; overflow: hidden; cursor: pointer';\nconst shots = ['Foto unit', '+ Lecet', '+ Lecet', '+ Lainnya'].map((label, i) => ({ label, url: s.shots[i] && s.shots[i].url, box: sbox + (s.shots[i] ? '; border-style: solid' : ''), pick: e => this.upload(i, e) }));\nconst p = s.pa