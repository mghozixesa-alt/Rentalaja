{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Pendapatan per aset</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0}\n.cp-card{background:#FFFFFF;border-radius:20px;box-shadow:0 2px 12px rgba(31,43,77,.06);padding:16px;display:flex;flex-direction:column;gap:12px}\n.cp-in{height:50px;box-sizing:border-box;border:2px solid #CDEFEA;border-radius:14px;padding:0 14px;font:700 16px 'Plus Jakarta Sans',sans-serif;color:#1F2B4D;background:#FFFFFF;width:100%}\n.cp-btn{height:50px;border:0;border-radius:14px;background:linear-gradient(135deg,#12B5A6,#077A70);color:#FFFFFF;font:800 15px 'Plus Jakarta Sans',sans-serif;cursor:pointer;display:flex;align-items:center;justify-content:center;text-decoration:none;width:100%}\n.cp-btn2{height:46px;border:1.5px solid #E3E7ED;border-radius:14px;background:#FFFFFF;color:#1F2B4D;font:800 14px 'Plus Jakarta Sans',sans-serif;cursor:pointer;display:flex;align-items:center;justify-content:center;text-decoration:none}\n.cp-st{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}\n.cp-st div{background:#F6F7F9;border-radius:14px;padding:10px 12px}\n.cp-st b{display:block;font-size:20px;line-height:26px}\n.cp-st span{font-size:12px;color:#4A5468}\n.cp-kv{display:flex;justify-content:space-between;gap:10px;font-size:13.5px;padding:9px 0;border-bottom:1px solid #EEF0F3}\n.cp-kv:last-child{border-bottom:0}.cp-kv span{color:#5B6577}.cp-kv b{text-align:right}\n.cp-rad{display:flex;align-items:center;gap:10px;min-height:48px;border:1.5px solid #E3E7ED;border-radius:14px;padding:0 14px;font:700 14px 'Plus Jakarta Sans',sans-serif;color:#1F2B4D;background:#FFFFFF;cursor:pointer;text-align:left;width:100%}\n.cp-rad i{width:18px;height:18px;border-radius:50%;border:2px solid #B4BCC8;flex:none;box-sizing:border-box}\n.cp-rad.on{border-color:#077A70;background:#F2FBFA}.cp-rad.on i{border:6px solid #077A70}\n\n.ap-k{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}\n@media (min-width:900px){.ap-k{grid-template-columns:repeat(4,minmax(0,1fr))}}\n.ap-k a,.ap-k div{background:#FFFFFF;border-radius:18px;padding:14px;box-shadow:0 2px 12px rgba(31,43,77,.06);text-decoration:none;color:#1F2B4D;display:block}\n.ap-k b{display:block;font-size:24px;line-height:30px}.ap-k span{font-size:12.5px;color:#4A5468;font-weight:600}\n.ap-t{width:100%;border-collapse:collapse;font-size:13px}.ap-t th{font-size:11.5px;color:#4A5468;text-align:right;padding:8px 6px;border-bottom:1px solid #EEF0F3;white-space:nowrap}.ap-t th:first-child{text-align:left}\n.ap-t td{padding:10px 6px;border-bottom:1px solid #EEF0F3;text-align:right;white-space:nowrap}.ap-t td:first-child{text-align:left;white-space:normal}\n.ap-bar{height:7px;border-radius:4px;background:#EEF0F3;overflow:hidden}.ap-bar i{display:block;height:100%;border-radius:4px}\n.ap-row{display:block;padding:12px 0;border-bottom:1px solid #EEF0F3;cursor:pointer;background:none;border-left:0;border-right:0;border-top:0;width:100%;text-align:left;font-family:inherit;color:#1F2B4D}\n.ap-desk{display:none}@media (min-width:900px){.ap-desk{display:block}.ap-mob{display:none}}\n</style>\n</helmet>\n<div style=\"min-height: 100vh; box-sizing: border-box; background: #F4F6F9; color: #1F2B4D; font-family: 'Plus Jakarta Sans', system-ui, sans-serif\">\n <main style=\"max-width: 1100px; margin: 0 auto; padding: 18px 16px 28px; display: flex; flex-direction: column; gap: 14px\">\n  <div style=\"display: flex; justify-content: space-between; align-items: flex-end; gap: 10px; flex-wrap: wrap\">\n   <div><div style=\"font-size: 13px; font-weight: 700; color: #5B6577\">{{scope}}</div><h1 style=\"margin: 2px 0 0; font-size: 26px; line-height: 32px\">Kinerja &amp; pendapatan aset</h1></div>\n   <div style=\"display: flex; gap: 6px; flex-wrap: wrap\"><sc-for list=\"{{periods}}\" as=\"p\"><button type=\"button\" onClick=\"{{p.pick}}\" style=\"{{p.style}}\">{{p.label}}</button></sc-for><button type=\"button\" onClick=\"{{csv}}\" style=\"height: 36px; padding: 0 12px; border-radius: 18px; border: 1.5px solid #E3E7ED; background: #FFFFFF; color: #1F2B4D; font: 800 12.5px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">⤓ Unduh</button></div>\n  </div>\n  <sc-if value=\"{{loading}}\"><div class=\"cp-card\" style=\"text-align: center; color: #4A5468\">Memuat…</div></sc-if>\n  <sc-if value=\"{{err}}\"><div class=\"cp-card\" style=\"color: #A12A1F; font-weight: 700\">{{err}}</div></sc-if>\n  <sc-if value=\"{{ready}}\">\n  <section style=\"background: #1F2B4D; color: #FFFFFF; border-radius: 20px; padding: 16px 18px\">\n   <div style=\"font-size: 13px; opacity: .8; font-weight: 600\">Bersih aset {{days}} hari</div>\n   <div style=\"font-size: 30px; font-weight: 800; line-height: 38px\">{{net}}</div>\n   <div style=\"font-size: 12.5px; opacity: .85\">sewa {{rev}} − servis {{svc}} − bagi hasil mitra {{share}}</div>\n  </section>\n  <div class=\"ap-k\">\n   <a href=\"OpsKalender.dc.html\"><span>Unit tersewa</span><b>{{k.rented}}<span style=\"font-size: 15px; color: #6B7486\"> / {{k.units}}</span></b><span>utilisasi {{k.util}}</span></a>\n   <div><span>Uang masuk hari ini</span><b>{{k.today}}</b><span>{{k.todaySub}}</span></div>\n   <div style=\"border: 1.5px solid #F6C9C4\"><span>Nganggur ≥ 3 hari</span><b style=\"color: #C0392B\">{{k.idle}}</b><span>unit siap tapi tidak keluar</span></div>\n   <div><span>Balik modal</span><b>{{k.payback}}</b><span>{{k.paybackSub}}</span></div>\n  </div>\n  <sc-if value=\"{{stuckNote}}\"><a href=\"PosHariIni.dc.html\" style=\"display: block; background: #FFF6E5; color: #7A4B00; border-radius: 14px; padding: 12px 14px; font-size: 13.5px; line-height: 19px; font-weight: 700; text-decoration: none\">{{stuckNote}}</a></sc-if>\n  <sc-if value=\"{{tips}}\"><section class=\"cp-card\" style=\"border: 1.5px solid #CDEFEA; background: #F3FBFA\"><b style=\"font-size: 16px\">Saran hari ini</b>\n   <sc-for list=\"{{tips}}\" as=\"t\"><div style=\"display: flex; gap: 8px; font-size: 13.5px; line-height: 19px\"><span style=\"color: {{t.c}}\">●</span><span>{{t.t}}</span></div></sc-for>\n   <a class=\"cp-btn\" style=\"height: 46px; font-size: 14px\" href=\"OpsUnit.dc.html\">Atur mutasi unit</a></section></sc-if>\n\n  <section class=\"cp-card\"><div style=\"display: flex; justify-content: space-between; align-items: baseline\"><b style=\"font-size: 17px\">Per produk</b><span style=\"font-size: 12px; color: #6B7486\">ketuk untuk lihat per unit</span></div>\n   <div class=\"ap-desk\"><table class=\"ap-t\"><thead><tr><th>Produk</th><th>Pendapatan</th><th>Servis</th><th>Bersih</th><th>Utilisasi</th><th>Nganggur</th><th>Balik modal</th></tr></thead><tbody>\n    <sc-for list=\"{{prods}}\" as=\"p\"><tr onClick=\"{{p.toggle}}\" style=\"cursor: pointer\"><td><b>{{p.name}}</b><div style=\"font-size: 11.5px; color: #6B7486\">{{p.units}} unit · {{p.rented}} disewa</div></td><td>{{p.rev}}</td><td style=\"color: #C0392B\">{{p.svc}}</td><td><b>{{p.net}}</b></td><td style=\"min-width: 110px\"><div style=\"display: flex; gap: 6px; align-items: center; justify-content: flex-end\"><div class=\"ap-bar\" style=\"width: 60px\"><i style=\"{{p.bar}}\"></i></div>{{p.util}}</div></td><td style=\"color: {{p.idleC}}\">{{p.idle}}</td><td>{{p.payback}}</td></tr>\n     <sc-if value=\"{{p.open}}\"><tr><td colspan=\"7\" style=\"background: #F8FAFB; padding: 6px 10px\"><sc-for list=\"{{p.ulist}}\" as=\"u\"><div style=\"display: flex; justify-content: space-between; gap: 10px; font-size: 12.5px; padding: 5px 0; border-bottom: 1px dashed #E3E7ED\"><span><b>{{u.label}}</b> · {{u.branch}} · {{u.st}}</span><span>{{u.rev}} · servis {{u.svc}} · util {{u.util}} · {{u.payback}}</span></div></sc-for></td></tr></sc-if>\n    </sc-for></tbody></table></div>\n   <div class=\"ap-mob\"><sc-for list=\"{{prods}}\" as=\"p\"><button type=\"button\" class=\"ap-row\" onClick=\"{{p.toggle}}\">\n    <div style=\"display: flex; justify-content: space-between; gap: 8px\"><b style=\"font-size: 15px\">{{p.name}}</b><b style=\"font-size: 14px\">{{p.util}}</b></div>\n    <div style=\"display: flex; justify-content: space-between; gap: 8px; font-size: 12.5px; color: #4A5468; margin: 2px 0 6px\"><span>{{p.units}} unit · {{p.rented}} disewa · {{p.idle}} nganggur</span><span>bersih {{p.net}}</span></div>\n    <div class=\"ap-bar\"><i style=\"{{p.bar}}\"></i></div>\n    <sc-if value=\"{{p.open}}\"><div style=\"margin-top: 8px; background: #F8FAFB; border-radius: 12px; padding: 6px 10px\"><sc-for list=\"{{p.ulist}}\" as=\"u\"><div style=\"font-size: 12.5px; padding: 6px 0; border-bottom: 1px dashed #E3E7ED\"><b>{{u.label}}</b> · {{u.branch}} · {{u.st}}<br><span style=\"color: #4A5468\">{{u.rev}} · servis {{u.svc}} · util {{u.util}} · {{u.payback}}</span></div></sc-for></div></sc-if>\n   </button></sc-for></div>\n   <sc-if value=\"{{more}}\"><button type=\"button\" class=\"cp-btn2\" onClick=\"{{showMore}}\">{{more}}</button></sc-if>\n  </section>\n\n  <section class=\"cp-card\" id=\"idle\"><b style=\"font-size: 17px\">Unit nganggur ≥ 3 hari</b>\n   <sc-for list=\"{{idle}}\" as=\"u\"><div style=\"display: flex; justify-content: space-between; gap: 10px; font-size: 13px; padding: 8px 0; border-bottom: 1px solid #EEF0F3\"><span><b>{{u.label}}</b> · {{u.product}}<br><span style=\"color: #6B7486\">{{u.branch}}</span></span><b style=\"color: #C0392B; white-space: nowrap\">{{u.days}}</b></div></sc-for>\n   <sc-if value=\"{{noIdle}}\"><div style=\"font-size: 13px; color: #1E6B45; font-weight: 700\">Tidak ada unit nganggur.</div></sc-if>\n  </section>\n  <div style=\"font-size: 12px; line-height: 17px; color: #6B7486\">{{foot}}</div>\n  </sc-if>\n </main>\n</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{\"$preview\":{\"width\":390,\"height\":844}}'>\nclass Component extends DCLogic {\nstate = { days: 30, r: null, err: '', open: {}, all: false, today: null, stuck: 0 };\nasync componentDidMount() { await RA.staff(); this.load(); }\nasync load() {\n  const t0 = new Date(); t0.setHours(0, 0, 0, 0);\n  this.setState({ r: null, err: '' });\n  try {\n    const [r, py, st] = await Promise.all([\n      RA.call('asset_revenue', { p_days: this.state.days, p_branch: null }),\n      RA.from('payments').select('amount,kind').eq('status', 'paid').gte('paid_at', t0.toISOString()).limit(2000),\n      RA.from('bookings').select('id', { count: 'exact', head: true }).eq('status', 'confirmed').lt('start_at', new Date(Date.now() - 2 * 36e5).toISOString())\n    ]);\n    if (!RA_ALIVE(this)) return;\n    const today = (py.data || []).reduce((a, p) => a + (p.kind === 'refund' ? -Math.abs(+p.amount) : +p.amount), 0);\n    this.setState({ r, today, stuck: st.count || 0 });\n  } catch (e) { if (RA_ALIVE(this)) this.setState({ err: e.message || String(e) }); }\n}\nrenderVals() {\n  const s = this.state, r = s.r, now = new Date();\n  const sh = v => RA.rpShort ? RA.rpShort(v) : RA.rp(v);\n  const chip = on => 'height: 36px; padding: 0 14px; border-radius: 18px; cursor: pointer; font: 800 12.5px \\'Plus Jakarta Sans\\', sans-serif; ' + (on ? 'border: 0; background: #1F2B4D; color: #FFFFFF' : 'border: 1.5px solid #E3E7ED; background: #FFFFFF; color: #1F2B4D');\n  const periods = [[7, '7 hari'], [30, '30 hari'], [90, '90 hari']].map(([d, l]) => ({ label: l, style: chip(s.days === d), pick: () => { this.setState({ days: d }); setTimeout(() => this.load(), 0); } }));\n  if (!r) return { scope: 'Operasional · semua cabang', periods, loading: !s.err, err: s.err, ready: false, csv: () => {} };\n  const T = r.totals || {};\n  const ST = { ready: 'siap', rented: 'disewa', booked: 'dipesan', qc: 'QC', service: 'servis', waiting_part: 'tunggu part' };\n  const units = r.units || [];\n  const prods0 = (r.products || []).slice().sort((a, b) => (b.rev - a.rev) || (b.util - a.util) || (b.units - a.units));\n  const prods = (s.all ? prods0 : prods0.slice(0, 15)).map(p => { const u = +p.util || 0; return { name: p.name, units: p.units, rented: p.rented, idle: String(p.idle), idleC: p.idle ? '#C0392B' : '#1F2B4D', rev: sh(p.rev), svc: p.svc ? '−' + sh(p.svc) : '—', net: sh(p.net), util: u + '%',\n    bar: 'width: ' + Math.min(100, u) + '%; background: ' + (u >= 60 ? 'linear-gradient(90deg,#12B5A6,#077A70)' : u >= 30 ? '#F2B441' : '#E5534B'),\n    payback: p.payback != null ? p.payback + '%' : p.priced ? 'sebagian' : 'isi harga beli', open: !!s.open[p.id], toggle: () => this.setState({ open: Object.assign({}, s.open, { [p.id]: !s.open[p.id] }) }),\n    ulist: s.open[p.id] ? units.filter(x => x.product_id === p.id).map(x => ({ label: x.label, branch: x.branch || '—', st: ST[x.status] || x.status, rev: sh(x.rev), svc: x.svc ? sh(x.svc) : 'Rp0', util: (x.util || 0) + '%', payback: x.payback != null ? 'balik modal ' + x.payback + '%' : 'harga beli belum diisi' })) : [] }; });\n  const idle = (r.idle_units || []).slice(0, 12).map(u => ({ label: u.label, product: u.product, branch: u.branch || '—', days: u.since ? u.days + ' hari' : 'belum pernah keluar' }));\n  const tips = [];\n  const byBr = {}; (r.idle_units || []).forEach(u => { byBr[u.branch || '—'] = (byBr[u.branch || '—'] || 0) + 1; });\n  const topIdle = Object.keys(byBr).sort((a, b) => byBr[b] - byBr[a])[0];\n  if (topIdle) tips.push({ t: byBr[topIdle] + ' unit nganggur ≥ 3 hari di ' + topIdle + ' → pindahkan ke cabang yang ramai atau dorong promo lewat CS.', c: '#C0392B' });\n  const lowP = prods0.filter(p => p.units >= 2 && (+p.util || 0) < 30 && p.idle > 0).slice(0, 2);\n  lowP.forEach(p => tips.push({ t: p.name + ': utilisasi ' + (p.util || 0) + '%, ' + p.idle + ' unit nganggur → aktifkan promo atau kurangi stok.', c: '#E0A21B' }));\n  if (s.stuck) tips.push({ t: s.stuck + ' booking sudah lewat jam ambil tapi serah terimanya belum dicatat, jadi pendapatannya belum masuk laporan ini.', c: '#1E5AA8' });\n  const csvRows = [['Produk', 'Unit', 'Disewa', 'Nganggur', 'Pendapatan', 'Servis', 'Bersih', 'Utilisasi %', 'Balik modal %']].concat(prods0.map(p => [p.name, p.units, p.rented, p.idle, p.rev, p.svc, p.net, p.util, p.payback == null ? '' : p.payback]));\n  return {\n    scope: 'Operasional · semua cabang · ' + RA.HARIL[now.getDay()] + ', ' + RA.date(now), periods, loading: false, err: '', ready: true, days: r.days,\n    net: RA.rp((T.rev || 0) - (T.svc || 0)), rev: sh(T.rev || 0), svc: sh(T.svc || 0), share: 'Rp0',\n    k: { rented: String(T.rented || 0), units: String(T.units || 0), util: (T.util == null ? '—' : T.util + '%') + ' · ' + r.days + ' hari', today: sh(s.today || 0), todaySub: 'semua pembayaran lunas hari ini', idle: String(T.idle || 0),\n      payback: T.priced ? Math.round(100 * (T.life_rev || 0) / Math.max(1, T.cost || 0)) + '%' : '—', paybackSub: T.priced ? T.priced + ' unit sudah ada harga beli' : 'harga beli unit belum diisi' },\n    stuckNote: s.stuck ? '⚠ ' + s.stuck + ' booking lewat jam ambil belum dicatat serah terimanya. Pendapatan & utilisasi di sini baru akurat setelah dibereskan.' : '',\n    tips, prods, more: prods0.length > 15 ? (s.all ? 'Ringkas' : 'Tampilkan semua ' + prods0.length + ' produk') : '', showMore: () => this.setState({ all: !s.all }),\n    idle, noIdle: !idle.length,\n    foot: 'Pendapatan = nilai sewa dari booking yang sudah diserahkan (mulai dalam periode). Servis = biaya work order. Utilisasi = jam disewa ÷ jam tersedia. Bagi hasil mitra & balik modal terisi setelah unit punya mitra dan harga beli (Aset Tetap / Lengkapi data unit). Data yang sama dipakai di Keuangan › Laporan.',\n    csv: () => { const t = csvRows.map(a => a.map(x => '\"' + String(x).replace(/\"/g, '\"\"') + '\"').join(',')).join('\\n'); const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([t], { type: 'text/csv' })); a.download = 'pendapatan-aset-' + r.days + 'hari.csv'; a.click(); }\n  };\n}\n}\n</script>\n</body>\n</html>\n"}