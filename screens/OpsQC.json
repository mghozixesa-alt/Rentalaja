{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Kualitas layanan</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0}\n#okRoot{max-width:1180px;margin:0 auto;padding:24px 24px 48px;box-sizing:border-box;display:flex;flex-direction:column;gap:16px}\n#okRoot h1{margin:0;font-size:28px;font-weight:800;letter-spacing:-.01em}\n#okRoot h2{margin:0 0 10px;font-size:17px;font-weight:800}\n#okRoot .ok-sub{color:#4A5468;font-size:14px;margin-top:4px}\n#okRoot .ok-row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}\n#okRoot .ok-btn{height:40px;padding:0 14px;border-radius:12px;border:1px solid #1F2B4D;background:#FFFFFF;color:#1F2B4D;font:700 14px 'Plus Jakarta Sans',system-ui,sans-serif;cursor:pointer;display:inline-flex;align-items:center;gap:6px;text-decoration:none}\n#okRoot .ok-btn.pri{background:#09BEAF;border-color:#09BEAF;color:#1F2B4D}\n#okRoot .ok-btn.sm{height:32px;padding:0 10px;font-size:13px;border-radius:10px;border-color:#D5D9E0}\n#okRoot .ok-btn.sm.pri{border-color:#09BEAF}\n#okRoot .ok-tabs{display:flex;gap:6px;background:#FFFFFF;border:1px solid #E6E8EC;border-radius:14px;padding:5px;width:max-content;max-width:100%;overflow-x:auto}\n#okRoot .ok-tab{height:36px;padding:0 16px;border-radius:10px;border:0;background:transparent;color:#4A5468;font:700 14px 'Plus Jakarta Sans',system-ui,sans-serif;cursor:pointer;white-space:nowrap;display:inline-flex;align-items:center;gap:6px}\n#okRoot .ok-tab.on{background:#1F2B4D;color:#FFFFFF}\n#okRoot .ok-tab i{font-style:normal;background:#D93025;color:#FFFFFF;border-radius:9px;font-size:11px;padding:1px 6px}\n#okRoot .ok-wk{width:100%;border-collapse:separate;border-spacing:4px;table-layout:fixed}\n#okRoot .ok-wk th{text-align:center;border:0;padding:2px}#okRoot .ok-wk th:first-child{text-align:left;width:150px}\n#okRoot .ok-wk th small{display:block;font-weight:600;color:#8A93A3}#okRoot .ok-wk th.today{color:#077A70}\n#okRoot .ok-wk td{border:0;padding:0}\n#okRoot .ok-wk td.nm{font-weight:800;font-size:13.5px;padding-right:6px;vertical-align:middle}#okRoot .ok-wk td.nm small{display:block;font-weight:600;color:#4A5468;font-size:11.5px}\n#okRoot .ok-wk tr.grp td{padding:10px 2px 2px;font-size:11.5px;font-weight:800;color:#8A93A3;letter-spacing:.05em;text-transform:uppercase}\n#okRoot .ok-cell{display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;box-sizing:border-box;width:100%;min-height:46px;border-radius:10px;border:1.5px dashed #D5D9E0;background:#FFFFFF;font:700 12.5px/16px 'Plus Jakarta Sans',system-ui,sans-serif;color:#8A93A3;cursor:pointer;padding:5px 2px}\n#okRoot .ok-cell.P{background:#E3F7F5;color:#077A70;border:0}#okRoot .ok-cell.S{background:#E5EEF9;color:#1E5AA8;border:0}#okRoot .ok-cell.M{background:#EDE7FB;color:#5B3FB0;border:0}\n#okRoot .ok-cell.L{background:#F4F6F9;color:#9AA2B1;border:0}#okRoot .ok-cell.C{background:#FFF6E0;color:#7A5200;border:0;cursor:default}#okRoot .ok-cell.H{background:#FBE9E7;color:#A12A1F;border:0}\n#okRoot .ok-cell small{display:block;font-weight:600;font-size:11px;opacity:.85}\n#okRoot .ok-warn{background:#FFF6E0;color:#7A5200;font-size:13px;border-radius:10px;padding:8px 12px;margin-top:6px}\n#okRoot .ok-leg{display:flex;gap:12px;flex-wrap:wrap;font-size:12px;color:#4A5468;margin-top:10px;align-items:center}#okRoot .ok-leg i{width:14px;height:14px;border-radius:4px;display:inline-block;vertical-align:-2px;margin-right:4px}\n#okRoot .ok-trk{display:flex;align-items:center;gap:4px;margin-top:6px;font-size:11px;font-weight:700;flex-wrap:wrap}#okRoot .ok-trk em{font-style:normal;padding:2px 8px;border-radius:999px;background:#EEF0F3;color:#8A93A3}#okRoot .ok-trk em.d{background:#E3F7F5;color:#077A70}#okRoot .ok-trk em.n{background:#1F2B4D;color:#FFFFFF}\n#okRoot .ok-av{width:36px;height:36px;border-radius:18px;background:#E3F7F5;color:#077A70;font-weight:800;font-size:12.5px;display:flex;align-items:center;justify-content:center;flex-shrink:0}\n#okRoot .ok-kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}\n#okRoot .ok-kpi{background:#FFFFFF;border:1px solid #E6E8EC;border-radius:16px;padding:14px 16px}\n#okRoot .ok-kpi span{font-size:13px;font-weight:700;color:#4A5468}#okRoot .ok-kpi b{display:block;font-size:26px;font-weight:800;margin:2px 0}#okRoot .ok-kpi small{font-size:12.5px;color:#4A5468}\n#okRoot .ok-card{background:#FFFFFF;border:1px solid #E6E8EC;border-radius:18px;padding:18px}\n#okRoot .ok-card.hot{border-color:#09BEAF;background:#F1FBFA}\n#okRoot .ok-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:16px}\n#okRoot table{width:100%;border-collapse:collapse;font-size:14px}\n#okRoot th{text-align:left;font-size:12.5px;color:#4A5468;font-weight:700;padding:8px 10px;border-bottom:1px solid #E6E8EC}\n#okRoot td{padding:10px;border-bottom:1px solid #EEF0F3;vertical-align:top}\n#okRoot .ok-scroll{overflow-x:auto}\n#okRoot .ok-chip{display:inline-flex;align-items:center;padding:3px 9px;border-radius:999px;font-size:12px;font-weight:700;background:#EEF0F3;color:#4A5468;white-space:nowrap}\n#okRoot .ok-chip.g{background:#E3F7F5;color:#077A70}#okRoot .ok-chip.y{background:#FFF6E0;color:#7A5200}#okRoot .ok-chip.r{background:#FBE9E7;color:#A12A1F}#okRoot .ok-chip.b{background:#E5EEF9;color:#1E5AA8}\n#okRoot .ok-li{display:flex;gap:10px;align-items:center;flex-wrap:wrap;padding:10px 0;border-top:1px solid #EEF0F3}#okRoot .ok-li:first-child{border-top:0}\n#okRoot .ok-mut{color:#4A5468;font-size:12.5px}\n#okRoot details summary{cursor:pointer;list-style:none}#okRoot details summary::-webkit-details-marker{display:none}\n.ok-modal{position:fixed;inset:0;background:rgba(31,43,77,.45);display:flex;align-items:center;justify-content:center;z-index:1000;padding:16px}\n.ok-modal form{background:#FFFFFF;border-radius:18px;padding:20px;width:100%;max-width:480px;max-height:90vh;overflow:auto;display:flex;flex-direction:column;gap:12px;font-family:'Plus Jakarta Sans',system-ui,sans-serif;color:#1F2B4D}\n.ok-modal h3{margin:0;font-size:18px;font-weight:800}\n.ok-modal label{display:flex;flex-direction:column;gap:5px;font-size:13px;font-weight:700}\n.ok-modal input,.ok-modal select,.ok-modal textarea{height:42px;border:1px solid #D5D9E0;border-radius:10px;padding:0 10px;font:500 14px 'Plus Jakarta Sans',system-ui,sans-serif;color:#1F2B4D;background:#FFFFFF}\n.ok-modal textarea{height:auto;padding:10px}\n.ok-modal .g2{display:grid;grid-template-columns:1fr 1fr;gap:10px}\n.ok-modal .act{display:flex;gap:10px;justify-content:flex-end}\n.ok-modal .act button{height:42px;padding:0 16px;border-radius:12px;border:1px solid #D5D9E0;background:#FFFFFF;font:700 14px 'Plus Jakarta Sans',system-ui,sans-serif;cursor:pointer;color:#1F2B4D}\n.ok-modal .act button.pri{background:#09BEAF;border-color:#09BEAF}\n.ok-modal .err{color:#A12A1F;font-size:13px;font-weight:700}\n@media (max-width:900px){#okRoot{padding:16px 16px 96px}#okRoot .ok-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}#okRoot .ok-grid{grid-template-columns:minmax(0,1fr)}#okRoot h1{font-size:23px}}\n</style>\n</helmet>\n<div style=\"min-height: 100vh; box-sizing: border-box; background: #F4F6F9; color: #1F2B4D; font-family: 'Plus Jakarta Sans', system-ui, sans-serif\">\n  <div id=\"okRoot\"><div style=\"padding: 40px; color: #4A5468\">Memuat…</div></div>\n</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{}'>\nclass Component extends DCLogic {\nstate = {};\nrenderVals() { return {}; }\ncomponentDidMount() { this.days = 30; this.load(); }\nesc(s) { return String(s == null ? '' : s).replace(/[&<>\"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c])); }\nbox() { return document.getElementById('okRoot'); }\ndt(t) { if (!t) return '—'; const d = new Date(t); return d.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', timeZone: 'Asia/Jakarta' }) + ' ' + d.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Jakarta' }).replace(':', '.'); }\nago(t) { const m = Math.max(0, Math.round((Date.now() - new Date(t)) / 6e4)); return m < 60 ? m + ' mnt' : m < 1440 ? Math.round(m / 60) + ' jam' : Math.round(m / 1440) + ' hari'; }\nasync load() { const el = this.box(); if (!el) return; const r = await RA.rpc('ops_quality', { p_days: this.days }); if (r.error) { el.innerHTML = '<div class=\"ok-card\"><h2>Belum bisa dibuka</h2><p class=\"ok-mut\">' + this.esc(r.error.message) + '</p></div>'; return; } this.Q = r.data; const s2 = await RA.rpc('ops_sop_score', { p_days: this.days }); this.S = s2.error ? null : s2.data; this.draw(); }\ndraw() {\n  const e = this.esc.bind(this), Q = this.Q, chip = (t, c) => '<span class=\"ok-chip ' + (c || '') + '\">' + e(t) + '</span>';\n  const stars = n => '★★★★★'.slice(0, n) + '☆☆☆☆☆'.slice(0, 5 - n);\n  const T = Q.tickets || [], LR = Q.late_run || [], LB = Q.late_back || [], RV = Q.reviews || [], BR = (Q.branches || []).filter(b => b.reviews || b.tickets || b.open || b.late_run);\n  const late = T.filter(t => t.late).length;\n  const PRI = { high: ['tinggi', 'r'], urgent: ['mendesak', 'r'], medium: ['sedang', 'y'], low: ['rendah', ''] };\n  this.box().innerHTML = '<div class=\"ok-row\" style=\"justify-content:space-between;align-items:flex-end\"><div><h1>Kualitas layanan</h1><div class=\"ok-sub\">Skor otomatis dari jalannya SOP di setiap sewa, ditambah ulasan, keluhan, dan ketepatan waktu.</div></div>'\n    + '<div class=\"ok-row\">' + [7, 30, 90].map(n => '<button class=\"ok-btn sm' + (this.days === n ? ' pri' : '') + '\" data-days=\"' + n + '\">' + n + ' hari</button>').join('') + '</div></div>'\n    + (this.S ? (() => { const S = this.S, sc = S.score == null ? '—' : S.score, col = S.score == null ? '#4A5468' : S.score >= 80 ? '#1E6B45' : S.score >= 60 ? '#8A4B00' : '#A12A1F', d = (S.score != null && S.score_prev != null) ? S.score - S.score_prev : null;\n      const bar = p => '<div style=\"height:8px;border-radius:8px;background:#EEF0F3;overflow:hidden;flex:1;min-width:80px\"><div style=\"height:8px;width:' + (p || 0) + '%;background:' + ((p || 0) >= 80 ? '#1E8E4E' : (p || 0) >= 60 ? '#D08B00' : '#D93025') + '\"></div></div>';\n      const lst = (L, t) => '<div class=\"ok-card\"><h2>' + t + '</h2>' + (L.length ? L.map(x => '<div class=\"ok-li\" style=\"gap:10px\"><span style=\"flex:1;min-width:120px\"><b>' + e(x.name) + '</b> <span class=\"ok-mut\">· ' + x.n + ' sewa</span></span>' + bar(x.score) + '<b style=\"width:40px;text-align:right\">' + (x.score == null ? '—' : x.score) + '</b></div>').join('') : '<p class=\"ok-mut\">Belum ada data.</p>') + '</div>';\n      return '<div class=\"ok-card\" style=\"display:flex;gap:24px;flex-wrap:wrap;align-items:center\"><div style=\"min-width:180px\"><div class=\"ok-mut\" style=\"font-weight:800;font-size:12px;letter-spacing:.06em;text-transform:uppercase\">Skor kualitas layanan (SOP)</div><div style=\"font-size:56px;line-height:64px;font-weight:800;color:' + col + '\">' + sc + '<span style=\"font-size:20px;color:#4A5468\">/100</span></div><div class=\"ok-mut\">' + S.n + ' sewa · ' + this.days + ' hari terakhir' + (d != null ? ' · ' + (d >= 0 ? '▲ ' : '▼ ') + Math.abs(d) + ' dari periode sebelumnya' : '') + '</div></div>'\n        + '<div style=\"flex:1;min-width:280px;display:flex;flex-direction:column;gap:8px\">' + (S.items || []).map(it => '<div style=\"display:flex;gap:10px;align-items:center;font-size:13.5px\"><span style=\"width:230px;max-width:55%\">' + e(it.label) + ' <span class=\"ok-mut\">(' + it.pts + ' poin)</span></span>' + bar(it.pct) + '<b style=\"width:52px;text-align:right\">' + (it.pct == null ? '—' : it.pct + '%') + '</b></div>').join('') + '</div></div>'\n        + '<div class=\"ok-grid\">' + lst(S.branches || [], 'Skor per cabang') + lst(S.staff || [], 'Skor per petugas serah terima') + '</div>'\n        + ((S.misses || []).length ? '<div class=\"ok-card\"><h2>Sewa dengan SOP paling banyak terlewat</h2>' + S.misses.map(m => '<div class=\"ok-li\"><span style=\"flex:1;min-width:200px\"><b>' + e(m.code) + '</b> <span class=\"ok-mut\">· ' + e(m.branch || '') + (m.staff ? ' · ' + e(m.staff) : '') + '</span><br><span style=\"font-size:12.5px;color:#A12A1F\">Terlewat: ' + e((m.miss || []).join(', ')) + '</span></span><b>' + m.score + '</b></div>').join('') + '</div>' : '')\n        + '<div class=\"ok-mut\" style=\"font-size:12.5px\">Cara hitung: tiap sewa dinilai dari 9 poin SOP di atas (bobot dalam poin). Skor = poin terpenuhi ÷ poin yang berlaku. Diperbarui otomatis dari data serah terima, verifikasi, pembayaran, keluhan, dan ulasan.</div>'; })() : '')\n    + '<div class=\"ok-kpis\"><div class=\"ok-kpi\"><span>Rating ulasan</span><b>' + (Q.rating ? String(Q.rating).replace('.', ',') + ' ★' : '—') + '</b><small>' + (Q.n_reviews ? 'dari ' + Q.n_reviews + ' ulasan' : 'belum ada ulasan') + '</small></div>'\n    + '<div class=\"ok-kpi\"><span>Keluhan terbuka</span><b style=\"color:' + (T.length ? '#A12A1F' : '#1F2B4D') + '\">' + T.length + '</b><small>' + (late ? late + ' lewat batas waktu' : 'semua dalam batas waktu') + ' · ' + (Q.tickets_closed || 0) + ' selesai' + (Q.satisfaction ? ' · puas ' + Q.satisfaction + '/5' : '') + '</small></div>'\n    + '<div class=\"ok-kpi\"><span>Antar-jemput tepat waktu</span><b>' + (Q.run_ontime == null ? '—' : Q.run_ontime + '%') + '</b><small>' + (LR.length ? LR.length + ' sedang terlambat' : 'tidak ada yang terlambat') + '</small></div>'\n    + '<div class=\"ok-kpi\"><span>Telat kembali</span><b style=\"color:' + (LB.length ? '#A12A1F' : '#1F2B4D') + '\">' + LB.length + '</b><small>sewa aktif lewat jam kembali</small></div></div>'\n    + '<div class=\"ok-grid\"><div class=\"ok-card\"><div class=\"ok-row\" style=\"justify-content:space-between\"><h2 style=\"margin:0\">Keluhan terbuka</h2><a class=\"ok-btn sm\" href=\"TiketCS.dc.html\">Buka Keluhan →</a></div>'\n    + (T.map(t => '<div class=\"ok-li\"><span style=\"flex:1;min-width:200px\"><b>' + e(t.code || '') + '</b> ' + chip((PRI[t.priority] || [t.priority || '—'])[0], (PRI[t.priority] || ['', ''])[1]) + (t.late ? ' ' + chip('lewat batas', 'r') : '') + '<br>' + e(t.summary || t.category || '') + '<br><span class=\"ok-mut\">' + e(t.branch || '') + (t.pic ? ' · PIC ' + e(t.pic) : ' · belum ada PIC') + ' · ' + this.ago(t.at) + ' lalu</span></span></div>').join('') || '<p class=\"ok-mut\">Tidak ada keluhan terbuka. 👍</p>') + '</div>'\n    + '<div class=\"ok-card\"><h2>Perlu dikejar sekarang</h2>'\n    + (LR.map(r => '<div class=\"ok-li\"><span style=\"flex:1\">' + chip(r.kind === 'pickup' ? 'Jemput telat' : 'Antar telat', 'y') + ' <b>' + e(r.code || '') + '</b><br><span class=\"ok-mut\">' + e(r.branch || '') + ' · jadwal ' + this.dt(r.scheduled_at) + (r.runner ? ' · ' + e(r.runner) : ' · belum ada runner') + '</span></span><a class=\"ok-btn sm\" href=\"PosHariIni.dc.html\">Cek</a></div>').join('')\n    + LB.map(b => '<div class=\"ok-li\"><span style=\"flex:1\">' + chip('Telat kembali', 'r') + ' <b>' + e(b.code) + '</b> ' + e(b.item || '') + '<br><span class=\"ok-mut\">' + e(b.branch || '') + ' · seharusnya ' + this.dt(b.end_at) + ' · lewat ' + this.ago(b.end_at) + '</span></span><a class=\"ok-btn sm\" href=\"PosHariIni.dc.html\">Buka</a></div>').join('')\n    || '<p class=\"ok-mut\">Semua antar-jemput dan pengembalian sesuai jadwal.</p>') + '</div></div>'\n    + '<div class=\"ok-grid\"><div class=\"ok-card\"><h2>Ulasan terbaru</h2>' + (RV.slice(0, 12).map(v => '<div class=\"ok-li\" style=\"align-items:flex-start\"><span style=\"flex:1\"><b style=\"color:' + (v.rating <= 3 ? '#A12A1F' : '#C77C00') + '\">' + stars(v.rating) + '</b> <span class=\"ok-mut\">' + e(v.product || '') + (v.branch ? ' · ' + e(v.branch) : '') + ' · ' + this.ago(v.at) + ' lalu</span>' + (v.body ? '<br>' + e(v.body) : '') + ((v.tags || []).length ? '<br>' + v.tags.map(t => chip(t)).join(' ') : '') + '</span></div>').join('') || '<p class=\"ok-mut\">Belum ada ulasan di periode ini.</p>') + '</div>'\n    + '<div class=\"ok-card\"><h2>Per cabang</h2>' + (BR.length ? '<table><thead><tr><th>Cabang</th><th>Rating</th><th>Keluhan</th><th>Terbuka</th><th>Antar telat</th></tr></thead><tbody>' + BR.map(b => '<tr><td><b>' + e(b.name) + '</b></td><td>' + (b.rating ? String(b.rating).replace('.', ',') + ' ★ <span class=\"ok-mut\">(' + b.reviews + ')</span>' : '—') + '</td><td>' + b.tickets + '</td><td' + (b.open ? ' style=\"color:#A12A1F;font-weight:700\"' : '') + '>' + b.open + '</td><td>' + b.late_run + '</td></tr>').join('') + '</tbody></table>' : '<p class=\"ok-mut\">Belum ada data di periode ini.</p>') + '</div></div>';\n  this.box().onclick = ev => { const b = ev.target.closest('[data-days]'); if (b) { this.days = +b.dataset.days; this.load(); } };\n}\n}\n</script>\n</body>\n</html>"}