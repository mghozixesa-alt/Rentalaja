{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Cek calon penyewa</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0}\n.cp-card{background:#FFFFFF;border-radius:20px;box-shadow:0 2px 12px rgba(31,43,77,.06);padding:16px;display:flex;flex-direction:column;gap:12px}\n.cp-in{height:50px;box-sizing:border-box;border:2px solid #CDEFEA;border-radius:14px;padding:0 14px;font:700 16px 'Plus Jakarta Sans',sans-serif;color:#1F2B4D;background:#FFFFFF;width:100%}\n.cp-btn{height:50px;border:0;border-radius:14px;background:linear-gradient(135deg,#12B5A6,#077A70);color:#FFFFFF;font:800 15px 'Plus Jakarta Sans',sans-serif;cursor:pointer;display:flex;align-items:center;justify-content:center;text-decoration:none;width:100%}\n.cp-btn2{height:46px;border:1.5px solid #E3E7ED;border-radius:14px;background:#FFFFFF;color:#1F2B4D;font:800 14px 'Plus Jakarta Sans',sans-serif;cursor:pointer;display:flex;align-items:center;justify-content:center;text-decoration:none}\n.cp-st{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}\n.cp-st div{background:#F6F7F9;border-radius:14px;padding:10px 12px}\n.cp-st b{display:block;font-size:20px;line-height:26px}\n.cp-st span{font-size:12px;color:#4A5468}\n.cp-kv{display:flex;justify-content:space-between;gap:10px;font-size:13.5px;padding:9px 0;border-bottom:1px solid #EEF0F3}\n.cp-kv:last-child{border-bottom:0}.cp-kv span{color:#5B6577}.cp-kv b{text-align:right}\n.cp-rad{display:flex;align-items:center;gap:10px;min-height:48px;border:1.5px solid #E3E7ED;border-radius:14px;padding:0 14px;font:700 14px 'Plus Jakarta Sans',sans-serif;color:#1F2B4D;background:#FFFFFF;cursor:pointer;text-align:left;width:100%}\n.cp-rad i{width:18px;height:18px;border-radius:50%;border:2px solid #B4BCC8;flex:none;box-sizing:border-box}\n.cp-rad.on{border-color:#077A70;background:#F2FBFA}.cp-rad.on i{border:6px solid #077A70}\n</style>\n</helmet>\n<div style=\"min-height: 100vh; box-sizing: border-box; background: #F4F6F9; color: #1F2B4D; font-family: 'Plus Jakarta Sans', system-ui, sans-serif\">\n <main style=\"max-width: 640px; margin: 0 auto; padding: 18px 16px 28px; display: flex; flex-direction: column; gap: 14px\">\n  <div><div style=\"font-size: 13px; font-weight: 700; color: #5B6577\">{{scope}}</div><h1 style=\"margin: 2px 0 0; font-size: 26px; line-height: 32px\">Cek calon penyewa</h1>\n   <div style=\"font-size: 13px; line-height: 19px; color: #4A5468; margin-top: 4px\">Cek dulu sebelum terima booking: riwayat sewa, telat, kerusakan, tunggakan, dan blokir di semua cabang.</div></div>\n  <section class=\"cp-card\">\n   <div style=\"display: flex; gap: 6px\"><sc-for list=\"{{modes}}\" as=\"m\"><button type=\"button\" onClick=\"{{m.pick}}\" style=\"{{m.style}}\">{{m.label}}</button></sc-for></div>\n   <input class=\"cp-in\" type=\"{{inType}}\" inputmode=\"{{inMode}}\" placeholder=\"{{ph}}\" value=\"{{q}}\" onInput=\"{{setQ}}\" onKeyDown=\"{{onKey}}\" autocomplete=\"off\">\n   <button type=\"button\" class=\"cp-btn\" onClick=\"{{run}}\" disabled=\"{{busy}}\">{{btnLabel}}</button>\n   <sc-if value=\"{{err}}\"><div style=\"font-size: 13px; color: #A12A1F; font-weight: 700\">{{err}}</div></sc-if>\n  </section>\n\n  <sc-if value=\"{{resTitle}}\"><div style=\"font-size: 13px; font-weight: 700; color: #5B6577; margin-bottom: -6px\">{{resTitle}}</div></sc-if>\n\n  <sc-if value=\"{{blOnly}}\"><section class=\"cp-card\" style=\"border: 2px solid #F6C9C4\">\n   <div style=\"display: flex; gap: 12px; align-items: center\"><span style=\"width: 48px; height: 48px; border-radius: 14px; background: #FDE8E6; color: #C0392B; font-weight: 800; display: flex; align-items: center; justify-content: center\">!</span><span style=\"flex: 1\"><b style=\"font-size: 17px\">{{blOnly.name}}</b><span style=\"display: block; font-size: 12.5px; color: #4A5468\">Ada di daftar hitam (belum punya akun)</span></span><span style=\"height: 28px; padding: 0 10px; border-radius: 14px; background: #FDE8E6; color: #C0392B; font-size: 12.5px; font-weight: 800; display: flex; align-items: center\">⛔ Diblokir</span></div>\n   <div style=\"background: #FDECEA; color: #A12A1F; border-radius: 14px; padding: 12px 14px; font-size: 14px; line-height: 20px; font-weight: 700\">{{blOnly.reason}}</div>\n  </section></sc-if>\n\n  <sc-for list=\"{{cards}}\" as=\"c\"><section class=\"cp-card\" style=\"border: 2px solid {{c.border}}\">\n   <div style=\"display: flex; gap: 12px; align-items: center\">\n    <span style=\"width: 48px; height: 48px; border-radius: 14px; background: {{c.avBg}}; color: {{c.avFg}}; font-size: 16px; font-weight: 800; display: flex; align-items: center; justify-content: center; flex: none\">{{c.ini}}</span>\n    <span style=\"flex: 1; min-width: 0\"><b style=\"font-size: 17px; display: block\">{{c.name}}</b><span style=\"font-size: 12.5px; color: #4A5468\">{{c.sub}}</span></span>\n    <span style=\"{{c.chip}}\">{{c.tag}}</span></div>\n   <sc-if value=\"{{c.why}}\"><div style=\"border-radius: 14px; padding: 12px 14px; font-size: 13.5px; line-height: 19px; font-weight: 700; background: {{c.whyBg}}; color: {{c.whyFg}}\">{{c.why}}</div></sc-if>\n   <div class=\"cp-st\"><sc-for list=\"{{c.st}}\" as=\"x\"><div><b style=\"color: {{x.c}}\">{{x.v}}</b><span>{{x.l}}</span></div></sc-for></div>\n   <div><sc-for list=\"{{c.kv}}\" as=\"k\"><div class=\"cp-kv\"><span>{{k.l}}</span><b style=\"color: {{k.c}}\">{{k.v}}</b></div></sc-for></div>\n   <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 8px\"><a class=\"cp-btn2\" href=\"{{c.prof}}\">Lihat profil</a><sc-if value=\"{{c.canBook}}\"><a class=\"cp-btn\" style=\"height: 46px; font-size: 14px\" href=\"PosKasir.dc.html\">Buat booking</a></sc-if><sc-if value=\"{{c.canBook}}\" not><span class=\"cp-btn2\" style=\"color: #A12A1F; border-color: #F6C9C4; background: #FDF3F2\">Jangan diterima</span></sc-if></div>\n  </section></sc-for>\n\n  <sc-if value=\"{{showNew}}\"><section class=\"cp-card\">\n   <div style=\"display: flex; gap: 12px; align-items: center\"><span style=\"width: 48px; height: 48px; border-radius: 14px; background: #FFF0DC; color: #B46A00; font-size: 18px; font-weight: 800; display: flex; align-items: center; justify-content: center\">?</span><span style=\"flex: 1\"><b style=\"font-size: 17px; display: block\">Belum pernah sewa</b><span style=\"font-size: 12.5px; color: #4A5468\">{{newSub}}</span></span><span style=\"height: 28px; padding: 0 10px; border-radius: 14px; background: #FFF0DC; color: #9A5B00; font-size: 12.5px; font-weight: 800; display: flex; align-items: center\">Baru</span></div>\n   <div style=\"background: #FFF6E5; color: #7A4B00; border-radius: 14px; padding: 12px 14px; font-size: 13.5px; line-height: 19px; font-weight: 700\">Wajib verifikasi lengkap: KTP + KK + 1 dokumen pendukung, nomor darurat se-KK, cek GetContact.</div>\n   <a class=\"cp-btn\" href=\"PosKasir.dc.html\">Daftarkan &amp; buat booking</a>\n  </section></sc-if>\n\n  <section class=\"cp-card\" style=\"gap: 8px\">\n   <b style=\"font-size: 15px\">Aturan penilaian</b>\n   <div style=\"font-size: 13px; line-height: 19px; color: #3A4458\"><b style=\"color: #1E7A3F\">● Aman</b>: tidak diblokir, tunggakan Rp0, telat ≤ 1× dalam 6 bulan.</div>\n   <div style=\"font-size: 13px; line-height: 19px; color: #3A4458\"><b style=\"color: #B46A00\">● Hati-hati</b>: telat ≥ 2× dalam 6 bulan, pernah ada klaim kerusakan, atau ditandai waspada → minta DP penuh / jaminan tambahan.</div>\n   <div style=\"font-size: 13px; line-height: 19px; color: #3A4458\"><b style=\"color: #C0392B\">● Tolak</b>: diblokir atau masih ada tunggakan.</div>\n   <div style=\"font-size: 12px; color: #6B7486\">NIK hanya tampil 4 digit terakhir. Pencarian dicatat sistem.</div>\n  </section>\n </main>\n</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{\"$preview\":{\"width\":390,\"height\":844}}'>\nclass Component extends DCLogic {\nstate = { mode: 'phone', q: '', res: null, busy: false, err: '' };\nasync componentDidMount() { await RA.staff(); const p = new URLSearchParams((location.hash.split('?')[1]) || ''); if (p.get('q')) { this.setState({ q: p.get('q'), mode: p.get('m') || 'phone' }); setTimeout(() => this.run(), 0); } }\nasync run() {\n  const q = String(this.state.q || '').trim(); if (q.length < 3) return this.setState({ err: 'Ketik minimal 3 karakter.' });\n  this.setState({ busy: true, err: '' });\n  try { const r = await RA.call('cs_check_customer', { p_q: q, p_mode: this.state.mode }); if (RA_ALIVE(this)) this.setState({ res: r, busy: false }); }\n  catch (e) { if (RA_ALIVE(this)) this.setState({ busy: false, err: e.message || String(e), res: null }); }\n}\nrenderVals() {\n  const s = this.state, br = RA.staffBranch ? RA.staffBranch() : null, now = new Date();\n  const chipM = on => 'height: 38px; padding: 0 16px; border-radius: 19px; cursor: pointer; font: 800 13.5px \\'Plus Jakarta Sans\\', sans-serif; ' + (on ? 'border: 0; background: #1F2B4D; color: #FFFFFF' : 'border: 1.5px solid #E3E7ED; background: #FFFFFF; color: #1F2B4D');\n  const L = { aman: ['✓ Aman', '#E4F4E9', '#1E7A3F', '#CDEFEA'], hati: ['⚠ Hati-hati', '#FFF0DC', '#9A5B00', '#F7DDB0'], tolak: ['⛔ Tolak', '#FDE8E6', '#C0392B', '#F6C9C4'], baru: ['Baru', '#FFF0DC', '#9A5B00', '#F7DDB0'] };\n  const ini = n => String(n || '?').split(/\\s+/).filter(Boolean).slice(0, 2).map(x => x[0]).join('').toUpperCase();\n  const mon = d => { const t = new Date(d); return RA.BULAN[t.getMonth()].slice(0, 3) + ' ' + t.getFullYear(); };\n  const r = s.res, list = (r && r.list) || [];\n  const DOC = { ktp: 'KTP', kk: 'KK', sim: 'SIM', stnk: 'STNK', npwp: 'NPWP', paspor: 'Paspor', lainnya: 'Dok. lain' };\n  const cards = list.map(c => { const l = L[c.label] || L.aman; const bl = c.blacklist;\n    const why = c.label === 'tolak' && bl ? ('Diblokir' + (bl.at ? ' ' + RA.date(bl.at) : '') + (bl.by ? ' oleh ' + bl.by : '') + ': ' + (bl.reason || '')) + (+c.arrears > 0 ? ' · tunggakan ' + RA.rp(c.arrears) : '') : c.why;\n    return { ini: ini(c.name), name: c.name || '(tanpa nama)', sub: 'Pelanggan sejak ' + mon(c.since) + (c.nik4 ? ' · NIK •••• ' + c.nik4 : '') + (c.accounts > 1 ? ' · ' + c.accounts + ' akun' : '') + (c.phone4 ? ' · HP ••' + c.phone4 : ''),\n      tag: l[0], chip: 'flex: none; height: 28px; padding: 0 10px; border-radius: 14px; font-size: 12.5px; font-weight: 800; display: flex; align-items: center; background: ' + l[1] + '; color: ' + l[2], border: l[3],\n      avBg: l[1], avFg: l[2], why, whyBg: c.label === 'tolak' ? '#FDECEA' : '#FFF6E5', whyFg: c.label === 'tolak' ? '#A12A1F' : '#7A4B00',\n      st: [{ v: c.done + '×', l: 'Sewa selesai', c: '#1F2B4D' }, { v: c.late + '×', l: c.late ? 'Telat (maks ' + (c.late_max >= 2880 ? Math.round(c.late_max / 1440) + ' hari' : c.late_max >= 120 ? Math.round(c.late_max / 60) + ' jam' : c.late_max + ' mnt') + ')' : 'Telat', c: c.late6 >= 2 ? '#C0392B' : '#1F2B4D' }, +c.arrears > 0 ? { v: RA.rpShort ? RA.rpShort(c.arrears) : RA.rp(c.arrears), l: 'Tunggakan', c: '#C0392B' } : { v: String(c.damage), l: 'Kerusakan', c: c.damage ? '#B46A00' : '#1F2B4D' }],\n      kv: [{ l: 'Verifikasi', v: c.verified ? ((c.docs || []).map(k => DOC[k] || k).join(' + ') || 'terverifikasi') + ' ✓' : 'Belum', c: c.verified ? '#1E7A3F' : '#B46A00' },\n        { l: 'Nomor darurat', v: c.emergency_set ? (c.emergency || 'ada') + ((c.emergency || '').match(/istri|suami|anak|ayah|ibu|orang tua|kakak|adik|saudara/i) ? ' ✓' : '') : 'Belum diisi', c: c.emergency_set ? '#1F2B4D' : '#B46A00' },\n        { l: 'Tunggakan', v: RA.rp(c.arrears || 0), c: +c.arrears > 0 ? '#C0392B' : '#1F2B4D' }, { l: 'Member', v: c.level ? String(c.level).replace(/^./, x => x.toUpperCase()) : '—', c: '#1F2B4D' }].concat(c.drive ? [{ l: 'Cara berkendara (GPS)', v: 'skor ' + c.drive.score + ' · ' + c.drive.trips + ' sewa' + (c.drive.speeding ? ' · ngebut ' + c.drive.speeding + '×' : '') + (c.drive.out_zone ? ' · keluar wilayah ' + c.drive.out_zone + '×' : ''), c: c.drive.score >= 80 ? '#1E7A3F' : c.drive.score >= 60 ? '#B46A00' : '#C0392B' }] : []),\n      prof: 'PosPelanggan.dc.html?id=' + c.id, canBook: c.label !== 'tolak' ? '1' : '' }; });\n  const blOnly = r && !r.found && r.blacklist ? { name: r.blacklist.name || 'Nomor/NIK ini', reason: (r.blacklist.reason || 'Diblokir') + (r.blacklist.at ? ' · sejak ' + RA.date(r.blacklist.at) : '') } : null;\n  const masked = s.mode === 'phone' ? String(s.q).replace(/\\D/g, '').replace(/^(\\d{4})\\d+(\\d{4})$/, '$1 •••• $2') : s.mode === 'nik' ? 'NIK •••• ' + String(s.q).replace(/\\D/g, '').slice(-4) : s.q;\n  return {\n    scope: (br ? br.name + ' · ' : '') + RA.HARIL[now.getDay()] + ', ' + RA.date(now),\n    modes: [['phone', 'Nomor WA'], ['nik', 'NIK'], ['name', 'Nama']].map(([k, l]) => ({ label: l, style: chipM(s.mode === k), pick: () => this.setState({ mode: k, res: null, err: '' }) })),\n    inType: s.mode === 'phone' ? 'tel' : 'text', inMode: s.mode === 'name' ? 'text' : 'numeric', ph: s.mode === 'phone' ? '0812 xxxx xxxx' : s.mode === 'nik' ? '16 angka NIK di KTP' : 'Nama sesuai KTP',\n    q: s.q, setQ: e => this.setState({ q: e.target.value }), onKey: e => { if (e.key === 'Enter') this.run(); },\n    run: () => this.run(), busy: !!s.busy, btnLabel: s.busy ? 'Mengecek…' : 'Cek sekarang', err: s.err,\n    resTitle: !r ? '' : list.length ? (list.length === 1 ? 'Hasil cek' : 'Hasil cek · ' + list.length + ' kemungkinan') : 'Hasil cek',\n    cards, blOnly, showNew: !!(r && !r.found && !r.blacklist), newSub: masked,\n  };\n}\n}\n</script>\n</body>\n</html>\n"}