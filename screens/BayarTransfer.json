{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Bayar lewat transfer bank</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0}\na{color:#1F2B4D}a:hover{color:#000}\n</style>\n</helmet>\n<div style=\"width: 390px; min-height: 844px; box-sizing: border-box; background: #F4F6F9; color: #1F2B4D; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; flex-direction: column; position: relative\">\n<header style=\"display: flex; align-items: center; gap: 8px; padding: 10px 12px; border-bottom: 1px solid #E6E8EC\">\n    <a href=\"{{backHref}}\" aria-label=\"Kembali\" style=\"width: 44px; height: 44px; display: flex; align-items: center; justify-content: center\">\n      <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1F2B4D\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M15 6l-6 6 6 6\"/></svg>\n    </a>\n    <div style=\"display: flex; flex-direction: column\"><div style=\"font-size: 18px; font-weight: 800\">Bayar lewat transfer</div><div style=\"font-size: 13px; color: #4A5468\">{{sub}}</div></div>\n</header>\n<section style=\"padding: 16px; display: flex; flex-direction: column; gap: 14px\">\n  <sc-if value=\"{{note}}\"><div style=\"background: #FFFFFF; border-radius: 14px; padding: 16px; font-size: 14px; line-height: 20px; color: #4A5468\">{{note}}</div></sc-if>\n\n  <sc-if value=\"{{paid}}\">\n    <div style=\"background: #E4F2EA; border-radius: 14px; padding: 16px; display: flex; flex-direction: column; gap: 6px\"><b style=\"font-size: 17px; color: #1E6B45\">Pembayaran sudah dikonfirmasi ✅</b><span style=\"font-size: 14px; line-height: 20px; color: #2D4A3A\">Terima kasih. Detail booking dan petunjuk check-in ada di tiketmu.</span></div>\n    <a href=\"{{ticketHref}}\" style=\"height: 52px; border-radius: 12px; background: #09BEAF; color: #1F2B4D; font: 800 16px 'Plus Jakarta Sans', sans-serif; display: flex; align-items: center; justify-content: center; text-decoration: none\">Lihat tiket</a>\n  </sc-if>\n\n  <sc-if value=\"{{show}}\">\n  <sc-if value=\"{{waiting}}\">\n  <div style=\"background: #FFFFFF; border-radius: 18px; padding: 20px 16px; display: flex; flex-direction: column; align-items: center; gap: 8px; text-align: center; box-shadow: 0 4px 14px rgba(31,43,77,.06)\">\n    <div style=\"width: 64px; height: 64px; border-radius: 32px; background: #E3F7F5; display: flex; align-items: center; justify-content: center\"><svg width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#077A70\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z\"/><path d=\"M12 7v5l3 2\"/></svg></div>\n    <b style=\"font-size: 19px\">Bukti transfer diterima</b>\n    <span style=\"font-size: 13.5px; line-height: 20px; color: #4A5468\">Admin sedang mencocokkan dengan mutasi rekening. Begitu dikonfirmasi, tiket dan petunjuk check-in langsung dikirim ke email kamu.</span>\n    <span style=\"font-size: 12px; font-weight: 800; color: #077A70; background: #E3F7F5; border-radius: 10px; padding: 6px 10px\">Biasanya &lt; 1 jam · jam kerja 07.30–21.00</span>\n  </div>\n\n  <div style=\"background: #FFFFFF; border-radius: 18px; padding: 16px; display: flex; flex-direction: column; gap: 0\">\n    <b style=\"font-size: 15px; margin-bottom: 10px\">Status pesanan</b>\n    <sc-for list=\"{{steps}}\" as=\"st\"><div style=\"display: flex; gap: 12px\">\n      <div style=\"display: flex; flex-direction: column; align-items: center\"><span style=\"{{st.dot}}\">{{st.mark}}</span><sc-if value=\"{{st.line}}\"><span style=\"{{st.lineStyle}}\"></span></sc-if></div>\n      <div style=\"padding-bottom: 14px\"><b style=\"{{st.titleStyle}}\">{{st.t}}</b><div style=\"font-size: 12.5px; color: #4A5468; margin-top: 1px\">{{st.d}}</div></div>\n    </div></sc-for>\n  </div>\n\n  <div style=\"background: #FFFFFF; border-radius: 18px; padding: 14px 16px; display: flex; flex-direction: column; gap: 8px\">\n    <b style=\"font-size: 15px\">Ringkasan</b>\n    <sc-for list=\"{{summary}}\" as=\"r\"><div style=\"display: flex; justify-content: space-between; gap: 12px; font-size: 13.5px\"><span style=\"color: #4A5468\">{{r.k}}</span><b style=\"text-align: right\">{{r.v}}</b></div></sc-for>\n    <sc-if value=\"{{proofUrl}}\"><details style=\"margin-top: 4px\"><summary style=\"cursor: pointer; font-size: 13px; font-weight: 700; color: #077A70\">Lihat bukti yang dikirim</summary><img src=\"{{proofUrl}}\" alt=\"Bukti transfer\" style=\"width: 100%; max-height: 260px; object-fit: contain; border-radius: 10px; background: #F4F6F9; margin-top: 8px\"></details></sc-if>\n  </div>\n\n  <div style=\"display: flex; flex-direction: column; gap: 10px\">\n    <a href=\"{{detailHref}}\" style=\"height: 52px; border-radius: 12px; background: #09BEAF; color: #1F2B4D; font: 800 16px 'Plus Jakarta Sans', sans-serif; display: flex; align-items: center; justify-content: center; text-decoration: none\">Lihat detail pesanan</a>\n    <a href=\"{{waHref}}\" target=\"_blank\" rel=\"noopener\" style=\"height: 48px; border-radius: 12px; border: 1px solid #C9EFD6; background: #E9F9EF; color: #137A3B; font: 800 15px 'Plus Jakarta Sans', sans-serif; display: flex; align-items: center; justify-content: center; gap: 8px; text-decoration: none\">Chat admin di WhatsApp</a>\n    <a href=\"Home.dc.html\" style=\"height: 44px; display: flex; align-items: center; justify-content: center; font: 700 14px 'Plus Jakarta Sans', sans-serif; color: #4A5468; text-decoration: none\">Kembali ke beranda</a>\n  </div>\n  </sc-if>\n  <sc-if value=\"{{waiting}}\" not>\n  <div style=\"background: linear-gradient(135deg, #1F2B4D, #2A3A66); color: #FFFFFF; border-radius: 18px; padding: 14px 16px; display: flex; align-items: center; gap: 12px\">\n    <span style=\"width: 42px; height: 42px; border-radius: 21px; background: rgba(255,255,255,.12); display: flex; align-items: center; justify-content: center; flex-shrink: 0\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#09BEAF\" stroke-width=\"2.2\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"13\" r=\"8\"/><path d=\"M12 9v4l2.5 2M9 2h6\"/></svg></span>\n    <div style=\"flex: 1\"><div style=\"font-size: 12.5px; color: #C9D3E3\">Selesaikan pembayaran dalam</div><b style=\"font-size: 22px; letter-spacing: .02em; font-variant-numeric: tabular-nums\">{{countdown}}</b></div>\n    <div style=\"text-align: right; font-size: 11.5px; color: #C9D3E3\">Tanggal ditahan<br>sampai {{holdTime}}</div>\n  </div>\n\n  <div style=\"display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px\">\n    <sc-for list=\"{{flow}}\" as=\"f\"><div style=\"{{f.box}}\"><span style=\"{{f.num}}\">{{f.n}}</span><span style=\"font-size: 11.5px; font-weight: 700; line-height: 14px\">{{f.t}}</span></div></sc-for>\n  </div>\n\n  <div style=\"background: #FFFFFF; border-radius: 18px; padding: 16px; display: flex; flex-direction: column; gap: 14px; box-shadow: 0 4px 14px rgba(31,43,77,.06)\">\n    <div style=\"display: flex; flex-direction: column; gap: 4px\"><span style=\"font-size: 13px; color: #4A5468\">Jumlah yang harus ditransfer</span>\n      <div style=\"display: flex; align-items: center; justify-content: space-between; gap: 8px\"><b style=\"font-size: 28px; letter-spacing: -0.01em\">{{amount}}</b><button type=\"button\" onClick=\"{{copyAmount}}\" style=\"height: 36px; padding: 0 12px; border-radius: 10px; border: 1px solid #D5D9E0; background: #FFFFFF; font: 700 13px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; cursor: pointer\">Salin</button></div>\n      <span style=\"font-size: 12px; color: #8A4B00\">⚠️ Transfer persis sampai 3 digit terakhir supaya cepat dicek.</span></div>\n    <div style=\"border-radius: 16px; padding: 14px 16px; color: #FFFFFF; background: linear-gradient(135deg, #0B5DA8 0%, #0A3D7A 100%); position: relative; overflow: hidden; display: flex; flex-direction: column; gap: 6px\">\n      <span style=\"position: absolute; right: -30px; top: -30px; width: 120px; height: 120px; border-radius: 60px; background: rgba(255,255,255,.08)\"></span>\n      <div style=\"display: flex; justify-content: space-between; align-items: center\"><b style=\"font-size: 18px; letter-spacing: .06em\">{{bank}}</b><span style=\"font-size: 11px; font-weight: 700; opacity: .85\">Rekening resmi</span></div>\n      <div style=\"display: flex; align-items: center; justify-content: space-between; gap: 8px; position: relative\"><b style=\"font-size: 24px; letter-spacing: .08em; font-variant-numeric: tabular-nums\">{{numberFmt}}</b><button type=\"button\" onClick=\"{{copyNumber}}\" style=\"height: 34px; padding: 0 12px; border-radius: 10px; border: 0; background: rgba(255,255,255,.18); font: 800 13px 'Plus Jakarta Sans', sans-serif; color: #FFFFFF; cursor: pointer\">Salin</button></div>\n      <span style=\"font-size: 13.5px; font-weight: 700\">a.n. {{holder}}</span>\n    </div>\n    <div style=\"font-size: 12.5px; line-height: 18px; color: #4A5468\">Berita transfer (opsional): <b style=\"color: #1F2B4D\">{{code}}</b></div>\n  </div>\n\n  <div style=\"background: #FFFFFF; border-radius: 18px; padding: 14px 16px; display: flex; flex-direction: column; gap: 8px\">\n    <b style=\"font-size: 15px\">Pesananmu</b>\n    <sc-for list=\"{{summary}}\" as=\"r\"><div style=\"display: flex; justify-content: space-between; gap: 12px; font-size: 13.5px\"><span style=\"color: #4A5468\">{{r.k}}</span><b style=\"text-align: right\">{{r.v}}</b></div></sc-for>\n  </div>\n\n  <details style=\"background: #FFFFFF; border-radius: 18px; padding: 14px 16px\">\n    <summary style=\"cursor: pointer; font-size: 14px; font-weight: 800; list-style: none; display: flex; justify-content: space-between\">Cara transfer <span style=\"color: #077A70; font-size: 13px\">lihat ›</span></summary>\n    <div style=\"font-size: 13px; line-height: 20px; color: #3A4558; margin-top: 10px\"><b>m-BCA / myBCA</b><br>Transfer → Antar Rekening BCA → masukkan nomor rekening → isi nominal → kirim.<br><br><b>Bank lain / e-wallet</b><br>Pilih transfer ke bank lain → BCA → masukkan nomor rekening & nominal (biaya transfer ditanggung pengirim).<br><br>Setelah berhasil, <b>screenshot bukti transfer</b> lalu unggah di bawah.</div>\n  </details>\n\n  <sc-if value=\"{{rejected}}\"><div role=\"alert\" style=\"background: #FDECEA; border-radius: 12px; padding: 12px; font-size: 13px; line-height: 19px; color: #A12A1F\"><b>Bukti sebelumnya belum bisa diterima:</b> {{rejected}}</div></sc-if>\n\n  <label style=\"{{upStyle}}\">\n    <input type=\"file\" accept=\"image/*\" onChange=\"{{pick}}\" style=\"position: absolute; width: 1px; height: 1px; opacity: 0\">\n    <span style=\"width: 44px; height: 44px; border-radius: 14px; background: #09BEAF; display: flex; align-items: center; justify-content: center\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1F2B4D\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 16V4M7 9l5-5 5 5\"/><path d=\"M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3\"/></svg></span>\n    <span style=\"display: flex; flex-direction: column; text-align: left\"><b style=\"font-size: 16px\">{{upLabel}}</b><span style=\"font-size: 12px; font-weight: 600; color: #4A5468\">Screenshot / foto struk · JPG atau PNG</span></span>\n  </label>\n  <sc-if value=\"{{error}}\"><div role=\"alert\" style=\"background: #FDECEA; border-radius: 10px; padding: 10px 12px; font-size: 13px; line-height: 19px; color: #A12A1F\">{{error}}</div></sc-if>\n  <div style=\"font-size: 12px; line-height: 18px; color: #4A5468\">{{holdText}} Butuh bantuan? <a href=\"{{waHref}}\">Chat admin</a>.</div>\n  </sc-if>\n  <sc-if value=\"{{waiting}}\"><label style=\"font-size: 12.5px; color: #4A5468; text-align: center; cursor: pointer; position: relative\">Salah kirim foto? <u style=\"color: #077A70; font-weight: 700\">Ganti bukti transfer</u><input type=\"file\" accept=\"image/*\" onChange=\"{{pick}}\" style=\"position: absolute; width: 1px; height: 1px; opacity: 0\"></label></sc-if>\n  </sc-if>\n</section>\n</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{\"$preview\":{\"width\":390,\"height\":844}}'>\nclass Component extends DCLogic {\nstate = { b: null, info: null, pm: null, proofUrl: '', busy: false, error: '', note: '' };\nasync componentDidMount() {\n  if (!RA.isLoggedIn()) { RA.setCtx({ next: 'BayarTransfer?id=' + (this.params.id || '') }); RA.go('Login'); return; }\n  await this.load();\n  this.stop = RA.poll(this, () => this.load(), 15000);\n  this.tick = setInterval(() => { if (RA_ALIVE(this)) this.setState({ now: Date.now() }); }, 1000);\n}\ncomponentWillUnmount() { if (this.stop) this.stop(); clearInterval(this.tick); }\nasync load() {\n  const id = this.params.id;\n  if (!id) { this.setState({ note: 'Booking tidak ditemukan.' }); return; }\n  const r = await RA.from('bookings').select('*,branches(name,code,phone),booking_items(is_addon,products(name))').eq('id', id).maybeSingle();\n  if (!RA_ALIVE(this)) return;\n  const b = r.data;\n  if (!b) { this.setState({ note: 'Booking tidak ditemukan.' }); return; }\n  if (b.status === 'expired') { location.replace('#/Kedaluwarsa?id=' + b.id); return; }\n  const info = this.state.info || await RA.call('pay_info', { p_booking: b.id }).catch(() => null);\n  if (!RA_ALIVE(this)) return;\n  if (!info || info.mode !== 'transfer') { location.replace('#/Bayar?id=' + b.id); return; }\n  let pm = null;\n  if (b.status === 'awaiting_payment' || +b.paid_amount < +b.dp_amount) {\n    try { pm = await RA.call('create_payment', { p_booking: b.id, p_kind: null, p_method: 'transfer', p_amount: null }); }\n    catch (e) { if (/habis/i.test(e.message)) { location.replace('#/Kedaluwarsa?id=' + b.id); return; } this.setState({ error: RA.friendly(e.message) }); }\n    if (pm && pm.id) { const x = await RA.from('payments').select('*').eq('id', pm.id).maybeSingle(); if (x.data) pm = x.data; }\n  }\n  if (!RA_ALIVE(this)) return;\n  let proofUrl = this.state.proofUrl;\n  if (pm && pm.proof_path && (!this.state.pm || this.state.pm.proof_path !== pm.proof_path)) proofUrl = await RA.signedUrl('dokumen', pm.proof_path, 3600).catch(() => '');\n  if (!RA_ALIVE(this)) return;\n  if (this.state.pm && this.state.pm.status === 'pending' && b && +b.paid_amount >= +b.dp_amount && b.status === 'confirmed') { RA.ok('Pembayaran dikonfirmasi. Ini tiketmu!'); location.replace('#/' + (/^JP-/.test(b.code) ? 'JeepTiket' : 'InapTiket') + '?id=' + b.id); return; }\n  this.setState({ b, info, pm, proofUrl, note: '' });\n}\nasync upload(f) {\n  const s = this.state, b = s.b, pm = s.pm;\n  if (!f || !pm) return;\n  if (!/^image\\//.test(f.type)) throw new Error('Pilih foto/screenshot bukti transfer.');\n  const c = await RA.customer();\n  const blob = await this.shrink(f);\n  const path = c.id + '/transfer/' + pm.id + '-' + Date.now() + '.jpg';\n  await RA.upload('dokumen', path, blob);\n  const r = await RA.call('transfer_submit', { p_payment: pm.id, p_path: path });\n  RA.ok(r.status === 'paid' ? 'Sudah lunas' : 'Bukti terkirim. Kami kabari setelah dicek.');\n  this.setState({ proofUrl: '' });\n  await this.load();\n}\nshrink(f) {\n  return new Promise((ok) => {\n    const img = new Image(), url = URL.createObjectURL(f);\n    img.onload = () => { const k = Math.min(1, 1600 / Math.max(img.width, img.height)); const cv = document.createElement('canvas'); cv.width = Math.round(img.width * k); cv.height = Math.round(img.height * k);\n      cv.getContext('2d').drawImage(img, 0, 0, cv.width, cv.height); URL.revokeObjectURL(url); cv.toBlob(bl => ok(bl || f), 'image/jpeg', 0.85); };\n    img.onerror = () => ok(f); img.src = url;\n  });\n}\nrenderVals() {\n  const s = this.state, b = s.b, pm = s.pm, bank = (s.info && s.info.bank) || {};\n  const paid = !!(b && (+b.paid_amount >= +b.dp_amount) && ['confirmed', 'active', 'returned', 'completed'].indexOf(b.status) > -1);\n  const waiting = !!(pm && pm.status === 'pending' && pm.proof_path);\n  const kind = b && (/^RM-/.test(b.code) ? 'InapTiket' : /^JP-/.test(b.code) ? 'JeepTiket' : 'Status');\n  const wa = (b && b.branches && b.branches.phone) || '6281324700077';\n  const item = b ? ((b.booking_items || []).find(x => !x.is_addon && x.products) || {}).products : null;\n  const stay = b && !/^JP-/.test(b.code);\n  const nights = b ? Math.max(1, Math.round((new Date(b.end_at) - new Date(b.start_at)) / 86400000)) : 0;\n  const dot = (state) => 'width: 24px; height: 24px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 800; flex-shrink: 0; ' + (state === 'done' ? 'background: #09BEAF; color: #1F2B4D' : state === 'now' ? 'background: #FFFFFF; color: #077A70; border: 2px solid #09BEAF; box-shadow: 0 0 0 4px rgba(9,190,175,.18)' : 'background: #EEF0F3; color: #9AA3B2');\n  const stepsRaw = [['done', 'Pesanan dibuat', b ? RA.dayTime(b.created_at) : ''], ['done', 'Bukti transfer dikirim', pm && pm.proof_at ? RA.dayTime(pm.proof_at) : ''],\n    ['now', 'Dicek admin', 'Mencocokkan ' + (pm ? RA.rp(pm.amount) : '') + ' dengan mutasi BCA'], ['next', stay ? 'Tiket & petunjuk check-in' : 'Tiket & jadwal jemput', 'Dikirim ke WhatsApp setelah dikonfirmasi']];\n  const steps = stepsRaw.map((x, i) => ({ t: x[1], d: x[2], mark: x[0] === 'done' ? '✓' : String(i + 1), dot: dot(x[0]), line: i < stepsRaw.length - 1, lineStyle: 'width: 2px; flex: 1; min-height: 18px; background: ' + (x[0] === 'done' ? '#09BEAF' : '#E6E8EC'),\n    titleStyle: 'font-size: 14px; color: ' + (x[0] === 'next' ? '#8A93A6' : '#1F2B4D') }));\n  const summary = b ? [{ k: stay ? 'Penginapan' : 'Paket', v: (item && item.name) || (b.branches && b.branches.name) || '-' },\n    { k: stay ? 'Tanggal' : 'Jadwal', v: stay ? RA.date(b.start_at) + ' – ' + RA.date(b.end_at) + ' · ' + nights + ' malam' : RA.day(new Date(b.start_at)) + ' · ' + RA.time(b.start_at) },\n    { k: stay ? 'Tamu' : 'Peserta', v: (b.guests || 1) + ' orang' }, { k: 'Atas nama', v: b.guest_name || '-' }, { k: 'Total', v: pm ? RA.rp(pm.amount) + ' · lunas' : '-' }] : [];\n  const ph = b && b.guest_phone ? String(b.guest_phone) : '';\n  const left = b && b.hold_expires_at ? Math.max(0, new Date(b.hold_expires_at) - Date.now()) : 0;\n  const mm = Math.floor(left / 60000), ss = Math.floor(left / 1000) % 60;\n  const fb = (on, done) => 'border-radius: 14px; padding: 10px 8px; display: flex; flex-direction: column; align-items: center; gap: 6px; text-align: center; ' + (on ? 'background: #FFFFFF; box-shadow: 0 0 0 2px #09BEAF inset' : 'background: #FFFFFF');\n  const fn = (on) => 'width: 24px; height: 24px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 800; ' + (on ? 'background: #09BEAF; color: #1F2B4D' : 'background: #EEF0F3; color: #8A93A6');\n  const flow = [['1', 'Transfer ke BCA', true], ['2', 'Unggah bukti', true], ['3', 'Dicek admin', false]].map(x => ({ n: x[0], t: x[1], box: fb(x[2]), num: fn(x[2]) }));\n  return {\n    countdown: left ? String(mm).padStart(2, '0') + ':' + String(ss).padStart(2, '0') : 'Waktu habis', holdTime: b && b.hold_expires_at ? RA.time(b.hold_expires_at) : '',\n    flow, numberFmt: String(bank.number || '').replace(/^(\\d{3})(\\d{3})(\\d+)$/, '$1 $2 $3'),\n    steps, summary, phoneMasked: ph ? '+' + ph.slice(0, 4) + '••••' + ph.slice(-3) : 'kamu', detailHref: b ? (stay ? 'InapTiket' : 'JeepTiket') + '.dc.html?id=' + b.id : 'Akun.dc.html',\n    backHref: b ? 'Status.dc.html?id=' + b.id : 'Status.dc.html',\n    sub: b ? (b.branches ? b.branches.name + ' · ' : '') + b.code : '',\n    note: s.note, paid, ticketHref: b ? kind + '.dc.html?id=' + b.id : '',\n    show: !!(b && pm && !paid), code: b ? b.code : '', amount: pm ? RA.rp(pm.amount) : '',\n    bank: bank.bank || '', number: bank.number || '', holder: bank.holder || '',\n    copyAmount: () => { try { navigator.clipboard.writeText(String(Math.round(+pm.amount))); } catch (e) {} RA.toast('Nominal disalin'); },\n    copyNumber: () => { try { navigator.clipboard.writeText(String(bank.number || '').replace(/\\D/g, '')); } catch (e) {} RA.toast('Nomor rekening disalin'); },\n    rejected: pm && !pm.proof_path && pm.reject_note ? pm.reject_note : '',\n    waiting, proofUrl: waiting ? s.proofUrl : '',\n    upLabel: s.busy ? 'Mengunggah…' : 'Unggah bukti transfer',\n    upStyle: 'position: relative; min-height: 76px; border-radius: 18px; display: flex; align-items: center; gap: 14px; padding: 14px 16px; cursor: pointer; font-family: \"Plus Jakarta Sans\", sans-serif; color: #1F2B4D; background: #FFFFFF; border: 2px dashed #09BEAF' + (s.busy ? '; opacity: .6; pointer-events: none' : ''),\n    pick: async (e) => { const f = e.target.files && e.target.files[0]; e.target.value = ''; if (!f) return; this.setState({ busy: true, error: '' });\n      try { await this.upload(f); } catch (er) { this.setState({ error: RA.friendly(er.message) }); } finally { if (RA_ALIVE(this)) this.setState({ busy: false }); } },\n    error: s.error,\n    holdText: b && b.hold_expires_at ? 'Tanggal ditahan sampai ' + RA.dayTime(b.hold_expires_at) + '.' : '',\n    waHref: 'https://wa.me/' + String(wa).replace(/\\D/g, '') + '?text=' + encodeURIComponent('Halo, saya mau tanya pembayaran transfer booking ' + (b ? b.code : ''))\n  };\n}\n}\n</script>\n</body>\n</html>\n"}