{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Cari barang</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0}\na{color:#1F2B4D}a:hover{color:#000}\n.ra-q::placeholder{color:#8A93A3}\n.ra-q::-webkit-search-cancel-button{display:none}\n.ra-cc::-webkit-scrollbar{display:none}\n</style>\n</helmet>\n<div style=\"width: 390px; height: 1500px; box-sizing: border-box; background: #F4F6F9; color: #1F2B4D; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; flex-direction: column; position: relative; overflow: hidden\">\n\n  <header style=\"background: linear-gradient(160deg, #09BEAF 0%, #077A70 100%); padding: 16px 16px 18px; position: relative; overflow: hidden; display: flex; flex-direction: column; gap: 12px\">\n    <svg width=\"220\" height=\"220\" viewBox=\"0 0 220 220\" aria-hidden=\"true\" style=\"position: absolute; right: -70px; top: -90px; opacity: 0.18\"><circle cx=\"110\" cy=\"110\" r=\"100\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"30\"/></svg>\n    <b style=\"font-size: 22px; line-height: 28px; color: #FFFFFF; position: relative\">Mau sewa apa hari ini?</b>\n    <label style=\"position: relative; height: 52px; border-radius: 16px; background: #FFFFFF; display: flex; align-items: center; gap: 10px; padding: 0 14px; box-shadow: 0 6px 16px rgba(0,0,0,0.12)\">\n      <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#077A70\" stroke-width=\"2.4\" stroke-linecap=\"round\" aria-hidden=\"true\" style=\"flex-shrink: 0\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"M20 20l-4-4\"/></svg>\n      <input class=\"ra-q\" type=\"search\" aria-label=\"Cari barang\" value=\"{{q}}\" onChange=\"{{setQ}}\" placeholder=\"Motor, iPhone, kamera, tenda…\" style=\"flex: 1; min-width: 0; height: 48px; border: 0; outline: none; background: transparent; font: 600 16px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D\">\n      <sc-if value=\"{{q}}\"><button type=\"button\" onClick=\"{{clearQ}}\" aria-label=\"Hapus pencarian\" style=\"width: 28px; height: 28px; flex-shrink: 0; border-radius: 14px; border: 0; background: #EEF0F3; display: flex; align-items: center; justify-content: center; cursor: pointer\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#5B6577\" stroke-width=\"2.6\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button></sc-if>\n    </label>\n    <a href=\"Kalender.dc.html\" style=\"position: relative; align-self: flex-start; max-width: 100%; box-sizing: border-box; height: 32px; padding: 0 12px; border-radius: 16px; background: rgba(255,255,255,0.22); color: #FFFFFF; font-size: 12px; font-weight: 700; display: inline-flex; align-items: center; gap: 6px; text-decoration: none; white-space: nowrap; overflow: hidden; text-overflow: ellipsis\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"2.2\" stroke-linecap=\"round\" aria-hidden=\"true\"><rect x=\"4\" y=\"5\" width=\"16\" height=\"15\" rx=\"2\"/><path d=\"M8 3v4M16 3v4M4 10h16\"/></svg>{{ctxText}} · Ubah</a>\n  </header>\n\n  <!-- kategori -->\n  <div class=\"ra-cc\" style=\"display: flex; gap: 8px; overflow-x: auto; padding: 14px 16px 2px; scrollbar-width: none\">\n    <sc-for list=\"{{cats}}\" as=\"c\" hint-placeholder-count=\"5\"><button type=\"button\" onClick=\"{{c.pick}}\" aria-pressed=\"{{c.on}}\" style=\"{{c.style}}\">{{c.label}}</button></sc-for>\n  </div>\n\n  <!-- tampilan awal: belum mengetik -->\n  <sc-if value=\"{{idle}}\">\n  <section style=\"padding: 14px 16px 0; display: flex; flex-direction: column; gap: 10px\">\n    <sc-if value=\"{{hasRecent}}\"><div style=\"display: flex; justify-content: space-between; align-items: center\"><b style=\"font-size: 15px\">Terakhir kamu cari</b><button type=\"button\" onClick=\"{{clearRecent}}\" style=\"border: 0; background: none; font: 700 12px 'Plus Jakarta Sans', sans-serif; color: #077A70; cursor: pointer\">Hapus</button></div>\n    <div style=\"display: flex; flex-wrap: wrap; gap: 8px\"><sc-for list=\"{{recent}}\" as=\"r\"><button type=\"button\" onClick=\"{{r.pick}}\" style=\"height: 34px; padding: 0 12px; border-radius: 17px; border: 0; background: #FFFFFF; box-shadow: 0 1px 6px rgba(31,43,77,0.08); font: 600 13px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; display: flex; align-items: center; gap: 6px; cursor: pointer\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#8A93A3\" stroke-width=\"2.2\" stroke-linecap=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3 2\"/></svg>{{r.t}}</button></sc-for></div></sc-if>\n    <b style=\"font-size: 15px; margin-top: 4px\">Pencarian populer 🔥</b>\n    <div style=\"display: flex; flex-wrap: wrap; gap: 8px\"><sc-for list=\"{{popular}}\" as=\"r\"><button type=\"button\" onClick=\"{{r.pick}}\" style=\"height: 34px; padding: 0 14px; border-radius: 17px; border: 1.5px solid #CDEFEA; background: #F2FBFA; font: 700 13px 'Plus Jakarta Sans', sans-serif; color: #077A70; cursor: pointer\">{{r.t}}</button></sc-for></div>\n    <b style=\"font-size: 15px; margin-top: 8px\">{{topTitle}}</b>\n  </section>\n  </sc-if>\n\n  <!-- tampilan hasil -->\n  <sc-if value=\"{{idle}}\" not>\n  <section style=\"padding: 12px 16px 0; display: flex; justify-content: space-between; align-items: center; gap: 8px\">\n    <span style=\"font-size: 13px; color: #5B6577\">{{countText}}</span>\n    <div style=\"display: flex; gap: 6px; align-items: center\">\n      <button type=\"button\" onClick=\"{{toggleAvail}}\" aria-pressed=\"{{availOn}}\" style=\"{{availStyle}}\">Tersedia</button>\n      <select value=\"{{sort}}\" onChange=\"{{setSort}}\" aria-label=\"Urutkan\" style=\"height: 32px; border: 0; border-radius: 16px; padding: 0 8px; font: 700 12px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; background: #FFFFFF; box-shadow: 0 1px 6px rgba(31,43,77,0.08)\"><option value=\"pop\">Terlaris</option><option value=\"low\">Termurah</option><option value=\"high\">Termahal</option></select>\n    </div>\n  </section>\n  <sc-if value=\"{{emptyText}}\"><section style=\"margin: 14px 16px 0; background: #FFFFFF; border-radius: 20px; box-shadow: 0 2px 12px rgba(31,43,77,0.07); padding: 24px 18px; display: flex; flex-direction: column; align-items: center; gap: 8px; text-align: center\">\n    <svg width=\"72\" height=\"72\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#B9ECE6\" stroke-width=\"1.6\" stroke-linecap=\"round\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"M20 20l-4-4M8.5 9.5l5 5M13.5 9.5l-5 5\"/></svg>\n    <b style=\"font-size: 15px\">Belum ketemu</b>\n    <span style=\"font-size: 13px; line-height: 19px; color: #5B6577\">{{emptyText}}</span>\n    <a href=\"{{waAsk}}\" style=\"margin-top: 4px; font-size: 13px; font-weight: 800; color: #077A70\">Tanya cabang lewat WhatsApp →</a>\n  </section></sc-if>\n  </sc-if>\n\n  <section style=\"padding: 12px 16px 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px\">\n    <sc-for list=\"{{items}}\" as=\"it\" hint-placeholder-count=\"4\">\n      <a href=\"{{it.href}}\" style=\"background: #FFFFFF; border-radius: 18px; box-shadow: 0 2px 12px rgba(31,43,77,0.07); overflow: hidden; text-decoration: none; color: #1F2B4D; display: flex; flex-direction: column\">\n        <div style=\"aspect-ratio: 1 / 1; background: linear-gradient(180deg, #F7F9FB 0%, #EDF1F5 100%); position: relative; display: flex; align-items: center; justify-content: center; font-size: 10px; font-weight: 600; color: #6B7385\">\n          <sc-if value=\"{{it.photo}}\"><img src=\"{{it.photo}}\" alt=\"{{it.name}}\" style=\"width: 100%; height: 100%; object-fit: contain; padding: 10px; box-sizing: border-box; display: block; {{it.imgStyle}}\"></sc-if><sc-if value=\"{{it.photo}}\" not>Foto segera</sc-if>\n          <sc-if value=\"{{it.best}}\" hint-placeholder-val=\"{{false}}\"><span style=\"position: absolute; left: 0; top: 10px; height: 24px; padding: 0 10px 0 8px; border-radius: 0 12px 12px 0; background: linear-gradient(90deg, #FF6A3D, #FF9F1C); color: #FFFFFF; font-size: 11px; font-weight: 800; display: flex; align-items: center; gap: 4px\">🔥 Terlaris</span></sc-if>\n        </div>\n        <div style=\"padding: 10px 12px 12px; display: flex; flex-direction: column; gap: 4px; flex: 1\">\n          <div style=\"font-size: 14px; font-weight: 700; line-height: 18px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden\">{{it.name}}</div>\n          <sc-if value=\"{{it.sold}}\"><div style=\"display: flex; align-items: center; gap: 4px; font-size: 11px; color: #5B6577\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#077A70\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6L9 17l-5-5\"/></svg>{{it.sold}}</div></sc-if>\n          <sc-if value=\"{{it.promo}}\"><span style=\"align-self: flex-start; font-size: 10px; line-height: 13px; font-weight: 800; padding: 4px 7px; border-radius: 6px; background: #FFF1CC; color: #8A5A00\">🎁 {{it.promo}}</span></sc-if>\n          <div style=\"margin-top: auto; padding-top: 4px; display: flex; flex-direction: column\">\n            <sc-if value=\"{{it.was}}\"><s style=\"font-size: 11px; color: #8A93A3\">{{it.was}}</s></sc-if>\n            <span style=\"font-size: 16px; font-weight: 800\">{{it.price}}<span style=\"font-size: 11px; font-weight: 600; color: #5B6577\">{{it.suf}}</span></span>\n            <sc-if value=\"{{it.sub}}\"><span style=\"font-size: 11px; font-weight: 700; color: #1E9E5A\">{{it.sub}}</span></sc-if>\n          </div>\n          <div style=\"margin-top: 6px; padding-top: 8px; border-top: 1px dashed #E3E7EC; display: flex; align-items: center; gap: 6px; font-size: 11px; font-weight: 700; color: {{it.dot}}\"><span style=\"width: 7px; height: 7px; border-radius: 4px; flex-shrink: 0; background: {{it.dot}}\"></span><span style=\"white-space: nowrap; overflow: hidden; text-overflow: ellipsis\">{{it.status}}</span></div>\n        </div>\n      </a>\n    </sc-for>\n  </section>\n  <div style=\"height: 110px\"></div>\n</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{\"$preview\":{\"width\":390,\"height\":1500}}'>\nclass Component extends DCLogic {\nstate = { cat: 'all', avail: false, sort: 'pop', q: '', list: null, branch: null, fr: null, recent: [] };\nasync componentDidMount() {\n  const prm = this.params || {};\n  if (prm.q) this.state.q = prm.q;\n  if (prm.cat) this.state.cat = prm.cat;\n  let recent = []; try { recent = JSON.parse(localStorage.getItem('ra.recentSearch') || '[]') || []; } catch (e) {}\n  this.state.recent = Array.isArray(recent) ? recent.slice(0, 6) : [];\n  const branch = await RA.branch(); if (!branch) { this.setState({ list: [] }); return; }\n  const c = RA.ctx();\n  const [cl, ap] = await Promise.all([\n    RA.rpc('catalog_list', { p_branch: branch.id, p_start: c.start_at, p_end: c.end_at }),\n    RA.promoFree(branch.id).then(f => ({ data: f ? [f] : [] }))\n  ]);\n  if (!RA_ALIVE(this)) return;\n  if (cl.error) RA.err(cl.error.message);\n  const fr = ((ap && ap.data) || []).filter(x => x.is_active !== false)[0] || null;\n  this.setState({ branch, fr, list: (cl.data || []).filter(p => (p.units > 0 || p.category.kind !== 'rental') && p.category.slug !== 'mobil-sopir') });\n}\nremember(t) {\n  t = String(t || '').trim(); if (t.length < 3) return;\n  const r = [t].concat(this.state.recent.filter(x => x.toLowerCase() !== t.toLowerCase())).slice(0, 6);\n  try { localStorage.setItem('ra.recentSearch', JSON.stringify(r)); } catch (e) {}\n  this.setState({ recent: r });\n}\nsetQuery(v) {\n  this.setState({ q: v });\n  clearTimeout(this._rt); this._rt = setTimeout(() => this.remember(this.state.q), 1500);\n}\nrenderVals() {\n  const s = this.state, c = RA.ctx(), br = s.branch || {};\n  const days = RA.days(c.start_at, c.end_at);\n  const st = new Date(c.start_at), en = new Date(c.end_at);\n  const range = st.getMonth() === en.getMonth() ? st.getDate() + '–' + RA.date(en) : RA.date(st) + '–' + RA.date(en);\n  const list = s.list || [];\n  const q = String(s.q || '').toLowerCase().trim();\n  const idle = !q && s.cat === 'all';\n  const FLOW = { stay: 'Penginapan', trip: 'JeepJadwal', car_driver: 'MobilSopirPaket' };\n  const UNIT = { hari: '/hari', malam: '/malam', trip: '/trip', paket: '/paket', jam: '/jam' };\n  const fr = s.fr, frT = fr && fr.rule ? (fr.rule.tiers || [{ buy: fr.rule.buy_days, free: fr.rule.free_days }]) : [];\n  const frTxt = frT.length ? 'Sewa ' + (+frT[0].buy + +frT[0].free) + ' hari, cukup bayar ' + frT[0].buy + ' hari' : '';\n  const promoOk = p => !!(frTxt && p.category.kind === 'rental' && p.category.price_unit === 'hari' && (fr.exclude_category_ids || []).indexOf(p.category.id) < 0 && (!fr.category_ids || !fr.category_ids.length || fr.category_ids.indexOf(p.category.id) > -1));\n  const words = q.split(/\\s+/).filter(Boolean);\n  let items = list.filter(p => (s.cat === 'all' || p.category.slug === s.cat) && (!s.avail || p.available > 0)\n    && (!words.length || words.every(w => (p.name + ' ' + p.category.name + ' ' + p.category.slug + ' ' + (p.label || '') + ' ' + (p.short_desc || '')).toLowerCase().indexOf(w) > -1)));\n  const up = p => p.price && p.price.unit_price != null ? +p.price.unit_price : null;\n  if (s.sort === 'pop' || idle) items = items.slice().sort((a, b) => (b.rent_count || 0) - (a.rent_count || 0));\n  if (s.sort === 'low' && !idle) items = items.slice().sort((a, b) => (up(a) == null ? Infinity : up(a)) - (up(b) == null ? Infinity : up(b)));\n  if (s.sort === 'high' && !idle) items = items.slice().sort((a, b) => (up(b) || -1) - (up(a) || -1));\n  if (idle) items = items.slice(0, 8);\n  const bestIds = list.slice().sort((a, b) => (b.rent_count || 0) - (a.rent_count || 0)).filter(p => (p.rent_count || 0) >= 30).slice(0, 5).map(p => p.id);\n  const out = items.map(p => {\n    const k = p.category.kind, flow = FLOW[k], ok = p.available > 0, pr = p.price, u = UNIT[p.category.price_unit] || '';\n    const o = { name: p.name, photo: RA.photo(p.photos), best: bestIds.indexOf(p.id) > -1, sold: p.rent_count ? RA.num(p.rent_count) + '× disewa' : '',\n      href: flow ? flow + '.dc.html?id=' + p.id : ok ? 'Produk.dc.html?id=' + p.id : 'StokHabis.dc.html?id=' + p.id,\n      promo: promoOk(p) ? frTxt : '', was: '', sub: '', suf: u, price: pr ? RA.rp(pr.unit_price) : 'Tanya harga',\n      imgStyle: ok || k !== 'rental' ? '' : 'opacity: 0.45; filter: grayscale(1);',\n      dot: k !== 'rental' ? '#077A70' : ok ? (p.available === 1 ? '#E08A00' : '#1E9E5A') : '#D0472A',\n      status: k !== 'rental' ? 'Lihat jadwal' : ok ? (p.available === 1 ? 'Sisa 1 unit, cepat!' : 'Siap di tanggalmu') : 'Penuh di tanggalmu' };\n    if (pr && k === 'rental' && days > 1 && pr.unit_price != null) {\n      const fN = o.promo ? Math.max(0, ...frT.map(t => (+t.buy + +t.free) > 0 ? Math.floor(days / (+t.buy + +t.free)) * +t.free : 0)) : 0;\n      const tot = +pr.line_total - fN * +pr.unit_price;\n      o.price = RA.rp(tot); o.suf = ''; o.sub = fN > 0 ? 'Gratis ' + fN + ' hari · ' + days + ' hari' : RA.rp(pr.unit_price) + u + ' × ' + days + ' hari';\n      if (fN > 0) o.was = RA.rp(pr.line_total);\n    }\n    return o;\n  });\n  const ORD = ['motor', 'mobil', 'iphone', 'kamera', 'lensa', 'game', 'proyektor', 'camping', 'piknik', 'penginapan', 'jeep'], NM = { game: 'PlayStation' };\n  const seen = {}, catDefs = [];\n  list.forEach(p => { if (!seen[p.category.slug]) { seen[p.category.slug] = 1; catDefs.push([p.category.slug, NM[p.category.slug] || p.category.name]); } });\n  catDefs.sort((a, b) => (ORD.indexOf(a[0]) < 0 ? 99 : ORD.indexOf(a[0])) - (ORD.indexOf(b[0]) < 0 ? 99 : ORD.indexOf(b[0])));\n  const chipS = on => 'flex-shrink: 0; height: 36px; padding: 0 14px; border-radius: 18px; cursor: pointer; font: 700 13px \"Plus Jakarta Sans\", sans-serif; ' + (on ? 'border: 0; background: #1F2B4D; color: #FFFFFF;' : 'border: 0; background: #FFFFFF; color: #1F2B4D; box-shadow: 0 1px 6px rgba(31,43,77,0.08);');\n  const cats = [['all', 'Semua']].concat(catDefs).map(([id, label]) => ({ label, on: s.cat === id ? 'true' : 'false', pick: () => this.setState({ cat: id }), style: chipS(s.cat === id) }));\n  const POP = ['Honda Beat', 'iPhone', 'Sony', 'Canon', 'Tenda', 'PlayStation', 'Proyektor', 'GoPro'];\n  const has = t => list.some(p => (p.name + ' ' + p.category.name).toLowerCase().indexOf(t.toLowerCase()) > -1);\n  const pick = t => () => { this.setState({ q: t }); this.remember(t); };\n  const avail = items.filter(p => p.available > 0).length;\n  const msg = encodeURIComponent('Halo Rentalaja ' + (br.name || '') + ', apakah ada sewa \"' + (s.q || '') + '\"?');\n  return {\n    items: out, cats, q: s.q, sort: s.sort, idle,\n    recent: s.recent.map(t => ({ t, pick: pick(t) })), hasRecent: s.recent.length > 0,\n    clearRecent: () => { try { localStorage.removeItem('ra.recentSearch'); } catch (e) {} this.setState({ recent: [] }); },\n    popular: POP.filter(has).map(t => ({ t, pick: pick(t) })),\n    topTitle: !s.list ? 'Memuat…' : 'Paling sering disewa di ' + (br.name || 'cabang ini'),\n    ctxText: (br.name || 'Pilih cabang') + ' · ' + range + ' (' + RA.durText(c.start_at, c.end_at) + ')',\n    setQ: e => this.setQuery(e.target.value), clearQ: () => this.setState({ q: '' }),\n    setSort: e => this.setState({ sort: e.target.value }),\n    availOn: s.avail ? 'true' : 'false', toggleAvail: () => this.setState({ avail: !s.avail }),\n    availStyle: 'height: 32px; padding: 0 12px; border-radius: 16px; cursor: pointer; font: 700 12px \"Plus Jakarta Sans\", sans-serif; ' + (s.avail ? 'border: 0; background: #077A70; color: #FFFFFF;' : 'border: 0; background: #FFFFFF; color: #1F2B4D; box-shadow: 0 1px 6px rgba(31,43,77,0.08);'),\n    countText: !s.list ? 'Memuat…' : items.length + ' barang · ' + avail + ' tersedia',\n    emptyText: s.list && !items.length ? (list.length ? 'Coba kata lain, pilih kategori \"Semua\", atau matikan filter Tersedia.' : 'Belum ada barang di cabang ' + (br.name || 'ini') + '. Pilih cabang lain di Beranda.') : '',\n    waAsk: br.phone ? 'https://wa.me/' + br.phone + '?text=' + msg : 'Bantuan.dc.html'\n  };\n}\n}\n</script>\n</body>\n</html>\n"}