{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Pesanan saya</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0}\na{color:#1F2B4D}a:hover{color:#000}\n@keyframes raPulse{0%{transform:scale(.85);opacity:.7}70%{transform:scale(1.35);opacity:0}100%{opacity:0}}\n@keyframes raSpin{to{transform:rotate(360deg)}}\n.ra-pulse{position:absolute;inset:0;border-radius:50%;background:#FFFFFF;animation:raPulse 1.8s ease-out infinite}\n.ra-tabs::-webkit-scrollbar{display:none}\n</style>\n</helmet>\n<div style=\"width: 390px; height: 1500px; box-sizing: border-box; background: #F4F6F9; color: #1F2B4D; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; flex-direction: column; position: relative; overflow: hidden\">\n\n  <!-- ===================== DAFTAR PESANAN ===================== -->\n  <sc-if value=\"{{listMode}}\">\n  <header style=\"background: linear-gradient(160deg, #09BEAF 0%, #077A70 100%); padding: 18px 16px 62px; position: relative; overflow: hidden; display: flex; flex-direction: column; gap: 4px\">\n    <svg width=\"220\" height=\"220\" viewBox=\"0 0 220 220\" aria-hidden=\"true\" style=\"position: absolute; right: -70px; top: -80px; opacity: 0.18\"><circle cx=\"110\" cy=\"110\" r=\"100\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"30\"/></svg>\n    <b style=\"font-size: 24px; line-height: 30px; color: #FFFFFF; position: relative\">Pesananku</b>\n    <span style=\"font-size: 13px; color: rgba(255,255,255,0.92); position: relative\">{{listSub}}</span>\n  </header>\n  <div style=\"margin: -44px 16px 0; background: #FFFFFF; border-radius: 18px; box-shadow: 0 6px 20px rgba(31,43,77,0.10); padding: 6px; position: relative; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px\">\n    <sc-for list=\"{{tabs}}\" as=\"t\"><button type=\"button\" onClick=\"{{t.pick}}\" aria-pressed=\"{{t.on}}\" style=\"{{t.style}}\">{{t.label}}<sc-if value=\"{{t.n}}\"><span style=\"{{t.badge}}\">{{t.n}}</span></sc-if></button></sc-for>\n  </div>\n\n  <sc-if value=\"{{listLoading}}\"><div style=\"padding: 24px 16px; font-size: 14px; color: #5B6577\">Memuat pesanan…</div></sc-if>\n\n  <sc-if value=\"{{listEmpty}}\">\n  <section style=\"margin: 16px; background: #FFFFFF; border-radius: 20px; box-shadow: 0 2px 12px rgba(31,43,77,0.07); padding: 28px 20px; display: flex; flex-direction: column; align-items: center; gap: 10px; text-align: center\">\n    <svg width=\"120\" height=\"96\" viewBox=\"0 0 120 96\" aria-hidden=\"true\"><rect x=\"22\" y=\"18\" width=\"76\" height=\"66\" rx=\"12\" fill=\"#E3F7F5\"/><rect x=\"34\" y=\"32\" width=\"52\" height=\"7\" rx=\"3.5\" fill=\"#09BEAF\"/><rect x=\"34\" y=\"46\" width=\"38\" height=\"7\" rx=\"3.5\" fill=\"#B9ECE6\"/><rect x=\"34\" y=\"60\" width=\"44\" height=\"7\" rx=\"3.5\" fill=\"#B9ECE6\"/><circle cx=\"92\" cy=\"72\" r=\"16\" fill=\"#F7B955\"/><path d=\"M85 72l5 5 9-10\" fill=\"none\" stroke=\"#1F2B4D\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n    <b style=\"font-size: 17px\">{{emptyTitle}}</b>\n    <span style=\"font-size: 14px; line-height: 20px; color: #5B6577\">{{emptySub}}</span>\n    <a href=\"Cari.dc.html\" style=\"margin-top: 6px; height: 46px; padding: 0 22px; border-radius: 14px; background: #09BEAF; color: #1F2B4D; font-weight: 800; font-size: 15px; display: flex; align-items: center; text-decoration: none\">Cari barang</a>\n  </section>\n  </sc-if>\n\n  <section style=\"padding: 14px 16px 0; display: flex; flex-direction: column; gap: 12px\">\n    <sc-for list=\"{{orders}}\" as=\"o\" hint-placeholder-count=\"3\">\n    <div style=\"background: #FFFFFF; border-radius: 20px; box-shadow: 0 2px 12px rgba(31,43,77,0.07); overflow: hidden; display: flex; flex-direction: column\">\n      <a href=\"{{o.href}}\" style=\"display: flex; gap: 12px; padding: 14px; text-decoration: none; color: #1F2B4D\">\n        <div style=\"width: 68px; height: 68px; border-radius: 14px; background: linear-gradient(180deg, #F7F9FB, #E8EEF2); flex-shrink: 0; display: flex; align-items: center; justify-content: center; overflow: hidden; position: relative\">\n          <sc-if value=\"{{o.photo}}\"><img src=\"{{o.photo}}\" alt=\"\" style=\"width: 100%; height: 100%; object-fit: contain; padding: 6px; box-sizing: border-box\"></sc-if>\n          <sc-if value=\"{{o.more}}\"><span style=\"position: absolute; right: 4px; bottom: 4px; font-size: 10px; font-weight: 800; color: #FFFFFF; background: rgba(31,43,77,0.75); padding: 1px 6px; border-radius: 8px\">{{o.more}}</span></sc-if>\n        </div>\n        <div style=\"flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 3px\">\n          <div style=\"display: flex; justify-content: space-between; align-items: center; gap: 8px\"><span style=\"font-size: 11px; font-weight: 700; color: #5B6577\">{{o.code}}</span><span style=\"{{o.chip}}\">{{o.status}}</span></div>\n          <b style=\"font-size: 15px; line-height: 19px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden\">{{o.title}}</b>\n          <span style=\"font-size: 12px; color: #5B6577\">{{o.when}}</span>\n          <span style=\"font-size: 13px; font-weight: 800\">{{o.total}}</span>\n        </div>\n      </a>\n      <sc-if value=\"{{o.note}}\"><div style=\"{{o.noteStyle}}\">{{o.note}}</div></sc-if>\n      <sc-if value=\"{{o.cta}}\"><div style=\"padding: 0 14px 14px; display: flex; gap: 8px\">\n        <a href=\"{{o.ctaHref}}\" onClick=\"{{o.ctaGo}}\" style=\"flex: 1; height: 42px; border-radius: 12px; background: {{o.ctaBg}}; color: {{o.ctaFg}}; font-size: 14px; font-weight: 800; display: flex; align-items: center; justify-content: center; text-decoration: none\">{{o.cta}}</a>\n      </div></sc-if>\n    </div>\n    </sc-for>\n  </section>\n  <div style=\"height: 110px\"></div>\n  </sc-if>\n\n  <!-- ===================== DETAIL PESANAN ===================== -->\n  <sc-if value=\"{{ready}}\">\n  <header style=\"background: {{heroBg}}; padding: 10px 16px 70px; position: relative; overflow: hidden; display: flex; flex-direction: column; gap: 10px\">\n    <svg width=\"240\" height=\"240\" viewBox=\"0 0 220 220\" aria-hidden=\"true\" style=\"position: absolute; right: -80px; top: -70px; opacity: 0.16\"><circle cx=\"110\" cy=\"110\" r=\"100\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"30\"/></svg>\n    <div style=\"display: flex; align-items: center; justify-content: space-between; position: relative\">\n      <a href=\"Status.dc.html\" aria-label=\"Kembali\" style=\"width: 40px; height: 40px; border-radius: 20px; background: rgba(255,255,255,0.22); display: flex; align-items: center; justify-content: center\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"2.4\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M15 6l-6 6 6 6\"/></svg></a>\n      <span style=\"height: 28px; padding: 0 12px; border-radius: 14px; background: rgba(255,255,255,0.22); color: #FFFFFF; font-size: 12px; font-weight: 800; display: flex; align-items: center\">{{chipText}}</span>\n    </div>\n    <div style=\"display: flex; gap: 14px; align-items: center; position: relative; margin-top: 4px\">\n      <div style=\"width: 58px; height: 58px; flex-shrink: 0; position: relative; display: flex; align-items: center; justify-content: center\">\n        <sc-if value=\"{{pulse}}\"><span class=\"ra-pulse\"></span></sc-if>\n        <div style=\"position: relative; width: 58px; height: 58px; border-radius: 29px; background: #FFFFFF; display: flex; align-items: center; justify-content: center; box-shadow: 0 6px 16px rgba(0,0,0,0.12)\">\n          <sc-if value=\"{{iconSearch}}\"><svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#077A70\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"5\" width=\"13\" height=\"10\" rx=\"2\"/><circle cx=\"8\" cy=\"10\" r=\"2\"/><circle cx=\"17\" cy=\"16\" r=\"4\"/><path d=\"M20 19l2 2\"/></svg></sc-if>\n          <sc-if value=\"{{iconPay}}\"><svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#C47F00\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"2.5\" y=\"6\" width=\"19\" height=\"13\" rx=\"2.5\"/><path d=\"M2.5 10h19M6.5 15h4\"/></svg></sc-if>\n          <sc-if value=\"{{iconCheck}}\"><svg width=\"30\" height=\"30\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#077A70\" stroke-width=\"2.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12l5 5 9-10\"/></svg></sc-if>\n          <sc-if value=\"{{iconX}}\"><svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#A12A1F\" stroke-width=\"2.6\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M7 7l10 10M17 7L7 17\"/></svg></sc-if>\n        </div>\n      </div>\n      <div style=\"display: flex; flex-direction: column; gap: 4px; min-width: 0\">\n        <h1 style=\"margin: 0; font-size: 22px; line-height: 27px; font-weight: 800; color: #FFFFFF\">{{title}}</h1>\n        <sc-if value=\"{{lead}}\"><p style=\"margin: 0; font-size: 13px; line-height: 19px; color: rgba(255,255,255,0.92)\">{{lead}}</p></sc-if>\n      </div>\n    </div>\n  </header>\n\n  <!-- progres singkat -->\n  <section style=\"margin: -48px 16px 0; position: relative; background: #FFFFFF; border-radius: 20px; box-shadow: 0 6px 20px rgba(31,43,77,0.10); padding: 16px 12px 14px; display: flex; flex-direction: column; gap: 14px\">\n    <div style=\"display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); position: relative\">\n      <div style=\"position: absolute; left: 10%; right: 10%; top: 15px; height: 3px; background: #E6E9EE; border-radius: 2px\"></div>\n      <div style=\"{{barFill}}\"></div>\n      <sc-for list=\"{{chips}}\" as=\"p\" hint-placeholder-count=\"5\">\n        <div style=\"display: flex; flex-direction: column; align-items: center; gap: 6px; position: relative\">\n          <div style=\"{{p.dot}}\">{{p.n}}</div>\n          <span style=\"{{p.lbl}}\">{{p.t}}</span>\n        </div>\n      </sc-for>\n    </div>\n    <sc-if value=\"{{nextBox}}\"><div style=\"background: #F2FBFA; border-radius: 14px; padding: 12px; display: flex; gap: 10px; align-items: flex-start\">\n      <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#077A70\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" style=\"flex-shrink: 0; margin-top: 1px\"><path d=\"M12 3a7 7 0 0 1 7 7c0 5-7 11-7 11S5 15 5 10a7 7 0 0 1 7-7z\"/><circle cx=\"12\" cy=\"10\" r=\"2.5\"/></svg>\n      <span style=\"display: flex; flex-direction: column; gap: 2px\"><b style=\"font-size: 13px\">Selanjutnya</b><span style=\"font-size: 13px; line-height: 19px; color: #3A4558\">{{nextBox}}</span></span>\n    </div></sc-if>\n    <sc-if value=\"{{cta}}\"><a href=\"{{ctaHref}}\" style=\"height: 50px; border-radius: 14px; background: #09BEAF; color: #1F2B4D; font-size: 16px; font-weight: 800; display: flex; align-items: center; justify-content: center; text-decoration: none\">{{cta}}</a></sc-if>\n  </section>\n\n  <sc-if value=\"{{showCode}}\"><section style=\"margin: 12px 16px 0; background: linear-gradient(135deg, #1F2B4D, #2E3F6E); color: #FFFFFF; border-radius: 20px; padding: 16px; display: flex; flex-direction: column; align-items: center; gap: 4px; text-align: center\">\n    <span style=\"font-size: 12px; font-weight: 700; color: #9BE7E0\">KODE AMBIL UNIT</span>\n    <span style=\"font-size: 34px; font-weight: 800; letter-spacing: 0.14em\">{{b.pickup_code}}</span>\n    <span style=\"font-size: 12px; color: #DDE3EE\">Tunjukkan kode ini ke staf saat ambil unit.</span>\n  </section></sc-if>\n\n  <!-- nomor booking -->\n  <section style=\"margin: 12px 16px 0; background: #FFFFFF; border-radius: 20px; box-shadow: 0 2px 12px rgba(31,43,77,0.07); padding: 14px 16px; display: flex; justify-content: space-between; align-items: center; gap: 10px\">\n    <div style=\"display: flex; flex-direction: column\"><span style=\"font-size: 12px; color: #5B6577\">Nomor booking</span><b style=\"font-size: 18px; letter-spacing: 0.04em\">{{b.code}}</b></div>\n    <button type=\"button\" onClick=\"{{copy}}\" style=\"height: 38px; padding: 0 14px; border-radius: 12px; border: 1.5px solid #E1E5EA; background: #FFFFFF; color: #1F2B4D; font: 700 13px 'Plus Jakarta Sans', sans-serif; cursor: pointer; display: flex; align-items: center; gap: 6px\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#077A70\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"8\" y=\"8\" width=\"12\" height=\"12\" rx=\"2\"/><path d=\"M16 8V5a1 1 0 0 0-1-1H5a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h3\"/></svg>{{copyLabel}}</button>\n  </section>\n  <sc-if value=\"{{hasInvoice}}\"><div style=\"margin: 8px 16px 0; display: flex; justify-content: center\"><button type=\"button\" onClick=\"{{invoice}}\" style=\"height: 40px; padding: 0 16px; border-radius: 12px; border: 1.5px solid #E1E5EA; background: #FFFFFF; color: #1F2B4D; font: 700 13px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">📄 Unduh invoice (PDF)</button></div></sc-if>\n\n  <!-- barang & biaya -->\n  <section style=\"margin: 12px 16px 0; background: #FFFFFF; border-radius: 20px; box-shadow: 0 2px 12px rgba(31,43,77,0.07); padding: 16px; display: flex; flex-direction: column; gap: 12px\">\n    <b style=\"font-size: 16px\">Barang yang disewa</b>\n    <sc-for list=\"{{items}}\" as=\"it\">\n      <div style=\"display: flex; gap: 12px; align-items: center\">\n        <div style=\"width: 52px; height: 52px; border-radius: 12px; background: linear-gradient(180deg, #F7F9FB, #E8EEF2); flex-shrink: 0; overflow: hidden; display: flex; align-items: center; justify-content: center\"><sc-if value=\"{{it.photo}}\"><img src=\"{{it.photo}}\" alt=\"\" style=\"width: 100%; height: 100%; object-fit: contain; padding: 4px; box-sizing: border-box\"></sc-if></div>\n        <div style=\"flex: 1; min-width: 0; display: flex; flex-direction: column\"><b style=\"font-size: 14px\">{{it.name}}</b><span style=\"font-size: 12px; color: #5B6577\">{{it.qty}}</span></div>\n      </div>\n    </sc-for>\n    <div style=\"display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: 8px; background: #F4F6F9; border-radius: 14px; padding: 10px 12px\">\n      <span style=\"display: flex; flex-direction: column; min-width: 0\"><span style=\"font-size: 11px; color: #5B6577\">Ambil</span><b style=\"font-size: 13px; line-height: 17px\">{{pickText}}</b></span>\n      <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#8A93A3\" stroke-width=\"2.2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg>\n      <span style=\"display: flex; flex-direction: column; min-width: 0\"><span style=\"font-size: 11px; color: #5B6577\">Kembali</span><b style=\"font-size: 13px; line-height: 17px\">{{returnText}}</b></span>\n    </div>\n    <div style=\"display: flex; gap: 10px; align-items: flex-start; font-size: 13px; line-height: 18px\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#077A70\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" style=\"flex-shrink: 0\"><path d=\"M12 3a7 7 0 0 1 7 7c0 5-7 11-7 11S5 15 5 10a7 7 0 0 1 7-7z\"/><circle cx=\"12\" cy=\"10\" r=\"2.5\"/></svg><span><b>{{placeText}}</b><sc-if value=\"{{placeSub}}\"><br><span style=\"color: {{placeSubColor}}\">{{placeSub}}</span></sc-if></span></div>\n    <sc-if value=\"{{addrHref}}\"><a href=\"{{addrHref}}\" style=\"{{addrBtn}}\">{{addrLabel}}</a></sc-if>\n    <sc-if value=\"{{retText}}\"><div style=\"display: flex; gap: 10px; font-size: 14px; line-height: 20px\"><span aria-hidden=\"true\" style=\"width: 20px; text-align: center; flex-shrink: 0\">🔁</span><span><b>{{retText}}</b><br><span style=\"color: #5B6577\">{{retSub}}</span></span></div></sc-if>\n    <div style=\"height: 1px; background: #EEF0F3\"></div>\n    <sc-for list=\"{{money}}\" as=\"m\"><div style=\"display: flex; justify-content: space-between; font-size: 14px\"><span style=\"color: #5B6577\">{{m.label}}</span><b>{{m.value}}</b></div></sc-for>\n  </section>\n\n  <!-- perjalanan -->\n  <section style=\"margin: 12px 16px 0; background: #FFFFFF; border-radius: 20px; box-shadow: 0 2px 12px rgba(31,43,77,0.07); padding: 16px; display: flex; flex-direction: column\">\n    <b style=\"font-size: 16px; margin-bottom: 12px\">Perjalanan sewamu</b>\n    <sc-for list=\"{{steps}}\" as=\"s\" hint-placeholder-count=\"5\">\n      <div style=\"display: flex; gap: 12px\">\n        <div style=\"display: flex; flex-direction: column; align-items: center; width: 22px; flex-shrink: 0\">\n          <div style=\"{{s.dot}}\"></div>\n          <sc-if value=\"{{s.line}}\" hint-placeholder-val=\"{{true}}\"><div style=\"{{s.lineStyle}}\"></div></sc-if>\n        </div>\n        <div style=\"padding-bottom: 14px; display: flex; flex-direction: column; gap: 2px\">\n          <div style=\"{{s.titleStyle}}\">{{s.t}}</div>\n          <div style=\"font-size: 12px; line-height: 17px; color: #5B6577\">{{s.d}}</div>\n        </div>\n      </div>\n    </sc-for>\n  </section>\n\n  <section style=\"margin: 12px 16px 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px\">\n    <a href=\"{{waHref}}\" style=\"height: 50px; border-radius: 14px; background: #FFFFFF; box-shadow: 0 2px 12px rgba(31,43,77,0.07); color: #1F2B4D; font-size: 14px; font-weight: 800; display: flex; align-items: center; justify-content: center; gap: 8px; text-decoration: none\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"#25D366\" aria-hidden=\"true\"><path d=\"M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.4.8 3.2.7.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3z\"/></svg>Chat cabang</a>\n    <button type=\"button\" onClick=\"{{saveCal}}\" style=\"height: 50px; border-radius: 14px; border: 0; background: #FFFFFF; box-shadow: 0 2px 12px rgba(31,43,77,0.07); color: #1F2B4D; font: 800 14px 'Plus Jakarta Sans', sans-serif; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#077A70\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"3\"/><path d=\"M8 3v4M16 3v4M3 10h18\"/></svg>Ke kalender</button>\n  </section>\n  <div style=\"margin: 8px 16px 0; font-size: 11px; line-height: 16px; color: #5B6577; text-align: center\">Chat otomatis menyertakan nomor booking, jadi admin tidak perlu tanya ulang.</div>\n  <sc-if value=\"{{canChange}}\"><a href=\"{{ubahHref}}\" style=\"margin: 12px 16px 0; height: 46px; border-radius: 14px; border: 1.5px solid #E1E5EA; color: #3A4558; font-size: 14px; font-weight: 700; display: flex; align-items: center; justify-content: center; text-decoration: none\">Ubah jadwal atau batalkan</a></sc-if>\n  <div style=\"height: 110px\"></div>\n  </sc-if>\n</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{\"$preview\":{\"width\":390,\"height\":1500}}'>\nclass Component extends DCLogic {\nstate = { b: null, events: [], list: null, tab: 'run', copied: false };\nasync componentDidMount() { this.ensure(); }\nensure() {\n  const k = (this.params && this.params.id) || '__list';\n  if (this._for === k) return;\n  this._for = k;\n  if (this.stop) { this.stop(); this.stop = null; }\n  if (k === '__list') { this.setState({ b: null, events: [] }); this.loadList(); }\n  else { this.setState({ b: null, events: [] }); this.stop = RA.poll(this, () => this.load(), 10000); }\n  try { window.scrollTo(0, 0); } catch (e) {}\n}\ncomponentWillUnmount() { if (this.stop) this.stop(); }\nasync loadList() {\n  if (!RA.isLoggedIn()) { this.setState({ list: [] }); return; }\n  const { data, error } = await RA.from('bookings').select('id,code,status,line,start_at,end_at,total,paid_amount,dp_amount,hold_expires_at,branch_id,created_at,branches(name),booking_items(product_id,quantity,status,products(id,name,photos))').order('created_at', { ascending: false }).limit(60);\n  if (!RA_ALIVE(this)) return;\n  if (error) RA.err(error.message);\n  const list = data || [];\n  const RUN = ['pending_verification', 'rejected', 'awaiting_payment', 'confirmed', 'active', 'returned'];\n  this.setState({ list, tab: list.some(b => RUN.indexOf(b.status) > -1) || !list.length ? 'run' : 'done' });\n}\nasync load() {\n  const sel = '*,branches(name,address,phone,maps_url,cs_start,cs_end,lat,lng),booking_items(product_id,quantity,qty,status,products(name,photos))';\n  const want = this.params.id;\n  const { data: b, error } = await RA.from('bookings').select(sel).eq('id', want).maybeSingle();\n  if (!RA_ALIVE(this) || this.params.id !== want) return;\n  if (error) { RA.err(error.message); return; }\n  if (!b) { const ot = await RA.call('booking_owner_hint', { p_id: want }).catch(() => null); if (ot) { location.replace('#/Bayar?id=' + want); return; } location.replace('#/Status'); return; }\n  const ev = await RA.from('booking_events').select('kind,label,at').eq('booking_id', b.id).order('at');\n  if (!RA_ALIVE(this)) return;\n  const prev = this.state.b && this.state.b.status;\n  this.setState({ b, events: ev.data || [] });\n  const go = n => location.replace('#/' + n + '?id=' + b.id);\n  if (b.status === 'rejected') return go('Ditolak');\n  if (b.status === 'expired') return go('Kedaluwarsa');\n  if (b.status === 'active') return go('Aktif');\n  if (prev && prev !== b.status) {\n    if (b.status === 'awaiting_payment') { RA.ok('Dokumen lolos verifikasi. Silakan bayar.'); return go('Bayar'); }\n    if (b.status === 'confirmed') RA.ok('Booking terkonfirmasi');\n  }\n}\noutsideCs(br) {\n  const st = (br && br.cs_start) || RA.setting('cs_hours_start'), en = (br && br.cs_end) || RA.setting('cs_hours_end');\n  if (!st || !en) return null;\n  const m = t => { const p = String(t).split(/[:.]/); return (+p[0]) * 60 + (+p[1] || 0); };\n  const now = new Date(), cur = now.getHours() * 60 + now.getMinutes(), a = m(st), z = m(en);\n  const out = a <= z ? (cur < a || cur >= z) : (cur < a && cur >= z);\n  return out ? { start: String(st).slice(0, 5).replace(':', '.'), tomorrow: cur >= z && a <= z } : null;\n}\nics() {\n  const b = this.state.b; if (!b) return;\n  const f = d => new Date(d).toISOString().replace(/[-:]/g, '').replace(/\\.\\d{3}/, '');\n  const names = (b.booking_items || []).map(i => i.products && i.products.name).filter(Boolean).join(', ');\n  const txt = ['BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//Rentalaja//ID', 'BEGIN:VEVENT', 'UID:' + b.id + '@rentalaja', 'DTSTAMP:' + f(new Date()),\n    'DTSTART:' + f(b.start_at), 'DTEND:' + f(b.end_at), 'SUMMARY:Sewa Rentalaja ' + b.code + (names ? ' · ' + names : ''),\n    'LOCATION:' + ((b.branches || {}).address || (b.branches || {}).name || ''), 'END:VEVENT', 'END:VCALENDAR'].join('\\r\\n');\n  const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([txt], { type: 'text/calendar' })); a.download = b.code + '.ics';\n  document.body.appendChild(a); a.click(); a.remove();\n}\nagain(b) {\n  RA.setCtx({ branch_id: b.branch_id });\n  const seen = {};\n  (b.booking_items || []).filter(i => i.status !== 'released').forEach(i => { if (!seen[i.product_id]) { seen[i.product_id] = 1; RA.addToCart({ product_id: i.product_id }); } });\n  RA.go('Keranjang');\n}\nlistVals() {\n  const s = this.state, list = s.list;\n  const RUN = ['pending_verification', 'rejected', 'awaiting_payment', 'confirmed', 'active', 'returned'];\n  const run = (list || []).filter(b => RUN.indexOf(b.status) > -1), done = (list || []).filter(b => RUN.indexOf(b.status) < 0);\n  run.sort((a, b) => new Date(a.start_at) - new Date(b.start_at));\n  const tabS = on => 'height: 42px; border-radius: 13px; border: 0; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 6px; font: 800 14px \"Plus Jakarta Sans\", sans-serif; ' + (on ? 'background: #077A70; color: #FFFFFF;' : 'background: transparent; color: #5B6577;');\n  const badge = on => 'min-width: 20px; height: 20px; padding: 0 6px; box-sizing: border-box; border-radius: 10px; font-size: 11px; display: flex; align-items: center; justify-content: center; ' + (on ? 'background: #FFFFFF; color: #077A70;' : 'background: #E6E9EE; color: #3A4558;');\n  const tabs = [['run', 'Berjalan', run.length], ['done', 'Riwayat', done.length]].map(([id, label, n]) => ({ label, n: n ? String(n) : '', on: s.tab === id ? 'true' : 'false', style: tabS(s.tab === id), badge: badge(s.tab === id), pick: () => this.setState({ tab: id }) }));\n  const src = s.tab === 'run' ? run : done;\n  const orders = src.map(b => {\n    const its = (b.booking_items || []).filter(i => i.status !== 'released');\n    const seen = {}, prods = []; its.forEach(i => { if (i.products && !seen[i.product_id]) { seen[i.product_id] = 1; prods.push(i.products); } });\n    const st = RA.STATUS[b.status] || [b.status, 'mute'];\n    const owe = Math.max(0, +b.dp_amount - +b.paid_amount);\n    let note = '', noteTone = '', cta = '', ctaHref = '', ctaGo = null, ctaBg = '#09BEAF', ctaFg = '#1F2B4D';\n    if (b.status === 'pending_verification') { note = 'Dokumen sedang dicek tim cabang. Kamu dikabari lewat WhatsApp.'; noteTone = 'info'; }\n    else if (b.status === 'awaiting_payment') { note = 'Lolos verifikasi! Bayar ' + RA.rp(owe) + (b.hold_expires_at ? ' sebelum ' + RA.time(b.hold_expires_at) : '') + ' supaya unit tetap untukmu.'; noteTone = 'warn'; cta = 'Bayar sekarang'; ctaHref = 'Bayar.dc.html?id=' + b.id; }\n    else if (b.status === 'confirmed') { note = 'Siap ' + (b.line === 'experience' ? 'dinikmati' : 'diambil') + ' ' + RA.dayTime(b.start_at) + '. Tunjukkan kode ambil di halaman detail.'; noteTone = 'good'; }\n    else if (b.status === 'active') { note = 'Sedang dipakai · kembali ' + RA.dayTime(b.end_at); noteTone = 'teal'; cta = 'Perpanjang / lihat detail'; ctaHref = 'Aktif.dc.html?id=' + b.id; }\n    else if (b.status === 'rejected') { note = 'Dokumen perlu diperbaiki.'; noteTone = 'bad'; cta = 'Perbaiki dokumen'; ctaHref = 'Ditolak.dc.html?id=' + b.id; }\n    else if ((b.status === 'completed' || b.status === 'returned') && its.length) { cta = 'Sewa lagi'; ctaHref = 'Keranjang.dc.html'; ctaGo = e => { if (e && e.preventDefault) e.preventDefault(); this.again(b); }; ctaBg = '#E3F7F5'; ctaFg = '#077A70'; }\n    const T = { info: ['#EEF3FB', '#2C3E66'], warn: ['#FFF4D6', '#7A4B00'], good: ['#E4F6EC', '#1E7A47'], teal: ['#E3F7F5', '#077A70'], bad: ['#FDECEA', '#A12A1F'] }[noteTone] || ['#F4F6F9', '#3A4558'];\n    const href = b.status === 'active' ? 'Aktif.dc.html?id=' + b.id : /^RM-/.test(b.code) ? 'InapTiket.dc.html?id=' + b.id : /^JP-/.test(b.code) ? 'JeepTiket.dc.html?id=' + b.id : /^MS-/.test(b.code) ? 'MobilSopirStatus.dc.html?id=' + b.id : 'Status.dc.html?id=' + b.id;\n    return { href, code: b.code, status: st[0], chip: RA.chip(st[1]), photo: RA.photo((prods[0] || {}).photos), more: prods.length > 1 ? '+' + (prods.length - 1) : '',\n      title: prods.map(p => p.name).join(', ') || 'Pesanan ' + b.code,\n      when: RA.date(b.start_at) + ' → ' + RA.date(b.end_at) + ((b.branches || {}).name ? ' · ' + b.branches.name : ''),\n      total: RA.rp(b.total), note, noteStyle: 'margin: 0 14px 12px; padding: 10px 12px; border-radius: 12px; font-size: 12px; line-height: 17px; font-weight: 600; background: ' + T[0] + '; color: ' + T[1],\n      cta, ctaHref, ctaGo, ctaBg, ctaFg };\n  });\n  return {\n    listMode: true, ready: false, listLoading: !list, tabs, orders,\n    listSub: !list ? 'Memuat…' : run.length ? run.length + ' pesanan berjalan' : 'Tidak ada pesanan berjalan',\n    listEmpty: !!list && !orders.length,\n    emptyTitle: s.tab === 'run' ? 'Belum ada pesanan berjalan' : 'Belum ada riwayat',\n    emptySub: s.tab === 'run' ? 'Pesanan yang kamu buat muncul di sini lengkap dengan statusnya.' : 'Pesanan yang sudah selesai akan tersimpan di sini.'\n  };\n}\nrenderVals() {\n  const s = this.state;\n  if (this._for !== undefined && this._for !== ((this.params && this.params.id) || '__list')) setTimeout(() => this.ensure(), 0);\n  if (!this.params.id) return this.listVals();\n  const b = s.b;\n  if (!b) return { listMode: false, ready: false };\n  const br = b.branches || {}, st = b.status;\n  const dpLeft = Math.max(0, +b.dp_amount - +b.paid_amount);\n  const hold = RA.setting('payment_hold_minutes');\n  const off = st === 'pending_verification' ? this.outsideCs(br) : null;\n  let title = '', lead = '', icon = 'check', cta = '', ctaHref = '', nextBox = '';\n  if (st === 'pending_verification') {\n    icon = 'search';\n    title = off ? 'Booking diterima, dicek pukul ' + off.start : 'Dokumenmu sedang dicek';\n    lead = 'Jadwal sudah dikunci untukmu. Belum ada yang perlu dibayar.';\n    nextBox = (off ? 'CS mulai bertugas' + (off.tomorrow ? ' besok' : '') + ' pukul ' + off.start + '. ' : '') + 'Begitu lolos, link bayar ' + (+b.dp_amount > 0 && +b.dp_amount < +b.total ? 'DP ' : '') + 'dikirim ke emailmu dan muncul di sini.' + (hold != null ? ' Bayar dalam ' + hold + ' menit supaya unit tetap untukmu.' : '') + ' Kalau tidak lolos, booking batal tanpa biaya.';\n  } else if (st === 'awaiting_payment') {\n    icon = 'pay'; title = 'Lolos verifikasi, tinggal bayar';\n    lead = 'Bayar ' + RA.rp(dpLeft) + (b.hold_expires_at ? ' sebelum pukul ' + RA.time(b.hold_expires_at) : '') + ' supaya unit tetap untukmu.';\n    cta = 'Bayar ' + RA.rp(dpLeft) + ' sekarang'; ctaHref = 'Bayar.dc.html?id=' + b.id;\n  } else if (st === 'confirmed') {\n    title = 'Booking terkonfirmasi';\n    lead = (b.delivery_mode === 'delivery' ? 'Unit diantar ke alamatmu ' : 'Ambil unit di cabang ') + RA.dayTime(b.start_at) + '.';\n    nextBox = 'Bawa KTP asli saat ambil unit dan tunjukkan kode ambil di bawah. Pengingat dikirim lewat WhatsApp sebelum jadwal.';\n  } else if (st === 'cancelled') { title = 'Booking dibatalkan'; icon = 'x'; lead = b.cancel_reason || ''; }\n  else if (st === 'returned' || st === 'completed') { title = 'Sewa selesai, terima kasih!'; lead = 'Ceritakan pengalamanmu supaya kami makin baik.'; cta = 'Beri ulasan'; ctaHref = 'Ulasan.dc.html?id=' + b.id; }\n  else if (st === 'no_show') { title = 'Unit tidak diambil'; icon = 'x'; }\n  else { title = (RA.STATUS[st] || [st])[0]; }\n  const heroBg = icon === 'x' ? 'linear-gradient(160deg, #8A93A3 0%, #5B6577 100%)' : icon === 'pay' ? 'linear-gradient(160deg, #F2A93B 0%, #C47F00 100%)' : 'linear-gradient(160deg, #09BEAF 0%, #077A70 100%)';\n  // langkah ringkas\n  const stage = { pending_verification: 0, rejected: 0, awaiting_payment: 1, confirmed: 2, active: 3, returned: 4, completed: 5, cancelled: -1, expired: -1, no_show: -1 }[st];\n  const CH = ['Cek data', 'Bayar', 'Siap', 'Dipakai', 'Selesai'];\n  const chips = CH.map((t, i) => { const done = stage > i, now = stage === i;\n    return { t, n: done ? '✓' : String(i + 1),\n      dot: 'width: 32px; height: 32px; border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 800; box-sizing: border-box; ' + (done ? 'background: #077A70; color: #FFFFFF;' : now ? 'background: #FFFFFF; color: #077A70; border: 3px solid #09BEAF; box-shadow: 0 0 0 4px #E3F7F5;' : 'background: #FFFFFF; color: #8A93A3; border: 2px solid #E1E5EA;'),\n      lbl: 'font-size: 11px; font-weight: ' + (now ? '800; color: #077A70' : done ? '700; color: #1F2B4D' : '600; color: #8A93A3') }; });\n  const pct = stage < 0 ? 0 : Math.min(4, stage) / 4 * 80;\n  const barFill = 'position: absolute; left: 10%; top: 15px; height: 3px; width: ' + pct + '%; background: #09BEAF; border-radius: 2px';\n  // timeline\n  const ev = k => s.events.find(e => e.kind === k);\n  const at = e => e ? RA.dayTime(e.at) : '';\n  const verifiedAuto = !ev('verified') && st !== 'pending_verification' && st !== 'rejected';\n  const noDp = +b.dp_amount === 0;\n  const tStage = { pending_verification: 1, rejected: 1, awaiting_payment: 2, confirmed: 3, active: 4, returned: 5, completed: 6, cancelled: -1, expired: -1, no_show: -1 }[st];\n  const raw = [\n    { t: 'Booking dibuat', d: 'Jadwal dikunci sementara untukmu.' + (ev('created') ? ' ' + at(ev('created')) : '') },\n    { t: 'Verifikasi data', d: ev('verified') ? 'Lolos · ' + at(ev('verified')) : verifiedAuto ? 'Pelanggan terverifikasi, tidak perlu cek ulang.' : 'Tim cabang mengecek KTP, dokumen, dan datamu' + (RA.setting('verification_target_minutes') != null ? ' · maks. ' + RA.setting('verification_target_minutes') + ' menit' : '') + '.' },\n    { t: noDp ? 'Tanpa DP' : +b.dp_amount < +b.total ? 'Bayar DP' : 'Bayar', d: noDp ? 'Sisa dibayar saat ambil unit.' : ev('paid') ? 'Diterima · ' + at(ev('paid')) : 'Link QRIS/VA muncul di sini setelah lolos.' },\n    { t: b.delivery_mode === 'delivery' ? 'Siap diantar' : 'Siap diambil', d: 'Pengingat dikirim lewat WhatsApp sebelum jadwal.' },\n    { t: 'Sedang dipakai', d: 'Perpanjang sewa langsung dari aplikasi.' },\n    { t: 'Dikembalikan', d: 'Unit dicek, lalu KTP asli dikembalikan.' }\n  ];\n  const D = 'width: 14px; height: 14px; border-radius: 7px; box-sizing: border-box; margin-top: 3px; ';\n  const steps = raw.map((x, i) => { const sx = tStage < 0 ? (i === 0 ? 'done' : 'next') : i < tStage ? 'done' : i === tStage ? 'now' : 'next';\n    return { ...x, dot: D + (sx === 'done' ? 'background: #077A70;' : sx === 'now' ? 'background: #09BEAF; box-shadow: 0 0 0 4px #E3F7F5;' : 'background: #FFFFFF; border: 2px solid #C5CBD4;'),\n      lineStyle: 'width: 2px; flex-grow: 1; min-height: 24px; background: ' + (sx === 'done' ? '#077A70' : '#E6E9EE'),\n      titleStyle: 'font-size: 14px; font-weight: ' + (sx === 'next' ? '600; color: #8A93A3' : '800; color: #1F2B4D'), line: i < raw.length - 1 }; });\n  const money = [];\n  const rest = +b.total + +b.late_fee + +b.damage_fee - Math.max(+b.paid_amount, 0);\n  const after = st === 'pending_verification' ? ' (setelah lolos)' : '';\n  money.push({ label: 'Total sewa', value: RA.rp(b.total) });\n  if (+b.paid_amount > 0) money.push({ label: 'Sudah dibayar', value: RA.rp(b.paid_amount) });\n  else if (+b.dp_amount > 0 && +b.dp_amount < +b.total) money.push({ label: 'DP' + (b.dp_percent != null ? ' ' + b.dp_percent + '%' : '') + after, value: RA.rp(b.dp_amount) });\n  else if (+b.dp_amount > 0) money.push({ label: 'Bayar lunas' + after, value: RA.rp(b.dp_amount) });\n  const restAfter = +b.paid_amount > 0 ? rest : +b.total - +b.dp_amount;\n  if (restAfter > 0) money.push({ label: 'Sisa saat ambil', value: RA.rp(restAfter) });\n  const agg = {};\n  (b.booking_items || []).filter(i => i.status !== 'released').forEach(i => { const n = (i.products && i.products.name) || 'Barang'; if (!agg[n]) agg[n] = { name: n, q: 0, photo: RA.photo(i.products && i.products.photos) }; agg[n].q += (i.quantity || 1); });\n  const items = Object.keys(agg).map(k => ({ name: agg[k].name, photo: agg[k].photo, qty: agg[k].q + ' unit · ' + RA.durText(b.start_at, b.end_at) }));\n  const msg = encodeURIComponent('Halo Rentalaja ' + (br.name || '') + ', saya mau tanya booking ' + b.code + '.');\n  return {\n    listMode: false, ready: true, b, heroBg, pulse: st === 'pending_verification',\n    iconSearch: icon === 'search', iconPay: icon === 'pay', iconCheck: icon === 'check', iconX: icon === 'x',\n    chipText: (RA.STATUS[st] || [st])[0], title, lead, cta, ctaHref, nextBox, chips, barFill,\n    showCode: (st === 'confirmed' || st === 'active') && !!b.pickup_code,\n    hasInvoice: +(b.paid_amount || 0) > 0 && st !== 'cancelled',\n    invoice: () => RA.invoice(b.id, b.code),\n    copyLabel: s.copied ? 'Tersalin' : 'Salin',\n    copy: () => { try { navigator.clipboard.writeText(b.code); } catch (e) {} this.setState({ copied: true }); RA.toast('Nomor booking disalin'); },\n    items, pickText: RA.dayTime(b.start_at), returnText: RA.dayTime(b.end_at),\n    placeText: b.delivery_mode === 'delivery' ? 'Diantar ke alamatmu' + (b.delivery_slot ? ' · ' + b.delivery_slot : '') : 'Ambil di cabang ' + (br.name || ''),\n    retText: b.return_mode === 'pickup' ? 'Dijemput saat selesai' + (b.return_slot ? ' · ' + b.return_slot : '') : '',\n    retSub: b.return_mode === 'pickup' ? (String(b.return_address || '').trim() ? b.return_address + (b.return_landmark ? ' · ' + b.return_landmark : '') : 'Di alamat antar yang sama') : '',\n    placeSub: b.delivery_mode === 'delivery' ? (String(b.delivery_address || '').trim() || '⚠ Alamat antar belum lengkap — isi paling lambat H-1 supaya petugas tidak salah alamat.') : (br.address || ''),\n    placeSubColor: b.delivery_mode === 'delivery' && !String(b.delivery_address || '').trim() ? '#A12A1F' : '#5B6577',\n    addrHref: b.delivery_mode === 'delivery' && ['pending_verification', 'awaiting_payment', 'confirmed'].indexOf(b.status) > -1 && new Date(b.start_at).getTime() > Date.now() + 2 * 3600e3 ? 'Antar.dc.html?edit=1&back=Status&id=' + b.id : '',\n    addrLabel: String(b.delivery_address || '').trim() ? 'Ubah alamat antar' : '📍 Lengkapi alamat antar',\n    addrBtn: 'height: 42px; border-radius: 12px; display: flex; align-items: center; justify-content: center; text-decoration: none; font-size: 14px; font-weight: 800; ' + (String(b.delivery_address || '').trim() ? 'border: 1.5px solid #E1E5EA; color: #3A4558;' : 'background: #09BEAF; color: #1F2B4D;'),\n    money, steps, saveCal: () => this.ics(),\n    waHref: br.phone ? 'https://wa.me/' + br.phone + '?text=' + msg : 'Bantuan.dc.html',\n    canChange: ['pending_verification', 'awaiting_payment', 'confirmed'].indexOf(st) > -1, ubahHref: 'Ubah.dc.html?id=' + b.id\n  };\n}\n}\n</script>\n</body>\n</html>\n"}