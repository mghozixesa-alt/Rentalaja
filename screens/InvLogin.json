{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Masuk investor</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0}\na{color:#1F2B4D}a:hover{color:#000}\n</style>\n</helmet>\n<div style=\"width: 390px; height: 844px; box-sizing: border-box; background: #FFFFFF; color: #1F2B4D; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; flex-direction: column; position: relative; overflow: hidden\">\n<header style=\"display: flex; align-items: center; gap: 8px; padding: 10px 12px; border-bottom: 1px solid #E6E8EC\">\n    <a href=\"InvGabung.dc.html\" aria-label=\"Kembali\" style=\"width: 44px; height: 44px; display: flex; align-items: center; justify-content: center\">\n      <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1F2B4D\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M15 6l-6 6 6 6\"/></svg>\n    </a>\n    <div style=\"display: flex; flex-direction: column\"><div style=\"font-size: 18px; font-weight: 800\">Masuk sebagai investor</div></div>\n  </header>\n  <section style=\"padding: 24px 20px 0; display: flex; flex-direction: column; gap: 16px\">\n    <h1 style=\"margin: 0; font-size: 24px; line-height: 30px; font-weight: 800\">Akses aman untuk data aset Anda</h1>\n    <label style=\"display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 700; color: #4A5468\">Nomor HP terdaftar<input type=\"tel\" inputmode=\"tel\" autocomplete=\"tel\" placeholder=\"0812 xxxx xxxx\" value=\"{{phone}}\" onChange=\"{{setPhone}}\" disabled=\"{{isOtp}}\" style=\"height: 48px; box-sizing: border-box; border: 1px solid #D5D9E0; border-radius: 10px; padding: 0 12px; font: 600 16px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; background: #FFFFFF; width: 100%\"></label>\n    <sc-if value=\"{{simCode}}\"><div style=\"font-size: 13px; line-height: 19px; color: #8A4B00; background: #FFF1D6; border-radius: 10px; padding: 10px 12px\"><b>Mode uji:</b> WhatsApp belum tersambung, jadi kodenya ditampilkan di sini: <b style=\"letter-spacing: 0.15em\">{{simCode}}</b></div></sc-if>\n    <sc-if value=\"{{isOtp}}\"><label style=\"display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 700; color: #4A5468\"><span style=\"display: flex; justify-content: space-between; gap: 8px\">Kode OTP<button type=\"button\" onClick=\"{{toPhone}}\" style=\"border: none; background: none; padding: 0; color: #077A70; font: 700 13px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">Ganti nomor</button></span><input type=\"text\" inputmode=\"numeric\" autocomplete=\"one-time-code\" maxlength=\"6\" value=\"{{code}}\" onChange=\"{{setCode}}\" style=\"height: 48px; box-sizing: border-box; border: 1px solid #D5D9E0; border-radius: 10px; padding: 0 12px; font: 600 16px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; background: #FFFFFF; width: 100%; letter-spacing: 0.4em; text-align: center; font-size: 22px; height: 56px\"></label></sc-if>\n    <label style=\"display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 700; color: #4A5468\"><span style=\"display: flex; justify-content: space-between; align-items: center; gap: 8px\">Kode authenticator (2FA)<span style=\"font-size: 12px; font-weight: 800; color: #8A4B00; background: #FFF1D6; border-radius: 6px; padding: 3px 8px\">Segera</span></span><input type=\"text\" inputmode=\"numeric\" placeholder=\"Segera tersedia\" disabled style=\"height: 48px; box-sizing: border-box; border: 1px solid #D5D9E0; border-radius: 10px; padding: 0 12px; font: 600 16px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; background: #FFFFFF; width: 100%; background: #F6F7F9; color: #8A93A6\"></label>\n    <sc-if value=\"{{error}}\"><div role=\"alert\" style=\"font-size: 13px; font-weight: 600; color: #A12A1F; background: #FDECEA; border-radius: 10px; padding: 10px 12px\">{{error}}</div></sc-if>\n    <button type=\"button\" onClick=\"{{submit}}\" disabled=\"{{busy}}\" style=\"height: 52px; border-radius: 12px; border: none; background: #09BEAF; color: #1F2B4D; font: 800 16px 'Plus Jakarta Sans', sans-serif; display: flex; align-items: center; justify-content: center; text-decoration: none; cursor: pointer; width: 100%\">{{btnLabel}}</button>\n    <sc-if value=\"{{isOtp}}\"><div style=\"display: flex; justify-content: space-between; font-size: 13px; color: #4A5468\">\n      <sc-if value=\"{{canResend}}\" not><span>Kirim ulang dalam {{resend}}</span></sc-if>\n      <sc-if value=\"{{canResend}}\"><button type=\"button\" onClick=\"{{resendOtp}}\" style=\"border: none; background: none; padding: 0; color: #077A70; font: 700 13px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">Kirim ulang kode</button></sc-if>\n    </div></sc-if>\n    <div style=\"border: 1px solid #E6E8EC; border-radius: 16px; padding: 14px 16px; display: flex; flex-direction: column; gap: 6px\">\n      <div style=\"font-size: 14px; font-weight: 800\">Kenapa dua langkah?</div>\n      <div style=\"font-size: 13px; line-height: 19px; color: #4A5468\">Halaman ini menampilkan hasil keuangan dan bisa menarik dana. Akun investor wajib kode OTP (dikirim ke email) untuk nomor yang terdaftar di perjanjian. Kode authenticator (2FA) segera ditambahkan, sama seperti owner dan keuangan.</div>\n    </div>\n    <div style=\"font-size: 12px; line-height: 18px; color: #4A5468\">Akun investor dibuat oleh tim Rentalaja setelah perjanjian ditandatangani dan KYC selesai (KTP, NPWP, rekening atas nama sendiri).</div>\n  </section>\n\n</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{\"$preview\":{\"width\":390,\"height\":844}}'>\nclass Component extends DCLogic {\nstate = { step: 'phone', left: 45, phone: '', code: '', error: '', sim: '', norm: null };\ncomponentDidMount() {\n  this.timer = setInterval(() => { if (this.state.step === 'otp' && this.state.left > 0) this.setState({ left: this.state.left - 1 }); }, 1000);\n  if (RA.isLoggedIn()) this.myPartner().then(p => { if (p && RA_ALIVE(this)) RA.afterLogin('Investor'); }).catch(() => {});\n}\ncomponentWillUnmount() { clearInterval(this.timer); }\nasync myPartner() {\n  const me = RA.me(); if (!me) return null;\n  const r = await RA.from('partners').select('id,name,is_active').eq('user_id', me.id).limit(1);\n  const data = (r.data || [])[0];\n  if (data && data.is_active) { RA._partner = data; return data; }\n  return null;\n}\nasync send() {\n  const n = RA.normPhone(this.state.phone);\n  if (!n) { this.setState({ error: 'Nomor HP tidak valid. Contoh: 0812 3456 7890' }); return; }\n  this.setState({ error: '' });\n  const r = await RA.requestOtp(n, 'investor_login');\n  this.setState({ step: 'otp', left: 45, norm: n, sim: r.simulation ? (r.code || '') : '', code: '', error: (r.simulation && !r.code) ? 'WhatsApp Rentalaja belum tersambung, jadi kode tidak terkirim. Minta kode masuk ke admin Rentalaja.' : '' });\n}\nasync check() {\n  const code = String(this.state.code).replace(/\\D/g, '');\n  if (code.length !== 6) { this.setState({ error: 'Kode terdiri dari 6 angka.' }); return; }\n  this.setState({ error: '' });\n  await RA.verifyOtp(this.state.norm, code, 'investor_login');\n  const p = await this.myPartner();\n  if (!p) { RA.signOut(); this.setState({ step: 'phone', sim: '', code: '', error: 'Nomor ini belum terdaftar sebagai mitra aktif. Hubungi tim Rentalaja untuk perjanjian dan KYC.' }); return; }\n  RA.toast('Masuk sebagai ' + p.name);\n  RA.afterLogin('Investor');\n}\nrenderVals() {\n  const s = this.state;\n  const wrap = fn => this.act(async () => { try { await fn.call(this); } catch (e) { this.setState({ error: RA.friendly(e.message) }); } });\n  const isOtp = s.step === 'otp';\n  return {\n    isOtp, phone: s.phone, code: s.code, error: s.error, busy: !!s.busy, simCode: s.sim,\n    btnLabel: s.busy ? (isOtp ? 'Memeriksa…' : 'Mengirim…') : (isOtp ? 'Masuk' : 'Kirim kode ke email'),\n    resend: '0:' + String(s.left).padStart(2, '0'), canResend: s.left === 0,\n    setPhone: e => this.setState({ phone: e.target.value }), setCode: e => this.setState({ code: e.target.value }),\n    submit: wrap(isOtp ? this.check : this.send), resendOtp: wrap(this.send),\n    toPhone: () => this.setState({ step: 'phone', error: '', sim: '', code: '' })\n  };\n}\n}\n</script>\n</body>\n</html>\n"}