{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Laporan shift CS</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0}\na{color:#1F2B4D}a:hover{color:#000}\nbutton:disabled{opacity:.55;cursor:not-allowed}\n</style>\n</helmet>\n<div style=\"width: 390px; height: 1400px; box-sizing: border-box; background: #F4F6F9; color: #1F2B4D; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; flex-direction: column; position: relative; overflow: hidden\">\n\n  <header style=\"display: flex; align-items: center; justify-content: space-between; padding: 14px 16px; border-bottom: 1px solid #E6E8EC; background: #FFFFFF\">\n    <img src=\"logo.png\" alt=\"Rentalaja\" style=\"height: 28px; width: auto; display: block\">\n    <div style=\"text-align: right\"><div style=\"font-size: 14px; font-weight: 800\">Laporan shift</div><div style=\"font-size: 12px; color: #4A5468\">{{who}}</div></div>\n  </header>\n\n  <section style=\"padding: 14px 16px 0; display: flex; flex-direction: column; gap: 12px\">\n    <div style=\"display: flex; gap: 6px\"><sc-for list=\"{{modes}}\" as=\"m\"><button type=\"button\" onClick=\"{{m.pick}}\" style=\"{{m.style}}\">{{m.label}}</button></sc-for></div>\n    <sc-if value=\"{{modeSkor}}\">\n      <div style=\"background: linear-gradient(160deg, #09BEAF 0%, #077A70 100%); color: #FFFFFF; border-radius: 20px; padding: 16px; display: flex; flex-direction: column; gap: 4px\">\n        <div style=\"font-size: 13px; opacity: 0.9\">Skor {{skMonth}}</div>\n        <div style=\"font-size: 30px; font-weight: 800; line-height: 36px\">{{skScore}}</div>\n        <div style=\"font-size: 12px; opacity: 0.9\">{{skNote}}</div>\n      </div>\n      <sc-for list=\"{{skItems}}\" as=\"k\"><div style=\"background: #FFFFFF; border-radius: 16px; padding: 14px; display: flex; flex-direction: column; gap: 6px\">\n        <div style=\"display: flex; justify-content: space-between; gap: 8px\"><b style=\"font-size: 14px\">{{k.label}}</b><b style=\"font-size: 14px; color: {{k.color}}\">{{k.val}}</b></div>\n        <div style=\"height: 8px; border-radius: 4px; background: #EEF0F3; overflow: hidden\"><div style=\"height: 100%; width: {{k.pct}}; background: {{k.color}}; border-radius: 4px\"></div></div>\n        <div style=\"font-size: 12px; color: #4A5468\">{{k.sub}}</div>\n      </div></sc-for>\n      <sc-if value=\"{{hasRank}}\"><div style=\"background: #FFFFFF; border-radius: 16px; padding: 14px; display: flex; flex-direction: column; gap: 2px\">\n        <b style=\"font-size: 14px; margin-bottom: 4px\">Peringkat CS bulan ini · pelanggan sewa lagi</b>\n        <sc-for list=\"{{rank}}\" as=\"r\"><div style=\"display: flex; justify-content: space-between; padding: 7px 0; border-top: 1px solid #EEF0F3; font-size: 13px\"><span>{{r.label}}</span><b>{{r.val}}</b></div></sc-for>\n      </div></sc-if>\n    </sc-if>\n    <sc-if value=\"{{modeSkor}}\" not>\n    <div role=\"tablist\" style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 4px; background: #E6E9EE; border-radius: 12px; padding: 4px\"><sc-for list=\"{{shifts}}\" as=\"t\"><button type=\"button\" role=\"tab\" aria-selected=\"{{t.on}}\" onClick=\"{{t.pick}}\" style=\"{{t.style}}\"><span style=\"display: block\">{{t.label}}</span><span style=\"display: block; font-size: 11px; font-weight: 600; opacity: 0.8\">{{t.time}}</span></button></sc-for></div>\n    <div style=\"font-size: 12px; color: #4A5468; text-align: center\">{{periodText}}</div>\n\n    <div style=\"background: #FFFFFF; border-radius: 20px; box-shadow: 0 2px 10px rgba(31,43,77,0.05); padding: 16px; display: flex; flex-direction: column; gap: 2px\">\n      <div style=\"font-size: 15px; font-weight: 800; margin-bottom: 6px\">Yang dikerjakan shift ini</div>\n      <sc-if value=\"{{loading}}\"><div style=\"font-size: 13px; color: #4A5468\">Menghitung…</div></sc-if>\n      <sc-for list=\"{{done}}\" as=\"r\"><div style=\"display: flex; justify-content: space-between; gap: 10px; padding: 8px 0; border-top: 1px solid #EEF0F3; font-size: 13px; line-height: 18px\"><span style=\"color: #4A5468\">{{r.label}}</span><b style=\"text-align: right\">{{r.val}}</b></div></sc-for>\n    </div>\n\n\n    <sc-if value=\"{{hasDet}}\"><div style=\"background: #FFFFFF; border-radius: 20px; box-shadow: 0 2px 10px rgba(31,43,77,0.05); padding: 16px; display: flex; flex-direction: column; gap: 4px\">\n      <div style=\"font-size: 15px; font-weight: 800; margin-bottom: 4px\">Rincian per barang & layanan</div>\n      <sc-for list=\"{{det}}\" as=\"g\"><div style=\"display: flex; flex-direction: column; padding-top: 8px\">\n        <div style=\"display: flex; justify-content: space-between; gap: 8px; font-size: 12px; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase; color: #077A70; padding-bottom: 4px\"><span>{{g.title}}</span><span>{{g.total}}</span></div>\n        <sc-if value=\"{{g.none}}\"><div style=\"font-size: 13px; color: #6B7486; padding: 4px 0\">{{g.none}}</div></sc-if>\n        <sc-for list=\"{{g.rows}}\" as=\"r\"><div style=\"display: flex; justify-content: space-between; gap: 10px; padding: 7px 0; border-top: 1px solid #EEF0F3; font-size: 13px; line-height: 18px\"><span>{{r.label}}</span><b style=\"text-align: right\">{{r.val}}</b></div></sc-for>\n      </div></sc-for>\n    </div></sc-if>\n    <div style=\"{{pendBox}}\">\n      <div style=\"font-size: 15px; font-weight: 800; margin-bottom: 6px\">{{pendTitle}}</div>\n      <sc-for list=\"{{pend}}\" as=\"r\"><div style=\"display: flex; justify-content: space-between; gap: 10px; padding: 7px 0; border-top: 1px solid rgba(31,43,77,0.08); font-size: 13px; line-height: 18px\"><span>{{r.label}}</span><b>{{r.val}}</b></div></sc-for>\n    </div>\n\n    <div style=\"background: #FFFFFF; border-radius: 20px; box-shadow: 0 2px 10px rgba(31,43,77,0.05); padding: 16px; display: flex; flex-direction: column; gap: 10px\">\n      <label style=\"display: flex; flex-direction: column; gap: 6px; font-size: 14px; font-weight: 800\">Catatan & kendala\n        <textarea rows=\"4\" placeholder=\"Contoh: pelanggan RA-2611-0012 minta perpanjang 1 hari, sudah diinfo harga. Chat dari Bu Rina soal jam check-in belum dijawab pemilik villa.\" value=\"{{note}}\" onInput=\"{{setNote}}\" style=\"width: 100%; box-sizing: border-box; border: 1px solid #B4BCC8; border-radius: 12px; padding: 10px 12px; font: 500 14px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; resize: vertical\"></textarea>\n      </label>\n      <label style=\"display: flex; flex-direction: column; gap: 6px; font-size: 14px; font-weight: 800\">Diteruskan ke CS shift berikutnya\n        <select value=\"{{handTo}}\" onChange=\"{{setHandTo}}\" style=\"height: 46px; border-radius: 12px; border: 1px solid #B4BCC8; padding: 0 10px; font: 700 14px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; background: #FFFFFF\"><sc-for list=\"{{mates}}\" as=\"m\"><option value=\"{{m.id}}\">{{m.label}}</option></sc-for></select>\n      </label>\n    </div>\n\n    <details style=\"background: #FFFFFF; border-radius: 16px; padding: 12px 16px\">\n      <summary style=\"cursor: pointer; font-size: 14px; font-weight: 800\">Lihat teks laporan WhatsApp</summary>\n      <div style=\"white-space: pre-wrap; font-size: 13px; line-height: 19px; color: #1F2B4D; background: #E7F8F0; border-radius: 12px; padding: 12px; margin-top: 10px\">{{text}}</div>\n    </details>\n\n    <button type=\"button\" onClick=\"{{send}}\" disabled=\"{{busy}}\" style=\"height: 54px; border-radius: 14px; border: none; background: #09BEAF; color: #1F2B4D; font: 800 16px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">Simpan & kirim ke WhatsApp manajemen</button>\n    <button type=\"button\" onClick=\"{{copy}}\" style=\"height: 44px; border-radius: 12px; border: 1px solid #D5D9E0; background: #FFFFFF; color: #1F2B4D; font: 700 14px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">Salin teks laporan</button>\n    <div style=\"font-size: 12px; line-height: 17px; color: #4A5468; text-align: center\">{{sendHint}}</div>\n\n    <sc-if value=\"{{hasHist}}\"><div style=\"background: #FFFFFF; border-radius: 20px; padding: 16px; display: flex; flex-direction: column; gap: 2px\">\n      <div style=\"font-size: 15px; font-weight: 800; margin-bottom: 6px\">Laporan terakhir</div>\n      <sc-for list=\"{{hist}}\" as=\"h\"><div style=\"padding: 8px 0; border-top: 1px solid #EEF0F3; font-size: 13px; line-height: 18px\"><b>{{h.title}}</b><div style=\"color: #4A5468\">{{h.sub}}</div></div></sc-for>\n    </div></sc-if>\n    </sc-if>\n  </section>\n\n</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{\"$preview\":{\"width\":390,\"height\":1400}}'>\nclass Component extends DCLogic {\nstate = { mode: 'lap', shift: null, d: null, sk: null, note: '', handTo: '', mates: [], hist: [] };\nhm(k, def) { const v = String(RA.setting(k) || def); const m = v.match(/(\\d{1,2})[:.](\\d{2})/); return m ? [+m[1], +m[2]] : def.split(':').map(Number); }\nrange(sh) { const a = new Date(); const [h1, m1] = this.hm('cs_shift_start', '07:30'), [h2, m2] = this.hm('cs_shift_split', '15:15'), [h3, m3] = this.hm('cs_shift_end', '23:00');\n  const at = (h, m) => { const x = new Date(a); x.setHours(h, m, 0, 0); return x; };\n  return sh === 2 ? [at(h2, m2), at(h3, m3)] : [at(h1, m1), at(h2, m2)]; }\nasync componentDidMount() {\n  await RA.staff();\n  const [h2, m2] = this.hm('cs_shift_split', '15:15'); const n = new Date();\n  let note = ''; try { note = RA.ls.get('ra.cs.note') || ''; } catch (e) {}\n  this.setState({ shift: (n.getHours() * 60 + n.getMinutes()) >= h2 * 60 + m2 ? 2 : 1, note });\n  const me = (RA.me() || {}).id;\n  const [ms, hs] = await Promise.all([\n    RA.from('staff').select('user_id,name,role').in('role', ['cs', 'cs_experience', 'branch_head', 'owner']).eq('is_active', true),\n    RA.from('cs_reports').select('id,shift_label,period_start,created_at,note').eq('staff_id', me).order('created_at', { ascending: false }).limit(5)\n  ]);\n  if (!RA_ALIVE(this)) return;\n  this.setState({ mates: (ms.data || []).filter(x => x.user_id !== me), hist: hs.data || [] });\n  await this.reload();\n  if (this.params && this.params.tab === 'skor') { this.setState({ mode: 'skor' }); this.loadSkor(); }\n}\nasync loadSkor() {\n  const me = (RA.me() || {}).id; const a = new Date(); a.setDate(1); a.setHours(0, 0, 0, 0); const A = a.toISOString();\n  const [fu, fw, wa, tk, vb] = await Promise.all([\n    RA.from('followups').select('id,status,assigned_to,contacted_at,result_at').gte('created_at', new Date(a.getTime() - 7 * 864e5).toISOString()),\n    RA.from('followups').select('assigned_to').eq('status', 'won').gte('result_at', A),\n    RA.can('mgmt.inbox') ? RA.from('wa_conversations').select('first_response_seconds,assigned_to').gte('created_at', A).not('first_response_seconds', 'is', null) : { data: [] },\n    RA.from('tickets').select('status,satisfaction,resolved_at').gte('created_at', A),\n    RA.from('bookings').select('verification_seconds,verified_by').eq('verified_by', me).gte('verified_at', A)\n  ]);\n  if (!RA_ALIVE(this)) return;\n  this.setState({ sk: { me, fu: (fu.data || []).filter(x => x.assigned_to === me), won: fw.data || [], wa: (wa.data || []).filter(x => x.assigned_to === me), tk: tk.data || [], vb: vb.data || [] } });\n}\nasync reload() {\n  const [A, B] = this.range(this.state.shift); const a = A.toISOString(), b = B.toISOString();\n  this.setState({ d: null });\n  const IT = 'booking_items(quantity,line_total,is_addon,products(name,categories(name,kind)))';\n  const K = 'id,status,total,paid_amount,channel,ota_ref,created_at,created_by,' + IT;\n  const [nb, vb, py, ob, rb, tn, tr, wa, pv, pp, ow, wq, tk, jp, na, sr] = await Promise.all([\n    RA.from('bookings').select(K).gte('created_at', a).lt('created_at', b).neq('status', 'draft'),\n    RA.from('bookings').select('id,status,verification_seconds').gte('verified_at', a).lt('verified_at', b),\n    RA.from('payments').select('amount,method,bookings(channel,created_by,' + IT + ')').eq('status', 'paid').gte('paid_at', a).lt('paid_at', b),\n    RA.from('bookings').select('id,' + IT).gte('actual_start_at', a).lt('actual_start_at', b),\n    RA.from('bookings').select('id,end_at,actual_end_at,' + IT).gte('actual_end_at', a).lt('actual_end_at', b),\n    RA.from('tickets').select('id').gte('created_at', a).lt('created_at', b),\n    RA.from('tickets').select('id').gte('resolved_at', a).lt('resolved_at', b),\n    RA.can('mgmt.inbox') ? RA.from('wa_conversations').select('id,first_response_seconds,created_at').gte('last_out_at', a).lt('last_out_at', b) : { data: [] },\n    RA.from('bookings').select('id', { count: 'exact', head: true }).eq('status', 'pending_verification'),\n    RA.from('bookings').select('id', { count: 'exact', head: true }).eq('status', 'awaiting_payment'),\n    RA.from('bookings').select('total,paid_amount,late_fee,damage_fee').eq('status', 'returned'),\n    RA.can('mgmt.inbox') ? RA.from('wa_conversations').select('last_in_at,last_out_at').eq('status', 'open') : { data: [] },\n    RA.from('tickets').select('id', { count: 'exact', head: true }).in('status', ['open', 'in_progress']),\n    RA.rpc('driver_trips', { p_from: new Date().toISOString(), p_to: new Date(Date.now() + 2 * 864e5).toISOString() }),\n    RA.from('bookings').select('id', { count: 'exact', head: true }).eq('delivery_mode', 'delivery').is('delivery_address', null).in('status', ['confirmed', 'awaiting_payment', 'pending_verification']),\n    RA.from('staff').select('user_id,role')\n  ]);\n  if (!RA_ALIVE(this)) return;\n  const kind = x => { const ks = (x.booking_items || []).map(i => i.products && i.products.categories && i.products.categories.kind); return ks.indexOf('stay') > -1 ? 'inap' : ks.indexOf('trip') > -1 ? 'jeep' : 'rental'; };\n  const by = (arr) => { const o = { rental: 0, inap: 0, jeep: 0 }; (arr || []).forEach(x => o[kind(x)]++); return o; };\n  const bal = x => Math.max(0, +x.total + +(x.late_fee || 0) + +(x.damage_fee || 0) - +(x.paid_amount || 0));\n  const owe = (ow.data || []).filter(x => bal(x) > 0);\n  const roles = {}; (sr.data || []).forEach(x => { roles[x.user_id] = x.role; });\n  this.setState({ d: {\n    roles, nb: (nb.data || []), nbBy: by(nb.data), ver: vb.data || [], pay: py.data || [], outBy: by(ob.data), backBy: by(rb.data), outL: ob.data || [], backL: rb.data || [],\n    late: (rb.data || []).filter(x => x.actual_end_at && new Date(x.actual_end_at) > new Date(new Date(x.end_at).getTime() + 15 * 6e4)).length,\n    tNew: (tn.data || []).length, tDone: (tr.data || []).length, chats: wa.data || [],\n    pVer: pv.count || 0, pPay: pp.count || 0, owe: owe.length, oweSum: owe.reduce((s, x) => s + bal(x), 0),\n    unans: (wq.data || []).filter(c => c.last_in_at && (!c.last_out_at || new Date(c.last_in_at) > new Date(c.last_out_at))).length, tOpen: tk.count || 0,\n    noDrv: (jp.data || []).filter(x => x.driver_status !== 'accepted' && ['cancelled', 'expired'].indexOf(x.status) < 0).length, noAddr: na.count || 0 } });\n}\n/* Closing CS = booking online (web/WA/telepon/OTA/korporat) atau walk-in yang dibuat akun CS.\n   Datang langsung (OTS) = walk-in yang dibuat kasir/staf cabang di toko. */\nsrc(b) { const r = ((this.state.d || {}).roles || {})[b && b.created_by]; return b && b.channel === 'walkin' && r !== 'cs' && r !== 'cs_experience' ? 'ots' : 'cs'; }\nkeyOf(i) { const p = i.products || {}, c = p.categories || {}; const k = c.kind;\n  if (k === 'stay') return String(p.name || 'Penginapan').replace(/ · .*$/, '');\n  if (k === 'trip') return String(p.name || 'Trip jeep').replace(/^DEMO /, '');\n  if (k === 'car_driver') return 'Mobil + sopir';\n  return c.name || 'Lainnya'; }\ngroup(list, withVal) {\n  const g = {};\n  (list || []).forEach(b => { const its = (b.booking_items || []).filter(i => !i.is_addon && i.products); const seen = {};\n    its.forEach(i => { const k = this.keyOf(i); const o = g[k] || (g[k] = { b: 0, u: 0, v: 0 }); if (!seen[k]) { o.b++; seen[k] = 1; } o.u += +(i.quantity || 1); o.v += +(i.line_total || 0); }); });\n  return Object.keys(g).sort((p, q) => g[q].b - g[p].b || g[q].v - g[p].v).map(k => ({ label: k, val: g[k].b + ' booking' + (g[k].u !== g[k].b ? ' · ' + g[k].u + ' unit' : '') + (withVal && g[k].v ? ' · ' + RA.rp(g[k].v) : ''), n: g[k].b }));\n}\ndetails() {\n  const d = this.state.d; if (!d) return [];\n  const ok = d.nb.filter(b => ['cancelled', 'expired', 'rejected'].indexOf(b.status) < 0);\n  const st = { lunas: 0, dp: 0, belum: 0, verif: 0, batal: 0 };\n  d.nb.forEach(b => { if (['cancelled', 'expired', 'rejected'].indexOf(b.status) > -1) st.batal++; else if (b.status === 'pending_verification') st.verif++; else if (+b.paid_amount >= +b.total && +b.total > 0) st.lunas++; else if (+b.paid_amount > 0) st.dp++; else st.belum++; });\n  const CH = { web: 'Website', wa: 'WhatsApp', walkin: 'Datang langsung', ota: 'OTA', corporate: 'Korporat', phone: 'Telepon' }; const ch = {};\n  d.nb.forEach(b => { const k = b.channel === 'ota' && b.ota_ref ? 'OTA ' + b.ota_ref : (CH[b.channel] || b.channel || 'Website'); ch[k] = (ch[k] || 0) + 1; });\n  const pk = {}; d.pay.forEach(p => { const it = ((p.bookings || {}).booking_items || []).find(i => !i.is_addon && i.products); const k = it ? this.keyOf(it) : 'Lainnya'; pk[k] = (pk[k] || 0) + +p.amount; });\n  const okC = ok.filter(b => this.src(b) === 'cs'), okO = ok.filter(b => this.src(b) === 'ots');\n  const vs = a => a.reduce((t, b) => t + +b.total, 0);\n  const pS = k => d.pay.filter(p => this.src(p.bookings || {}) === k), pv = a => a.reduce((t, p) => t + +p.amount, 0);\n  const pg = a => { const o = {}; a.forEach(p => { const it = ((p.bookings || {}).booking_items || []).find(i => !i.is_addon && i.products); const k = it ? this.keyOf(it) : 'Lainnya'; o[k] = (o[k] || 0) + +p.amount; }); return Object.keys(o).sort((x, y) => o[y] - o[x]).map(k => ({ label: k, val: RA.rp(o[k]) })); };\n  const pC = pS('cs'), pO = pS('ots');\n  return [\n    { title: 'Closing CS (online + dibuat CS)', total: okC.length + ' · ' + RA.rp(vs(okC)), rows: this.group(okC, true), none: okC.length ? '' : 'Belum ada' },\n    { title: 'Datang langsung ke toko (OTS kasir)', total: okO.length + ' · ' + RA.rp(vs(okO)), rows: this.group(okO, true), none: okO.length ? '' : 'Belum ada' },\n    { title: 'Status bayar booking masuk', total: '', rows: [['Lunas', st.lunas], ['Sudah DP', st.dp], ['Belum bayar', st.belum], ['Menunggu verifikasi', st.verif], ['Batal / kedaluwarsa / ditolak', st.batal]].filter(x => x[1]).map(x => ({ label: x[0], val: x[1] + ' booking' })), none: d.nb.length ? '' : '—' },\n    { title: 'Sumber booking', total: '', rows: Object.keys(ch).sort((p, q) => ch[q] - ch[p]).map(k => ({ label: k, val: ch[k] + ' booking' })), none: d.nb.length ? '' : '—' },\n    { title: 'Uang masuk dari booking closing CS', total: RA.rp(pv(pC)), rows: pg(pC), none: pC.length ? '' : 'Belum ada pembayaran' },\n    { title: 'Uang masuk dari booking datang langsung (OTS)', total: RA.rp(pv(pO)), rows: pg(pO), none: pO.length ? '' : 'Belum ada pembayaran' },\n    { title: 'Unit keluar / tamu check-in / trip berangkat', total: String(d.outL.length), rows: this.group(d.outL, false), none: d.outL.length ? '' : 'Tidak ada' },\n    { title: 'Unit kembali / check-out', total: String(d.backL.length), rows: this.group(d.backL, false), none: d.backL.length ? '' : 'Tidak ada' }\n  ];\n}\ntext() {\n  const s = this.state, d = s.d; if (!d) return '';\n  const [A, B] = this.range(s.shift); const st = RA._staff || {};\n  const L = this.lines(); const P = this.pendLines();\n  const mate = (s.mates || []).find(m => m.user_id === s.handTo);\n  return '*Laporan Shift ' + s.shift + ' CS* · Rentalaja\\n' + RA.HARIL[A.getDay()] + ', ' + RA.date(A) + ' ' + A.getFullYear() + ' (' + RA.time(A) + '–' + RA.time(B) + ')\\nCS: ' + (st.name || '—') + '\\n\\n'\n    + L.map(r => '• ' + r.label + ': ' + r.val).join('\\n')\n    + this.details().filter(g => g.rows.length).map(g => '\\n\\n*' + g.title + (g.total ? ' (' + g.total + ')' : '') + '*\\n' + g.rows.map(r => '• ' + r.label + ': ' + r.val).join('\\n')).join('')\n    + '\\n\\n*Tertunda untuk shift berikutnya*\\n' + (P.length ? P.map(r => '• ' + r.label + ': ' + r.val).join('\\n') : '• Tidak ada, semua beres')\n    + (String(s.note || '').trim() ? '\\n\\n*Catatan & kendala*\\n' + String(s.note).trim() : '')\n    + (mate ? '\\n\\nDiteruskan ke: ' + mate.name : '');\n}\nlines() {\n  const d = this.state.d; if (!d) return [];\n  const sum = a => a.reduce((t, x) => t + (+x.amount || +x.total || 0), 0);\n  const ML = { qris: 'QRIS', va: 'VA', ewallet: 'e-wallet', cash: 'tunai', transfer: 'transfer', edc: 'EDC', link: 'link', xendit: 'link' };\n  const pm = {}; d.pay.forEach(p => { const k = ML[p.method] || p.method; pm[k] = (pm[k] || 0) + +p.amount; });\n  const ok = d.ver.filter(x => ['awaiting_payment', 'confirmed', 'active', 'returned', 'completed'].indexOf(x.status) > -1).length, rej = d.ver.filter(x => x.status === 'rejected').length;\n  const vs = d.ver.filter(x => x.verification_seconds != null); const vAvg = vs.length ? Math.round(vs.reduce((t, x) => t + +x.verification_seconds, 0) / vs.length / 60) : null;\n  const fr = d.chats.filter(c => c.first_response_seconds != null); const fAvg = fr.length ? Math.round(fr.reduce((t, x) => t + +x.first_response_seconds, 0) / fr.length / 60) : null;\n  const by = o => [o.rental ? 'rental ' + o.rental : '', o.inap ? 'penginapan ' + o.inap : '', o.jeep ? 'jeep ' + o.jeep : ''].filter(Boolean).join(', ');\n  return [\n    { label: 'Booking masuk', val: d.nb.length + (d.nb.length ? ' (' + by(d.nbBy) + ') · ' + RA.rp(sum(d.nb)) : '') },\n    { label: '↳ Closing CS', val: (a => a.length + ' · ' + RA.rp(sum(a)))(d.nb.filter(b => this.src(b) === 'cs' && ['cancelled', 'expired', 'rejected'].indexOf(b.status) < 0)) },\n    { label: '↳ Datang langsung (OTS kasir)', val: (a => a.length + ' · ' + RA.rp(sum(a)))(d.nb.filter(b => this.src(b) === 'ots' && ['cancelled', 'expired', 'rejected'].indexOf(b.status) < 0)) },\n    { label: 'Verifikasi', val: (ok + rej) ? ok + ' disetujui, ' + rej + ' ditolak' + (vAvg != null ? ' · rata-rata ' + vAvg + ' mnt' : '') : '0' },\n    { label: 'Pembayaran masuk (semua cabang)', val: RA.rp(sum(d.pay)) + (d.pay.length ? ' (' + Object.keys(pm).map(k => k + ' ' + RA.rp(pm[k])).join(', ') + ')' : '') },\n    { label: 'Unit/tamu keluar', val: String(d.outBy.rental + d.outBy.inap + d.outBy.jeep) + (by(d.outBy) ? ' (' + by(d.outBy) + ')' : '') },\n    { label: 'Kembali / check-out', val: String(d.backBy.rental + d.backBy.inap + d.backBy.jeep) + (d.late ? ' · ' + d.late + ' telat' : '') },\n    { label: 'Chat ditangani', val: d.chats.length + (fAvg != null ? ' · respon rata-rata ' + fAvg + ' mnt' : '') },\n    { label: 'Keluhan', val: d.tNew + ' baru, ' + d.tDone + ' selesai' }\n  ];\n}\npendLines() {\n  const d = this.state.d; if (!d) return [];\n  return [[d.pVer, 'Menunggu verifikasi', d.pVer], [d.pPay, 'Menunggu pembayaran', d.pPay], [d.owe, 'Tagihan belum lunas', d.owe + ' (' + RA.rp(d.oweSum) + ')'], [d.unans, 'Chat belum dibalas', d.unans],\n    [d.tOpen, 'Keluhan terbuka', d.tOpen], [d.noDrv, 'Trip jeep belum ada sopir (2 hari)', d.noDrv], [d.noAddr, 'Alamat antar belum diisi', d.noAddr]].filter(x => x[0]).map(x => ({ label: x[1], val: String(x[2]) }));\n}\nasync send() {\n  const s = this.state; if (!s.d) throw new Error('Tunggu ringkasan selesai dihitung.');\n  const [A, B] = this.range(s.shift); const t = this.text();\n  const { error } = await RA.from('cs_reports').insert({ shift_label: 'Shift ' + s.shift, period_start: A.toISOString(), period_end: B.toISOString(), data: { lines: this.lines(), pending: this.pendLines() }, note: String(s.note || '').trim() || null, handover_to: s.handTo || null });\n  if (error) throw new Error(error.message);\n  try { RA.ls.del('ra.cs.note'); } catch (e) {}\n  const to = String(RA.setting('cs_report_wa') || '').replace(/\\D/g, '');\n  window.open('https://wa.me/' + to + '?text=' + encodeURIComponent(t), '_blank');\n  RA.ok('Laporan tersimpan');\n  const me = (RA.me() || {}).id;\n  const hs = await RA.from('cs_reports').select('id,shift_label,period_start,created_at,note').eq('staff_id', me).order('created_at', { ascending: false }).limit(5);\n  this.setState({ note: '', hist: hs.data || [] });\n}\nrenderVals() {\nconst s = this.state, st = RA._staff || {};\nconst mpill = on => 'flex: 1; height: 42px; border-radius: 21px; border: 0; background: ' + (on ? '#1F2B4D' : '#FFFFFF') + '; color: ' + (on ? '#FFFFFF' : '#1F2B4D') + '; font: 800 14px \\'Plus Jakarta Sans\\', sans-serif; cursor: pointer';\nconst sk = s.sk; let skItems = [], skScore = '—', skNote = 'Menghitung…', rank = [];\nif (sk) {\n  const num = k => { const v = RA.setting(k); return v == null || v === '' ? null : +v; };\n  const tWon = num('cs_target_followup_won'), tResp = num('cs_target_response_min') || 5, tSat = num('cs_target_satisfaction') || 90;\n  const myWon = sk.won.filter(x => x.assigned_to === sk.me).length, done = sk.fu.filter(x => x.status !== 'open').length, tot = sk.fu.length;\n  const resp = sk.wa.length ? sk.wa.reduce((t, x) => t + +x.first_response_seconds, 0) / sk.wa.length / 60 : null;\n  const fb = sk.tk.filter(x => x.satisfaction != null), sat = fb.length ? Math.round(fb.filter(x => x.satisfaction >= 4).length / fb.length * 100) : null;\n  const ver = sk.vb.filter(x => x.verification_seconds != null), vAvg = ver.length ? ver.reduce((t, x) => t + +x.verification_seconds, 0) / ver.length / 60 : null;\n  const P = x => Math.max(0, Math.min(100, Math.round(x))) + '%';\n  const sc = []; \n  const wonPct = tWon ? myWon / tWon * 100 : (myWon ? 100 : 0); sc.push(Math.min(100, wonPct));\n  const fuPct = tot ? done / tot * 100 : 100; sc.push(fuPct);\n  const rPct = resp == null ? 100 : resp <= tResp ? 100 : Math.max(0, 100 - (resp - tResp) / tResp * 100); sc.push(rPct);\n  const sPct = sat == null ? 100 : Math.min(100, sat / tSat * 100); sc.push(sPct);\n  skScore = Math.round(sc[0] * 0.4 + sc[1] * 0.2 + sc[2] * 0.2 + sc[3] * 0.2) + ' / 100';\n  skNote = 'Bobot: sewa lagi 40%, follow-up dikerjakan 20%, kecepatan respon 20%, kepuasan keluhan 20%.';\n  skItems = [\n    { label: 'Pelanggan sewa lagi dari follow-up', val: myWon + (tWon ? ' / ' + tWon : ''), pct: P(wonPct), color: '#09BEAF', sub: tWon ? 'Target ' + tWon + ' orang per bulan' : 'Target belum diatur manajemen' },\n    { label: 'Follow-up dikerjakan', val: done + ' / ' + tot, pct: P(fuPct), color: '#1F2B4D', sub: tot ? (tot - done) + ' masih menunggu dihubungi' : 'Belum ada follow-up bulan ini' },\n    { label: 'Rata-rata respon chat', val: resp == null ? '—' : (Math.round(resp * 10) / 10).toString().replace('.', ',') + ' mnt', pct: P(rPct), color: resp != null && resp > tResp ? '#D9782C' : '#1E6B45', sub: 'Target ≤ ' + tResp + ' menit · ' + sk.wa.length + ' chat' },\n    { label: 'Keluhan selesai dengan puas', val: sat == null ? '—' : sat + '%', pct: P(sPct), color: sat != null && sat < tSat ? '#D9782C' : '#1E6B45', sub: 'Target ' + tSat + '% · ' + fb.length + ' keluhan dinilai pelanggan' },\n    { label: 'Verifikasi oleh saya', val: ver.length + (vAvg != null ? ' · ' + Math.round(vAvg) + ' mnt' : ''), pct: P(ver.length ? 100 : 0), color: '#6B7486', sub: 'jumlah & rata-rata waktu verifikasi' }];\n  const by = {}; sk.won.forEach(x => { if (x.assigned_to) by[x.assigned_to] = (by[x.assigned_to] || 0) + 1; });\n  const nm = {}; (s.mates || []).forEach(m => nm[m.user_id] = m.name); nm[sk.me] = (st.name || 'Saya') + ' (saya)';\n  rank = Object.keys(by).sort((p, q) => by[q] - by[p]).slice(0, 10).map((k, i) => ({ label: (i + 1) + '. ' + (nm[k] || 'CS'), val: by[k] + ' org' }));\n}\nconst tab = on => 'min-height: 48px; border: none; border-radius: 9px; background: ' + (on ? '#FFFFFF' : 'transparent') + '; color: #1F2B4D; font: ' + (on ? '800' : '700') + ' 14px \\'Plus Jakarta Sans\\', sans-serif; cursor: pointer; box-shadow: ' + (on ? '0 1px 3px rgba(31,43,77,.15)' : 'none');\nconst r1 = this.range(1), r2 = this.range(2);\nconst [A, B] = s.shift ? this.range(s.shift) : r1;\nconst P = this.pendLines();\nconst to = String(RA.setting('cs_report_wa') || '').replace(/\\D/g, '');\nreturn {\n  who: (st.name || 'CS'),\n  modes: [['lap', 'Laporan shift'], ['skor', 'Skor saya']].map(([k, l]) => ({ label: l, style: mpill(s.mode === k), pick: () => { this.setState({ mode: k }); if (k === 'skor' && !this.state.sk) this.loadSkor(); } })),\n  modeSkor: s.mode === 'skor', skItems, skScore, skNote, skMonth: RA.BULAN[new Date().getMonth()] + ' ' + new Date().getFullYear(), rank, hasRank: rank.length > 0,\n  shifts: [[1, r1], [2, r2]].map(([n, r]) => ({ label: 'Shift ' + n, time: RA.time(r[0]) + '–' + RA.time(r[1]), on: s.shift === n ? 'true' : 'false', style: tab(s.shift === n), pick: () => { this.setState({ shift: n }); this.reload(); } })),\n  periodText: RA.HARIL[A.getDay()] + ', ' + RA.date(A) + ' · ' + RA.time(A) + '–' + RA.time(B) + ' · kerja dari rumah, tanpa absen',\n  loading: !s.d, done: this.lines(), det: this.details(), hasDet: !!s.d,\n  pend: P.length ? P : [{ label: 'Tidak ada yang tertunda', val: '✓' }], pendTitle: P.length ? 'Tertunda untuk shift berikutnya' : 'Semua beres',\n  pendBox: 'border-radius: 20px; padding: 16px; display: flex; flex-direction: column; gap: 2px; ' + (P.length ? 'background: #FFF1D6; color: #5C3600' : 'background: #E4F2EA; color: #1E6B45'),\n  note: s.note, setNote: e => { this.setState({ note: e.target.value }); try { RA.ls.set('ra.cs.note', e.target.value); } catch (x) {} },\n  mates: [{ id: '', label: '— pilih (opsional) —' }].concat((s.mates || []).map(m => ({ id: m.user_id, label: m.name }))), handTo: s.handTo, setHandTo: e => this.setState({ handTo: e.target.value }),\n  text: this.text() || 'Menghitung…', busy: !!s.busy, send: this.act(this.send),\n  copy: () => { const t = this.text(); try { navigator.clipboard.writeText(t).then(() => RA.ok('Teks laporan disalin')); } catch (e) { RA.toast('Salin manual dari kotak teks'); } },\n  sendHint: to ? 'Terkirim ke nomor manajemen yang diatur owner. Laporan juga tersimpan di sistem.' : 'WhatsApp terbuka, pilih grup manajemen. Laporan juga tersimpan di sistem.',\n  hasHist: (s.hist || []).length > 0, hist: (s.hist || []).map(h => ({ title: (h.shift_label || 'Shift') + ' · ' + RA.date(h.period_start), sub: 'dikirim ' + RA.dayTime(h.created_at) + (h.note ? ' · ' + String(h.note).slice(0, 60) : '') }))\n};\n}\n}\n</script>\n</body>\n</html>\n"}