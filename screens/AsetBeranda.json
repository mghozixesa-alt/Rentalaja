{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Hari ini · aset</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0}\nbutton{font-family:inherit}\nbutton:disabled{opacity:.55;cursor:not-allowed}\n[data-aui]{min-height:100vh;box-sizing:border-box;background:#F4F6F9;color:#1F2B4D;font-family:'Plus Jakarta Sans',system-ui,sans-serif}\n[data-in]{max-width:1240px;margin:0 auto;box-sizing:border-box;padding:14px 16px 24px;display:flex;flex-direction:column;gap:12px}\n[data-card]{background:#FFFFFF;border-radius:16px;box-shadow:0 1px 3px rgba(31,43,77,.07);padding:14px;display:flex;flex-direction:column;gap:10px}\n[data-h]{font-size:15px;font-weight:800;display:flex;justify-content:space-between;align-items:center;gap:8px}\n[data-mut]{font-size:12px;color:#5B6577}\n[data-k4]{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}\n[data-kpi]{background:#FFFFFF;border-radius:14px;box-shadow:0 1px 3px rgba(31,43,77,.07);padding:12px 14px;display:flex;flex-direction:column;gap:2px;text-decoration:none;color:#1F2B4D;min-width:0;border:0;text-align:left;cursor:pointer;font:inherit}\n[data-kpi] b{font-size:24px;line-height:28px;font-weight:800}\n[data-kpi] span{font-size:12px;font-weight:700}\n[data-kpi] small{font-size:11px;color:#5B6577;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n[data-seg]{display:flex;flex-wrap:wrap;gap:6px}\n[data-seg] button{height:32px;padding:0 12px;border-radius:16px;border:1px solid #D5D9E0;background:#FFFFFF;color:#1F2B4D;font:700 12.5px 'Plus Jakarta Sans',sans-serif;cursor:pointer}\n[data-seg] button[aria-pressed=\"true\"]{background:#1F2B4D;border-color:#1F2B4D;color:#FFFFFF}\n[data-task]{display:grid;grid-template-columns:38px 1fr;gap:10px;padding:12px 0;border-top:1px solid #EEF0F3}\n[data-task]:first-child{border-top:0;padding-top:2px}\n[data-ico]{width:38px;height:38px;border-radius:11px;display:flex;align-items:center;justify-content:center}\n[data-ico] img{width:20px;height:20px;display:block}\n[data-chip]{display:inline-flex;align-items:center;height:20px;padding:0 8px;border-radius:10px;font-size:11px;font-weight:800;white-space:nowrap}\n[data-btn]{height:34px;padding:0 12px;border-radius:10px;border:0;font:800 12.5px 'Plus Jakarta Sans',sans-serif;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;text-decoration:none;white-space:nowrap}\n[data-feed]{display:grid;grid-template-columns:30px 1fr;gap:8px;padding:8px 0;border-top:1px solid #EEF0F3;text-decoration:none;color:#1F2B4D}\n[data-feed]:first-child{border-top:0}\n[data-cols]{display:flex;flex-direction:column;gap:12px}\ninput[type=search]{height:44px;width:100%;box-sizing:border-box;border:1px solid #E1E4EA;border-radius:13px;padding:0 12px 0 40px;font:500 14px 'Plus Jakarta Sans',sans-serif;color:#1F2B4D;background:#FFFFFF}\n@media (min-width:1000px){\n  [data-in]{padding:20px 24px 32px}\n  [data-k4]{grid-template-columns:repeat(4,minmax(0,1fr))}\n  [data-cols]{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(0,1fr);align-items:start}\n}\n@media print{[data-noprint]{display:none !important}}\n</style>\n</helmet>\n<div data-aui=\"1\"><div data-in=\"1\">\n  <div style=\"display: flex; justify-content: space-between; align-items: flex-end; gap: 12px; flex-wrap: wrap\">\n    <div><div data-mut=\"1\">{{hello}}</div><div style=\"font-size: 21px; line-height: 27px; font-weight: 800\">{{headline}}</div></div>\n    <div data-noprint=\"1\" style=\"position: relative; flex: 1 1 260px; max-width: 420px\"><img src=\"{{icSearch}}\" alt=\"\" style=\"position: absolute; left: 12px; top: 12px; width: 20px; height: 20px\"><input type=\"search\" aria-label=\"Cari unit\" placeholder=\"Cari unit (plat, nomor aset, nama) lalu Enter\" value=\"{{q}}\" onInput=\"{{setQ}}\" onKeyDown=\"{{goQ}}\"></div>\n  </div>\n\n  <div data-k4=\"1\"><sc-for list=\"{{kpi}}\" as=\"k\"><button type=\"button\" data-kpi=\"1\" onClick=\"{{k.go}}\"><b style=\"color: {{k.c}}\">{{k.v}}</b><span>{{k.l}}</span><small>{{k.t}}</small></button></sc-for></div>\n\n  <div data-cols=\"1\">\n    <div data-card=\"1\">\n      <div data-h=\"1\">Perlu ditangani<span data-mut=\"1\">{{taskCount}}</span></div>\n      <div data-seg=\"1\" data-noprint=\"1\"><sc-for list=\"{{filters}}\" as=\"f\"><button type=\"button\" aria-pressed=\"{{f.on}}\" onClick=\"{{f.pick}}\">{{f.label}} · {{f.n}}</button></sc-for></div>\n      <sc-if value=\"{{loading}}\"><div data-mut=\"1\" style=\"text-align: center; padding: 16px; font-size: 13px\">Memuat…</div></sc-if>\n      <sc-if value=\"{{allClear}}\"><div style=\"text-align: center; padding: 18px 8px; color: #077A70; font-weight: 800; font-size: 14px\">{{allClear}}</div></sc-if>\n      <div><sc-for list=\"{{tasks}}\" as=\"t\"><div data-task=\"1\">\n        <span data-ico=\"1\" style=\"background: {{t.bg}}\"><img src=\"{{t.ic}}\" alt=\"\"></span>\n        <div style=\"min-width: 0; display: flex; flex-direction: column; gap: 4px\">\n          <div style=\"display: flex; justify-content: space-between; gap: 8px; align-items: center\"><span data-chip=\"1\" style=\"background: {{t.bg}}; color: {{t.c}}\">{{t.kind}}</span><span style=\"font-size: 11.5px; font-weight: 800; color: {{t.ac}}; white-space: nowrap\">{{t.age}}</span></div>\n          <b style=\"font-size: 14.5px; line-height: 19px\">{{t.title}}</b>\n          <sc-if value=\"{{t.sub}}\"><span data-mut=\"1\" style=\"font-size: 12.5px; line-height: 17px\">{{t.sub}}</span></sc-if>\n          <sc-if value=\"{{t.impact}}\"><span style=\"font-size: 12px; font-weight: 800; color: {{t.c}}\">{{t.impact}}</span></sc-if>\n          <div data-noprint=\"1\" style=\"display: flex; gap: 6px; flex-wrap: wrap; margin-top: 2px\"><sc-if value=\"{{t.act}}\"><button type=\"button\" data-btn=\"1\" onClick=\"{{t.act}}\" disabled=\"{{busy}}\" style=\"background: #09BEAF; color: #1F2B4D\">{{t.actLabel}}</button></sc-if><sc-if value=\"{{t.href}}\"><a data-btn=\"1\" href=\"{{t.href}}\" style=\"background: {{t.ctaBg}}; color: {{t.ctaFg}}\">{{t.cta}}</a></sc-if></div>\n        </div>\n      </div></sc-for></div>\n      <sc-if value=\"{{more}}\"><button type=\"button\" data-btn=\"1\" onClick=\"{{showMore}}\" style=\"background: #F4F6F9; color: #1F2B4D; height: 38px\">{{more}}</button></sc-if>\n    </div>\n\n    <div style=\"display: flex; flex-direction: column; gap: 12px\">\n      <div data-card=\"1\">\n        <div data-h=\"1\">Kesiapan per kategori<a href=\"AsetKalender.dc.html\" data-noprint=\"1\" style=\"font-size: 12px; font-weight: 800; color: #077A70; text-decoration: none\">Kalender ›</a></div>\n        <div style=\"display: flex; flex-direction: column; gap: 8px\"><sc-for list=\"{{cats}}\" as=\"c\"><div style=\"display: grid; grid-template-columns: 96px 1fr 42px; gap: 8px; align-items: center; font-size: 12.5px\"><b style=\"white-space: nowrap; overflow: hidden; text-overflow: ellipsis\">{{c.name}}</b><div style=\"height: 8px; border-radius: 4px; background: #EEF0F3; overflow: hidden\"><div style=\"height: 100%; width: {{c.w}}; background: {{c.bar}}\"></div></div><b style=\"text-align: right; color: {{c.color}}\">{{c.pct}}</b></div></sc-for></div>\n        <span data-mut=\"1\">Siap = unit siap disewa atau sedang dipakai. Sisanya tertahan servis, QC, atau tidak aktif.</span>\n      </div>\n      <div data-card=\"1\">\n        <div data-h=\"1\">Kejadian terbaru<span data-mut=\"1\">7 hari</span></div>\n        <sc-if value=\"{{feedEmpty}}\"><span data-mut=\"1\" style=\"font-size: 13px\">{{feedEmpty}}</span></sc-if>\n        <div><sc-for list=\"{{feed}}\" as=\"f\"><a data-feed=\"1\" href=\"{{f.href}}\"><span data-ico=\"1\" style=\"width: 30px; height: 30px; border-radius: 9px; background: {{f.bg}}\"><img src=\"{{f.ic}}\" alt=\"\" style=\"width: 16px; height: 16px\"></span><span style=\"min-width: 0; font-size: 12.5px; line-height: 17px\"><b>{{f.unit}}</b> {{f.t}}<sc-if value=\"{{f.warn}}\"><span style=\"color: #A12A1F\"> · {{f.warn}}</span></sc-if><br><span data-mut=\"1\" style=\"font-size: 11.5px\">{{f.when}}{{f.by}}</span></span></a></sc-for></div>\n      </div>\n    </div>\n  </div>\n</div></div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{\"$preview\":{\"width\":390,\"height\":844}}'>\nclass Component extends DCLogic {\nstate = { d: null, q: '', f: 'all', lim: 12 };\nP = { search: '<circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"M20 20l-3.5-3.5\"/>', cal: '<rect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"2\"/><path d=\"M8 3v4M16 3v4M3 10h18\"/>', chat: '<path d=\"M4 5h16v11H9l-5 4z\"/>',\n  flag: '<path d=\"M5 21V4M5 4h11l-2 4 2 4H5\"/>', alert: '<path d=\"M12 3l9.5 16.5h-19z\"/><path d=\"M12 10v4M12 17h.01\"/>', clock: '<circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3 2\"/>', user: '<circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6\"/>',\n  cart: '<path d=\"M3 4h2l2.5 11h11L21 7H6\"/><circle cx=\"9\" cy=\"19\" r=\"1.5\"/><circle cx=\"17\" cy=\"19\" r=\"1.5\"/>', check: '<circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M8 12l3 3 5-6\"/>', x: '<circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M9 9l6 6M15 9l-6 6\"/>',\n  wrench: '<path d=\"M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.4-.6-.6-2.4z\"/>', doc: '<path d=\"M6 3h9l4 4v14H6z\"/><path d=\"M14 3v5h5M9 13h7M9 17h5\"/>', eye: '<path d=\"M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12z\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/>',\n  in: '<path d=\"M12 3v12M7 10l5 5 5-5M4 21h16\"/>', out: '<path d=\"M12 21V9M7 14l5-5 5 5M4 3h16\"/>', box: '<path d=\"M3 7l9-4 9 4v10l-9 4-9-4z\"/><path d=\"M3 7l9 4 9-4M12 11v10\"/>' };\nic(n, c) { return 'data:image/svg+xml;utf8,' + encodeURIComponent('<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"' + (c || '#1F2B4D') + '\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">' + (this.P[n] || this.P.box) + '</svg>'); }\nasync componentDidMount() { await RA.staff(); this.stop = RA.poll(this, () => this.reload(), 90000); }\ncomponentWillUnmount() { if (this.stop) this.stop(); }\nasync reload() {\n  const [un, wo, ap, sf, tk, pp, all, pr, fl, rk, feed] = await Promise.all([\n    RA.from('units').select('id,code,asset_no,plate_or_serial,status,updated_at,branch_id,product_id,branches(name),products(name)').in('status', ['service', 'qc', 'waiting_part']).is('archived_at', null).order('updated_at').limit(500),\n    RA.from('work_orders').select('id,code,unit_id,status,complaint,target_at,created_at,technician_id,vendor_name,units(code,asset_no,plate_or_serial,products(name)),branches(name)').in('status', ['queued', 'working', 'waiting_part', 'qc']).order('created_at').limit(300),\n    RA.from('approvals').select('id,kind,title,detail,created_at,payload,ref_id,status,ref_type').or('and(kind.eq.aset_lapor,status.eq.pending),and(kind.eq.pembelian_part,ref_type.eq.part_request)').order('created_at').limit(300),\n    RA.from('staff').select('user_id,name'),\n    RA.from('tickets').select('id,code,category,priority,summary,status,sla_due_at,created_at').in('status', ['open', 'in_progress']).or('division.eq.aset,category.ilike.%unit%,category.ilike.%rusak%,category.ilike.%mogok%').order('created_at').limit(50),\n    RA.from('product_prices').select('product_id,price').eq('basis', 'day').eq('is_active', true).limit(2000),\n    RA.from('units').select('status,products(categories(name))').is('archived_at', null).limit(5000),\n    RA.from('part_requests').select('id,items,status,estimated_total,created_at,purpose,need_by,requested_by,unit_id,branches(name)').in('status', ['requested', 'approved', 'ordered']).order('created_at').limit(200),\n    RA.from('unit_flags').select('id,unit_id,level,note,created_at,created_by,work_order_id,units(code,asset_no,plate_or_serial,products(name))').is('cleared_at', null).order('created_at').limit(200),\n    RA.call('asset_risk', {}).catch(() => null), RA.call('asset_feed', { p_limit: 15 }).catch(() => [])\n  ]);\n  if (!RA_ALIVE(this)) return;\n  const nm = {}; (sf.data || []).forEach(x => { nm[x.user_id] = x.name; });\n  this.setState({ d: { un: un.data || [], wo: wo.data || [], ap: ap.data || [], nm, tk: tk.data || [], pp: pp.data || [], all: all.data || [], pr: pr.data || [], fl: fl.data || [], rk: rk || {}, feed: feed || [] } });\n}\nasync swapUnit(c) { if (!confirm('Pindahkan booking ' + c.code + ' dari ' + c.unit + ' ke unit lain yang siap di jadwal yang sama?')) return; const r = await RA.call('asset_swap_unit', { p_item: c.item_id }); RA.ok('Booking ' + r.booking + ' dipindah ke ' + r.to); await this.reload(); }\nasync prDecide(r) { const { error } = await RA.from('part_requests').update({ status: 'approved' }).eq('id', r.id); if (error) throw new Error(error.message); await RA.from('approvals').update({ status: 'approved', decided_by: (RA.me() || {}).id, decided_at: new Date().toISOString() }).eq('ref_type', 'part_request').eq('ref_id', r.id).eq('status', 'pending'); RA.ok('Disetujui — silakan dibeli'); await this.reload(); }\nasync prSet(r, status) { const patch = { status }; if (status === 'ordered') patch.ordered_at = new Date().toISOString(); if (status === 'received') patch.received_at = new Date().toISOString(); const { error } = await RA.from('part_requests').update(patch).eq('id', r.id); if (error) throw new Error(error.message); RA.ok(status === 'ordered' ? 'Ditandai sudah dibeli' : 'Part diterima — teknisi bisa lanjut'); await this.reload(); }\nrenderVals() {\nconst s = this.state, d = s.d, now = new Date(), st = RA._staff || {}, IC = (n, c) => this.ic(n, c);\nconst NAVY = '#1F2B4D', RED = '#A12A1F', AMB = '#8A4B00', TEAL = '#077A70', RB = '#FDECEA', AB = '#FFF4E5', NB = '#EEF0F3', TB = '#E3F7F5';\nconst hrs = x => Math.max(0, Math.round((now - new Date(x)) / 36e5)), dur = h => h < 48 ? h + ' jam' : Math.round(h / 24) + ' hari';\nconst uName = u => ((u || {}).products || {}).name ? u.products.name + ' · ' + (u.plate_or_serial || u.asset_no || u.code || '') : 'Unit';\nconst det = id => 'AsetUnit.dc.html?id=' + id;\nconst T = []; let held = [], okU = 0, AC = [], late = [], due7 = [], lossDay = 0;\nif (d) {\n  const rk = d.rk || {};\n  const add = (pri, grp, o) => T.push(Object.assign({ pri, grp, sub: '', impact: '', age: '', ac: '#5B6577', href: '', cta: 'Buka', ctaBg: NAVY, ctaFg: '#FFFFFF', act: null, actLabel: '' }, o));\n  const tone = r => r ? { c: RED, bg: RB } : { c: AMB, bg: AB };\n  (rk.conflicts || []).forEach(c => { const hh = Math.round((new Date(c.start) - now) / 36e5), r = c.kind !== 'during';\n    const why = c.kind === 'status' ? 'Unit sedang ' + ({ service: 'diservis', waiting_part: 'menunggu part', qc: 'menunggu QC', inactive: 'tidak aktif' }[c.ustatus] || c.ustatus) : c.kind === 'overdue' ? 'Lewat jadwal ' + (c.rule || 'perawatan') : (c.rule || 'Perawatan') + ' jatuh tempo saat disewa';\n    add(hh < 48 ? 0 : 2, 'genting', Object.assign({ ic: IC('cal', r ? RED : AMB), kind: 'Booking bentrok', age: hh < 48 ? 'disewa ' + dur(Math.max(0, hh)) + ' lagi' : RA.date(c.start), ac: RED, title: c.unit, sub: why + ' · ' + c.code + ' (' + (c.guest || 'tamu') + ')', impact: c.alt ? c.alt + ' unit pengganti siap' : 'Tidak ada pengganti — percepat servis atau hubungi pelanggan', href: 'PosSerahTerima.dc.html?id=' + c.booking_id, cta: 'Booking', act: c.alt ? this.act(() => this.swapUnit(c)) : null, actLabel: 'Ganti unit' }, tone(r))); });\n  d.tk.forEach(t => { const od = t.sla_due_at && new Date(t.sla_due_at) < now; add(od ? 0 : 1, 'genting', Object.assign({ ic: IC('chat', RED), kind: 'Komplain pelanggan', age: dur(hrs(t.created_at)), ac: RED, title: t.category || 'Keluhan pelanggan', sub: (t.summary || '').slice(0, 110), impact: od ? 'Lewat batas waktu ' + dur(hrs(t.sla_due_at)) : '', href: 'TiketCS.dc.html', cta: 'Tangani' }, tone(true))); });\n  d.ap.filter(a => a.kind === 'aset_lapor').forEach(a => { const p = a.payload || {}, hil = p.kind === 'hilang' || p.kind === 'kurang'; add(hil ? 0 : 2, 'genting', Object.assign({ ic: IC(hil ? 'alert' : 'flag', hil ? RED : AMB), kind: hil ? 'Unit hilang / selisih' : 'Laporan dari cabang', age: dur(hrs(a.created_at)), title: String(a.detail || a.title || '').split(' · ').slice(0, 2).join(' · '), sub: p.note || '', href: 'MgmtSetuju.dc.html', cta: 'Putuskan' }, tone(hil))); });\n  d.fl.forEach(f => { const r = f.level === 'rusak'; add(r ? 1 : 3, r ? 'genting' : 'servis', Object.assign({ ic: IC(f.level === 'cek' ? 'eye' : 'flag', r ? RED : AMB), kind: { rusak: 'Ditandai rusak', perbaikan: 'Perlu perbaikan', cek: 'Dicek dulu' }[f.level], age: dur(hrs(f.created_at)), title: uName(f.units), sub: [f.note, d.nm[f.created_by]].filter(Boolean).join(' · '), impact: r ? (f.work_order_id ? 'Sudah masuk antrean servis' : 'Belum ada servis') : f.level === 'perbaikan' ? 'Masih bisa disewa — jadwalkan perbaikan' : 'Ditahan sampai lolos QC', href: det(f.unit_id), cta: 'Buka unit' }, tone(r))); });\n  late = d.wo.filter(w => w.target_at && new Date(w.target_at) < now);\n  const PR = {}; d.pp.forEach(p => { if (!PR[p.product_id] || +p.price < PR[p.product_id]) PR[p.product_id] = +p.price; });\n  held = d.un; lossDay = held.reduce((a, u) => a + (PR[u.product_id] || 0), 0);\n  late.forEach(w => { const pr = PR[(held.find(u => u.id === w.unit_id) || {}).product_id]; add(2, 'servis', Object.assign({ ic: IC('clock', RED), kind: 'Servis molor', age: 'lewat ' + dur(hrs(w.target_at)), ac: RED, title: uName(w.units), sub: (w.complaint || w.code) + ' · ' + (w.vendor_name ? 'bengkel ' + w.vendor_name : d.nm[w.technician_id] || 'belum ada teknisi'), impact: pr ? '±' + RA.rp(pr) + '/hari tidak bisa disewa' : '', href: det(w.unit_id), cta: 'Buka unit' }, tone(true))); });\n  d.wo.filter(w => !w.technician_id && !w.vendor_name && w.status === 'queued' && !(w.target_at && new Date(w.target_at) < now)).forEach(w => add(4, 'servis', Object.assign({ ic: IC('user', AMB), kind: 'Belum ada teknisi', age: dur(hrs(w.created_at)), title: uName(w.units), sub: w.complaint || w.code, href: 'MgmtServis.dc.html', cta: 'Tugaskan' }, tone(false))));\n  const woU = {}; d.wo.forEach(w => { woU[w.unit_id] = w; });\n  d.wo.filter(w => w.status === 'qc').forEach(w => add(4, 'servis', { ic: IC('check', TEAL), bg: TB, c: TEAL, kind: 'QC setelah servis', age: dur(hrs(w.created_at)), title: uName(w.units), sub: w.code, href: 'PosQC.dc.html', cta: 'Cek QC' }));\n  d.un.filter(u => u.status === 'qc' && !woU[u.id]).forEach(u => add(4, 'servis', { ic: IC('check', TEAL), bg: TB, c: TEAL, kind: 'Baru kembali, cek dulu', age: dur(hrs(u.updated_at)), ac: hrs(u.updated_at) > 24 ? RED : '#5B6577', title: uName(u), sub: (u.branches || {}).name || '', href: 'PosQC.dc.html', cta: 'Cek QC' }));\n  const apm = {}; d.ap.filter(a => a.kind === 'pembelian_part').forEach(a => { apm[a.ref_id] = a.status; });\n  d.pr.forEach(r => { const ap = apm[r.id]; if (ap === 'rejected' || r.status === 'rejected') return; const k = r.status === 'ordered' ? 'ordered' : (r.status === 'approved' || ap === 'approved') ? 'approved' : 'requested';\n    add(k === 'requested' ? 3 : 5, 'part', { ic: IC('cart', k === 'requested' ? AMB : NAVY), bg: k === 'requested' ? AB : NB, c: k === 'requested' ? AMB : NAVY, kind: k === 'approved' ? 'Part siap dibeli' : k === 'ordered' ? 'Part menunggu datang' : 'Part perlu disetujui', age: r.need_by ? 'butuh ' + r.need_by : dur(hrs(r.created_at)), ac: /Hari ini/.test(r.need_by || '') ? RED : '#5B6577',\n      title: (r.items || []).map(i => i.name + ' ×' + i.qty).join(', '), sub: [r.purpose, (r.branches || {}).name, d.nm[r.requested_by], r.estimated_total ? '± ' + RA.rp(r.estimated_total) : ''].filter(Boolean).join(' · '), href: r.unit_id ? det(r.unit_id) : '', cta: 'Unit',\n      act: k === 'approved' ? this.act(() => this.prSet(r, 'ordered