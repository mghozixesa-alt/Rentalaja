{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Beranda aset</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0}\na{color:#1F2B4D}a:hover{color:#000}\nbutton:disabled{opacity:.55;cursor:not-allowed}\n\n/* tampilan desktop (layar lebar) */\n@media (min-width: 1000px){\n  header[data-hero]{padding:22px 32px 64px !important}\n  header[data-hero] > div, main[data-aset]{max-width:1180px !important}\n  main[data-aset]{padding:0 32px 32px !important;gap:16px !important}\n  main[data-aset] [data-scrollx]{overflow:visible !important;scroll-snap-type:none !important;margin:0 !important;padding-left:0 !important;padding-right:0 !important}\n  section[aria-label=\"Alur perbaikan\"] [data-scrollx] > button{flex:1 1 0 !important;min-width:0 !important;max-width:none !important;padding:12px 14px !important}\n  section[aria-label=\"Alur perbaikan\"] [data-scrollx] > button span:first-child{font-size:28px !important;line-height:32px !important}\n  section[aria-label=\"Alur perbaikan\"] [data-scrollx] > button span:nth-child(2){font-size:13px !important;line-height:17px !important}\n  section[aria-label=\"Alur perbaikan\"] [data-scrollx] > button span:nth-child(3){font-size:11.5px !important}\n  section[aria-label=\"Per kategori\"] [data-scrollx]{flex-wrap:wrap !important}\n  section[aria-label=\"Per kategori\"] [data-scrollx] > div{flex:1 1 160px !important}\n  section[aria-label=\"Selesaikan sekarang\"] [data-scrollx]{flex-wrap:wrap !important}\n  section[aria-label=\"Selesaikan sekarang\"] [data-scrollx] > a{flex:1 1 300px !important;max-width:none !important}\n  main[data-aset] section > div:first-child > span:last-child{display:none}\n  header[data-hero] img[alt=\"Rentalaja\"]{visibility:hidden}\n  main[data-aset] [data-items]{display:grid !important;grid-template-columns:1fr 1fr;column-gap:0}\n  main[data-aset] [data-items] > div:nth-child(odd){border-right:1px solid #EEF0F3}\n}\n</style>\n</helmet>\n<div style=\"min-height: 100vh; box-sizing: border-box; background: #F4F6F9; color: #1F2B4D; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; flex-direction: column\">\n\n  <header data-hero=\"1\" style=\"background: linear-gradient(160deg, #1F2B4D 0%, #2E3F6B 100%); padding: 14px 16px 60px; color: #FFFFFF; position: relative; overflow: hidden\">\n    <div style=\"max-width: 720px; margin: 0 auto; display: flex; flex-direction: column; gap: 12px; position: relative\">\n      <div style=\"display: flex; justify-content: space-between; align-items: center\"><img src=\"logo.png\" alt=\"Rentalaja\" style=\"height: 26px; width: auto; background: #FFFFFF; border-radius: 8px; padding: 4px 8px; display: block\"><button type=\"button\" data-noprint=\"1\" onClick=\"{{cetak}}\" style=\"height: 32px; padding: 0 12px; border-radius: 16px; border: 0; background: #FFFFFF; color: #1F2B4D; font: 800 12px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">⎙ Cetak / PDF</button></div>\n      <div style=\"display: flex; align-items: center; gap: 14px\">\n        <div style=\"{{ring}}\"><div style=\"width: 74px; height: 74px; border-radius: 37px; background: #24335A; display: flex; flex-direction: column; align-items: center; justify-content: center\"><b style=\"font-size: 22px; line-height: 24px\">{{health}}</b><span style=\"font-size: 10px; opacity: 0.85\">siap pakai</span></div></div>\n        <div style=\"flex: 1; min-width: 0\"><div style=\"font-size: 13px; opacity: 0.9\">{{hello}}</div><div style=\"font-size: 20px; font-weight: 800; line-height: 25px\">{{headline}}</div><div style=\"font-size: 12px; opacity: 0.85; margin-top: 2px\">{{healthSub}}</div></div>\n      </div>\n      <sc-if value=\"{{loss}}\"><div style=\"background: rgba(229,83,75,0.22); border: 1px solid rgba(255,160,150,0.5); border-radius: 12px; padding: 10px 12px; display: flex; align-items: center; gap: 10px\"><span style=\"font-size: 22px\">💸</span><span style=\"font-size: 13px; line-height: 18px\"><b style=\"font-size: 15px\">{{loss}}</b><br>{{lossSub}}</span></div></sc-if>\n      <div style=\"position: relative\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#5B6577\" stroke-width=\"2.4\" aria-hidden=\"true\" style=\"position: absolute; left: 14px; top: 15px\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"M20 20l-3.5-3.5\"/></svg><input type=\"search\" aria-label=\"Cari unit\" placeholder=\"Cari unit: plat, nomor aset, atau nama barang\" value=\"{{q}}\" onInput=\"{{setQ}}\" style=\"height: 48px; width: 100%; box-sizing: border-box; border: 0; border-radius: 14px; padding: 0 14px 0 40px; font: 500 14px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; background: #FFFFFF\"></div>\n    </div>\n  </header>\n  <main data-aset=\"1\" style=\"width: 100%; max-width: 720px; margin: 0 auto; box-sizing: border-box; padding: 0 16px 16px; display: flex; flex-direction: column; gap: 12px\">\n    <sc-if value=\"{{searching}}\"><section style=\"margin-top: -34px; position: relative; background: #FFFFFF; border-radius: 16px; box-shadow: 0 6px 20px rgba(31,43,77,0.10); padding: 8px 14px; display: flex; flex-direction: column\">\n      <sc-if value=\"{{sNone}}\"><div style=\"font-size: 13px; color: #4A5468; padding: 8px 0\">{{sNone}}</div></sc-if>\n      <sc-for list=\"{{sres}}\" as=\"r\"><a href=\"{{r.href}}\" style=\"text-decoration: none; color: #1F2B4D; display: flex; justify-content: space-between; gap: 8px; padding: 10px 0; border-top: 1px solid #EEF0F3\"><span style=\"min-width: 0; display: flex; flex-direction: column\"><b style=\"font-size: 14px\">{{r.name}}</b><span style=\"font-size: 12px; color: #4A5468\">{{r.sub}}</span></span><span style=\"{{r.chip}}\">{{r.st}}</span></a></sc-for>\n    </section></sc-if>\n    <sc-if value=\"{{hasUrgent}}\"><section aria-label=\"Selesaikan sekarang\" style=\"{{urgWrap}}\">\n      <div style=\"display: flex; justify-content: space-between; align-items: center\"><b style=\"font-size: 16px\">🔥 Selesaikan sekarang</b><span style=\"font-size: 11px; color: #4A5468\">geser →</span></div>\n      <div data-scrollx=\"1\" style=\"display: flex; gap: 10px; overflow-x: auto; scroll-snap-type: x mandatory; margin: 0 -14px; padding: 2px 14px 6px\">\n        <sc-for list=\"{{urgent}}\" as=\"u\"><a href=\"{{u.href}}\" style=\"flex: 0 0 82%; max-width: 300px; scroll-snap-align: start; text-decoration: none; color: #1F2B4D; border-radius: 16px; padding: 14px; display: flex; flex-direction: column; gap: 6px; background: {{u.bg}}; border: 1.5px solid {{u.bd}}\">\n          <div style=\"display: flex; justify-content: space-between; align-items: center; gap: 8px\"><span style=\"font-size: 12px; font-weight: 800; color: {{u.c}}\">{{u.icon}} {{u.kind}}</span><span style=\"font-size: 12px; font-weight: 800; color: {{u.c}}; white-space: nowrap\">⏱ {{u.age}}</span></div>\n          <b style=\"font-size: 16px; line-height: 21px\">{{u.title}}</b>\n          <span style=\"font-size: 13px; line-height: 18px; color: #3A4458\">{{u.sub}}</span>\n          <sc-if value=\"{{u.impact}}\"><span style=\"font-size: 12px; font-weight: 800; color: #A12A1F\">{{u.impact}}</span></sc-if>\n          <span style=\"margin-top: 2px; align-self: flex-start; height: 34px; padding: 0 14px; border-radius: 10px; background: #1F2B4D; color: #FFFFFF; font-size: 13px; font-weight: 800; display: inline-flex; align-items: center\">{{u.cta}} →</span>\n        </a></sc-for>\n      </div>\n    </section></sc-if>\n    <section aria-label=\"Alur perbaikan\" style=\"{{flowWrap}}\">\n      <div style=\"display: flex; justify-content: space-between; align-items: center; padding: 0 2px\"><b style=\"font-size: 14px\">Alur perbaikan unit</b><span style=\"font-size: 11px; color: #4A5468\">ketuk tahap · geser →</span></div>\n      <div data-scrollx=\"1\" style=\"display: flex; gap: 6px; overflow-x: auto; margin: 0 -14px; padding: 2px 14px 4px; align-items: stretch\">\n        <sc-for list=\"{{stages}}\" as=\"g\"><button type=\"button\" onClick=\"{{g.pick}}\" aria-pressed=\"{{g.on}}\" style=\"{{g.style}}\"><span style=\"font-size: 22px; font-weight: 800; line-height: 26px; color: {{g.nc}}\">{{g.n}}</span><span style=\"font-size: 11px; font-weight: 800; line-height: 14px\">{{g.label}}</span><span style=\"font-size: 10px; line-height: 13px; opacity: 0.75\">{{g.who}}</span></button><sc-if value=\"{{g.arrow}}\"><span aria-hidden=\"true\" style=\"align-self: center; color: #B4BCC8; font-size: 16px; flex-shrink: 0\">›</span></sc-if></sc-for>\n      </div>\n    </section>\n    <section aria-label=\"Per kategori\" style=\"background: #FFFFFF; border-radius: 16px; box-shadow: 0 2px 10px rgba(31,43,77,0.05); padding: 12px 14px; display: flex; flex-direction: column; gap: 8px\">\n      <div style=\"display: flex; justify-content: space-between; align-items: center\"><b style=\"font-size: 14px\">Kondisi per kategori</b><a href=\"AsetPreventif.dc.html\" data-noprint=\"1\" style=\"font-size: 12px; font-weight: 800; color: #077A70; text-decoration: none\">Preventif →</a></div>\n      <div data-scrollx=\"1\" style=\"display: flex; gap: 8px; overflow-x: auto; scroll-snap-type: x mandatory; margin: 0 -14px; padding: 0 14px 4px\">\n        <sc-for list=\"{{cats}}\" as=\"c\"><div style=\"flex: 0 0 auto; min-width: 128px; scroll-snap-align: start; background: #F6F7F9; border-radius: 12px; padding: 10px; display: flex; flex-direction: column; gap: 4px\"><b style=\"font-size: 13px; white-space: nowrap\">{{c.name}}</b><span style=\"font-size: 20px; font-weight: 800; color: {{c.color}}\">{{c.pct}}</span><div style=\"height: 5px; border-radius: 3px; background: #E2E6EC\"><div style=\"{{c.bar}}\"></div></div><span style=\"font-size: 11px; color: #4A5468; white-space: nowrap\">{{c.sub}}</span></div></sc-for>\n      </div>\n    </section>\n    <div style=\"display: flex; flex-direction: column; gap: 2px; padding: 0 4px\"><b style=\"font-size: 16px\">{{stTitle}}</b><span style=\"font-size: 12px; color: #4A5468\">{{hint}}</span></div>\n    <sc-if value=\"{{loading}}\"><div style=\"background: #FFFFFF; border-radius: 16px; padding: 18px; text-align: center; font-size: 14px; color: #4A5468\">Memuat…</div></sc-if>\n    <sc-if value=\"{{empty}}\"><div style=\"background: #FFFFFF; border-radius: 16px; padding: 20px 16px; text-align: center; font-size: 14px; line-height: 20px; color: #1E6B45; font-weight: 700\">{{empty}}</div></sc-if>\n    <sc-if value=\"{{hasItems}}\"><div data-items=\"1\" style=\"background: #FFFFFF; border-radius: 16px; box-shadow: 0 2px 10px rgba(31,43,77,0.05); overflow: hidden\"><sc-for list=\"{{items}}\" as=\"r\"><div style=\"display: flex; align-items: center; gap: 10px; padding: 10px 12px; border-bottom: 1px solid #EEF0F3\">\n      <span style=\"width: 4px; align-self: stretch; border-radius: 2px; background: {{r.bar}}; flex-shrink: 0\"></span>\n      <a href=\"{{r.href}}\" style=\"flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; text-decoration: none; color: #1F2B4D\"><span style=\"display: flex; gap: 6px; align-items: center; min-width: 0\"><span style=\"{{r.chip}}\">{{r.type}}</span><span style=\"font-size: 11px; font-weight: 800; color: {{r.rightColor}}; white-space: nowrap; overflow: hidden; text-overflow: ellipsis\">{{r.right}}</span></span><b style=\"font-size: 14px; line-height: 18px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis\">{{r.title}}</b><sc-if value=\"{{r.sub}}\"><span style=\"font-size: 12px; line-height: 16px; color: #4A5468; white-space: nowrap; overflow: hidden; text-overflow: ellipsis\">{{r.sub}}</span></sc-if></a>\n      <sc-if value=\"{{r.act}}\"><button type=\"button\" onClick=\"{{r.act}}\" disabled=\"{{busy}}\" style=\"height: 34px; padding: 0 10px; border-radius: 9px; border: 0; background: #1F2B4D; color: #FFFFFF; font: 800 12px 'Plus Jakarta Sans', sans-serif; cursor: pointer; white-space: nowrap; flex-shrink: 0\">{{r.actLabel}}</button></sc-if>\n      <sc-if value=\"{{r.act}}\" not><span style=\"font-size: 20px; color: #B4BCC8; flex-shrink: 0\" aria-hidden=\"true\">›</span></sc-if>\n    </div></sc-for></div></sc-if>\n    <sc-if value=\"{{more}}\"><div style=\"font-size: 12px; color: #4A5468; text-align: center\">{{more}}</div></sc-if>\n  </main>\n</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{\"$preview\":{\"width\":390,\"height\":844}}'>\nclass Component extends DCLogic {\nstate = { stage: null, d: null, q: '', sres: null };\nasync componentDidMount() { await RA.staff(); this.stop = RA.poll(this, () => this.reload(), 90000); }\ncomponentWillUnmount() { if (this.stop) this.stop(); }\nasync reload() {\n  const soon = new Date(Date.now() + 30 * 864e5).toISOString().slice(0, 10);\n  const [un, wo, ap, sf, dd, tk, pp, all, pr] = await Promise.all([\n    RA.from('units').select('id,code,asset_no,plate_or_serial,status,updated_at,branch_id,product_id,branches(name),products(name)').in('status', ['service', 'qc', 'waiting_part']).is('archived_at', null).order('updated_at').limit(500),\n    RA.from('work_orders').select('id,code,unit_id,status,complaint,target_at,created_at,technician_id,vendor_name,total_cost,units(code,asset_no,plate_or_serial,products(name)),branches(name)').in('status', ['queued', 'working', 'waiting_part', 'qc']).order('created_at').limit(300),\n    RA.from('approvals').select('id,kind,title,detail,created_at,payload,ref_id,status,ref_type').or('and(kind.eq.aset_lapor,status.eq.pending),and(kind.eq.pembelian_part,ref_type.eq.part_request)').order('created_at').limit(300),\n    RA.from('staff').select('user_id,name'),\n    RA.from('units').select('id,code,asset_no,plate_or_serial,stnk_due,stnk_tax_due,branches(name),products(name)').is('archived_at', null).or('stnk_due.lte.' + soon + ',stnk_tax_due.lte.' + soon).limit(200),\n    RA.from('tickets').select('id,code,category,priority,summary,status,sla_due_at,created_at,division,pic_id,booking_id').in('status', ['open', 'in_progress']).or('division.eq.aset,category.ilike.%unit%,category.ilike.%rusak%,category.ilike.%mogok%').order('created_at').limit(50),\n    RA.from('product_prices').select('product_id,price,basis').eq('basis', 'day').eq('is_active', true).limit(2000),\n    RA.from('units').select('status,products(categories(name))').is('archived_at', null).limit(5000),\n    RA.from('part_requests').select('id,items,status,estimated_total,created_at,purpose,need_by,requested_by,work_order_id,unit_id,branches(name)').in('status', ['requested', 'approved', 'ordered']).order('created_at').limit(200)\n  ]);\n  if (!RA_ALIVE(this)) return;\n  const nm = {}; (sf.data || []).forEach(x => { nm[x.user_id] = x.name; });\n  this.setState({ d: { un: un.data || [], wo: wo.data || [], ap: ap.data || [], nm, dd: dd.data || [], pr: pr.data || [], tk: tk.data || [], pp: pp.data || [], all: all.data || [] } });\n}\nasync prDecide(r, ok) {\n  const { error } = await RA.from('part_requests').update({ status: ok ? 'approved' : 'rejected' }).eq('id', r.id); if (error) throw new Error(error.message);\n  await RA.from('approvals').update({ status: ok ? 'approved' : 'rejected', decided_by: (RA.me() || {}).id, decided_at: new Date().toISOString() }).eq('ref_type', 'part_request').eq('ref_id', r.id).eq('status', 'pending');\n  RA.ok(ok ? 'Disetujui — silakan dibeli' : 'Pengajuan ditolak'); await this.reload();\n}\nasync prSet(r, status) {\n  const patch = { status }; if (status === 'ordered') patch.ordered_at = new Date().toISOString(); if (status === 'received') patch.received_at = new Date().toISOString();\n  const { error } = await RA.from('part_requests').update(patch).eq('id', r.id); if (error) throw new Error(error.message);\n  RA.ok(status === 'ordered' ? 'Ditandai sudah dibeli' : 'Part diterima — teknisi bisa lanjut'); await this.reload();\n}\nasync search(q) {\n  q = String(q || '').trim().replace(/[,()%*]/g, ' ').trim(); if (q.length < 2) { this.setState({ sres: null }); return; }\n  const { data } = await RA.from('units').select('id,code,asset_no,plate_or_serial,status,branches(name),products!inner(name)').is('archived_at', null).or('asset_no.ilike.%' + q + '%,plate_or_serial.ilike.%' + q + '%,code.ilike.%' + q + '%').limit(12);\n  let rows = data || [];\n  if (rows.length < 5) { const r2 = await RA.from('units').select('id,code,asset_no,plate_or_serial,status,branches(name),products!inner(name)').is('archived_at', null).ilike('products.name', '%' + q + '%').limit(12); rows = rows.concat((r2.data || []).filter(x => !rows.some(y => y.id === x.id))); }\n  if (RA_ALIVE(this) && this.state.q.trim().replace(/[,()%*]/g, ' ').trim() === q) this.setState({ sres: rows.slice(0, 12) });\n}\nrenderVals() {\nconst s = this.state, d = s.d, now = new Date(), st = RA._staff || {};\nconst T = (type, c) => ({ type, chip: 'display: inline-flex; align-items: center; height: 20px; padding: 0 7px; border-radius: 10px; font-size: 11px; font-weight: 800; white-space: nowrap; background: ' + c[0] + '; color: ' + c[1], bar: c[2] });\nconst RED = ['#FDECEA', '#A12A1F', '#E5534B'], AMB = ['#FFF1D6', '#8A4B00', '#F2C14E'], BLU = ['#E8EEF8', '#1F2B4D', '#1F2B4D'], TEA = ['#E3F7F5', '#077A70', '#09BEAF'], GRN = ['#E4F2EA', '#1E6B45', '#1E9E6A'];\nconst hrs = x => { const v = Math.round((now - new Date(x)) / 36e5); return v > 0 ? v : 0; }; const dur = h => h < 48 ? h + ' jam' : Math.round(h / 24) + ' hari';\nconst uName = u => ((u.products || {}).name || 'Unit') + ' · ' + (u.plate_or_serial || u.asset_no || u.code || '');\nconst det = id => 'MgmtAsetDetail.dc.html?id=' + id;\nconst L = { komplain: [], lapor: [], antre: [], kerja: [], part: [], qc: [], beli: [], tempo: [] };\nif (d) {\n  const tech = w => w.vendor_name ? 'bengkel ' + w.vendor_name : d.nm[w.technician_id] || 'belum ada teknisi';\n  const late = w => w.target_at && new Date(w.target_at) < now;\n  const woU = {}; d.wo.forEach(w => { woU[w.unit_id] = w; });\n  d.ap.filter(a => a.kind === 'aset_lapor').forEach(a => { const p = a.payload || {}; const K = { rusak: 'Rusak', hilang: 'Hilang', kurang: 'Selisih stok', lebih: 'Kelebihan', ditemukan: 'Ditemukan' };\n    L.lapor.push(Object.assign({ at: new Date(a.created_at) }, T(K[p.kind] || 'Laporan', p.kind === 'rusak' || p.kind === 'hilang' ? RED : AMB), { title: String(a.detail || a.title).split(' · ').slice(0, 2).join(' · '), sub: (p.note || '') + ' · ' + dur(hrs(a.created_at)) + ' lalu', right: p.kind === 'hilang' || p.kind === 'kurang' ? 'diputuskan owner' : '', rightColor: '#8A4B00', href: 'MgmtSetuju.dc.html' })); });\n  const W = (w, c) => Object.assign({ at: new Date(w.created_at) }, T(late(w) ? 'Lewat target' : c[0], late(w) ? RED : c[1]), { title: uName(w.units || {}), sub: (w.complaint || w.code) + ' · ' + tech(w) + ' · ' + ((w.branches || {}).name || ''), right: (late(w) ? 'lewat ' + dur(hrs(w.target_at)) : 'sejak ' + dur(hrs(w.created_at))), rightColor: late(w) ? '#A12A1F' : '#4A5468', href: det(w.unit_id) });\n  d.wo.forEach(w => { if (w.status === 'queued') L.antre.push(W(w, [w.technician_id || w.vendor_name ? 'Antre' : 'Belum ada teknisi', w.technician_id || w.vendor_name ? BLU : AMB])); else if (w.status === 'working') L.kerja.push(W(w, ['Dikerjakan', TEA])); else if (w.status === 'waiting_part') L.part.push(W(w, ['Tunggu part', AMB])); else if (w.status === 'qc') L.qc.push(W(w, ['QC setelah servis', TEA])); });\n  d.un.filter(u => u.status === 'qc' && !woU[u.id]).forEach(u => L.qc.push(Object.assign({ at: new Date(u.updated_at) }, T('Baru kembali', TEA), { title: uName(u), sub: ((u.branches || {}).name || '') + ' · cek sebelum disewa lagi', right: dur(hrs(u.updated_at)), rightColor: hrs(u.updated_at) > 24 ? '#A12A1F' : '#4A5468', href: 'PosQC.dc.html' })));\n  const noWo = d.un.filter(u => (u.status === 'service' || u.status === 'waiting_part') && !