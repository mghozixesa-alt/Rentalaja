{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Beranda Rentalaja</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0;background:#F4F6F9}\na{color:#1F2B4D}a:hover{color:#000}\n.ra-hs::-webkit-scrollbar{display:none}\n.ra-shine{position:absolute;top:0;left:-45%;width:30%;height:100%;z-index:1;background:linear-gradient(90deg,transparent,rgba(255,255,255,.22),transparent);transform:skewX(-20deg);animation:raShine 4.2s ease-in-out infinite;pointer-events:none}@keyframes raShine{0%,62%{left:-45%}100%{left:135%}}@media (prefers-reduced-motion:reduce){.ra-shine{animation:none;display:none}}\n</style>\n</helmet>\n<div style=\"width: 390px; height: 2400px; box-sizing: border-box; background: #F4F6F9; color: #1F2B4D; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; flex-direction: column; position: relative; overflow: hidden\">\n\n  <section style=\"background: linear-gradient(160deg, #09BEAF 0%, #077A70 100%); padding: 16px 20px 64px; display: flex; flex-direction: column; gap: 14px; position: relative; overflow: hidden\">\n    <svg width=\"220\" height=\"220\" viewBox=\"0 0 220 220\" aria-hidden=\"true\" style=\"position: absolute; right: -60px; top: -70px; opacity: 0.18\"><circle cx=\"110\" cy=\"110\" r=\"100\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"30\"/></svg>\n    <div style=\"display: flex; justify-content: space-between; align-items: center; position: relative\">\n      <img src=\"logo.png\" alt=\"Rentalaja\" style=\"height: 26px; width: auto; background: #FFFFFF; border-radius: 8px; padding: 4px 8px; display: block\">\n      <a href=\"HomeEn.dc.html\" lang=\"en\" aria-label=\"English\" style=\"height: 32px; padding: 0 10px; border-radius: 16px; background: rgba(255,255,255,0.22); color: #FFFFFF; font-size: 12px; font-weight: 800; display: flex; align-items: center; text-decoration: none\">EN</a>\n    </div>\n    <div style=\"position: relative; display: flex; flex-direction: column; gap: 2px; color: #FFFFFF\">\n      <span style=\"font-size: 13px; opacity: 0.92\">Halo, mau sewa apa hari ini?</span>\n      <label style=\"position: relative; align-self: flex-start; display: flex; align-items: center; gap: 6px; font-size: 22px; font-weight: 800; cursor: pointer; min-height: 44px\">\n        {{branchName}}\n        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"2.6\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M6 9l6 6 6-6\"/></svg>\n        <select aria-label=\"Pilih cabang\" value=\"{{branchId}}\" onChange=\"{{pickBranch}}\" style=\"position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; font-size: 16px\"><sc-for list=\"{{branchOpts}}\" as=\"o\"><option value=\"{{o.id}}\">{{o.name}}</option></sc-for></select>\n      </label>\n    </div>\n    <a href=\"Cari.dc.html\" style=\"position: relative; height: 48px; border-radius: 14px; background: #FFFFFF; display: flex; align-items: center; gap: 10px; padding: 0 14px; text-decoration: none\">\n      <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#5B6577\" stroke-width=\"2.4\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"M20 20l-3.5-3.5\"/></svg>\n      <span style=\"font-size: 14px; color: #5B6577\">Cari motor, iPhone, kamera…</span>\n    </a>\n  </section>\n\n  <nav aria-label=\"Kategori\" style=\"margin: -44px 16px 0; background: #FFFFFF; border-radius: 20px; box-shadow: 0 6px 20px rgba(31,43,77,0.10); padding: 22px 6px 10px; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); row-gap: 22px; position: relative\">\n    <a href=\"Katalog.dc.html?cat=motor\" style=\"text-decoration: none; display: flex; 