ize: 13px; font-weight: 800; color: #077A70\">Lihat paket →</span></span>\n        </a>\n      </sc-for>\n    </div>\n  </section></sc-if>\n\n  <a href=\"Menginap.dc.html\" style=\"margin: 26px 16px 0; border-radius: 20px; background: linear-gradient(160deg, #2E6F57 0%, #1F2B4D 100%); padding: 18px; position: relative; overflow: hidden; display: flex; flex-direction: column; gap: 6px; text-decoration: none\">\n    <svg width=\"220\" height=\"110\" viewBox=\"0 0 220 110\" aria-hidden=\"true\" style=\"position: absolute; right: -10px; bottom: -4px; opacity: 0.55\"><path d=\"M0 110L70 30l40 40 30-24 80 64z\" fill=\"#3C8D6E\"/><path d=\"M90 110l50-48 60 48z\" fill=\"#09BEAF\"/><circle cx=\"180\" cy=\"22\" r=\"10\" fill=\"#F7B955\"/></svg>\n    <span style=\"font-size: 11px; font-weight: 800; color: #F7B955; position: relative\">RENTALAJA EXPERIENCE</span>\n    <b style=\"font-size: 18px; line-height: 23px; color: #FFFFFF; max-width: 210px; position: relative\">Sekalian liburan di Garut?</b>\n    <span style=\"font-size: 12px; color: #C9D1DE; max-width: 200px; position: relative\">Ruma Metua · Ertap Village · Jeep Trip Garut</span>\n    <span style=\"align-self: flex-start; margin-top: 6px; height: 36px; padding: 0 14px; border-radius: 18px; background: #FFFFFF; color: #1F2B4D; font-size: 13px; font-weight: 800; display: flex; align-items: center; position: relative\">Lihat penginapan &amp; trip</span>\n  </a>\n\n  <section style=\"margin: 16px 16px 0; background: #FFFFFF; border-radius: 20px; padding: 16px; display: flex; flex-direction: column; gap: 4px\">\n    <h2 style=\"margin: 0; font-size: 17px; font-weight: 800\">Ambil di cabang terdekat</h2>\n    <span style=\"font-size: 12px; font-weight: 700; color: #1E6B45\">● Buka setiap hari 07.30–21.00</span>\n    <sc-for list=\"{{branchCards}}\" as=\"c\">\n      <div style=\"display: flex; gap: 12px; align-items: center; padding: 10px 0; border-bottom: 1px solid #EEF0F3\">\n        <span role=\"button\" tabindex=\"0\" onClick=\"{{c.pick}}\" style=\"display: flex; gap: 12px; align-items: center; flex: 1; min-width: 0; cursor: pointer\">\n          <span style=\"{{c.pinStyle}}\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"{{c.pinColor}}\" stroke-width=\"2.4\" aria-hidden=\"true\"><path d=\"M12 21s-7-6.5-7-11a7 7 0 0 1 14 0c0 4.5-7 11-7 11z\"/><circle cx=\"12\" cy=\"10\" r=\"2.5\"/></svg></span>\n          <span style=\"flex: 1; display: flex; flex-direction: column; gap: 2px; min-width: 0\"><b style=\"font-size: 14px\">{{c.name}}</b><span style=\"font-size: 12px; color: #5B6577\">{{c.addr}}</span></span>\n        </span>\n        <sc-if value=\"{{c.map}}\"><a href=\"{{c.map}}\" target=\"_blank\" rel=\"noopener\" style=\"flex-shrink: 0; height: 32px; padding: 0 12px; border-radius: 16px; border: 1px solid #DDE1E7; font-size: 12px; font-weight: 700; color: #1F2B4D; display: flex; align-items: center; text-decoration: none\">Rute</a></sc-if>\n      </div>\n    </sc-for>\n  </section>\n\n  <section style=\"padding: 26px 16px 0; display: flex; flex-direction: column; gap: 12px\">\n    <h2 style=\"margin: 0; font-size: 17px; font-weight: 800\">Cara sewa di Rentalaja</h2>\n    <div style=\"display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px\">\n      <div style=\"background: #FFFFFF; border-radius: 16px; padding: 14px 10px; display: flex; flex-direction: column; align-items: center; gap: 8px; text-align: center\">\n        <span style=\"width: 40px; height: 40px; border-radius: 20px; background: #E3F7F5; display: flex; align-items: center; justify-content: center\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#077A70\" stroke-width=\"2.4\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"M20 20l-3.5-3.5\"/></svg></span>\n        <b style=\"font-size: 12px; line-height: 16px\">Pilih barang &amp; jam</b>\n      </div>\n      <div style=\"background: #FFFFFF; border-radius: 16px; padding: 