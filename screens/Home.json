e=\"height: 128px; border-radius: 18px; background: #FDE8E4; text-decoration: none; position: relative; overflow: hidden; padding: 14px; box-sizing: border-box; display: flex; flex-direction: column; gap: 2px\">\n        <b style=\"font-size: 15px; position: relative; z-index: 1\">Nobar &amp; acara</b><span style=\"font-size: 12px; color: #4A5468; position: relative; z-index: 1\">proyektor + screen</span>\n        <img src=\"img/p/proyektor-panasonic-vw355n.webp\" alt=\"\" style=\"position: absolute; right: -14px; bottom: -26px; width: 120px; height: 120px; object-fit: contain\">\n      </a>\n      <a href=\"Katalog.dc.html?cat=camping\" style=\"height: 128px; border-radius: 18px; background: #E4F3E9; text-decoration: none; position: relative; overflow: hidden; padding: 14px; box-sizing: border-box; display: flex; flex-direction: column; gap: 2px\">\n        <b style=\"font-size: 15px; position: relative; z-index: 1\">Naik gunung</b><span style=\"font-size: 12px; color: #4A5468; position: relative; z-index: 1\">carrier, sleeping bag</span>\n        <img src=\"img/p/carrier-60l.webp\" alt=\"\" style=\"position: absolute; right: -16px; bottom: -18px; width: 108px; height: 108px; object-fit: contain\">\n      </a>\n      <a href=\"Katalog.dc.html?cat=motor\" style=\"height: 128px; border-radius: 18px; background: #E3F7F5; text-decoration: none; position: relative; overflow: hidden; padding: 14px; box-sizing: border-box; display: flex; flex-direction: column; gap: 2px\">\n        <b style=\"font-size: 15px; position: relative; z-index: 1\">Keliling kota</b><span style=\"font-size: 12px; color: #4A5468; position: relative; z-index: 1\">motor matic harian</span>\n        <img src=\"img/p/honda-beat-cbs-new.webp\" alt=\"\" style=\"position: absolute; right: -14px; bottom: -26px; width: 104px; height: 104px; object-fit: contain\">\n      </a>\n    </div>\n  </section>\n\n  <sc-if value=\"{{hasPacks}}\"><section style=\"padding: 26px 0 0 0; display: flex; flex-direction: col