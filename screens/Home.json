">599 ulasan Google · verifikasi KTP · aman &amp; resmi</span></span>\n  </section>\n  <sc-if value=\"{{mtHas}}\"><section style=\"margin: 16px 16px 0; background: #FFFFFF; border-radius: 20px; padding: 16px; display: flex; flex-direction: column; gap: 10px\">\n    <div style=\"display: flex; justify-content: space-between; align-items: baseline; gap: 8px\"><b style=\"font-size: 16px\">Mitra Unggulan</b><span style=\"font-size: 12px; color: #5B6577\">{{mtMonth}}</span></div>\n    <div data-scrollx style=\"display: flex; gap: 10px; overflow-x: auto; scroll-snap-type: x mandatory; margin: 0 -16px; padding: 0 16px 4px\">\n      <sc-for list=\"{{mtList}}\" as=\"m\"><div style=\"flex: 0 0 68%; max-width: 240px; scroll-snap-align: start; background: #F6F7F9; border-radius: 14px; padding: 12px 14px; display: flex; flex-direction: column; gap: 4px\"><span style=\"font-size: 11px; font-weight: 800; color: #077A70\">{{m.badge}}</span><b style=\"font-size: 14px; line-height: 19px\">{{m.name}}</b><span style=\"font-size: 12px; color: #5B6577\">{{m.sub}}</span></div></sc-for>\n    </div>\n  </section></sc-if>\n  <a href=\"https://pokama.org/mitra\" target=\"_blank\" rel=\"noopener\" style=\"margin: 16px 16px 0; background: #FFFFFF; border-radius: 16px; padding: 14px 16px; display: flex; align-items: center; justify-content: space-between; gap: 12px; text-decoration: none; color: #1F2B4D\"><span style=\"font-size: 13px; line-height: 19px; color: #4A5468\">Punya hotel, villa, komunitas, atau kampus? Dapat komisi tiap tamu yang sewa.</span><b style=\"font-size: 14px; white-space: nowrap; color: #077A70\">Daftar jadi mitra →</b></a>\n  <a href=\"kredit-foto.html\" style=\"margin: 12px 16px 24px; font-size: 11px; color: #8A93A3; text-align: center\">Kredit foto produk</a>\n\n  <nav style=\"position: absolute; left: 0; right: 0; bottom: 0; height: 72px; background: #FFFFFF; border-top: 1px solid #E8EBEF; box-shadow: 0 -4px 16px rgba(31,43,77,0.06); display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); align-items: center; text-align: center; font-size: 11px; font-weight: 700; color: #5B6577\">\n    <a href=\"Home.dc.html\" aria-current=\"page\" style=\"text-decoration: none; color: #077A70; display: flex; flex-direction: column; align-items: center; gap: 3px\"><span style=\"width: 52px; height: 30px; border-radius: 15px; background: #E3F7F5; display: flex; align-items: center; justify-content: center\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#077A70\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 11l9-7 9 7\"/><path d=\"M5 10v10h14V10\"/><path d=\"M10 20v-5h4v5\"/></svg></span>Beranda</a>\n    <a href=\"Status.dc.html\" style=\"text-decoration: none; color: #8A93A3; display: flex; flex-direction: column; align-items: center; gap: 3px\"><span style=\"width: 52px; height: 30px; display: flex; align-items: center; justify-content: center\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#8A93A3\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"5\" y=\"3\" width=\"14\" height=\"18\" rx=\"2.5\"/><path d=\"M9 8h6M9 12h6M9 16h3\"/></svg></span>Pesanan</a>\n    <a href=\"Cari.dc.html\" style=\"text-decoration: none; color: #8A93A3; display: flex; flex-direction: column; align-items: center; gap: 3px\"><span style=\"width: 52px; height: 30px; display: flex; align-items: center; justify-content: center\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#8A93A3\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"M20 20l-3.5-3.5\"/></svg></span>Pencarian</a>\n    <a href=\"Akun.dc.html\" style=\"text-decoration: none; color: #8A93A3; display: flex; flex-direction: column; align-items: center; gap: 3px\"><span style=\"width: 52px; height: 30px; display: flex; align-items: center; justify-content: center\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#8A93A3\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6\"/></svg></span>Akun</a>\n  </nav>\n</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{\"$preview\":{\"width\":390,\"height\":2400}}'>\nclass Component extends DCLogic {\nstate = { branches: [], branch: null, popular: null, promos: [], bundles: [], free: null };\nasync componentDidMount() {\n  RA.branch().then(b => { if (RA_ALIVE(this) && b) { this._popB = b.id; this.loadPopular(b); } });\n  const [bs, branch, pr, bu] = await Promise.all([\n    RA.branches(), RA.branch(),\n    RA.from('auto_promos').select('key,rule,category_ids'),\n    RA.from('bundles').select('id,name,description,discount_percent,bundle_items(product_id,products(name,photos,product_prices(basis,price)))').eq('is_active', true)\n  ]);\n  if (!RA_ALIVE(this)) return;\n  this.setState({ branches: (bs || []).filter(b => b.kind !== 'experience' && b.accepts_online !== false), branch, promos: (pr && pr.data) || [], bundles: (bu && bu.data) || [] });\n  this.loadFree(branch);\n  if (!branch || this._popB !== branch.id) this.loadPopular();\n}\nasync loadPopular(b0) {\n  const b = b0 || this.state.branch; if (!b) { this.setState({ popular: [] }); return; }\n  const c = RA.ctx();\n  const { data } = await RA.rpc('catalog_list', { p_branch: b.id, p_start: c.start_at, p_end: c.end_at });\n  if (!RA_ALIVE(this)) return;\n  this.setState({ popular: (data || []).filter(p => p.units > 0 && p.category.line !== 'experience').slice(0, 4) });\n}\nloadFree(b) { RA.promoFree(b && b.id).then(f => { if (RA_ALIVE(this)) this.setState({ free: f }); }); }\npickBranch(id) {\n  const b = this.state.branches.find(x => x.id === id); if (!b) return;\n  RA.setCtx({ branch_id: b.id, cart: [] });\n  this.setState({ branch: b, popular: null }); this.loadPopular(); this.loadFree(b);\n}\nmitraTop() {\n  if (this._mt === undefined) { this._mt = null; RA.from('ra_mitra_featured').select('name,kind,city,rank,month').order('rank').limit(12).then(r => { this._mt = (r && r.data) || []; if (RA_ALIVE(this)) this.forceUpdate(); }, () => { this._mt = []; }); }\n  const L = this._mt || [], K = { penginapan: 'Penginapan', komunitas: 'Komunitas', kampus: 'Kampus', kreator: 'Kreator', travel: 'Travel' };\n  const m0 = L[0] && L[0].month ? String(L[0].month).split('-') : null;\n  return { mtHas: L.length > 0, mtMonth: m0 ? 'Bulan ' + (RA.BULAN ? RA.BULAN[+m0[1] - 1] : m0[1]) + ' ' + m0[0] : '',\n    mtList: L.map(m => ({ badge: (m.rank ? '#' + m.rank + ' ' : '') + (K[m.kind] || 'Mitra'), name: m.name, sub: m.city || '' })) };\n}\nrenderVals() {\n  const s = this.state, br = s.branch || {};\n  const CUT = ['honda-beat-cbs-new','honda-pcx','honda-scoopy-new','iphone-13','iphone-15','iphone-16','iphone-xr','lensa-sony-fe-28-70mm','proyektor-panasonic-vw355n','carrier-60l','sleeping-bag','tripod-tnw-s30'];\n  const pic = photos => { const p = (photos || [])[0] || ''; const m = String(p).match(/products\\/([^/]+)\\//); if (m && CUT.indexOf(m[1]) > -1) return { photo: 'img/p/' + m[1] + '.webp', fit: 'contain' }; if (/^\\/img\\/p\\//.test(p)) return { photo: p.slice(1), fit: 'contain' }; return { photo: RA.photo(photos), fit: 'cover' }; };\n  const k = n => n >= 1000 ? String(Math.round(n / 100) / 10).replace('.', ',') + 'rb' : String(n);\n  const rpS = v => 'Rp' + k(+v);\n  const unitTxt = { hari: '/hari', malam: '/malam', trip: '/trip', paket: '/paket', jam: '/jam' };\n  const popular = (s.popular || []).map(p => {\n    const pr = p.prices || {}, u = p.category.price_unit;\n    const base = u === 'malam' ? pr.night : u === 'trip' ? pr.trip : u === 'paket' ? pr.package : u === 'jam' ? pr.hour : pr.day;\n    const short = pr.two_hour != null ? '2 jam ' + rpS(pr.two_hour) : pr.half_day != null ? '½ hari ' + rpS(pr.half_day) : '';\n    const meta = (p.category.name || '') + (p.rent_count ? ' · disewa ' + RA.num(p.rent_count) + '×' : '');\n    return Object.assign({ name: p.name, href: 'Produk.dc.html?id=' + p.id, meta, short,\n      price: base != null ? rpS(base) : '—', unit: base != null ? (unitTxt[u] || '') : 'harga segera' }, pic(p.photos));\n  });\n  // Promo sewa X gratis Y — tampil hanya kalau aktif di sistem\n  // sumber tunggal: RA.promoFree (server promo_free) — sudah cek aktif, tanggal, cabang\n  const fp = s.free;\n  const fr = fp ? { tiers: fp.tiers, buy_days: fp.tiers[0].buy, free_days: fp.tiers[0].free } : {};\n  const freeOk = !!fp;\n  // Paket hemat — hanya yang aktif\n  const packs = s.bundles.map(b => {\n    const items = (b.bundle_items || []).map(i => i.products).filter(Boolean);\n    const pics = items.map(i => pic(i.photos)).filter(x => x.photo).map(x => x.photo).slice(0, 3);\n    const dayP = it => { const v = (it.product_prices || []).filter(x => x.basis === 'day' && x.price != null).map(x => +x.price); return v.length ? Math.min(...v) : null; };\n    const ps = items.map(dayP); const sum = ps.every(x => x != null) && ps.length ? ps.reduce((a, x) => a + x, 0) : 0;\n    const now = sum ? Math.round(sum * (100 - (+b.discount_percent || 0)) / 100) : 0;\n    const k = n => n >= 1e6 ? 'Rp' + String(Math.round(n / 1e4) / 100).replace('.', ',') + 'jt' : 'Rp' + Math.round(n / 1000) + 'rb';\n    return { name: b.name, isi: items.map(i => i.name).join(' + '), badge: 'HEMAT ' + (+b.discount_percent) + '%',\n      was: sum ? k(sum) : '', now: now && now < sum ? k(now) : '', save: now && now < sum ? k(sum - now) : '',\n      pics, href: 'Cari.dc.html' };\n  });\n  const tiers = s.promos.find(x => x.key === 'bundle_tiers');\n  if (tiers && tiers.rule && (tiers.rule.tiers || []).length) {\n    const t = tiers.rule.tiers, mx = Math.max.apply(null, t.map(x => x.percent));\n    packs.unshift({ name: 'Rombongan motor', isi: t.map(x => x.items + (x === t[t.length - 1] ? '+' : '') + ' motor ' + x.percent + '%').join(' · '),\n      badge: 'HEMAT S.D. ' + mx + '%', pics: ['img/p/honda-beat-cbs-new.webp', 'img/p/honda-pcx.webp', 'img/p/honda-scoopy-new.webp'], href: 'Katalog.dc.html?cat=motor' });\n  }\n  // Siapkan sebelum sewa\n  const docs = RA.setting('docs_required'), opts = (RA.setting('supporting_doc_options') || []).map(x => String(x).toUpperCase());\n  const or = a => a.length > 1 ? a.slice(0, -1).join(', ') + ', atau ' + a[a.length - 1] : a.join('');\n  const parts = [];\n  if (Array.isArray(docs) && docs.length) {\n    const hasK = docs.indexOf('ktp') > -1, hasP = docs.indexOf('pendukung') > -1;\n    let t = hasK ? 'KTP' : '';\n    if (hasP) t += (t ? ' + ' : '') + '1 dokumen pendukung' + (opts.length ? ' (' + or(opts) + ')' : '');\n    if (t) parts.push(t);\n  }\n  const dp = RA.setting('dp_percent');\n  let prep = parts.join(' · ');\n  if (prep && RA.setting('ktp_original_deposit') === true) prep += '. KTP asli dititipkan di cabang selama sewa';\n  const branchCards = s.branches.filter(b => b.address).map(b => {\n    const on = b.id === br.id;\n    return { name: b.name, addr: (b.address || '').split(',').slice(0, 2).join(','),\n      map: b.address ? 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent('Rentalaja ' + b.address) : '',\n      pinColor: on ? '#FFFFFF' : '#077A70',\n      pinStyle: 'width: 40px; height: 40px; border-radius: 20px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; background: ' + (on ? '#077A70' : '#E3F7F5'),\n      pick: () => this.pickBranch(b.id) };\n  });\n  return { ...this.mitraTop(),\n    branchName: br.name || 'Pilih cabang', branchId: br.id || '', branchOpts: s.branches.map(b => ({ id: b.id, name: b.name })),\n    pickBranch: e => this.pickBranch(e.target.value),\n    freeText: freeOk ? 'Sewa ' + ((fr.tiers || [])[0] ? fr.tiers[0].buy + fr.tiers[0].free : fr.buy_days + fr.free_days) + ' hari, cukup bayar ' + ((fr.tiers || [])[0] ? fr.tiers[0].buy : fr.buy_days) : '', freeSub: ((fr.tiers || []).slice(1).map(t => (t.buy + t.free) + ' hari bayar ' + t.buy + ' · ').join('')) + ((fp && fp.scope) || '') + ' →', freeDays: fr.free_days || 1,\n    popular, popEmpty: s.popular && !s.popular.length ? 'Belum ada barang yang bisa disewa di cabang ' + (br.name || 'ini') + '. Coba pilih cabang lain.' : '',\n    hasPacks: packs.length > 0, packs,\n    antarOn: !!br.delivery_enabled, antarSub: 'Pilih \"Diantar\" saat checkout →',\n    memTitle: (() => { const T = (RA.setting('member_tiers') || {}).tiers || []; const mx = Math.max(0, ...T.map(t => +t.percent || 0)); return mx ? 'Jadi member, hemat sampai ' + mx + '% tiap sewa' : 'Jadi member, dapat diskon tiap sewa'; })(),\n    memSub: (() => { const T = ((RA.setting('member_tiers') || {}).tiers || []).slice().sort((a, b) => a.min - b.min); return T[0] ? 'Mulai ' + T[0].min + 'x sewa, otomatis →' : 'Daftar gratis →'; })(),\n    step2: dp != null ? 'Verifikasi KTP, DP ' + dp + '%' : 'Verifikasi KTP',\n    prepText: prep, branchCards\n  };\n}\n}\n</script>\n</body>\n</html>\n"}