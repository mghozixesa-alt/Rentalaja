{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Kalender unit</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0}\nbutton{font-family:inherit}\nbutton:disabled{opacity:.55;cursor:not-allowed}\n[data-aui]{min-height:100vh;box-sizing:border-box;background:#F4F6F9;color:#1F2B4D;font-family:'Plus Jakarta Sans',system-ui,sans-serif}\n[data-in]{max-width:1240px;margin:0 auto;box-sizing:border-box;padding:14px 16px 24px;display:flex;flex-direction:column;gap:12px}\n[data-card]{background:#FFFFFF;border-radius:16px;box-shadow:0 1px 3px rgba(31,43,77,.07);padding:14px;display:flex;flex-direction:column;gap:10px}\n[data-mut]{font-size:12px;color:#5B6577}\n[data-seg]{display:flex;flex-wrap:wrap;gap:6px;align-items:center}\n[data-seg] button{height:34px;padding:0 12px;border-radius:17px;border:1px solid #D5D9E0;background:#FFFFFF;color:#1F2B4D;font:700 13px 'Plus Jakarta Sans',sans-serif;cursor:pointer}\n[data-seg] button[aria-pressed=\"true\"]{background:#1F2B4D;border-color:#1F2B4D;color:#FFFFFF}\nselect,input[type=date],input[type=text],textarea{height:40px;width:100%;box-sizing:border-box;border:1px solid #D5D9E0;border-radius:11px;padding:0 12px;font:500 14px 'Plus Jakarta Sans',sans-serif;color:#1F2B4D;background:#FFFFFF}\ntextarea{height:80px;padding:10px 12px}\n[data-btn]{height:40px;padding:0 14px;border-radius:11px;border:0;font:800 13px 'Plus Jakarta Sans',sans-serif;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:6px;text-decoration:none;white-space:nowrap}\n[data-cal]{--lw:118px;--cw:46px;overflow-x:auto;background:#FFFFFF;border-radius:16px;box-shadow:0 1px 3px rgba(31,43,77,.07);position:relative}\n[data-cal][data-v=\"14\"]{--cw:40px}\n[data-cal][data-v=\"31\"]{--cw:30px}\n[data-crow]{display:flex;min-width:calc(var(--lw) + var(--n) * var(--cw));border-top:1px solid #EEF0F3}\n[data-crow]:first-child{border-top:0}\n[data-lab]{position:sticky;left:0;z-index:2;width:var(--lw);flex:0 0 var(--lw);box-sizing:border-box;padding:6px 8px 6px 12px;background:#FFFFFF;border-right:1px solid #EEF0F3;display:flex;flex-direction:column;justify-content:center;min-height:46px;text-decoration:none;color:#1F2B4D;cursor:pointer;border-top:0;border-bottom:0;border-left:0;text-align:left;font:inherit}\n[data-lab] b{font-size:12px;line-height:15px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n[data-lab] span{font-size:10.5px;color:#5B6577;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n[data-track]{position:relative;flex:0 0 calc(var(--n) * var(--cw));width:calc(var(--n) * var(--cw));background-image:repeating-linear-gradient(90deg,transparent 0,transparent calc(var(--cw) - 1px),#F1F3F6 calc(var(--cw) - 1px),#F1F3F6 var(--cw))}\n[data-dh]{display:flex;flex:0 0 calc(var(--n) * var(--cw))}\n[data-dh] div{flex:0 0 var(--cw);width:var(--cw);text-align:center;padding:6px 0;font-size:10.5px;color:#5B6577;line-height:13px;box-sizing:border-box}\n[data-dh] div b{display:block;font-size:13px;color:#1F2B4D}\n[data-bar]{position:absolute;border-radius:6px;font-size:10.5px;font-weight:700;line-height:16px;padding:0 5px;box-sizing:border-box;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;cursor:pointer;border:0;text-align:left;font-family:inherit}\n[data-legend]{display:flex;flex-wrap:wrap;gap:12px;font-size:11.5px;color:#5B6577}\n[data-legend] i{display:inline-block;width:14px;height:10px;border-radius:3px;margin-right:5px;vertical-align:-1px}\n[data-sheet]{position:fixed;inset:0;z-index:80;background:rgba(31,43,77,.45);display:flex;align-items:flex-end;justify-content:center}\n[data-sheet] > div{width:100%;max-width:480px;background:#FFFFFF;border-radius:20px 20px 0 0;padding:16px;box-sizing:border-box;display:flex;flex-direction:column;gap:12px;max-height:90vh;overflow-y:auto}\n[data-sheet] label{display:flex;flex-direction:column;gap:5px;font-size:12px;font-weight:700;color:#4A5468}\n@media (min-width:1000px){\n  [data-in]{padding:20px 24px 32px}\n  [data-cal]{--lw:220px;--cw:110px}\n  [data-cal][data-v=\"14\"]{--cw:60px}\n  [data-cal][data-v=\"31\"]{--cw:34px}\n  [data-lab] b{font-size:13px}\n  [data-sheet]{align-items:center}\n  [data-sheet] > div{border-radius:20px}\n}\n@media print{[data-sheet],[data-noprint]{display:none !important}[data-cal]{overflow:visible}}\n</style>\n</helmet>\n<div data-aui=\"1\"><div data-in=\"1\">\n  <div style=\"display: flex; justify-content: space-between; align-items: flex-end; gap: 10px; flex-wrap: wrap\">\n    <div><div style=\"font-size: 20px; font-weight: 800\">Kalender</div><div data-mut=\"1\">{{rangeTxt}}</div></div>\n    <button type=\"button\" data-btn=\"1\" data-noprint=\"1\" onClick=\"{{openSched}}\" style=\"background: #09BEAF; color: #1F2B4D\">+ Jadwalkan servis</button>\n  </div>\n  <div data-card=\"1\" data-noprint=\"1\" style=\"padding: 12px\">\n    <div data-seg=\"1\"><button type=\"button\" onClick=\"{{prev}}\" aria-label=\"Sebelumnya\" style=\"width: 36px; padding: 0\">‹</button><button type=\"button\" onClick=\"{{today}}\">Hari ini</button><button type=\"button\" onClick=\"{{next}}\" aria-label=\"Berikutnya\" style=\"width: 36px; padding: 0\">›</button><span style=\"width: 6px\"></span><sc-for list=\"{{views}}\" as=\"v\"><button type=\"button\" aria-pressed=\"{{v.on}}\" onClick=\"{{v.pick}}\">{{v.label}}</button></sc-for></div>\n    <div style=\"display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px\"><select aria-label=\"Kategori\" onChange=\"{{setCat}}\"><sc-for list=\"{{catOpts}}\" as=\"o\"><option value=\"{{o.k}}\">{{o.label}}</option></sc-for></select><select aria-label=\"Cabang\" onChange=\"{{setBr}}\"><sc-for list=\"{{brOpts}}\" as=\"o\"><option value=\"{{o.k}}\">{{o.label}}</option></sc-for></select></div>\n  </div>\n  <div style=\"display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px\"><sc-for list=\"{{kpi}}\" as=\"k\"><div style=\"background: #FFFFFF; border-radius: 12px; padding: 10px 12px; box-shadow: 0 1px 3px rgba(31,43,77,.07); min-width: 0\"><div style=\"font-size: 18px; font-weight: 800; color: {{k.c}}\">{{k.v}}</div><div data-mut=\"1\" style=\"font-size: 11px\">{{k.l}}</div></div></sc-for></div>\n  <div data-legend=\"1\"><span><i style=\"background: #1F2B4D\"></i>Disewa</span><span><i style=\"background: #8FA3C8\"></i>Dibooking</span><span><i style=\"background: #F0A43A\"></i>Servis</span><span><i style=\"background: repeating-linear-gradient(135deg,#F0A43A 0 4px,#FFE3B8 4px 8px)\"></i>Servis terjadwal (unit dikunci)</span><span><i style=\"background: #FFFFFF; box-shadow: inset 0 0 0 2px #E5534B\"></i>Bentrok</span></div>\n  <sc-if value=\"{{loading}}\"><div data-card=\"1\" style=\"text-align: center; color: #5B6577; font-size: 14px\">Memuat kalender…</div></sc-if>\n  <sc-if value=\"{{err}}\"><div data-card=\"1\" style=\"text-align: center; color: #A12A1F; font-size: 14px\">{{err}}</div></sc-if>\n  <sc-if value=\"{{empty}}\"><div data-card=\"1\" style=\"text-align: center; color: #5B6577; font-size: 14px\">{{empty}}</div></sc-if>\n  <sc-if value=\"{{hasRows}}\"><div data-cal=\"1\" data-v=\"{{n}}\" style=\"--n: {{n}}\">\n    <div data-crow=\"1\" style=\"position: sticky; top: 0; z-index: 3; background: #FFFFFF; border-bottom: 1px solid #E1E4EA\"><div data-lab=\"1\" style=\"cursor: default; min-height: 40px\"><b>{{unitCount}}</b></div><div data-dh=\"1\"><sc-for list=\"{{days}}\" as=\"dd\"><div style=\"{{dd.style}}\">{{dd.w}}<b>{{dd.d}}</b></div></sc-for></div></div>\n    <sc-for list=\"{{rows}}\" as=\"r\"><div data-crow=\"1\">\n      <button type=\"button\" data-lab=\"1\" onClick=\"{{r.open}}\"><b>{{r.title}}</b><span>{{r.sub}}</span></button>\n      <div data-track=\"1\"><sc-if value=\"{{todayL}}\"><div style=\"position: absolute; top: 0; bottom: 0; left: {{todayL}}; width: 2px; background: #09BEAF; opacity: .55\"></div></sc-if><sc-for list=\"{{r.bars}}\" as=\"b\"><button type=\"button\" data-bar=\"1\" onClick=\"{{b.go}}\" title=\"{{b.tip}}\" style=\"{{b.style}}\">{{b.txt}}</button></sc-for></div>\n    </div></sc-for>\n  </div></sc-if>\n  <sc-if value=\"{{more}}\"><div data-mut=\"1\" style=\"text-align: center\">{{more}}</div></sc-if>\n</div>\n\n<sc-if value=\"{{sh}}\"><div data-sheet=\"1\"><div>\n  <div style=\"display: flex; justify-content: space-between; align-items: flex-start; gap: 10px\"><div><div data-mut=\"1\">{{sh.sub}}</div><b style=\"font-size: 17px\">{{sh.title}}</b></div><button type=\"button\" onClick=\"{{closeSh}}\" aria-label=\"Tutup\" style=\"width: 34px; height: 34px; border-radius: 17px; border: 0; background: #EEF0F3; font-size: 16px; cursor: pointer\">✕</button></div>\n  <sc-for list=\"{{sh.lines}}\" as=\"l\"><div style=\"display: flex; justify-content: space-between; gap: 10px; font-size: 13.5px; padding: 6px 0; border-top: 1px solid #EEF0F3\"><span data-mut=\"1\" style=\"font-size: 13px\">{{l.k}}</span><b style=\"text-align: right\">{{l.v}}</b></div></sc-for>\n  <sc-if value=\"{{sh.warn}}\"><div style=\"background: #FDECEA; color: #A12A1F; border-radius: 10px; padding: 9px 11px; font-size: 13px; line-height: 18px\">{{sh.warn}}</div></sc-if>\n  <sc-if value=\"{{sh.form}}\">\n    <label>Unit<select onChange=\"{{sh.setUnit}}\"><sc-for list=\"{{sh.unitOpts}}\" as=\"o\"><option value=\"{{o.k}}\">{{o.label}}</option></sc-for></select></label>\n    <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 8px\"><label>Mulai<input type=\"date\" value=\"{{sh.v.s}}\" onInput=\"{{sh.setS}}\"></label><label>Sampai<input type=\"date\" value=\"{{sh.v.e}}\" onInput=\"{{sh.setE}}\"></label></div>\n    <label>Pekerjaan servis<textarea placeholder=\"mis. ganti oli + kampas rem\" onInput=\"{{sh.setNote}}\">{{sh.v.note}}</textarea><span style=\"font-weight: 500; color: #8A93A6\">Selama tanggal ini unit dikunci dan tidak bisa dibooking. Servis otomatis masuk Papan servis.</span></label>\n  </sc-if>\n  <div style=\"display: flex; gap: 8px; flex-wrap: wrap\"><sc-for list=\"{{sh.acts}}\" as=\"a\"><sc-if value=\"{{a.href}}\"><a data-btn=\"1\" href=\"{{a.href}}\" style=\"flex: 1; background: {{a.bg}}; color: {{a.fg}}\">{{a.label}}</a></sc-if><sc-if value=\"{{a.go}}\"><button type=\"button\" data-btn=\"1\" onClick=\"{{a.go}}\" disabled=\"{{sh.busy}}\" style=\"flex: 1; background: {{a.bg}}; color: {{a.fg}}\">{{a.label}}</button></sc-if></sc-for></div>\n</div></div></sc-if>\n</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{\"$preview\":{\"width\":390,\"height\":844}}'>\nclass Component extends DCLogic {\nstate = { v: 14, from: null, cat: 'motor', br: '', d: null, err: '', sh: null, lim: 120 };\nymd(dt) { const x = new Date(dt.getTime() + 7 * 36e5); return x.toISOString().slice(0, 10); }\njday() { return this.ymd(new Date()); }\naddD(s, n) { const x = new Date(s + 'T00:00:00Z'); x.setUTCDate(x.getUTCDate() + n); return x.toISOString().slice(0, 10); }\nasync componentDidMount() {\n  await RA.staff(); const p = RA.params(); const t = this.jday();\n  this.setState({ from: this.addD(t, -1), cat: p.cat != null ? p.cat : 'motor', br: p.br || '' });\n  await this.reload();\n}\nasync reload() {\n  const s = this.state; if (!s.from) return; const to = this.addD(s.from, s.v - 1);\n  this.setState({ err: '' });\n  try { const d = await RA.call('asset_calendar', { p_from: s.from, p_to: to, p_cat: s.cat || null, p_branch: s.br || null }); if (RA_ALIVE(this)) this.setState({ d, lim: 120 }); }\n  catch (e) { if (RA_ALIVE(this)) this.setState({ err: (e && e.message) || 'Gagal memuat kalender' }); }\n}\nset(o) { this.setState(Object.assign({ d: null }, o)); setTimeout(() => this.reload(), 0); }\nasync swap(e) {\n  if (!confirm('Pindahkan booking ' + e.code + ' ke unit lain yang siap di jadwal yang sama?')) return;\n  this.setState({ sh: Object.assign({}, this.state.sh, { busy: true }) });\n  try { const r = await RA.call('asset_swap_unit', { p_item: e.item_id }); RA.ok('Booking ' + r.booking + ' dipindah ke ' + r.to); this.setState({ sh: null }); this.reload(); }\n  catch (er) { RA.err(er); if (this.state.sh) this.setState({ sh: Object.assign({}, this.state.sh, { busy: false }) }); }\n}\nasync unsched(e) {\n  if (!confirm('Batalkan servis terjadwal ini? Unit kembali bisa dibooking di tanggal itu.')) return;\n  try { await RA.call('asset_unschedule', { p_block: e.block }); RA.ok('Jadwal servis dibatalkan'); this.setState({ sh: null }); this.reload(); } catch (er) { RA.err(er); }\n}\nasync sched() {\n  const sh = this.state.sh, v = sh.v; this.setState({ sh: Object.assign({}, sh, { busy: true, warn: '' }) });\n  try { await RA.call('asset_schedule_service', { p_unit: v.unit, p_start: v.s, p_end: v.e, p_note: v.note }); RA.ok('Servis dijadwalkan — tanggalnya dikunci'); this.setState({ sh: null }); this.reload(); }\n  catch (er) { if (this.state.sh) this.setState({ sh: Object.assign({}, this.state.sh, { busy: false, warn: (er && er.message) || 'Gagal' }) }); }\n}\nopenSched(unitId) {\n  const units = (this.state.d && this.state.d.units) || []; const t = this.jday();\n  this.setState({ sh: { kind: 'sched', v: { unit: unitId || (units[0] || {}).id || '', s: this.addD(t, 1), e: this.addD(t, 1), note: '' }, busy: false, warn: '' } });\n}\nrenderVals() {\nconst s = this.state, d = s.d, now = new Date(); const NAVY = '#1F2B4D', RED = '#A12A1F', AMB = '#8A4B00', TEAL = '#077A70';\nconst from = s.from || this.jday(), n = s.v; const a = new Date(from + 'T00:00:00+07:00').getTime(), z = a + n * 864e5, span = z - a;\nconst HR = ['Min', 'Sen', 'Sel', 'Rab', 'Kam', 'Jum', 'Sab'], BL = (RA.BULAN || []).map(x => x.slice(0, 3));\nconst days = []; for (let i = 0; i < n; i++) { const dt = new Date(a + i * 864e5 + 7 * 36e5); const isT = this.ymd(new Date(a + i * 864e5)) === this.jday(); const we = dt.getUTCDay() === 0 || dt.getUTCDay() === 6;\n  days.push({ w: n > 14 ? HR[dt.getUTCDay()].slice(0, 1) : HR[dt.getUTCDay()], d: String(dt.getUTCDate()), style: isT ? 'background: #E3F7F5; color: #077A70; font-weight: 800' : we ? 'background: #FAFBFC' : '' }); }\nconst pct = t => Math.max(0, Math.min(100, (t - a) / span * 100));\nconst tl = now.getTime() > a && now.getTime() < z ? pct(now.getTime()).toFixed(2) + '%' : '';\nconst fmt = x => RA.dayTime ? RA.dayTime(x) : String(x);\nlet rows = [], nSewa = 0, nSvc = 0, nConf = 0, nBlk = 0;\nif (d) {\n  rows = d.units.map(u => {\n    const ev = u.ev || []; const busy = ev.filter(e => e.t !== 'sewa').map(e => [new Date(e.s).getTime(), new Date(e.e).getTime()]);\n    const bars = ev.map(e => { const s0 = new Date(e.s).getTime(), e0 = new Date(e.e).getTime(); if (e0 <= a || s0 >= z) return null;\n      const L = pct(s0), W = Math.max(pct(e0) - L, 100 / n / 3);\n      if (e.t === 'sewa') { const conf = (e.st === 'held' || e.st === 'confirmed') && busy.some(([bs, be]) => bs < e0 && be > s0); nSewa++; if (conf) nConf++;\n        const bg = e.st === 'active' ? NAVY : e.st === 'returned' ? '#B4BCC8' : '#8FA3C8';\n        return { style: 'left: ' + L + '%; width: ' + W + '%; top: 5px; height: 18px; background: ' + (conf ? '#FDECEA' : bg) + '; color: ' + (conf ? RED : '#FFFFFF') + (conf ? '; box-shadow: inset 0 0 0 2px #E5534B' : ''), txt: (conf ? '⚠ ' : '') + (e.guest || e.code), tip: e.code + ' · ' + (e.guest || ''), go: () => this.setState({ sh: { kind: 'sewa', e, u, conf } }) }; }\n      if (e.t === 'blok') { nBlk++; return { style: 'left: ' + L + '%; width: ' + W + '%; top: 26px; height: 15px; background: repeating-linear-gradient(135deg,#F0A43A 0 6px,#FFE3B8 6px 12px); color: #5A3200', txt: e.note || 'Servis terjadwal', tip: 'Servis terjadwal: ' + (e.note || ''), go: () => this.setState({ sh: { kind: 'blok', e, u } }) }; }\n      nSvc++; return { style: 'left: ' + L + '%; width: ' + W + '%; top: 26px; height: 15px; background: ' + (e.late ? '#E5534B' : '#F0A43A') + '; color: #FFFFFF', txt: e.code, tip: e.code + ' · ' + (e.note || ''), go: () => this.setState({ sh: { kind: 'servis', e, u } }) };\n    }).filter(Boolean);\n    return { id: u.id, title: u.name, sub: [u.code, u.branch].filter(Boolean).join(' · '), bars, conf: bars.some(b => b.txt.indexOf('⚠') === 0), open: () => { location.hash = '#/AsetUnit?id=' + u.id; } };\n  });\n  rows.sort((x, y) => (y.conf - x.conf) || (y.bars.length > 0) - (x.bars.length > 0));\n}\nconst cats = d ? d.cats : [], brs = d ? d.branches : [];\nconst first = (arr, k) => arr.filter(o => o.k === k).concat(arr.filter(o => o.k !== k));\nconst catOpts = first([{ k: '', label: 'Semua kategori' }].concat(cats.map(c => ({ k: c.slug, label: c.n }))), s.cat || '');\nconst brOpts = first([{ k: '', label: 'Semua cabang' }].concat(brs.map(b => ({ k: b.id, label: b.n }))), s.br || '');\nconst toD = this.addD(from, n - 1), fD = new Date(from + 'T00:00:00Z'), tD = new Date(toD + 'T00:00:00Z');\nconst o = { views: [[7, 'Minggu'], [14, '2 minggu'], [31, 'Bulan']].map(([k, l]) => ({ label: l, on: s.v === k ? 'true' : 'false', pick: () => this.set({ v: k }) })),\n  prev: () => this.set({ from: this.addD(from, -Math.max(7, Math.floor(n / 2))) }), next: () => this.set({ from: this.addD(from, Math.max(7, Math.floor(n / 2))) }), today: () => this.set({ from: this.addD(this.jday(), -1) }),\n  rangeTxt: fD.getUTCDate() + ' ' + BL[fD.getUTCMonth()] + ' – ' + tD.getUTCDate() + ' ' + BL[tD.getUTCMonth()] + ' ' + tD.getUTCFullYear() + ' · sewa & servis per unit',\n  catOpts, brOpts, setCat: e => this.set({ cat: e.target.value }), setBr: e => this.set({ br: e.target.value }),\n  kpi: [[d ? String(d.units.length) : '—', 'unit', NAVY], [String(nSewa), 'sewa di periode ini', NAVY], [String(nSvc + nBlk), 'servis (' + nBlk + ' terjadwal)', AMB], [String(nConf), 'booking bentrok', nConf ? RED : TEAL]].map(([v, l, c]) => ({ v, l, c })),\n  loading: !d && !s.err, err: s.err, empty: d && !rows.length ? 'Tidak ada unit di pilihan ini.' : '', hasRows: rows.length > 0,\n  n: String(n), days, todayL: tl, unitCount: d ? d.units.length + ' unit' : '', rows: rows.slice(0, s.lim), more: rows.length > s.lim ? 'Menampilkan ' + s.lim + ' dari ' + rows.length + ' unit — pilih kategori atau cabang' : '',\n  openSched: () => this.openSched(), closeSh: () => this.setState({ sh: null }), sh: null };\nif (s.sh) {\n  const sh = s.sh, e = sh.e || {}, u = sh.u || {};\n  if (sh.kind === 'sewa') o.sh = { title: (e.guest || 'Pelanggan') + ' · ' + e.code, sub: u.name + ' · ' + u.code, lines: [{ k: 'Mulai', v: fmt(e.s) }, { k: 'Selesai', v: fmt(e.e) }, { k: 'Status', v: { held: 'Dibooking (belum bayar)', confirmed: 'Dikonfirmasi', active: 'Sedang disewa', returned: 'Sudah kembali' }[e.st] || e.st }],\n    warn: sh.conf ? 'Unit ini sedang/akan diservis di tanggal yang sama. Ganti ke unit lain yang siap supaya pelanggan tidak kecewa.' : '',\n    acts: [].concat((e.st === 'held' || e.st === 'confirmed') && e.item_id ? [{ label: 'Ganti unit', go: () => this.swap(e), bg: sh.conf ? '#09BEAF' : '#EEF0F3', fg: NAVY }] : [], [{ label: 'Buka unit', href: 'AsetUnit.dc.html?id=' + u.id, bg: NAVY, fg: '#FFFFFF' }]) };\n  if (sh.kind === 'servis') o.sh = { title: 'Servis ' + e.code, sub: u.name + ' · ' + u.code, lines: [{ k: 'Masuk', v: fmt(e.s) }, { k: 'Target / selesai', v: fmt(e.e) }, { k: 'Status', v: { queued: 'Antre', working: 'Dikerjakan', waiting_part: 'Tunggu part', qc: 'QC', done: 'Selesai' }[e.st] || e.st }, { k: 'Pekerjaan', v: e.note || '—' }],\n    warn: e.late ? 'Servis lewat target.' : '', acts: [{ label: 'Buka unit', href: 'AsetUnit.dc.html?id=' + u.id, bg: '#EEF0F3', fg: NAVY }, { label: 'Papan servis', href: 'AsetServis.dc.html', bg: NAVY, fg: '#FFFFFF' }] };\n  if (sh.kind === 'blok') o.sh = { title: 'Servis terjadwal', sub: u.name + ' · ' + u.code, lines: [{ k: 'Mulai', v: fmt(e.s) }, { k: 'Sampai', v: fmt(e.e) }, { k: 'Pekerjaan', v: e.note || '—' }, { k: 'Efek', v: 'Unit tidak bis