ontent: center\">{{nav.approvals}}</span></sc-if></a><a href=\"KeuProfitFirst.dc.html\" style=\"min-height: 40px; box-sizing: border-box; padding: 0 12px; border-radius: 10px; background: transparent; color: #1F2B4D; font: 600 14px 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; align-items: center; gap: 10px; text-decoration: none\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4A5468\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 20V10M10 20V4M16 20v-7M22 20H2\"/></svg><span>Profit First</span></a><a href=\"KeuArusKas.dc.html\" style=\"min-height: 40px; box-sizing: border-box; padding: 0 12px; border-radius: 10px; background: transparent; color: #1F2B4D; font: 600 14px 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; align-items: center; gap: 10px; text-decoration: none\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4A5468\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"6\" width=\"18\" height=\"13\" rx=\"2\"/><path d=\"M3 10h18M16 14.5h2\"/><path d=\"M6 6l9-3 1.5 3\"/></svg><span>Proyeksi kas</span></a><a href=\"KeuAnggaran.dc.html\" style=\"min-height: 40px; box-sizing: border-box; padding: 0 12px; border-radius: 10px; background: transparent; color: #1F2B4D; font: 600 14px 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; align-items: center; gap: 10px; text-decoration: none\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4A5468\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 20V10M10 20V4M16 20v-7M22 20H2\"/></svg><span>Anggaran</span></a><a href=\"KeuUtang.dc.html\" style=\"min-height: 40px; box-sizing: border-box; padding: 0 12px; border-radius: 10px; background: transparent; color: #1F2B4D; font: 600 14px 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; align-items: center; gap: 10px; text-decoration: none\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4A5468\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"/><path d=\"M3 10h18M7 15h4\"/></svg><span>Utang leasing</span></a><a href=\"KeuGaji.dc.html\" aria-current=\"page\" style=\"min-height: 40px; box-sizing: border-box; padding: 0 12px; border-radius: 10px; background: #E3F7F5; color: #1F2B4D; font: 800 14px 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; align-items: center; gap: 10px; text-decoration: none\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1F2B4D\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"9\" cy=\"8\" r=\"3.5\"/><path d=\"M2.5 20c1-3.5 3.5-5.5 6.5-5.5s5.5 2 6.5 5.5\"/><path d=\"M16 4.5a3.5 3.5 0 0 1 0 7M18.5 14.5c1.6.8 2.6 2.6 3 5.5\"/></svg><span>Penggajian</span></a><a href=\"KeuKomisi.dc.html\" style=\"min-height: 40px; box-sizing: border-box; padding: 0 12px; border-radius: 10px; background: transparent; color: #1F2B4D; font: 600 14px 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; align-items: center; gap: 10px; text-decoration: none\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4A5468\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"9\" cy=\"8\" r=\"3.5\"/><path d=\"M2.5 20c1-3.5 3.5-5.5 6.5-5.5s5.5 2 6.5 5.5\"/><path d=\"M16 4.5a3.5 3.5 0 0 1 0 7M18.5 14.5c1.6.8 2.6 2.6 3 5.5\"/></svg><span>Komisi staf</span></a><a href=\"KeuTutupBuku.dc.html\" style=\"min-height: 40px; box-sizing: border-box; padding: 0 12px; border-radius: 10px; background: transparent; color: #1F2B4D; font: 600 14px 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; align-items: center; gap: 10px; text-decoration: none\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4A5468\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"4\" y=\"5\" width=\"16\" height=\"15\" rx=\"2\"/><path d=\"M8 3v4M16 3v4M4 10h16\"/></svg><span>Tutup buku</span></a></div></nav>\n  <div style=\"margin-top: auto; display: flex; align-items: center; gap: 10px; padding-top: 16px; border-top: 1px solid #E6E8EC\">\n    <div style=\"width: 36px; height: 36px; border-radius: 18px; background: #1F2B4D; color: #09BEAF; font-size: 13px; font-weight: 800; display: flex; align-items: center; justify-content: center; flex-shrink: 0\">{{nav.initials}}</div>\n    <div style=\"display: flex; flex-direction: column\"><span style=\"font-size: 13px; font-weight: 700\">{{nav.name}}</span><span style=\"font-size: 12px; color: #4A5468\">{{nav.roleLine}}</span></div>\n  </div>\n</aside>\n<main style=\"flex: 999 1 560px; min-width: 0; box-sizing: border-box; padding: 24px 28px 40px; display: flex; flex-direction: column; gap: 20px\">\n<details data-wa-share open=\"{{share.open}}\" onToggle=\"{{share.toggle}}\" style=\"background: #FFFFFF; border: 1px solid #E6E8EC; border-radius: 14px\">\n<summary style=\"list-style: none; cursor: pointer; display: flex; flex-wrap: wrap; gap: 10px; align-items: center; justify-content: space-between; padding: 8px 10px 8px 14px\">\n  <span style=\"font-size: 13px; color: #4A5468\">Laporan <b style=\"color: #1F2B4D\">{{share.title}}</b> · {{share.schedText}} ke {{share.to}}</span>\n  <span style=\"display: inline-flex; align-items: center; gap: 8px; height: 36px; padding: 0 14px; border-radius: 10px; background: #09BEAF; color: #1F2B4D; font-size: 14px; font-weight: 800\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 12a8 8 0 0 1-11.8 7L4 20l1.1-4A8 8 0 1 1 20 12z\"/><path d=\"M9 9.5c0 2.5 2 5 5 5.5l1.2-1.2-1.6-.9-.8.6c-1-.4-1.8-1.2-2.2-2.2l.6-.8-.9-1.6z\"/></svg>Bagikan ke WhatsApp</span>\n</summary>\n<div style=\"display: flex; flex-wrap: wrap; gap: 16px; padding: 4px 14px 16px; border-top: 1px solid #E6E8EC\">\n  <div style=\"flex: 1 1 340px; background: #E7F3EE; border-radius: 12px; padding: 12px; margin-top: 12px\"><div style=\"background: #FFFFFF; border-radius: 10px; padding: 10px 12px; font-size: 13.5px; line-height: 20px; box-shadow: 0 1px 1px rgba(0,0,0,0.08)\"><b>{{share.title}}</b> · Rentalaja<sc-for list=\"{{share.lines}}\" as=\"l\"><br>• {{l.t}}</sc-for><br><br>Rincian lengkap bisa dibuka di panel Keuangan (perlu login).</div></div>\n  <div style=\"flex: 1 1 360px; display: flex; flex-direction: column; gap: 10px; margin-top: 12px\">\n    <div style=\"display: flex; flex-direction: column; gap: 6px\"><span style=\"font-size: 12px; font-weight: 700; color: #4A5468\">Penerima</span><div style=\"display: flex; flex-wrap: wrap; gap: 6px\"><sc-for list=\"{{share.recipients}}\" as=\"r\"><span style=\"display: inline-flex; align-items: center; height: 30px; padding: 0 10px; border-radius: 15px; font-size: 12px; font-weight: 800; border: 1.5px solid #1F2B4D; background: #E3F7F5; color: #1F2B4D\">{{r.name}}</span></sc-for><span style=\"display: inline-flex; align-items: center; height: 30px; padding: 0 10px; border-radius: 15px; font-size: 12px; font-weight: 700; border: 1px solid #D5D9E0; background: #FFFFFF; color: #1F2B4D; cursor: pointer\" onClick=\"{{share.addRecipient}}\">+ Tambah penerima</span></div></div>\n    <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 10px\">\n      <label style=\"display: flex; flex-direction: column; gap: 4px; font-size: 12px; font-weight: 700; color: #4A5468\">Jadwal kirim<select onChange=\"{{share.setSched}}\" value=\"{{share.sched}}\" style=\"height: 40px; border: 1px solid #D5D9E0; border-radius: 10px; padding: 0 10px; font: 600 13px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; background: #FFFFFF\"><option value=\"daily 07:00\">Harian 07.00</option><option value=\"\">Tidak terjadwal</option><option value=\"weekly mon 07:00\">Mingguan · Senin 07.00</option><option value=\"monthly 1 07:00\">Bulanan · tanggal 1</option></select></label>\n      <label style=\"display: flex; flex-direction: column; gap: 4px; font-size: 12px; font-weight: 700; color: #4A5468\">Isi<select onChange=\"{{share.setContent}}\" value=\"{{share.content}}\" style=\"height: 40px; border: 1px solid #D5D9E0; border-radius: 10px; padding: 0 10px; font: 600 13px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; background: #FFFFFF\"><option value=\"summary_link\">Ringkasan + link PDF</option><option value=\"summary\">Ringkasan saja</option><option value=\"summary_chart\">Ringkasan + gambar grafik</option></select></label>\n    </div>\n    <div style=\"font-size: 12px; line-height: 18px; color: #4A5468\">Laporan keuangan hanya bisa dikirim ke nomor owner dan keuangan yang terdaftar, dan tidak bisa dibagikan ke grup.</div>\n    <div style=\"display: flex; gap: 8px; flex-wrap: wrap\"><button type=\"button\" onClick=\"{{share.send}}\" disabled=\"{{share.busy}}\" style=\"height: 44px; padding: 0 16px; border-radius: 10px; border: none; background: #09BEAF; color: #1F2B4D; font: 800 14px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">Kirim sekarang</button><button type=\"button\" onClick=\"{{share.save}}\" disabled=\"{{share.busy}}\" style=\"height: 44px; padding: 0 16px; border-radius: 10px; border: 1px solid #D5D9E0; background: #FFFFFF; color: #1F2B4D; font: 700 14px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">Simpan jadwal</button></div>\n  </div>\n</div>\n</details>\n<header style=\"display: flex; flex-wrap: wrap; gap: 12px; justify-content: space-between; align-items: flex-end\">\n  <div style=\"display: flex; flex-direction: column; gap: 6px; max-width: 860px\"><sc-if value=\"{{err}}\"><span style=\"font-size: 12px; font-weight: 800; color: #8A4B00; background: #FFF1D6; border-radius: 6px; padding: 3px 8px; align-self: flex-start\">{{err}}</span></sc-if><h1 style=\"margin: 0; font-size: 28px; line-height: 34px; font-weight: 800; letter-spacing: -0.01em\">Penggajian</h1><div style=\"font-size: 14px; line-height: 20px; color: #4A5468\">Slip gaji bulanan dari data yang sudah ada: absen, komisi staf, lembur dari work order, potongan selisih kas, dan kasbon. Keuangan memeriksa, owner menyetujui, slip dikirim ke email staf.</div></div></header>\n<div style=\"display: flex; flex-wrap: wrap; gap: 8px; align-items: center\"><span style=\"{{st1}}\">1. {{st1t}}</span><span style=\"color: #8A93A6\">→</span><span style=\"{{st2}}\">2. Diperiksa keuangan</span><span style=\"color: #8A93A6\">→</span><span style=\"{{st3}}\">3. Disetujui owner</span><span style=\"color: #8A93A6\">→</span><span style=\"{{st4}}\">4. {{st4t}}</span></div><div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr)); gap: 12px\"><div style=\"background: #FFFFFF; border: 1px solid #E6E8EC; border-radius: 14px; padding: 14px 16px; display: flex; flex-direction: column; gap: 2px\"><span style=\"font-size: 12px; font-weight: 700; color: #4A5468\">Total dibayar {{mName}}</span><span style=\"font-size: 24px; font-weight: 800; line-height: 30px\">{{total}}</span><span style=\"font-size: 12px; color: #4A5468\">{{nStaf}}</span></div><div style=\"background: #FFFFFF; border: 1px solid #E6E8EC; border-radius: 14px; padding: 14px 16px; display: flex; flex-direction: column; gap: 2px\"><span style=\"font-size: 12px; font-weight: 700; color: #4A5468\">Komisi staf</span><span style=\"font-size: 24px; font-weight: 800; line-height: 30px\">{{kom}}</span><span style=\"font-size: 12px; color: #4A5468\">dari poin staf</span></div><div style=\"background: #FFFFFF; border: 1px solid #E6E8EC; border-radius: 14px; padding: 14px 16px; display: flex; flex-direction: column; gap: 2px\"><span style=\"font-size: 12px; font-weight: 700; color: #4A5468\">Potongan dan kasbon</span><span style=\"font-size: 24px; font-weight: 800; line-height: 30px\">{{pot}}</span></div><div style=\"background: #FFFFFF; border: 1px solid #E6E8EC; border-radius: 14px; padding: 14px 16px; display: flex; flex-direction: column; gap: 2px\"><span style=\"font-size: 12px; font-weight: 700; color: #4A5468\">Gaji ÷ pendapatan</span><span style=\"font-size: 24px; font-weight: 800; line-height: 30px\">{{ratio}}</span><span style=\"font-size: 12px; color: #4A5468\">{{ratioN}}</span></div></div><div style=\"display: flex; flex-wrap: wrap; gap: 20px; align-items: flex-start\"><section style=\"flex: 3 1 700px; min-width: 0; background: #FFFFFF; border: 1px solid #E6E8EC; border-radius: 16px; padding: 18px; display: flex; flex-direction: column; gap: 12px\"><div style=\"display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap\"><h2 style=\"margin: 0; font-size: 17px; font-weight: 800\">{{perLabel}}</h2><select onChange=\"{{setPer}}\" value=\"{{per}}\" style=\"height: 44px; box-sizing: border-box; border: 1px solid #D5D9E0; border-radius: 10px; padding: 0 12px; font: 600 14px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; background: #FFFFFF; width: 100%; width: 180px; height: 36px\"><sc-for list=\"{{perOpts}}\" as=\"o\"><option value=\"{{o.v}}\">{{o.l}}</option></sc-for></select></div>\n  <div style=\"display: grid; grid-template-columns: minmax(0, 1fr) 96px 56px 90px 80px 90px 104px; gap: 10px; font-size: 12px; font-weight: 700; color: #4A5468; padding-bottom: 8px; border-bottom: 1px solid #E6E8EC\"><span>Staf</span><span style=\"text-align: right\">Pokok</span><span style=\"text-align: right\">Hadir</span><span style=\"text-align: right\">Komisi</span><span style=\"text-align: right\">Lembur</span><span style=\"text-align: right\">Potongan</span><span style=\"text-align: right\">Diterima</span></div>\n  <sc-for list=\"{{rows}}\" as=\"r\" hint-placeholder-count=\"8\">\n    <button type=\"button\" onClick=\"{{r.pick}}\" aria-pressed=\"{{r.on}}\" style=\"{{r.style}}\">\n      <span style=\"display: flex; flex-direction: column; min-width: 0\"><b>{{r.n}}</b><span style=\"font-size: 12px; color: #4A5468; white-space: nowrap; overflow: hidden; text-overflow: ellipsis\">{{r.p}} · {{r.c}}</span></span><span style=\"text-align: right\">{{r.g}}</span><span style=\"text-align: right\">{{r.h}}</span><span style=\"text-align: right\">{{r.k}}</span><span style=\"text-align: right\">{{r.l}}</span><span style=\"text-align: right; color: #A12A1F\">{{r.pt}}</span><b style=\"text-align: right\">{{r.t}}</b>\n    </button>\n  </sc-for>\n  <sc-if value=\"{{noRows}}\"><div style=\"font-size: 14px; color: #4A5468; padding: 10px 0\">{{emptyText}}</div></sc-if>\n  <sc-if value=\"{{notSent}}\" hint-placeholder-val=\"{{true}}\"><div style=\"display: flex; gap: 8px; flex-wrap: wrap\"><sc-if value=\"{{hasRows}}\"><button type=\"button\" onClick=\"{{download}}\" style=\"height: 44px; padding: 0 16px; border-radius: 10px; border: 1px solid #1F2B4D; background: #FFFFFF; color: #1F2B4D; font: 700 14px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">Unduh Excel untuk bank</button></sc-if><sc-if value=\"{{canRecalc}}\"><button type=\"button\" onClick=\"{{recalc}}\" disabled=\"{{busy}}\" style=\"height: 44px; padding: 0 16px; border-radius: 10px; border: 1px solid #1F2B4D; background: #FFFFFF; color: #1F2B4D; font: 700 14px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">Hitung ulang</button></sc-if><sc-if value=\"{{isApproved}}\"><div style=\"width: 240px\"><select onChange=\"{{setAcc}}\" value=\"{{acc}}\" style=\"height: 44px; box-sizing: border-box; border: 1px solid #D5D9E0; border-radius: 10px; padding: 0 12px; font: 600 14px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; background: #FFFFFF; width: 100%\"><sc-for list=\"{{accOpts}}\" as=\"o\"><option value=\"{{o.v}}\">{{o.l}}</option></sc-for></select></div></sc-if><button type=\"button\" onClick=\"{{send}}\" disabled=\"{{sendDisabled}}\" style=\"height: 48px; padding: 0 18px; border-radius: 12px; border: none; background: #09BEAF; color: #1F2B4D; font: 800 15px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">{{sendLabel}}</button></div></sc-if>\n  <sc-if value=\"{{sent}}\" hint-placeholder-val=\"{{false}}\"><div style=\"background: #E4F2EA; border-radius: 12px; padding: 14px 16px; font-size: 14px; line-height: 20px; color: #1F3D2D\"><b>{{sentT}}</b> {{sentB}}</div></sc-if></section><section style=\"flex: 2 1 340px; min-width: 0; background: #FFFFFF; border: 1px solid #E6E8EC; border-radius: 16px; padding: 18px; display: flex; flex-direction: column; gap: 12px\"><div style=\"display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap\"><h2 style=\"margin: 0; font-size: 17px; font-weight: 800\">Slip gaji</h2></div>\n  <div style=\"border: 1px solid #E6E8EC; border-radius: 14px; padding: 16px; display: flex; flex-direction: column; gap: 8px; background: #FFFFFF\">\n    <div><b style=\"font-size: 15px\">Slip gaji · {{perLabel}}</b><div style=\"font-size: 12px; color: #4A5468\">PT Popo Karya Investama</div></div>\n    <div style=\"font-size: 14px\"><b>{{s.n}}</b> · {{s.p}} · {{s.c}}</div>\n    <div style=\"height: 1px; background: #E6E8EC\"></div>\n    <sc-for list=\"{{s.lines}}\" as=\"x\" hint-placeholder-count=\"6\"><div style=\"display: flex; justify-content: space-between; font-size: 14px\"><span>{{x.a}}</span><span style=\"{{x.st}}\">{{x.b}}</span></div></sc-for>\n    <div style=\"height: 1px; background: #E6E8EC\"></div>\n    <div style=\"display: flex; justify-content: space-between; font-size: 16px; font-weight: 800\"><span>Diterima</span><span>{{s.t}}</span></div>\n  </div>\n  <div style=\"font-size: 12px; line-height: 18px; color: #4A5468\">Potongan selisih kas dan kasbon berasal dari Tutup shift dan pengajuan kasbon yang sudah disetujui. Staf bisa membuka rincian komisinya di aplikasi.</div></section></div>\n</main>\n</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{\"$preview\":{\"width\":1440,\"height\":1080}}'>\n/* ===== bersama panel Keuangan (agen H) ===== */\nconst KC = {\n  CH: { good: ['#E4F2EA', '#1E6B45'], warn: ['#FFF1D6', '#8A4B00'], bad: ['#FDECEA', '#A12A1F'], info: ['#E8EEF8', '#1F2B4D'], mute: ['#EEF0F3', '#4A5468'], teal: ['#E3F7F5', '#077A70'] },\n  chip(t) { const c = KC.CH[t] || KC.CH.mute; return 'display: inline-flex; align-items: center; height: 24px; padding: 0 9px; border-radius: 12px; font-size: 12px; font-weight: 800; white-space: nowrap; background: ' + c[0] + '; color: ' + c[1] + ';'; },\n  tab(on) { return 'height: 36px; padding: 0 12px; border-radius: 9px; cursor: pointer; font: 700 13px \"Plus Jakarta Sans\", sans-serif; color: #1F2B4D; ' + (on ? 'border: 1.5px solid #1F2B4D; background: #E3F7F5;' : 'border: 1px solid #D5D9E0; background: #FFFFFF;'); },\n  rp(n) { return RA.rp(n); },\n  n0(n) { return n == null || isNaN(+n) ? '' : (Math.round(+n) < 0 ? '−' : '') + Math.abs(Math.round(+n)).toString().replace(/\\B(?=(\\d{3})+(?!\\d))/g, '.'); },\n  jt(n) { if (n == null || isNaN(+n)) return '—'; n = +n; const a = Math.abs(n), s = n < 0 ? '−' : ''; if (a >= 1e9) return s + 'Rp' + (a / 1e9).toFixed(2).replace('.', ',').replace(/,?0+$/, '') + ' M'; if (a >= 1e6) return s + 'Rp' + (a / 1e6).toFixed(a >= 1e8 ? 1 : 2).replace('.', ',').replace(/,?0+$/, '') + ' jt'; if (a >= 1e3) return s + 'Rp' + Math.round(a / 1e3) + ' rb'; return RA.rp(n); },\n  pct(a, b) { return b ? Math.round(a / b * 100) + '%' : '—'; },\n  ym(d) { d = d ? new Date(d) : new Date(); return d.getFullYear() + '-' + RA.pad(d.getMonth() + 1); },\n  addM(ym, k) { const [y, m] = ym.split('-').map(Number); const d = new Date(y, m - 1 + k, 1); return d.getFullYear() + '-' + RA.pad(d.getMonth() + 1); },\n  range(ym) { const [y, m] = ym.split('-').map(Number); return { from: y + '-' + RA.pad(m) + '-01', to: RA.iso(new Date(y, m, 0)), label: RA.BULAN[m - 1] + ' ' + y, name: RA.BULAN[m - 1], days: new Date(y, m, 0).getDate() }; },\n  mname(ym) { return RA.BULAN[+ym.split('-')[1] - 1]; },\n  today() { return RA.iso(new Date()); },\n  dmy(iso) { if (!iso) return ''; const p = String(iso).slice(0, 10).split('-'); return p[2] + '/' + p[1] + '/' + p[0]; },\n  dm(iso) { return iso ? RA.date(String(iso).slice(0, 10) + 'T12:00:00') : '—'; },\n  parseDate(s) { s = String(s || '').trim(); let m = s.match(/^(\\d{1,2})[\\/.\\-](\\d{1,2})[\\/.\\-](\\d{4})$/); if (m) return m[3] + '-' + RA.pad(m[2]) + '-' + RA.pad(m[1]); return /^\\d{4}-\\d{2}-\\d{2}$/.test(s) ? s : null; },\n  num(s) { if (typeof s === 'number') return s; const v = String(s == null ? '' : s).replace(/[^\\d,\\-]/g, '').replace(',', '.'); return v === '' || v === '-' ? null : +v; },\n  sched(s) { if (!s) return 'belum terjadwal'; if (/^daily/.test(s)) return 'harian ' + s.split(' ')[1].replace(':', '.'); if (/^weekly/.test(s)) return 'mingguan · senin ' + (s.split(' ')[2] || '').replace(':', '.'); if (/^monthly/.test(s)) return 'bulanan · tanggal ' + s.split(' ')[1]; return s; },\n  csv(name, rows) { const t = rows.map(r => r.map(c => { c = c == null ? '' : String(c); return /[\",;\\n]/.test(c) ? '\"' + c.replace(/\"/g, '\"\"') + '\"' : c; }).join(';')).join('\\n'); const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob(['﻿' + t], { type: 'text/csv' })); a.download = name; document.body.appendChild(a); a.click(); a.remove(); },\n  async accounts(force) { if (!window.KEU_ACC || force) { window.KEU_ACC = await RA.q(RA.from('accounts').select('id,code,name,category,grp,is_cash,is_header,is_active').eq('is_active', true).order('code')); } return window.KEU_ACC; },\n  async branches() { if (!window.KEU_BR) { window.KEU_BR = (await RA.q(RA.from('branches').select('id,code,name,kind,sort,archived_at').order('sort'))).filter(b => !b.archived_at); } return window.KEU_BR; },\n  async upload(file, folder) { const path = 'keuangan/' + (folder || 'nota') + '/' + KC.ym() + '/' + Date.now() + '-' + String(file.name || 'file').replace(/[^\\w.\\-]+/g, '_'); await RA.upload('operasional', path, file); return path; },\n  inp: 'height: 44px; box-sizing: border-box; border: 1px solid #D5D9E0; border-radius: 10px; padding: 0 12px; font: 600 14px \\'Plus Jakarta Sans\\', sans-serif; color: #1F2B4D; background: #FFFFFF; width: 100%'\n};\nclass KeuBase extends DCLogic {\n  async keuInit() {\n    /* pengaturan bisa ter-cache saat belum login (hanya kunci publik) → muat ulang sekali sebagai staf */\n    if (!window.KEU_SET) { try { await RA.settings(true); window.KEU_SET = 1; } catch (e) {} }\n    try { const nav = await RA.call('fin_nav', {}); if (!RA_ALIVE(this)) return; this.setState({ nav }); }\n    catch (e) { if (RA_ALIVE(this)) this.setState({ err: RA.friendly(e.message) }); }\n  }\n  async loadAcc() { try { const acc = await KC.accounts(); if (RA_ALIVE(this)) this.setState({ acc }); } catch (e) {} }\n  acctOpts(fn, ph) { return [{ v: '', l: ph || 'Pilih akun' }].concat((this.state.acc || []).filter(a => !a.is_header && (!fn || fn(a))).map(a => ({ v: a.id, l: a.code + ' ' + a.name }))); }\n  accById(id) { return (this.state.acc || []).find(a => a.id === id); }\n  setF(k) { return e => this.setState({ f: Object.assign({}, this.state.f, { [k]: e.target.type === 'checkbox' ? e.target.checked : e.target.value }) }); }\n  setRow(i, k) { return e => { const rows = this.state.f.rows.slice(); rows[i] = Object.assign({}, rows[i], { [k]: e.target.value }); this.setState({ f: Object.assign({}, this.state.f, { rows }) }); }; }\n  addRow(blank) { return () => this.setState({ f: Object.assign({}, this.state.f, { rows: this.state.f.rows.concat([Object.assign({}, blank)]) }) }); }\n  delRow(i) { return () => { const rows = this.state.f.rows.filter((_, j) => j !== i); this.setState({ f: Object.assign({}, this.state.f, { rows: rows.length ? rows : this.state.f.rows }) }); }; }\n  pickFile(k) { return e => { const file = e.target.files && e.target.files[0]; if (file) this.setState({ f: Object.assign({}, this.state.f, { [k]: file }) }); }; }\n  async run(p) { try { return await p; } catch (e) { if (RA_ALIVE(this)) this.setState({ err: RA.friendly(e.message) }); return null; } }\n  tagOpts(all) { const t = ((this.state.nav || {}).tags || []).map(x => ({ v: x.label, l: x.label })); return (all ? [{ v: '', l: all }] : []).concat(t); }\n  tagIds(label) { if (!label) return null; const t = ((this.state.nav || {}).tags || []).find(x => x.label === label); return t ? t.ids : null; }\n  can(p) { const n = this.state.nav; return !!(n && n.perms && n.perms[p]); }\n  keuVals() {\n    const n = this.state.nav || {}, me = RA._staff || {};\n    const name = n.name || me.name || '';\n    const role = (n.role || me.role) === 'owner' ? 'Owner' : 'Keuangan';\n    return { nav: { journals: n.journals || 0, approvals: n.approvals || 0, initials: RA.initials(name), name, roleLine: role + (n.require_2fa ? ' · 2FA aktif' : '') },\n      err: this.state.err || '', share: this.shareVals() };\n  }\n  shareVals() {\n    if (!this.shareKey) return {};\n    const n = this.state.nav || {}, rep = (n.reports || {})[this.shareKey] || {};\n    const sched = this.state.shareSched !== undefined ? this.state.shareSched : (rep.schedule || '');\n    const lines = (this.shareLines ? this.shareLines() : []).filter(Boolean);\n    const recips = n.recipients || [];\n    return { open: !!this.state.shareOpen, title: this.shareTitle, schedText: KC.sched(rep.schedule), to: recips.join(', ') || 'owner dan keuangan',\n      toggle: e => { const o = !!e.target.open; if (o !== !!this.state.shareOpen) this.setState({ shareOpen: o }); },\n      lines: lines.map(t => ({ t })), recipients: recips.map(x => ({ name: x })), sched, content: this.state.shareContent || 'summary_link', busy: !!this.state.shareBusy,\n      setSched: e => this.setState({ shareSched: e.target.value }), setContent: e => this.setState({ shareContent: e.target.value }),\n      addRecipient: () => RA.toast('Laporan keuangan hanya bisa dikirim ke nomor owner dan keuangan yang terdaftar.'),\n      send: this.act(async () => {\n        const body = '*' + this.shareTitle + '* · Rentalaja\\n' + lines.map(l => '• ' + l).join('\\n') + '\\n\\nRincian lengkap bisa dibuka di panel Keuangan (perlu login).';\n        const r = await RA.call('fin_send_report', { p_key: this.shareKey, p_body: body });\n        RA.ok('Terkirim ke ' + r.sent + ' nomor' + (r.simulation ? ' (mode uji)' : ''));\n      }, 'shareBusy'),\n      save: this.act(async () => {\n        await RA.call('fin_save_report_schedule', { p_key: this.shareKey, p_name: this.shareTitle, p_schedule: sched, p_content: this.state.shareContent || 'summary_link' });\n        await this.keuInit(); this.setState({ shareSched: undefined }); RA.ok('Jadwal laporan disimpan');\n      }, 'shareBusy') };\n  }\n}\n/* ===== layar ===== */\nclass Component extends KeuBase {\nstate = { sel: 0, per: KC.ym(), d: null, acc: '' };\nshareKey = 'KeuGaji'; shareTitle = 'Penggajian';\nasync componentDidMount() { await Promise.all([this.keuInit(), this.loadAcc()]); if (this.params.period) this.setState({ per: this.params.period }); this.reload(); }\nasync reload() { const d = await this.run(RA.call('fin_payroll', { p_period: this.state.per })); if (d && RA_ALIVE(this)) this.setState({ d }); }\nshareLines() { const d = this.state.d; if (!d || !d.run) return ['Gaji ' + KC.range(this.state.per).label + ' belum dihitung'];\n  const st = { collecting: 'data terkumpul, belum diajukan', reviewed: 'diperiksa keuangan, menunggu owner', approved: 'disetujui owner, menunggu transfer', paid: 'sudah dibayar' }[d.run.status];\n  return [KC.mname(this.state.per) + ' ' + KC.jt(d.run.total) + ' · ' + d.items.length + ' staf', 'Status: ' + st]; }\nrenderVals() {\n  const s = this.state, d = s.d, base = this.keuVals(), run = d && d.run, items = d ? d.items : [];\n  const stv = run ? run.status : 'none';\n  const ord = { none: 0, collecting: 1, reviewed: 2, approved: 3, paid: 4 }[stv];\n  const sty = n => { const c = ord > n ? ['E4F2EA', '1E6B45'] : ord === n ? ['E3F7F5', '077A70'] : ['EEF0F3', '4A5468']; return 'display: inline-flex; align-items: center; gap: 8px; height: 36px; padding: 0 12px; border-radius: 18px; font-size: 13px; font-weight: 800; background: #' + c[0] + '; color: #' + c[1]; };\n  const ROLE = { cs: 'CS', cashier: 'Kasir', qc: 'Petugas QC', technician: 'Teknisi', runner: 'Runner', driver: 'Sopir', cs_experience: 'CS Experience', branch_head: 'Kepala cabang', finance: 'Keuangan', asset_manager: 'Manajer aset', experience_manager: 'Manajer operasional', staff: 'Staf', viewer: 'Pemantau' };\n  const rows = items.map((r, i) => { const pot = +r.shortage + +r.advance + +(r.late_fine || 0);\n    return { n: r.name, p: ROLE[r.role] || r.role, c: r.tag || '—', g: RA.rp(r.base), h: r.attendance || '—', k: RA.rp(r.commission), l: +r.overtime || +r.bonus || +r.reimburse ? RA.rp(+r.overtime + +r.bonus + +(r.reimburse || 0)) : '—', pt: pot ? '−' + RA.rp(pot) : '—', t: RA.rp(r.net),\n      on: s.sel === i ? 'true' : 'false', pick: () => this.setState({ sel: i }),\n      style: 'display: grid; grid-template-columns: minmax(0, 1fr) 96px 56px 90px 80px 90px 104px; gap: 10px; align-items: center; width: 100%; text-align: left; padding: 9px 8px; border: none; border-bottom: 1px solid #E6E8EC; border-radius: 8px; cursor: pointer; font: 500 14px \"Plus Jakarta Sans\", sans-serif; color: #1F2B4D; background: ' + (s.sel === i ? '#E3F7F5' : 'transparent') + ';' }; });\n  const r = items[s.sel] || items[0];\n  const L = r ? [['Gaji pokok', RA.rp(r.base), ''], ['Kehadiran', r.attendance || '—', ''], ['Komisi staf', '+' + RA.rp(r.commission), ''], ['Lembur' + (+r.ot_minutes ? ' (' + Math.round(r.ot_minutes / 6) / 10 + ' jam)' : ''), +r.overtime ? '+' + RA.rp(r.overtime) : 'Rp0', ''], ['Bonus', +r.bonus ? '+' + RA.rp(r.bonus) : 'Rp0', ''], ['Reimburse (Kerja lapangan)', +r.reimburse ? '+' + RA.rp(r.reimburse) : 'Rp0', ''],\n    ['Potongan selisih kas', +r.shortage ? '−' + RA.rp(r.shortage) : 'Rp0', +r.shortage ? 'color: #A12A1F;' : ''], ['Kasbon', +r.advance ? '−' + RA.rp(r.advance) : 'Rp0', +r.advance ? 'color: #A12A1F;' : ''], ['Denda telat' + (+r.late_count ? ' (' + r.late_count + '×)' : ''), +r.late_fine ? '−' + RA.rp(r.late_fine) : 'Rp0', +r.late_fine ? 'color: #A12A1F;' : '']] : [];\n  const sum = f => items.reduce((a, x) => a + +x[f], 0);\n  const cur = KC.ym();\n  const label = { none: 'Hitung gaji ' + KC.mname(s.per), collecting: 'Ajukan ke owner', reviewed: 'Menunggu persetujuan owner', approved: 'Tandai sudah dibayar', paid: 'Sudah dibayar' }[stv];\n  const appr = d && d.approval;\n  const sent = ['reviewed', 'approved', 'paid'].includes(stv);\n  return Object.assign(base, { rows, noRows: d && !rows.length, hasRows: rows.length > 0, emptyText: d && d.no_comp ? 'Belum dihitung. ' + d.no_comp + ' staf belum punya data gaji pokok (atur di Pengguna).' : 'Gaji bulan ini belum dihitung. Klik Hitung gaji untuk mengumpulkan absen, komisi, selisih kas, dan kasbon.',\n    s: r ? { n: r.name, p: ROLE[r.role] || r.role, c: r.tag || '—', t: RA.rp(r.net), lines: L.map(([a, b, st]) => ({ a, b, st: 'font-weight: 700; ' + st })) } : { n: '—', p: '', c: '', t: '—', lines: [] },\n    total: RA.rp(sum('net')), kom: RA.rp(sum('commission')), pot: RA.rp(sum('shortage') + sum('advance') + items.reduce((a, x) => a + +(x.late_fine || 0), 0)), mName: KC.mname(s.per), nStaf: items.length + ' staf', perLabel: KC.range(s.per).label,\n    ratio: d && d.revenue ? KC.pct(sum('net'), d.revenue) : '—', ratioN: d ? 'pendapatan ' + KC.mname(s.per) + ' ' + KC.jt(d.revenue) : '',\n    per: s.per, perOpts: [-2, -1, 0, 1].map(k => ({ v: KC.addM(cur, k), l: KC.range(KC.addM(cur, k)).label })), setPer: e => { this.setState({ per: e.target.value, sel: 0 }); setTimeout(() => this.reload()); },\n    st1: sty(1), st1t: run ? 'Data terkumpul ' + KC.dm(run.created_at) : 'Data belum dihitung', st2: sty(2), st3: sty(3), st4: sty(4), st4t: run && run.paid_at ? 'Dibayar dan slip terkirim ' + KC.dm(run.paid_at) : 'Dibayar dan slip terkirim',\n    notSent: stv !== 'paid' && stv !== 'reviewed', sent, sendLabel: s.busy ? 'Memproses…' : label, sendDisabled: !!s.busy || stv === 'reviewed' || stv === 'paid', busy: !!s.busy,\n    sentT: stv === 'paid' ? 'Gaji sudah dibayar.' : stv === 'approved' ? 'Disetujui owner' + (appr && appr.decided_at ? ' ' + KC.dm(appr.decided_at) : '') + '.' : 'Diajukan ke Persetujuan.',\n    sentB: stv === 'paid' ? 'Slip terkirim ke email masing-masing staf.' : stv === 'approved' ? 'Transfer dari aplikasi bank, lalu tandai sudah dibayar: jurnal gaji dibuat dan slip terkirim.' : 'Setelah owner setuju dan transfer ditandai, slip terkirim otomatis ke WhatsApp masing-masing staf.',\n    canRecalc: stv === 'collecting', isApproved: stv === 'approved', acc: s.acc, setAcc: e => this.setState({ acc: e.target.value }), accOpts: this.acctOpts(a => a.is_cash, 'Bayar dari rekening'),\n    recalc: this.act(async () => { await RA.call('fin_payroll_collect', { p_period: s.per }); RA.ok('Gaji dihitung ulang'); this.reload(); }),\n    download: () => KC.csv('gaji-' + s.per + '.csv', [['Nama', 'Peran', 'Rekening', 'Diterima']].concat(items.map(x => [x.name, ROLE[x.role] || x.role, x.bank || '', Math.round(x.net)]))),\n    send: this.act(async () => {\n      if (stv === 'none') { await RA.call('fin_payroll_collect', { p_period: s.per }); RA.ok('Data gaji terkumpul'); }\n      else if (stv === 'collecting') { await RA.call('fin_payroll_submit', { p_run: run.id }); RA.ok('Diajukan ke owner'); this.keuInit(); }\n      else if (stv === 'approved') { if (!s.acc) throw new Error('Pilih rekening pembayar gaji'); const x = await RA.call('fin_payroll_pay', { p_run: run.id, p_account: s.acc }); RA.ok('Gaji dibayar · ' + x.slips + ' slip terkirim'); }\n      this.reload(); }) });\n}\n}\n</script>\n</body>\n</html>\n"}