{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Keuangan · Penggajian</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>summary::-webkit-details-marker{display:none}\nbody{margin:0}\na{color:#1F2B4D}a:hover{color:#000}\n</style>\n</helmet>\n<div style=\"min-height: 100vh; box-sizing: border-box; display: flex; flex-wrap: wrap; align-items: stretch; background: #F6F7F9; color: #1F2B4D; font-family: 'Plus Jakarta Sans', system-ui, sans-serif\">\n<aside style=\"flex: 1 1 232px; box-sizing: border-box; background: #FFFFFF; border-right: 1px solid #E6E8EC; padding: 20px 16px; display: flex; flex-direction: column; gap: 20px\">\n  <img src=\"logo.png\" alt=\"Rentalaja\" style=\"height: 28px; width: auto; align-self: flex-start; display: block\">\n  <div style=\"display: flex; flex-direction: column; gap: 6px\">\n    <div style=\"font-size: 12px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #077A70\">Keuangan</div>\n    <div style=\"display: flex; align-items: center; gap: 6px; background: #1F2B4D; color: #FFFFFF; border-radius: 10px; padding: 8px 10px; font-size: 12px; line-height: 16px; font-weight: 700\">\n      <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#09BEAF\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" style=\"flex-shrink: 0\"><rect x=\"5\" y=\"11\" width=\"14\" height=\"10\" rx=\"2\"/><path d=\"M8 11V8a4 4 0 0 1 8 0v3\"/></svg>\n      <span>Area terbatas · owner dan keuangan · 2FA</span></div>\n    <a href=\"MgmtDashboard.dc.html\" style=\"font-size: 12px; font-weight: 700; color: #4A5468\">← Panel manajemen</a>\n  </div>\n  <nav aria-label=\"Menu\" style=\"display: flex; flex-direction: column; gap: 14px\"><div role=\"group\" aria-label=\"Jurnal\" style=\"display: flex; flex-direction: column; gap: 2px\"><div style=\"font-size: 11px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #8A93A6; padding: 0 12px 2px\">Jurnal</div><a href=\"KeuDasbor.dc.html\" style=\"min-height: 40px; box-sizing: border-box; padding: 0 12px; border-radius: 10px; background: transparent; color: #1F2B4D; font: 600 14px 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; align-items: center; gap: 10px; text-decoration: none\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4A5468\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1.5\"/></svg><span>Dasbor</span></a><a href=\"KeuLaporan.dc.html\" style=\"min-height: 40px; box-sizing: border-box; padding: 0 12px; border-radius: 10px; background: transparent; color: #1F2B4D; font: 600 14px 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; align-items: center; gap: 10px; text-decoration: none\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4A5468\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 20V10M10 20V4M16 20v-7M22 20H2\"/></svg><span>Laporan</span></a><a href=\"KeuKasBank.dc.html\" style=\"min-height: 40px; box-sizing: border-box; padding: 0 12px; border-radius: 10px; background: transparent; color: #1F2B4D; font: 600 14px 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; align-items: center; gap: 10px; text-decoration: none\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4A5468\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-li