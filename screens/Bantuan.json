{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Bantuan</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0}\na{color:#1F2B4D}a:hover{color:#000}\n</style>\n</helmet>\n<div style=\"width: 390px; height: 1400px; box-sizing: border-box; background: #F4F6F9; color: #1F2B4D; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; flex-direction: column; position: relative; overflow: hidden\">\n<header style=\"display: flex; align-items: center; gap: 8px; padding: 10px 12px; border-bottom: 1px solid #E6E8EC\">\n    <a href=\"Akun.dc.html\" aria-label=\"Kembali\" style=\"width: 44px; height: 44px; display: flex; align-items: center; justify-content: center\">\n      <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1F2B4D\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M15 6l-6 6 6 6\"/></svg>\n    </a>\n    <div style=\"display: flex; flex-direction: column\"><div style=\"font-size: 18px; font-weight: 800\">Bantuan</div></div>\n  </header>\n  <section style=\"padding: 16px; display: flex; flex-direction: column; gap: 14px\">\n    <div role=\"group\" aria-label=\"Topik\" style=\"display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); background: #F6F7F9; border-radius: 12px; padding: 4px; gap: 4px\">\n      <sc-for list=\"{{tabs}}\" as=\"t\">\n        <button type=\"button\" onClick=\"{{t.pick}}\" aria-pressed=\"{{t.on}}\" style=\"{{t.style}}\">{{t.label}}</button>\n      </sc-for>\n    </div>\n    <sc-if value=\"{{isFaq}}\">\n      <div style=\"display: flex; flex-direction: column; gap: 8px\"><sc-for list=\"{{faq}}\" as=\"f\"><details style=\"background: #FFFFFF; border: 0; border-radius: 20px; box-shadow: 0 2px 12px rgba(31,43,77,0.07); padding: 14px 16px\"><summary style=\"font-size: 15px; font-weight: 800; cursor: pointer; line-height: 22px\">{{f.q}}</summary><p style=\"margin: 8px 0 0; font-size: 14px; line-height: 21px; color: #4A5468; white-space: pre-line\">{{f.a}}</p></details></sc-for></div>\n    </sc-if>\n    <sc-if value=\"{{isSyarat}}\">\n      <div style=\"display: flex; flex-direction: column; gap: 10px\">\n        <div style=\"font-size: 13px; line-height: 19px; color: #4A5468\">{{partyLine}}</div>\n        <ol style=\"margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 8px\"><sc-for list=\"{{terms}}\" as=\"x\"><li style=\"font-size: 14px; line-height: 21px\">{{x}}</li></sc-for></ol>\n        <div style=\"font-size: 12px; color: #6B7385\">Versi {{legalVersion}}</div>\n        <div style=\"background: #FFF1D6; border-radius: 10px; padding: 10px 12px; font-size: 12px; line-height: 18px; color: #5C3A00\">Draf. Teks lengkap perlu dicek konsultan hukum sebelum dipakai resmi.</div>\n      </div>\n    </sc-if>\n    <sc-if value=\"{{isPrivasi}}\">\n      <div style=\"display: flex; flex-direction: column; gap: 14px\"><sc-for list=\"{{privacy}}\" as=\"x\"><div style=\"display: flex; flex-direction: column; gap: 4px\"><b style=\"font-size: 15px\">{{x.t}}</b><span style=\"font-size: 14px; line-height: 21px; color: #4A5468; white-space: pre-line\">{{x.d}}</span></div></sc-for>\n        <div style=\"background: #FFFFFF; border: 0; border-radius: 20px; box-shadow: 0 2px 12px rgba(31,43,77,0.07); padding: 14px 16px; display: flex; flex-direction: column; gap: 10px\">\n          <b style=\"font-size: 15px\">Gunakan hak Anda</b>\n          <span style=\"font-size: 13px; line-height: 19px; color: #4A5468\">Permintaan dicatat sebagai tiket dan dijawab paling lambat 3×24 jam lewat WhatsApp.</span>\n          <sc-if value=\"{{loggedIn}}\">\n            <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 8px\"><sc-for list=\"{{rights}}\" as=\"h\"><button type=\"button\" onClick=\"{{h.go}}\" disabled=\"{{busy}}\" style=\"min-height: 44px; padding: 8px 10px; border-radius: 10px; border: 1px solid #D5D9E0; background: #FFFFFF; color: #1F2B4D; font: 700 13px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">{{h.label}}</button></sc-for></div>\n          </sc-if>\n          <sc-if value=\"{{loggedIn}}\" not><a href=\"Login.dc.html\" style=\"font-size: 14px; font-weight: 700\">Masuk dulu untuk mengajukan permintaan</a></sc-if>\n          <sc-if value=\"{{reqDone}}\"><div role=\"status\" style=\"font-size: 13px; font-weight: 600; color: #1E6B45; background: #E4F2EA; border-radius: 10px; padding: 10px 12px\">{{reqDone}}</div></sc-if>\n          <sc-if value=\"{{reqErr}}\"><div role=\"alert\" style=\"font-size: 13px; font-weight: 600; color: #A12A1F; background: #FDECEA; border-radius: 10px; padding: 10px 12px\">{{reqErr}}</div></sc-if>\n        </div>\n        <div style=\"font-size: 12px; color: #6B7385\">Versi {{legalVersion}}</div>\n        <div style=\"background: #FFF1D6; border-radius: 10px; padding: 10px 12px; font-size: 12px; line-height: 18px; color: #5C3A00\">Draf. Perlu dicek konsultan hukum agar sesuai UU Pelindungan Data Pribadi.</div>\n      </div>\n    </sc-if>\n    <div style=\"background: #FFFFFF; border: 0; border-radius: 20px; box-shadow: 0 2px 12px rgba(31,43,77,0.07); padding: 14px 16px; display: flex; justify-content: space-between; align-items: center; gap: 10px\">\n      <span style=\"font-size: 14px; line-height: 20px\"><b>Masih bingung?</b><sc-if value=\"{{csHours}}\"><br><span style=\"font-size: 12px; color: #4A5468\">{{csHours}}</span></sc-if></span>\n      <sc-if value=\"{{waHref}}\"><a href=\"{{waHref}}\" style=\"height: 44px; padding: 0 16px; border-radius: 10px; background: #1F2B4D; color: #FFFFFF; font-size: 14px; font-weight: 700; display: flex; align-items: center; text-decoration: none\">Chat CS</a></sc-if>\n    </div>\n  </section>\n\n</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{\"$preview\":{\"width\":390,\"height\":1400}}'>\nclass Component extends DCLogic {\nstate = { tab: 'faq', cms: [], cats: [], promos: [], branch: null, free: null };\nasync componentDidMount() {\n  if (this.params.tab) this.setState({ tab: this.params.tab });\n  const [cms, cats, promos, branch] = await Promise.all([\n    RA.from('content_items').select('id,title,subtitle,body,category,position,lang').eq('kind', 'faq').eq('status', 'published').order('position'),\n    RA.from('categories').select('id,name,slug,docs_required,is_active'),\n    RA.from('auto_promos').select('key,name,rule,category_ids,exclude_category_ids,is_active'),\n    RA.branch()\n  ]);\n  if (!RA_ALIVE(this)) return;\n  this.setState({ cms: (cms.data || []).filter(x => !x.lang || x.lang === 'id'), cats: cats.data || [], promos: promos.data || [], branch, free: await RA.promoFree(null) });\n}\nrules() {\n  const S = k => RA.setting(k);\n  const hm = v => v ? String(v).slice(0, 5).replace(':', '.') : null;\n  const docs = S('docs_required') || [];\n  const opts = (S('supporting_doc_options') || []).map(x => String(x).toUpperCase());\n  const orList = a => a.length > 1 ? a.slice(0, -1).join(', ') + ', atau ' + a[a.length - 1] : a.join('');\n  const ktpOnly = this.state.cats.filter(c => c.is_active !== false && Array.isArray(c.docs_required) && c.docs_required.length === 1 && c.docs_required[0] === 'ktp').map(c => c.name.toLowerCase());\n  const docText = (docs.indexOf('ktp') > -1 ? (docs.indexOf('pendukung') > -1 ? 'KTP dan satu dokumen pendukung' + (opts.length ? ' (' + orList(opts) + ')' : '') : 'KTP') : 'Dokumen identitas sesuai syarat cabang') + '.' +\n    (ktpOnly.length ? ' Sewa ' + ktpOnly.join(' dan ') + ' cukup KTP.' : '');\n  const ktpDep = S('ktp_original_deposit') === true;\n  return { S, hm, docText, ktpDep, dp: S('dp_percent'), noDp: S('member_no_dp') === true, ver: S('verification_target_minutes'),\n    csS: hm(S('cs_hours_start')), csE: hm(S('cs_hours_end')), late: S('late_fee_percent_per_hour'), lateMax: S('late_fee_max'), tol: (function (g) { g = +g || 0; return g > 0 ? (g % 60 === 0 ? g / 60 + ' jam' : g + ' menit') : ''; })(RA.setting('late_grace_minutes')),\n    pkShift: (function (g) { g = +g || 0; return g > 0 ? (g % 60 === 0 ? g / 60 + ' jam' : g + ' menit') : ''; })(S('pickup_late_shift_max_minutes')), pkWait: (function (g) { g = +g || 0; return g > 0 ? (g % 60 === 0 ? g / 60 + ' jam' : g + ' menit') : ''; })(S('pickup_wait_minutes')), freeH: S('free_cancel_hours'), lateRule: S('late_cancel_rule'), cfd: S('cancel_full_days'), cfee: S('cancel_refund_fee_pct'), cpart: S('cancel_partial_pct'), cdays: S('cancel_credit_days'), peaks: S('peak_dates'), region: S('rental_region'), keep: S('docs_retention_months'),\n    lgMin: S('langganan_min_rentals'), lgWin: S('langganan_window_months'), prMin: S('prioritas_min_rentals'), prSpend: S('prioritas_min_spend'), prWin: S('prioritas_window_months'), inc: S('incident_cost_rule'),\n    legal: S('company_legal_name'), addr: S('company_address'), pmail: S('privacy_email'), loc: S('data_location'), lver: S('legal_version') || '1' };\n}\nrenderVals() {\n  const s = this.state, r = this.rules();\n  const seg = on => 'height: 44px; border-radius: 9px; border: none; cursor: pointer; font: 800 14px \"Plus Jakarta Sans\", sans-serif; ' + (on ? 'background: #FFFFFF; color: #1F2B4D; box-shadow: 0 1px 3px rgba(31,43,77,0.15);' : 'background: transparent; color: #4A5468;');\n  const tabs = [['faq', 'FAQ'], ['syarat', 'Syarat'], ['privasi', 'Privasi']].map(([id, label]) => ({ label, on: s.tab === id ? 'true' : 'false', pick: () => this.setState({ tab: id }), style: seg(s.tab === id) }));\n  const J = a => a.filter(Boolean).join(' ');\n  const faq = [];\n  faq.push({ q: 'Apa saja syarat sewa?', a: J([r.docText, r.ktpDep ? 'KTP asli dititipkan di cabang selama sewa.' : '']) });\n  faq.push({ q: 'Kapan saya bayar?', a: J([r.dp != null ? 'DP ' + r.dp + '% setelah dokumen lolos verifikasi, sisanya saat ambil.' : 'Pembayaran dilakukan setelah dokumen lolos verifikasi.', r.noDp ? 'Member Langganan dan Prioritas tanpa DP.' : '']) });\n  const verA = J([r.ver != null ? 'Maksimal ' + r.ver + ' menit' + (r.csS && r.csE ? ' saat CS aktif, ' + r.csS + '–' + r.csE + '.' : '.') : (r.csS && r.csE ? 'Dicek saat CS aktif, ' + r.csS + '–' + r.csE + '.' : ''), r.csS ? 'Booking di luar jam itu dicek mulai ' + r.csS + '.' : '']);\n  if (verA) faq.push({ q: 'Berapa lama verifikasi?', a: verA });\n  faq.push({ q: 'Bagaimana kalau telat mengembalikan?', a: J([r.tol ? 'Ada toleransi ' + r.tol + ' tanpa denda.' : '', r.late != null ? (r.tol ? 'Lewat dari itu, denda ' : 'Denda ') + r.late + '% dari tarif harian per jam' + (r.lateMax != null ? ', maksimal ' + RA.num(r.lateMax) + '× tarif harian' : '') + '.' : '', 'Perpanjang dari HP sebelum waktunya habis supaya tidak kena denda.']) });\n  { const fg = RA.setting('fuel_gauge') || {}; const fees = Object.values(fg).map(x => +x.fee).filter(Boolean); if (fees.length) { const lo = Math.min.apply(null, fees), hi = Math.max.apply(null, fees);\n    faq.push({ q: 'Bagaimana aturan bensin motor?', a: 'Kembalikan motor dengan jumlah strip bensin yang sama seperti saat diserahkan. Strip dicek di layar motor dan difoto saat serah terima. Kurang 1 strip didenda Rp' + lo.toLocaleString('id-ID') + (hi !== lo ? ' (PCX Rp' + hi.toLocaleString('id-ID') + ')' : '') + ' per strip; strip yang berkedip dihitung kosong. Mengisi sendiri di SPBU lebih hemat. Kelebihan bensin tidak dikembalikan.' }); } }\n  faq.push({ q: 'Bagaimana kalau telat mengambil?', a: J([r.pkShift ? 'Telat sampai ' + r.pkShift + ', jam kembali ikut kami mundurkan sebesar keterlambatannya, jadi waktu sewa tetap penuh (selama unit tidak dipakai booking berikutnya). Lebih dari ' + r.pkShift + ', jam kembali hanya mundur ' + r.pkShift + '.' : 'Jam kembali tetap sesuai jadwal.', r.pkWait ? 'Unit kami tahan sampai ' + r.pkWait + ' dari jadwal ambil. Lewat dari itu tanpa kabar, booking dianggap tidak datang: DP tidak dikembalikan tetapi jadi saldo yang bisa dipakai booking lagi dalam 30 hari, dan kelebihan bayar di atas DP dikembalikan.' : '', 'Kalau bakal telat, kabari cabang lewat WhatsApp.']) });\n  const fmtD = x => { const d = new Date(x + 'T00:00:00'); return d.getDate() + ' ' + ['Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agu','Sep','Okt','Nov','Des'][d.getMonth()] + ' ' + d.getFullYear(); };\n  const peakTxt = Array.isArray(r.peaks) && r.peaks.length ? r.peaks.map(x => (x.label ? x.label + ', ' : '') + fmtD(x.from) + '–' + fmtD(x.to)).join('; ') : '';\n  const cancelPolicy = r.cfd != null ? J(['Batal paling lambat ' + r.cfd + ' hari sebelum jadwal ambil: DP kembali 100% sebagai saldo Rentalaja (berlaku ' + (r.cdays || 90) + ' hari), atau uang kembali dipotong biaya admin ' + (r.cfee || 25) + '% dari DP.',\n    'Batal 1–' + r.cfd + ' hari sebelum ambil: ' + (r.cpart || 50) + '% DP jadi saldo, sisanya hangus. Atau ganti jadwal 1 kali tanpa potongan.',\n    'Batal kurang dari 24 jam sebelum ambil atau tidak datang: DP tidak dikembalikan, tetapi jadwal bisa diganti 1 kali dalam 30 hari.',\n    'Booking di tanggal ramai' + (peakTxt ? ' (' + peakTxt + ')' : '') + ': DP tidak bisa dikembalikan, hanya bisa ganti jadwal.',\n    'Batal dan ganti jadwal bisa langsung dari halaman status booking. Aturan ini berlaku untuk booking mulai 13 November 2026; booking sebelumnya memakai aturan lama.']) : null;\n  faq.push({ q: 'Bisa batal atau ubah jadwal?', a: cancelPolicy || J([r.freeH != null ? 'Gratis sampai ' + r.freeH + ' jam sebelum jadwal ambil, DP kembali penuh.' : 'Bisa, lewat menu Ubah atau batalkan di halaman booking.', r.lateRule ? 'Lewat dari itu: ' + r.lateRule + '.' : '']) });\n  const catName = id => (s.cats.find(c => c.id === id) || {}).name;\n  // promo gratis hari: sumber tunggal RA.promoFree (teks dibuat server dari aturan yang dipakai menghitung harga)\n  if (s.free) { const p = s.free;\n    faq.push({ q: 'Apa itu promo sewa ' + p.tiers[0].buy + ' hari gratis ' + p.tiers[0].free + ' hari?', a: J([p.label, p.categories ? 'Berlaku untuk ' + p.categories.toLowerCase() + '.' : '', p.scope + '.', 'Potongannya dihitung otomatis saat booking.']) });\n  }\n  const lv = [r.lgMin != null ? r.lgMin + ' sewa tanpa pelanggaran' + (r.lgWin != null ? ' dalam ' + r.lgWin + ' bulan' : '') + ' jadi Langganan' : '', (r.prMin != null || r.prSpend != null) ? [r.prMin != null ? r.prMin + ' sewa' : '', r.prSpend != null ? 'total ' + RA.rp(r.prSpend) : ''].filter(Boolean).join(' atau ') + (r.prWin != null ? ' dalam ' + r.prWin + ' bulan' : '') + ' jadi Prioritas' : ''].filter(Boolean);\n  if (lv.length) faq.push({ q: 'Bagaimana cara naik level member?', a: lv.join(', ') + '.' });\n  const seen = {}; const cms = s.cms.map(x => ({ q: x.title, a: [x.subtitle, x.body].filter(Boolean).join('\\n') })).filter(x => x.q && x.a);\n  const all = cms.concat(faq).filter(x => { const k = x.q.toLowerCase().replace(/\\s+(motor|barang)\\?$/, '?'); if (seen[k]) return false; seen[k] = 1; return true; });\n  const who = r.legal ? r.legal + ' (Rentalaja)' : 'Rentalaja';\n  const terms = [\n    'Penyewa wajib menyerahkan ' + r.docText.replace(/^KTP/, 'foto KTP').replace(/\\.$/, '') + ' yang masih berlaku, atas nama penyewa sendiri.',\n    r.ktpDep ? 'KTP asli dititipkan di cabang selama masa sewa dan dikembalikan saat barang kembali.' : '',\n    'Booking terkunci setelah dikirim. Rentalaja berhak menolak booking bila dokumen tidak sesuai atau penyewa masuk daftar hitam.',\n    r.dp != null ? 'DP minimal ' + r.dp + '% dari total sewa dibayar setelah lolos verifikasi. Sisa dibayar saat ambil.' : 'Pembayaran diminta setelah lolos verifikasi.',\n    'Barang dipakai sesuai fungsinya, dijaga, tidak diubah, dan tidak dipakai untuk kegiatan yang melanggar hukum.',\n    'Untuk kendaraan: penyewa wajib punya SIM yang berlaku dan mematuhi aturan lalu lintas. Tilang, parkir, dan denda lain selama masa sewa menjadi tanggungan penyewa.',\n    'Barang dikembalikan lengkap, bersih, dan tepat waktu ke tempat yang disepakati. Kondisi dicek bersama dan difoto saat serah terima.',\n    r.late != null ? (r.tol ? 'Ada toleransi keterlambatan ' + r.tol + '. Lewat dari itu dikenai denda ' : 'Keterlambatan dikenai denda ') + r.late + '% dari tarif harian per jam' + (r.lateMax != null ? ', maksimal ' + RA.num(r.lateMax) + '× tarif harian' : '') + '. Perpanjang dari aplikasi sebelum waktunya habis.' : 'Perpanjang dari aplikasi sebelum waktu sewa habis.',\n    J(['Kerusakan atau kehilangan karena kelalaian penyewa ditanggung penyewa sesuai biaya perbaikan atau penggantian.', r.inc ? r.inc + '.' : '']),\n    (r.cfd != null ? J(['Pembatalan: batal paling lambat ' + r.cfd + ' hari sebelum jadwal ambil, DP kembali 100% sebagai saldo Rentalaja (berlaku ' + (r.cdays || 90) + ' hari) atau uang kembali dipotong biaya admin ' + (r.cfee || 25) + '% dari DP.',\n      'Batal 1–' + r.cfd + ' hari sebelum ambil: ' + (r.cpart || 50) + '% DP jadi saldo, sisanya hangus, atau ganti jadwal 1 kali tanpa potongan.',\n      'Batal kurang dari 24 jam sebelum ambil atau tidak datang: DP tidak dikembalikan, jadwal bisa diganti 1 kali dalam 30 hari.',\n      'Tanggal ramai' + (Array.isArray(r.peaks) && r.peaks.length ? ' (' + r.peaks.map(x => x.label || (x.from + '–' + x.to)).join(', ') + ')' : '') + ': DP tidak bisa dikembalikan, hanya ganti jadwal.'])\n     : J([r.freeH != null ? 'Pembatalan gratis sampai ' + r.freeH + ' jam sebelum jadwal ambil.' : 'Booking bisa dibatalkan atau diubah dari aplikasi.', r.lateRule ? r.lateRule + '.' : ''])),\n    r.region ? 'Barang tidak boleh disewakan ulang, dipindahtangankan, atau dibawa ke luar wilayah ' + r.region + ' tanpa izin.' : 'Barang tidak boleh disewakan ulang atau dipindahtangankan tanpa izin.',\n    'Tidak ada pihak yang bertanggung jawab atas keterlambatan karena keadaan kahar (bencana alam, kerusuhan, larangan pemerintah). Jadwal disesuaikan bersama.',\n    'Data pribadi penyewa diproses sesuai Kebijakan privasi di halaman ini.',\n    'Syarat ini tunduk pada hukum Indonesia. Perselisihan diselesaikan dulu secara musyawarah; bila tidak tercapai, melalui pengadilan negeri di wilayah cabang tempat sewa.',\n    'Bila syarat ini berubah, versinya dinaikkan dan Anda diminta menyetujui ulang pada booking berikutnya.'\n  ].filter(Boolean);\n  const br = s.branch || {};\n  const phone = br.phone || '';\n  const fmtPhone = p => '+' + p.slice(0, 2) + ' ' + p.slice(2, 5) + '-' + p.slice(5, 9) + '-' + p.slice(9);\n  const privacy = [\n    { t: 'Siapa kami', d: who + ' adalah pengendali data pribadi Anda di aplikasi ini.' + (r.addr ? ' Alamat: ' + r.addr + '.' : '') },\n    { t: 'Data yang kami kumpulkan', d: 'Nama, nomor WhatsApp, foto KTP dan dokumen pendukung, riwayat booking dan pembayaran, foto unit saat serah terima, alamat atau lokasi antar-jemput, percakapan dengan CS, dan ulasan. Nomor kartu atau rekening tidak kami simpan; pembayaran diproses penyedia pembayaran.\\nSaat Anda membuka rentalaja.co.id, kami juga mencatat halaman yang dibuka, jenis perangkat dan browser, perkiraan kota, asal kunjungan (misalnya dari Instagram atau Google), dan tombol yang diklik seperti WhatsApp atau Booking. Data ini dicatat lewat Google Analytics, Meta Pixel, dan statistik halaman link kami, tanpa nama, nomor WhatsApp, atau isi dokumen Anda.' },\n    { t: 'Untuk apa dan dasarnya', d: '• Menjalankan perjanjian sewa: booking, verifikasi identitas, serah terima, penagihan, pengingat.\\n• Kewajiban hukum: pencatatan keuangan dan pajak.\\n• Kepentingan yang sah: mencegah penipuan dan menjaga keamanan barang.\\n• Kepentingan yang sah: memahami halaman dan informasi mana yang membantu pelanggan, lalu memperbaiki situs.\\n• Kepentingan yang sah: mengukur hasil iklan Rentalaja di Instagram dan Facebook dan menampilkan iklan ke orang yang pernah membuka situs.\\n• Persetujuan Anda: promo lewat WhatsApp. Bisa dihentikan kapan saja.' },\n    { t: 'Siapa yang bisa melihat', d: 'Hanya staf yang tugasnya memerlukan, misalnya CS verifikasi dan kepala cabang. Setiap pembukaan dokumen identitas dari aplikasi tercatat. Pihak lain yang ikut memproses atas nama kami: penyedia server dan database, penyedia pembayaran, penyedia WhatsApp, Google (Google Analytics) untuk statistik kunjungan situs, serta Meta (Meta Pixel) untuk mengukur dan menampilkan iklan Rentalaja. Kami tidak menjual data pribadi Anda. Yang dibagikan ke Meta hanya data kunjungan situs (halaman yang dibuka, tombol yang diklik, dan nilai booking), tanpa nama, nomor WhatsApp, atau dokumen. Data juga dibuka bila diminta aparat berwenang sesuai hukum.' },\n    { t: 'Cookie', d: 'Google Analytics dan Meta Pixel memakai cookie di browser Anda untuk membedakan kunjungan dan mengukur iklan. Anda bisa menolaknya dengan memblokir cookie di pengaturan browser, memasang Google Analytics Opt-out Add-on, dan mengatur preferensi iklan di Pusat Akun Meta.' },\n    r.loc ? { t: 'Di mana data disimpan', d: 'Di server ' + r.loc + '. Kami memilih penyedia yang menerapkan perlindungan data setara atau lebih tinggi dari UU Pelindungan Data Pribadi.' } : null,\n    { t: 'Berapa lama disimpan', d: J([r.keep != null ? 'Foto KTP dan dokumen identitas dihapus otomatis ' + r.keep + ' bulan setelah sewa terakhir, kecuali masih ada sewa atau tagihan berjalan, atau Anda masuk daftar hitam.' : 'Foto KTP dan dokumen identitas disimpan selama diperlukan untuk sewa, lalu dihapus.', 'Catatan transaksi disimpan sesuai ketentuan perpajakan dan dokumen perusahaan.']) },\n    { t: 'Cara kami menjaganya', d: 'Koneksi terenkripsi, penyimpanan dokumen privat, akses berdasarkan peran, verifikasi dua langkah untuk owner dan keuangan, dan log audit. Bila terjadi kebocoran data, kami memberi tahu Anda dan otoritas paling lambat 3×24 jam.' },\n    { t: 'Hak Anda', d: 'Meminta salinan, membetulkan, atau menghapus data; menarik persetujuan; dan menolak keputusan yang sepenuhnya otomatis. Verifikasi selalu diperiksa tim, bukan hanya mesin.' + (r.pmail ? ' Email: ' + r.pmail + '.' : '') + (phone ? ' WhatsApp: ' + fmtPhone(phone) + '.' : '') }\n  ].filter(Boolean);\n  const reqLabels = [['copy', 'Minta salinan data'], ['fix', 'Minta koreksi data'], ['delete', 'Minta hapus data'], ['withdraw', 'Tarik persetujuan']];\n  const rights = reqLabels.map(([k, label]) => ({ label, go: this.act(async () => {\n    this.setState({ reqDone: '', reqErr: '' });\n    try { const t = await RA.call('request_my_data', { p_kind: k }); this.setState({ reqDone: 'Permintaan tercatat dengan nomor ' + t.code + '. Tim kami menghubungi Anda lewat WhatsApp paling lambat 3×24 jam.' }); }\n    catch (e) { this.setState({ reqErr: RA.friendly(e.message) }); }\n  }) }));\n  return {\n    tabs, isFaq: s.tab === 'faq', isSyarat: s.tab === 'syarat', isPrivasi: s.tab === 'privasi',\n    faq: all, terms, privacy, rights, loggedIn: RA.isLoggedIn(), busy: !!s.busy, reqDone: s.reqDone || '', reqErr: s.reqErr || '',\n    partyLine: 'Syarat ini berlaku antara penyewa dan ' + who + (r.addr ? ', ' + r.addr : '') + '.', legalVersion: r.lver,\n    csHours: r.csS && r.csE ? 'CS aktif ' + r.csS + '–' + r.csE : '',\n    waHref: phone ? 'https://wa.me/' + phone + '?text=' + encodeURIComponent('Halo CS Rentalaja, saya mau tanya.') : ''\n  };\n}\n}\n</script>\n</body>\n</html>\n"}