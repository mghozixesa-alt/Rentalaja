{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Buka hari</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0}\n.bh-card{background:#FFFFFF;border-radius:20px;box-shadow:0 8px 24px rgba(31,43,77,0.08);padding:6px 16px}\n.bh-h{font-size:12px;font-weight:800;letter-spacing:0.06em;text-transform:uppercase;color:#077A70;padding:10px 0 2px}\n.bh-row{display:flex;gap:12px;padding:12px 0;border-bottom:1px solid #EEF0F3}\n.bh-row:last-child{border-bottom:0}\n.bh-in{width:100%;box-sizing:border-box;min-height:44px;border-radius:12px;border:1px solid #CBD2DE;padding:10px 12px;font:500 13px 'Plus Jakarta Sans',sans-serif;color:#1F2B4D;resize:vertical}\n.bh-btn{min-height:40px;padding:0 12px;border-radius:10px;border:0;background:#077A70;color:#FFFFFF;font:800 12.5px 'Plus Jakarta Sans',sans-serif;cursor:pointer;display:inline-flex;align-items:center;text-decoration:none}\n@media (min-width:1000px){.bh-wrap{padding-top:24px}}\n</style>\n</helmet>\n<div style=\"min-height: 100vh; box-sizing: border-box; background: #F3F5F8; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; color: #1F2B4D; padding-bottom: 110px\">\n <div class=\"bh-wrap\" style=\"max-width: 560px; margin: 0 auto; display: flex; flex-direction: column; gap: 14px\">\n  <header style=\"padding: 16px 16px 0; display: flex; align-items: center; gap: 10px\">\n    <a href=\"OpsManajer.dc.html\" aria-label=\"Kembali\" style=\"flex: none; width: 44px; height: 44px; border-radius: 14px; background: #FFFFFF; box-shadow: 0 4px 12px rgba(31,43,77,0.10); display: flex; align-items: center; justify-content: center\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1F2B4D\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M15 18l-6-6 6-6\"></path></svg></a>\n    <div style=\"flex: 1; min-width: 0\">\n      <div style=\"font-size: 18px; line-height: 24px; font-weight: 800\">Buka hari</div>\n      <div style=\"font-size: 12px; font-weight: 700; color: #4A5468\">{{dayLabel}} · 09.00–10.00 · blok KKH pertama</div>\n    </div>\n    <span style=\"{{pill}}\">{{okTxt}}</span>\n  </header>\n\n  <div style=\"{{banner}}\">{{bannerTxt}}</div>\n\n  <sc-if value=\"{{ready}}\" hint-placeholder-val=\"{{true}}\">\n  <div style=\"display: flex; flex-direction: column; gap: 14px\">\n  <sc-for list=\"{{secs}}\" as=\"g\" hint-placeholder-count=\"2\">\n    <section class=\"bh-card\" style=\"margin: 0 16px\">\n      <div class=\"bh-h\">{{g.title}}</div>\n      <sc-for list=\"{{g.items}}\" as=\"it\" hint-placeholder-count=\"4\">\n        <div class=\"bh-row\">\n          <span style=\"{{it.box}}\"><sc-if value=\"{{it.ok}}\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg></sc-if><sc-if value=\"{{it.bad}}\">!</sc-if></span>\n          <div style=\"flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6px\">\n            <div><b style=\"display: block; font-size: 14px\">{{it.label}}</b><span style=\"{{it.subStyle}}\">{{it.sub}}</span></div>\n            <sc-if value=\"{{it.showNote}}\"><div style=\"display: flex; flex-direction: column; gap: 4px\">\n              <label style=\"font-size: 12px; font-weight: 700; color: #4A5468\">Catatan (wajib kalau belum beres)</label>\n              <textarea class=\"bh-in\" rows=\"2\" placeholder=\"Apa penyebabnya & siapa yang menindaklanjuti\" onInput=\"{{it.setNote}}\">{{it.note}}</textarea>\n            </div></sc-if>\n            <div style=\"display: flex; gap: 8px; flex-wrap: wrap\">\n              <sc-if value=\"{{it.hasHref}}\"><a href=\"{{it.href}}\" class=\"bh-btn\" style=\"background: #FFFFFF; color: #1F2B4D; border: 1px solid #CBD2DE\">Buka</a></sc-if>\n              <sc-if value=\"{{it.isIdle}}\"><button type=\"button\" class=\"bh-btn\" onClick=\"{{pushIdle}}\">Dorong ke CS lewat WA</button></sc-if>\n            </div>\n          </div>\n        </div>\n      </sc-for>\n    </section>\n  </sc-for>\n\n  <section class=\"bh-card\" style=\"margin: 0 16px; padding: 16px; display: flex; flex-direction: column; gap: 8px\">\n    <label for=\"bh-note\" style=\"font-size: 12px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: #077A70\">Catatan untuk CEO (opsional)</label>\n    <textarea id=\"bh-note\" class=\"bh-in\" rows=\"3\" placeholder=\"Usulan, kendala, atau hal yang perlu keputusan\" onInput=\"{{setMain}}\">{{mainNote}}</textarea>\n  </section>\n\n  <div style=\"margin: 0 16px\">\n    <button type=\"button\" onClick=\"{{submit}}\" style=\"{{submitStyle}}\">{{submitTxt}}</button>\n    <div style=\"font-size: 11.5px; line-height: 16px; color: #4A5468; text-align: center; margin-top: 6px\">Laporan terkirim ke CEO jam 10.00. Belum dibuka sampai 10.00: tetap terkirim dengan tanda \"belum dicek manajer\".</div>\n  </div>\n  </div>\n  </sc-if>\n </div>\n</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{\"$preview\":{\"width\":390,\"height\":1180}}'>\nclass Component extends DCLogic {\nstate = { d: null, notes: {}, main: null, busy: false };\nasync componentDidMount() { await RA.staff(); this.load(); }\nasync load() {\n  try { const d = await RA.call('ops_mgr_today', {}); if (!RA_ALIVE(this)) return; this.setState({ d }); } catch (e) { RA.err(e); }\n}\nasync pushIdle() {\n  try { const n = await RA.call('ops_idle_push', {}); RA.toast(n > 0 ? 'Terkirim ke ' + n + ' CS lewat WA' : 'Tidak ada CS dengan nomor WA', n > 0 ? 'ok' : 'bad'); this.load(); } catch (e) { RA.err(e); }\n}\nasync submit() {\n  if (this.state.busy) return; this.setState({ busy: true });\n  const notes = {}; Object.keys(this.state.notes).forEach(k => { const v = (this.state.notes[k] || '').trim(); if (v) notes[k] = v; });\n  try { await RA.call('ops_day_open', { p_notes: notes, p_note: this.state.main == null ? '' : this.state.main }); RA.toast('Hari dibuka. Laporan siap dikirim ke CEO jam 10.00', 'ok'); await this.load(); }\n  catch (e) { RA.err(e); }\n  if (RA_ALIVE(this)) this.setState({ busy: false });\n}\nrenderVals() {\n  const s = this.state, d = s.d, now = new Date();\n  const dayLabel = now.toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'short' });\n  const items = (d && d.items) || [];\n  const ok = items.filter(i => i.ok).length;\n  const mk = i => {\n    const note = s.notes[i.key] != null ? s.notes[i.key] : (i.note_text || '');\n    const warnNote = i.n > 0 && i.action !== 'idle';\n    return Object.assign({}, i, {\n      ok: !!i.ok && !(i.n > 0), bad: i.n > 0 && !i.note_text, note,\n      showNote: !!warnNote,\n      box: 'flex: none; width: 28px; height: 28px; border-radius: 9px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 800; ' +\n        (i.n > 0 ? (i.note_text ? 'background: #FFF0DC; border: 2px solid #9A5B00; color: #6B3E00' : 'background: #FDE8E6; border: 2px solid #C0392B; color: #9B2C20') : 'background: #077A70'),\n      subStyle: 'font-size: 12px; ' + (i.n > 0 ? 'color: #9B2C20; font-weight: 700' : 'color: #4A5468'),\n      hasHref: !!i.href && i.n > 0, href: (i.href || '') + '.dc.html', isIdle: i.action === 'idle' && i.n > 0,\n      setNote: e => { const n = Object.assign({}, this.state.notes); n[i.key] = e.target.value; this.setState({ notes: n }); }\n    });\n  };\n  const secs = [['kemarin', '1 · Beres-beres kemarin'], ['hari', '2 · Siap hari ini']].map(([k, t]) => ({ title: t, items: items.filter(i => i.sec === k).map(mk) }));\n  const opened = d && d.opened_at;\n  return {\n    dayLabel, ready: !!d, secs, okTxt: ok + '/' + items.length,\n    pill: 'flex: none; font-size: 12px; font-weight: 800; padding: 6px 10px; border-radius: 999px; ' + (ok === items.length && items.length ? 'background: #E3F4F1; color: #055C55' : 'background: #FFF0DC; color: #6B3E00'),\n    banner: 'margin: 0 16px; border-radius: 16px; padding: 12px 14px; font-size: 12.5px; line-height: 18px; font-weight: 600; ' + (opened ? 'background: #E3F4F1; color: #055C55' : 'background: #E8EEF8; color: #1F2B4D'),\n    bannerTxt: opened ? 'Hari sudah dibuka jam ' + RA.time(opened) + '. Anda masih bisa menambah catatan sampai laporan terkirim jam 10.00.' : 'Daftar ini disiapkan sistem dari data kemarin dan jadwal hari ini. Yang hijau sudah beres otomatis. Yang merah: bereskan, atau beri catatan.',\n    mainNote: s.main != null ? s.main : '', setMain: e => this.setState({ main: e.target.value }),\n    pushIdle: () => this.pushIdle(), submit: () => this.submit(),\n    submitTxt: s.busy ? 'Menyimpan…' : opened ? 'Simpan catatan' : 'Buka hari',\n    submitStyle: 'width: 100%; min-height: 52px; border-radius: 16px; border: 0; background: #1F2B4D; color: #FFFFFF; font: 800 15px \\'Plus Jakarta Sans\\', sans-serif; cursor: pointer'\n  };\n}\n}\n</script>\n</body>\n</html>\n"}