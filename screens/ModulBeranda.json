{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Beranda</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0}\n.mb-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px 6px}\n.mb-it{display:flex;flex-direction:column;align-items:center;gap:6px;text-decoration:none;color:#1F2B4D;font-size:12px;line-height:15px;font-weight:600;text-align:center;position:relative}\n.mb-ic{width:50px;height:50px;border-radius:16px;display:flex;align-items:center;justify-content:center;position:relative}\n.mb-ic img{width:24px;height:24px}\n.mb-row{display:flex;gap:12px;align-items:center;padding:12px 0;border-bottom:1px solid #EEF0F3;text-decoration:none;color:#1F2B4D}\n.mb-row:last-child{border-bottom:0}\n@media (min-width:1000px){.mb-wrap{padding-top:24px}}\n</style>\n</helmet>\n<div style=\"min-height: 100vh; box-sizing: border-box; background: #F4F6F9; color: #1F2B4D; font-family: 'Plus Jakarta Sans', system-ui, sans-serif\">\n <div class=\"mb-wrap\" style=\"max-width: 560px; margin: 0 auto\">\n  <header style=\"background: linear-gradient(170deg, #0A9E92 0%, #077A70 100%); padding: 14px 16px 64px; color: #FFFFFF; border-radius: 0 0 0 0\">\n    <div style=\"display: flex; align-items: center; gap: 10px\"><img src=\"logo.png\" alt=\"Rentalaja\" style=\"height: 24px; width: auto; background: #FFFFFF; border-radius: 8px; padding: 4px 8px\"><span style=\"font-size: 14px; font-weight: 700; opacity: .95\">{{modTitle}} · {{scope}}</span></div>\n    <sc-if value=\"{{hasMods}}\"><div style=\"display: flex; gap: 6px; margin-top: 12px; overflow-x: auto\"><sc-for list=\"{{mods}}\" as=\"m\"><button type=\"button\" onClick=\"{{m.pick}}\" style=\"{{m.style}}\">{{m.label}}</button></sc-for></div></sc-if>\n    <div style=\"display: flex; align-items: center; gap: 12px; margin-top: 14px\">\n      <span style=\"width: 48px; height: 48px; border-radius: 24px; background: #FFFFFF; color: #077A70; font-size: 16px; font-weight: 800; display: flex; align-items: center; justify-content: center; flex: none\">{{ini}}</span>\n      <span style=\"min-width: 0; flex: 1\"><b style=\"display: block; font-size: 19px; line-height: 24px\">{{hello}}</b><span style=\"font-size: 13px; opacity: .9\">{{roleName}}</span></span>\n    </div>\n  </header>\n  <main style=\"padding: 0 16px 24px; margin-top: -48px; display: flex; flex-direction: column; gap: 16px\">\n    <section style=\"background: #FFFFFF; border-radius: 20px; box-shadow: 0 10px 28px rgba(31,43,77,.12); padding: 14px 16px 16px\">\n      <div style=\"display: flex; justify-content: space-between; align-items: baseline\"><b style=\"font-size: 15px\">{{card.title}}</b><span style=\"font-size: 12px; color: #6B7486\">{{clock}}</span></div>\n      <div style=\"display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin: 10px 0 14px\">\n        <sc-for list=\"{{card.stats}}\" as=\"x\"><a href=\"{{x.href}}\" style=\"text-decoration: none; color: #1F2B4D; padding: 0 10px; border-left: 1px solid #EEF0F3; {{x.first}}\"><b style=\"display: block; font-size: 24px; line-height: 30px; color: {{x.c}}\">{{x.v}}</b><span style=\"font-size: 12px; line-height: 15px; color: #4A5468\">{{x.l}}</span></a></sc-for>\n      </div>\n      <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 8px\">\n        <a href=\"{{card.b1h}}\" style=\"height: 44px; border-radius: 12px; background: linear-gradient(135deg, #12B5A6, #077A70); color: #FFFFFF; font-size: 14px; font-weight: 800; display: flex; align-items: center; justify-content: center; text-decoration: none; box-shadow: 0 6px 14px rgba(7,122,112,.25)\">{{card.b1}}</a>\n        <a href=\"{{card.b2h}}\" style=\"height: 44px; border-radius: 12px; border: 1.5px solid #E3E7ED; color: #1F2B4D; font-size: 14px; font-weight: 800; display: flex; align-items: center; justify-content: center; text-decoration: none\">{{card.b2}}</a>\n      </div>\n    </section>\n\n    <section>\n      <div style=\"display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 10px\"><b style=\"font-size: 17px\">Menu</b><button type=\"button\" onClick=\"{{toggleAll}}\" style=\"border: 0; background: none; color: #077A70; font: 800 13px 'Plus Jakarta Sans', sans-serif; cursor: pointer; padding: 0\">{{allLabel}}</button></div>\n      <div style=\"background: #FFFFFF; border-radius: 20px; padding: 16px 10px; box-shadow: 0 2px 10px rgba(31,43,77,.05)\"><div class=\"mb-grid\">\n        <sc-for list=\"{{menu}}\" as=\"m\"><a class=\"mb-it\" href=\"{{m.href}}\"><span class=\"mb-ic\" style=\"background: {{m.bg}}\"><img src=\"{{m.ic}}\" alt=\"\"><sc-if value=\"{{m.n}}\"><span style=\"position: absolute; top: -6px; right: -6px; min-width: 20px; height: 20px; padding: 0 5px; box-sizing: border-box; border-radius: 10px; background: #E5534B; color: #FFFFFF; font-size: 11px; font-weight: 800; display: flex; align-items: center; justify-content: center; border: 2px solid #FFFFFF\">{{m.n}}</span></sc-if><sc-if value=\"{{m.baru}}\"><span style=\"position: absolute; top: -8px; left: 50%; transform: translateX(-50%); height: 17px; padding: 0 6px; border-radius: 9px; background: #077A70; color: #FFFFFF; font-size: 10px; font-weight: 800; display: flex; align-items: center\">Baru</span></sc-if></span>{{m.label}}</a></sc-for>\n        <sc-if value=\"{{moreTile}}\"><button type=\"button\" class=\"mb-it\" onClick=\"{{toggleAll}}\" style=\"border: 0; background: none; cursor: pointer; font-family: inherit; padding: 0\"><span class=\"mb-ic\" style=\"background: #EEF0F3\"><img src=\"{{moreIc}}\" alt=\"\"></span>{{moreTile}}</button></sc-if>\n      </div></div>\n    </section>\n\n    <section>\n      <div style=\"display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 10px\"><b style=\"font-size: 17px\">{{listTitle}}</b><a href=\"{{listHref}}\" style=\"color: #077A70; font-size: 13px; font-weight: 800; text-decoration: none\">Lihat semua</a></div>\n      <div style=\"background: #FFFFFF; border-radius: 20px; padding: 2px 16px; box-shadow: 0 2px 10px rgba(31,43,77,.05)\">\n        <sc-if value=\"{{loading}}\"><div style=\"padding: 18px 0; text-align: center; font-size: 13px; color: #4A5468\">Memuat…</div></sc-if>\n        <sc-if value=\"{{emptyText}}\"><div style=\"padding: 18px 0; text-align: center; font-size: 13px; color: #1E6B45; font-weight: 700\">{{emptyText}}</div></sc-if>\n        <sc-for list=\"{{rows}}\" as=\"r\"><a class=\"mb-row\" href=\"{{r.href}}\">\n          <span style=\"width: 42px; height: 42px; border-radius: 21px; background: {{r.bg}}; color: {{r.fg}}; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 800; flex: none\">{{r.av}}</span>\n          <span style=\"flex: 1; min-width: 0\"><b style=\"display: block; font-size: 14px; line-height: 19px\">{{r.t}}</b><span style=\"font-size: 12.5px; line-height: 17px; color: #4A5468\">{{r.s}}</span></span>\n          <span style=\"{{r.chip}}\">{{r.tag}}</span><span style=\"color: #B4BCC8; font-size: 18px\">›</span></a></sc-for>\n      </div>\n    </section>\n\n    <sc-if value=\"{{banner.t}}\"><a href=\"{{banner.href}}\" style=\"display: flex; gap: 12px; align-items: center; border-radius: 20px; padding: 14px 16px; text-decoration: none; color: #FFFFFF; background: {{banner.bg}}\">\n      <span style=\"width: 42px; height: 42px; border-radius: 12px; background: rgba(255,255,255,.14); display: flex; align-items: center; justify-content: center; flex: none\"><img src=\"{{banner.ic}}\" alt=\"\" style=\"width: 22px; height: 22px\"></span>\n      <span style=\"min-width: 0\"><b style=\"display: block; font-size: 15px; line-height: 20px\">{{banner.t}}</b><span style=\"font-size: 12.5px; line-height: 17px; opacity: .85\">{{banner.s}}</span></span></a></sc-if>\n  </main>\n </div>\n</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{\"$preview\":{\"width\":390,\"height\":844}}'>\nconst P = {\n  home: '<path d=\"M3 11l9-7 9 7\"/><path d=\"M5 10v10h14V10\"/>', chart: '<path d=\"M4 20V10M10 20V4M16 20v-7M22 20H2\"/>', cal: '<rect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"2\"/><path d=\"M8 3v4M16 3v4M3 10h18\"/>',\n  star: '<path d=\"M12 3l2.8 5.8 6.2.9-4.5 4.4 1 6.2L12 17.3 6.5 20.3l1-6.2L3 9.7l6.2-.9z\"/>', users: '<circle cx=\"9\" cy=\"8\" r=\"3.5\"/><path d=\"M2.5 20c1-3.5 3.5-5 6.5-5s5.5 1.5 6.5 5\"/><circle cx=\"17\" cy=\"9\" r=\"2.5\"/><path d=\"M17 14c2.5 0 4 1.5 4.5 4\"/>',\n  head: '<path d=\"M4 15v-3a8 8 0 0 1 16 0v3\"/><rect x=\"3\" y=\"14\" width=\"4\" height=\"6\" rx=\"1.5\"/><rect x=\"17\" y=\"14\" width=\"4\" height=\"6\" rx=\"1.5\"/>', idcard: '<rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"/><circle cx=\"9\" cy=\"12\" r=\"2\"/><path d=\"M14 10h4M14 14h4\"/>',\n  grid: '<rect x=\"4\" y=\"4\" width=\"6\" height=\"6\" rx=\"1.5\"/><rect x=\"14\" y=\"4\" width=\"6\" height=\"6\" rx=\"1.5\"/><rect x=\"4\" y=\"14\" width=\"6\" height=\"6\" rx=\"1.5\"/><rect x=\"14\" y=\"14\" width=\"6\" height=\"6\" rx=\"1.5\"/>',\n  tool: '<path d=\"M14.5 5.5a4 4 0 0 0 4 4l-9 9a2 2 0 0 1-3-3l9-9a4 4 0 0 0-1-1z\"/>', check: '<path d=\"M5 12l5 5 9-10\"/>', bell: '<path d=\"M6 16V11a6 6 0 0 1 12 0v5l2 2H4z\"/><path d=\"M10 20a2 2 0 0 0 4 0\"/>',\n  pin: '<path d=\"M12 21s-7-6.5-7-11a7 7 0 0 1 14 0c0 4.5-7 11-7 11z\"/><circle cx=\"12\" cy=\"10\" r=\"2.5\"/>', box: '<path d=\"M3 7l9-4 9 4v10l-9 4-9-4z\"/><path d=\"M3 7l9 4 9-4M12 11v10\"/>',\n  list: '<path d=\"M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01\"/>', swap: '<path d=\"M4 8h13l-3-3M20 16H7l3 3\"/>', cart: '<circle cx=\"9\" cy=\"20\" r=\"1.5\"/><circle cx=\"18\" cy=\"20\" r=\"1.5\"/><path d=\"M3 4h2l2.5 11h11L21 8H7\"/>',\n  user: '<circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6\"/>', chat: '<path d=\"M4 5h16v11H9l-5 4z\"/>', clock: '<circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3 2\"/>', flag: '<path d=\"M5 21V4h11l-2 4 2 4H5\"/>',\n  shield: '<path d=\"M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z\"/><path d=\"M9 12l2 2 4-4\"/>', truck: '<path d=\"M3 7h11v9H3zM14 10h4l3 3v3h-7\"/><circle cx=\"7\" cy=\"18\" r=\"1.6\"/><circle cx=\"17\" cy=\"18\" r=\"1.6\"/>', calcheck: '<rect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"2\"/><path d=\"M8 3v4M16 3v4M3 10h18M9 15l2 2 4-4\"/>'\n};\nconst IC = (k, c) => 'data:image/svg+xml;utf8,' + encodeURIComponent('<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"' + (c || '#077A70') + '\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">' + (P[k] || P.grid) + '</svg>');\nconst TONE = { g: ['#E3F6F4', '#077A70'], b: ['#E6EEFB', '#1E5AA8'], o: ['#FFF0DC', '#B46A00'], r: ['#FDE8E6', '#C0392B'], p: ['#EFEAFB', '#6A4BC4'], l: ['#E4F4E9', '#1E7A3F'], s: ['#EEF0F3', '#4A5468'] };\n/* menu tiap modul: [halaman, label, ikon, warna, kunci badge, baru] */\nconst MODS = {\n  ops: { title: 'Operasional', card: 'Kondisi hari ini', menu: [['OpsManajer', 'Tugas hari ini', 'calcheck', 'r', '', 1], ['OpsBeranda', 'Dashboard', 'home', 'g'], ['AsetPendapatan', 'Utilisasi & pendapatan aset', 'chart', 'p', '', 1], ['OpsUnit', 'Mutasi antarcabang', 'swap', 'b'], ['OpsKalender', 'Kalender sewa', 'cal', 'b'], ['OpsQC', 'Kualitas layanan', 'star', 'o'], ['OpsKerja', 'Kerja lapangan', 'users', 'l', 'req'], ['PusatCS', 'Pusat CS', 'head', 'b'], ['PosVerifikasi', 'Verifikasi', 'idcard', 'r', 'ver'], ['PosHariIni', 'Rental hari ini', 'calcheck', 'g'], ['MgmtSetuju', 'Persetujuan', 'check', 'l', 'apr'], ['AsetBeranda', 'Aset & servis', 'tool', 'o'], ['PosKasir', 'Kasir', 'cart', 'b'], ['ExpKalender', 'Penginapan', 'home', 'p']] },\n  aset: { title: 'Aset & servis', card: 'Aset hari ini', menu: [['AsetServis', 'Papan servis', 'tool', 'o', 'wo'], ['AsetKalender', 'Kalender unit', 'cal', 'b'], ['PosQC', 'Cek kondisi', 'check', 'l', 'qc'], ['AsetPengingat', 'Pengingat & GPS', 'bell', 'r', '', 1], ['https://app.pokama.org/#/gudang', 'Gudang & stok', 'box', 'o', '', 1], ['AsetPreventif', 'Aturan preventif', 'calcheck', 'o'], ['AsetData', 'Lengkapi data unit', 'list', 'b'], ['AsetUnit', 'Unit aset', 'box', 'p'], ['AsetOpname', 'Stok opname', 'list', 'g'], ['AsetLaporan', 'Laporan aset', 'chart', 'o'], ['AsetRisiko', 'Kontrol aset', 'shield', 'r'], ['AsetTim', 'Tim teknisi', 'users', 'l'], ['AsetBeranda', 'Hari ini (aset)', 'home', 'g']] },\n  cs: { title: 'Pusat CS', card: 'Antrean CS', menu: [['CekPenyewa', 'Cek calon penyewa', 'shield', 'g', '', 1], ['PosVerifikasi', 'Verifikasi', 'idcard', 'r', 'ver'], ['PosHariIni', 'Jadwal', 'cal', 'b'], ['PosKasir', 'Booking walk-in', 'cart', 'o'], ['PusatCS', 'Kelola booking', 'swap', 'b'], ['PosPelanggan', 'Pelanggan', 'user', 'p'], ['TiketCS', 'Tiket keluhan', 'chat', 'l', 'tk'], ['MgmtInbox', 'Inbox WA', 'chat', 'g'], ['OpsKalender', 'Kalender', 'calcheck', 'o'], ['LaporanShift', 'Laporan shift', 'chart', 's'], ['AlatChat', 'Template chat', 'list', 's']] },\n  kasir: { title: 'Kasir cabang', card: 'Serah terima hari ini', menu: [['PosSerahTerima', 'Serahkan & terima', 'swap', 'g', 'out'], ['PosKasir', 'Kasir', 'cart', 'o'], ['CekPenyewa', 'Cek calon penyewa', 'shield', 'g', '', 1], ['PosVerifikasi', 'Verifikasi', 'idcard', 'r', 'ver'], ['PosHariIni', 'Rental hari ini', 'cal', 'b'], ['PosPelanggan', 'Pelanggan', 'user', 'p'], ['PosUnit', 'Stok unit', 'box', 'l'], ['PosShift', 'Shift & tutup kas', 'clock', 's'], ['AsetTandai', 'Lapor unit rusak', 'flag', 'r'], ['Runner', 'Antar-jemput', 'truck', 'b'], ['MgmtDaftarHitam', 'Daftar hitam', 'shield', 's']] },\n  exp: { title: 'Penginapan & Jeep', card: 'Tamu & trip hari ini', menu: [['ExpKalender', 'Kalender penginapan', 'cal', 'b'], ['ExpJeep', 'Jadwal jeep', 'truck', 'o'], ['KonfirmasiTransfer', 'Konfirmasi transfer', 'check', 'g'], ['Housekeeping', 'Kamar & housekeeping', 'home', 'l'], ['PosVerifikasi', 'Verifikasi', 'idcard', 'r', 'ver'], ['PusatCS', 'Kelola booking', 'swap', 'p']] },\n  tek: { title: 'Teknisi', card: 'Pekerjaan servis', menu: [['Teknisi', 'Antrean servis', 'tool', 'o', 'wo'], ['TekBelanja', 'Belanja part', 'cart', 'b'], ['TekAkun', 'Akun & kinerja', 'user', 'p'], ['PosQC', 'Cek kondisi', 'check', 'l', 'qc'], ['AsetTandai', 'Lapor unit rusak', 'flag', 'r']] },\n  lap: { title: 'Lapangan', card: 'Tugas lapangan hari ini', menu: [['AgendaLapangan', 'Agenda hari ini', 'cal', 'g'], ['Runner', 'Antar-jemput', 'truck', 'b'], ['Housekeeping', 'Housekeeping', 'home', 'l'], ['SopirJeep', 'Sopir jeep', 'truck', 'o'], ['AkunLapangan', 'Akun saya', 'user', 'p']] }\n};\nconst ROLE_MOD = { owner: 'ops', viewer: 'ops', experience_manager: 'ops', asset_manager: 'aset', cs: 'cs', cs_experience: 'cs', technician: 'tek', runner: 'lap', driver: 'lap', qc: 'lap', cashier: 'kasir', staff: 'kasir', branch_head: 'kasir' };\nconst ROLE_NAME = { owner: 'Owner', viewer: 'Pemantau', experience_manager: 'Manajer Operasional', asset_manager: 'Manajer Aset', cs: 'Customer Service', cs_experience: 'CS Experience', cashier: 'Kasir', staff: 'Kasir + Teknisi', branch_head: 'Kepala cabang', technician: 'Teknisi', runner: 'Petugas lapangan', driver: 'Sopir', qc: 'Petugas QC' };\nclass Component extends DCLogic {\nstate = { mod: null, d: null, all: false };\nasync componentDidMount() {\n  await RA.staff();\n  const q = new URLSearchParams((location.hash.split('?')[1]) || ''); const m = q.get('m');\n  let saved = null; try { saved = localStorage.getItem('ra.mb.mod'); } catch (e) {}\n  const role = (RA._staff || {}).role;\n  this.setState({ mod: MODS[m] ? m : ['owner', 'chief_of_staff', 'experience_manager'].indexOf(role) > -1 && MODS[saved] ? saved : ROLE_MOD[role] || 'kasir' });\n  this.stop = RA.poll(this, () => this.reload(), 60000);\n}\ncomponentWillUnmount() { if (this.stop) this.stop(); }\npageOk(p) { const pp = RA.PAGE_PERM && RA.PAGE_PERM[p]; return pp == null || [].concat(pp).some(x => RA.can(x)); }\nasync reload() {\n  const st = RA._staff || {}; const role = st.role;\n  const branchMode = ['cashier', 'staff', 'branch_head'].indexOf(role) > -1; const br = branchMode ? RA.staffBranch() : null;\n  const t0 = new Date(); t0.setHours(0, 0, 0, 0);\n  const B = x => br ? x.eq('branch_id', br.id) : x;\n  const none = Promise.resolve({ data: [], count: 0 });\n  const t2 = new Date(t0.getTime() + 864e5);\n  const [bk, un, wo, tk, ap, md, rt] = await Promise.all([\n    B(RA.from('bookings').select('id,code,status,start_at,end_at,created_at,guest_name,total,paid_amount,branch_id,branches(name),booking_items(products(name,categories(kind)),units(code,plate_or_serial))').in('status', ['pending_verification', 'awaiting_payment', 'confirmed', 'active']).lt('start_at', new Date(t0.getTime() + 3 * 864e5).toISOString()).gt('end_at', new Date(t0.getTime() - 30 * 864e5).toISOString()).order('start_at').limit(500)),\n    B(RA.from('units').select('id,status,branch_id').is('archived_at', 'null').limit(3000)),\n    RA.can('mgmt.assets') || RA.can('field.workorder') ? RA.from('work_orders').select('id,code,status,complaint,target_at,created_at,units(code,name,plate),branches(name)').in('status', ['queued', 'working', 'waiting_part', 'qc']).order('target_at').limit(200) : none,\n    RA.from('tickets').select('id', { count: 'exact', head: true }).eq('status', 'open'),\n    RA.can('mgmt.approvals') || RA.can('finance.approve') ? RA.from('approvals').select('id', { count: 'exact', head: true }).eq('status', 'pending') : { count: 0 },\n    RA.rpc('ops_dash', {}).then(x => x, () => ({ data: null })),\n    RA.can('field.runner') || RA.can('field.driver') || ['runner', 'driver', 'qc', 'owner', 'experience_manager', 'chief_of_staff'].indexOf(role) > -1 ? RA.from('runner_tasks').select('id,kind,status,scheduled_at,address,runner_id,branches(name),bookings(code,guest_name)').gte('scheduled_at', t0.toISOString()).lt('scheduled_at', t2.toISOString()).order('scheduled_at').limit(100) : none\n  ]);\n  if (!RA_ALIVE(this)) return;\n  const kd = b => { const ks = (b.booking_items || []).map(i => i.products && i.products.categories && i.products.categories.kind); return ks.indexOf('stay') > -1 ? 'inap' : ks.indexOf('trip') > -1 ? 'jeep' : 'rental'; };\n  this.setState({ d: { bk: (bk.data || []).map(b => Object.assign({ _k: kd(b) }, b)), un: un.data || [], wo: wo.data || [], tk: tk.count || 0, ap: ap.count || 0, md: (md && md.data) || null, rt: (rt && rt.data) || [], br } });\n}\nrenderVals() {\n  const s = this.state, d = s.d, st = RA._staff || {}, now = new Date();\n  const mod = s.mod || 'kasir', M = MODS[mod];\n  const t0 = new Date(now); t0.setHours(0, 0, 0, 0); const t1 = new Date(t0.getTime() + 864e5);\n  const inDay = x => { const t = new Date(x); return t >= t0 && t < t1; };\n  const item = b => { const it = (b.booking_items || [])[0]; if (!it) return '—'; const u = it.units || {}; return ((it.products || {}).name || '') + (u.plate_or_serial || u.code ? ' · ' + (u.plate_or_serial || u.code) : ''); };\n  const ini = n => String(n || '?').split(/\\s+/).filter(Boolean).slice(0, 2).map(x => x[0]).join('').toUpperCase();\n  const chip = k => { const t = { r: ['#FDE8E6', '#C0392B'], y: ['#FFF0DC', '#9A5B00'], g: ['#E4F4E9', '#1E7A3F'], b: ['#E6EEFB', '#1E5AA8'] }[k]; return 'flex: none; height: 26px; padding: 0 10px; border-radius: 13px; font-size: 12px; font-weight: 800; display: inline-flex; align-items: center; white-space: nowrap; background: ' + t[0] + '; color: ' + t[1]; };\n  const hrs = x => Math.max(0, Math.round((now - new Date(x)) / 36e5)); const dur = h => h < 48 ? h + ' jam' : Math.round(h / 24) + ' hari';\n  let N = {}, stats = [], rows = [], b1 = ['', ''], b2 = ['', ''], banner = {}, listTitle = 'Perlu ditindak', listHref = 'OpsBeranda.dc.html';\n  if (d) {\n    const R = d.bk.filter(b => b._k === 'rental');\n    const ver = d.bk.filte