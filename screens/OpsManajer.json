{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Manajer Operasional</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0}\n.om-card{background:#FFFFFF;border-radius:20px;box-shadow:0 8px 24px rgba(31,43,77,0.08);padding:16px;display:flex;flex-direction:column;gap:10px}\n.om-h{font-size:12px;font-weight:800;letter-spacing:0.06em;text-transform:uppercase}\n.om-btn{white-space:nowrap;min-height:44px;border-radius:12px;border:0;background:#077A70;color:#FFFFFF;font:800 13px 'Plus Jakarta Sans',sans-serif;cursor:pointer;display:flex;align-items:center;justify-content:center;text-decoration:none;padding:0 14px}\n.om-btn2{min-height:44px;border-radius:12px;border:1px solid #CBD2DE;background:#FFFFFF;color:#1F2B4D;font:700 13px 'Plus Jakarta Sans',sans-serif;cursor:pointer;display:flex;align-items:center;justify-content:center;text-decoration:none;padding:0 14px}\n.om-in{width:100%;box-sizing:border-box;min-height:44px;border-radius:12px;border:1px solid #CBD2DE;padding:10px 12px;font:500 13px 'Plus Jakarta Sans',sans-serif;color:#1F2B4D;resize:vertical}\n.om-row{display:flex;gap:10px;padding:10px 0;border-bottom:1px solid #EEF0F3;text-decoration:none;color:#1F2B4D}\n.om-row:last-child{border-bottom:0}\n@media (min-width:1000px){.om-wrap{padding-top:24px}}\n</style>\n</helmet>\n<div style=\"min-height: 100vh; box-sizing: border-box; background: #F3F5F8; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; color: #1F2B4D; padding-bottom: 110px\">\n <div class=\"om-wrap\" style=\"max-width: 560px; margin: 0 auto; display: flex; flex-direction: column; gap: 14px\">\n  <header style=\"padding: 18px 16px 0\">\n    <div style=\"font-size: 12px; font-weight: 700; color: #4A5468\">{{dayLabel}} · Semua cabang</div>\n    <div style=\"font-size: 20px; line-height: 26px; font-weight: 800\">Manajer Operasional</div>\n  </header>\n\n  <sc-if value=\"{{loading}}\" hint-placeholder-val=\"{{false}}\"><div style=\"margin: 0 16px\" class=\"om-card\"><span style=\"color: #4A5468; font-size: 13px\">Memuat tugas hari ini…</span></div></sc-if>\n\n  <sc-if value=\"{{ready}}\" hint-placeholder-val=\"{{true}}\">\n  <div style=\"display: flex; flex-direction: column; gap: 14px\">\n\n  <sc-if value=\"{{hasReply}}\"><div style=\"margin: 0 16px; background: #E8EEF8; border-radius: 18px; padding: 12px 14px; display: flex; flex-direction: column; gap: 4px\">\n    <div style=\"font-size: 12px; font-weight: 800; color: #1F2B4D\">💬 Tanggapan CEO · laporan {{replyDay}}</div>\n    <div style=\"font-size: 13.5px; line-height: 19px; white-space: pre-line\">{{replyText}}</div>\n  </div></sc-if>\n\n  <a href=\"OpsBukaHari.dc.html\" style=\"{{openCard}}\">\n    <div style=\"flex: none; width: 44px; height: 44px; border-radius: 14px; background: rgba(255,255,255,0.16); display: flex; align-items: center; justify-content: center\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"4\"></circle><path d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"></path></svg></div>\n    <div style=\"flex: 1; min-width: 0\">\n      <div style=\"font-size: 15px; font-weight: 800\">{{openTitle}}</div>\n      <div style=\"font-size: 12px; line-height: 16px; opacity: 0.9\">{{openSub}}</div>\n    </div>\n    <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M9 18l6-6-6-6\"></path></svg>\n  </a>\n\n  <section aria-label=\"Skor hari ini\" style=\"margin: 0 16px; background: #1F2B4D; color: #FFFFFF; border-radius: 22px; padding: 18px 16px; display: flex; flex-direction: column; gap: 14px\">\n    <div style=\"display: flex; justify-content: space-between; align-items: flex-end; gap: 10px\">\n      <div>\n        <div class=\"om-h\" style=\"color: #B9C3D9\">Skor hari ini</div>\n        <div style=\"font-size: 34px; line-height: 40px; font-weight: 800\">{{done}}<span style=\"font-size: 18px; color: #B9C3D9\"> / {{total}} beres</span></div>\n      </div>\n      <div style=\"text-align: right; font-size: 12px; line-height: 16px; color: #B9C3D9\">Masih terbuka<br><b style=\"font-size: 16px; color: #FFFFFF\">{{openCount}} tugas</b></div>\n    </div>\n    <div style=\"height: 8px; border-radius: 8px; background: rgba(255,255,255,0.18); overflow: hidden\"><div style=\"{{bar}}\"></div></div>\n    <div style=\"display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px\">\n      <div style=\"background: rgba(255,255,255,0.08); border-radius: 14px; padding: 10px 12px\">\n        <div style=\"font-size: 11px; font-weight: 700; color: #B9C3D9\">Omzet hari ini</div>\n        <div style=\"font-size: 16px; font-weight: 800\">{{omzet}}</div>\n        <div style=\"font-size: 11px; color: #B9C3D9\">{{omzetSub}}</div>\n      </div>\n      <div style=\"background: rgba(255,255,255,0.08); border-radius: 14px; padding: 10px 12px\">\n        <div style=\"font-size: 11px; font-weight: 700; color: #B9C3D9\">Utilisasi unit</div>\n        <div style=\"font-size: 16px; font-weight: 800\">{{util}}</div>\n        <div style=\"font-size: 11px; color: #B9C3D9\">{{utilSub}}</div>\n      </div>\n    </div>\n    <sc-if value=\"{{hasIdle}}\"><div style=\"background: #FFF0DC; color: #6B3E00; border-radius: 14px; padding: 12px; display: flex; gap: 10px; align-items: center\">\n      <div style=\"flex: 1; min-width: 0\">\n        <div style=\"font-size: 13px; font-weight: 800\">{{idleTitle}}</div>\n        <div style=\"font-size: 12px; line-height: 16px\">{{idleSub}}</div>\n      </div>\n      <button type=\"button\" onClick=\"{{pushIdle}}\" style=\"flex: none; min-height: 44px; padding: 0 12px; border-radius: 12px; border: 0; background: #9A5B00; color: #FFFFFF; font: 800 12px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">{{idleBtn}}</button>\n    </div></sc-if>\n  </section>\n\n  <div role=\"tablist\" style=\"margin: 0 16px; background: #E4E8EF; border-radius: 14px; padding: 4px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4px\">\n    <span role=\"tab\" aria-selected=\"true\" style=\"min-height: 40px; border-radius: 11px; background: #FFFFFF; font-size: 13px; font-weight: 800; display: flex; align-items: center; justify-content: center\">Tugas hari ini</span>\n    <a role=\"tab\" aria-selected=\"false\" href=\"OpsBeranda.dc.html\" style=\"min-height: 40px; border-radius: 11px; font-size: 13px; font-weight: 700; color: #4A5468; display: flex; align-items: center; justify-content: center; text-decoration: none\">Dashboard angka</a>\n  </div>\n\n  <section aria-label=\"Harus ditangani\" style=\"margin: 0 16px; display: flex; flex-direction: column; gap: 10px\">\n    <div style=\"display: flex; justify-content: space-between; align-items: baseline\"><span class=\"om-h\" style=\"color: #C0392B\">Perlu ditangani</span><span style=\"font-size: 12px; font-weight: 700; color: #4A5468\">{{openCount}} terbuka</span></div>\n    <sc-if value=\"{{noTasks}}\"><div class=\"om-card\" style=\"align-items: center; text-align: center\"><b style=\"font-size: 14px\">Tidak ada yang macet</b><span style=\"font-size: 12px; color: #4A5468\">Daftar ini terisi otomatis kalau ada booking telat, shift belum buka, verifikasi tertunda, atau tagihan belum lunas.</span></div></sc-if>\n    <sc-if value=\"{{hasTasks}}\"><div class=\"om-card\" style=\"padding: 4px 14px; gap: 0\">\n    <sc-for list=\"{{tasks}}\" as=\"t\" hint-placeholder-count=\"3\">\n      <div style=\"{{t.row}}\">\n        <div style=\"display: flex; gap: 10px; align-items: flex-start\">\n          <span style=\"{{t.dot}}\"></span>\n          <div style=\"flex: 1; min-width: 0\">\n            <div style=\"font-size: 14px; line-height: 19px; font-weight: 800\">{{t.title}}</div>\n            <div style=\"font-size: 12px; line-height: 17px; color: #4A5468\">{{t.meta}}</div>\n            <sc-if value=\"{{t.done}}\"><div style=\"font-size: 12px; line-height: 16px; color: #055C55; font-weight: 700\">{{t.doneNote}}</div></sc-if>\n          </div>\n          <sc-if value=\"{{t.open}}\"><a href=\"{{t.href}}\" class=\"om-btn\" style=\"flex: none; min-height: 38px; padding: 0 12px; font-size: 12.5px\">{{t.label}}</a></sc-if>\n        </div>\n        <sc-if value=\"{{t.open}}\"><div style=\"display: flex; gap: 14px; padding-left: 18px\">\n          <button type=\"button\" onClick=\"{{t.toggleAck}}\" style=\"border: 0; background: none; padding: 4px 0; font: 700 12.5px 'Plus Jakarta Sans', sans-serif; color: #077A70; cursor: pointer\">✓ Sudah ditangani</button>\n          <button type=\"button\" onClick=\"{{t.toggleGuide}}\" style=\"border: 0; background: none; padding: 4px 0; font: 700 12.5px 'Plus Jakarta Sans', sans-serif; color: #4A5468; cursor: pointer\">Panduan</button>\n        </div></sc-if>\n        <sc-if value=\"{{t.showGuide}}\">\n          <ol style=\"margin: 0 0 0 18px; padding: 8px 12px 8px 28px; background: #F3F5F8; border-radius: 12px; font-size: 12.5px; line-height: 19px\">\n            <sc-for list=\"{{t.steps}}\" as=\"st\"><li>{{st}}</li></sc-for>\n          </ol>\n        </sc-if>\n        <sc-if value=\"{{t.showAck}}\">\n          <div style=\"display: flex; flex-direction: column; gap: 8px; margin-left: 18px; background: #F3F5F8; border-radius: 12px; padding: 10px\">\n            <textarea class=\"om-in\" rows=\"2\" placeholder=\"Apa yang sudah dilakukan? Contoh: sudah ditelepon, kembali 15.00 + denda\" onInput=\"{{t.setNote}}\">{{t.note}}</textarea>\n            <button type=\"button\" class=\"om-btn\" onClick=\"{{t.saveAck}}\">Simpan</button>\n          </div>\n        </sc-if>\n      </div>\n    </sc-for>\n    </div></sc-if>\n  </section>\n\n  <section aria-label=\"Ritme hari ini\" class=\"om-card\" style=\"margin: 0 16px\">\n    <span class=\"om-h\" style=\"color: #077A70\">Ritme hari ini</span>\n    <div style=\"display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px\">\n      <a href=\"OpsBukaHari.dc.html\" style=\"{{rt1}}\"><div style=\"font-size: 11px; font-weight: 700\">Buka hari · 09–10</div><div style=\"font-size: 16px; font-weight: 800\">{{rt1v}}</div><div style=\"font-size: 11px; line-height: 14px\">Kemarin beres, hari ini siap</div></a>\n      <div style=\"{{rt2}}\"><div style=\"font-size: 11px; font-weight: 700\">Siang</div><div style=\"font-size: 16px; font-weight: 800\">{{rt2v}}</div><div style=\"font-size: 11px; line-height: 14px\">Pantau yang keluar jalur</div></div>\n      <div style=\"{{rt3}}\"><div style=\"font-size: 11px; font-weight: 700\">18.00 · otomatis</div><div style=\"font-size: 16px; font-weight: 800\">{{rt3v}}</div><div style=\"font-size: 11px; line-height: 14px\">Risiko besok ke kepala cabang</div></div>\n    </div>\n    <div style=\"font-size: 11.5px; line-height: 16px; color: #4A5468\">Malam tidak ada tugas manajer.</div>\n  </section>\n\n  <section aria-label=\"Risiko besok\" class=\"om-card\" style=\"margin: 0 16px; gap: 2px\">\n    <div style=\"display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 6px\"><span class=\"om-h\" style=\"color: #9A5B00\">Risiko besok</span><span style=\"font-size: 12px; font-weight: 700; color: #4A5468\">ke kepala cabang 18.00</span></div>\n    <sc-if value=\"{{noRisk}}\"><span style=\"font-size: 13px; color: #4A5468\">Belum ada risiko untuk besok.</span></sc-if>\n    <sc-for list=\"{{risks}}\" as=\"r\" hint-placeholder-count=\"2\"><a href=\"PosHariIni.dc.html\" class=\"om-row\"><span style=\"{{r.dot}}\"></span><span><b style=\"display: block; font-size: 13.5px; line-height: 18px\">{{r.title}}</b><span style=\"font-size: 12px; color: #4A5468\">{{r.sub}}</span></span></a></sc-for>\n  </section>\n\n  <section aria-label=\"Skor cabang\" class=\"om-card\" style=\"margin: 0 16px; gap: 8px\">\n    <div style=\"display: flex; justify-content: space-between; align-items: baseline\"><span class=\"om-h\" style=\"color: #077A70\">Skor cabang 7 hari</span><span style=\"font-size: 11.5px; color: #4A5468\">100 − masalah</span></div>\n    <sc-for list=\"{{branches}}\" as=\"b\" hint-placeholder-count=\"4\">\n      <div style=\"display: flex; align-items: center; gap: 10px\">\n        <span style=\"width: 24px; font-size: 13px; font-weight: 800; color: #4A5468\">{{b.rank}}</span>\n        <span style=\"flex: 1; min-width: 0\"><span style=\"display: block; font-size: 13.5px; font-weight: 700\">{{b.name}}</span><span style=\"font-size: 11.5px; color: #4A5468\">{{b.sub}}</span></span>\n        <div style=\"width: 80px; height: 6px; border-radius: 6px; background: #EEF0F3; overflow: hidden\"><div style=\"{{b.bar}}\"></div></div>\n        <span style=\"width: 30px; text-align: right; font-size: 13px; font-weight: 800\">{{b.score}}</span>\n      </div>\n    </sc-for>\n  </section>\n\n  <section aria-label=\"Inspeksi acak\" class=\"om-card\" style=\"margin: 0 16px\">\n    <div style=\"display: flex; justify-content: space-between; align-items: baseline\"><span class=\"om-h\" style=\"color: #077A70\">Inspeksi acak minggu ini</span><span style=\"font-size: 12px; font-weight: 800\">{{inspSum}}</span></div>\n    <span style=\"font-size: 12px; line-height: 16px; color: #4A5468\">3 unit dipilih acak tiap Senin. Cek kondisinya, foto, simpan di Google Drive, tempel link-nya. Batas {{inspDue}}.</span>\n    <sc-for list=\"{{insp}}\" as=\"i\" hint-placeholder-count=\"3\">\n      <div style=\"display: flex; flex-direction: column; gap: 8px; padding: 8px 0; border-top: 1px solid #EEF0F3\">\n        <div style=\"display: flex; align-items: center; gap: 10px\">\n          <span style=\"flex: 1; min-width: 0\"><b style=\"display: block; font-size: 13.5px\">{{i.code}}</b><span style=\"font-size: 12px; color: #4A5468\">{{i.sub}}</span></span>\n          <sc-if value=\"{{i.done}}\"><a href=\"{{i.url}}\" target=\"_blank\" rel=\"noopener\" style=\"font-size: 12px; font-weight: 800\">✓ Lihat foto</a></sc-if>\n          <sc-if value=\"{{i.todo}}\"><button type=\"button\" class=\"om-btn2\" onClick=\"{{i.toggle}}\">Cek unit</button></sc-if>\n        </div>\n        <sc-if value=\"{{i.show}}\"><div style=\"display: flex; flex-direction: column; gap: 8px\">\n          <input class=\"om-in\" type=\"url\" placeholder=\"Link Google Drive foto unit\" value=\"{{i.link}}\" onInput=\"{{i.setLink}}\">\n          <input class=\"om-in\" type=\"text\" placeholder=\"Catatan kondisi (opsional)\" value=\"{{i.note}}\" onInput=\"{{i.setNote}}\">\n          <div style=\"display: flex; gap: 8px\"><a href=\"https://drive.google.com/drive/my-drive\" target=\"_blank\" rel=\"noopener\" class=\"om-btn2\" style=\"flex: 1\">Buka Google Drive</a><button type=\"button\" class=\"om-btn\" style=\"flex: 1\" onClick=\"{{i.save}}\">Simpan</button></div>\n        </div></sc-if>\n      </div>\n    </sc-for>\n  </section>\n\n  </div>\n  </sc-if>\n </div>\n</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{\"$preview\":{\"width\":390,\"height\":1700}}'>\nclass Component extends DCLogic {\nstate = { d: null, guide: {}, ack: {}, notes: {}, insp: {}, busy: false };\nasync componentDidMount() {\n  await RA.staff();\n  this.stop = RA.poll(this, () => this.load(), 60000);\n}\ncomponentWillUnmount() { if (this.stop) this.stop(); }\nasync load() {\n  try { const d = await RA.call('ops_mgr_today', {}); if (!RA_ALIVE(this)) return; this.setState({ d }); }\n  catch (e) { RA.err(e); if (RA_ALIVE(this) && !this.state.d) this.setState({ d: { err: 1, tasks: [], items: [], metrics: {}, risks: [], branches: [], insp: { items: [] } } }); }\n}\nasync ack(t) {\n  const note = (this.state.notes[t.key] || '').trim();\n  try { await RA.call('ops_task_ack', { p_key: t.key, p_note: note }); RA.toast('Tercatat sudah ditangani', 'ok'); const a = Object.assign({}, this.state.ack); a[t.key] = false; this.setState({ ack: a }); this.load(); } catch (e) { RA.err(e); }\n}\nasync pushIdle() {\n  if (this.state.busy) return; this.setState({ busy: true });\n  try { const n = await RA.call('ops_idle_push', {}); RA.toast(n > 0 ? 'Terkirim ke ' + n + ' CS lewat WA' : 'Tidak ada CS dengan nomor WA', n > 0 ? 'ok' : 'bad'); this.load(); } catch (e) { RA.err(e); }\n  this.setState({ busy: false });\n}\nasync saveInsp(i) {\n  const v = this.state.insp[i.unit_id] || {};\n  try { await RA.call('ops_insp_done', { p_unit: i.unit_id, p_url: (v.link || '').trim(), p_note: v.note || '' }); RA.toast('Inspeksi tersimpan', 'ok'); const x = Object.assign({}, this.state.insp); delete x[i.unit_id]; this.setState({ insp: x }); this.load(); } catch (e) { RA.err(e); }\n}\nrenderVals() {\n  const s = this.state, d = s.d, now = new Date();\n  const rp = n => RA.rpShort ? RA.rpShort(n) : RA.rp(n);\n  const STEPS = {\n    late: ['Telepon penyewa 2x, lalu kirim WA.', 'Cek posisi lewat GPS unit (kalau ada).', 'Sepakati jam kembali: perpanjang atau kenakan denda, catat di booking.', 'Lewat 2 jam tanpa kabar: otomatis naik ke CEO. Jaminan jangan dilepas.'],\n    pick: ['Hubungi penyewa: jadi ambil jam berapa?', 'Kalau batal, batalkan booking supaya unit bisa disewa orang lain.', 'Kalau mundur, ubah jadwal ambil di booking.'],\n    shift: ['Hubungi kepala cabang / kasir cabang itu.', 'Kasir berhalangan: tugaskan pengganti dari cabang terdekat.', 'Pastikan shift dibuka sebelum booking pertama hari ini.'],\n    verif: ['Minta CS cabang cek sekarang.', 'CS tidak ada: verifikasi sendiri di halaman Verifikasi.', 'Ragu: tolak dengan alasan, jangan dibiarkan menggantung.'],\n    unpaid: ['Kirim link pembayaran ke penyewa.', 'Ingatkan kasir: tagih sebelum unit kembali.', 'Belum bayar saat kembali: jaminan jangan dilepas.']\n  };\n  const TAG = { late: 'Telat kembali', pick: 'Belum diambil', shift: 'Shift', verif: 'Verifikasi', unpaid: 'Belum lunas' };\n  const dayLabel = now.toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'short' });\n  if (!d) return { loading: true, ready: false, dayLabel, tasks: [], risks: [], branches: [], insp: [] };\n  const since = t => { if (!t.started_at) return ''; const m = Math.round((now - new Date(t.started_at)) / 60000); return m <= 0 ? '' : 'sejak ' + (m >= 1440 ? Math.floor(m / 1440) + ' hari' : m >= 60 ? Math.floor(m / 60) + ' jam' : m + ' mnt'); };\n  const tasks = (d.tasks || []).slice(0, 30).map(t => {\n    const done = !!t.done;\n    return Object.assign({}, t, {\n      done, open: !done, tag: TAG[t.kind] || t.kind, branch: t.branch || '', href: (t.href || 'OpsBeranda') + '.dc.html', label: t.label || 'Buka',\n      steps: STEPS[t.kind] || [], showGuide: !!s.guide[t.key], showAck: !!s.ack[t.key], note: s.notes[t.key] || '',\n      hasDoneNote: done, doneNote: t.ack_note ? '✓ ' + t.ack_note : '✓ Beres otomatis (data sudah sesuai)',\n      meta: [TAG[t.kind] || t.kind, t.branch, t.sub, since(t)].filter(Boolean).join(' · '),\n      row: 'display: flex; flex-direction: column; gap: 6px; padding: 12px 0; border-bottom: 1px solid #EEF0F3;' + (done ? ' opacity: 0.55;' : ''),\n      dot: 'flex: none; width: 8px; height: 8px; margin-top: 6px; border-radius: 50%; background: ' + (done ? '#077A70' : '#C0392B'),\n      toggleGuide: () => { const g = Object.assign({}, this.state.guide); g[t.key] = !g[t.key]; this.setState({ guide: g }); },\n      toggleAck: () => { const a = Object.assign({}, this.state.ack); a[t.key] = !a[t.key]; this.setState({ ack: a }); },\n      setNote: e => { const n = Object.assign({}, this.state.notes); n[t.key] = e.target.value; this.setState({ notes: n }); },\n      saveAck: () => this.ack(t)\n    });\n  });\n  const openCount = tasks.filter(t => t.open).length;\n  const done = (d.task_done || 0) + (d.items_ok || 0), total = (d.task_n || 0) + (d.items_n || 0);\n  const m = d.metrics || {}, idle = m.idle || {};\n  const opened = !!d.opened_at;\n  const hr = now.getHours();\n  const box = (bg, c) => 'border-radius: 14px; padding: 10px; display: flex; flex-direction: column; gap: 2px; text-decoration: none; background: ' + bg + '; color: ' + c;\n  const items = d.items || [];\n  const branches = (d.branches || []).slice(0, 6).map((b, i) => ({ rank: '#' + (i + 1), name: b.name, score: b.score, sub: b.tasks + ' masalah' + (b.cash ? ' · ' + b.cash + ' selisih kas' : ''),\n    bar: 'height: 6px; border-radius: 6px; width: ' + b.score + '%; background: ' + (b.score >= 80 ? '#077A70' : '#9A5B00') }));\n  const ins = (d.insp && d.insp.items) || [];\n  const insp = ins.map(i => { const v = s.insp[i.unit_id]; return Object.assign({}, i, { sub: [i.name, i.branch].filter(Boolean).join(' · '), todo: !i.done, show: !i.done && !!v, link: (v && v.link) || '', note: (v && v.note) || '',\n    toggle: () => { const x = Object.assign({}, this.state.insp); if (x[i.unit_id]) delete x[i.unit_id]; else x[i.unit_id] = { link: '', note: '' }; this.setState({ insp: x }); },\n    setLink: e => { const x = Object.assign({}, this.state.insp); x[i.unit_id] = Object.assign({}, x[i.unit_id], { link: e.target.value }); this.setState({ insp: x }); },\n    setNote: e => { const x = Object.assign({}, this.state.insp); x[i.unit_id] = Object.assign({}, x[i.unit_id], { note: e.target.value }); this.setState({ insp: x }); },\n    save: () => this.saveInsp(i) }); });\n  const byTxt = (idle.by || []).slice(0, 4).map(x => x.cat + ' ' + x.n).join(' · ');\n  return {\n    loading: false, ready: true, dayLabel,\n    hasReply: false, replyText: d.reply ? d.reply.text : '', replyDay: d.reply ? RA.date(d.reply.day) : '',\n    openCard: 'display: flex; align-items: center; gap: 12px; margin: 0 16px; border-radius: 20px; padding: 14px 16px; text-decoration: none; color: #FFFFFF; background: ' + (opened ? '#055C55' : '#077A70'),\n    openTitle: opened ? 'Hari sudah dibuka ' + RA.time(d.opened_at) + ' ✓' : 'Buka hari · 09.00–10.00',\n    openSub: (d.items_ok || 0) + '/' + (d.items_n || 0) + ' beres · cek kemarin & kesiapan hari ini',\n    done, total, escToday: d.esc_today || 0,\n    bar: 'height: 8px; border-radius: 8px; background: #3DD6C3; width: ' + (total ? Math.round(100 * done / total) : 0) + '%',\n    omzet: RA.rp(m.omzet || 0), omzetSub: m.target ? 'target ' + rp(m.target) + ' · ' + Math.round(100 * (m.omzet || 0) / m.target) + '%' : 'kemarin ' + rp(m.omzet_y || 0),\n    util: m.util != null ? m.util + '%' : '—', utilSub: (m.used || 0) + ' dari ' + (m.units || 0) + ' unit jalan',\n    hasIdle: (idle.count || 0) > 0, idleTitle: idle.count + ' unit nganggur ≈ ' + rp(idle.value || 0) + ' potensi hilang', idleSub: byTxt,\n    idleBtn: d.idle_pushed_at ? 'Kirim lagi' : 'Dorong ke CS', pushIdle: () => this.pushIdle(),\n    tasks, openCount, noTasks: tasks.length === 0, hasTasks: tasks.length > 0,\n    rt1: opened ? box('#E3F4F1', '#055C55') : box('#FFF0DC', '#6B3E00'), rt1v: opened ? '✓ ' + RA.time(d.opened_at) : (d.items_ok || 0) + '/' + (d.items_n || 0),\n    rt2: hr >= 10 ? (openCount ? box('#FFF0DC', '#6B3E00') : box('#E3F4F1', '#055C55')) : box('#EEF0F3', '#4A5468'), rt2v: openCount ? openCount + ' terbuka' : '✓',\n    rt3: box('#EEF0F3', '#4A5468'), rt3v: (d.risks || []).length ? (d.risks || []).length + ' risiko' : '—',\n    risks: (d.risks || []).map(r => ({ title: r.title, sub: [r.branch, r.sub].filter(Boolean).join(' · '), dot: 'flex: none; width: 8px; height: 8px; margin-top: 6px; border-radius: 50%; background: ' + (r.sev === 1 ? '#C0392B' : '#9A5B00') })),\n    noRisk: !(d.risks || []).length,\n    branches, insp, inspSum: ins.filter(i => i.done).length + '/' + ins.length + ' dicek', inspDue: d.insp && d.insp.due ? RA.date(d.insp.due) : 'Kamis'\n  };\n}\n}\n</script>\n</body>\n</html>\n"}