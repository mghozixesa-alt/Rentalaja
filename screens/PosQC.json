{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Cabang · Quality control</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>summary::-webkit-details-marker{display:none}\nbody{margin:0}\na{color:#1F2B4D}a:hover{color:#000}\n</style>\n</helmet>\n<div style=\"min-height: 100vh; box-sizing: border-box; display: flex; flex-wrap: wrap; align-items: stretch; background: #F6F7F9; color: #1F2B4D; font-family: 'Plus Jakarta Sans', system-ui, sans-serif\">\n<aside style=\"flex: 1 1 232px; box-sizing: border-box; background: #FFFFFF; border-right: 1px solid #E6E8EC; padding: 20px 16px; display: flex; flex-direction: column; gap: 20px\">\n  <img src=\"logo.png\" alt=\"Rentalaja\" style=\"height: 28px; width: auto; align-self: flex-start; display: block\">\n  <sc-if value=\"{{nav.multi}}\"><label style=\"display: flex; flex-direction: column; gap: 4px; font-size: 12px; font-weight: 700; color: #4A5468\">Cabang\n    <select aria-label=\"Pilih cabang\" onChange=\"{{nav.pickBranch}}\" style=\"height: 44px; border: 1px solid #D5D9E0; border-radius: 10px; padding: 0 10px; font: 700 14px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; background: #FFFFFF\">\n      <sc-for list=\"{{nav.branches}}\" as=\"b\"><option value=\"{{b.id}}\" selected=\"{{b.on}}\">{{b.name}}</option></sc-for>\n    </select>\n  </label></sc-if>\n  <sc-if value=\"{{nav.multi}}\" not><div style=\"display: flex; flex-direction: column; gap: 4px; font-size: 12px; font-weight: 700; color: #4A5468\">Cabang<div style=\"height: 44px; display: flex; align-items: center; font: 700 14px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D\">{{nav.branchName}}</div></div></sc-if>\n  <nav aria-label=\"Menu\" style=\"display: flex; flex-direction: column; gap: 14px\"><sc-if value=\"{{nav.gTransaksi}}\"><div role=\"group\" aria-label=\"Transaksi\" style=\"display: flex; flex-direction: column; gap: 2px\"><div style=\"font-size: 11px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #8A93A6; padding: 0 12px 2px\">Transaksi</div><sc-if value=\"{{nav.cPosHariIni}}\"><a href=\"PosHariIni.dc.html\" style=\"min-height: 40px; box-sizing: border-box; padding: 0 12px; border-radius: 10px; background: transparent; color: #1F2B4D; font: 600 14px 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; align-items: center; gap: 10px; text-decoration: none\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4A5468\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"4\" y=\"5\" width=\"16\" height=\"15\" rx=\"2\"/><path d=\"M8 3v4M16 3v4M4 10h16\"/></svg><span>Hari ini</span></a></sc-if><sc-if value=\"{{nav.cPosVerifikasi}}\"><a href=\"PosVerifikasi.dc.html\" style=\"min-height: 40px; box-sizing: border-box; padding: 0 12px; border-radius: 10px; background: transparent; color: #1F2B4D; font: 600 14px 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; align-items: center; gap: 10px; text-decoration: none\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4A5468\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z\"/><path d=\"M9 12l2 2 4-4\"/></svg><span>Verifikasi</span><sc-if value=\"{{nav.nPosVerifikasi}}\"><span style=\"margin-left: auto; min-width: 22px; height: 22px; padding: 0 6px; box-sizing: border-box; border-radius: 11px; background: #1F2B4D; color: #FFFFFF; font-size: 12px; font-weight: 800; display: flex; align-items: center; justify-content: center\">{{nav.nPosVerifikasi}}</span></sc-if></a></sc-if><sc-if value=\"{{nav.cPosSerahTerima}}\"><a href=\"PosSerahTerima.dc.html\" style=\"min-height: 40px; box-sizing: border-box; padding: 0 12px; border-radius: 10px; background: transparent; color: #1F2B4D; font: 600 14px 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; align-items: center; gap: 10px; text-decoration: none\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4A5468\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 8h13l-3-3M20 16H7l3 3\"/></svg><span>Serah-terima</span></a></sc-if><sc-if value=\"{{nav.cPosKasir}}\"><a href=\"PosKasir.dc.html\" style=\"min-height: 40px; box-sizing: border-box; padding: 0 12px; border-radius: 10px; background: transparent; color: #1F2B4D; font: 600 14px 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; align-items: center; gap: 10px; text-decoration: none\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4A5468\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"9\" cy=\"20\" r=\"1.5\"/><circle cx=\"18\" cy=\"20\" r=\"1.5\"/><path d=\"M3 4h2l2.5 11h11L21 8H7\"/></svg><span>Kasir walk-in</span></a></sc-if><sc-if value=\"{{nav.cPosPelanggan}}\"><a href=\"PosPelanggan.dc.html\" style=\"min-height: 40px; box-sizing: border-box; padding: 0 12px; border-radius: 10px; background: transparent; color: #1F2B4D; font: 600 14px 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; align-items: center; gap: 10px; text-decoration: none\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4A5468\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"9\" cy=\"8\" r=\"3.5\"/><path d=\"M2.5 20c1-3.5 3.5-5.5 6.5-5.5s5.5 2 6.5 5.5\"/><path d=\"M16 4.5a3.5 3.5 0 0 1 0 7M18.5 14.5c1.6.8 2.6 2.6 3 5.5\"/></svg><span>Pelanggan</span></a></sc-if></div></sc-if><sc-if value=\"{{nav.gAset}}\"><div role=\"group\" aria-label=\"Aset\" style=\"display: flex; flex-direction: column; gap: 2px\"><div style=\"font-size: 11px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #8A93A6; padding: 0 12px 2px\">Aset</div><sc-if value=\"{{nav.cPosUnit}}\"><a href=\"PosUnit.dc.html\" style=\"min-height: 40px; box-sizing: border-box; padding: 0 12px; border-radius: 10px; background: transparent; color: #1F2B4D; font: 600 14px 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; align-items: center; gap: 10px; text-decoration: none\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4A5468\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 7l9-4 9 4v10l-9 4-9-4z\"/><path d=\"M3 7l9 4 9-4M12 11v10\"/></svg><span>Unit dan stok</span></a></sc-if><sc-if value=\"{{nav.cPosQC}}\"><a href=\"PosQC.dc.html\" aria-current=\"page\" style=\"min-height: 40px; box-sizing: border-box; padding: 0 12px; border-radius: 10px; background: #E3F7F5; color: #1F2B4D; font: 800 14px 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; align-items: center; gap: 10px; text-decoration: none\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1F2B4D\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z\"/><path d=\"M9 12l2 2 4-4\"/></svg><span>Quality control</span><sc-if value=\"{{nav.nPosQC}}\"><span style=\"margin-left: auto; min-width: 22px; height: 22px; padding: 0 6px; box-sizing: border-box; border-radius: 11px; background: #1F2B4D; color: #FFFFFF; font-size: 12px; font-weight: 800; display: flex; align-items: center; justify-content: center\">{{nav.nPosQC}}</span></sc-if></a></sc-if></div></sc-if><sc-if value=\"{{nav.gShift}}\"><div role=\"group\" aria-label=\"Shift\" style=\"display: flex; flex-direction: column; gap: 2px\"><div style=\"font-size: 11px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #8A93A6; padding: 0 12px 2px\">Shift</div><sc-if value=\"{{nav.cPosShift}}\"><a href=\"PosShift.dc.html\" style=\"min-height: 40px; box-sizing: border-box; padding: 0 12px; border-radius: 10px; background: transparent; color: #1F2B4D; font: 600 14px 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; align-items: center; gap: 10px; text-decoration: none\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4A5468\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"/><path d=\"M3 10h18M7 15h4\"/></svg><span>Tutup shift</span></a></sc-if><sc-if value=\"{{nav.cPosAbsen}}\"><a href=\"PosAbsen.dc.html\" style=\"min-height: 40px; box-sizing: border-box; padding: 0 12px; border-radius: 10px; background: transparent; color: #1F2B4D; font: 600 14px 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; align-items: center; gap: 10px; text-decoration: none\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4A5468\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 20V10M10 20V4M16 20v-7M22 20H2\"/></svg><span>Absen dan target</span></a></sc-if></div></sc-if></nav>\n  <div style=\"margin-top: auto; display: flex; align-items: center; gap: 10px; padding-top: 16px; border-top: 1px solid #E6E8EC\">\n    <div style=\"width: 36px; height: 36px; border-radius: 18px; background: #1F2B4D; color: #09BEAF; font-size: 13px; font-weight: 800; display: flex; align-items: center; justify-content: center; flex-shrink: 0\">{{nav.initials}}</div>\n    <div style=\"display: flex; flex-direction: column\"><span style=\"font-size: 13px; font-weight: 700\">{{nav.name}}</span><span style=\"font-size: 12px; color: #4A5468\">{{nav.roleLine}}</span></div>\n    <button type=\"button\" onClick=\"{{nav.signOut}}\" style=\"margin-left: auto; height: 32px; padding: 0 10px; border-radius: 8px; border: 1px solid #D5D9E0; background: #FFFFFF; color: #4A5468; font: 700 12px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">Keluar</button>\n  </div>\n</aside>\n<main style=\"flex: 999 1 560px; min-width: 0; box-sizing: border-box; padding: 24px 28px 40px; display: flex; flex-direction: column; gap: 20px\">\n<details data-wa-share style=\"background: #FFFFFF; border: 1px solid #E6E8EC; border-radius: 14px\">\n<summary style=\"list-style: none; cursor: pointer; display: flex; flex-wrap: wrap; gap: 10px; align-items: center; justify-content: space-between; padding: 8px 10px 8px 14px\">\n  <span style=\"font-size: 13px; color: #4A5468\">Laporan <b style=\"color: #1F2B4D\">QC cabang</b> · {{wa.sched}}</span>\n  <span style=\"display: inline-flex; align-items: center; gap: 8px; height: 36px; padding: 0 14px; border-radius: 10px; background: #09BEAF; color: #1F2B4D; font-size: 14px; font-weight: 800\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 12a8 8 0 0 1-11.8 7L4 20l1.1-4A8 8 0 1 1 20 12z\"/><path d=\"M9 9.5c0 2.5 2 5 5 5.5l1.2-1.2-1.6-.9-.8.6c-1-.4-1.8-1.2-2.2-2.2l.6-.8-.9-1.6z\"/></svg>Bagikan ke WhatsApp</span>\n</summary>\n<div style=\"display: flex; flex-wrap: wrap; gap: 16px; padding: 4px 14px 16px; border-top: 1px solid #E6E8EC\">\n  <div style=\"flex: 1 1 340px; background: #E7F3EE; border-radius: 12px; padding: 12px; margin-top: 12px\"><div style=\"background: #FFFFFF; border-radius: 10px; padding: 10px 12px; font-size: 13.5px; line-height: 20px; box-shadow: 0 1px 1px rgba(0,0,0,0.08)\"><b>QC cabang</b> · Rentalaja<br><sc-for list=\"{{wa.lines}}\" as=\"l\">• {{l}}<br></sc-for></div></div>\n  <div style=\"flex: 1 1 360px; display: flex; flex-direction: column; gap: 10px; margin-top: 12px\">\n    <div style=\"display: flex; flex-direction: column; gap: 6px\"><span style=\"font-size: 12px; font-weight: 700; color: #4A5468\">Penerima</span><div style=\"display: flex; flex-wrap: wrap; gap: 6px\"><sc-for list=\"{{wa.to}}\" as=\"r\"><span style=\"display: inline-flex; align-items: center; height: 30px; padding: 0 10px; border-radius: 15px; font-size: 12px; font-weight: 800; border: 1.5px solid #1F2B4D; background: #E3F7F5; color: #1F2B4D\">{{r}}</span></sc-for><span style=\"display: inline-flex; align-items: center; height: 30px; padding: 0 10px; border-radius: 15px; font-size: 12px; font-weight: 700; border: 1px solid #D5D9E0; background: #FFFFFF; color: #1F2B4D\">+ Tambah penerima</span></div></div>\n    <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 10px\">\n      <label style=\"display: flex; flex-direction: column; gap: 4px; font-size: 12px; font-weight: 700; color: #4A5468\">Jadwal kirim<select style=\"height: 40px; border: 1px solid #D5D9E0; border-radius: 10px; padding: 0 10px; font: 600 13px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; background: #FFFFFF\"><option selected>Harian 21.30</option><option>Tidak terjadwal</option><option>Harian 07.00</option><option>Mingguan · Senin 07.00</option><option>Bulanan · tanggal 1</option></select></label>\n      <label style=\"display: flex; flex-direction: column; gap: 4px; font-size: 12px; font-weight: 700; color: #4A5468\">Isi<select style=\"height: 40px; border: 1px solid #D5D9E0; border-radius: 10px; padding: 0 10px; font: 600 13px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; background: #FFFFFF\"><option>Ringkasan + link PDF</option><option>Ringkasan saja</option><option>Ringkasan + gambar grafik</option></select></label>\n    </div>\n    <div style=\"font-size: 12px; line-height: 18px; color: #4A5468\">Nomor dan dokumen pelanggan tidak pernah ikut terkirim. Bagikan manual membuka WhatsApp untuk memilih chat atau grup.</div>\n    <div style=\"display: flex; gap: 8px; flex-wrap: wrap\"><button type=\"button\" style=\"height: 44px; padding: 0 16px; border-radius: 10px; border: none; background: #09BEAF; color: #1F2B4D; font: 800 14px 'Plus Jakarta Sans', sans-serif; cursor: pointer\" onClick=\"{{wa.send}}\">Kirim sekarang</button><button type=\"button\" style=\"height: 44px; padding: 0 16px; border-radius: 10px; border: 1px solid #1F2B4D; background: #FFFFFF; color: #1F2B4D; font: 700 14px 'Plus Jakarta Sans', sans-serif; cursor: pointer\" onClick=\"{{wa.share}}\">Bagikan manual</button><button type=\"button\" style=\"height: 44px; padding: 0 16px; border-radius: 10px; border: 1px solid #D5D9E0; background: #FFFFFF; color: #1F2B4D; font: 700 14px 'Plus Jakarta Sans', sans-serif; cursor: pointer\" onClick=\"{{wa.save}}\">Simpan jadwal</button></div>\n  </div>\n</div>\n</details>\n\n<header style=\"display: flex; flex-direction: column; gap: 6px; max-width: 820px\">\n  <h1 style=\"margin: 0; font-size: 28px; line-height: 34px; font-weight: 800; letter-spacing: -0.01em\">Quality control</h1>\n  <div style=\"font-size: 14px; line-height: 20px; color: #4A5468\">Semua unit yang kembali dari sewa atau dari servis masuk ke sini dulu. Hanya petugas QC yang bisa membuat unit Ready; teknisi tidak bisa meloloskan pekerjaannya sendiri.</div>\n</header>\n<div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(min(180px, 100%), 1fr)); gap: 12px\">\n  <div style=\"background: #FFFFFF; border: 1px solid #E6E8EC; border-radius: 14px; padding: 14px 16px; display: flex; flex-direction: column; gap: 2px\"><span style=\"font-size: 12px; font-weight: 700; color: #4A5468\">Antre QC</span><span style=\"font-size: 24px; font-weight: 800; line-height: 30px\">{{st.queue}}</span></div>\n  <div style=\"background: #FFFFFF; border: 1px solid #E6E8EC; border-radius: 14px; padding: 14px 16px; display: flex; flex-direction: column; gap: 2px\"><span style=\"font-size: 12px; font-weight: 700; color: #4A5468\">Lolos hari ini</span><span style=\"font-size: 24px; font-weight: 800; line-height: 30px\">{{st.pass}}</span></div>\n  <div style=\"background: #FFFFFF; border: 1px solid #E6E8EC; border-radius: 14px; padding: 14px 16px; display: flex; flex-direction: column; gap: 2px\"><span style=\"font-size: 12px; font-weight: 700; color: #4A5468\">Gagal, dikirim ke servis</span><span style=\"font-size: 24px; font-weight: 800; line-height: 30px\">{{st.fail}}</span></div>\n  <div style=\"background: #FFFFFF; border: 1px solid #E6E8EC; border-radius: 14px; padding: 14px 16px; display: flex; flex-direction: column; gap: 2px\"><span style=\"font-size: 12px; font-weight: 700; color: #4A5468\">Target waktu QC</span><span style=\"font-size: 24px; font-weight: 800; line-height: 30px\">{{st.target}}</span></div>\n</div>\n<div style=\"display: flex; flex-wrap: wrap; gap: 20px; align-items: flex-start\">\n  <section style=\"flex: 2 1 340px; min-width: 0; background: #FFFFFF; border: 1px solid #E6E8EC; border-radius: 16px; padding: 18px; display: flex; flex-direction: column; gap: 8px\">\n    <h2 style=\"margin: 0; font-size: 17px; font-weight: 800\">Antrean</h2>\n    <sc-for list=\"{{queue}}\" as=\"q\" hint-placeholder-count=\"4\">\n      <button type=\"button\" onClick=\"{{q.pick}}\" aria-pressed=\"{{q.on}}\" style=\"{{q.style}}\">\n        <span style=\"display: flex; justify-content: space-between; gap: 8px; align-items: center\"><b style=\"font-size: 14px\">{{q.name}}</b><span style=\"font-size: 12px; color: #4A5468\">{{q.time}}</span></span>\n        <span style=\"{{q.srcStyle}}\">{{q.src}}</span>\n      </button>\n    </sc-for>\n    <sc-if value=\"{{noQueue}}\"><div style=\"font-size: 14px; color: #4A5468\">{{emptyText}}</div></sc-if>\n  </section>\n  <sc-if value=\"{{hasCur}}\">\n  <section style=\"flex: 3 1 520px; min-width: 0; background: #FFFFFF; border: 1px solid #E6E8EC; border-radius: 16px; padding: 18px; display: flex; flex-direction: column; gap: 10px\">\n    <div style=\"display: flex; justify-content: space-between; gap: 10px; align-items: baseline\"><h2 style=\"margin: 0; font-size: 17px; font-weight: 800\">{{cur.name}}</h2><span style=\"font-size: 13px; color: #4A5468\">{{cur.src}}</span></div>\n    <sc-for list=\"{{checks}}\" as=\"c\" hint-placeholder-count=\"6\">\n      <button type=\"button\" onClick=\"{{c.toggle}}\" aria-pressed=\"{{c.on}}\" style=\"{{c.style}}\"><span style=\"{{c.box}}\">{{c.mark}}</span>{{c.t}}</button>\n    </sc-for>\n    <div style=\"display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px\">\n      <sc-for list=\"{{shots}}\" as=\"f\"><label style=\"height: 70px; box-sizing: border-box; border-radius: 10px; border: 1.5px dashed #B4BCC8; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; color: #6B7385; cursor: pointer; overflow: hidden; position: relative\"><input type=\"file\" accept=\"image/*\" capture=\"environment\" onChange=\"{{f.pick}}\" aria-label=\"{{f.label}}\" disabled=\"{{f.locked}}\" style=\"position: absolute; opacity: 0; width: 1px; height: 1px\"><sc-if value=\"{{f.src}}\"><img src=\"{{f.src}}\" alt=\"{{f.label}}\" style=\"width: 100%; height: 100%; object-fit: cover\"></sc-if><sc-if value=\"{{f.src}}\" not>{{f.text}}</sc-if></label></sc-for>\n    </div>\n    <sc-if value=\"{{cannotDecide}}\"><div style=\"font-size: 13px; color: #4A5468\">Hanya petugas QC yang bisa meloloskan atau menggagalkan unit.</div></sc-if>\n    <sc-if value=\"{{canDecide}}\">\n      <div style=\"display: flex; flex-wrap: wrap; gap: 10px; align-items: center\">\n        <button type=\"button\" onClick=\"{{pass}}\" disabled=\"{{busy}}\" style=\"{{passStyle}}\">Lolos, jadikan Ready</button>\n        <button type=\"button\" onClick=\"{{fail}}\" disabled=\"{{busy}}\" style=\"height: 44px; padding: 0 16px; border-radius: 10px; border: 1.5px solid #A12A1F; background: #FFFFFF; color: #A12A1F; font: 800 14px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">Gagal, buat work order</button>\n        <span style=\"font-size: 13px; color: #4A5468\">{{progress}}</span>\n      </div>\n    </sc-if>\n    <sc-if value=\"{{passed}}\" hint-placeholder-val=\"{{false}}\"><div style=\"background: #E4F2EA; border-radius: 12px; padding: 14px 16px; font-size: 14px; line-height: 20px; color: #1F3D2D\"><b>Lolos.</b> {{cur.name}} kini Ready di web dan kasir. Hasil QC dan foto tersimpan di riwayat unit.</div></sc-if>\n    <sc-if value=\"{{failed}}\" hint-placeholder-val=\"{{false}}\"><div style=\"background: #FDECEA; border-radius: 12px; padding: 14px 16px; font-size: 14px; line-height: 20px; color: #5E1A13\"><b>Gagal QC.</b> Work order {{woCode}} dibuat untuk teknisi dengan poin yang tidak lolos. Unit tetap tidak bisa disewa.</div></sc-if>\n  </section>\n  </sc-if>\n</div>\n</main>\n</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{\"$preview\":{\"width\":1280,\"height\":960}}'>\n/* ===== bagian bersama panel cabang (sidebar, cabang aktif, laporan WA). Sama di semua layar Pos*. ===== */\nconst PNL = {\n  ROLE: { owner: 'Owner', finance: 'Keuangan', viewer: 'Pemantau', asset_manager: 'Manajer aset', experience_manager: 'Manajer operasional', branch_head: 'Manajemen',\n    cs: 'CS', cs_experience: 'CS Experience', cashier: 'Kasir', staff: 'Kasir + Teknisi', qc: 'Petugas QC', technician: 'Teknisi', runner: 'Runner', driver: 'Sopir' },\n  PERM: { PosHariIni: 'pos.bookings', PosVerifikasi: 'pos.verify', PosSerahTerima: 'pos.handover', PosKasir: 'pos.cashier', PosPelanggan: 'pos.customers',\n    PosUnit: 'pos.units', PosQC: 'pos.qc', PosShift: 'pos.shift', PosAbsen: null },\n  day(d) { const s = new Date(d || Date.now()); s.setHours(0, 0, 0, 0); const e = new Date(s); e.setDate(e.getDate() + 1); return [s, e]; },\n  esc(s) { return String(s == null ? '' : s); },\n  async boot(c) {\n    const st = await RA.staff();\n    if (!st) return null;\n    const br = RA.staffBranch();\n    const cnt = r => (r && r.count) || 0;\n    const none = Promise.resolve({ data: null, count: 0 });\n    const [sch, sh, vq, qq, mates, owners] = await Promise.all([\n      RA.from('shift_schedules').select('shift,starts,ends').eq('staff_id', st.user_id).eq('day', RA.iso(new Date())).limit(1),\n      br ? RA.from('shifts').select('id,label,opened_at,cash_open,branch_id').eq('staff_id', st.user_id).eq('branch_id', br.id).eq('status', 'open').order('opened_at', { ascending: false }).limit(1) : none,\n      br && RA.can('pos.verify') ? RA.from('bookings').select('id', { count: 'exact' }).eq('branch_id', br.id).eq('status', 'pending_verification').limit(1) : none,\n      br && RA.can('pos.qc') ? RA.from('qc_inspections').select('id', { count: 'exact' }).eq('branch_id', br.id).is('done_at', 'null').limit(1) : none,\n      br ? RA.from('staff_branches').select('staff_id,staff(user_id,name,phone,role,is_active)').eq('branch_id', br.id) : none,\n      RA.from('staff').select('user_id,name,phone,role').eq('role', 'owner').eq('is_active', true)\n    ]);\n    const team = (mates.data || []).map(x => x.staff).filter(x => x && x.is_active);\n    const heads = team.filter(x => x.role === 'branch_head').concat(owners.data || []);\n    const p = { st, br, sched: (sch.data || [])[0] || null, shift: (sh.data || [])[0] || null, vCount: cnt(vq), qCount: cnt(qq), team, heads };\n    if (RA_ALIVE(c)) c.setState({ pnl: p });\n    return p;\n  },\n  /* nilai untuk sidebar + blok laporan WA. active = nama layar ini; wa = {title, lines[]} */\n  vals(c, active, wa) {\n    const p = c.state.pnl || {};\n    const st = p.st || RA._staff || {};\n    const br = RA.staffBranch() || p.br || {};\n    const bs = st.branches || [];\n    const can = n => { const k = PNL.PERM[n]; return !k || RA.can(k); };\n    const nav = {\n      multi: bs.length > 1, branchName: br.name || 'Belum ada cabang',\n      branches: bs.map(b => ({ id: b.id, name: b.name, on: b.id === br.id })),\n      pickBranch: e => { RA.setStaffBranch(e.target.value); RA.go(active); },\n      initials: RA.initials(st.name), name: st.name || '—',\n      roleLine: (PNL.ROLE[st.role] || 'Staf') + (p.sched && p.sched.shift ? ' · shift ' + p.sched.shift : p.shift ? ' · shift buka' : ''),\n      signOut: () => { RA.signOut(); RA.go('Masuk'); },\n      nPosVerifikasi: p.vCount || 0, nPosQC: p.qCount || 0,\n      gTransaksi: ['PosHariIni', 'PosVerifikasi', 'PosSerahTerima', 'PosKasir', 'PosPelanggan'].some(can),\n      gAset: ['PosUnit', 'PosQC'].some(can), gShift: true\n    };\n    Object.keys(PNL.PERM).forEach(n => { nav['c' + n] = can(n); });\n    wa = wa || { title: '', lines: [] };\n    const heads = p.heads || [];\n    const text = '*' + wa.title + '* · Rentalaja ' + (br.name || '') + '\\n' + (wa.lines || []).map(l => '• ' + l).join('\\n');\n    const open = ph => window.open('https://wa.me/' + (ph || '') + '?text=' + encodeURIComponent(text), '_blank', 'noopener');\n    return {\n      nav,\n      wa: {\n        lines: wa.lines || [], to: heads.length ? heads.map(h => h.name) : ['Manajemen'],\n        sched: heads.length ? 'kirim ke ' + heads.map(h => h.name).join(', ') : 'bagikan manual',\n        send: () => { const h = heads.find(x => x.phone && x.user_id !== st.user_id) || heads.find(x => x.phone); if (!h) return RA.toast('Nomor penerima belum diisi. Pakai Bagikan manual.'); open(h.phone); },\n        share: () => open(''),\n        save: () => RA.toast('Jadwal kirim otomatis diatur owner di Laporan WhatsApp (panel manajemen).')\n      }\n    };\n  },\n  chip(tone) { return RA.chip(tone).replace('padding: 0 10px', 'padding: 0 9px').replace('border-radius: 999px', 'border-radius: 12px').replace('font-weight: 700', 'font-weight: 800') + ';'; },\n  num(v) { const n = parseInt(String(v == null ? '' : v).replace(/[^0-9]/g, ''), 10); return isNaN(n) ? null : n; },\n  mins(a, b) { return Math.round((new Date(b) - new Date(a)) / 60000); },\n  dur(m) { m = Math.max(0, Math.round(m)); if (m < 60) return m + ' menit'; const h = Math.floor(m / 60), r = m % 60; if (h < 24) return h + ' jam' + (r ? ' ' + r + ' menit' : ''); const d = Math.floor(h / 24); return d + ' hari' + (h % 24 ? ' ' + (h % 24) + ' jam' : ''); },\n  items(b) {\n    const g = {};\n    (b.booking_items || []).forEach(it => { const n = (it.products && it.products.name) || 'Barang'; g[n] = (g[n] || 0) + (it.quantity || 1); });\n    const k = Object.keys(g); return k.length ? k.map(n => g[n] > 1 ? n + ' × ' + g[n] : n).join(', ') : '—';\n  },\n  /* unggah foto dari <input type=file> (kamera tablet) ke bucket operasional */\n  async upPhoto(file, prefix, n) {\n    const ext = (file.type && file.type.split('/')[1] || 'jpg').replace('jpeg', 'jpg');\n    const path = prefix + '/' + Date.now() + '-' + (n == null ? Math.random().toString(36).slice(2, 6) : n) + '.' + ext;\n    await RA.upload('operasional', path, file);\n    return path;\n  },\n  /* ===== pembayaran di cabang (QRIS di layar / link ke WA / tunai ke shift) — state: method, pay, linkSent =====\n     o = { booking, due, kind, onPaid } ; komponen wajib punya state.pnl (shift terbuka) */\n  payVals(c, o) {\n    const s = c.state, b = o.booking || {}, due = Math.max(0, Math.round(o.due || 0));\n    const method = s.method || 'qris';\n    const opt = on => 'min-height: 44px; padding: 0 10px; border-radius: 10px; cursor: pointer; font: 700 13px \"Plus Jakarta Sans\", sans-serif; color: #1F2B4D; ' + (on ? 'border: 2px solid #1F2B4D; background: #E3F7F5;' : 'border: 1px solid #D5D9E0; background: #FFFFFF;');\n    const canCash = RA.can('pos.cashier');\n    const methods = [{ id: 'qris', label: 'QRIS Xendit' }, { id: 'edc', label: 'EDC BCA' }, { id: 'cash', label: 'Tunai' }, { id: 'link', label: 'Link ke WA' }]\n      .map(m => ({ ...m, on: method === m.id ? 'true' : 'false', pick: () => c.setState({ method: m.id }), style: opt(method === m.id) }));\n    const pay = s.pay && s.pay.status === 'pending' && s.pay.booking_id === b.id ? s.pay : null;\n    const shift = s.pnl && s.pnl.shift;\n    const me = (RA._staff || {}).name || 'staf';\n    const phone = b.guest_phone || (b.customers && b.customers.phone);\n    const appLink = location.origin + location.pathname + '#/Bayar?id=' + b.id;\n    const poll = () => {\n      clearInterval(c._payPoll);\n      c._payPoll = setInterval(async () => {\n        if (!RA_ALIVE(c)) return clearInterval(c._payPoll);\n        const cur = c.state.pay; if (!cur) return clearInterval(c._payPoll);\n        const { data } = await RA.from('payments').select('id,status').eq('id', cur.id).maybeSingle();\n        if (data && data.status !== 'pending') { clearInterval(c._payPoll); c.setState({ pay: null }); if (data.status === 'paid') { RA.ok('Pembayaran diterima'); o.onPaid && o.onPaid(); } }\n      }, 3000);\n    };\n    const create = async m => {\n      const pm = await RA.call('create_payment', { p_booking: b.id, p_kind: o.kind || 'settlement', p_method: m });\n      let extra = {};\n      if (m !== 'cash' && m !== 'edc') { try { const r = await RA.fn('pay', { payment_id: pm.id }); extra = (r && r.payment) || {}; } catch (e) { console.warn(e); } }\n      const row = { ...pm, ...extra, id: pm.id, status: 'pending', booking_id: b.id };\n      c.setState({ pay: row });\n      if (m !== 'cash' && m !== 'edc') poll();\n      return row;\n    };\n    return {\n      methods: canCash ? methods : methods.filter(m => m.id === 'link'), dueShort: RA.rp(due),\n      showQr: due > 0 && canCash && method === 'qris', qrReady: !!(pay && pay.method === 'qris'),\n      qrText: pay ? (pay.qr_string ? 'Kode ' + String(pay.qr_string).slice(0, 18) + '…' : pay.code || '') + ' · ' + RA.rp(pay.amount) : '',\n      makeQr: c.act(() => create('qris')),\n      showLink: due > 0 && method === 'link', linkSent: !!(pay && pay.method === 'link'),\n      linkText: pay && pay.method === 'link' ? 'Link bayar dikirim ke email pelanggan. Status berubah otomatis begitu dibayar.' : 'Link bayar ' + RA.rp(due) + ' dikirim ke email pelanggan.',\n      sendLink: c.act(async () => {\n        if (!phone) throw new Error('Nomor WhatsApp pelanggan belum ada.');\n        const w = window.open('', '_blank');\n        const row = await create('link');\n        const url = row.payment_url || appLink;\n        const msg = 'Halo ' + (b.guest_name || '') + ', tagihan ' + b.code + ' sebesar ' + RA.rp(row.amount) + '. Bayar di sini: ' + url;\n        const href = 'https://wa.me/' + phone + '?text=' + encodeURIComponent(msg);\n        if (w) w.location = href; else window.open(href, '_blank', 'noopener');\n      }),\n      showCash: due > 0 && canCash && method === 'cash', hasShift: !!shift,\n      showEdc: due > 0 && canCash && method === 'edc', edcRef: c.state.edcRef || '', setEdcRef: e => c.setState({ edcRef: e.target.value }),\n      edcText: shift ? 'Proses di mesin EDC BCA sebesar ' + RA.rp(due) + ' (QRIS atau kartu), lalu isi nomor approval dari struk EDC.' : 'Pembayaran EDC harus masuk shift kasir. Buka shift dulu.',\n      payEdc: c.act(async () => {\n        if (!shift) throw new Error('Buka shift dulu sebelum menerima pembayaran EDC.');\n        const ref = String(c.state.edcRef || '').replace(/\\s+/g, '');\n        if (ref.length < 4) throw new Error('Isi nomor approval dari struk EDC (minimal 4 karakter).');\n        const row = await create('edc');\n        await RA.call('mark_payment_paid', { p_payment: row.id, p_provider_ref: 'EDC BCA ' + ref });\n        c.setState({ pay: null, edcRef: '' }); RA.ok('EDC BCA ' + RA.rp(row.amount) + ' tercatat · approval ' + ref);\n        o.onPaid && o.onPaid();\n      }),\n      cashText: shift ? 'Tunai tetap dicatat atas nama ' + me + ' dan masuk setoran shift. Disarankan hanya kalau QRIS gagal.' : 'Tunai harus masuk shift kasir. Buka shift Anda dulu di Tutup shift, lalu kembali ke sini.',\n      payCash: c.act(async () => {\n        if (!shift) throw new Error('Buka shift dulu sebelum menerima tunai.');\n        const row = await create('cash');\n        await RA.call('mark_payment_paid', { p_payment: row.id });\n        c.setState({ pay: null }); RA.ok('Tunai ' + RA.rp(row.amount) + ' tercatat di shift Anda');\n        o.onPaid && o.onPaid();\n      }),\n      waiting: !!pay && pay.method !== 'cash' && pay.method !== 'edc' && due > 0, pendingText: pay ? RA.rp(pay.amount) : '',\n      canSim: RA.simulation() && !!pay,\n      simulate: c.act(async () => { await RA.fn('pay', { payment_id: pay.id, action: 'simulate' }); clearInterval(c._payPoll); c.setState({ pay: null }); RA.ok('Pembayaran (simulasi) diterima'); o.onPaid && o.onPaid(); })\n    };\n  }\n};\nclass Component extends DCLogic {\nstate = { list: null, i: null, ok: {}, res: {}, shots: {}, stats: { pass: 0, fail: 0 }, lists: {}, refs: {} };\nasync componentDidMount() {\n  await PNL.boot(this);\n  if (!RA_ALIVE(this)) return;\n  this.stop = RA.poll(this, () => this.load(), 20000);\n}\ncomponentWillUnmount() { if (this.stop) this.stop(); }\nasync load() {\n  const br = RA.staffBranch(); if (!br) return this.setState({ list: [] });\n  const [S] = PNL.day();\n  const [q, done] = await Promise.all([\n    RA.from('qc_inspections').select('id,unit_id,source,source_ref,checklist_snapshot,queued_at,units(code,plate_or_serial,products(name,category_id))').eq('branch_id', br.id).is('done_at', 'null').order('queued_at'),\n    RA.from('qc_inspections').select('id,passed').eq('branch_id', br.id).gte('done_at', S.toISOString())\n  ]);\n  const list = q.data || [];\n  const keep = (this.state.list || []).filter(x => this.state.res[x.id] && !list.find(y => y.id === x.id));\n  const all = keep.concat(list);\n  // nomor referensi (WO / booking) dan daftar cek bila snapshot kosong\n  const woIds = all.filter(x => x.source === 'service' && x.source_ref).map(x => x.source_ref);\n  const bkIds = all.filter(x => x.source === 'return' && x.source_ref).map(x => x.source_ref);\n  const cats = [...new Set(all.filter(x => !(x.checklist_snapshot || []).length).map(x => x.units && x.units.products && x.units.products.category_id).filter(Boolean))];\n  const [wo, bk, cl] = await Promise.all([\n    woIds.length ? RA.from('work_orders').select('id,code').in('id', woIds) : { data: [] },\n    bkIds.length ? RA.from('bookings').select('id,code').in('id', bkIds) : { data: [] },\n    cats.length ? RA.from('qc_checklists').select('category_id,items').in('category_id', cats).eq('is_active', true) : { data: [] }\n  ]);\n  if (!RA_ALIVE(this)) return;\n  const refs = {}; (wo.data || []).concat(bk.data || []).forEach(r => { refs[r.id] = r.code; });\n  const lists = {}; (cl.data || []).forEach(c => { lists[c.category_id] = c.items || []; });\n  const dd = done.data || [];\n  const i = this.state.i && all.find(x => x.id === this.state.i) ? this.state.i : (all.find(x => !this.state.res[x.id]) || {}).id || null;\n  this.setState({ list: all, refs, lists, i, err: q.error && q.error.message, stats: { pass: dd.filter(x => x.passed).length, fail: dd.filter(x => x.passed === false).length } });\n}\nchecklistOf(x) {\n  const snap = x.checklist_snapshot || [];\n  if (snap.length) return snap.map(v => typeof v === 'string' ? v : v.label || v.item || String(v));\n  const cat = x.units && x.units.products && x.units.products.category_id;\n  const l = this.state.lists[cat] || [];\n  return l.length ? l : ['Kondisi fisik baik, tidak ada kerusakan baru', 'Berfungsi normal saat diuji', 'Kelengkapan sesuai daftar sewa'];\n}\nasync shot(e, k, n) {\n  const f = e.target.files && e.target.files[0]; if (!f) return;\n  const src = URL.createObjectURL(f);\n  this.setState({ shots: { ...this.state.shots, [k]: { src, up: true } } });\n  try { const path = await PNL.upPhoto(f, 'qc/' + this.state.i, n); if (RA_ALIVE(this)) this.setState({ shots: { ...this.state.shots, [k]: { src, path } } }); }\n  catch (err) { RA.err(err); const sh = { ...this.state.shots }; delete sh[k]; this.setState({ shots: sh }); }\n}\nasync decide(x, passed) {\n  const list = this.checklistOf(x); const ok = this.state.ok;\n  const results = {}; list.forEach((t, j) => { results[t] = !!ok[j]; });\n  const failed = list.filter((t, j) => !ok[j]);\n  const photos = [0, 1, 2, 3].map(j => this.state.shots[x.id + ':' + j]).filter(v => v && v.path).map(v => v.path);\n  const r = await RA.call('qc_decide', { p_inspection: x.id, p_passed: passed, p_results: results, p_failed: passed ? null : failed, p_photos: photos });\n  if (passed && photos.length) { try { await RA.fn('unit-kondisi', { action: 'set', unit_id: x.unit_id, photos }); } catch (e) { console.warn(e); } }\n  this.setState({ res: { ...this.state.res, [x.id]: { d: passed ? 'pass' : 'fail', wo: r && r.work_order } } });\n  RA.ok(passed ? 'Unit lolos QC, kini Ready' : 'Gagal QC, work order dibuat');\n  PNL.boot(this);\n  await this.load();\n}\nrenderVals() {\n  const s = this.state, list = s.list || [];\n  const chip = (bg, fg) => 'display: inline-flex; align-items: center; height: 24px; padding: 0 9px; border-radius: 12px; font-size: 12px; font-weight: 800; white-space: nowrap; background: ' + bg + '; color: ' + fg + ';';\n  const TONE = { info: chip('#E8EEF8', '#1F2B4D'), teal: chip('#E3F7F5', '#077A70'), mute: chip('#EEF0F3', '#4A5468'), good: chip('#E4F2EA', '#1E6B45'), bad: chip('#FDECEA', '#A12A1F') };\n  const SRC = { return: ['Pengembalian', 'teal'], service: ['Dari servis', 'info'], new_unit: ['Unit baru', 'mute'] };\n  const pickSt = on => 'display: flex; flex-direction: column; gap: 6px; align-items: flex-start; text-align: left; padding: 12px 14px; border-radius: 12px; cursor: pointer; font-family: \"Plus Jakarta Sans\", sans-serif; color: #1F2B4D; background: #FFFFFF; ' + (on ? 'border: 2px solid #1F2B4D;' : 'border: 1px solid #E6E8EC;');\n  const nm = x => ((x.units && x.units.products && x.units.products.name) || 'Unit') + ' ' + ((x.units && x.units.code) || '');\n  const srcText = x => (SRC[x.source] || [x.source])[0] + (s.refs[x.source_ref] ? ' · ' + s.refs[x.source_ref] : '');\n  const target = RA.setting('qc_target_minutes');\n  const queue = list.map(x => { const r = s.res[x.id]; const age = PNL.mins(x.queued_at, new Date());\n    return { name: nm(x), src: r ? (r.d === 'pass' ? 'Lolos' : 'Gagal') : srcText(x), srcStyle: r ? TONE[r.d === 'pass' ? 'good' : 'bad'] : TONE[(SRC[x.source] || [0, 'mute'])[1]],\n      time: 'Masuk ' + RA.time(x.queued_at) + (target != null && age > target && !r ? ' · lewat target' : ''), on: s.i === x.id ? 'true' : 'false', style: pickSt(s.i === x.id),\n      pick: () => this.setState({ i: x.id, ok: {} }) }; });\n  const open = list.filter(x => !s.res[x.id]).length;\n  const wa = { title: 'QC cabang', lines: ['Antre ' + open + ' · lolos hari ini ' + s.stats.pass + ' · gagal ' + s.stats.fail] };\n  const common = { ...PNL.vals(this, 'PosQC', wa), busy: !!s.busy, queue, noQueue: list.length === 0,\n    emptyText: s.list === null ? 'Memuat antrean…' : s.err ? s.err : 'Tidak ada unit yang menunggu QC.',\n    st: { queue: s.list === null ? '…' : open, pass: s.stats.pass, fail: s.stats.fail, target: target != null ? target + ' menit' : 'Belum diatur' } };\n  const x = list.find(y => y.id === s.i);\n  if (!x) return { ...common, hasCur: false, cur: {}, checks: [], shots: [] };\n  const items = this.checklistOf(x);\n  const r = s.res[x.id];\n  let n = 0;\n  const checks = items.map((t, j) => { const on = !!s.ok[j]; if (on) n++; return { t, on: on ? 'true' : 'false', mark: on ? '✓' : '', toggle: () => { if (!r) this.setState({ ok: { ...s.ok, [j]: !on } }); },\n    box: 'width: 22px; height: 22px; border-radius: 6px; flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center; font-weight: 800; ' + (on ? 'background: #1F2B4D; color: #FFFFFF;' : 'border: 1.5px solid #8A93A6; color: transparent;'),\n    style: 'min-height: 44px; display: flex; align-items: center; gap: 12px; text-align: left; padding: 6px 10px; border-radius: 10px; border: 1px solid #E6E8EC; background: ' + (on ? '#E4F2EA' : '#FFFFFF') + '; cursor: pointer; font: 600 14px \"Plus Jakarta Sans\", sans-serif; color: #1F2B4D;' }; });\n  const all = n === items.length;\n  const can = RA.can('pos.qc');\n  const shots = [0, 1, 2, 3].map(j => { const v = s.shots[x.id + ':' + j]; return { label: 'Foto ' + (j + 1), src: v && v.src, text: v && v.up ? 'Mengunggah…' : 'Foto ' + (j + 1), locked: !!r || !can, pick: e => this.shot(e, x.id + ':' + j, j + 1) }; });\n  return {\n    ...common, hasCur: true, cur: { name: nm(x), src: srcText(x) }, checks, shots, progress: n + ' dari ' + items.length + ' poin dicek', notAll: !all,\n    passStyle: 'height: 48px; padding: 0 18px; border-radius: 12px; border: none; font: 800 15px \"Plus Jakarta Sans\", sans-serif; ' + (all ? 'background: #09BEAF; color: #1F2B4D; cursor: pointer;' : 'background: #E6E8EC; color: #6B7385; cursor: not-allowed;'),\n    canDecide: can && !r, cannotDecide: !can, open: !r, passed: r && r.d === 'pass', failed: r && r.d === 'fail', woCode: r && r.wo || '',\n    pass: this.act(async () => { if (!all) return RA.toast('Cek semua poin dulu.'); await this.decide(x, true); }),\n    fail: this.act(async () => { await this.decide(x, false); })\n  };\n}\n}\n</script>\n</body>\n</html>"}