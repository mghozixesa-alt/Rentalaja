{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Ubah atau batalkan</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0}\na{color:#1F2B4D}a:hover{color:#000}\n</style>\n</helmet>\n<div style=\"width: 390px; height: 1000px; box-sizing: border-box; background: #F4F6F9; color: #1F2B4D; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; flex-direction: column; position: relative; overflow: hidden\">\n<header style=\"display: flex; align-items: center; gap: 8px; padding: 10px 12px; border-bottom: 1px solid #E6E8EC\">\n    <a href=\"{{backHref}}\" aria-label=\"Kembali\" style=\"width: 44px; height: 44px; display: flex; align-items: center; justify-content: center\">\n      <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1F2B4D\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M15 6l-6 6 6 6\"/></svg>\n    </a>\n    <div style=\"display: flex; flex-direction: column\"><div style=\"font-size: 18px; font-weight: 800\">Ubah atau batalkan</div><div style=\"font-size: 12px; color: #4A5468\">{{sub}}</div></div>\n  </header>\n  <sc-if value=\"{{missing}}\"><section style=\"padding: 24px 16px; font-size: 15px; line-height: 22px; color: #4A5468\">{{missing}} <a href=\"Akun.dc.html\" style=\"font-weight: 700\">Lihat booking saya</a></section></sc-if>\n  <sc-if value=\"{{ready}}\">\n  <section style=\"padding: 16px; display: flex; flex-direction: column; gap: 14px\">\n    <div role=\"group\" aria-label=\"Pilihan\" style=\"display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); background: #F6F7F9; border-radius: 12px; padding: 4px; gap: 4px\">\n      <sc-for list=\"{{modes}}\" as=\"m\">\n        <button type=\"button\" onClick=\"{{m.pick}}\" aria-pressed=\"{{m.on}}\" style=\"{{m.style}}\">{{m.label}}</button>\n      </sc-for>\n    </div>\n    <div style=\"background: #FFFFFF; border: 0; border-radius: 20px; box-shadow: 0 2px 12px rgba(31,43,77,0.07); padding: 14px 16px; display: flex; flex-direction: column; gap: 6px; font-size: 14px\">\n      <div style=\"display: flex; justify-content: space-between; gap: 10px\"><span style=\"color: #4A5468\">Jadwal sekarang</span><b style=\"text-align: right\">{{nowSched}}</b></div>\n      <div style=\"display: flex; justify-content: space-between; gap: 10px\"><span style=\"color: #4A5468\">Sudah dibayar</span><b>{{paidText}}</b></div>\n    </div>\n\n    <sc-if value=\"{{isUbah}}\">\n      <div style=\"display: flex; flex-direction: column; gap: 12px\">\n        <sc-if value=\"{{canResched}}\">\n        <div style=\"display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px\">\n          <label style=\"display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 700; color: #4A5468\">Ambil<select onChange=\"{{setStart}}\" style=\"height: 48px; box-sizing: border-box; border: 1px solid #D5D9E0; border-radius: 10px; padding: 0 12px; font: 600 16px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; background: #FFFFFF; width: 100%\"><sc-for list=\"{{startOpts}}\" as=\"o\"><option value=\"{{o.v}}\" selected=\"{{o.sel}}\">{{o.t}}</option></sc-for></select></label>\n          <label style=\"display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 700; color: #4A5468\">Kembali<select onChange=\"{{setEnd}}\" style=\"height: 48px; box-sizing: border-box; border: 1px solid #D5D9E0; border-radius: 10px; padding: 0 12px; font: 600 16px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; background: #FFFFFF; width: 100%\"><sc-for list=\"{{endOpts}}\" as=\"o\"><option value=\"{{o.v}}\" selected=\"{{o.sel}}\">{{o.t}}</option></sc-for></select></label>\n        </div>\n        <sc-if value=\"{{availText}}\"><div style=\"{{availStyle}}\"><sc-if value=\"{{availOk}}\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1E6B45\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12l5 5 9-10\"/></svg></sc-if>{{availText}}</div></sc-if>\n        <div style=\"display: flex; justify-content: space-between; font-size: 14px\"><span style=\"color: #4A5468\">Selisih biaya</span><b>{{diffText}}</b></div>\n        </sc-if>\n        <sc-if value=\"{{reschedRule}}\"><div style=\"font-size: 12px; line-height: 18px; color: #4A5468\">{{reschedRule}}</div></sc-if>\n        <sc-if value=\"{{reschedBlock}}\"><div style=\"background: #FFF1D6; border-radius: 12px; padding: 12px 14px; font-size: 13px; line-height: 19px; color: #5C3A00\">{{reschedBlock}}</div></sc-if>\n        <sc-if value=\"{{notSaved}}\">\n          <button type=\"button\" onClick=\"{{save}}\" disabled=\"{{cantSave}}\" style=\"{{saveStyle}}\">{{saveLabel}}</button>\n        </sc-if>\n        <sc-if value=\"{{saved}}\">\n          <div style=\"background: #E4F2EA; border-radius: 12px; padding: 14px; font-size: 14px; line-height: 20px; color: #1F3D2D\"><b>Jadwal diperbarui.</b> {{savedText}}</div>\n        </sc-if>\n      </div>\n    </sc-if>\n\n    <sc-if value=\"{{isBatal}}\">\n      <div style=\"display: flex; flex-direction: column; gap: 12px\">\n        <div style=\"{{freeBox}}\">\n          <div style=\"{{freeTitleStyle}}\">{{freeTitle}}</div>\n          <div style=\"font-size: 13px; line-height: 19px; color: #2D4A3A\">{{freeText}}</div>\n        </div>\n        <sc-if value=\"{{lateRule}}\"><div style=\"font-size: 12px; line-height: 18px; color: #4A5468\">{{lateRule}}</div></sc-if>\n        <sc-if value=\"{{canCancel}}\">\n        <label style=\"display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 700; color: #4A5468\">Alasan batal (membantu kami)\n          <select onChange=\"{{setReason}}\" style=\"height: 48px; box-sizing: border-box; border: 1px solid #D5D9E0; border-radius: 10px; padding: 0 12px; font: 600 16px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; background: #FFFFFF; width: 100%\"><sc-for list=\"{{reasons}}\" as=\"o\"><option value=\"{{o.v}}\" selected=\"{{o.sel}}\">{{o.v}}</option></sc-for></select>\n        </label>\n        </sc-if>\n        <sc-if value=\"{{notCancelled}}\">\n          <button type=\"button\" onClick=\"{{cancel}}\" disabled=\"{{cantCancel}}\" style=\"{{cancelStyle}}\">{{cancelLabel}}</button>\n        </sc-if>\n        <sc-if value=\"{{cancelled}}\">\n          <div style=\"background: #E4F2EA; border-radius: 12px; padding: 14px; font-size: 14px; line-height: 20px; color: #1F3D2D\"><b>Booking dibatalkan.</b> {{cancelText}}</div>\n          <a href=\"Cari.dc.html\" style=\"height: 48px; border-radius: 12px; border: 1px solid #1F2B4D; background: #FFFFFF; color: #1F2B4D; font: 700 14px 'Plus Jakarta Sans', sans-serif; display: flex; align-items: center; justify-content: center; text-decoration: none; cursor: pointer; width: 100%\">Cari unit lain</a>\n        </sc-if>\n      </div>\n    </sc-if>\n  </section>\n  </sc-if>\n\n</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{\"$preview\":{\"width\":390,\"height\":1000}}'>\nclass Component extends DCLogic {\nstate = { mode: 'ubah', b: null, missing: null, start: null, end: null, avail: null, newSum: null, reason: 'Rencana berubah', saved: null, cancelled: null };\nasync componentDidMount() {\n  if (this.params.mode === 'batal') this.setState({ mode: 'batal' });\n  const id = this.params.id;\n  if (!id) { this.setState({ missing: 'Pilih booking dulu dari halaman Akun.' }); return; }\n  const { data: b } = await RA.from('bookings').select('id,code,status,line,branch_id,start_at,end_at,subtotal,total,paid_amount,dp_amount,reschedule_count,booking_items(id,product_id,status,period,products(name))').eq('id', id).maybeSingle();\n  if (!RA_ALIVE(this)) return;\n  if (!b) { this.setState({ missing: 'Booking tidak ditemukan.' }); return; }\n  this.setState({ b, start: b.start_at, end: b.end_at });\n}\nitems() { const b = this.state.b; return (b.booking_items || []).filter(i => ['held', 'confirmed'].indexOf(i.status) > -1); }\nasync check(start, end) {\n  const b = this.state.b; this.setState({ start, end, avail: null, newSum: null });\n  const os = new Date(b.start_at), oe = new Date(b.end_at), ns = new Date(start), ne = new Date(end);\n  const parts = [];\n  if (ne <= os || ns >= oe) parts.push([ns, ne]); else { if (ns < os) parts.push([ns, os]); if (ne > oe) parts.push([oe, ne]); }\n  let ok = true, sum = 0, priced = true;\n  for (const it of this.items()) {\n    for (const p of parts) {\n      const a = await RA.rpc('availability', { p_product: it.product_id, p_branch: b.branch_id, p_start: p[0].toISOString(), p_end: p[1].toISOString() });\n      if (a.data === 0) ok = false;\n    }\n    const q = await RA.rpc('price_item', { p_product: it.product_id, p_branch: b.branch_id, p_start: ns.toISOString(), p_end: ne.toISOString(), p_quantity: 1, p_trips: 1 });\n    if (!q.data) priced = false; else sum += +q.data.line_total;\n  }\n  if (!RA_ALIVE(this) || this.state.start !== start || this.state.end !== end) return;\n  this.setState({ avail: ok, newSum: priced ? sum : null });\n}\nrenderVals() {\n  const s = this.state, b = s.b;\n  if (!b) return { ready: false, missing: s.missing, sub: s.missing ? '' : 'Memuat…', backHref: 'Akun.dc.html' };\n  const names = Array.from(new Set((b.booking_items || []).filter(i => i.status !== 'released').map(i => i.products && i.products.name).filter(Boolean)));\n  const exp = b.line === 'experience';\n  const seg = on => 'height: 44px; border-radius: 9px; border: none; cursor: pointer; font: 800 14px \"Plus Jakarta Sans\", sans-serif; ' + (on ? 'background: #FFFFFF; color: #1F2B4D; box-shadow: 0 1px 3px rgba(31,43,77,0.15);' : 'background: transparent; color: #4A5468;');\n  const modes = [['ubah', 'Ubah jadwal'], ['batal', 'Batalkan']].map(([id, label]) => ({ label, on: s.mode === id ? 'true' : 'false', pick: () => this.setState({ mode: id }), style: seg(s.mode === id) }));\n  const sched = (a, z) => RA.date(a) + ' ' + RA.time(a) + ' → ' + RA.date(z) + ' ' + RA.time(z);\n  const paid = +b.paid_amount;\n  const btn = (on, primary) => 'height: 52px; border-radius: 12px; font: 800 16px \"Plus Jakarta Sans\", sans-serif; width: 100%; ' + (!on ? 'border: none; background: #E6E8EC; color: #6B7385; cursor: not-allowed;' : primary ? 'border: none; background: #09BEAF; color: #1F2B4D; cursor: pointer;' : 'border: 1.5px solid #A12A1F; background: #FFFFFF; color: #A12A1F; cursor: pointer;');\n  // ubah jadwal\n  const start = new Date(s.start), end = new Date(s.end), dur = new Date(b.end_at) - new Date(b.start_at);\n  const s0 = new Date(Math.max(Date.now() + 3600000, Date.now())); s0.setHours(new Date(b.start_at).getHours(), new Date(b.start_at).getMinutes(), 0, 0);\n  if (s0 < new Date()) s0.setDate(s0.getDate() + 1);\n  const startOpts = []; for (let k = 0; k < 21; k++) { const d = new Date(s0); d.setDate(d.getDate() + k); startOpts.push({ v: d.toISOString(), t: RA.day(d) + ' · ' + RA.time(d), sel: Math.abs(d - start) < 60000 }); }\n  if (!startOpts.some(o => o.sel)) startOpts.unshift({ v: start.toISOString(), t: RA.day(start) + ' · ' + RA.time(start), sel: true });\n  const endOpts = []; const minDays = exp ? 1 : 1;\n  for (let k = minDays; k <= 14; k++) { const d = new Date(start.getTime() + k * 86400000); endOpts.push({ v: d.toISOString(), t: RA.day(d) + ' · ' + RA.time(d), sel: Math.abs(d - end) < 60000 }); }\n  if (!endOpts.some(o => o.sel)) endOpts.unshift({ v: end.toISOString(), t: RA.day(end) + ' · ' + RA.time(end), sel: true });\n  const changed = Math.abs(start - new Date(b.start_at)) > 60000 || Math.abs(end - new Date(b.end_at)) > 60000;\n  const canStatus = ['pending_verification', 'awaiting_payment', 'confirmed'].indexOf(b.status) > -1;\n  let reschedBlock = '', reschedRule = '';\n  if (exp) {\n    const dd = RA.setting('stay_reschedule_days'), lim = RA.setting('stay_reschedule_limit');\n    reschedRule = [dd != null ? 'Ubah tanggal paling lambat H-' + dd + '.' : '', lim != null ? 'Maksimal ' + lim + ' kali ubah tanggal.' : ''].filter(Boolean).join(' ');\n    if (lim != null && b.reschedule_count >= lim) reschedBlock = 'Batas ubah tanggal untuk booking ini sudah terpakai.';\n    else if (dd != null && Date.now() > new Date(b.start_at).getTime() - dd * 86400000) reschedBlock = 'Sudah lewat batas ubah tanggal. Hubungi cabang untuk bantuan.';\n  } else {\n    const h = RA.setting('free_reschedule_hours');\n    reschedRule = h != null ? 'Ubah jadwal gratis sampai ' + h + ' jam sebelum jadwal ambil. Verifikasi dan DP tetap berlaku.' : 'Verifikasi dan DP tetap berlaku.';\n    if (h != null && Date.now() > new Date(b.start_at).getTime() - h * 3600000) reschedBlock = 'Sudah lewat batas ubah jadwal gratis (' + h + ' jam sebelum ambil). Hubungi cabang untuk bantuan.';\n  }\n  if (!canStatus) reschedBlock = 'Jadwal booking ini tidak bisa diubah (' + (RA.STATUS[b.status] || [b.status])[0].toLowerCase() + ').';\n  const canResched = canStatus && !reschedBlock && !s.saved;\n  const diff = s.newSum == null ? null : s.newSum - +b.subtotal;\n  const sameDur = Math.abs((end - start) - dur) < 60000;\n  const diffText = !changed ? 'Rp0 · jadwal sama' : s.newSum == null ? (s.avail == null ? 'menghitung…' : 'harga belum diatur') : diff === 0 ? 'Rp0' + (sameDur ? ' · durasi sama' : '') : (diff > 0 ? '+' : '') + RA.rp(diff);\n  const cantSave = !canResched || !changed || s.avail !== true || !!s.busy;\n  // batal\n  const cr = s.cancelled;\n  const fh = RA.setting('free_cancel_hours');\n  const deadline = fh != null ? new Date(new Date(b.start_at).getTime() - fh * 3600000) : null;\n  const isFree = paid === 0 || (deadline && Date.now() <= deadline.getTime());\n  const cancelBlocked = cr ? '' : ['active', 'returned', 'completed', 'cancelled', 'expired'].indexOf(b.status) > -1 ? 'Booking ini tidak bisa dibatalkan.' : (exp && paid > 0 ? 'Booking Experience yang sudah dibayar tidak bisa dibatalkan, tetapi tanggalnya bisa diubah.' : '');\n  let freeTitle, freeText;\n  if (cancelBlocked) { freeTitle = 'Tidak bisa dibatalkan'; freeText = cancelBlocked; }\n  else if (isFree) { freeTitle = 'Masih bisa batal gratis'; freeText = (deadline && paid > 0 ? 'Sampai ' + RA.dayTime(deadline) + ' (' + fh + ' jam sebelum ambil). ' : '') + (paid > 0 ? 'Pembayaran ' + RA.rp(paid) + ' dikembalikan penuh ke metode bayar asal.' : 'Belum ada pembayaran, tidak ada biaya.'); }\n  else { freeTitle = 'Batas batal gratis sudah lewat'; freeText = (deadline ? 'Batas gratis berakhir ' + RA.dayTime(deadline) + '. ' : '') + 'Pembayaran ' + RA.rp(paid) + ' tidak dikembalikan otomatis.'; }\n  const lr = RA.setting('late_cancel_rule'), pen = RA.setting('no_show_penalty_points');\n  const lateRule = [lr ? 'Lewat dari batas gratis: ' + lr + '.' : '', pen != null ? 'Member tanpa DP yang tidak datang dihitung pelanggaran dan dipotong ' + RA.num(pen) + ' poin.' : ''].filter(Boolean).join(' ');\n  const ok = !cancelBlocked;\n  const R = ['Rencana berubah', 'Dapat kendaraan lain', 'Harga terlalu mahal', 'Proses terlalu lama', 'Lainnya'];\n  return {\n    ready: true, sub: b.code + (names.length ? ' · ' + names.join(' + ') : ''), backHref: 'Status.dc.html?id=' + b.id,\n    modes, isUbah: s.mode === 'ubah', isBatal: s.mode === 'batal',\n    nowSched: sched(b.start_at, b.end_at), paidText: paid > 0 ? RA.rp(paid) : 'Belum ada',\n    canResched, startOpts, endOpts, reschedRule, reschedBlock,\n    setStart: e => { const ns = new Date(e.target.value); const ne = new Date(ns.getTime() + (end - start)); this.check(ns.toISOString(), ne.toISOString()); },\n    setEnd: e => this.check(s.start, new Date(e.target.value).toISOString()),\n    availText: !changed ? '' : s.avail == null ? 'Mengecek ketersediaan…' : s.avail ? 'Unit masih tersedia di tanggal baru' : 'Unit tidak tersedia di tanggal baru. Pilih tanggal lain.',\n    availOk: s.avail === true, availStyle: 'display: flex; gap: 8px; align-items: center; font-size: 14px; font-weight: 700; color: ' + (s.avail === false ? '#A12A1F' : s.avail ? '#1E6B45' : '#4A5468'),\n    diffText, notSaved: !s.saved, saved: !!s.saved, cantSave, saveStyle: btn(!cantSave, true), saveLabel: s.busy ? 'Menyimpan…' : 'Simpan jadwal baru',\n    savedText: s.saved ? sched(s.saved.start, s.saved.end) + '. ' + (s.saved.difference > 0 ? 'Sisa tagihan ' + RA.rp(s.saved.difference) + ' dibayar saat ambil atau dari halaman status. ' : '') + 'Cabang ikut diperbarui otomatis.' : '',\n    save: this.act(async () => {\n      if (cantSave) return;\n      const r = await RA.call('reschedule_booking', { p_booking: b.id, p_start: s.start, p_end: s.end });\n      this.setState({ saved: { start: s.start, end: s.end, difference: +r.difference }, b: Object.assign({}, b, { start_at: s.start, end_at: s.end, total: r.total, status: r.status }) });\n    }),\n    freeTitle, freeText, lateRule, canCancel: ok && !cr,\n    freeBox: 'border-radius: 12px; padding: 14px; display: flex; flex-direction: column; gap: 4px; background: ' + (cancelBlocked ? '#EEF0F3' : isFree ? '#E4F2EA' : '#FFF1D6'),\n    freeTitleStyle: 'font-size: 15px; font-weight: 800; color: ' + (cancelBlocked ? '#4A5468' : isFree ? '#1E6B45' : '#8A4B00'),\n    reasons: R.map(v => ({ v, sel: s.reason === v })), setReason: e => this.setState({ reason: e.target.value }),\n    notCancelled: !cr, cancelled: !!cr, cantCancel: !ok || !!s.busy, cancelStyle: btn(ok && !s.busy, false), cancelLabel: s.busy ? 'Membatalkan…' : 'Batalkan booking',\n    cancelText: cr ? (cr.refund > 0 ? 'Refund ' + RA.rp(cr.refund) + ' diproses ke metode bayar asal, kabar dikirim ke email.' : paid > 0 ? 'Pembayaran tidak dikembalikan karena lewat batas batal gratis.' : 'Tidak ada pembayaran yang perlu dikembalikan.') : '',\n    cancel: this.act(async () => {\n      if (!ok) return;\n      if (!confirm('Batalkan booking ' + b.code + '?')) return;\n      const r = await RA.call('cancel_booking', { p_booking: b.id, p_reason: s.reason });\n      this.setState({ cancelled: { refund: +r.refund, free: r.free }, b: Object.assign({}, b, { status: 'cancelled' }) });\n    })\n  };\n}\n}\n</script>\n</body>\n</html>\n"}