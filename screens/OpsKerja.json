{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Kerja lapangan</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0}\n#okRoot{max-width:1180px;margin:0 auto;padding:24px 24px 48px;box-sizing:border-box;display:flex;flex-direction:column;gap:16px}\n#okRoot h1{margin:0;font-size:28px;font-weight:800;letter-spacing:-.01em}\n#okRoot h2{margin:0 0 10px;font-size:17px;font-weight:800}\n#okRoot .ok-sub{color:#4A5468;font-size:14px;margin-top:4px}\n#okRoot .ok-row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}\n#okRoot .ok-btn{height:40px;padding:0 14px;border-radius:12px;border:1px solid #1F2B4D;background:#FFFFFF;color:#1F2B4D;font:700 14px 'Plus Jakarta Sans',system-ui,sans-serif;cursor:pointer;display:inline-flex;align-items:center;gap:6px;text-decoration:none}\n#okRoot .ok-btn.pri{background:#09BEAF;border-color:#09BEAF;color:#1F2B4D}\n#okRoot .ok-btn.sm{height:32px;padding:0 10px;font-size:13px;border-radius:10px;border-color:#D5D9E0}\n#okRoot .ok-btn.sm.pri{border-color:#09BEAF}\n#okRoot .ok-kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}\n#okRoot .ok-kpi{background:#FFFFFF;border:1px solid #E6E8EC;border-radius:16px;padding:14px 16px}\n#okRoot .ok-kpi span{font-size:13px;font-weight:700;color:#4A5468}#okRoot .ok-kpi b{display:block;font-size:26px;font-weight:800;margin:2px 0}#okRoot .ok-kpi small{font-size:12.5px;color:#4A5468}\n#okRoot .ok-card{background:#FFFFFF;border:1px solid #E6E8EC;border-radius:18px;padding:18px}\n#okRoot .ok-card.hot{border-color:#09BEAF;background:#F1FBFA}\n#okRoot .ok-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:16px}\n#okRoot table{width:100%;border-collapse:collapse;font-size:14px}\n#okRoot th{text-align:left;font-size:12.5px;color:#4A5468;font-weight:700;padding:8px 10px;border-bottom:1px solid #E6E8EC}\n#okRoot td{padding:10px;border-bottom:1px solid #EEF0F3;vertical-align:top}\n#okRoot .ok-scroll{overflow-x:auto}\n#okRoot .ok-chip{display:inline-flex;align-items:center;padding:3px 9px;border-radius:999px;font-size:12px;font-weight:700;background:#EEF0F3;color:#4A5468;white-space:nowrap}\n#okRoot .ok-chip.g{background:#E3F7F5;color:#077A70}#okRoot .ok-chip.y{background:#FFF6E0;color:#7A5200}#okRoot .ok-chip.r{background:#FBE9E7;color:#A12A1F}#okRoot .ok-chip.b{background:#E5EEF9;color:#1E5AA8}\n#okRoot .ok-li{display:flex;gap:10px;align-items:center;flex-wrap:wrap;padding:10px 0;border-top:1px solid #EEF0F3}#okRoot .ok-li:first-child{border-top:0}\n#okRoot .ok-mut{color:#4A5468;font-size:12.5px}\n#okRoot details summary{cursor:pointer;list-style:none}#okRoot details summary::-webkit-details-marker{display:none}\n.ok-modal{position:fixed;inset:0;background:rgba(31,43,77,.45);display:flex;align-items:center;justify-content:center;z-index:1000;padding:16px}\n.ok-modal form{background:#FFFFFF;border-radius:18px;padding:20px;width:100%;max-width:480px;max-height:90vh;overflow:auto;display:flex;flex-direction:column;gap:12px;font-family:'Plus Jakarta Sans',system-ui,sans-serif;color:#1F2B4D}\n.ok-modal h3{margin:0;font-size:18px;font-weight:800}\n.ok-modal label{display:flex;flex-direction:column;gap:5px;font-size:13px;font-weight:700}\n.ok-modal input,.ok-modal select,.ok-modal textarea{height:42px;border:1px solid #D5D9E0;border-radius:10px;padding:0 10px;font:500 14px 'Plus Jakarta Sans',system-ui,sans-serif;color:#1F2B4D;background:#FFFFFF}\n.ok-modal textarea{height:auto;padding:10px}\n.ok-modal .g2{display:grid;grid-template-columns:1fr 1fr;gap:10px}\n.ok-modal .act{display:flex;gap:10px;justify-content:flex-end}\n.ok-modal .act button{height:42px;padding:0 16px;border-radius:12px;border:1px solid #D5D9E0;background:#FFFFFF;font:700 14px 'Plus Jakarta Sans',system-ui,sans-serif;cursor:pointer;color:#1F2B4D}\n.ok-modal .act button.pri{background:#09BEAF;border-color:#09BEAF}\n.ok-modal .err{color:#A12A1F;font-size:13px;font-weight:700}\n@media (max-width:900px){#okRoot{padding:16px 16px 96px}#okRoot .ok-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}#okRoot .ok-grid{grid-template-columns:minmax(0,1fr)}#okRoot h1{font-size:23px}}\n</style>\n</helmet>\n<div style=\"min-height: 100vh; box-sizing: border-box; background: #F4F6F9; color: #1F2B4D; font-family: 'Plus Jakarta Sans', system-ui, sans-serif\">\n  <div id=\"okRoot\"><div style=\"padding: 40px; color: #4A5468\">Memuat…</div></div>\n</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{}'>\nclass Component extends DCLogic {\nstate = {};\nrenderVals() { return {}; }\ncomponentDidMount() { this.day = (RA.params() || {}).d || RA.iso(new Date()); this.load(); }\nesc(s) { return String(s == null ? '' : s).replace(/[&<>\"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c])); }\nhm(t) { return t ? String(t).slice(0, 5).replace(':', '.') : '—'; }\nclock(ts) { return ts ? new Date(ts).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Jakarta' }).replace(':', '.') : '—'; }\njam(m) { m = +m || 0; const h = Math.floor(m / 60), r = m % 60; return h ? h + ' j' + (r ? ' ' + r + ' m' : '') : r + ' m'; }\nfd(iso, wd) { if (!iso) return '—'; const d = new Date(String(iso).slice(0, 10) + 'T00:00:00Z'); return (wd === false ? '' : ['Min', 'Sen', 'Sel', 'Rab', 'Kam', 'Jum', 'Sab'][d.getUTCDay()] + ' ') + d.getUTCDate() + ' ' + ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'][d.getUTCMonth()]; }\nadd(iso, n) { const d = new Date(iso + 'T00:00:00Z'); d.setUTCDate(d.getUTCDate() + n); return d.toISOString().slice(0, 10); }\nbox() { return document.getElementById('okRoot'); }\nasync load() {\n  const el = this.box(); if (!el) return;\n  const [t, lv, cl] = await Promise.all([RA.rpc('ops_team', { p_day: this.day }), RA.rpc('ops_leave_pending', {}), RA.rpc('ops_claim_pending', {})]);\n  if (t.error) { el.innerHTML = '<div class=\"ok-card\"><h2>Belum bisa dibuka</h2><p class=\"ok-mut\">' + this.esc(t.error.message) + '. Halaman ini untuk Operasional yang terdaftar di Sistem Kerja Pokama; buka lewat Sistem Kerja (app.pokama.org → Operasional).</p></div>'; return; }\n  this.T = t.data; this.LV = lv.data || []; this.CL = cl.data || [];\n  if (this.FINMIN == null) { const s = await RA.from('pk_settings').select('value').eq('key', 'ops_claim_fin_min').maybeSingle(); this.FINMIN = s && s.data ? +s.data.value : 0; }\n  if (this.view) { try { await this.loadView(); } catch (x) { this.view = null; } }\n  this.draw();\n}\ndraw() {\n  const e = this.esc.bind(this), hm = this.hm.bind(this), clock = this.clock.bind(this), jam = this.jam.bind(this), fd = this.fd.bind(this);\n  const T = this.T, P = T.people || [], BR = T.branches || [], OT = T.ot || [], IT = T.items || [], LV = this.LV, CL = this.CL || [], day = this.day, today = RA.iso(new Date()), isToday = day === today;\n  const assigned = P.filter(p => p.assigns.length), free = P.filter(p => !p.assigns.length), pendOT = OT.filter(o => o.status === 'diajukan');\n  const inN = assigned.filter(p => p.att && p.att.in).length, lateN = assigned.filter(p => p.att && p.att.late > 0).length, schN = assigned.filter(p => p.sched).length;\n  const byBr = {}; assigned.forEach(p => p.assigns.forEach(a => { (byBr[a.branch] = byBr[a.branch] || []).push({ p, a }); }));\n  const order = BR.map(b => b.name).filter(n => byBr[n]).concat(Object.keys(byBr).filter(n => !BR.some(b => b.name === n)));\n  const chip = (t, c) => '<span class=\"ok-chip ' + (c || '') + '\">' + e(t) + '</span>';\n  const nowHM = new Date(Date.now() + 7 * 3600e3).toISOString().slice(11, 16);\n  const status = p => { const a = p.att; if (a && a.out) return chip((a.auto ? 'pulang otomatis ' : 'pulang ') + clock(a.out), a.auto ? 'y' : ''); if (a && a.in) return chip('masuk ' + clock(a.in) + (a.late > 0 ? ' · telat ' + jam(a.late) : ''), a.late > 0 ? 'y' : 'g');\n    if (!isToday) return chip('tidak absen'); if (p.sched && String(p.sched.starts).slice(0, 5) < nowHM) return chip('belum absen', 'r'); return chip(p.sched ? 'belum mulai' : 'tanpa jadwal'); };\n  const KIND = { cuti: 'Cuti', izin: 'Izin', sakit: 'Sakit' };\n  const row = ({ p, a }) => '<tr><td><b>' + e(p.nick) + '</b>' + (p.linked ? '' : ' ' + chip('belum pernah masuk', 'y')) + '<br><span class=\"ok-mut\">' + e(p.name) + '</span></td><td>' + chip(a.pos.label, 'b') + (a.kind === 'tambahan' ? ' <span class=\"ok-mut\">tambahan</span>' : '')\n    + (p.next ? '<br><span class=\"ok-mut\">→ ' + e(p.next.pos.label) + ' · ' + e(p.next.branch) + ' ' + fd(p.next.start_day, false) + '</span>' : '') + '</td><td>' + (p.sched ? e(p.sched.shift || '') + ' ' + hm(p.sched.starts) + '–' + hm(p.sched.ends) : '<span class=\"ok-mut\">—</span>') + '</td><td>' + status(p) + (p.open_shift ? ' ' + chip('kas terbuka', 'b') : '') + '</td>'\n    + '<td>' + (p.checks ? 'buka ' + (p.checks.buka || 0) + ' · tutup ' + (p.checks.tutup || 0) : '<span class=\"ok-mut\">—</span>') + '</td><td class=\"ok-mut\">' + p.m_hadir + ' hadir · ' + p.m_telat + ' telat<br>lembur ' + jam(p.m_lembur) + ' · poin ' + p.m_poin + '<br>sisa cuti <a href=\"#\" data-quota=\"' + p.id + '\" style=\"color:#077A70;font-weight:700\">' + (p.leave_left == null ? '—' : p.leave_left + '/' + p.leave_quota + ' hari') + '</a></td>'\n    + '<td><div class=\"ok-row\"><button class=\"ok-btn sm\" data-mv=\"' + p.id + '\">Mutasi</button><button class=\"ok-btn sm\" data-sc=\"' + p.id + '\">Jadwal</button><button class=\"ok-btn sm\" data-end=\"' + a.id + '\" data-p=\"' + p.id + '\">Akhiri</button></div></td></tr>';\n  this.box().innerHTML = '<div class=\"ok-row\" style=\"justify-content:space-between;align-items:flex-end\"><div><h1>Kerja lapangan</h1><div class=\"ok-sub\">Penugasan, mutasi, jadwal, persetujuan (cuti, izin, sakit, lembur, reimburse, kasbon), dan ceklis petugas yang absen lewat ops.pokama.org</div></div>'\n    + '<div class=\"ok-row\"><button class=\"ok-btn\" data-day=\"-1\">‹</button><b>' + fd(day) + (isToday ? ' · hari ini' : '') + '</b><button class=\"ok-btn\" data-day=\"1\">›</button><button class=\"ok-btn\" data-a=\"rekap\">' + (this.view === 'rekap' ? '✕ ' : '') + 'Rekap bulanan</button><button class=\"ok-btn\" data-a=\"libur\">' + (this.view === 'libur' ? '✕ ' : '') + 'Kalender libur</button><button class=\"ok-btn\" data-a=\"otas\">Tugaskan lembur</button><button class=\"ok-btn pri\" data-a=\"add\">+ Petugas</button></div></div>'\n    + '<div class=\"ok-kpis\"><div class=\"ok-kpi\"><span>Petugas bertugas</span><b>' + assigned.length + '</b><small>' + Object.keys(byBr).length + ' cabang' + (free.length ? ' · ' + free.length + ' belum ditugaskan' : '') + '</small></div>'\n    + '<div class=\"ok-kpi\"><span>Sudah absen</span><b>' + inN + ' / ' + (schN || assigned.length) + '</b><small>' + (schN ? 'dari yang terjadwal' : 'jadwal belum diatur') + '</small></div>'\n    + '<div class=\"ok-kpi\"><span>Telat</span><b style=\"color:' + (lateN ? '#A12A1F' : '#1F2B4D') + '\">' + lateN + '</b><small>' + (isToday ? 'hari ini' : fd(day, false)) + '</small></div>'\n    + '<div class=\"ok-kpi\"><span>Menunggu keputusan</span><b style=\"color:' + (pendOT.length + LV.length + CL.length ? '#A12A1F' : '#1F2B4D') + '\">' + (pendOT.length + LV.length + CL.length) + '</b><small>' + pendOT.length + ' lembur · ' + LV.length + ' cuti/izin/sakit · ' + CL.length + ' reimburse/kasbon</small></div></div>'\n    + (this.view === 'rekap' ? this.rekapHTML() : this.view === 'libur' ? this.liburHTML() : '')\n    + (pendOT.length || LV.length || CL.length ? '<div class=\"ok-card hot\"><h2>Perlu keputusan</h2>' + CL.map(c => '<div class=\"ok-li\"><span style=\"flex:1\"><b>' + e(c.nick) + '</b> · ' + (c.kind === 'kasbon' ? 'Kasbon' : 'Reimburse') + ' Rp' + Math.round(c.amount).toLocaleString('id-ID') + ' · ' + fd(c.day) + (c.category ? ' · ' + e(c.category) : '') + '<br><span class=\"ok-mut\">' + e(c.note || '') + (this.FINMIN && +c.amount >= this.FINMIN ? ' · setelah disetujui lanjut ke Keuangan' : '') + '</span></span>' + (c.photo ? '<button class=\"ok-btn sm\" data-nota=\"' + e(c.photo) + '\">Lihat nota</button>' : '') + '<button class=\"ok-btn sm pri\" data-clok=\"' + c.id + '\">Setujui</button><button class=\"ok-btn sm\" data-clno=\"' + c.id + '\">Tolak</button></div>').join('') + LV.map(l => '<div class=\"ok-li\"><span style=\"flex:1\"><b>' + e(l.nick) + '</b> · ' + (KIND[l.kind] || l.kind) + ' ' + fd(l.day) + (l.end_day && l.end_day !== l.day ? ' – ' + fd(l.end_day) : '') + '<br><span class=\"ok-mut\">' + e(l.reason || '') + '</span></span><button class=\"ok-btn sm pri\" data-lvok=\"' + l.id + '\">Setujui</button><button class=\"ok-btn sm\" data-lvno=\"' + l.id + '\">Tolak</button></div>').join('')\n      + pendOT.map(o => '<div class=\"ok-li\"><span style=\"flex:1\"><b>' + e(o.nick) + '</b> · Lembur ' + fd(o.day) + ' ' + hm(o.starts) + '–' + hm(o.ends) + ' (' + jam(o.minutes) + ')<br><span class=\"ok-mut\">' + e(o.reason || '') + '</span></span><button class=\"ok-btn sm pri\" data-otok=\"' + o.id + '\">Setujui</button><button class=\"ok-btn sm\" data-otno=\"' + o.id + '\">Tolak</button></div>').join('') + '</div>' : '')\n    + (!P.length ? '<div class=\"ok-card\"><h2>Belum ada petugas lapangan</h2><p class=\"ok-mut\">Tambahkan kasir, CS, runner, sopir, QC, teknisi, atau kepala cabang. Mereka masuk ops.pokama.org dengan akun Google (email yang didaftarkan), absen dan isi ceklis di sana, lalu membuka panel Rentalaja sesuai penugasan tanpa login lagi.</p><button class=\"ok-btn pri\" data-a=\"add\">+ Petugas</button></div>' : '')\n    + order.map(n => '<div class=\"ok-card ok-scroll\"><div class=\"ok-row\" style=\"justify-content:space-between\"><h2 style=\"margin:0\">' + e(n) + '</h2><span class=\"ok-mut\">' + byBr[n].length + ' orang · ' + byBr[n].filter(x => x.p.att && x.p.att.in).length + ' sudah absen</span></div><table><thead><tr><th>Nama</th><th>Posisi</th><th>Jadwal</th><th>Kehadiran</th><th>Ceklis</th><th>Bulan ini</th><th></th></tr></thead><tbody>' + byBr[n].map(row).join('') + '</tbody></table></div>').join('')\n    + (free.length ? '<div class=\"ok-card\"><h2>Belum ditugaskan</h2>' + free.map(p => '<div class=\"ok-li\"><b style=\"flex:1\">' + e(p.nick) + ' <span class=\"ok-mut\">' + e(p.email || '') + '</span></b>' + (p.next ? '<span class=\"ok-mut\">mulai ' + fd(p.next.start_day, false) + ' sebagai ' + e(p.next.pos.label) + ' · ' + e(p.next.branch) + '</span>' : '') + '<button class=\"ok-btn sm pri\" data-mv=\"' + p.id + '\">Tugaskan</button></div>').join('') + '</div>' : '')\n    + '<div class=\"ok-grid\"><div class=\"ok-card\"><h2>Riwayat penugasan & mutasi</h2>' + ((T.moves || []).map(m => '<div class=\"ok-li\">' + chip(m.pos.label, 'b') + '<span style=\"flex:1\"><b>' + e(m.nick) + '</b> · ' + e(m.branch) + ' <span class=\"ok-mut\">' + fd(m.start_day, false) + ' – ' + (m.end_day ? fd(m.end_day, false) : 'sekarang') + ' · ' + m.kind + (m.reason ? ' · ' + e(m.reason) : '') + (m.by && m.by !== '—' ? ' · oleh ' + e(m.by) : '') + '</span></span></div>').join('') || '<p class=\"ok-mut\">Belum ada.</p>') + '</div>'\n    + '<div class=\"ok-card\"><h2>Lembur bulan ini</h2>' + (OT.filter(o => o.status !== 'diajukan').map(o => '<div class=\"ok-li\"><span style=\"flex:1\"><b>' + e(o.nick) + '</b> · ' + fd(o.day, false) + ' ' + hm(o.starts) + '–' + hm(o.ends) + ' · ' + jam(o.minutes) + ' ' + (o.kind === 'tugas' ? chip('ditugaskan', 'b') : chip(o.status, o.status === 'disetujui' ? 'g' : o.status === 'ditolak' ? 'r' : '')) + '<br><span class=\"ok-mut\">' + e(o.reason || '') + (o.by ? ' · ' + e(o.by) : '') + '</span></span></div>').join('') || '<p class=\"ok-mut\">Belum ada.</p>')\n    + (P.some(p => p.m_lembur) ? '<h2 style=\"margin-top:12px\">Rekap per orang</h2>' + P.filter(p => p.m_lembur).map(p => '<div class=\"ok-li\"><span style=\"flex:1\">' + e(p.nick) + '</span><b>' + jam(p.m_lembur) + '</b></div>').join('') : '') + '</div></div>'\n    + '<details class=\"ok-card\"><summary><h2 style=\"display:inline\">Ceklis buka & tutup</h2> <span class=\"ok-mut\">· ' + IT.filter(i => i.active).length + ' butir aktif · tutup wajib lengkap sebelum absen keluar</span></summary><div class=\"ok-row\" style=\"margin:10px 0\"><button class=\"ok-btn sm\" data-a=\"item\">+ Butir ceklis</button></div><table><thead><tr><th>Tahap</th><th>Posisi</th><th>Butir</th><th></th></tr></thead><tbody>'\n    + IT.map(i => '<tr style=\"' + (i.active ? '' : 'opacity:.5') + '\"><td>' + i.phase + '</td><td>' + (i.position ? chip(this.POSL[i.position] || i.position, 'b') : '<span class=\"ok-mut\">semua</span>') + '</td><td>' + e(i.label) + '</td><td><button class=\"ok-btn sm\" data-it=\"' + i.id + '\">Ubah</button></td></tr>').join('') + '</tbody></table></details>';\n  this.box().onclick = ev => this.click(ev);\n}\nrp(n) { return 'Rp' + Math.round(+n || 0).toLocaleString('id-ID'); }\nym(d) { return String(d).slice(0, 7); }\nmname(ym) { const [y, m] = ym.split('-'); return ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'][+m - 1] + ' ' + y; }\nasync loadView() {\n  if (this.view === 'rekap') { const r = await RA.rpc('ops_recap', { p_month: (this.rm || this.ym(this.day)) + '-01' }); if (r.error) throw new Error(r.error.message); this.RC = r.data; }\n  if (this.view === 'libur') { const y = this.ly || +String(this.day).slice(0, 4); const r = await RA.rpc('ops_holiday_list', { p_year: y }); if (r.error) throw new Error(r.error.message); this.HL = r.data || []; }\n}\nrekapHTML() {\n  const e = this.esc.bind(this), R = this.RC || { rows: [] }, rows = R.rows || [], ym = this.rm || this.ym(this.day), jam = m => (Math.round((+m || 0) / 6) / 10) + ' j';\n  const sum = k => rows.reduce((a, x) => a + (+x[k] || 0), 0);\n  return '<div class=\"ok-card ok-scroll\"><div class=\"ok-row\" style=\"justify-content:space-between\"><div class=\"ok-row\"><button class=\"ok-btn sm\" data-rm=\"-1\">‹</button><h2 style=\"margin:0\">Rekap ' + this.mname(ym) + '</h2><button class=\"ok-btn sm\" data-rm=\"1\">›</button></div>'\n    + '<div class=\"ok-row\"><span class=\"ok-mut\">' + rows.length + ' petugas · hadir ' + sum('hadir') + ' · telat ' + sum('telat') + ' · tanpa keterangan ' + sum('tanpa_ket') + ' · lembur ' + jam(sum('lembur_menit')) + '</span><button class=\"ok-btn sm pri\" data-a=\"csv\">Unduh CSV</button></div></div>'\n    + '<table><thead><tr><th>Nama</th><th>Cabang</th><th>Jadwal</th><th>Hadir</th><th>Telat</th><th>Tanpa ket.</th><th>Cuti/izin/sakit</th><th>Jam kerja</th><th>Lembur</th><th>Pulang otomatis</th><th>Reimburse</th><th>Kasbon</th><th>Sisa cuti</th></tr></thead><tbody>'\n    + (rows.map(x => '<tr><td><b>' + e(x.nick) + '</b><br><span class=\"ok-mut\">' + e(x.title || '') + '</span></td><td class=\"ok-mut\">' + e(x.branch || '—') + '</td><td>' + x.jadwal + '</td><td>' + x.hadir + '</td><td' + (x.telat ? ' style=\"color:#A12A1F;font-weight:700\"' : '') + '>' + x.telat + (x.telat ? '<br><span class=\"ok-mut\">' + x.telat_menit + ' mnt</span>' : '') + '</td><td' + (x.tanpa_ket ? ' style=\"color:#A12A1F;font-weight:700\"' : '') + '>' + x.tanpa_ket + '</td><td>' + x.cuti + ' / ' + x.izin + ' / ' + x.sakit + '</td><td>' + x.jam_kerja + ' j</td><td>' + jam(x.lembur_menit) + '</td><td>' + (x.auto_out || 0) + '</td><td>' + (+x.reimburse ? this.rp(x.reimburse) : '—') + '</td><td>' + (+x.kasbon ? this.rp(x.kasbon) : '—') + '</td><td>' + x.sisa_cuti + ' hari</td></tr>').join('') || '<tr><td colspan=\"13\" class=\"ok-mut\">Belum ada petugas lapangan.</td></tr>')\n    + '</tbody></table><p class=\"ok-mut\" style=\"margin:10px 0 0\">Tanpa keterangan = ada jadwal shift tapi tidak absen, tidak cuti/izin/sakit, dan bukan hari libur. Lembur, reimburse, kasbon, dan denda telat otomatis masuk penggajian di panel Keuangan.</p></div>';\n}\nliburHTML() {\n  const e = this.esc.bind(this), y = this.ly || +String(this.day).slice(0, 4), L = this.HL || [];\n  return '<div class=\"ok-card\"><div class=\"ok-row\" style=\"justify-content:space-between\"><div class=\"ok-row\"><button class=\"ok-btn sm\" data-ly=\"-1\">‹</button><h2 style=\"margin:0\">Kalender libur ' + y + '</h2><button class=\"ok-btn sm\" data-ly=\"1\">›</button></div><button class=\"ok-btn sm pri\" data-a=\"hadd\">+ Hari libur</button></div>'\n    + '<p class=\"ok-mut\" style=\"margin:6px 0 4px\">Hari libur perusahaan atau cabang tutup. Tidak ada pengingat absen, tidak dihitung tanpa keterangan, dan libur semua cabang tidak memotong jatah cuti. Petugas melihatnya di ops.pokama.org.</p>'\n    + (L.map(h => '<div class=\"ok-li\"><b style=\"min-width:120px\">' + this.fd(h.day) + '</b><span style=\"flex:1\">' + e(h.name) + ' <span class=\"ok-chip ' + (h.branch ? 'b' : '') + '\">' + e(h.branch || 'semua cabang') + '</span></span><button class=\"ok-btn sm\" data-hdel=\"' + h.day + '|' + (h.branch_id || '') + '\">Hapus</button></div>').join('') || '<p class=\"ok-mut\">Belum ada hari libur di tahun ini.</p>') + '</div>';\n}\nPOS = [['kasir', 'Kasir'], ['cs', 'CS'], ['runner', 'Runner'], ['sopir', 'Sopir jeep'], ['qc', 'QC'], ['teknisi', 'Teknisi'], ['kepala_cabang', 'Kepala cabang']];\nPOSL = { kasir: 'Kasir', cs: 'CS', runner: 'Runner', sopir: 'Sopir jeep', qc: 'QC', teknisi: 'Teknisi', kepala_cabang: 'Kepala cabang' };\nopts(list, sel, blank) { return (blank ? '<option value=\"\">' + blank + '</option>' : '') + list.map(([v, l]) => '<option value=\"' + this.esc(v) + '\"' + (String(v) === String(sel) ? ' selected' : '') + '>' + this.esc(l) + '</option>').join(''); }\nmodal(title, body, submit, onSubmit) {\n  return new Promise(res => {\n    const w = document.createElement('div'); w.className = 'ok-modal';\n    w.innerHTML = '<form><h3>' + this.esc(title) + '</h3>' + body + '<div class=\"err\" hidden></div><div class=\"act\"><button type=\"button\" data-x>Batal</button><button type=\"submit\" class=\"pri\">' + this.esc(submit) + '</button></div></form>';\n    document.body.appendChild(w); const f = w.querySelector('form'), er = w.querySelector('.err');\n    const close = v => { w.remove(); res(v); };\n    w.querySelector('[data-x]').onclick = () => close(false); w.onclick = ev => { if (ev.target === w) close(false); };\n    f.onsubmit = async ev => { ev.preventDefault(); ev.stopPropagation(); const v = {}; new FormData(f).forEach((x, k) => { v[k] = x; }); f.querySelectorAll('input[type=checkbox]').forEach(c => { v[c.name] = c.checked; });\n      const b = f.querySelector('button[type=submit]'); b.disabled = true; er.hidden = true;\n      try { await onSubmit(v); close(true); } catch (x) { er.textContent = x.message || String(x); er.hidden = false; b.disabled = false; } };\n  });\n}\nneed(v, m) { if (v == null || String(v).trim() === '') throw new Error(m); }\nasync call(fn, args) { const r = await RA.rpc(fn, args); if (r.error) throw new Error(r.error.message); return r.data; }\nasync click(ev) {\n  const g = k => ev.target.closest('[data-' + k + ']'); let b;\n  const T = this.T, P = T.people || [], BR = T.branches || [], day = this.day, pOf = id => P.find(p => p.id === id);\n  const brSel = s => '<select name=\"br\">' + this.opts(BR.map(x => [x.id, x.name]), s, '— pilih cabang —') + '</select>';\n  const posSel = s => '<select name=\"pos\">' + this.opts(this.POS, s, '— pilih posisi —') + '</select>';\n  try {\n    if ((b = g('day'))) { this.day = this.add(this.day, +b.dataset.day); return this.load(); }\n    if ((b = g('a')) && (b.dataset.a === 'rekap' || b.dataset.a === 'libur')) { this.view = this.view === b.dataset.a ? null : b.dataset.a; await this.loadView(); return this.draw(); }\n    if ((b = g('rm'))) { const [y, m] = (this.rm || this.ym(this.day)).split('-').map(Number); const d = new Date(Date.UTC(y, m - 1 + +b.dataset.rm, 1)); this.rm = d.toISOString().slice(0, 