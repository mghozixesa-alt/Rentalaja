e: true }); RA.ok('Hari libur dihapus'); await this.loadView(); return this.draw(); }\n    if ((b = g('quota'))) { ev.preventDefault(); const p = pOf(b.dataset.quota);\n      if (await this.modal('Jatah cuti · ' + p.nick, '<span style=\"font-size:13px;color:#4A5468\">Sisa tahun ini ' + p.leave_left + ' dari ' + p.leave_quota + ' hari. Kosongkan untuk memakai jatah standar (diatur di Sistem Kerja → Pengaturan).</span><label>Jatah cuti per tahun (hari)<input type=\"number\" min=\"0\" name=\"q\" value=\"' + (p.leave_quota == null ? '' : p.leave_quota) + '\"></label>', 'Simpan',\n        async f => { await this.call('ops_set_leave_quota', { p_person: p.id, p_quota: f.q === '' ? null : +f.q }); }))\n        { RA.ok('Jatah cuti tersimpan'); this.load(); } return; }\n\n    if ((b = g('a')) && b.dataset.a === 'add') {\n      if (await this.modal('Tambah petugas lapangan', '<label>Nama lengkap<input name=\"name\"></label><div class=\"g2\"><label>Panggilan<input name=\"nick\"></label><label>WhatsApp<input name=\"wa\" inputmode=\"tel\"></label></div><label>Email Google<input name=\"email\" type=\"email\" placeholder=\"nama@gmail.com\"></label><span style=\"font-size:12.5px;color:#4A5468\">Dipakai untuk masuk ops.pokama.org. Akun Rentalaja dibuat otomatis saat pertama masuk.</span><div class=\"g2\"><label>Posisi' + posSel('') + '</label><label>Cabang' + brSel('') + '</label></div><label>Mulai bertugas<input type=\"date\" name=\"d\" value=\"' + day + '\"></label>', 'Tambahkan',\n        async f => { this.need(f.name, 'Isi nama'); this.need(f.email, 'Isi email Google'); this.need(f.pos, 'Pilih posisi'); this.need(f.br, 'Pilih cabang'); await this.call('ops_person_add', { p_name: f.name, p_nick: f.nick, p_email: f.email, p_phone: f.wa, p_position: f.pos, p_branch: f.br, p_start: f.d || day }); }))\n        { RA.ok('Petugas ditambahkan. Minta ia masuk ops.pokama.org dengan Google.'); this.load(); } return; }\n    if ((b = g('mv'))) { const p = pOf(b.dataset.mv), cur = p.assigns[0];\n      if (await this.modal((p.assigns.length ? 'Mutasi · ' : 'Tugaskan · ') + p.nick, (p.assigns.length ? '<span style=\"font-size:13px;color:#4A5468\">Sekarang: ' + p.assigns.map(a => this.esc(a.pos.label + ' · ' + a.branch)).join(', ') + '</span><label>Jenis<select name=\"mode\">' + this.opts([['mutasi', 'Mutasi (penugasan lama berakhir)'], ['tambahan', 'Tugas tambahan (penugasan lama tetap)']], 'mutasi') + '</select></label>' : '')\n        + '<div class=\"g2\"><label>Posisi' + posSel(cur ? cur.position : '') + '</label><label>Cabang' + brSel(cur ? cur.branch_id : '') + '</label></div><label>Berlaku mulai<input type=\"date\" name=\"d\" value=\"' + day + '\"></label><label>Alasan<input name=\"why\" placeholder=\"Contoh: Wanaraja kekurangan runner akhir pekan\"></label>', 'Simpan',\n        async f => { this.need(f.pos, 'Pilih posisi'); this.need(f.br, 'Pilih cabang'); await this.call('ops_assign', { p_person: p.id, p_position: f.pos, p_branch: f.br, p_start: f.d || day, p_reason: f.why || null, p_mode: f.mode || 'mutasi' }); }))\n        { RA.ok('Penugasan tersimpan · petugas mendapat notifikasi'); this.load(); } return; }\n    if ((b = g('sc'))) { const p = pOf(b.dataset.sc); if (!p.linked) throw new Error(p.nick + ' belum pernah masuk ops.pokama.org. Jadwal bisa diatur setelah ia masuk pertama kali.');\n      const hh = t => t ? String(t).slice(0, 5) : '';\n      if (await this.modal('Jadwal shift · ' + p.nick, '<div class=\"g2\"><label>Dari<input type=\"date\" name=\"d\" value=\"' + day + '\"></label><label>Sampai<input type=\"date\" name=\"to\" value=\"' + day + '\"></label></div><div class=\"g2\"><label>Shift<select name=\"sh\">' + this.opts([['Pagi', 'Pagi'], ['Siang', 'Siang'], ['Sore', 'Sore'], ['Malam', 'Malam'], ['Penuh', 'Penuh']], (p.sched && p.sched.shift) || 'Pagi') + '</select></label><span></span></div><div class=\"g2\"><label>Masuk<input type=\"time\" name=\"s\" value=\"' + (p.sched ? hh(p.sched.starts) : '08:00') + '\"></label><label>Pulang<inp