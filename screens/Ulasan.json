{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Beri ulasan</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0}\na{color:#1F2B4D}a:hover{color:#000}\n</style>\n</helmet>\n<div style=\"width: 390px; height: 1100px; box-sizing: border-box; background: #F4F6F9; color: #1F2B4D; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; flex-direction: column; position: relative; overflow: hidden\">\n<header style=\"display: flex; align-items: center; gap: 8px; padding: 10px 12px; border-bottom: 1px solid #E6E8EC\">\n    <a href=\"Akun.dc.html\" aria-label=\"Kembali\" style=\"width: 44px; height: 44px; display: flex; align-items: center; justify-content: center\">\n      <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1F2B4D\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M15 6l-6 6 6 6\"/></svg>\n    </a>\n    <div style=\"display: flex; flex-direction: column\"><div style=\"font-size: 18px; font-weight: 800\">Beri ulasan</div></div>\n  </header>\n  <sc-if value=\"{{missing}}\"><section style=\"padding: 24px 16px; font-size: 15px; line-height: 22px; color: #4A5468\">{{missing}} <a href=\"Akun.dc.html\" style=\"font-weight: 700\">Lihat booking saya</a></section></sc-if>\n  <sc-if value=\"{{open}}\">\n    <section style=\"padding: 16px; display: flex; flex-direction: column; gap: 16px\">\n      <div style=\"display: flex; gap: 12px; align-items: center\">\n        <div style=\"width: 64px; height: 64px; border-radius: 12px; flex-shrink: 0; background: #F1F3F5; border: 1px solid #D5D9E0; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; color: #6B7385; text-align: center; font-size: 10px; overflow: hidden\"><sc-if value=\"{{photo}}\"><img src=\"{{photo}}\" alt=\"\" style=\"width: 64px; height: 64px; object-fit: cover\"></sc-if></div>\n        <div><div style=\"font-size: 16px; font-weight: 800\">{{name}}</div><div style=\"font-size: 13px; color: #4A5468\">{{sub}}</div></div>\n      </div>\n      <div style=\"display: flex; flex-direction: column; gap: 8px\">\n        <div style=\"font-size: 15px; font-weight: 800\">Seberapa puas?</div>\n        <div role=\"group\" aria-label=\"Nilai\" style=\"display: flex; gap: 6px\">\n          <sc-for list=\"{{stars}}\" as=\"st\">\n            <button type=\"button\" onClick=\"{{st.pick}}\" aria-label=\"{{st.aria}}\" aria-pressed=\"{{st.on}}\" style=\"width: 48px; height: 48px; border: none; background: transparent; padding: 0; cursor: pointer\">\n              <svg width=\"36\" height=\"36\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z\" fill=\"{{st.fill}}\" stroke=\"#C79A2C\" stroke-width=\"1.4\" stroke-linejoin=\"round\"/></svg>\n            </button>\n          </sc-for>\n        </div>\n      </div>\n      <div style=\"display: flex; flex-direction: column; gap: 8px\">\n        <div style=\"font-size: 15px; font-weight: 800\">Yang paling terasa</div>\n        <div style=\"display: flex; flex-wrap: wrap; gap: 6px\">\n          <sc-for list=\"{{tags}}\" as=\"t\">\n            <button type=\"button\" onClick=\"{{t.pick}}\" aria-pressed=\"{{t.on}}\" style=\"{{t.style}}\">{{t.label}}</button>\n          </sc-for>\n        </div>\n      </div>\n      <label style=\"display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 700; color: #4A5468\">Cerita singkat (opsional)\n        <textarea rows=\"3\" value=\"{{body}}\" onChange=\"{{setBody}}\" maxlength=\"1000\" placeholder=\"Contoh: unit bersih, baterai awet seharian\" style=\"height: 48px; box-sizing: border-box; border: 1px solid #D5D9E0; border-radius: 10px; padding: 0 12px; font: 600 16px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; background: #FFFFFF; width: 100%; height: auto; padding: 10px 12px; resize: vertical\"></textarea>\n      </label>\n      <div style=\"display: flex; flex-direction: column; gap: 8px\">\n        <div style=\"display: flex; justify-content: space-between; align-items: baseline\"><div style=\"font-size: 15px; font-weight: 800\">Foto</div><sc-if value=\"{{photoBonus}}\"><span style=\"display: inline-flex; align-items: center; height: 24px; padding: 0 9px; border-radius: 12px; font-size: 12px; font-weight: 800; white-space: nowrap; background: #E3F7F5; color: #077A70\">{{photoBonus}}</span></sc-if></div>\n        <div style=\"display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px\">\n          <sc-for list=\"{{pics}}\" as=\"pc\"><div style=\"height: 88px; border-radius: 12px; overflow: hidden; position: relative; background: #F1F3F5\"><img src=\"{{pc.url}}\" alt=\"Foto ulasan\" style=\"width: 100%; height: 88px; object-fit: cover\"><button type=\"button\" onClick=\"{{pc.del}}\" aria-label=\"Hapus foto\" style=\"position: absolute; top: 4px; right: 4px; width: 26px; height: 26px; border-radius: 13px; border: none; background: rgba(31,43,77,0.75); color: #FFFFFF; font: 800 14px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">×</button></div></sc-for>\n          <sc-if value=\"{{canAdd}}\"><label style=\"height: 88px; box-sizing: border-box; border-radius: 12px; border: 1.5px dashed #B4BCC8; background: #FFFFFF; color: #4A5468; font: 700 12px 'Plus Jakarta Sans', sans-serif; display: flex; align-items: center; justify-content: center; cursor: pointer\">Tambah foto<input type=\"file\" accept=\"image/*\" multiple onChange=\"{{addPics}}\" style=\"display: none\"></label></sc-if>\n        </div>\n      </div>\n      <button type=\"button\" onClick=\"{{send}}\" disabled=\"{{busy}}\" style=\"{{sendStyle}}\">{{sendLabel}}</button>\n    </section>\n  </sc-if>\n  <sc-if value=\"{{sent}}\">\n    <section style=\"padding: 28px 20px 0; display: flex; flex-direction: column; gap: 14px\">\n      <div style=\"width: 56px; height: 56px; border-radius: 28px; background: #09BEAF; display: flex; align-items: center; justify-content: center\"><svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1F2B4D\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12l5 5 9-10\"/></svg></div>\n      <h1 style=\"margin: 0; font-size: 24px; line-height: 30px; font-weight: 800\">Terima kasih</h1>\n      <p style=\"margin: 0; font-size: 15px; line-height: 22px; color: #4A5468\">{{sentText}}</p>\n      <sc-if value=\"{{gmLink}}\">\n        <div style=\"border: 1px solid #E3E7ED; border-radius: 14px; padding: 14px 16px; display: flex; flex-direction: column; gap: 10px\">\n          <div style=\"font-size: 15px; font-weight: 800\">Mau bantu sedikit lagi?</div>\n          <div style=\"font-size: 14px; line-height: 21px; color: #4A5468\">Tulis ulasan singkat juga di Google Maps. Satu menit saja, dan sangat membantu orang lain menemukan Rentalaja.</div>\n          <a href=\"{{gmLink}}\" target=\"_blank\" rel=\"noopener\" style=\"height: 48px; border-radius: 12px; border: 1.5px solid #1F2B4D; background: #FFFFFF; color: #1F2B4D; font: 800 15px 'Plus Jakarta Sans', sans-serif; display: flex; align-items: center; justify-content: center; text-decoration: none\">Tulis ulasan di Google Maps</a>\n        </div>\n      </sc-if>\n      <a href=\"{{againHref}}\" style=\"height: 52px; border-radius: 12px; border: none; background: #09BEAF; color: #1F2B4D; font: 800 16px 'Plus Jakarta Sans', sans-serif; display: flex; align-items: center; justify-content: center; text-decoration: none; cursor: pointer; width: 100%\">Sewa lagi</a>\n    </section>\n  </sc-if>\n\n</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{\"$preview\":{\"width\":390,\"height\":1100}}'>\nclass Component extends DCLogic {\nstate = { b: null, missing: null, stars: 0, tags: {}, body: '', files: [], sent: null };\nasync componentDidMount() {\n  const sel = 'id,code,status,start_at,end_at,branch_id,branches(name,code),booking_items(product_id,status,products(id,name,photos))';\n  let b = null;\n  if (this.params.id) b = (await RA.from('bookings').select(sel).eq('id', this.params.id).maybeSingle()).data;\n  const { data: revs } = await RA.from('reviews').select('booking_id,rating');\n  const done = {}; (revs || []).forEach(r => { done[r.booking_id] = 1; });\n  if (!b && !this.params.id) {\n    const { data } = await RA.from('bookings').select(sel).in('status', ['completed', 'returned']).order('end_at', { ascending: false }).limit(20);\n    b = (data || []).find(x => !done[x.id]) || null;\n  }\n  if (!RA_ALIVE(this)) return;\n  if (!b) { this.setState({ missing: this.params.id ? 'Booking tidak ditemukan.' : 'Belum ada sewa selesai yang perlu diulas.' }); return; }\n  if (['completed', 'returned'].indexOf(b.status) < 0) { this.setState({ missing: 'Ulasan bisa diberikan setelah barang kembali.' }); return; }\n  this.setState({ b, sent: done[b.id] ? { points: 0, already: true } : null });\n}\ncomponentWillUnmount() { this.state.files.forEach(f => URL.revokeObjectURL(f.url)); }\nrenderVals() {\n  const s = this.state, b = s.b;\n  if (!b) return { missing: s.missing, open: false, sent: false };\n  const prods = []; (b.booking_items || []).filter(i => i.status !== 'released').forEach(i => { if (i.products && !prods.some(p => p.id === i.product_id)) prods.push(i.products); });\n  const p = prods[0] || {};\n  const d = new Date(b.start_at);\n  const stars = [1, 2, 3, 4, 5].map(n => ({ aria: n + ' bintang', on: s.stars >= n ? 'true' : 'false', fill: s.stars >= n ? '#E8B83A' : 'none', pick: () => this.setState({ stars: n }) }));\n  const list = ['Unit bersih', 'Sesuai foto', 'CS ramah', 'Serah-terima cepat', 'Harga pas', 'Bisa lebih baik'];\n  const chipS = on => 'height: 38px; padding: 0 12px; border-radius: 19px; cursor: pointer; font: 700 13px \"Plus Jakarta Sans\", sans-serif; color: #1F2B4D; ' + (on ? 'border: 1.5px solid #1F2B4D; background: #E3F7F5;' : 'border: 1px solid #D5D9E0; background: #FFFFFF;');\n  const tags = list.map(l => ({ label: l, on: s.tags[l] ? 'true' : 'false', style: chipS(!!s.tags[l]), pick: () => this.setState({ tags: Object.assign({}, s.tags, { [l]: !s.tags[l] }) }) }));\n  const ready = s.stars > 0 && !s.busy;\n  const bp = RA.setting('bonus_review_photo'), br = RA.setting('bonus_review');\n  const photoBonus = bp != null && +bp > +(br || 0) ? '+' + RA.num(bp) + ' poin kalau ada foto' : '';\n  const sent = s.sent;\n  return {\n    missing: null, open: !sent, sent: !!sent,\n    name: prods.map(x => x.name).join(' + ') || b.code, photo: RA.photo(p.photos),\n    sub: [RA.days(b.start_at, b.end_at) + ' hari', b.branches && b.branches.name, RA.BLN[d.getMonth()] + ' ' + d.getFullYear()].filter(Boolean).join(' · '),\n    stars, tags, body: s.body, setBody: e => this.setState({ body: e.target.value }),\n    photoBonus, pics: s.files.map((f, i) => ({ url: f.url, del: () => { URL.revokeObjectURL(f.url); this.setState({ files: s.files.filter((x, k) => k !== i) }); } })),\n    canAdd: s.files.length < 3,\n    addPics: e => { const fs = Array.from(e.target.files || []).filter(f => /^image\\//.test(f.type)).slice(0, 3 - s.files.length);\n      if (fs.some(f => f.size > 8 * 1024 * 1024)) { RA.toast('Ukuran foto maksimal 8 MB.', 'bad'); return; }\n      this.setState({ files: s.files.concat(fs.map(f => ({ file: f, url: URL.createObjectURL(f) }))) }); },\n    busy: !!s.busy, sendLabel: s.busy ? 'Mengirim…' : 'Kirim ulasan',\n    sendStyle: 'height: 52px; border-radius: 12px; border: none; font: 800 16px \"Plus Jakarta Sans\", sans-serif; ' + (ready ? 'background: #09BEAF; color: #1F2B4D; cursor: pointer;' : 'background: #E6E8EC; color: #6B7385; cursor: not-allowed;'),\n    send: this.act(async () => {\n      if (s.stars < 1) { RA.toast('Pilih bintang dulu.', 'bad'); return; }\n      const c = await RA.customer();\n      const paths = [];\n      for (let i = 0; i < s.files.length; i++) {\n        const f = s.files[i].file; const ext = (f.type.split('/')[1] || 'jpg').replace('jpeg', 'jpg');\n        paths.push(await RA.upload('dokumen', c.id + '/review-' + b.id.slice(0, 8) + '-' + Date.now() + '-' + i + '.' + ext, f));\n      }\n      const r = await RA.call('submit_review', { p_booking: b.id, p_rating: s.stars, p_tags: list.filter(l => s.tags[l]), p_body: s.body || null, p_photos: paths, p_product: p.id || null });\n      RA.customer(true);\n      this.setState({ sent: { points: +(r && r.points || 0) } });\n    }),\n    sentText: sent ? (sent.already ? 'Ulasan untuk booking ini sudah kamu kirim. ' : sent.points > 0 ? '+' + RA.num(sent.points) + ' poin masuk ke akunmu. ' : '') + 'Ulasan tampil di halaman produk setelah dicek CS.' : '',\n    gmLink: (() => { const g = RA.setting('gmaps') || {}; const code = b.branches && b.branches.code; const x = g[code] || (code && code.indexOf('BDG') === 0 ? g['BDG-HUB'] : null); return sent && x && x.place_id ? 'https://search.google.com/local/writereview?placeid=' + x.place_id : ''; })(),\n    againHref: p.id ? 'Produk.dc.html?id=' + p.id : 'Katalog.dc.html'\n  };\n}\n}\n</script>\n</body>\n</html>\n"}