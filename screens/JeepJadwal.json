{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Jadwal trip Jeep</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0}\na{color:#1F2B4D}a:hover{color:#000}\n</style>\n</helmet>\n<div style=\"width: 390px; min-height: 1160px; box-sizing: border-box; background: #F4F6F9; color: #1F2B4D; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; flex-direction: column; position: relative\">\n<header style=\"display: flex; align-items: center; gap: 8px; padding: 10px 12px; background: #FFFFFF; border-bottom: 1px solid #E6E8EC; position: sticky; top: 0; z-index: 6\">\n    <a href=\"{{backHref}}\" aria-label=\"Kembali\" style=\"width: 44px; height: 44px; display: flex; align-items: center; justify-content: center\">\n      <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1F2B4D\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M15 6l-6 6 6 6\"/></svg>\n    </a>\n    <div style=\"display: flex; flex-direction: column; flex: 1; min-width: 0\"><div style=\"font-size: 18px; font-weight: 800\">Pesan trip Jeep</div><div style=\"font-size: 12px; color: #4A5468\">{{subline}}</div></div>\n  </header>\n  <sc-if value=\"{{missing}}\"><section style=\"padding: 24px 16px; display: flex; flex-direction: column; gap: 12px; align-items: flex-start\"><div style=\"font-size: 15px; color: #4A5468\">{{missing}}</div><a href=\"JeepPaket.dc.html\" style=\"height: 48px; padding: 0 20px; border-radius: 12px; background: #09BEAF; color: #1F2B4D; font-weight: 800; display: flex; align-items: center; text-decoration: none\">Lihat paket Jeep</a></section></sc-if>\n  <sc-if value=\"{{ready}}\">\n  <section style=\"padding: 14px 16px 0\">\n    <div style=\"position: relative; height: 150px; border-radius: 20px; overflow: hidden; background: #2B2B22\">\n      <img src=\"{{photo}}\" alt=\"\" style=\"width: 100%; height: 100%; object-fit: cover; display: block\">\n      <span style=\"position: absolute; inset: 0; background: linear-gradient(0deg, rgba(15,15,10,.85) 0%, rgba(15,15,10,.2) 60%, rgba(15,15,10,0) 100%)\"></span>\n      <a href=\"JeepPaket.dc.html\" style=\"position: absolute; top: 10px; right: 10px; background: rgba(255,255,255,.92); color: #1F2B4D; font-size: 12px; font-weight: 800; border-radius: 10px; padding: 6px 10px; text-decoration: none\">Ganti paket</a>\n      <div style=\"position: absolute; left: 14px; right: 14px; bottom: 12px; color: #FFFFFF\">\n        <div style=\"font-size: 11px; font-weight: 800; letter-spacing: .08em; color: #F2C96B\">JEEP OFFROAD · GUNUNG GUNTUR</div>\n        <div style=\"font-size: 21px; font-weight: 800; line-height: 26px\">{{pkgName}}</div>\n        <div style=\"display: flex; gap: 6px; margin-top: 6px; flex-wrap: wrap\"><sc-for list=\"{{chips}}\" as=\"c\"><span style=\"background: rgba(255,255,255,.18); border-radius: 8px; padding: 3px 8px; font-size: 11.5px; font-weight: 700\">{{c}}</span></sc-for></div>\n      </div>\n    </div>\n  </section>\n\n  <section style=\"padding: 14px 16px 0\">\n    <div style=\"background: #FFFFFF; border-radius: 20px; box-shadow: 0 2px 12px rgba(31,43,77,.06); padding: 14px 0; display: flex; flex-direction: column; gap: 12px\">\n      <div style=\"padding: 0 14px\"><h2 style=\"margin: 0; font-size: 16px; font-weight: 800\">1. Kapan berangkat?</h2><div style=\"font-size: 12.5px; color: #4A5468; margin-top: 2px\">{{monthText}}</div></div>\n      <div style=\"display: flex; gap: 8px; overflow-x: auto; padding: 2px 14px 4px; scroll-padding: 0 14px; scrollbar-width: none\">\n        <sc-for list=\"{{days}}\" as=\"d\"><button type=\"button\" onClick=\"{{d.pick}}\" aria-pressed=\"{{d.on}}\" aria-label=\"{{d.aria}}\" disabled=\"{{d.off}}\" style=\"{{d.s}}\"><span style=\"font-size: 11px; font-weight: 700; opacity: .8\">{{d.l}}</span><b style=\"font-size: 18px; line-height: 22px\">{{d.n}}</b><span style=\"{{d.ss}}\">{{d.sub}}</span></button></sc-for>\n      </div>\n      <sc-if value=\"{{multiSlot}}\">\n      <div style=\"padding: 0 14px; display: flex; flex-direction: column; gap: 8px\">\n        <div style=\"font-size: 13px; font-weight: 800\">Jam berangkat</div>\n        <div style=\"display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px\"><sc-for list=\"{{slots}}\" as=\"t\"><button type=\"button\" onClick=\"{{t.pick}}\" aria-pressed=\"{{t.on}}\" disabled=\"{{t.off}}\" style=\"{{t.s}}\"><sc-if value=\"{{t.badge}}\"><span style=\"position: absolute; top: -9px; left: 50%; transform: translateX(-50%); background: #0E8A4F; color: #FFFFFF; font-size: 9.5px; font-weight: 800; border-radius: 6px; padding: 2px 6px; white-space: nowrap\">{{t.badge}}</span></sc-if><b style=\"font-size: 15px\">{{t.l}}</b><span style=\"{{t.ss}}\">{{t.sub}}</span></button></sc-for></div>\n      </div>\n      </sc-if>\n      <sc-if value=\"{{ebText}}\"><div style=\"{{ebStyle}}\"><span style=\"font-size: 15px\">🎟️</span><span style=\"flex: 1\">{{ebText}}</span></div></sc-if>\n      <div style=\"margin: 0 14px; display: flex; gap: 10px; align-items: center; background: #F4F6F9; border-radius: 12px; padding: 10px 12px; font-size: 13px\"><span style=\"font-size: 16px\">🕗</span><span style=\"flex: 1\">Berangkat <b>{{depart}}</b>{{pickupHint}}</span><span style=\"{{slotChip}}\">{{slotText}}</span></div>\n    </div>\n  </section>\n\n  <section style=\"padding: 14px 16px 0\">\n    <div style=\"background: #FFFFFF; border-radius: 20px; box-shadow: 0 2px 12px rgba(31,43,77,.06); padding: 14px; display: flex; flex-direction: column; gap: 12px\">\n      <h2 style=\"margin: 0; font-size: 16px; font-weight: 800\">2. Berapa orang &amp; jeep?</h2>\n      <div style=\"display: flex; justify-content: space-between; align-items: center; gap: 10px\">\n        <div style=\"display: flex; gap: 10px; align-items: center\"><span style=\"width: 40px; height: 40px; border-radius: 12px; background: #FFF1DC; display: flex; align-items: center; justify-content: center; font-size: 18px\">👥</span><div><b style=\"font-size: 15px\">{{pax}} orang</b><div style=\"font-size: 12px; color: #4A5468\">total penumpang</div></div></div>\n        <div style=\"display: flex; align-items: center; gap: 4px; background: #F4F6F9; border-radius: 22px; padding: 3px\"><button type=\"button\" aria-label=\"Kurangi penumpang\" onClick=\"{{less}}\" style=\"{{lessS}}\">−</button><b style=\"min-width: 24px; text-align: center; font-size: 15px\">{{pax}}</b><button type=\"button\" aria-label=\"Tambah penumpang\" onClick=\"{{more}}\" style=\"{{moreS}}\">+</button></div>\n      </div>\n      <div style=\"height: 1px; background: #F0F2F5\"></div>\n      <div style=\"display: flex; justify-content: space-between; align-items: center; gap: 10px\">\n        <div style=\"display: flex; gap: 10px; align-items: center\"><span style=\"width: 40px; height: 40px; border-radius: 12px; background: #2B2B22; display: flex; align-items: center; justify-content: center; font-size: 18px\">🚙</span><div><b style=\"font-size: 15px\">{{jeeps}} jeep</b><div style=\"font-size: 12px; color: #4A5468\">{{jeepSub}}</div></div></div>\n        <div style=\"display: flex; align-items: center; gap: 4px; background: #F4F6F9; border-radius: 22px; padding: 3px\"><button type=\"button\" aria-label=\"Kurangi jeep\" onClick=\"{{lessJ}}\" style=\"{{lessJS}}\">−</button><b style=\"min-width: 24px; text-align: center; font-size: 15px\">{{jeeps}}</b><button type=\"button\" aria-label=\"Tambah jeep\" onClick=\"{{moreJ}}\" style=\"{{moreJS}}\">+</button></div>\n      </div>\n      <div style=\"display: flex; gap: 6px; flex-wrap: wrap\"><sc-for list=\"{{jeepViz}}\" as=\"v\"><span style=\"{{v.s}}\">🚙 <b>{{v.n}}</b> org</span></sc-for></div>\n      <sc-if value=\"{{paxWarn}}\"><div style=\"font-size: 12.5px; line-height: 18px; color: #8A4B00; background: #FFF1D6; border-radius: 10px; padding: 8px 10px\">{{paxWarn}}</div></sc-if>\n    </div>\n  </section>\n\n  <sc-if value=\"{{docOn}}\"><section style=\"padding: 14px 16px 0\"><button type=\"button\" onClick=\"{{toggleDoc}}\" aria-pressed=\"{{docPressed}}\" style=\"{{docStyle}}\"><span style=\"width: 44px; height: 44px; border-radius: 12px; background: #2B2B22; display: flex; align-items: center; justify-content: center; flex-shrink: 0\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#F2C96B\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 8h3l2-3h6l2 3h3v11H4z\"/><circle cx=\"12\" cy=\"13\" r=\"3.5\"/></svg></span><span style=\"flex: 1; text-align: left\"><b style=\"display: block; font-size: 15px\">Dokumentasi foto &amp; video</b><span style=\"font-size: 12.5px; color: #4A5468\">{{docSub}}</span></span><span style=\"text-align: right\"><b style=\"display: block; font-size: 14px\">{{docPrice}}</b><span style=\"{{docCheck}}\">{{docMark}}</span></span></button></section></sc-if>\n\n  <section style=\"padding: 14px 16px 0\">\n    <div style=\"background: #FFFFFF; border-radius: 20px; box-shadow: 0 2px 12px rgba(31,43,77,.06); padding: 14px; display: flex; flex-direction: column; gap: 10px\">\n      <div><h2 style=\"margin: 0; font-size: 16px; font-weight: 800\">3. Dijemput di mana?</h2><div style=\"font-size: 12.5px; color: #4A5468; margin-top: 2px\">Sopir menjemput gratis di penginapan Garut kota.</div></div>\n      <sc-for list=\"{{pickups}}\" as=\"o\"><button type=\"button\" onClick=\"{{o.go}}\" aria-pressed=\"{{o.on}}\" style=\"{{o.s}}\"><span style=\"{{o.radio}}\"></span><span style=\"flex: 1; text-align: left; font-size: 14px; font-weight: 700\">{{o.l}}</span><sc-if value=\"{{o.tag}}\"><span style=\"font-size: 11px; font-weight: 800; color: #077A70; background: #E3F7F5; border-radius: 8px; padding: 3px 7px\">{{o.tag}}</span></sc-if></button></sc-for>\n      <sc-if value=\"{{customPick}}\"><input type=\"text\" value=\"{{addr}}\" onChange=\"{{setAddr}}\" placeholder=\"Nama hotel atau alamat di Garut kota\" aria-label=\"Alamat penjemputan\" style=\"height: 50px; box-sizing: border-box; border: 1.5px solid #D5D9E0; border-radius: 12px; padding: 0 14px; font: 600 16px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; background: #FFFFFF; width: 100%\"></sc-if>\n      <sc-if value=\"{{affmPick}}\"><button type=\"button\" onClick=\"{{affmPickGo}}\" style=\"height: 44px; border-radius: 12px; border: 1.5px solid #077A70; background: #FFFFFF; color: #077A70; font: 800 14px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">{{affmPickLabel}}</button></sc-if>\n    </div>\n  </section>\n\n  <section style=\"padding: 14px 16px 0\">\n    <div style=\"background: #FFFFFF; border-radius: 20px; box-shadow: 0 2px 12px rgba(31,43,77,.06); padding: 14px; display: flex; flex-direction: column; gap: 12px\">\n      <div><h2 style=\"margin: 0; font-size: 16px; font-weight: 800\">4. Data pemesan</h2><div style=\"font-size: 12.5px; color: #4A5468; margin-top: 2px\">Tanpa daftar akun. Tiket &amp; kontak sopir dikirim ke email kamu.</div></div>\n      <label style=\"display: flex; flex-direction: column; gap: 6px; font-size: 12.5px; font-weight: 700; color: #4A5468\">Nama lengkap<input type=\"text\" autocomplete=\"name\" value=\"{{name}}\" onChange=\"{{setName}}\" placeholder=\"Nama pemesan\" style=\"height: 50px; box-sizing: border-box; border: 1.5px solid #D5D9E0; border-radius: 12px; padding: 0 14px; font: 600 16px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; background: #FFFFFF; width: 100%\"></label>\n      <label style=\"display: flex; flex-direction: column; gap: 6px; font-size: 12.5px; font-weight: 700; color: #4A5468\">Nomor HP\n        <span style=\"display: flex; align-items: center; height: 50px; box-sizing: border-box; border: 1.5px solid #D5D9E0; border-radius: 12px; background: #FFFFFF; overflow: hidden\"><span style=\"height: 100%; padding: 0 12px; display: flex; align-items: center; gap: 6px; background: #F4F6F9; border-right: 1px solid #E1E5EB; font: 800 14px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path fill=\"#25D366\" d=\"M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2z\"/></svg>+62</span><input type=\"tel\" autocomplete=\"tel\" value=\"{{phone}}\" onChange=\"{{setPhone}}\" placeholder=\"812 3456 7890\" style=\"flex: 1; min-width: 0; height: 100%; border: 0; padding: 0 12px; font: 600 16px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; background: transparent; outline: none\"></span></label>\n          <label style=\"display: flex; flex-direction: column; gap: 6px; font-size: 12.5px; font-weight: 700; color: #4A5468\">Email (tiket &amp; konfirmasi dikirim ke sini)<input type=\"email\" inputmode=\"email\" autocomplete=\"email\" value=\"{{email}}\" onChange=\"{{setEmail}}\" placeholder=\"nama@gmail.com\" style=\"height: 50px; box-sizing: border-box; border: 1.5px solid #D5D9E0; border-radius: 12px; padding: 0 14px; font: 600 16px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; background: #FFFFFF; width: 100%\"></label>\n      <sc-if value=\"{{affOpen}}\" not><button type=\"button\" onClick=\"{{openAff}}\" style=\"min-height: 46px; border-radius: 12px; border: 1.5px dashed #C5CBD4; background: #FFFFFF; display: flex; align-items: center; gap: 10px; padding: 0 12px; font: 700 13.5px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; cursor: pointer\"><span>🏷️</span><span style=\"flex: 1; text-align: left\">Punya kode mitra atau teman?</span><span style=\"color: #077A70; font-weight: 800\">Pakai</span></button></sc-if>\n      <sc-if value=\"{{affOpen}}\">\n      <div style=\"display: flex; gap: 8px\"><input id=\"affmini\" type=\"text\" value=\"{{affmInput}}\" onChange=\"{{affmSet}}\" placeholder=\"Kode mitra / teman\" aria-label=\"Kode mitra atau teman\" style=\"flex: 1; min-width: 0; height: 48px; box-sizing: border-box; border: 1.5px solid #D5D9E0; border-radius: 12px; padding: 0 12px; font: 800 15px 'Plus Jakarta Sans', sans-serif; letter-spacing: 0.06em; color: #1F2B4D; background: #FFFFFF; text-transform: uppercase\"><button type=\"button\" onClick=\"{{affmApply}}\" style=\"height: 48px; padding: 0 16px; border: 0; border-radius: 12px; background: #1F2B4D; color: #FFFFFF; font: 800 14px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">{{affmBtn}}</button></div>\n      <sc-if value=\"{{affmOk}}\"><div style=\"padding: 10px 12px; border-radius: 10px; background: #E3F7F5; font-size: 13px; line-height: 19px; color: #055C55\"><b>{{affmTitle}}</b> · {{affmSub}}</div></sc-if>\n      <sc-if value=\"{{affmBad}}\"><div style=\"padding: 10px 12px; border-radius: 10px; background: #FFF1D6; font-size: 13px; line-height: 19px; color: #5C3A00\">{{affmBad}}</div></sc-if>\n      </sc-if>\n    </div>\n  </section>\n\n  <section style=\"padding: 14px 16px 0\">\n    <div style=\"background: #FFFFFF; border-radius: 20px; box-shadow: 0 2px 12px rgba(31,43,77,.06); padding: 14px; display: flex; flex-direction: column; gap: 9px\">\n      <h2 style=\"margin: 0 0 2px; font-size: 16px; font-weight: 800\">Rincian harga</h2>\n      <sc-for list=\"{{lines}}\" as=\"l\"><div style=\"display: flex; justify-content: space-between; gap: 12px; font-size: 13.5px\"><span style=\"color: #4A5468\">{{l.k}}</span><b>{{l.v}}</b></div></sc-for>\n      <div style=\"display: flex; justify-content: space-between; align-items: baseline; gap: 12px; border-top: 1px dashed #D5D9E0; padding-top: 10px\"><b style=\"font-size: 15px\">Total</b><span style=\"text-align: right\"><sc-if value=\"{{wasText}}\"><span style=\"display: block; font-size: 12px; color: #9AA2B1; text-decoration: line-through\">{{wasText}}</span></sc-if><b style=\"font-size: 19px\">{{totalText}}</b></span></div>\n      <sc-if value=\"{{saveText}}\"><div style=\"display: flex; align-items: center; gap: 8px; background: #E6F7EE; border: 1.5px dashed #6FCF97; border-radius: 12px; padding: 8px 12px; color: #0E8A4F; font-size: 13px; font-weight: 800\">🎉 {{saveText}}</div></sc-if>\n      <sc-for list=\"{{opts}}\" as=\"o\"><button type=\"button\" onClick=\"{{o.pick}}\" aria-pressed=\"{{o.on}}\" style=\"{{o.s}}\"><span style=\"text-align: left\"><b style=\"font-size: 14px\">{{o.name}}</b><br><span style=\"font-size: 12px; color: #4A5468\">{{o.sub}}</span></span><b>{{o.now}}</b></button></sc-for>\n      <div style=\"display: flex; gap: 12px; align-items: center; background: #F4F6F9; border-radius: 12px; padding: 9px 12px\"><span style=\"width: 36px; height: 36px; border-radius: 10px; background: #FFFFFF; display: flex; align-items: center; justify-content: center; font-size: 10.5px; font-weight: 900; color: #0060AF; flex-shrink: 0\">BCA</span><div style=\"font-size: 12px; line-height: 17px; color: #4A5468\"><b style=\"color: #1F2B4D; font-size: 13px\">Transfer bank BCA</b><br>Ke rekening PT Popo Karya Investama, dicek admin.</div></div>\n    </div>\n  </section>\n\n  <sc-if value=\"{{sim}}\">\n  <section style=\"padding: 14px 16px 0\">\n    <div style=\"border: 2px solid #1F2B4D; border-radius: 16px; padding: 14px 16px; display: flex; flex-direction: column; gap: 10px; background: #FFFFFF\">\n      <div style=\"font-size: 14px; line-height: 20px\"><b>Tagihan {{simPay}} dibuat · {{simAmount}}</b><br><span style=\"color: #4A5468\">Pembayaran masih mode simulasi. Tekan tombol di bawah untuk mencatat pembayaran berhasil.</span></div>\n      <button type=\"button\" onClick=\"{{simulate}}\" disabled=\"{{busy}}\" style=\"height: 48px; border-radius: 12px; border: 1px solid #1F2B4D; background: #FFFFFF; color: #1F2B4D; font: 700 15px 'Plus Jakarta Sans', sans-serif; cursor: pointer; width: 100%\">Simulasikan pembayaran berhasil</button>\n    </div>\n  </section>\n  </sc-if>\n\n  <section style=\"padding: 14px 16px 0\">\n    <div style=\"background: #FFFFFF; border-radius: 20px; padding: 4px 14px\">\n      <sc-for list=\"{{policy}}\" as=\"r\"><div style=\"display: flex; gap: 12px; align-items: flex-start; padding: 11px 0; border-bottom: 1px solid #F0F2F5\"><span style=\"font-size: 17px; width: 24px; text-align: center; line-height: 20px\">{{r.ic}}</span><div style=\"font-size: 13px; line-height: 18px\"><b>{{r.h}}</b><br><span style=\"color: #4A5468\">{{r.t}}</span></div></div></sc-for>\n    </div>\n  </section>\n  <sc-if value=\"{{error}}\"><div role=\"alert\" style=\"margin: 14px 16px 0; font-size: 13px; line-height: 19px; color: #A12A1F; background: #FDECEA; border-radius: 12px; padding: 10px 12px\">{{error}}</div></sc-if>\n  <div style=\"height: 22px\"></div>\n  <div style=\"position: sticky; bottom: 0; z-index: 5; margin-top: auto; background: #FFFFFF; border-top: 1px solid #E6E8EC; box-shadow: 0 -6px 18px rgba(31,43,77,.06); padding: 12px 16px 14px; display: flex; flex-direction: column; gap: 8px\">\n    <div style=\"display: flex; align-items: center; gap: 12px\"><div style=\"flex: 1; min-width: 0\"><div style=\"font-size: 11.5px; color: #4A5468; white-space: nowrap; overflow: hidden; text-overflow: ellipsis\">{{dateText}}</div><b style=\"font-size: 19px\">{{payNowText}}</b><sc-if value=\"{{saveText}}\"><span style=\"margin-left: 6px; font-size: 11px; font-weight: 800; color: #0E8A4F; background: #E6F7EE; border-radius: 6px; padding: 2px 6px; vertical-align: 3px\">hemat</span></sc-if></div><button type=\"button\" onClick=\"{{go}}\" disabled=\"{{cant}}\" style=\"{{btnStyle}}\">{{btnLabel}}</button></div>\n    <div style=\"font-size: 11px; line-height: 15px; color: #6B7385; text-align: center\">🔒 Dengan memesan, Anda setuju dengan <a href=\"Bantuan.dc.html?tab=syarat\">ketentuan</a> dan <a href=\"Bantuan.dc.html?tab=privasi\">kebijakan privasi</a>.</div>\n  </div>\n  </sc-if>\n</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{\"$preview\":{\"width\":390,\"height\":1700}}'>\nclass Component extends DCLogic {\nstate = { p: null, missing: null, stays: [], free: {}, d: null, pax: 1, pick: '', addr: '', full: false, q: null,\n  name: '', phone: '', code: '', otpStep: false, norm: null, simCodeOtp: '', b: null, sim: null, error: '', jeeps: 1, stayR: null, affOpen: false };\nDAYS = 10;\nbase() { const t = new Date(); t.setHours(0, 0, 0, 0); if (this._stay) { const d = new Date(this._stay.in + 'T00:00:00'); return d > t ? d : t; } const q = this.params.date; if (q && /^\\d{4}-\\d{2}-\\d{2}$/.test(q)) { const d = new Date(q + 'T00:00:00'); if (d > t) { const m = new Date(t); m.setDate(m.getDate() + 80); return d < m ? d : t; } } return t; }\nasync componentDidMount() {\n  if (this.params.booking) { RA.go('InapBayar', { id: this.params.booking }); return; }\n  const id = this.params.id;\n  const [adds, trips, stays, jhR] = await Promise.all([\n    RA.call('experience_catalog', { p_category: 'jeep-addon' }).catch(() => []),\n    RA.call('experience_catalog', { p_category: 'jeep' }).catch(() => []),\n    RA.call('experience_catalog', { p_category: 'penginapan' }).catch(() => []),\n    RA.from('auto_promos').select('key,rule').eq('key', 'jeep_hemat').then(r => r, () => ({ data: [] }))\n  ]);\n  if (!RA_ALIVE(this)) return;\n  const p = trips.find(x => x.id === id) || (!id ? trips[0] : null);\n  if (!p) { this.setState({ missing: 'Paket trip tidak ditemukan.' }); return; }\n  if (!p.branch || !p.depart_time) { this.setState({ missing: 'Paket ini belum bisa dipesan online.' }); return; }\n  const pre = this.params.pickup && stays.find(x => x.id === this.params.pickup);\n  const cust = RA.isLoggedIn() ? await RA.customer().catch(() => null) : null;\n  const cst = RA.ctx().stay || {};\n  const ctxPax = cst.guests;\n  let stayR = null;\n  if (pre && cst.product_id === pre.id && cst.in && cst.in >= RA.iso(new Date())) {\n    const n = Math.max(1, cst.nights || 1); const o = new Date(cst.in + 'T00:00:00'); o.setDate(o.getDate() + n);\n    stayR = { in: cst.in, out: RA.iso(o), nights: 