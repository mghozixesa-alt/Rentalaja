st).replace('{port}', sv.port || 5023) : '', rb = sv.rollback || 'SZCS,123456,DOMAIN=d.micodus.net:7700';\n  const sms = t => phone && t ? 'sms:' + phone + '?&body=' + encodeURIComponent(t) : '';\n  const canSet = !!(RA.can && (RA.can('mgmt.assets') || RA.can('pos.units') || RA.can('field.workorder'))) || ['owner', 'asset_manager', 'technician'].indexOf(me.role) > -1;\n  const wBlock = !g.has_imei ? 'IMEI alat belum diisi. Isi dulu di kartu GPS di bawah (Ubah data).' : !g.has_sim ? 'Nomor SIM alat belum diisi. Isi dulu di kartu GPS di bawah (Ubah data).' : !sv.ok ? 'Server GPS belum diatur owner (Peta armada → Pengaturan server GPS).' : '';\n  const waiting = g.connect_odo != null && !g.online_at ? 'Menunggu posisi pertama dari alat… Kalau lebih dari 15 menit belum masuk, cek balasan SMS dan pulsa/kuota kartu SIM alat.' : '';\n  const AK = s.aki, AN = (AK && AK.now) || {}, HR = ['Min', 'Sen', 'Sel', 'Rab', 'Kam', 'Jum', 'Sab'];\n  const akC = v => v == null ? '#B4BCC8' : v < 11.5 ? '#C0392B' : v < 12 ? '#E06A1B' : v < 12.4 ? '#C98A00' : '#1E9E62';\n  const fv = v => v == null ? '—' : String(Math.round(v * 10) / 10).replace('.', ',');\n  const akTag = AN.cut_at && now - new Date(AN.cut_at) < 2 * 36e5 ? ['Diputus', 'background: #FDE8E6; color: #C0392B'] : AN.rest == null && AN.run == null ? ['Belum ada data', 'background: #EEF0F3; color: #4A5468']\n    : AN.rest != null && AN.rest < 11.5 ? ['Kritis', 'background: #FDE8E6; color: #C0392B'] : AN.rest != null && AN.rest < 12 ? ['Lemah', 'background: #FFF0DC; color: #9A5B00']\n    : AN.run != null && AN.run < 12.9 ? ['Pengisian kurang', 'background: #FFF0DC; color: #9A5B00'] : ['Sehat', 'background: #E4F4E9; color: #1E7A3F'];\n  const aki = conn ? { tag: akTag[0], chip: chipS(akTag[1]),\n    sub: (AN.rest != null ? 'Mesin mati: ' + fv(AN.rest) + ' V' : 'Mesin mati: belum terbaca') + ' · ' + (AN.run != null ? 'mesin hidup & jalan: ' + fv(AN.run) + ' V' + (AN.run < 12.9 ? ' (kurang, cek kiprok/spul)' : ' (pengisian normal)'