{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Data GPS &amp; perawatan</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0}\n.cp-card{background:#FFFFFF;border-radius:20px;box-shadow:0 2px 12px rgba(31,43,77,.06);padding:16px;display:flex;flex-direction:column;gap:12px}\n.cp-in{height:50px;box-sizing:border-box;border:2px solid #CDEFEA;border-radius:14px;padding:0 14px;font:700 16px 'Plus Jakarta Sans',sans-serif;color:#1F2B4D;background:#FFFFFF;width:100%}\n.cp-btn{height:50px;border:0;border-radius:14px;background:linear-gradient(135deg,#12B5A6,#077A70);color:#FFFFFF;font:800 15px 'Plus Jakarta Sans',sans-serif;cursor:pointer;display:flex;align-items:center;justify-content:center;text-decoration:none;width:100%}\n.cp-btn2{height:46px;border:1.5px solid #E3E7ED;border-radius:14px;background:#FFFFFF;color:#1F2B4D;font:800 14px 'Plus Jakarta Sans',sans-serif;cursor:pointer;display:flex;align-items:center;justify-content:center;text-decoration:none}\n.cp-st{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}\n.cp-st div{background:#F6F7F9;border-radius:14px;padding:10px 12px}\n.cp-st b{display:block;font-size:20px;line-height:26px}\n.cp-st span{font-size:12px;color:#4A5468}\n.cp-kv{display:flex;justify-content:space-between;gap:10px;font-size:13.5px;padding:9px 0;border-bottom:1px solid #EEF0F3}\n.cp-kv:last-child{border-bottom:0}.cp-kv span{color:#5B6577}.cp-kv b{text-align:right}\n.cp-rad{display:flex;align-items:center;gap:10px;min-height:48px;border:1.5px solid #E3E7ED;border-radius:14px;padding:0 14px;font:700 14px 'Plus Jakarta Sans',sans-serif;color:#1F2B4D;background:#FFFFFF;cursor:pointer;text-align:left;width:100%}\n.cp-rad i{width:18px;height:18px;border-radius:50%;border:2px solid #B4BCC8;flex:none;box-sizing:border-box}\n.cp-rad.on{border-color:#077A70;background:#F2FBFA}.cp-rad.on i{border:6px solid #077A70}\n</style>\n</helmet>\n<div style=\"min-height: 100vh; box-sizing: border-box; background: #F4F6F9; color: #1F2B4D; font-family: 'Plus Jakarta Sans', system-ui, sans-serif\">\n <header style=\"background: linear-gradient(170deg, #0A9E92 0%, #077A70 100%); color: #FFFFFF; padding: 16px\">\n  <div style=\"max-width: 640px; margin: 0 auto; display: flex; gap: 12px; align-items: center\"><a href=\"AsetPengingat.dc.html\" aria-label=\"Kembali\" style=\"width: 38px; height: 38px; border-radius: 12px; background: rgba(255,255,255,.18); color: #FFFFFF; font-size: 22px; font-weight: 800; display: flex; align-items: center; justify-content: center; text-decoration: none\">‹</a>\n  <span><b style=\"display: block; font-size: 19px\">{{title}}</b><span style=\"font-size: 13px; opacity: .9\">{{sub}}</span></span></div>\n </header>\n <main style=\"max-width: 640px; margin: 0 auto; padding: 16px 16px 28px; display: flex; flex-direction: column; gap: 12px\">\n  <sc-if value=\"{{loading}}\"><div class=\"cp-card\" style=\"text-align: center; color: #4A5468\">Memuat…</div></sc-if>\n  <sc-if value=\"{{ready}}\">\n  <section class=\"cp-card\" style=\"gap: 4px\">\n   <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px\"><b style=\"font-size: 17px\">📡 GPS</b><span style=\"{{gpsChip}}\">{{gpsTag}}</span></div>\n   <sc-if value=\"{{editGps}}\" not>\n    <sc-for list=\"{{gpsKv}}\" as=\"k\"><div class=\"cp-kv\"><span>{{k.l}}</span><b style=\"color: {{k.c}}\">{{k.v}}</b></div></sc-for>\n    <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 8px\"><sc-if value=\"{{appUrl}}\"><a class=\"cp-btn2\" href=\"{{appUrl}}\" target=\"_blank\" rel=\"noopener\">Buka aplikasi GPS ↗</a></sc-if><sc-if value=\"{{appUrl}}\" not><span class=\"cp-btn2\" style=\"color: #9AA3B2\">Link aplikasi belum diisi</span></sc-if><button type=\"button\" class=\"cp-btn2\" onClick=\"{{startEdit}}\">Ubah data</button></div>\n   </sc-if>\n   <sc-if value=\"{{editGps}}\"><div style=\"display: flex; flex-direction: column; gap: 8px\">\n    <sc-for list=\"{{fields}}\" as=\"f\"><label style=\"display: flex; flex-direction: column; gap: 4px; font-size: 12px; font-weight: 700; color: #4A5468\">{{f.l}}<input class=\"cp-in\" style=\"border-color: #E3E7ED; height: 44px; font-size: 14px\" type=\"{{f.t}}\" placeholder=\"{{f.ph}}\" value=\"{{f.v}}\" onInput=\"{{f.set}}\"></label></sc-for>\n    <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 8px\"><button type=\"button\" class=\"cp-btn2\" onClick=\"{{cancelEdit}}\">Batal</button><button type=\"button\" class=\"cp-btn\" style=\"height: 46px; font-size: 14px\" onClick=\"{{saveGps}}\" disabled=\"{{busy}}\">Simpan</button></div>\n   </div></sc-if>\n   <div style=\"font-size: 12px; color: #6B7486; margin-top: 6px\">🔒 Password akun GPS tidak disimpan di aplikasi. IMEI &amp; nomor SIM hanya tampil sebagian.</div>\n  </section>\n  <section class=\"cp-card\" style=\"gap: 4px\"><b style=\"font-size: 17px; margin-bottom: 4px\">🔧 Jadwal perawatan</b>\n   <sc-for list=\"{{care}}\" as=\"k\"><div class=\"cp-kv\"><span>{{k.l}}</span><b style=\"color: {{k.c}}\">{{k.v}}</b></div></sc-for>\n   <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 10px\">\n    <label style=\"display: flex; flex-direction: column; gap: 4px; font-size: 12px; font-weight: 700; color: #4A5468\">Odometer sekarang (km)<input class=\"cp-in\" style=\"border-color: #E3E7ED; height: 44px; font-size: 14px\" type=\"text\" inputmode=\"numeric\" value=\"{{km}}\" onInput=\"{{setKm}}\"></label>\n    <label style=\"display: flex; flex-direction: column; gap: 4px; font-size: 12px; font-weight: 700; color: #4A5468\">Pajak STNK (tahunan)<input class=\"cp-in\" style=\"border-color: #E3E7ED; height: 44px; font-size: 14px\" type=\"date\" value=\"{{tax}}\" onInput=\"{{setTax}}\"></label>\n   </div>\n   <button type=\"button\" class=\"{{svcCls}}\" style=\"margin-top: 8px\" onClick=\"{{setSvc}}\"><i></i>Baru selesai servis hari ini (reset hitungan servis &amp; oli)</button>\n   <button type=\"button\" class=\"cp-btn\" style=\"margin-top: 8px\" onClick=\"{{saveCare}}\" disabled=\"{{busy}}\">Catat servis / isi odometer</button>\n  </section>\n  </sc-if>\n </main>\n</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{\"$preview\":{\"width\":390,\"height\":844}}'>\nclass Component extends DCLogic {\nstate = { d: null, edit: false, f: {}, km: '', tax: '', svc: false };\nasync componentDidMount() { await RA.staff(); this.load(); }\nasync load() {\n  if (!this.params.id) return;\n  try { const d = await RA.call('unit_vehicle_detail', { p_unit: this.params.id }); if (RA_ALIVE(this)) this.setState({ d, km: d.unit.odometer_km != null ? String(Math.round(d.unit.odometer_km)) : '', tax: d.unit.stnk_tax_due || '' }); } catch (e) { RA.err(e); }\n}\nrenderVals() {\n  const s = this.state, d = s.d;\n  if (!d) return { loading: true, ready: false, title: 'Data kendaraan', sub: '' };\n  const u = d.unit, g = d.gps || {};\n  const dl = x => x ? Math.round((new Date(x + 'T00:00:00') - new Date(new Date().toDateString())) / 864e5) : null;\n  const dt = x => { if (!x) return '—'; const t = new Date(x + 'T00:00:00'); return t.getDate() + ' ' + RA.BULAN[t.getMonth()].slice(0, 3) + ' ' + t.getFullYear(); };\n  const ag = dl(g.active_until), on = g.last_online_at && (Date.now() - new Date(g.last_online_at)) < 864e5;\n  const set = k => e => this.setState({ f: Object.assign({}, s.f, { [k]: e.target.value }) });\n  const kmF = x => Math.abs(Math.round(x)).toLocaleString('id-ID');\n  const care = (d.rules || []).map(r => { const late = (r.km_left != null && r.km_left <= 0) || (r.days_left != null && r.days_left <= 0); const near = !late && ((r.km_left != null && r.km_left <= 300) || (r.days_left != null && r.days_left <= 14));\n    const v = r.km_left != null && (r.days_left == null || r.km_left / 30 < r.days_left) ? (r.km_left <= 0 ? 'Lewat ' + kmF(r.km_left) + ' km' : 'dalam ' + kmF(r.km_left) + ' km') : r.days_left != null ? (r.days_left <= 0 ? 'Lewat ' + (-r.days_left) + ' hari' : 'dalam ' + r.days_left + ' hari') : 'isi odometer';\n    return { l: r.label, v, c: late ? '#C0392B' : near ? '#9A5B00' : '#1F2B4D' }; })\n    .concat([{ l: 'Pajak STNK', v: dt(u.stnk_tax_due), c: dl(u.stnk_tax_due) != null && dl(u.stnk_tax_due) <= 14 ? '#C0392B' : '#1F2B4D' }, { l: 'Ganti plat (5 th)', v: dt(u.stnk_due), c: '#1F2B4D' },\n      { l: 'Odometer', v: u.odometer_km != null ? kmF(u.odometer_km) + ' km' : 'belum diisi', c: u.odometer_km != null ? '#1F2B4D' : '#B46A00' }, { l: 'Servis terakhir', v: u.last_service_at ? dt(u.last_service_at) + (u.last_service_km != null ? ' · ' + kmF(u.last_service_km) + ' km' : '') : '—', c: '#1F2B4D' }]);\n  const F = s.f;\n  return {\n    loading: false, ready: true, title: (u.product || '') + ' · ' + u.label, sub: (u.branch || '') + ' · ' + (u.code || ''),\n    gpsTag: !g.provider ? 'Belum diisi' : on ? '● Online ' + RA.time(g.last_online_at) : '● Offline', gpsChip: 'height: 28px; padding: 0 10px; border-radius: 14px; font-size: 12.5px; font-weight: 800; display: flex; align-items: center; ' + (!g.provider ? 'background: #EEF0F3; color: #4A5468' : on ? 'background: #E4F4E9; color: #1E7A3F' : 'background: #FDE8E6; color: #C0392B'),\n    gpsKv: [{ l: 'Penyedia', v: g.provider || '—', c: '#1F2B4D' }, { l: 'IMEI alat', v: g.imei4 ? (g.imei2 || '') + '••••••••' + g.imei4 : '—', c: '#1F2B4D' }, { l: 'Nomor SIM GPS', v: g.sim4 ? '0' + String(g.sim_pre || '').replace(/^62/, '').slice(0, 3) + ' •••• ' + g.sim4 : '—', c: '#1F2B4D' },\n      { l: 'Paket aktif s.d.', v: g.active_until ? dt(g.active_until) + (ag != null ? ' · ' + (ag < 0 ? 'lewat ' + (-ag) + ' hari' : ag + ' hari lagi') : '') : '—', c: ag != null && ag <= 14 ? (ag < 0 ? '#C0392B' : '#9A5B00') : '#1F2B4D' }],\n    appUrl: g.app_url && /^https?:\\/\\//.test(g.app_url) ? g.app_url : '', editGps: s.edit, startEdit: () => this.setState({ edit: true, f: { provider: g.provider || '', active_until: g.active_until || '', app_url: g.app_url || '', imei: '', sim_phone: '' } }), cancelEdit: () => this.setState({ edit: false }),\n    fields: [['provider', 'Penyedia GPS', 'text', 'mis. GPS.id'], ['imei', 'IMEI alat (kosongkan kalau tidak berubah)', 'text', '15 digit'], ['sim_phone', 'Nomor SIM GPS (kosongkan kalau tidak berubah)', 'tel', '0821 xxxx xxxx'], ['active_until', 'Paket aktif sampai', 'date', ''], ['app_url', 'Link aplikasi/web GPS', 'url', 'https://…']].map(([k, l, t, ph]) => ({ l, t, ph, v: F[k] || '', set: set(k) })),\n    saveGps: this.act(async () => { await RA.call('unit_gps_save', { p_unit: u.id, p: { gps: F } }); RA.ok('Data GPS disimpan'); this.setState({ edit: false }); await this.load(); }),\n    care, km: s.km, setKm: e => this.setState({ km: e.target.value }), tax: s.tax, setTax: e => this.setState({ tax: e.target.value }), svcCls: 'cp-rad' + (s.svc ? ' on' : ''), setSvc: () => this.setState({ svc: !s.svc }),\n    saveCare: this.act(async () => { const km = String(s.km).replace(/\\D/g, ''); await RA.call('unit_gps_save', { p_unit: u.id, p: { odometer_km: km, stnk_tax_due: s.tax || '', serviced: !!s.svc } }); RA.ok(s.svc ? 'Servis dicatat, hitungan direset' : 'Data perawatan disimpan'); this.setState({ svc: false }); await this.load(); }),\n    busy: !!s.busy\n  };\n}\n}\n</script>\n</body>\n</html>\n"}