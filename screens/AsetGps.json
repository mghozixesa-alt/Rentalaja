{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Data GPS &amp; perawatan</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0}\n.cp-card{background:#FFFFFF;border-radius:20px;box-shadow:0 2px 12px rgba(31,43,77,.06);padding:16px;display:flex;flex-direction:column;gap:12px}\n.cp-in{height:50px;box-sizing:border-box;border:2px solid #CDEFEA;border-radius:14px;padding:0 14px;font:700 16px 'Plus Jakarta Sans',sans-serif;color:#1F2B4D;background:#FFFFFF;width:100%}\n.cp-btn{height:50px;border:0;border-radius:14px;background:linear-gradient(135deg,#12B5A6,#077A70);color:#FFFFFF;font:800 15px 'Plus Jakarta Sans',sans-serif;cursor:pointer;display:flex;align-items:center;justify-content:center;text-decoration:none;width:100%}\n.cp-btn2{height:46px;border:1.5px solid #E3E7ED;border-radius:14px;background:#FFFFFF;color:#1F2B4D;font:800 14px 'Plus Jakarta Sans',sans-serif;cursor:pointer;display:flex;align-items:center;justify-content:center;text-decoration:none}\n.cp-st{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}\n.cp-st div{background:#F6F7F9;border-radius:14px;padding:10px 12px}\n.cp-st b{display:block;font-size:20px;line-height:26px}\n.cp-st span{font-size:12px;color:#4A5468}\n.cp-kv{display:flex;justify-content:space-between;gap:10px;font-size:13.5px;padding:9px 0;border-bottom:1px solid #EEF0F3}\n.cp-kv:last-child{border-bottom:0}.cp-kv span{color:#5B6577}.cp-kv b{text-align:right}\n.cp-rad{display:flex;align-items:center;gap:10px;min-height:48px;border:1.5px solid #E3E7ED;border-radius:14px;padding:0 14px;font:700 14px 'Plus Jakarta Sans',sans-serif;color:#1F2B4D;background:#FFFFFF;cursor:pointer;text-align:left;width:100%}\n.cp-rad i{width:18px;height:18px;border-radius:50%;border:2px solid #B4BCC8;flex:none;box-sizing:border-box}\n.cp-rad.on{border-color:#077A70;background:#F2FBFA}.cp-rad.on i{border:6px solid #077A70}\n.lv-map{position:relative;width:100%;aspect-ratio:16/9;border-radius:14px;overflow:hidden;background:#E8EDF3}\n.lv-map img.t{position:absolute;display:block;max-width:none}\n.lv-st{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}\n.lv-st div{background:#F6F7F9;border-radius:14px;padding:10px 12px;display:flex;flex-direction:column;gap:1px}\n.lv-st span{font-size:12px;color:#4A5468}.lv-st b{font-size:16px}.lv-st i{font-style:normal;font-size:11.5px;color:#6B7486}\n.aki{background:#F6F7F9;border-radius:14px;padding:12px;display:flex;flex-direction:column;gap:8px}\n.aki-bars{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:6px;align-items:end;height:96px}\n.aki-bars div{display:flex;flex-direction:column;align-items:center;justify-content:flex-end;gap:3px;height:100%;font-size:10.5px;color:#4A5468}\n.aki-bars i{display:block;width:100%;max-width:26px;border-radius:6px 6px 3px 3px}\n.lv-cmd{font-family:ui-monospace,Menlo,monospace;font-size:14px;background:#F4F6F9;border:1.5px dashed #A9B6C8;border-radius:12px;padding:12px;word-break:break-all}\n.lv-step{display:flex;gap:10px;align-items:flex-start}.lv-step>b{width:26px;height:26px;border-radius:13px;background:#1F2B4D;color:#FFFFFF;font-size:13px;display:flex;align-items:center;justify-content:center;flex:none}\n</style>\n</helmet>\n<div style=\"min-height: 100vh; box-sizing: border-box; background: #F4F6F9; color: #1F2B4D; font-family: 'Plus Jakarta Sans', system-ui, sans-serif\">\n <header style=\"background: linear-gradient(170deg, #0A9E92 0%, #077A70 100%); color: #FFFFFF; padding: 16px\">\n  <div style=\"max-width: 640px; margin: 0 auto; display: flex; gap: 12px; align-items: center\"><a href=\"AsetPengingat.dc.html\" aria-label=\"Kembali\" style=\"width: 38px; height: 38px; border-radius: 12px; background: rgba(255,255,255,.18); color: #FFFFFF; font-size: 22px; font-weight: 800; display: flex; align-items: center; justify-content: center; text-decoration: none\">‹</a>\n  <span><b style=\"display: block; font-size: 19px\">{{title}}</b><span style=\"font-size: 13px; opacity: .9\">{{sub}}</span></span></div>\n </header>\n <main style=\"max-width: 640px; margin: 0 auto; padding: 16px 16px 28px; display: flex; flex-direction: column; gap: 12px\">\n  <sc-if value=\"{{loading}}\"><div class=\"cp-card\" style=\"text-align: center; color: #4A5468\">Memuat…</div></sc-if>\n  <sc-if value=\"{{ready}}\">\n  <section class=\"cp-card\" style=\"gap: 10px\">\n   <div style=\"display: flex; justify-content: space-between; align-items: center\"><b style=\"font-size: 17px\">🛰️ GPS live</b><span style=\"{{lv.chip}}\">{{lv.tag}}</span></div>\n   <sc-if value=\"{{lv.alert}}\"><div style=\"background: #FDE8E6; color: #8A2318; border-radius: 12px; padding: 10px 12px; font-size: 13.5px; font-weight: 700\">⚠️ {{lv.alert}}</div></sc-if>\n   <sc-if value=\"{{lv.live}}\">\n    <div style=\"display: flex; justify-content: space-between; align-items: center; gap: 8px\"><button type=\"button\" class=\"cp-btn2\" style=\"height: 36px; padding: 0 12px\" onClick=\"{{lv.prev}}\">‹</button><b style=\"font-size: 14px\">Rute {{lv.dayL}}</b><button type=\"button\" class=\"cp-btn2\" style=\"height: 36px; padding: 0 12px\" onClick=\"{{lv.next}}\" disabled=\"{{lv.isToday}}\">›</button></div>\n    <sc-if value=\"{{lv.map}}\"><div class=\"lv-map\">\n     <sc-for list=\"{{lv.map.tiles}}\" as=\"t\"><img class=\"t\" alt=\"\" src=\"{{t.src}}\" style=\"{{t.style}}\" loading=\"lazy\"></sc-for>\n     <svg viewBox=\"0 0 640 360\" preserveAspectRatio=\"none\" style=\"position: absolute; inset: 0; width: 100%; height: 100%\"><sc-for list=\"{{lv.map.segs}}\" as=\"g\"><path d=\"{{g.d}}\" fill=\"none\" stroke=\"{{g.c}}\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" vector-effect=\"non-scaling-stroke\"></path></sc-for></svg>\n     <sc-for list=\"{{lv.map.pins}}\" as=\"p\"><span style=\"{{p.style}}\"></span><sc-if value=\"{{p.t}}\"><span style=\"{{p.tstyle}}\">{{p.t}}</span></sc-if></sc-for>\n     <span style=\"position: absolute; right: 6px; bottom: 4px; font-size: 10px; background: rgba(255,255,255,.85); padding: 1px 5px; border-radius: 4px\">© OpenStreetMap</span>\n    </div></sc-if>\n    <sc-if value=\"{{lv.map}}\" not><div style=\"aspect-ratio: 16/9; border-radius: 14px; background: #EEF1F5; display: flex; align-items: center; justify-content: center; color: #4A5468; font-size: 13.5px; font-weight: 700; text-align: center; padding: 16px; box-sizing: border-box\">{{lv.noMap}}</div></sc-if>\n    <div style=\"display: flex; flex-wrap: wrap; gap: 10px; font-size: 12px; color: #4A5468\"><span>🟢 cabang</span><span>🟠 awal</span><span>⚫ terakhir</span><span style=\"color: #2F6FB5; font-weight: 800\">━ normal</span><span style=\"color: #C98A00; font-weight: 800\">━ 50–80</span><span style=\"color: #C0392B; font-weight: 800\">━ &gt;80 km/jam</span><span>· {{lv.nPts}}</span></div>\n    <sc-if value=\"{{lv.aki}}\"><div class=\"aki\">\n     <div style=\"display: flex; justify-content: space-between; align-items: center\"><b style=\"font-size: 14px\">🔋 Kondisi aki</b><span style=\"{{lv.aki.chip}}\">{{lv.aki.tag}}</span></div>\n     <div style=\"font-size: 12.5px; line-height: 18px; color: #4A5468\">{{lv.aki.sub}}</div>\n     <sc-if value=\"{{lv.aki.days.length}}\"><div class=\"aki-bars\"><sc-for list=\"{{lv.aki.days}}\" as=\"b\"><div><span style=\"font-weight: 800; color: {{b.c}}\">{{b.v}}</span><i style=\"height: {{b.h}}; background: {{b.c}}\"></i><span>{{b.l}}</span></div></sc-for></div>\n     <div style=\"font-size: 11.5px; color: #6B7486\">Batang = tegangan saat mesin mati per hari (7 hari). Sehat ≥ 12,4 V · lemah &lt; 12 V · kritis &lt; 11,5 V.</div></sc-if>\n    </div></sc-if>\n    <div class=\"lv-st\"><sc-for list=\"{{lv.stats}}\" as=\"k\"><div><span>{{k.l}}</span><b style=\"color: {{k.c}}\">{{k.v}}</b><i>{{k.s}}</i></div></sc-for></div>\n    <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 8px\"><sc-if value=\"{{lv.gmap}}\"><a class=\"cp-btn2\" href=\"{{lv.gmap}}\" target=\"_blank\" rel=\"noopener\">Buka di Google Maps ↗</a></sc-if><a class=\"cp-btn2\" href=\"AsetPeta.dc.html\">Peta armada</a></div>\n    <sc-if value=\"{{lv.rentals.length}}\"><div><b style=\"font-size: 14px\">Km per sewa (dari GPS)</b>\n     <sc-for list=\"{{lv.rentals}}\" as=\"r\"><div class=\"cp-kv\"><span>{{r.l}}</span><b>{{r.v}}</b></div></sc-for></div></sc-if>\n    <sc-if value=\"{{lv.alerts.length}}\"><div><b style=\"font-size: 14px\">Riwayat peringatan</b>\n     <sc-for list=\"{{lv.alerts}}\" as=\"r\"><div class=\"cp-kv\"><span>{{r.l}}</span><b style=\"color: {{r.c}}\">{{r.v}}</b></div></sc-for></div></sc-if>\n   </sc-if>\n   <sc-if value=\"{{lv.wizard}}\"><div style=\"display: flex; flex-direction: column; gap: 12px; border-top: 1px solid #EEF0F3; padding-top: 10px\">\n    <b style=\"font-size: 15px\">{{lv.wTitle}}</b>\n    <sc-if value=\"{{lv.wBlock}}\"><div style=\"background: #FFF6E5; color: #7A4B00; border-radius: 12px; padding: 10px 12px; font-size: 13px; font-weight: 700\">{{lv.wBlock}}</div></sc-if>\n    <sc-if value=\"{{lv.wBlock}}\" not>\n     <div class=\"lv-step\"><b>1</b><div style=\"flex: 1; display: flex; flex-direction: column; gap: 6px\"><span style=\"font-size: 13.5px\">Dari HP teknisi, kirim SMS ini ke nomor SIM alat ({{lv.simL}}). Motor diparkir di luar ruangan, mesin hidup.</span>\n      <div class=\"lv-cmd\">{{lv.cmd}}</div>\n      <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 8px\"><sc-if value=\"{{lv.smsHref}}\"><a class=\"cp-btn\" href=\"{{lv.smsHref}}\">Buka aplikasi SMS</a></sc-if><button type=\"button\" class=\"cp-btn2\" style=\"height: 44px\" onClick=\"{{lv.copyCmd}}\">Salin perintah</button></div>\n      <span style=\"font-size: 12px; color: #6B7486\">Balasan berisi OK / alamat baru berarti alat menerima. Perintah ini untuk MiCODUS MV720/MV730 (123456 = sandi bawaan alat; kalau sandi sudah diganti, ganti angka itu). Alat merek lain (mis. Dyegoo): cek manualnya, formatnya bisa beda.</span></div></div>\n     <div class=\"lv-step\"><b>2</b><label style=\"flex: 1; display: flex; flex-direction: column; gap: 4px; font-size: 13.5px\">Km di odometer motor sekarang (untuk mencocokkan km GPS)\n      <input class=\"cp-in\" style=\"border-color: #E3E7ED; height: 44px; font-size: 15px\" type=\"text\" inputmode=\"numeric\" placeholder=\"contoh 18742\" value=\"{{lv.odo}}\" onInput=\"{{lv.setOdo}}\"></label></div>\n     <div class=\"lv-step\"><b>3</b><div style=\"flex: 1; display: flex; flex-direction: column; gap: 6px\"><span style=\"font-size: 13.5px\">Tekan tombol di bawah, lalu tunggu posisi pertama masuk (biasanya 1–10 menit). Status di atas berubah jadi Online.</span>\n      <button type=\"button\" class=\"cp-btn\" onClick=\"{{lv.connect}}\" disabled=\"{{busy}}\">Sudah kirim SMS, sambungkan</button></div></div>\n    </sc-if>\n   </div></sc-if>\n   <sc-if value=\"{{lv.waiting}}\"><div style=\"background: #EEF3FA; border-radius: 12px; padding: 10px 12px; font-size: 13px; color: #1F4E8A; font-weight: 700\">{{lv.waiting}}</div></sc-if>\n   <sc-if value=\"{{lv.isOwner}}\"><details style=\"font-size: 13px; color: #4A5468\"><summary style=\"cursor: pointer; font-weight: 800; color: #A12A1F\">🔒 Matikan / hidupkan mesin dari jarak jauh (owner)</summary>\n    <div style=\"display: flex; flex-direction: column; gap: 8px; margin-top: 8px\"><span>Hanya untuk unit dibawa kabur / tidak kembali. Perintah ditolak bila unit sedang melaju &gt; 20 km/jam. Wajib alasan, tercatat di log. Masih uji coba: pastikan dulu di 1 motor.</span>\n     <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 8px\"><button type=\"button\" class=\"cp-btn2\" style=\"color: #A12A1F; border-color: #F6C9C4\" onClick=\"{{lv.cut}}\" disabled=\"{{busy}}\">Matikan mesin</button><button type=\"button\" class=\"cp-btn2\" onClick=\"{{lv.restore}}\" disabled=\"{{busy}}\">Hidupkan lagi</button></div>\n     <sc-for list=\"{{lv.cmds}}\" as=\"r\"><div class=\"cp-kv\"><span>{{r.l}}</span><b style=\"color: {{r.c}}\">{{r.v}}</b></div></sc-for></div></details></sc-if>\n   <sc-if value=\"{{lv.canRollback}}\"><details style=\"font-size: 13px; color: #4A5468\"><summary style=\"cursor: pointer; font-weight: 800; color: #1F2B4D\">Gagal / mau kembali ke aplikasi MiCODUS?</summary>\n    <div style=\"display: flex; flex-direction: column; gap: 8px; margin-top: 8px\"><span>Kirim SMS ini ke nomor SIM alat, lalu tekan Lepas dari server baru.</span><div class=\"lv-cmd\">{{lv.rbCmd}}</div>\n     <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 8px\"><sc-if value=\"{{lv.rbHref}}\"><a class=\"cp-btn2\" href=\"{{lv.rbHref}}\">Buka aplikasi SMS</a></sc-if><button type=\"button\" class=\"cp-btn2\" onClick=\"{{lv.disconnect}}\">Lepas dari server baru</button></div></div></details></sc-if>\n  </section>\n  <section class=\"cp-card\" style=\"gap: 4px\">\n   <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px\"><b style=\"font-size: 17px\">📡 GPS</b><span style=\"{{gpsChip}}\">{{gpsTag}}</span></div>\n   <sc-if value=\"{{editGps}}\" not>\n    <sc-for list=\"{{gpsKv}}\" as=\"k\"><div class=\"cp-kv\"><span>{{k.l}}</span><b style=\"color: {{k.c}}\">{{k.v}}</b></div></sc-for>\n    <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 8px\"><sc-if value=\"{{appUrl}}\"><a class=\"cp-btn2\" href=\"{{appUrl}}\" target=\"_blank\" rel=\"noopener\">Buka aplikasi GPS ↗</a></sc-if><sc-if value=\"{{appUrl}}\" not><span class=\"cp-btn2\" style=\"color: #9AA3B2\">Link aplikasi belum diisi</span></sc-if><button type=\"button\" class=\"cp-btn2\" onClick=\"{{startEdit}}\">Ubah data</button></div>\n   </sc-if>\n   <sc-if value=\"{{editGps}}\"><div style=\"display: flex; flex-direction: column; gap: 8px\">\n    <sc-for list=\"{{fields}}\" as=\"f\"><label style=\"display: flex; flex-direction: column; gap: 4px; font-size: 12px; font-weight: 700; color: #4A5468\">{{f.l}}<input class=\"cp-in\" style=\"border-color: #E3E7ED; height: 44px; font-size: 14px\" type=\"{{f.t}}\" placeholder=\"{{f.ph}}\" value=\"{{f.v}}\" onInput=\"{{f.set}}\"></label></sc-for>\n    <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 8px\"><button type=\"button\" class=\"cp-btn2\" onClick=\"{{cancelEdit}}\">Batal</button><button type=\"button\" class=\"cp-btn\" style=\"height: 46px; font-size: 14px\" onClick=\"{{saveGps}}\" disabled=\"{{busy}}\">Simpan</button></div>\n   </div></sc-if>\n   <div style=\"font-size: 12px; color: #6B7486; margin-top: 6px\">🔒 Password akun GPS tidak disimpan di aplikasi. IMEI &amp; nomor SIM hanya tampil sebagian.</div>\n  </section>\n  <section class=\"cp-card\" style=\"gap: 4px\"><b style=\"font-size: 17px; margin-bottom: 4px\">🔧 Jadwal perawatan</b>\n   <sc-for list=\"{{care}}\" as=\"k\"><div class=\"cp-kv\"><span>{{k.l}}</span><b style=\"color: {{k.c}}\">{{k.v}}</b></div></sc-for>\n   <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 10px\">\n    <label style=\"display: flex; flex-direction: column; gap: 4px; font-size: 12px; font-weight: 700; color: #4A5468\">Odometer sekarang (km)<input class=\"cp-in\" style=\"border-color: #E3E7ED; height: 44px; font-size: 14px\" type=\"text\" inputmode=\"numeric\" value=\"{{km}}\" onInput=\"{{setKm}}\"></label>\n    <label style=\"display: flex; flex-direction: column; gap: 4px; font-size: 12px; font-weight: 700; color: #4A5468\">Pajak STNK (tahunan)<input class=\"cp-in\" style=\"border-color: #E3E7ED; height: 44px; font-size: 14px\" type=\"date\" value=\"{{tax}}\" onInput=\"{{setTax}}\"></label>\n   </div>\n   <button type=\"button\" class=\"{{svcCls}}\" style=\"margin-top: 8px\" onClick=\"{{setSvc}}\"><i></i>Baru selesai servis hari ini (reset hitungan servis &amp; oli)</button>\n   <button type=\"button\" class=\"cp-btn\" style=\"margin-top: 8px\" onClick=\"{{saveCare}}\" disabled=\"{{busy}}\">Catat servis / isi odometer</button>\n  </section>\n  </sc-if>\n </main>\n</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{\"$preview\":{\"width\":390,\"height\":844}}'>\nclass Component extends DCLogic {\nstate = { d: null, edit: false, f: {}, km: '', tax: '', svc: false, lv: null, day: null, odo: '' };\nasync componentDidMount() { await RA.staff(); this.load(); this.loadLive(); this._t = setInterval(() => { if (RA_ALIVE(this)) this.loadLive(true); else clearInterval(this._t); }, 60000); }\ncomponentWillUnmount() { clearInterval(this._t); }\nasync loadLive(quiet) {\n  if (!this.params.id) return;\n  try { const [lv, aki] = await Promise.all([RA.call('gps_unit', { p_unit: this.params.id, p_day: this.state.day || null }), RA.call('gps_unit_aki', { p_unit: this.params.id }).catch(() => null)]); if (RA_ALIVE(this)) this.setState({ lv, aki }); } catch (e) { if (!quiet) RA.err(e); }\n}\nshiftDay(n) { const b = this.state.day ? new Date(this.state.day + 'T12:00:00') : new Date(); b.setDate(b.getDate() + n); const t = new Date(); if (b > t) return;\n  const iso = b.getFullYear() + '-' + String(b.getMonth() + 1).padStart(2, '0') + '-' + String(b.getDate()).padStart(2, '0'); this.setState({ day: iso, lv: Object.assign({}, this.state.lv, { points: [] }) }); setTimeout(() => this.loadLive(), 0); }\nmapOf(pts, marks) {\n  const W = 640, H = 360, all = pts.concat(marks).filter(p => p && p[0] != null && Math.abs(p[0]) > 0.01); if (!all.length) return null;\n  const X = (g, z) => (g + 180) / 360 * 256 * Math.pow(2, z), Y = (t, z) => { const s = Math.sin(t * Math.PI / 180); return (0.5 - Math.log((1 + s) / (1 - s)) / (4 * Math.PI)) * 256 * Math.pow(2, z); };\n  let z = 17; for (; z > 4; z--) { const xs = all.map(p => X(p[1], z)), ys = all.map(p => Y(p[0], z)); if (Math.max(...xs) - Math.min(...xs) < W - 60 && Math.max(...ys) - Math.min(...ys) < H - 50) break; }\n  const xs = all.map(p => X(p[1], z)), ys = all.map(p => Y(p[0], z)), x0 = (Math.max(...xs) + Math.min(...xs)) / 2 - W / 2, y0 = (Math.max(...ys) + Math.min(...ys)) / 2 - H / 2, n = Math.pow(2, z);\n  const pc = (v, t) => (v / t * 100).toFixed(3) + '%', tiles = [];\n  for (let tx = Math.floor(x0 / 256); tx <= Math.floor((x0 + W) / 256); tx++) for (let ty = Math.floor(y0 / 256); ty <= Math.floor((y0 + H) / 256); ty++) { if (ty < 0 || ty >= n) continue;\n    tiles.push({ src: 'https://tile.openstreetmap.org/' + z + '/' + (((tx % n) + n) % n) + '/' + ty + '.png', style: 'left: ' + pc(tx * 256 - x0, W) + '; top: ' + pc(ty * 256 - y0, H) + '; width: ' + pc(256, W) + '; height: ' + pc(256, H) }); }\n  const col = v => v > 80 ? '#C0392B' : v > 50 ? '#C98A00' : '#2F6FB5', segs = [];\n  for (let i = 1; i < pts.length; i++) { const c = col(pts[i][3] || 0), a = (X(pts[i - 1][1], z) - x0).toFixed(1) + ' ' + (Y(pts[i - 1][0], z) - y0).toFixed(1), b = (X(pts[i][1], z) - x0).toFixed(1) + ' ' + (Y(pts[i][0], z) - y0).toFixed(1);\n    const last = segs[segs.length - 1]; if (last && last.c === c) last.d += ' L' + b; else segs.push({ c, d: 'M' + a + ' L' + b }); }\n  const pins = marks.filter(p => p && p[0] != null).map(p => ({ t: p[3] || '', tstyle: 'position: absolute; transform: translate(-50%, -150%); left: ' + pc(X(p[1], z) - x0, W) + '; top: ' + pc(Y(p[0], z) - y0, H) + '; background: rgba(255,255,255,.92); border-radius: 6px; padding: 1px 6px; font-size: 10.5px; font-weight: 800; white-space: nowrap; box-shadow: 0 1px 3px rgba(0,0,0,.2)', style: 'position: absolute; width: 14px; height: 14px; border-radius: 50%; border: 3px solid #FFFFFF; box-shadow: 0 1px 4px rgba(0,0,0,.35); transform: translate(-50%,-50%); background: ' + p[2] + '; left: ' + pc(X(p[1], z) - x0, W) + '; top: ' + pc(Y(p[0], z) - y0, H) }));\n  return { tiles, segs, pins };\n}\nliveVals(u) {\n  const s = this.state, L = s.lv, me = RA._staff || {};\n  if (!L) return { tag: 'Memuat…', chip: 'font-size: 12.5px; color: #4A5468' };\n  const g = L.gps || {}, S = L.state || {}, sv = L.server || {}, now = Date.now();\n  const ago = x => { if (!x) return '—'; const m = Math.round((now - new Date(x)) / 60000); return m < 1 ? 'baru saja' : m < 60 ? m + ' mnt lalu' : m < 1440 ? Math.round(m / 60) + ' jam lalu' : Math.round(m / 1440) + ' hari lalu'; };\n  const conn = !!g.connected_at, on = conn && g.online_at && now - new Date(g.online_at) < 10 * 60000, fresh = conn && g.online_at && now - new Date(g.online_at) < 30 * 60000;\n  const chipS = c => 'height: 28px; padding: 0 10px; border-radius: 14px; font-size: 12.5px; font-weight: 800; display: flex; align-items: center; ' + c;\n  const tag = !conn ? 'Belum tersambung' : on ? '● Online' : fresh ? '● ' + ago(g.online_at) : '● Sinyal hilang';\n  const chip = chipS(!conn ? 'background: #EEF0F3; color: #4A5468' : on ? 'background: #E4F4E9; color: #1E7A3F' : fresh ? 'background: #FFF0DC; color: #9A5B00' : 'background: #FDE8E6; color: #C0392B');\n  const openA = (L.alerts || []).find(a => a.open);\n  const today = (new Date()).toISOString().slice(0, 10), dayIso = s.day || null, isToday = !dayIso || dayIso === new Date(Date.now() + 7 * 36e5).toISOString().slice(0, 10);\n  const dd = dayIso ? new Date(dayIso + 'T12:00:00') : new Date(), dayL = isToday ? 'hari ini' : RA.HARIL[dd.getDay()] + ', ' + RA.date(dd);\n  const P = (L.points || []).map(p => [p[0], p[1], p[2], p[3]]); const hm = e => { const t = new Date(e * 1000); return String(t.getHours()).padStart(2, '0') + '.' + String(t.getMinutes()).padStart(2, '0'); };\n  const marks = []; if (u.blat != null) marks.push([u.blat, u.blng, '#1E9E62']); if (P.length) marks.push([P[0][0], P[0][1], '#E06A1B', P[0][2] ? 'mulai ' + hm(P[0][2]) : '']); if (isToday && g.lat != null) marks.push([g.lat, g.lng, '#1F2B4D', 'sekarang']); else if (P.length) marks.push([P[P.length - 1][0], P[P.length - 1][1], '#1F2B4D', P[P.length - 1][2] ? hm(P[P.length - 1][2]) : '']);\n  const km = x => x == null ? '—' : Math.