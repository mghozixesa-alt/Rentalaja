{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Link bayar kedaluwarsa</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0}\na{color:#1F2B4D}a:hover{color:#000}\n</style>\n</helmet>\n<div style=\"width: 390px; height: 844px; box-sizing: border-box; background: #F4F6F9; color: #1F2B4D; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; flex-direction: column; position: relative; overflow: hidden\">\n<header style=\"display: flex; align-items: center; gap: 8px; padding: 10px 12px; border-bottom: 1px solid #E6E8EC\">\n    <a href=\"Status.dc.html\" aria-label=\"Kembali\" style=\"width: 44px; height: 44px; display: flex; align-items: center; justify-content: center\">\n      <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1F2B4D\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M15 6l-6 6 6 6\"/></svg>\n    </a>\n    <div style=\"display: flex; flex-direction: column\"><div style=\"font-size: 18px; font-weight: 800\">Booking {{code}}</div></div>\n  </header>\n  <section style=\"padding: 28px 20px 0; display: flex; flex-direction: column; gap: 14px\">\n    <div style=\"width: 56px; height: 56px; border-radius: 28px; background: #E8EEF8; display: flex; align-items: center; justify-content: center\"><svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1F2B4D\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3 2\"/></svg></div>\n    <h1 style=\"margin: 0; font-size: 24px; line-height: 30px; font-weight: 800\">Waktu bayar sudah habis</h1>\n    <p style=\"margin: 0; font-size: 15px; line-height: 22px; color: #4A5468\">Kunci unit dilepas supaya bisa disewa orang lain. Dokumenmu tetap tersimpan, jadi tidak perlu verifikasi ulang.</p>\n    <div style=\"{{boxStyle}}\">\n      <div style=\"{{boxTitleStyle}}\">{{boxTitle}}</div>\n      <div style=\"font-size: 13px; line-height: 19px; color: #2D4A3A\">{{summary}}</div>\n    </div>\n    <sc-if value=\"{{error}}\"><div role=\"alert\" style=\"background: #FDECEA; border-radius: 10px; padding: 10px 12px; font-size: 13px; line-height: 19px; color: #A12A1F\">{{error}}</div></sc-if>\n    <sc-if value=\"{{canPay}}\"><button type=\"button\" onClick=\"{{rebook}}\" disabled=\"{{busy}}\" style=\"height: 52px; border-radius: 12px; border: none; background: #09BEAF; color: #1F2B4D; font: 800 16px 'Plus Jakarta Sans', sans-serif; display: flex; align-items: center; justify-content: center; cursor: pointer; width: 100%\">{{payLabel}}</button></sc-if>\n    <sc-if value=\"{{altHref}}\"><a href=\"{{altHref}}\" style=\"height: 52px; border-radius: 12px; border: none; background: #09BEAF; color: #1F2B4D; font: 800 16px 'Plus Jakarta Sans', sans-serif; display: flex; align-items: center; justify-content: center; text-decoration: none; width: 100%\">Lihat unit serupa</a></sc-if>\n    <a href=\"Katalog.dc.html\" style=\"height: 48px; border-radius: 12px; border: 1px solid #1F2B4D; background: #FFFFFF; color: #1F2B4D; font: 700 14px 'Plus Jakarta Sans', sans-serif; display: flex; align-items: center; justify-content: center; text-decoration: none; cursor: pointer; width: 100%\">Lihat unit lain</a>\n    <div style=\"font-size: 12px; line-height: 18px; color: #4A5468\">Kalau unit sudah diambil orang, tombol bayar diganti dengan pilihan unit serupa di tanggal yang sama.</div>\n  </section>\n\n</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{\"$preview\":{\"width\":390,\"height\":844}}'>\nclass Component extends DCLogic {\nstate = { b: null, quote: null, checked: false, error: '' };\nasync componentDidMount() {\n  const id = this.params.id;\n  let q = RA.from('bookings').select('*,branches(name),booking_items(product_id,quantity,qty,products(name))');\n  q = id ? q.eq('id', id) : q.eq('status', 'expired').order('created_at', { ascending: false }).limit(1);\n  const r = id ? await q.maybeSingle() : await q;\n  const b = Array.isArray(r.data) ? r.data[0] : r.data;\n  if (!RA_ALIVE(this)) return;\n  if (!b) { RA.go('Status'); return; }\n  if (b.status === 'awaiting_payment' && b.hold_expires_at && new Date(b.hold_expires_at) > new Date()) { location.replace('#/Bayar?id=' + b.id); return; }\n  if (['expired', 'awaiting_payment'].indexOf(b.status) < 0) { location.replace('#/Status?id=' + b.id); return; }\n  this.setState({ b });\n  if (new Date(b.start_at) <= new Date()) { this.setState({ checked: true }); return; }\n  const qt = await RA.rpc('quote', { p: { branch_id: b.branch_id, start_at: b.start_at, end_at: b.end_at, items: this.items(b), delivery: null } });\n  if (!RA_ALIVE(this)) return;\n  this.setState({ quote: qt.data, checked: true });\n}\nitems(b) { const out = []; (b.booking_items || []).forEach(i => { const x = out.find(c => c.product_id === i.product_id); if (x) x.quantity++; else out.push({ product_id: i.product_id, quantity: 1 }); }); return out; }\nasync rebook() {\n  const b = this.state.b;\n  const p = { branch_id: b.branch_id, start_at: b.start_at, end_at: b.end_at, items: this.items(b), guest_name: b.guest_name,\n    delivery: b.delivery_mode === 'delivery' ? { mode: 'delivery', address: b.delivery_address, landmark: b.delivery_landmark, lat: b.delivery_lat, lng: b.delivery_lng, zone_id: b.delivery_zone_id, slot: b.delivery_slot, return_pickup: b.return_mode === 'pickup', return_slot: b.return_slot || null, ret: (b.return_address || b.return_lat != null) ? { address: b.return_address, landmark: b.return_landmark, lat: b.return_lat, lng: b.return_lng, zone_id: b.return_zone_id } : null } : null };\n  let r;\n  try { r = await RA.call('create_booking', { p }); } catch (e) { this.setState({ error: RA.friendly(e.message) }); return; }\n  RA.ok('Booking baru ' + r.code + ' dibuat');\n  RA.go(r.status === 'awaiting_payment' ? 'Bayar' : 'Status', { id: r.id });\n}\nrenderVals() {\n  const s = this.state, b = s.b;\n  const names = b ? Array.from(new Set((b.booking_items || []).map(i => i.products && i.products.name).filter(Boolean))) : [];\n  let range = '';\n  if (b) { const st = new Date(b.start_at), en = new Date(b.end_at); range = st.getMonth() === en.getMonth() ? st.getDate() + '–' + RA.date(en) : RA.date(st) + '–' + RA.date(en); }\n  const q = s.quote;\n  const past = b && new Date(b.start_at) <= new Date();\n  const ok = q && !(q.unavailable || []).length && !(q.missing_price || []).length;\n  const good = 'background: #E4F2EA; border-radius: 12px; padding: 14px; display: flex; flex-direction: column; gap: 4px';\n  const warn = 'background: #FFF1D6; border-radius: 12px; padding: 14px; display: flex; flex-direction: column; gap: 4px';\n  const title = !s.checked ? 'Mengecek ketersediaan…' : past ? 'Tanggal sewanya sudah lewat' : ok ? 'Unitnya masih tersedia' : 'Unitnya sudah dipesan orang lain';\n  const first = b && (b.booking_items || [])[0];\n  return {\n    code: b ? b.code : '', summary: b ? names.join(', ') + ' · ' + range + ' · ' + ((b.branches || {}).name || '') : '',\n    boxStyle: !s.checked || ok ? good : warn, boxTitleStyle: 'font-size: 15px; font-weight: 800; color: ' + (!s.checked || ok ? '#1E6B45' : '#8A4B00'), boxTitle: title,\n    canPay: s.checked && ok && !past, rebook: this.act(this.rebook), busy: !!s.busy, payLabel: s.busy ? 'Membuat ulang booking…' : 'Bayar sekarang',\n    altHref: s.checked && !ok && !past && first ? 'StokHabis.dc.html?id=' + first.product_id : '', error: s.error\n  };\n}\n}\n</script>\n</body>\n</html>\n"}