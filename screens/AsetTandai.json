{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Tandai unit</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0}\nbutton{font-family:inherit}\nbutton:disabled{opacity:.55;cursor:not-allowed}\n[data-aui]{min-height:100vh;box-sizing:border-box;background:#F4F6F9;color:#1F2B4D;font-family:'Plus Jakarta Sans',system-ui,sans-serif}\n[data-in]{max-width:560px;margin:0 auto;box-sizing:border-box;padding:14px 16px 28px;display:flex;flex-direction:column;gap:12px}\n[data-card]{background:#FFFFFF;border-radius:16px;box-shadow:0 1px 3px rgba(31,43,77,.07);padding:14px;display:flex;flex-direction:column;gap:10px}\n[data-mut]{font-size:12px;color:#5B6577}\ninput[type=search],textarea{width:100%;box-sizing:border-box;border:1px solid #D5D9E0;border-radius:12px;padding:0 12px;font:500 15px 'Plus Jakarta Sans',sans-serif;color:#1F2B4D;background:#FFFFFF}\ninput[type=search]{height:46px}\ntextarea{height:90px;padding:10px 12px;resize:vertical}\n[data-btn]{height:46px;padding:0 14px;border-radius:12px;border:0;font:800 14px 'Plus Jakarta Sans',sans-serif;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:6px;text-decoration:none}\n[data-row]{display:flex;align-items:center;gap:10px;padding:10px 0;border-top:1px solid #EEF0F3;background:none;border-left:0;border-right:0;border-bottom:0;width:100%;text-align:left;cursor:pointer;font:inherit;color:#1F2B4D}\n[data-row]:first-child{border-top:0}\n[data-opt]{display:flex;gap:10px;align-items:flex-start;padding:12px;border-radius:12px;border:1.5px solid #E1E4EA;background:#FFFFFF;cursor:pointer;text-align:left;font:inherit;color:#1F2B4D}\n[data-opt][aria-pressed=\"true\"]{border-color:#1F2B4D;background:#F4F6F9}\n[data-ico]{width:38px;height:38px;border-radius:11px;display:flex;align-items:center;justify-content:center;flex-shrink:0}\n[data-ico] img{width:20px;height:20px}\n[data-pill]{display:inline-flex;align-items:center;height:22px;padding:0 9px;border-radius:11px;font-size:11.5px;font-weight:800;white-space:nowrap}\n</style>\n</helmet>\n<div data-aui=\"1\"><div data-in=\"1\">\n  <div><div style=\"font-size: 20px; font-weight: 800\">Tandai unit</div><div data-mut=\"1\">Laporkan kondisi unit ke tim aset. Unit rusak langsung dikunci dari booking.</div></div>\n  <sc-if value=\"{{noUnit}}\"><div data-card=\"1\">\n    <div style=\"display: flex; gap: 8px\"><input type=\"search\" aria-label=\"Cari unit\" placeholder=\"Nomor aset, plat, atau nama barang\" value=\"{{q}}\" onInput=\"{{setQ}}\"><label data-btn=\"1\" style=\"background: #1F2B4D; color: #FFFFFF; flex-shrink: 0; width: 54px; padding: 0\" aria-label=\"Scan QR\"><img src=\"{{icQr}}\" alt=\"\" style=\"width: 22px; height: 22px\"><input type=\"file\" accept=\"image/*\" capture=\"environment\" onChange=\"{{scanQr}}\" style=\"display: none\"></label></div>\n    <sc-if value=\"{{hint}}\"><span data-mut=\"1\" style=\"font-size: 13px\">{{hint}}</span></sc-if>\n    <div><sc-for list=\"{{res}}\" as=\"r\"><button type=\"button\" data-row=\"1\" onClick=\"{{r.pick}}\"><span style=\"flex: 1; min-width: 0\"><b style=\"font-size: 14px; display: block\">{{r.name}}</b><span data-mut=\"1\">{{r.sub}}</span></span><span data-pill=\"1\" style=\"background: {{r.pbg}}; color: {{r.pfg}}\">{{r.st}}</span></button></sc-for></div>\n  </div></sc-if>\n  <sc-if value=\"{{unit}}\">\n    <div data-card=\"1\" style=\"flex-direction: row; align-items: center\"><span style=\"flex: 1; min-width: 0\"><div data-mut=\"1\">Unit</div><b style=\"font-size: 16px\">{{unit.name}}</b><div data-mut=\"1\">{{unit.sub}}</div></span><button type=\"button\" onClick=\"{{reset}}\" style=\"height: 34px; padding: 0 12px; border-radius: 17px; border: 1px solid #D5D9E0; background: #FFFFFF; font: 800 12.5px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D; cursor: pointer\">Ganti</button></div>\n    <div data-card=\"1\">\n      <b style=\"font-size: 15px\">Kondisinya?</b>\n      <sc-for list=\"{{levels}}\" as=\"l\"><button type=\"button\" data-opt=\"1\" aria-pressed=\"{{l.on}}\" onClick=\"{{l.pick}}\"><span data-ico=\"1\" style=\"background: {{l.bg}}\"><img src=\"{{l.ic}}\" alt=\"\"></span><span><b style=\"font-size: 14.5px; display: block\">{{l.label}}</b><span data-mut=\"1\" style=\"font-size: 12.5px\">{{l.desc}}</span></span></button></sc-for>\n      <label style=\"display: flex; flex-direction: column; gap: 5px; font-size: 12.5px; font-weight: 700; color: #4A5468\">{{noteLabel}}<textarea placeholder=\"mis. rem depan bunyi, lensa berjamur, layar retak\" onInput=\"{{setNote}}\">{{note}}</textarea></label>\n      <label data-btn=\"1\" style=\"background: #EEF0F3; color: #1F2B4D; cursor: pointer\">{{photoTxt}}<input type=\"file\" accept=\"image/*\" capture=\"environment\" onChange=\"{{pickPhoto}}\" style=\"display: none\"></label>\n      <button type=\"button\" data-btn=\"1\" onClick=\"{{submit}}\" disabled=\"{{busy}}\" style=\"background: #1F2B4D; color: #FFFFFF\">{{btn}}</button>\n    </div>\n  </sc-if>\n  <sc-if value=\"{{done}}\"><div data-card=\"1\" style=\"background: #E3F7F5; color: #077A70; font-size: 14px; line-height: 20px\"><b>{{done}}</b></div></sc-if>\n</div></div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{\"$preview\":{\"width\":390,\"height\":844}}'>\nclass Component extends DCLogic {\nstate = { q: '', res: null, unit: null, level: 'perbaikan', note: '', file: null, busy: false, done: '' };\nP = { qr: '<rect x=\"3\" y=\"3\" width=\"7\" height=\"7\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\"/><path d=\"M14 14h3v3h-3zM18 18h3v3h-3zM14 20h2M20 14v2\"/>', alert: '<path d=\"M12 3l9.5 16.5h-19z\"/><path d=\"M12 10v4M12 17h.01\"/>', wrench: '<path d=\"M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.4-.6-.6-2.4z\"/>', eye: '<path d=\"M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12z\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/>' };\nic(n, c) { return 'data:image/svg+xml;utf8,' + encodeURIComponent('<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"' + (c || '#1F2B4D') + '\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">' + this.P[n] + '</svg>'); }\nasync componentDidMount() { await RA.staff(); const p = RA.params(); if (p.id) this.load(p.id); }\nasync load(id) { const { data } = await RA.from('units').select('id,code,asset_no,plate_or_serial,status,branches(name),products(name)').eq('id', id).maybeSingle(); if (RA_ALIVE(this) && data) this.setState({ unit: data, res: null, done: '' }); else if (RA_ALIVE(this)) RA.toast('Unit tidak ditemukan di cabang Anda'); }\nasync search(q) {\n  q = String(q || '').trim().replace(/[,()%*]/g, ' ').trim(); if (q.length < 2) { this.setState({ res: null }); return; }\n  const sel = 'id,code,asset_no,plate_or_serial,status,branches(name),products!inner(name)';\n  const { data } = await RA.from('units').select(sel).is('archived_at', null).or('asset_no.ilike.%' + q + '%,plate_or_serial.ilike.%' + q + '%,code.ilike.%' + q + '%').limit(10);\n  let rows = data || []; if (rows.length < 5) { const r2 = await RA.from('units').select(sel).is('archived_at', null).ilike('products.name', '%' + q + '%').limit(10); rows = rows.concat((r2.data || []).filter(x => !rows.some(y => y.id === x.id))); }\n  if (RA_ALIVE(this) && this.state.q.trim().replace(/[,()%*]/g, ' ').trim() === q) this.setState({ res: rows.slice(0, 10) });\n}\nasync scanQr(e) {\n  const f = e.target.files && e.target.files[0]; e.target.value = ''; if (!f) return;\n  if (!('BarcodeDetector' in window)) { RA.toast('Pemindai QR belum didukung di HP ini. Ketik nomor aset atau plat.'); return; }\n  try { const bmp = await createImageBitmap(f); const codes = await new window.BarcodeDetector({ formats: ['qr_code'] }).detect(bmp); const v = codes[0] && codes[0].rawValue; if (!v) { RA.toast('QR tidak terbaca. Coba lagi.'); return; }\n    const m = v.match(/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/i); if (m) return this.load(m[0]); this.setState({ q: v }); this.search(v); } catch (er) { RA.err(er); }\n}\nasync submit() {\n  const s = this.state, u = s.unit; if (!u) return;\n  if (s.level === 'rusak' && !String(s.note).trim()) { RA.toast('Tulis apa yang rusak'); return; }\n  this.setState({ busy: true });\n  try {\n    let ph = [];\n    if (s.file) { const ext = (String(s.file.name || '').split('.').pop() || 'jpg').toLowerCase().replace(/[^a-z0-9]/g, '').slice(0, 5) || 'jpg'; ph = [await RA.upload('operasional', 'aset/' + u.id + '/tanda-' + Date.now() + '.' + ext, s.file)]; }\n    const r = await RA.call('unit_flag', { p_unit: u.id, p_level: s.level, p_note: s.note || null, p_photos: ph });\n    this.setState({ busy: false, done: '✓ ' + ((u.products || {}).name || 'Unit') + ' ditandai \"' + r.label + '\". ' + (s.level === 'rusak' ? 'Unit dikunci dan masuk antrean servis.' : s.level === 'cek' ? 'Unit ditahan sampai lolos QC.' : 'Tim aset akan menjadwalkan perbaikan.'), unit: null, q: '', res: null, note: '', file: null, level: 'perbaikan' });\n  } catch (e) { RA.err(e); this.setState({ busy: false }); }\n}\nrenderVals() {\nconst s = this.state, u = s.unit, RED = '#A12A1F', AMB = '#8A4B00';\nconst ST = { ready: ['Siap', '#E3F7F5', '#077A70'], rented: ['Disewa', '#EEF0F3', '#1F2B4D'], booked: ['Dipesan', '#EEF0F3', '#1F2B4D'], service: ['Servis', '#FFF4E5', AMB], waiting_part: ['Tunggu part', '#FFF4E5', AMB], qc: ['QC', '#FFF4E5', AMB], inactive: ['Tidak aktif', '#EEF0F3', '#6B7486'] };\nconst nm = x => ((x.products || {}).name || 'Unit') + ' · ' + (x.asset_no || x.code);\nreturn { noUnit: !u, icQr: this.ic('qr', '#FFFFFF'), q: s.q, setQ: e => { const v = e.target.value; this.setState({ q: v, done: '' }); clearTimeout(this._t); this._t = setTimeout(() => this.search(v), 300); },\n  scanQr: e => this.scanQr(e), hint: s.res && !s.res.length ? 'Unit tidak ditemukan. Coba nomor aset atau plat.' : !s.res ? 'Ketik minimal 2 huruf, atau scan QR di stiker unit.' : '',\n  res: (s.res || []).map(x => { const t = ST[x.status] || [x.status, '#EEF0F3', '#5B6577']; return { name: nm(x), sub: [x.plate_or_serial, (x.branches || {}).name].filter(Boolean).join(' · '), st: t[0], pbg: t[1], pfg: t[2], pick: () => this.setState({ unit: x, res: null, done: '' }) }; }),\n  unit: u ? { name: nm(u), sub: [u.plate_or_serial, (u.branches || {}).name].filter(Boolean).join(' · ') } : null, reset: () => this.setState({ unit: null }),\n  levels: [['rusak', 'Rusak — tidak bisa disewa', 'Langsung dikunci dari booking dan masuk antrean servis.', 'alert', '#FDECEA', RED], ['perbaikan', 'Perlu perbaikan — masih bisa disewa', 'Kerusakan kecil. Tim aset menjadwalkan perbaikan.', 'wrench', '#FFF4E5', AMB], ['cek', 'Dicek dulu', 'Belum yakin. Unit ditahan sampai lolos QC.', 'eye', '#FFF4E5', AMB]].map(([k, l, d, i, bg, c]) => ({ label: l, desc: d, ic: this.ic(i, c), bg, on: s.level === k ? 'true' : 'false', pick: () => this.setState({ level: k }) })),\n  noteLabel: s.level === 'rusak' ? 'Apa yang rusak? (wajib)' : 'Catatan', note: s.note, setNote: e => this.setState({ note: e.target.value }),\n  photoTxt: s.file ? 'Foto: ' + s.file.name + ' (ganti)' : 'Tambah foto (disarankan)', pickPhoto: e => { const f = e.target.files && e.target.files[0]; if (f) this.setState({ file: f }); },\n  submit: () => this.submit(), busy: !!s.busy, btn: s.busy ? 'Mengirim…' : 'Kirim tanda', done: s.done };\n}\n}\n</script>\n</body>\n</html>\n"}