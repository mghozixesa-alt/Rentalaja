{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Ambil atau diantar</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0}\na{color:#1F2B4D}a:hover{color:#000}\n</style>\n</helmet>\n<div style=\"width: 390px; height: 1500px; box-sizing: border-box; background: #F4F6F9; color: #1F2B4D; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; flex-direction: column; position: relative; overflow: hidden\">\n  <header style=\"background: linear-gradient(160deg, #09BEAF 0%, #077A70 100%); padding: 10px 16px 58px; position: relative; overflow: hidden; display: flex; flex-direction: column; gap: 10px\">\n    <svg width=\"220\" height=\"220\" viewBox=\"0 0 220 220\" aria-hidden=\"true\" style=\"position: absolute; right: -70px; top: -80px; opacity: 0.18\"><circle cx=\"110\" cy=\"110\" r=\"100\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"30\"/></svg>\n    <div style=\"display: flex; align-items: center; gap: 10px; position: relative\">\n      <a href=\"{{backHref}}\" aria-label=\"Kembali\" style=\"width: 40px; height: 40px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 20px; background: rgba(255,255,255,0.22)\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"2.4\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M15 6l-6 6 6 6\"/></svg></a>\n      <div style=\"display: flex; flex-direction: column\"><b style=\"font-size: 21px; line-height: 26px; color: #FFFFFF\">Antar-jemput</b><span style=\"font-size: 12px; color: rgba(255,255,255,0.9)\">Cabang {{branchName}}</span></div>\n    </div>\n  </header>\n\n  <sc-if value=\"{{notEdit}}\"><div style=\"margin: -40px 16px 0; position: relative; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px\">\n    <sc-for list=\"{{opts}}\" as=\"o\" hint-placeholder-count=\"2\">\n      <button type=\"button\" onClick=\"{{o.pick}}\" aria-pressed=\"{{o.on}}\" style=\"{{o.style}}\">\n        <span style=\"font-size: 15px; font-weight: 800\">{{o.icon}} {{o.label}}</span>\n        <span style=\"{{o.subStyle}}\">{{o.sub}}</span>\n      </button>\n    </sc-for>\n  </div></sc-if>\n  <sc-if value=\"{{isEdit}}\"><div style=\"margin: -40px 16px 0; position: relative; background: #FFFFFF; border-radius: 18px; box-shadow: 0 6px 18px rgba(31,43,77,0.10); padding: 14px 16px; font-size: 13px; line-height: 19px; color: #3A4558\"><b style=\"font-size: 15px; color: #1F2B4D\">{{editTitle}}</b><br>{{editNote}}</div></sc-if>\n\n  <section style=\"padding: 12px 16px 0; display: flex; flex-direction: column; gap: 12px\">\n    <sc-if value=\"{{isPickup}}\" hint-placeholder-val=\"{{false}}\">\n      <div style=\"background: #FFFFFF; border-radius: 20px; box-shadow: 0 2px 12px rgba(31,43,77,0.07); overflow: hidden; display: flex; flex-direction: column\">\n        <sc-if value=\"{{branchMap}}\"><iframe src=\"{{branchMap}}\" title=\"Peta cabang\" loading=\"lazy\" style=\"width: 100%; height: 170px; border: 0; display: block\"></iframe></sc-if>\n        <div style=\"padding: 14px 16px; display: flex; flex-direction: column; gap: 6px; font-size: 13px; line-height: 19px\">\n          <b style=\"font-size: 16px\">Cabang {{branchName}}</b>\n          <span style=\"color: #5B6577\">{{branchAddress}}</span>\n          <sc-if value=\"{{hoursText}}\"><span style=\"color: #5B6577\">🕘 {{hoursText}}</span></sc-if>\n          <sc-if value=\"{{mapsHref}}\"><a href=\"{{mapsHref}}\" target=\"_blank\" rel=\"noopener\" style=\"font-weight: 800; color: #077A70\">Buka rute di Google Maps →</a></sc-if>\n        </div>\n      </div>\n    </sc-if>\n\n    <sc-if value=\"{{isDeliver}}\" hint-placeholder-val=\"{{true}}\">\n      <div style=\"background: #FFFFFF; border-radius: 20px; box-shadow: 0 2px 12px rgba(31,43,77,0.07); padding: 16px; display: flex; flex-direction: column; gap: 12px\">\n        <div style=\"display: flex; align-items: center; gap: 10px\"><span style=\"width: 34px; height: 34px; border-radius: 12px; background: #E3F7F5; display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0\">🛵</span><div style=\"display: flex; flex-direction: column\"><b style=\"font-size: 16px\">Antar ke</b><span style=\"font-size: 12px; color: #5B6577\">{{a_when}}</span></div></div>\n        <sc-if value=\"{{later}}\" not>\n        <sc-if value=\"{{a_isPick}}\">\n          <div style=\"position: relative\">\n            <input type=\"search\" placeholder=\"Cari hotel, villa, kos, atau tempel link Maps\" value=\"{{a_q}}\" onInput=\"{{a_setQ}}\" style=\"{{inp}}; padding-left: 40px\">\n            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#8A93A6\" stroke-width=\"2.2\" stroke-linecap=\"round\" aria-hidden=\"true\" style=\"position: absolute; left: 13px; top: 14px\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"M20 20l-3.5-3.5\"/></svg>\n          </div>\n          <sc-if value=\"{{a_note}}\"><span style=\"font-size: 12px; color: #5B6577\">{{a_note}}</span></sc-if>\n          <sc-if value=\"{{a_hasResults}}\"><div style=\"display: flex; flex-direction: column; border: 1px solid #E6E8EC; border-radius: 14px; overflow: hidden\">\n            <sc-for list=\"{{a_results}}\" as=\"x\"><button type=\"button\" onClick=\"{{x.pick}}\" style=\"text-align: left; border: 0; border-bottom: 1px solid #EEF0F3; background: #FFFFFF; padding: 10px 12px; cursor: pointer; display: flex; justify-content: space-between; gap: 10px; align-items: center; font-family: 'Plus Jakarta Sans', sans-serif; color: #1F2B4D\">\n              <span style=\"display: flex; flex-direction: column; min-width: 0\"><b style=\"font-size: 14px\">{{x.name}}</b><span style=\"font-size: 12px; color: #5B6577; overflow: hidden; text-overflow: ellipsis; white-space: nowrap\">{{x.sub}}</span></span>\n              <span style=\"font-size: 12px; font-weight: 700; color: {{x.kmColor}}; white-space: nowrap\">{{x.km}}</span>\n            </button></sc-for>\n          </div></sc-if>\n          <button type=\"button\" onClick=\"{{a_locate}}\" style=\"border: 0; background: none; padding: 0; text-align: left; cursor: pointer; font: 800 13px 'Plus Jakarta Sans', sans-serif; color: #077A70\">◎ {{a_locateLabel}}</button>\n          <sc-if value=\"{{a_hasSaved}}\"><div style=\"display: flex; flex-direction: column; gap: 6px\"><span style=\"font-size: 12px; font-weight: 800; color: #5B6577\">Tersimpan</span>\n            <div style=\"display: flex; gap: 8px; flex-wrap: wrap\"><sc-for list=\"{{saved}}\" as=\"v\"><button type=\"button\" onClick=\"{{v.a}}\" style=\"height: 32px; padding: 0 12px; border-radius: 16px; border: 0; background: #F2F4F7; color: #1F2B4D; cursor: pointer; font: 700 12px 'Plus Jakarta Sans', sans-serif\">📍 {{v.label}}</button></sc-for></div></div></sc-if>\n          <sc-if value=\"{{a_showPopular}}\"><div style=\"display: flex; flex-direction: column; gap: 6px\"><span style=\"font-size: 12px; font-weight: 800; color: #5B6577\">Populer</span>\n            <div style=\"display: flex; gap: 8px; flex-wrap: wrap\"><sc-for list=\"{{popular}}\" as=\"p\"><button type=\"button\" onClick=\"{{p.a}}\" style=\"height: 32px; padding: 0 12px; border-radius: 16px; border: 0; background: #F2F4F7; color: #1F2B4D; cursor: pointer; font: 700 12px 'Plus Jakarta Sans', sans-serif\">{{p.label}} <span style=\"font-weight: 600; opacity: 0.75\">· {{p.km}}</span></button></sc-for></div></div></sc-if>\n          <div style=\"display: flex; gap: 14px; flex-wrap: wrap\">\n            <button type=\"button\" onClick=\"{{a_toManual}}\" style=\"border: 0; background: none; padding: 0; text-align: left; cursor: pointer; font: 800 13px 'Plus Jakarta Sans', sans-serif; color: #077A70; color: #5B6577\">✎ Tulis alamat manual</button>\n            <sc-if value=\"{{a_canCancel}}\"><button type=\"button\" onClick=\"{{a_cancel}}\" style=\"border: 0; background: none; padding: 0; text-align: left; cursor: pointer; font: 800 13px 'Plus Jakarta Sans', sans-serif; color: #077A70; color: #5B6577\">Batal ganti</button></sc-if>\n          </div>\n        </sc-if>\n        <sc-if value=\"{{a_isSet}}\">\n          <div style=\"border: 2px solid #077A70; background: #F2FBFA; border-radius: 14px; padding: 12px; display: flex; gap: 10px; align-items: flex-start\">\n            <div style=\"display: flex; flex-direction: column; gap: 2px; min-width: 0; flex: 1\"><b style=\"font-size: 14px\">📍 {{a_title}}</b><span style=\"font-size: 12px; color: #5B6577\">{{a_sub}}</span></div>\n            <button type=\"button\" onClick=\"{{a_change}}\" style=\"border: 0; background: none; padding: 0; text-align: left; cursor: pointer; font: 800 13px 'Plus Jakarta Sans', sans-serif; color: #077A70; font-size: 12px; white-space: nowrap\">Ganti</button>\n          </div>\n        </sc-if>\n        <sc-if value=\"{{a_isManual}}\">\n          <label style=\"display: flex; flex-direction: column; gap: 5px; font-size: 12px; font-weight: 700; color: #5B6577\">Alamat lengkap\n            <input type=\"text\" autocomplete=\"street-address\" placeholder=\"Nama hotel/villa, jalan, nomor, RT/RW\" value=\"{{a_address}}\" onChange=\"{{a_setAddress}}\" style=\"{{inp}}\">\n          </label>\n          <button type=\"button\" onClick=\"{{a_change}}\" style=\"border: 0; background: none; padding: 0; text-align: left; cursor: pointer; font: 800 13px 'Plus Jakarta Sans', sans-serif; color: #077A70; color: #5B6577\">🔍 Cari di peta saja</button>\n        </sc-if>\n        <sc-if value=\"{{a_showZones}}\"><div style=\"display: flex; flex-direction: column; gap: 6px\"><span style=\"font-size: 12px; font-weight: 800; color: #5B6577\">Perkiraan jarak dari cabang</span>\n          <div style=\"display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px\"><sc-for list=\"{{a_zones}}\" as=\"z\"><button type=\"button\" onClick=\"{{z.pick}}\" style=\"{{z.style}}\"><span style=\"font-size: 11px; font-weight: 700\">{{z.km}}</span><b style=\"font-size: 14px\">{{z.fee}}</b></button></sc-for></div></div></sc-if>\n        <sc-if value=\"{{a_feeText}}\"><div style=\"display: flex; justify-content: space-between; align-items: center; gap: 10px; background: #F6F7F9; border-radius: 12px; padding: 10px 12px; font-size: 13px\"><span>{{a_feeLabel}} <span style=\"color: #5B6577\">{{a_feeZone}}</span></span><b style=\"font-size: 14px; color: #077A70; white-space: nowrap\">{{a_feeText}}</b></div></sc-if>\n        <sc-if value=\"{{a_showDetail}}\"><label style=\"display: flex; flex-direction: column; gap: 5px; font-size: 12px; font-weight: 700; color: #5B6577\">Detail untuk kurir\n          <input type=\"text\" placeholder=\"No. kamar, warna pagar, patokan\" value=\"{{a_landmark}}\" onChange=\"{{a_setLandmark}}\" style=\"{{inp}}\">\n        </label></sc-if>\n        </sc-if>\n        <sc-if value=\"{{later}}\"><div style=\"background: #F2FBFA; border: 1.5px dashed #09BEAF; border-radius: 14px; padding: 12px; font-size: 12px; line-height: 17px; color: #3A4558\"><b style=\"font-size: 14px; color: #1F2B4D\">Alamat diisi nanti</b><br>Pilih perkiraan jarak di bawah supaya ongkir terhitung. Alamat lengkap diisi di halaman Status booking paling lambat H-1, kami kirim pengingat.</div>\n          <div style=\"display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px\"><sc-for list=\"{{a_zones}}\" as=\"z\"><button type=\"button\" onClick=\"{{z.pick}}\" style=\"{{z.style}}\"><span style=\"font-size: 11px; font-weight: 700\">{{z.km}}</span><b style=\"font-size: 14px\">{{z.fee}}</b></button></sc-for></div>\n        </sc-if>\n        <sc-if value=\"{{notEdit}}\">\n          <label style=\"display: flex; flex-direction: column; gap: 5px; font-size: 12px; font-weight: 700; color: #5B6577\">Jam antar\n            <select value=\"{{slot}}\" onChange=\"{{setSlot}}\" style=\"{{inp}}\"><sc-for list=\"{{slots}}\" as=\"t\"><option value=\"{{t}}\">{{t}}</option></sc-for></select>\n          </label>\n          <sc-if value=\"{{canSaveAddr}}\"><label style=\"display: flex; gap: 8px; align-items: center; font-size: 13px; font-weight: 600\"><input type=\"checkbox\" checked=\"{{saveAddr}}\" onChange=\"{{setSaveAddr}}\" style=\"width: 17px; height: 17px; accent-color: #077A70; margin: 0\">Simpan alamat ini untuk sewa berikutnya</label></sc-if>\n          <button type=\"button\" onClick=\"{{toggleLater}}\" style=\"border: 0; background: none; padding: 0; text-align: left; cursor: pointer; font: 800 13px 'Plus Jakarta Sans', sans-serif; color: #077A70; color: #5B6577\">{{laterLabel}}</button>\n        </sc-if>\n      </div>\n\n      <sc-if value=\"{{notEdit}}\">\n      <div style=\"background: #FFFFFF; border-radius: 20px; box-shadow: 0 2px 12px rgba(31,43,77,0.07); padding: 16px; display: flex; flex-direction: column; gap: 12px\">\n        <label style=\"display: flex; align-items: center; gap: 10px; cursor: pointer\"><span style=\"width: 34px; height: 34px; border-radius: 12px; background: #E3F7F5; display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0\">🔁</span><span style=\"display: flex; flex-direction: column; flex: 1\"><b style=\"font-size: 16px\">Dijemput saat selesai</b><span style=\"font-size: 12px; color: #5B6577\">{{r_when}}</span></span><input type=\"checkbox\" role=\"switch\" checked=\"{{retOn}}\" onChange=\"{{setRet}}\" style=\"width: 22px; height: 22px; accent-color: #077A70; margin: 0; flex-shrink: 0\"></label>\n        <sc-if value=\"{{retOn}}\">\n          <div style=\"display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px\"><button type=\"button\" onClick=\"{{pickSame}}\" style=\"{{sameStyle}}\">Alamat yang sama</button><button type=\"button\" onClick=\"{{pickOther}}\" style=\"{{otherStyle}}\">Alamat lain</button></div>\n          <sc-if value=\"{{retOther}}\">\n        <sc-if value=\"{{r_isPick}}\">\n          <div style=\"position: relative\">\n            <input type=\"search\" placeholder=\"Cari hotel, villa, kos, atau tempel link Maps\" value=\"{{r_q}}\" onInput=\"{{r_setQ}}\" style=\"{{inp}}; padding-left: 40px\">\n            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#8A93A6\" stroke-width=\"2.2\" stroke-linecap=\"round\" aria-hidden=\"true\" style=\"position: absolute; left: 13px; top: 14px\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"M20 20l-3.5-3.5\"/></svg>\n          </div>\n          <sc-if value=\"{{r_note}}\"><span style=\"font-size: 12px; color: #5B6577\">{{r_note}}</span></sc-if>\n          <sc-if value=\"{{r_hasResults}}\"><div style=\"display: flex; flex-direction: column; border: 1px solid #E6E8EC; border-radius: 14px; overflow: hidden\">\n            <sc-for list=\"{{r_results}}\" as=\"x\"><button type=\"button\" onClick=\"{{x.pick}}\" style=\"text-align: left; border: 0; border-bottom: 1px solid #EEF0F3; background: #FFFFFF; padding: 10px 12px; cursor: pointer; display: flex; justify-content: space-between; gap: 10px; align-items: center; font-family: 'Plus Jakarta Sans', sans-serif; color: #1F2B4D\">\n              <span style=\"display: flex; flex-direction: column; min-width: 0\"><b style=\"font-size: 14px\">{{x.name}}</b><span style=\"font-size: 12px; color: #5B6577; overflow: hidden; text-overflow: ellipsis; white-space: nowrap\">{{x.sub}}</span></span>\n              <span style=\"font-size: 12px; font-weight: 700; color: {{x.kmColor}}; white-space: nowrap\">{{x.km}}</span>\n            </button></sc-for>\n          </div></sc-if>\n          <button type=\"button\" onClick=\"{{r_locate}}\" style=\"border: 0; background: none; padding: 0; text-align: left; cursor: pointer; font: 800 13px 'Plus Jakarta Sans', sans-serif; color: #077A70\">◎ {{r_locateLabel}}</button>\n          <sc-if value=\"{{r_hasSaved}}\"><div style=\"display: flex; flex-direction: column; gap: 6px\"><span style=\"font-size: 12px; font-weight: 800; color: #5B6577\">Tersimpan</span>\n            <div style=\"display: flex; gap: 8px; flex-wrap: wrap\"><sc-for list=\"{{saved}}\" as=\"v\"><button type=\"button\" onClick=\"{{v.r}}\" style=\"height: 32px; padding: 0 12px; border-radius: 16px; border: 0; background: #F2F4F7; color: #1F2B4D; cursor: pointer; font: 700 12px 'Plus Jakarta Sans', sans-serif\">📍 {{v.label}}</button></sc-for></div></div></sc-if>\n          <sc-if value=\"{{r_showPopular}}\"><div style=\"display: flex; flex-direction: column; gap: 6px\"><span style=\"font-size: 12px; font-weight: 800; color: #5B6577\">Populer</span>\n            <div style=\"display: flex; gap: 8px; flex-wrap: wrap\"><sc-for list=\"{{popular}}\" as=\"p\"><button type=\"button\" onClick=\"{{p.r}}\" style=\"height: 32px; padding: 0 12px; border-radius: 16px; border: 0; background: #F2F4F7; color: #1F2B4D; cursor: pointer; font: 700 12px 'Plus Jakarta Sans', sans-serif\">{{p.label}} <span style=\"font-weight: 600; opacity: 0.75\">· {{p.km}}</span></button></sc-for></div></div></sc-if>\n          <div style=\"display: flex; gap: 14px; flex-wrap: wrap\">\n            <button type=\"button\" onClick=\"{{r_toManual}}\" style=\"border: 0; background: none; padding: 0; text-align: left; cursor: pointer; font: 800 13px 'Plus Jakarta Sans', sans-serif; color: #077A70; color: #5B6577\">✎ Tulis alamat manual</button>\n            <sc-if value=\"{{r_canCancel}}\"><button type=\"button\" onClick=\"{{r_cancel}}\" style=\"border: 0; background: none; padding: 0; text-align: left; cursor: pointer; font: 800 13px 'Plus Jakarta Sans', sans-serif; color: #077A70; color: #5B6577\">Batal ganti</button></sc-if>\n          </div>\n        </sc-if>\n        <sc-if value=\"{{r_isSet}}\">\n          <div style=\"border: 2px solid #077A70; background: #F2FBFA; border-radius: 14px; padding: 12px; display: flex; gap: 10px; align-items: flex-start\">\n            <div style=\"display: flex; flex-direction: column; gap: 2px; min-width: 0; flex: 1\"><b style=\"font-size: 14px\">📍 {{r_title}}</b><span style=\"font-size: 12px; color: #5B6577\">{{r_sub}}</span></div>\n            <button type=\"button\" onClick=\"{{r_change}}\" style=\"border: 0; background: none; padding: 0; text-align: left; cursor: pointer; font: 800 13px 'Plus Jakarta Sans', sans-serif; color: #077A70; font-size: 12px; white-space: nowrap\">Ganti</button>\n          </div>\n        </sc-if>\n        <sc-if value=\"{{r_isManual}}\">\n          <label style=\"display: flex; flex-direction: column; gap: 5px; font-size: 12px; font-weight: 700; color: #5B6577\">Alamat lengkap\n            <input type=\"text\" autocomplete=\"street-address\" placeholder=\"Nama hotel/villa, jalan, nomor, RT/RW\" value=\"{{r_address}}\" onChange=\"{{r_setAddress}}\" style=\"{{inp}}\">\n          </label>\n          <button type=\"button\" onClick=\"{{r_change}}\" style=\"border: 0; background: none; padding: 0; text-align: left; cursor: pointer; font: 800 13px 'Plus Jakarta Sans', sans-serif; color: #077A70; color: #5B6577\">🔍 Cari di peta saja</button>\n        </sc-if>\n        <sc-if value=\"{{r_showZones}}\"><div style=\"display: flex; flex-direction: column; gap: 6px\"><span style=\"font-size: 12px; font-weight: 800; color: #5B6577\">Perkiraan jarak dari cabang</span>\n          <div style=\"display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px\"><sc-for list=\"{{r_zones}}\" as=\"z\"><button type=\"button\" onClick=\"{{z.pick}}\" style=\"{{z.style}}\"><span style=\"font-size: 11px; font-weight: 700\">{{z.km}}</span><b style=\"font-size: 14px\">{{z.fee}}</b></button></sc-for></div></div></sc-if>\n        <sc-if value=\"{{r_feeText}}\"><div style=\"display: flex; justify-content: space-between; align-items: center; gap: 10px; background: #F6F7F9; border-radius: 12px; padding: 10px 12px; font-size: 13px\"><span>{{r_feeLabel}} <span style=\"color: #5B6577\">{{r_feeZone}}</span></span><b style=\"font-size: 14px; color: #077A70; white-space: nowrap\">{{r_feeText}}</b></div></sc-if>\n        <sc-if value=\"{{r_showDetail}}\"><label style=\"display: flex; flex-direction: column; gap: 5px; font-size: 12px; font-weight: 700; color: #5B6577\">Detail untuk kurir\n          <input type=\"text\" placeholder=\"No. kamar, warna pagar, patokan\" value=\"{{r_landmark}}\" onChange=\"{{r_setLandmark}}\" style=\"{{inp}}\">\n        </label></sc-if>\n          </sc-if>\n          <sc-if value=\"{{retOther}}\" not><sc-if value=\"{{r_sameFee}}\"><div style=\"display: flex; justify-content: space-between; align-items: center; gap: 10px; background: #F6F7F9; border-radius: 12px; padding: 10px 12px; font-size: 13px\"><span>Ongkir jemput <span style=\"color: #5B6577\">{{r_sameZone}}</span></span><b style=\"font-size: 14px; color: #077A70; white-space: nowrap\">{{r_sameFee}}</b></div></sc-if></sc-if>\n          <label style=\"display: flex; flex-direction: column; gap: 5px; font-size: 12px; font-weight: 700; color: #5B6577\">Jam jemput\n            <select value=\"{{rslot}}\" onChange=\"{{setRslot}}\" style=\"{{inp}}\"><sc-for list=\"{{rslots}}\" as=\"t\"><option value=\"{{t}}\">{{t}}</option></sc-for></select>\n          </label>\n        </sc-if>\n        <sc-if value=\"{{retOn}}\" not><span style=\"font-size: 12px; line-height: 17px; color: #5B6577\">Barang kamu kembalikan sendiri ke cabang saat selesai.</span></sc-if>\n      </div>\n      <div style=\"background: #FFFFFF; border-radius: 20px; box-shadow: 0 2px 12px rgba(31,43,77,0.07); padding: 14px 16px; font-size: 12px; line-height: 17px; color: #5B6577\">🪪 Kurir mengecek KTP asli dan memotret kondisi barang bersamamu saat serah-terima. Pelanggan VIP gratis ongkir.</div>\n      </sc-if>\n    </sc-if>\n    <sc-if value=\"{{error}}\"><div role=\"alert\" style=\"background: #FDECEA; border-radius: 12px; padding: 10px 