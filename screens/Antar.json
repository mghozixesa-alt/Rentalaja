 RA.ctx();\n  const fees = s.zones.filter(z => z.fee != null).map(z => +z.fee);\n  const canDeliver = !!br.delivery_enabled;\n  const opts = [{ id: 'ambil', icon: '🏬', label: 'Ambil sendiri', sub: 'Gratis' }, { id: 'antar', icon: '🛵', label: 'Diantar', sub: canDeliver ? (fees.length ? 'mulai ' + this.rpS(Math.min.apply(null, fees)) : 'Ongkir sesuai jarak') : 'Belum tersedia di cabang ini' }]\n    .map(o => ({ ...o, on: s.mode === o.id ? 'true' : 'false', pick: () => { if (o.id === 'antar' && !canDeliver) { RA.toast('Cabang ini belum melayani antar.'); return; } this.setState({ mode: o.id, error: '' }); }, subStyle: 'font-size: 12px; font-weight: 700; color: ' + (s.mode === o.id ? '#077A70' : '#5B6577'), style: 'min-height: 78px; border-radius: 18px; cursor: pointer; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; padding: 10px; font-family: \"Plus Jakarta Sans\", sans-serif; color: #1F2B4D; box-shadow: 0 6px 18px rgba(31,43,77,0.10); ' + (s.mode === o.id ? 'border: 2px solid #09BEAF; background: #FFFFFF;' : 'border: 2px solid transparent; background: #FFFFFF; opacity: 0.85;') }));\n  const hh = t => t ? String(t).slice(0, 5).replace(':', '.') : '';\n  const a = this.leg('a'), r = this.leg('r');\n  const za = s.zones.find(x => x.id === a.zone_id), zr = s.retSame ? za : s.zones.find(x => x.id === r.zone_id);\n  const fa = za && za.fee != null ? +za.fee : null, fr = s.retOn ? (zr && zr.fee != null ? +zr.fee : null) : 0;\n  const deliverOn = s.mode === 'antar';\n  const slots = this.slots(), rslots = this.rslots();\n  const segOn = 'height: 44px; border-radius: 12px; cursor: pointer; font: 700 13px \"Plus Jakarta Sans\", sans-serif; border: 2px solid #077A70; background: #F2FBFA; color: #077A70;';\n  const segOff = 'height: 44px; border-radius: 12px; cursor: pointer; font: 700 13px \"Plus Jakarta Sans\", sans-serif; border: 1.5px solid #E1E5EA; background: #FFFFFF; color: #1F2B4D;';\n  const fullDay = x => { const d = new Date(x); return isNaN(d) ? '' : RA.day(d) + ', ' + RA.date(d); };\n  let totalFee, totalSub = '';\n  if (!deliverOn) totalFee = 'Gratis';\n  else if (!s.zones.length) totalFee = 'Dikonfirmasi cabang';\n  else if (fa == null || (s.retOn && fr == null)) totalFee = fa == null ? 'Pilih alamat' : RA.rp(fa) + ' + jemput';\n  else { totalFee = RA.rp(fa + fr); if (s.retOn) totalSub = this.rpS(fa) + ' antar + ' + this.rpS(fr) + ' jemput'; }\n  return Object.assign({\n    backHref: ((this.params || {}).back || 'Checkout') + '.dc.html' + ((this.params || {}).id ? '?id=' + this.params.id : ''),\n    saved: s.saved.map(x => ({ label: x.label || String(x.address).slice(0, 22) + (String(x.address).length > 22 ? '…' : ''), a: () => this.pickSaved('a', x), r: () => this.pickSaved('r', x) })),\n    popular: s.places.slice(0, 10).map(p => ({ label: p.name, km: p.km == null ? '' : String(p.km).replace('.', ',') + ' km', a: () => this.pickPoint('a', p), r: () => this.pickPoint('r', p) })),\n    saveAddr: s.saveAddr, setSaveAddr: e => this.setState({ saveAddr: e.target.checked }), canSaveAddr: this.canSave(),\n    inp: 'height: 46px; box-sizing: border-box; border: 1px solid #D5D9E0; border-radius: 12px; padding: 0 12px; font: 600 15px \"Plus Jakarta Sans\", sans-serif; color: #1F2B4D; background: #FFFFFF; width: 100%',\n    branchMap: br.lat != null ? 'https://maps.google.com/maps?q=' + br.lat + ',' + br.lng + '&z=16&output=embed' : '',\n    opts, isPickup: s.mode === 'ambil', isDeliver: deliverOn,\n    branchName: br.name || '', branchAddress: br.address || 'Alamat cabang belum diisi',\n    hoursText: br.open_time && br.close_time ? 'Buka setiap hari ' + hh(br.open_time) + '–' + hh(br.close_time) : '',\n    mapsHref: br.maps_url || (br.lat != null && br.lng != null ? 'https://www.google.com/maps?q=' + br.lat + ',' + br.lng : ''),\n    a_when: s.edit && s.bk ? 'Diantar ' + RA.dayTime(s.bk.start_at) : c.start_at ? fullDay(c.start_at) + ' · sewa mulai ' + RA.time(c.start_at) : '',\n    r_when: c.end_at ? fullDay(c.end_at) + ' · sewa selesai ' + RA.time(c.end_at) : '',\n    later: !!s.later, toggleLater: () => { this.setState({ later: !s.later, error: '' }); if (s.later) this.setLeg('a', { st: a.lat != null ? 'set' : String(a.address).trim() ? 'manual' : 'pick' }); },\n    laterLabel: s.later ? '← Isi alamat sekarang saja' : 'Belum tahu alamatnya? Isi nanti (paling lambat H-1) →',\n    slots, slot: slots.indexOf(s.slot) > -1 ? s.slot : slots[slots.length - 1], setSlot: e => this.setState({ slot: e.target.value }),\n    rslots, rslot: rslots.indexOf(s.rslot) > -1 ? s.rslot : rslots[0], setRslot: e => this.setState({ rslot: e.target.value }),\n    retOn: s.retOn, setRet: e => this.setState({ retOn: e.target.checked, error: '' }),\n    retOther: s.retOn && !s.retSame, pickSame: () => this.setState({ retSame: true, error: '' }), pickOther: () => this.setState({ retSame: false, error: '' }),\n    sameStyle: s.retSame ? segOn : segOff, otherStyle: s.retSame ? segOff : segOn,\n    r_sameFee: za ? (za.fee != null ? RA.rp(za.fee) : 'dikonfirmasi cabang') : '', r_sameZone: za ? '(≤ ' + String(za.max_km).replace('.', ',') + ' km)' : '',\n    totalLabel: s.edit ? 'Ongkir antar (sudah termasuk di booking)' : !deliverOn ? 'Ambil sendiri di cabang' : s.retOn ? 'Ongkir antar + jemput' : 'Ongkir antar saja',\n    totalFee: s.edit ? (za && za.fee != null ? RA.rp(za.fee) : '—') : totalFee, totalSub: s.edit ? '' : totalSub,\n    error: s.error, save: () => this.save(), saving: s.saving, saveLabel: s.edit ? (s.saving ? 'Menyimpan…' : 'Simpan alamat') : 'Simpan & lanjut',\n    notEdit: !s.edit, isEdit: s.edit, editTitle: s.bk && String(s.bk.delivery_address || '').trim() ? 'Ubah alamat antar ' + s.bk.code : 'Lengkapi alamat antar ' + (s.bk ? s.bk.code : ''),\n    editNote: s.bk ? 'Diantar ' + RA.dayTime(s.bk.start_at) + '. Titik harus masih di dalam zona ongkir yang sudah dipilih' + (s.zones[0] ? ' (≤ ' + s.zones[0].max_km + ' km dari cabang)' : '') + '.' : ''\n  }, this.legVals('a'), this.legVals('r'));\n}\n}\n\n</script>\n</body>\n</html>\n"}