async saveEdit() {\n  const s = this.state, b = s.bk, a = this.leg('a'); if (!b || s.saving) return;\n  if (String(a.address).trim().length < 6) { this.setState({ error: 'Pilih atau tulis alamat lengkap (jalan, nomor, nama hotel/villa).' }); return; }\n  this.setState({ saving: true, error: '' });\n  try {\n    await RA.fn('antar', { action: 'set_address', booking_id: b.id, address: String(a.address).trim(), landmark: String(a.landmark || '').trim(), lat: a.lat, lng: a.lng });\n    RA.ok('Alamat antar tersimpan');\n    RA.go('Status', { id: b.id });\n  } catch (e) { if (RA_ALIVE(this)) this.setState({ saving: false, error: RA.friendly(e.message) }); }\n}\nrpS(v) { return +v >= 1000 ? 'Rp' + Math.round(+v / 1000) + 'rb' : RA.rp(v); }\nlegVals(k) {\n  const s = this.state, l = this.leg(k), P = k + '_';\n  const fmtK = x => x == null ? '' : String(Math.round(x * 10) / 10).replace('.', ',') + ' km';\n  const maxKm = s.zones.length ? Math.max.apply(null, s.zones.map(x => +x.max_km || 0)) : null;\n  const z = s.zones.find(x => x.id === l.zone_id);\n  const autoKm = l.st === 'set' && l.dist != null && s.branch && s.branch.lat != null;\n  const showZones = !s.edit && s.zones.length > 0 && ((l.st === 'manual') || (l.st === 'set' && !autoKm) || (k === 'a' && s.later));\n  const parts = String(l.address || '').split(', ');\n  const title = l.name || parts[0] || 'Titik di peta';\n  const sub = (l.name && parts[0] === l.name ? parts.slice(1).join(', ') : l.name ? l.address : parts.slice(1).join(', ')) || '';\n  const o = {};\n  o[P + 'isPick'] = l.st === 'pick'; o[P + 'isSet'] = l.st === 'set'; o[P + 'isManual'] = l.st === 'manual';\n  o[P + 'q'] = l.q; o[P + 'setQ'] = e => this.setQ(k, e.target.value);\n  o[P + 'note'] = l.searching ? 'Mencari…' : l.note;\n  o[P + 'hasResults'] = l.results.length > 0;\n  o[P + 'results'] = l.results.map(r => ({ name: r.name, sub: r.area || r.address || '', km: r.km != null ? fmtK(r.km) : '', kmColor: maxKm != null && r.km != null && r.km > maxK