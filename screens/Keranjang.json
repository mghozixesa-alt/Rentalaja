{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Keranjang dan bundling</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0}\na{color:#1F2B4D}a:hover{color:#000}\n</style>\n</helmet>\n<div style=\"width: 390px; height: 1700px; box-sizing: border-box; background: #F4F6F9; color: #1F2B4D; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; flex-direction: column; position: relative; overflow: hidden\">\n\n  <header style=\"background: #FFFFFF; border-bottom: 1px solid #E6E8EC; padding: 10px 12px; display: flex; align-items: center; gap: 8px\">\n    <a href=\"{{backHref}}\" aria-label=\"Kembali\" style=\"width: 44px; height: 44px; display: flex; align-items: center; justify-content: center\">\n      <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1F2B4D\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M15 6l-6 6 6 6\"/></svg>\n    </a>\n    <div style=\"display: flex; flex-direction: column\">\n      <div style=\"font-size: 18px; font-weight: 800\">Keranjang</div>\n      <div style=\"font-size: 12px; color: #4A5468\">{{ctxText}}</div>\n    </div>\n  </header>\n\n  <sc-if value=\"{{showNudge}}\"><section style=\"margin: 14px 16px 0; background: #FFFFFF; color: #1F2B4D; border: 1px solid #09BEAF; border-radius: 16px; padding: 14px 16px; display: flex; flex-direction: column; gap: 10px\">\n    <div style=\"font-size: 15px; font-weight: 700\">{{nudge}}</div>\n    <div style=\"height: 8px; border-radius: 4px; background: #E6E8EC; overflow: hidden\"><div style=\"{{barStyle}}\"></div></div>\n    <div style=\"display: flex; justify-content: space-between; font-size: 12px; color: #4A5468\"><sc-for list=\"{{tierLabels}}\" as=\"t\"><span>{{t}}</span></sc-for></div>\n  </section></sc-if>\n\n  <sc-if value=\"{{empty}}\"><section style=\"margin: 14px 16px 0; border: 1px dashed #C5CBD4; border-radius: 16px; padding: 18px 16px; display: flex; flex-direction: column; gap: 10px; align-items: flex-start\">\n    <div style=\"font-size: 16px; font-weight: 800\">{{empty}}</div>\n    <div style=\"font-size: 14px; line-height: 20px; color: #4A5468\">Pilih barang dari katalog, lalu masukkan ke keranjang.</div>\n    <a href=\"Cari.dc.html\" style=\"height: 44px; padding: 0 16px; border-radius: 12px; background: #09BEAF; color: #1F2B4D; font-size: 14px; font-weight: 800; display: flex; align-items: center; text-decoration: none\">Lihat katalog</a>\n  </section></sc-if>\n\n  <sc-for list=\"{{warnings}}\" as=\"w\"><div style=\"margin: 12px 16px 0; background: #FFF1D6; border-radius: 12px; padding: 10px 12px; font-size: 13px; line-height: 19px; color: #5C3A00\">{{w}}</div></sc-for>\n\n  <sc-if value=\"{{hasCart}}\"><section style=\"margin: 12px 16px 0; background: #FFFFFF; border: 0; border-radius: 20px; box-shadow: 0 2px 12px rgba(31,43,77,0.07); padding: 6px 14px; display: flex; flex-direction: column\">\n    <sc-for list=\"{{cart}}\" as=\"c\" hint-placeholder-count=\"2\">\n      <div style=\"display: flex; gap: 12px; align-items: center; padding: 10px 0; border-bottom: 1px solid #EEF0F3\">\n        <div style=\"width: 52px; height: 52px; border-radius: 10px; background: #F1F3F5; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 9px; font-weight: 600; color: #6B7385; overflow: hidden; text-align: center\"><sc-if value=\"{{c.photo}}\"><img src=\"{{c.photo}}\" alt=\"\" style=\"width: 100%; height: 100%; object-fit: cover; display: block\"></sc-if><sc-if value=\"{{c.photo}}\" not>Foto</sc-if></div>\n        <div style=\"flex-grow: 1; display: flex; flex-direction: column; gap: 2px; min-width: 0\">\n          <div style=\"font-size: 14px; font-weight: 700\">{{c.name}}</div>\n          <div style=\"font-size: 12px; color: #4A5468\">{{c.line}}</div>\n          <sc-if value=\"{{c.warn}}\"><div style=\"font-size: 12px; font-weight: 700; color: #A12A1F\">{{c.warn}}</div></sc-if>\n          <sc-if value=\"{{c.canQty}}\"><div style=\"display: flex; align-items: center; gap: 8px; margin-top: 4px\">\n            <button type=\"button\" onClick=\"{{c.dec}}\" aria-label=\"Kurangi\" style=\"width: 28px; height: 28px; border-radius: 14px; border: 1px solid #D5D9E0; background: #FFFFFF; color: #1F2B4D; font: 800 15px 'Plus Jakarta Sans', sans-serif; cursor: pointer; padding: 0\">−</button>\n            <span style=\"font-size: 13px; font-weight: 800; min-width: 16px; text-align: center\">{{c.qty}}</span>\n            <button type=\"button\" onClick=\"{{c.inc}}\" aria-label=\"Tambah\" style=\"width: 28px; height: 28px; border-radius: 14px; border: 1px solid #D5D9E0; background: #FFFFFF; color: #1F2B4D; font: 800 15px 'Plus Jakarta Sans', sans-serif; cursor: pointer; padding: 0\">+</button>\n          </div></sc-if>\n        </div>\n        <div style=\"font-size: 14px; font-weight: 800; white-space: nowrap\">{{c.total}}</div>\n        <sc-if value=\"{{c.removable}}\" hint-placeholder-val=\"{{false}}\">\n          <button type=\"button\" onClick=\"{{c.remove}}\" aria-label=\"Hapus\" style=\"width: 36px; height: 36px; border-radius: 18px; border: 0; background: #FFFFFF; display: flex; align-items: center; justify-content: center; cursor: pointer\">\n            <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4A5468\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg>\n          </button>\n        </sc-if>\n      </div>\n    </sc-for>\n  </section></sc-if>\n\n  <sc-if value=\"{{canDeliver}}\"><section style=\"margin: 12px 16px 0; background: #FFFFFF; border-radius: 20px; box-shadow: 0 2px 12px rgba(31,43,77,0.07); padding: 14px; display: flex; flex-direction: column; gap: 10px\">\n    <b style=\"font-size: 15px\">Cara terima barang</b>\n    <div style=\"display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px\">\n      <button type=\"button\" onClick=\"{{rcvPickup}}\" style=\"{{rcvPickStyle}}\"><span style=\"font-size: 20px\">🏬</span><b style=\"font-size: 14px\">Ambil sendiri</b><span style=\"font-size: 11px; font-weight: 700; color: #5B6577\">Gratis</span></button>\n      <a href=\"{{antarHref}}\" style=\"{{rcvDelStyle}}\"><span style=\"font-size: 20px\">🛵</span><b style=\"font-size: 14px\">Antar-jemput</b><span style=\"font-size: 11px; font-weight: 700; color: #077A70\">{{rcvDelSub}}</span></a>\n    </div>\n    <sc-if value=\"{{rcvAddr}}\"><a href=\"{{antarHref}}\" style=\"display: flex; gap: 8px; align-items: center; background: #F2FBFA; border-radius: 12px; padding: 10px 12px; text-decoration: none; color: #1F2B4D; font-size: 12px; line-height: 17px\"><span>📍</span><span style=\"flex: 1; min-width: 0\">{{rcvAddr}}</span><b style=\"color: #077A70\">Ubah</b></a></sc-if>\n  </section></sc-if>\n\n  <sc-if value=\"{{hasPacks}}\"><section style=\"margin: 22px 0 0 16px; display: flex; flex-direction: column; gap: 12px\">\n    <div style=\"display: flex; flex-direction: column; gap: 2px; padding-right: 16px\">\n      <h2 style=\"margin: 0; font-size: 18px; font-weight: 800\">Paket hemat 🔥</h2>\n      <span style=\"font-size: 13px; color: #4A5468\">Lebih murah daripada sewa satuan. Sekali tap, langsung masuk keranjang.</span>\n    </div>\n    <div style=\"display: flex; gap: 12px; overflow-x: auto; padding: 2px 16px 6px 0; scroll-snap-type: x mandatory\">\n    <sc-for list=\"{{packs}}\" as=\"p\" hint-placeholder-count=\"2\">\n      <div style=\"flex: 0 0 272px; scroll-snap-align: start; background: #FFFFFF; border-radius: 20px; overflow: hidden; box-shadow: 0 6px 18px rgba(31,43,77,0.10); display: flex; flex-direction: column\">\n        <div style=\"height: 128px; background: linear-gradient(135deg, #1F2B4D 0%, #2E4A7A 60%, #077A70 100%); position: relative; display: flex; align-items: center; justify-content: center; gap: 0\">\n          <span style=\"position: absolute; left: 10px; top: 12px; background: #FFFFFF; color: #0E8A4F; font-size: 11.5px; font-weight: 800; padding: 4px 9px; border-radius: 8px; border: 1.5px dashed #6FCF97\">🏷️ {{p.ribbon}}</span>\n          <span style=\"position: absolute; right: 12px; top: 12px; width: 46px; height: 46px; border-radius: 23px; background: #E6F7EE; color: #0E8A4F; border: 1.5px dashed #6FCF97; box-sizing: border-box; font-size: 14px; font-weight: 800; display: flex; align-items: center; justify-content: center; transform: rotate(-10deg)\">{{p.pct}}</span>\n          <sc-for list=\"{{p.pics}}\" as=\"ph\"><img src=\"{{ph}}\" alt=\"\" style=\"width: 76px; height: 76px; margin: 22px -8px 0; border-radius: 18px; background: #FFFFFF; object-fit: contain; padding: 6px; box-sizing: border-box; box-shadow: 0 6px 14px rgba(0,0,0,0.25); display: block\"></sc-for>\n        </div>\n        <div style=\"padding: 12px 14px 14px; display: flex; flex-direction: column; gap: 6px; flex: 1\">\n          <b style=\"font-size: 15px\">{{p.name}}</b>\n          <span style=\"font-size: 12px; line-height: 17px; color: #4A5468; min-height: 34px\">{{p.desc}}</span>\n          <sc-if value=\"{{p.newPrice}}\"><div style=\"display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap\">\n            <span style=\"font-size: 13px; color: #9AA2B1; text-decoration: line-through\">{{p.oldPrice}}</span>\n            <span style=\"font-size: 20px; font-weight: 800; color: #1F2B4D\">{{p.newPrice}}</span>\n            <span style=\"font-size: 12px; color: #4A5468\">{{p.forDays}}</span>\n          </div></sc-if>\n          <button type=\"button\" onClick=\"{{p.add}}\" style=\"{{p.btnStyle}}\">{{p.btn}}</button>\n        </div>\n      </div>\n    </sc-for>\n    </div>\n  </section></sc-if>\n\n  <sc-if value=\"{{hasRecs}}\"><section style=\"margin: 18px 16px 0; padding: 14px 0 14px 14px; border-radius: 22px; background: linear-gradient(160deg,#E8F8F6 0%,#F5FBFA 60%,#FFFFFF 100%); border: 1px solid #D4EFEB; display: flex; flex-direction: column; gap: 12px\">\n    <div style=\"display: flex; flex-direction: column; gap: 2px; padding-right: 16px\"><h2 style=\"margin: 0; font-size: 17px; font-weight: 800; color: #1F2B4D\">{{recTitle}}</h2><span style=\"font-size: 12.5px; color: #4A5468\">Tambah sekalian, satu kali ambil & kembali</span></div>\n    <div style=\"display: flex; gap: 10px; overflow-x: auto; padding: 2px 14px 4px 0; scroll-snap-type: x mandatory\">\n      <sc-for list=\"{{recs}}\" as=\"r\" hint-placeholder-count=\"4\"><div style=\"width: 158px; flex-shrink: 0; scroll-snap-align: start; background: #FFFFFF; border-radius: 18px; box-shadow: 0 4px 16px rgba(31,43,77,0.09); overflow: hidden; display: flex; flex-direction: column\">\n          <div style=\"position: relative; height: 112px; background: linear-gradient(160deg,#F3F6F9,#E9EEF3); display: flex; align-items: center; justify-content: center; font-size: 10px; font-weight: 600; color: #6B7385; overflow: hidden\"><sc-if value=\"{{r.photo}}\"><img src=\"{{r.photo}}\" alt=\"\" loading=\"lazy\" style=\"width: 100%; height: 100%; object-fit: cover; display: block\"></sc-if><sc-if value=\"{{r.photo}}\" not>Foto belum diunggah</sc-if>\n            <sc-if value=\"{{r.badge}}\"><span style=\"position: absolute; left: 8px; top: 8px; height: 22px; padding: 0 8px; border-radius: 11px; background: rgba(31,43,77,0.86); color: #FFFFFF; font-size: 10.5px; font-weight: 800; display: inline-flex; align-items: center; gap: 3px; backdrop-filter: blur(4px)\">{{r.badge}}</span></sc-if></div>\n          <div style=\"padding: 10px 10px 12px; display: flex; flex-direction: column; gap: 4px; flex-grow: 1\">\n            <div style=\"font-size: 13.5px; font-weight: 800; line-height: 17px; color: #1F2B4D; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 34px\">{{r.name}}</div>\n            <div style=\"font-size: 12px; color: #4A5468\"><b style=\"font-size: 14px; color: #077A70\">{{r.priceBig}}</b>{{r.priceUnit}}</div>\n            <button type=\"button\" onClick=\"{{r.toggle}}\" style=\"{{r.btnStyle}}\">{{r.btn}}</button>\n          </div>\n        </div></sc-for>\n    </div>\n  </section></sc-if>\n\n  <sc-if value=\"{{hasCart}}\"><div style=\"position: absolute; left: 0; right: 0; bottom: 0; background: #FFFFFF; border-top: 1px solid #E6E8EC; padding: 12px 16px 16px; display: flex; flex-direction: column; gap: 8px\">\n    <div style=\"display: flex; justify-content: space-between; font-size: 13px; color: #4A5468\"><span>Subtotal {{count}} item · {{durLabel}}</span><span>{{subtotal}}</span></div>\n    <sc-for list=\"{{discLines}}\" as=\"d\">\n      <div style=\"display: flex; justify-content: space-between; font-size: 13px; font-weight: 700; color: #0E8A4F\"><span>🏷️ {{d.label}}</span><span>−{{d.amount}}</span></div>\n    </sc-for>\n    <sc-if value=\"{{deliveryLine}}\"><div style=\"display: flex; justify-content: space-between; font-size: 13px; color: #4A5468\"><span>Ongkir antar</span><span>{{deliveryLine}}</span></div></sc-if>\n    <div style=\"display: flex; align-items: center; justify-content: space-between; gap: 12px\">\n      <div style=\"display: flex; flex-direction: column\">\n        <span style=\"font-size: 12px; color: #4A5468\">Total sewa</span>\n        <span style=\"font-size: 20px; font-weight: 800\">{{total}}</span>\n      </div>\n      <button type=\"button\" onClick=\"{{next}}\" disabled=\"{{cantNext}}\" style=\"{{nextStyle}}\">Lanjut verifikasi</button>\n    </div>\n  </div></sc-if>\n</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{\"bundle2\":{\"editor\":\"int\",\"default\":5,\"min\":0,\"max\":50,\"unit\":\"%\",\"section\":\"Diskon bundling\"},\"bundle3\":{\"editor\":\"int\",\"default\":10,\"min\":0,\"max\":50,\"unit\":\"%\",\"section\":\"Diskon bundling\"},\"$preview\":{\"width\":390,\"height\":1700}}'>\nclass Component extends DCLogic {\nstate = { quote: null, prods: {}, branch: null, tiers: null, packs: [], recs: [], loaded: false };\nasync componentDidMount() {\n  const branch = await RA.branch();\n  const ap = await RA.from('auto_promos').select('key,rule,lines,category_ids,exclude_category_ids,starts_at,ends_at').in('key', ['bundle_tiers', 'buy_x_free_y']);\n  const now = new Date();\n  const act = (ap.data || []).filter(x => (!x.starts_at || new Date(x.starts_at) <= now) && (!x.ends_at || new Date(x.ends_at) >= now));\n  if (!RA_ALIVE(this)) return;\n  this.setState({ branch, tiers: act.find(x => x.key === 'bundle_tiers') || null, free: act.find(x => x.key === 'buy_x_free_y' && (!((x.rule || {}).branch_ids || []).length || x.rule.branch_ids.indexOf(branch && branch.id) > -1)) || null });\n  await this.refresh();\n}\nasync refresh() {\n  const c = RA.ctx();\n  if (!c.cart.length) { this.setState({ quote: null, loaded: true, recs: [], packs: [] }); return; }\n  const ids = c.cart.map(x => x.product_id);\n  const [q, pr, rel, bun] = await Promise.all([\n    RA.quote(),\n    RA.from('products').select('id,name,photos,category_id,categories(slug,name,kind,price_unit)').in('id', ids),\n    RA.from('product_relations').select('product_id,related_id,pct').in('product_id', ids),\n    RA.from('bundles').select('id,name,description,discount_percent,branch_id,bundle_items(product_id,qty)').eq('is_active', true)\n  ]);\n  if (!RA_ALIVE(this)) return;\n  if (q.error) RA.err(q.error.message);\n  const prods = Object.assign({}, this.state.prods); (pr.data || []).forEach(p => { prods[p.id] = p; });\n  const relIds = Array.from(new Set((rel.data || []).map(r => r.related_id)));\n  const br = this.state.branch;\n  const packs = (bun.data || []).filter(x => !x.branch_id || (br && x.branch_id === br.id)).filter(x => (x.bundle_items || []).length);\n  const needIds = Array.from(new Set(relIds.concat([].concat.apply([], packs.map(p => p.bundle_items.map(i => i.product_id)))))).filter(id => !prods[id]);\n  if (needIds.length) {\n    const { data } = await RA.from('products').select('id,name,photos,category_id,categories(slug,name,kind,price_unit),product_prices(basis,price,branch_id)').in('id', needIds);\n    (data || []).forEach(p => { prods[p.id] = p; });\n  }\n  if (!RA_ALIVE(this)) return;\n  const relPct = {}; (rel.data || []).forEach(r => { relPct[r.related_id] = Math.max(relPct[r.related_id] || 0, r.pct || 0); });\n  this.setState({ quote: q.data, prods, recs: relIds.slice().sort((a, b) => (relPct[b] || 0) - (relPct[a] || 0)), relPct, packs, loaded: true });\n}\nsetCart(cart) { RA.setCtx({ cart }); this.refresh(); this.forceUpdate(); }\nrenderVals() {\n  const s = this.state, c = RA.ctx(), br = s.branch || {}, q = s.quote, cart = c.cart;\n  const days = RA.days(c.start_at, c.end_at);\n  const st = new Date(c.start_at), en = new Date(c.end_at);\n  const range = st.getMonth() === en.getMonth() ? st.getDate() + '–' + RA.date(en) : RA.date(st) + '–' + RA.date(en);\n  const qi = {}; (q && q.items || []).forEach(x => { qi[x.product_id] = x; });\n  const missing = q ? q.missing_price || [] : [], unav = q ? q.unavailable || [] : [];\n  const UNIT = { hari: 'hari', malam: 'malam', trip: 'trip', paket: 'paket', jam: 'jam' };\n  const rows = cart.map((it, i) => {\n    const p = s.prods[it.product_id] || {}, x = qi[it.product_id], k = (p.categories || {}).kind || 'rental';\n    const u = UNIT[(p.categories || {}).price_unit] || 'hari';\n    const qty = it.quantity || 1;\n    const warn = missing.indexOf(it.product_id) > -1 ? 'Harga belum diatur cabang' : unav.indexOf(it.product_id) > -1 ? (x && x.available > 0 ? 'Hanya tersisa ' + x.available + ' unit' : 'Tidak tersedia di tanggal ini') : '';\n    const line = x ? (x.basis === 'two_hour' ? 'Tarif 2 jam ' + RA.rp(x.unit_price) : x.basis === 'half_day' ? 'Tarif ½ hari ' + RA.rp(x.unit_price) : (+x.qty) % 1 ? (+x.qty).toString().replace('.', ',') + ' ' + u + ' (' + Math.floor(+x.qty) + ' hari + ½ hari)' : (+x.qty) + ' ' + u + ' × ' + RA.rp(x.unit_price)) + (qty > 1 ? ' × ' + qty + ' unit' : '') : (s.loaded ? '' : 'Menghitung…');\n    const upd = n => { const cc = RA.ctx().cart.slice(); if (n <= 0) cc.splice(i, 1); else cc[i] = Object.assign({}, cc[i], { quantity: n }); this.setCart(cc); };\n    return { name: p.name || 'Memuat barang…', photo: RA.photo(p.photos), line, warn, total: x ? RA.rp(x.line_total) : '—',\n      removable: true, remove: () => upd(0), canQty: k === 'rental', qty, inc: () => upd(qty + 1), dec: () => upd(qty - 1) };\n  });\n  // jenjang diskon bundling dari Promo otomatis\n  const tp = s.tiers, tiers = tp && tp.rule && Array.isArray(tp.rule.tiers) ? tp.rule.tiers.filter(t => t.percent != null && t.items != null).sort((a, b) => a.items - b.items) : [];\n  const elig = it => { const p = s.prods[it.product_id] || {}; const cat = p.category_id, line = x => x; return tp && (!tp.category_ids || tp.category_ids.indexOf(cat) > -1) && (!tp.exclude_category_ids || tp.exclude_category_ids.indexOf(cat) < 0); };\n  const n = cart.filter(elig).reduce((a, it) => a + (it.quantity || 1), 0);\n  let nudge = '', bar = 0;\n  if (tiers.length) {\n    const cur = tiers.filter(t => n >= t.items).pop(), nxt = tiers.find(t => n < t.items), top = tiers[tiers.length - 1];\n    nudge = !nxt ? (tp && tp.category_ids ? 'Mantap! Diskon rombongan ' : 'Mantap! Diskon bundling ') + top.percent + '% sudah aktif.' : 'Tambah ' + (nxt.items - n) + (tp && tp.category_ids ? ' motor lagi, hemat ' : ' item lagi, hemat ') + (cur ? 'jadi ' : 'langsung ') + nxt.percent + '%.';\n    bar = Math.min(n, top.items) / top.items * 100;\n  }\n  const unitW = tp && tp.category_ids ? ' motor' : ' item'; const tierLabels = tiers.length ? ['1' + unitW].concat(tiers.map((t, i) => t.items + (i === tiers.length - 1 ? '+' : '') + unitW + ' · hemat ' + t.percent + '%')) : [];\n  const btnBase = 'height: 38px; border-radius: 10px; font: 700 13px \"Plus Jakarta Sans\", sans-serif; cursor: pointer; margin-top: auto;';\n  const on = 'border: 0; background: #1F2B4D; color: #FFFFFF;', off = 'border: 1px solid #1F2B4D; background: #FFFFFF; color: #1F2B4D;';\n  const inCart = id => cart.some(x => x.product_id === id);\n  const toggle = id => () => { const cc = RA.ctx().cart.slice(); const i = cc.findIndex(x => x.product_id === id); if (i > -1) cc.splice(i, 1); else cc.push({ product_id: id, quantity: 1 }); this.setCart(cc); };\n  const dayPrice = p => { const pp = (p.product_prices || []).filter(x => x.price != null && (!x.branch_id || x.branch_id === br.id)); const d = pp.find(x => x.basis === 'day'); return d ? RA.rp(d.price) + '/hari' : pp[0] ? RA.rp(pp[0].price) : 'Harga belum diatur'; };\n  const recs = s.recs.filter(id => s.prods[id] && !inCart(id) || (s.prods[id] && inCart(id) && s._added && s._added[id])).map(id => {\n    const p = s.prods[id], has = inCart(id);\n    const pc = (s.relPct || {})[id] || 0, dp = dayPrice(p), mm = /^(Rp[\\d.]+)(\\/hari)?$/.exec(dp || '');\n    return { name: p.name, photo: RA.photo(p.photos), badge: pc >= 5 ? '🔥 ' + pc + '% ikut sewa' : '', priceBig: mm ? mm[1].replace(/\\.000$/, 'rb') : dp, priceUnit: mm ? (mm[2] || '') : '', btn: has ? '✓ Ditambahkan' : '+ Tambah', btnStyle: (has ? 'height: 36px; border-radius: 11px; border: 0; background: #077A70; color: #FFFFFF;' : 'height: 36px; border-radius: 11px; border: 1.5px solid #09BEAF; background: #FFFFFF; color: #077A70;') + ' font: 800 13px \"Plus Jakarta Sans\", sans-serif; cursor: pointer; margin-top: 4px; width: 100%',\n      toggle: () => { this.state._added = Object.assign({}, s._added, { [id]: true }); toggle(id)(); } };\n  });\n  const first = s.prods[(cart[0] || {}).product_id];\n  const dayOf = id => { const pp = ((s.prods[id] || {}).product_prices || []).filter(x => x.price != null && (!x.branch_id || x.branch_id === br.id)); const brp = pp.find(x => x.basis === 'day' && x.branch_id); const d = brp || pp.find(x => x.basis === 'day'); return d ? +d.price : null; };\n  const kRp = n => n >= 1000 ? 'Rp' + String(Math.round(n / 100) / 10).replace('.', ',') + 'rb' : RA.rp(n);\n  const packs = s.packs.map(b => {\n    const ids = b.bundle_items.map(i => i.product_id), has = ids.every(inCart), rel = ids.filter(inCart).length;\n    const prices = b.bundle_items.map(i => { const d = dayOf(i.product_id); return d == null ? null : d * Math.max(days, 1) * (i.qty || 1); });\n    const normal = prices.every(x => x != null) ? prices.reduce((a, x) => a + x, 0) : null;\n    const pct = +b.discount_percent || 0, cut = normal != null ? Math.round(normal * pct / 100) : null;\n    return { has, rel, name: b.name, pics: ids.slice(0, 3).map(id => RA.photo((s.prods[id] || {}).photos)).filter(Boolean),\n      desc: b.description || ids.map(id => (s.prods[id] || {}).name).filter(Boolean).join(' + '),\n      ribbon: cut ? 'HEMAT ' + kRp(cut).toUpperCase() : 'HEMAT ' + pct + '%', pct: '-' + pct + '%',\n      newPrice: normal != null ? RA.rp(normal - cut) : '', oldPrice: normal != null ? RA.rp(normal) : '', forDays: 'untuk ' + Math.max(days, 1) + ' hari',\n      add: () => { const cc = RA.ctx().cart.slice(); b.bundle_items.forEach(i => { if (!cc.some(x => x.product_id === i.product_id)) cc.push({ product_id: i.product_id, quantity: i.qty || 1 }); }); this.setCart(cc); },\n      btn: has ? '✓ Sudah di keranjang' : (cut ? 'Ambil paket · hemat ' + kRp(cut) : 'Ambil paket ini'),\n      btnStyle: 'margin-top: 4px; height: 44px; border-radius: 12px; font: 800 14px \"Plus Jakarta Sans\", sans-serif; cursor: pointer;' + (has ? 'border: 1px solid #077A70; background: #E3F7F5; color: #077A70;' : 'border: 0; background: #09BEAF; color: #1F2B4D;') };\n  }).sort((x, y) => (x.has - y.has) || (y.rel - x.rel)).slice(0, 3);\n  const discLines = [];\n  if (q && +q.pack_discount > 0) { (q.packs_applied || []).forEach(pk => discLines.push({ label: pk.name + ' (hemat ' + pk.percent + '%)', amount: RA.rp(pk.amount) })); } 