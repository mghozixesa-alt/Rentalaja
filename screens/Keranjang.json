 ? 'border: 2px solid #077A70; background: #F2FBFA;' : 'border: 1.5px solid #E1E5EA; background: #FFFFFF;'),\n    rcvDelSub: ((RA.ctx().delivery || {}).mode === 'delivery') ? ((q && q.delivery_fee != null && !q.delivery_fee_pending ? (+q.delivery_fee ? RA.rp(q.delivery_fee) : 'Gratis ongkir') : '') || 'Ongkir dihitung') : 'Ke rumah, kos, hotel',\n    rcvAddr: ((RA.ctx().delivery || {}).mode === 'delivery') ? ((RA.ctx().delivery.address ? 'Diantar ke ' + RA.ctx().delivery.address : 'Alamat antar belum diisi') + ((RA.ctx().delivery || {}).return_pickup ? ((RA.ctx().delivery.ret && RA.ctx().delivery.ret.address) ? ' · dijemput di ' + RA.ctx().delivery.ret.address : ' · dijemput di alamat yang sama') : '')) : '',\n    antarHref: 'Antar.dc.html?back=Keranjang',\n    backHref: cart.length ? 'Produk.dc.html?id=' + cart[cart.length - 1].product_id : 'Cari.dc.html',\n    ctxText: (br.name || '') + ' · ' + range + ' (' + RA.durText(c.start_at, c.end_at) + ')',\n    showNudge: tiers.length > 0 && n > 0, nudge, tierLabels, barStyle: 'height: 100%; width: ' + bar + '%; background: #09BEAF; border-radius: 4px;',\n    empty: s.loaded && !cart.length ? 'Keranjang masih kosong' : '', hasCart: cart.length > 0, cart: rows, warnings,\n    hasPacks: packs.length > 0 && cart.length > 0, packs,\n    hasRecs: recs.length > 0, recs, recTitle: 'Sering disewa bareng ' + (first && first.categories ? first.categories.name.toLowerCase() : 'ini'),\n    count, days, durLabel: RA.durText(c.start_at, c.end_at), subtotal: q ? RA.rp(q.subtotal) : '—', discLines,\n    deliveryLine: deliv && q ? (q.delivery_fee_pending ? 'dikonfirmasi cabang' : RA.rp(q.delivery_fee)) : '',\n    total: q ? RA.rp(q.total) : '—', cantNext: cant,\n    nextStyle: 'height: 50px; padding: 0 20px; border-radius: 12px; border: 0; background: ' + (cant ? '#C5CBD4' : '#09BEAF') + '; color: #1F2B4D; font: 800 15px \"Plus Jakarta Sans\", sans-serif; display: flex; align-items: center; cursor: ' + (cant ? 'not-allowed' : 'pointer'),\