{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Bayar booking</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0}\na{color:#1F2B4D}a:hover{color:#000}\n</style>\n</helmet>\n<div style=\"width: 390px; height: 1400px; box-sizing: border-box; background: #F4F6F9; color: #1F2B4D; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; flex-direction: column; position: relative; overflow: hidden\">\n\n  <header style=\"background: #FFFFFF; border-bottom: 1px solid #E6E8EC; padding: 10px 12px 16px; display: flex; flex-direction: column; gap: 12px\">\n    <div style=\"display: flex; align-items: center; gap: 8px\">\n      <a href=\"{{statusHref}}\" aria-label=\"Kembali\" style=\"width: 44px; height: 44px; display: flex; align-items: center; justify-content: center\">\n        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1F2B4D\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M15 6l-6 6 6 6\"/></svg>\n      </a>\n      <div style=\"font-size: 18px; font-weight: 800\">Pembayaran</div>\n    </div>\n    <div style=\"display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; padding: 0 4px\">\n      <div style=\"display: flex; flex-direction: column; gap: 6px\"><div style=\"height: 4px; border-radius: 2px; background: #1F2B4D\"></div><div style=\"font-size: 12px; font-weight: 700\">1 · Jadwal</div></div>\n      <div style=\"display: flex; flex-direction: column; gap: 6px\"><div style=\"height: 4px; border-radius: 2px; background: #1F2B4D\"></div><div style=\"font-size: 12px; font-weight: 700\">2 · Verifikasi</div></div>\n      <div style=\"display: flex; flex-direction: column; gap: 6px\"><div style=\"height: 4px; border-radius: 2px; background: #09BEAF\"></div><div style=\"font-size: 12px; font-weight: 800\">3 · Bayar</div></div>\n    </div>\n  </header>\n\n  <sc-if value=\"{{note}}\"><div style=\"margin: 24px 16px 0; font-size: 15px; line-height: 22px; color: #4A5468\">{{note}}</div></sc-if>\n  <sc-if value=\"{{other}}\"><div style=\"margin: 20px 16px 0; background: #FFF4E0; border-radius: 16px; padding: 16px; display: flex; flex-direction: column; gap: 10px\">\n    <b style=\"font-size: 15px; color: #5C3D00\">Masuk dengan akun yang dipakai saat booking {{otCode}}</b>\n    <div style=\"font-size: 13.5px; line-height: 20px; color: #5C3D00\">{{otTxt}}</div>\n    <button type=\"button\" onClick=\"{{switchAcc}}\" style=\"height: 48px; border: 0; border-radius: 12px; background: #1F2B4D; color: #FFFFFF; font: 800 14px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">Ganti akun</button>\n    <div style=\"font-size: 12px; line-height: 17px; color: #6B4A10\">Lupa akunnya? Chat admin dan sebutkan kode booking di atas.</div>\n  </div></sc-if>\n  <sc-if value=\"{{waiting}}\" hint-placeholder-val=\"{{true}}\">\n    <div style=\"display: flex; flex-direction: column\">\n\n      <section style=\"margin: 14px 16px 0; background: #E4F2EA; border-radius: 16px; padding: 16px; display: flex; flex-direction: column; gap: 6px\">\n        <div style=\"display: flex; align-items: center; gap: 8px; font-size: 15px; font-weight: 800; color: #1E6B45\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1E6B45\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M8 12.5l3 3 5-6\"/></svg>\n          Dokumen lolos verifikasi\n        </div>\n        <div style=\"font-size: 14px; line-height: 20px; color: #2D4A3A\">{{lockText}}</div>\n        <sc-if value=\"{{clock}}\"><div style=\"display: flex; align-items: baseline; gap: 8px; margin-top: 4px\">\n          <div style=\"font-size: 30px; font-weight: 800; letter-spacing: 0.02em; color: #1F2B4D; font-variant-numeric: tabular-nums\">{{clock}}</div>\n          <div style=\"font-size: 13px; color: #2D4A3A\">sisa waktu bayar</div>\n        </div></sc-if>\n      </section>\n\n      <section style=\"background: #FFFFFF; margin: 12px 16px 0; border: 0; border-radius: 20px; box-shadow: 0 2px 12px rgba(31,43,77,0.07); padding: 14px 16px; display: flex; flex-direction: column; gap: 8px; font-size: 14px\">\n        <div style=\"display: flex; justify-content: space-between; gap: 12px\"><span style=\"font-weight: 700\">{{itemsText}}</span><span style=\"color: #4A5468; white-space: nowrap\">{{daysText}}</span></div>\n        <div style=\"font-size: 13px; color: #4A5468\">{{whenText}}</div>\n        <div style=\"height: 1px; background: #E6E8EC\"></div>\n        <div style=\"display: flex; justify-content: space-between\"><span style=\"color: #4A5468\">{{nowLabel}}</span><b style=\"font-size: 18px\">{{amountText}}</b></div>\n        <sc-if value=\"{{feeText}}\"><div style=\"display: flex; justify-content: space-between\"><span style=\"color: #4A5468\">Biaya layanan {{feeName}}</span><span>{{feeText}}</span></div>\n        <div style=\"display: flex; justify-content: space-between; border-top: 1px dashed #D5D9E0; padding-top: 8px\"><span style=\"font-weight: 700\">Total dibayar sekarang</span><b style=\"font-size: 18px\">{{payTotalText}}</b></div></sc-if>\n        <sc-if value=\"{{restText}}\"><div style=\"display: flex; justify-content: space-between\"><span style=\"color: #4A5468\">Sisa saat ambil di cabang</span><span>{{restText}}</span></div></sc-if>\n      </section>\n\n      <section style=\"margin: 16px 16px 0; display: flex; flex-direction: column; gap: 12px\">\n        <div style=\"font-size: 16px; font-weight: 800\">Bayar pakai</div>\n        <div style=\"display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px\">\n          <sc-for list=\"{{tabs}}\" as=\"t\" hint-placeholder-count=\"3\">\n            <button type=\"button\" onClick=\"{{t.pick}}\" aria-pressed=\"{{t.on}}\" style=\"{{t.style}}\"><span style=\"display: flex; flex-direction: column; align-items: center; line-height: 17px\">{{t.label}}<span style=\"font-size: 11px; font-weight: 700; color: {{t.subColor}}\">{{t.sub}}</span></span></button>\n          </sc-for>\n        </div>\n\n        <sc-if value=\"{{isQris}}\" hint-placeholder-val=\"{{true}}\">\n          <div style=\"background: #FFFFFF; border: 0; border-radius: 20px; box-shadow: 0 2px 12px rgba(31,43,77,0.07); padding: 18px 16px; display: flex; flex-direction: column; align-items: center; gap: 12px\">\n            <img src=\"img/pay/qris.svg\" alt=\"QRIS\" style=\"height: 26px; width: auto; display: block\">\n            <div style=\"font-size: 13px; color: #4A5468\">Scan dari m-banking atau e-wallet apa pun</div>\n            <div style=\"width: 216px; height: 216px; border-radius: 12px; background: #F1F3F5; border: 1px solid #D5D9E0; display: flex; flex-direction: column; gap: 10px; align-items: center; justify-content: center; text-align: center; font-size: 12px; font-weight: 700; color: #6B7385; padding: {{qrPad}}; box-sizing: border-box; background: {{qrBg}}\">\n              <sc-if value=\"{{qrImg}}\"><img src=\"{{qrImg}}\" alt=\"Kode QRIS untuk dipindai\" style=\"width: 200px; height: 200px; display: block\"></sc-if>\n              <sc-if value=\"{{qrImg}}\" not><svg width=\"40\" height=\"40\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4A5468\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/><path d=\"M14 14h3v3h-3zM20 14v.01M14 20h.01M17 20h4v-3\"/></svg>\n              <span>{{qrNote}}</span></sc-if>\n            </div>\n            <div style=\"font-size: 14px; font-weight: 700\">Rentalaja · {{amountText}}</div>\n            <sc-if value=\"{{qrSimNote}}\"><div style=\"font-size: 12px; font-weight: 700; color: #8A4B00; background: #FFF1D6; border-radius: 8px; padding: 6px 10px\">{{qrSimNote}}</div></sc-if>\n            <sc-if value=\"{{payUrl}}\"><a href=\"{{payUrl}}\" target=\"_blank\" rel=\"noopener\" style=\"height: 44px; width: 100%; border-radius: 12px; border: 1px solid #1F2B4D; background: #FFFFFF; color: #1F2B4D; font: 700 14px 'Plus Jakarta Sans', sans-serif; display: flex; align-items: center; justify-content: center; text-decoration: none\">Buka halaman pembayaran</a></sc-if>\n            <sc-if value=\"{{qrImg}}\"><button type=\"button\" onClick=\"{{saveQr}}\" style=\"height: 40px; padding: 0 16px; border-radius: 10px; border: 1px solid #D5D9E0; background: #FFFFFF; color: #1F2B4D; font: 700 13px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">Simpan gambar QR</button></sc-if>\n            <div style=\"font-size: 12px; line-height: 18px; color: #4A5468; text-align: center\">Bayar dari HP yang sama? Simpan gambar QR, lalu unggah di menu scan QRIS aplikasi bank/e-wallet. Atau pilih tab E-wallet / Transfer VA.</div>\n          </div>\n        </sc-if>\n\n        <sc-if value=\"{{isWallet}}\" hint-placeholder-val=\"{{false}}\">\n          <div style=\"display: flex; flex-direction: column; gap: 8px\">\n            <sc-for list=\"{{wallets}}\" as=\"w\" hint-placeholder-count=\"4\">\n              <button type=\"button\" onClick=\"{{w.pick}}\" style=\"{{w.style}}\">\n                <span style=\"display: flex; align-items: center; gap: 12px\"><span style=\"width: 64px; height: 28px; display: flex; align-items: center; justify-content: center\"><img src=\"{{w.logo}}\" alt=\"\" style=\"max-width: 64px; max-height: 26px; display: block\"></span><span>{{w.label}}</span></span>\n                <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#8A93A6\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M9 6l6 6-6 6\"/></svg>\n              </button>\n            </sc-for>\n            <sc-if value=\"{{ovoAsk}}\"><div style=\"background: #FFFFFF; border-radius: 14px; box-shadow: 0 2px 12px rgba(31,43,77,0.07); padding: 14px; display: flex; flex-direction: column; gap: 8px\">\n              <label style=\"display: flex; flex-direction: column; gap: 4px; font-size: 13px; font-weight: 600; color: #4A5468\">Nomor HP terdaftar di OVO\n                <input type=\"tel\" inputmode=\"numeric\" placeholder=\"08xxxxxxxxxx\" value=\"{{ovoPhone}}\" onInput=\"{{setOvo}}\" style=\"height: 46px; border: 1px solid #D5D9E0; border-radius: 10px; padding: 0 12px; font: 600 16px 'Plus Jakarta Sans', sans-serif; color: #1F2B4D\">\n              </label>\n              <button type=\"button\" onClick=\"{{sendOvo}}\" disabled=\"{{busyW}}\" style=\"height: 46px; border-radius: 12px; border: none; background: #4C2A86; color: #FFFFFF; font: 800 15px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">{{ovoBtn}}</button>\n            </div></sc-if>\n            <sc-if value=\"{{walletMsg}}\"><div style=\"background: #E3F7F5; border-radius: 12px; padding: 12px 14px; font-size: 13px; line-height: 19px; color: #1F2B4D\">{{walletMsg}}</div></sc-if>\n            <div style=\"font-size: 12px; line-height: 18px; color: #4A5468\">Pilih e-wallet. DANA, AstraPay & ShopeePay membuka aplikasinya sebentar untuk konfirmasi, lalu kembali ke halaman ini. OVO cukup konfirmasi notifikasi di aplikasi OVO.</div>\n          </div>\n        </sc-if>\n\n        <sc-if value=\"{{isVa}}\" hint-placeholder-val=\"{{false}}\">\n          <div style=\"background: #FFFFFF; border: 0; border-radius: 20px; box-shadow: 0 2px 12px rgba(31,43,77,0.07); padding: 16px; display: flex; flex-direction: column; gap: 12px\">\n            <div style=\"display: flex; flex-direction: column; gap: 6px\"><span style=\"font-size: 13px; font-weight: 600; color: #4A5468\">Pilih bank</span>\n              <div style=\"display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px\"><sc-for list=\"{{banks}}\" as=\"k\"><button type=\"button\" onClick=\"{{k.pick}}\" aria-pressed=\"{{k.on}}\" aria-label=\"{{k.name}}\" style=\"{{k.style}}\"><img src=\"{{k.logo}}\" alt=\"{{k.name}}\" style=\"max-width: 78%; max-height: 24px; display: block\"></button></sc-for></div>\n            </div>\n            <div style=\"background: #F6F7F9; border-radius: 12px; padding: 12px 14px; display: flex; justify-content: space-between; align-items: center; gap: 12px\">\n              <div><div style=\"font-size: 12px; color: #4A5468\">Nomor virtual account</div><div style=\"font-size: {{vaSize}}; font-weight: 800; letter-spacing: 0.04em\">{{vaText}}</div></div>\n              <sc-if value=\"{{vaNumber}}\"><button type=\"button\" onClick=\"{{copyVa}}\" style=\"height: 40px; padding: 0 14px; border-radius: 10px; border: 1px solid #1F2B4D; background: #FFFFFF; color: #1F2B4D; font: 700 13px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">Salin</button></sc-if>\n            </div>\n            <div style=\"font-size: 12px; line-height: 18px; color: #4A5468\">Transfer tepat <b>{{payTotalText}}</b> ke nomor di atas. Nomor ini hanya untuk booking ini.</div>\n            <div style=\"font-size: 12px; line-height: 18px; color: #4A5468\">Cara bayar: buka m-banking/ATM {{bankName}} → Transfer → Virtual Account → masukkan nomor → konfirmasi. Dari bank lain: pilih transfer antarbank ke {{bankName}} dengan nomor yang sama.</div>\n          </div>\n        </sc-if>\n      </section>\n\n      <div style=\"margin: 14px 16px 0; display: flex; align-items: center; gap: 10px; font-size: 13px; line-height: 19px; color: #4A5468\">\n        <div style=\"width: 10px; height: 10px; border-radius: 5px; background: #09BEAF; flex-shrink: 0\"></div>\n        Menunggu pembayaran. Terdeteksi otomatis, tidak perlu kirim bukti transfer.\n      </div>\n\n      <sc-if value=\"{{sim}}\"><div style=\"margin: 18px 16px 0; border: 1.5px dashed #B4BCC8; border-radius: 14px; padding: 14px; display: flex; flex-direction: column; gap: 10px; background: #F6F7F9\">\n        <div style=\"font-size: 14px; font-weight: 800\">Mode uji</div>\n        <div style=\"font-size: 13px; line-height: 19px; color: #4A5468\">Pembayaran belum tersambung ke payment gateway, jadi tidak ada uang yang ditarik. Tekan tombol ini untuk menguji alur pembayaran masuk.</div>\n        <button type=\"button\" onClick=\"{{simulate}}\" disabled=\"{{busy}}\" style=\"height: 44px; border-radius: 12px; border: 1px solid #1F2B4D; background: #FFFFFF; color: #1F2B4D; font: 700 14px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">{{simLabel}}</button>\n      </div></sc-if>\n      <sc-if value=\"{{payError}}\"><div role=\"alert\" style=\"margin: 12px 16px 0; background: #FDECEA; border-radius: 10px; padding: 10px 12px; font-size: 13px; line-height: 19px; color: #A12A1F\">{{payError}}</div></sc-if>\n    </div>\n  </sc-if>\n\n  <sc-if value=\"{{paid}}\" hint-placeholder-val=\"{{false}}\">\n    <div style=\"display: flex; flex-direction: column\">\n      <section style=\"padding: 24px 20px 18px; display: flex; flex-direction: column; gap: 10px; border-bottom: 1px solid #E6E8EC\">\n        <div style=\"width: 48px; height: 48px; border-radius: 24px; background: #09BEAF; display: flex; align-items: center; justify-content: center\">\n          <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1F2B4D\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12l5 5 9-10\"/></svg>\n        </div>\n        <h1 style=\"margin: 0; font-size: 26px; line-height: 32px; font-weight: 800\">Pembayaran diterima</h1>\n        <p style=\"margin: 0; font-size: 15px; line-height: 22px; color: #4A5468\">{{paidText}}</p>\n      </section>\n\n      <section style=\"background: #FFFFFF; margin: 16px 16px 0; border: 0; border-radius: 20px; box-shadow: 0 2px 12px rgba(31,43,77,0.07); padding: 18px 16px; display: flex; flex-direction: column; align-items: center; gap: 10px; text-align: center\">\n        <div style=\"font-size: 16px; font-weight: 800\">Kode ambil unit</div>\n        <div style=\"font-size: 40px; font-weight: 800; letter-spacing: 0.12em; padding: 14px 0; font-variant-numeric: tabular-nums\">{{pickupCode}}</div>\n        <div style=\"font-size: 14px; font-weight: 700; color: #4A5468\">Booking {{code}}</div>\n        <div style=\"font-size: 13px; line-height: 19px; color: #4A5468\">{{codeNote}}</div>\n      </section>\n\n      <section style=\"background: #FFFFFF; margin: 12px 16px 0; border: 0; border-radius: 20px; box-shadow: 0 2px 12px rgba(31,43,77,0.07); padding: 16px; display: flex; flex-direction: column; gap: 8px; font-size: 14px\">\n        <div style=\"display: flex; justify-content: space-between\"><span style=\"color: #4A5468\">Ambil</span><b>{{pickText}}</b></div>\n        <div style=\"display: flex; justify-content: space-between; gap: 12px\"><span style=\"color: #4A5468\">Lokasi</span><b style=\"text-align: right\">{{placeText}}</b></div>\n        <sc-if value=\"{{restText}}\"><div style=\"display: flex; justify-content: space-between\"><span style=\"color: #4A5468\">Dibayar di cabang</span><b>{{restText}}</b></div></sc-if>\n        <div style=\"font-size: 12px; line-height: 18px; color: #4A5468\">Pengingat dikirim lewat WhatsApp sebelum jadwal ambil.</div>\n      </section>\n\n      <section style=\"margin: 12px 16px 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px\">\n        <button type=\"button\" onClick=\"{{saveCal}}\" style=\"height: 48px; border-radius: 12px; border: 1px solid #1F2B4D; background: #FFFFFF; color: #1F2B4D; font: 700 14px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">Simpan ke kalender</button>\n        <a href=\"{{mapsHref}}\" style=\"height: 48px; border-radius: 12px; background: #1F2B4D; color: #FFFFFF; font-size: 14px; font-weight: 700; display: flex; align-items: center; justify-content: center; text-decoration: none\">Arah ke cabang</a>\n      </section>\n\n      <a href=\"{{statusHref}}\" style=\"margin: 16px 16px 0; height: 52px; border-radius: 12px; background: #09BEAF; color: #1F2B4D; font-size: 16px; font-weight: 800; display: flex; align-items: center; justify-content: center; text-decoration: none\">Lihat status booking</a>\n      <div style=\"height: 24px\"></div>\n    </div>\n  </sc-if>\n</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{\"$preview\":{\"width\":390,\"height\":1400}}'>\nclass Component extends DCLogic {\nstate = { b: null, method: 'qris', pm: null, pay: null, now: Date.now(), payError: '', bank: 'BNI', note: 'Memuat tagihan…', paidPm: null, wallet: '', ovoPhone: '', walletMsg: '', busyW: false };\nasync componentDidMount() {\n  const plan = ((RA.ctx().pay_plans || {})[this.params.id] || {});\n  if (plan.method === 'va') this.state.method = 'va';\n  this.timer = setInterval(() => { this.setState({ now: Date.now() }); this.checkExpiry(); }, 1000);\n  this.stop = RA.poll(this, () => this.load(), 5000);\n  this.sync = setInterval(() => { const p = this.state.pm, b = this.state.b; if (p && p.id && b && b.status === 'awaiting_payment' && !RA.simulation()) RA.fn('pay-sync', { payment_id: p.id }).catch(() => {}); }, 8000);\n}\ncomponentWillUnmount() { clearInterval(this.timer); clearInterval(this.sync); if (this.stop) this.stop(); }\nasync load() {\n  const id = this.params.id;\n  let q = RA.from('bookings').select('*,branches(name,address,maps_url,lat,lng),booking_items(product_id,quantity,products(name))');\n  q = id ? q.eq('id', id) : q.eq('status', 'awaiting_payment').order('created_at', { ascending: false }).limit(1);\n  const r = id ? await q.maybeSingle() : await q;\n  if (!RA_ALIVE(this)) return;\n  const b = Array.isArray(r.data) ? r.data[0] : r.data;\n  if (!b) { let other = null; if (id) { other = await RA.call('booking_owner_hint', { p_id: id }).catch(() => null); if (!RA_ALIVE(this)) return; }\n    this.setState({ note: other ? '' : 'Tidak ada tagihan yang menunggu pembayaran.', other, b: null }); return; }\n  const go = n => location.replace('#/' + n + '?id=' + b.id);\n  if (b.status === 'rejected') return go('Ditolak');\n  if (b.status === 'expired') return go('Kedaluwarsa');\n  if (b.status === 'pending_verification') return go('Status');\n  if (['confirmed', 'active', 'returned', 'completed'].indexOf(b.status) > -1) {\n    if (!this.state.paidPm) {\n      const { data } = await RA.from('payments').select('amount,method,paid_at,kind').eq('booking_id', b.id).eq('status', 'paid').order('paid_at', { ascending: false }).limit(1);\n      if (!RA_ALIVE(this)) return;\n      this.setState({ paidPm: (data || [])[0] || { amount: b.paid_amount, method: null } });\n    }\n    this.setState({ b, note: '' }); return;\n  }\n  if (b.status !== 'awaiting_payment') { this.setState({ b: null, note: 'Booking ini ' + ((RA.STATUS[b.status] || [b.status])[0]).toLowerCase() + ', tidak ada yang perlu dibayar.' }); return; }\n  if (this._pi === undefined) { this._pi = await RA.call('pay_info', { p_booking: b.id }).catch(() => null); if (!RA_ALIVE(this)) return; }\n  if (this._pi && this._pi.mode === 'transfer') { location.replace('#/BayarTransfer?id=' + b.id); return; }\n  this.setState({ b, note: '' });\n  if (!this._preparing && (!this.state.pm || this.state.pm.method !== this.apiMethod())) await this.prepare();\n}\napiMethod() { return this.state.method === 'ewallet' ? 'ewallet' : this.state.method; }\nasync prepare() {\n  const b = this.state.b; if (!b) return;\n  const seq = this._seq = (this._seq || 0) + 1;\n  this._preparing = true; setTimeout(() => { if (this._seq === seq) this._preparing = false; }, 15000);\n  const plan = ((RA.ctx().pay_plans || {})[b.id] || {}).plan;\n  const kind = plan === 'full' && +b.paid_amount < +b.dp_amount && +b.dp_amount < +b.total ? 'settlement' : null;\n  try {\n    const pm = await RA.call('create_payment', { p_booking: b.id, p_kind: kind, p_method: this.apiMethod(), p_amount: null });\n    if (!RA_ALIVE(this)) return;\n    if (this.state.method === 'ewallet') { this._preparing = false; this.setState({ pm, payError: '' }); return; }\n    const ck = this.state.method === 'va' ? 'va:' + this.state.bank : '';\n    if (ck && this._cache && this._cache[ck] && this._cache[ck].pm.id === pm.id) { const c0 = this._cache[ck]; this._preparing = false; pm.va_number = c0.va; this.setState({ pm, pay: c0.pay, payError: '' }); return; }\n    const pay = await RA.fn('pay', { payment_id: pm.id, channel: this.state.method === 'va' ? this.state.bank : undefined, return_url: location.origin + location.pathname + '#/Bayar?id=' + b.id });\n    if (seq !== this._seq) return;\n    if (pay.va_number) { pm.va_number = pay.va_number; this._cache = this._cache || {}; this._cache['va:' + this.state.bank] = { va: pay.va_number, pay, pm }; }\n    if (!RA_ALIVE(this)) return;\n    this._preparing = false;\n    this.setState({ pm, pay, payError: '' });\n    if (pay.status === 'paid') this.load();\n  } catch (e) {\n    this._preparing = false;\n    if (!RA_ALIVE(this)) return;\n    if (/habis/i.test(e.message)) { location.replace('#/Kedaluwarsa?id=' + b.id); return; }\n    this.setState({ payError: RA.friendly(e.message) });\n  }\n}\nasync payWallet(code) {\n  const s = this.state; if (s.busyW) return;\n  if (code === 'OVO' && !/^(\\+?62|0)?8\\d{7,12}$/.test(String(s.ovoPhone || '').replace(/[\\s-]/g, ''))) { this.setState({ wallet: 'OVO', walletMsg: '' }); return; }\n  this.setState({ wallet: code, busyW: true, walletMsg: '', payError: '' });\n  try {\n    if (!this.state.pm) await this.prepare();\n    const pm = this.state.pm; if (!pm) throw new Error('Tagihan belum siap');\n    const r = await RA.fn('pay', { payment_id: pm.id, channel: code, mobile: code === 'OVO' ? s.ovoPhone : undefined, return_url: location.origin + location.pathname + '#/Bayar?id=' + this.state.b.id });\n    if (!RA_ALIVE(this)) return;\n    if (r.status === 'paid') { this.load(); return; }\n    const ew = r.ewallet || {};\n    if (code === 'OVO') { this.setState({ busyW: false, walletMsg: 'Tagihan dikirim ke aplikasi OVO. Buka notifikasi OVO dan konfirmasi dalam 55 detik — halaman ini otomatis berubah setelah pembayaran masuk.' }); return; }\n    const mobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);\n    const url = (mobile ? (ew.deeplink || ew.mobile) : null) || ew.web || ew.mobile;\n    if (!url) throw new Error('Halaman konfirmasi ' + code + ' belum tersedia, coba lagi.');\n    this.setState({ walletMsg: 'Membuka ' + code + ' untuk konfirmasi…' });\n    location.href = url;\n  } catch (e) { if (RA_ALIVE(this)) this.setState({ busyW: false, payError: RA.friendly(e.message) }); }\n}\ncheckExpiry() {\n  const b = this.state.b;\n  if (b && b.status === 'awaiting_payment' && b.hold_expires_at && new Date(b.hold_expires_at).getTime() <= Date.now()) location.replace('#/Kedaluwarsa?id=' + b.id);\n}\nasync simulate() {\n  const pm = this.state.pm; if (!pm) { await this.prepare(); }\n  const p = this.state.pm; if (!p) return;\n  await RA.fn('pay', { payment_id: p.id, action: 'simulate' });\n  RA.ok('Pembayaran masuk (simulasi)');\n  await this.load();\n}\nics() {\n  const b = this.state.b; if (!b) return;\n  const f = d => new Date(d).toISOString().replace(/[-:]/g, '').replace(/\\.\\d{3}/, '');\n  const txt = ['BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//Rentalaja//ID', 'BEGIN:VEVENT', 'UID:' + b.id + '@rentalaja', 'DTSTAMP:' + f(new Date()), 'DTSTART:' + f(b.start_at), 'DTEND:' + f(b.end_at),\n    'SUMMARY:Ambil sewa Rentalaja ' + b.code + ' · kode ' + (b.pickup_code || ''), 'LOCATION:' + ((b.branches || {}).address || (b.branches || {}).name || ''), 'END:VEVENT', 'END:VCALENDAR'].join('\\r\\n');\n  const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([txt], { type: 'text/calendar' })); a.download = b.code + '.ics'; document.body.appendChild(a); a.click(); a.remove();\n}\nrenderVals() {\n  const s = this.state, b = s.b;\n  const ot = s.other, otVia = ot ? (/google/.test(ot.via) ? 'Google' : /phone/.test(ot.via) ? 'nomor HP' : 'email') : '';\n  const otWho = ot ? [ot.email, ot.phone].filter(Boolean).join(' · ') : '';\n  if (!b) return { note: s.note, other: !!ot, otCode: ot ? ot.code : '', otTxt: ot ? 'Booking ini dibuat dengan akun lain' + (otWho ? ' (' + otWho + ')' : '') + ', masuk lewat ' + otVia + '. Kamu sekarang masuk dengan akun yang berbeda, jadi tagihannya tidak terlihat.' : '', switchAcc: () => { RA.signOut(); location.reload(); }, waiting: false, paid: false, statusHref: 'Status.dc.html' + (this.params.id ? '?id=' + this.params.id : '') };\n  const br = b.branches || {};\n  const paid = ['confirmed', 'active', 'returned', 'completed'].indexOf(b.status) > -1;\n  const base = 'height: 54px; border-radius: 12px; cursor: pointer; font: 700 14px \"Plus Jakarta Sans\", sans-serif; color: #1F2B4D;';\n  const on = 'border: 2px solid #1F2B4D; background: #E3F7F5;', off = 'border: 1px solid #D5D9E0; background: #FFFFFF;';\n  const amt0 = s.pm ? +s.pm.amount : Math.max(0, +b.dp_amount - +b.paid_amount);\n  const feeOf = m => m === 'va' ? Math.max(0, Math.round(+RA.setting('pay_fee_va') || 0)) : m === 'ewallet' ? Math.ceil(amt0 * Math.max(0, +RA.setting('pay_fee_ewallet_pct') || 0) / 100 / 500) * 500 : 0;\n  const fee = s.pay && s.pay.fee != null && s.method !== 'qris' ? +s.pay.fee : feeOf(s.method);\n  const tabs = [{ id: 'qris', label: 'QRIS' }, { id: 'ewallet', label: 'E-wallet' }, { id: 'va', label: 'Transfer VA' }].map(t => ({ ...t, sub: feeOf(t.id) > 0 ? '+' + RA.rp(feeOf(t.id)) : 'Tanpa biaya', subColor: feeOf(t.id) > 0 ? '#5B6577' : '#077A70', on: s.method === t.id ? 'true' : 'false',\n    pick: () => { if (s.method === t.id) return; this.setState({ method: t.id, pm: null, pay: null, walletMsg: '', wallet: '', busyW: false }); setTimeout(() => this.prepare()); }, style: base + (s.method === t.id ? on : off) }));\n  const left = b.hold_expires_at ? Math.max(0, Math.floor((new Date(b.hold_expires_at).getTime() - s.now) / 1000)) : null;\n  const names = (b.booking_items || []).map(i => i.products && i.products.name).filter(Boolean);\n  const uniq = Array.from(new Set(names));\n  const days = RA.days(b.start_at, b.end_at);\n  const amt = s.pm ? +s.pm.amount : Math.max(0, +b.dp_amount - +b.paid_amount);\n  const isDp = s.pm ? s.pm.kind === 'dp' : +b.dp_amount < +b.total;\n  const rest = +b.total + +b.late_fee + +b.damage_fee - +b.paid_amount - (paid ? 0 : amt);\n  const sim = !!(s.pay && s.pay.simulation) || (!s.pay && RA.simulation());\n  const url = s.pay && s.pay.url ? s.pay.url : '';\n  const qrv = s.pay ? (s.pay.qr_string || (s.pay.payment || {}).qr_string || '') : '';\n  const labels = { qris: 'QRIS', ewallet: 'e-wallet', va: 'virtual account', cash: 'tunai', transfer: 'transfer', card: 'kartu', link: 'link bayar' };\n  const pp = s.paidPm || {};\n  const place = b.delivery_mode === 'delivery' ? 'Diantar · ' + (b.delivery_address || '') : 'Cabang ' + (br.name || '');\n  return {\n    note: '', statusHref: 'Status.dc.html?id=' + b.id, waiting: !paid, paid,\n    lockText: (uniq.length ? uniq.join(', ') : 'Unit') + ' dikunci untukmu. Selesaikan pembayaran sebelum waktunya habis, setelah itu unit dilepas lagi.',\n    clock: left == null ? '' : RA.pad(Math.floor(left / 60)) + ':' + RA.pad(left % 60),\n    itemsText: uniq.join(', ') || 'Booking ' + b.code, daysText: RA.durText(b.start_at, b.end_at) + '',\n    whenText: RA.date(b.start_at) + ' ' + RA.time(b.start_at) + ' → ' + RA.date(b.end_at) + ' ' + RA.time(b.end_at) + ' · ' + (b.delivery_mode === 'delivery' ? 'Diantar' : 'Ambil di ' + (br.name || 'cabang')),\n    nowLabel: isDp ? 'DP' + (b.dp_percent != null ? ' ' + b.dp_percent + '%' : '') + ' sekarang' : 'Bayar sekarang', amountText: RA.rp(amt),\n    restText: rest > 0 ? RA.rp(rest) : '',\n    feeText: fee > 0 && !paid ? RA.rp(fee) : '', feeName: s.method === 'va' ? 'transfer VA' : 'e-wallet', payTotalText: RA.rp(amt + (s.method === 'qris' ? 0 : fee)),\n    tabs, isQris: s.method === 'qris', isWallet: s.method === 'ewallet', isVa: s.method === 'va',\n    wallets: (RA.setting('ewallet_channels') || ['DANA', 'OVO', 'ASTRAPAY']).map(c => ({ label: { DANA: 'DANA', OVO: 'OVO', ASTRAPAY: 'AstraPay', SHOPEEPAY: 'ShopeePay' }[c] || c, logo: 'img/pay/' + ({ DANA: 'dana', OVO: 'ovo', ASTRAPAY: 'astra-pay', SHOPEEPAY: 'shopee-pay' }[c] || 'dana') + '.svg',\n      pick: () => this.payWallet(c), style: 'height: 52px; border-radius: 12px; border: ' + (s.wallet === c ? '2px solid #1F2B4D; background: #E3F7F5' : '1px solid #D5D9E0; background: #FFFFFF') + '; color: #1F2B4D; font: 700 15px \"Plus Jakarta Sans\", sans-serif; display: flex; align-items: center; justify-content: space-between; padding: 0 16px; cursor: pointer' })),\n    busyW: !!s.busyW, walletMsg: s.walletMsg, ovoAsk: s.wallet === 'OVO', ovoPhone: s.ovoPhone, setOvo: e => this.setState({ ovoPhone: e.target.value }),\n    sendOvo: () => this.payWallet('OVO'), ovoBtn: s.busyW ? 'Mengirim…' : 'Kirim tagihan ke OVO',\n    saveQr: () => { const a = document.createElement('a'); a.href = RA.qrSvg(qrv); a.download = 'QRIS-Rentalaja-' + b.code + '.svg'; document.body.appendChild(a); a.click(); a.remove(); },\n    bankName: ({ BNI: 'BNI', BRI: 'BRI', MANDIRI: 'Mandiri', BSI: 'BSI', PERMATA: 'Permata', CIMB: 'CIMB Niaga' })[s.bank] || s.bank,\n    qrImg: qrv ? RA.qrSvg(qrv) : '', qrPad: qrv ? '8px' : '16px', qrBg: qrv ? '#FFFFFF' : '#F1F3F5',\n    qrSimNote: qrv && sim ? 'Mode uji: QR contoh, tidak bisa dibayar' : '',\n    qrNote: sim ? 'Mode uji: kode QRIS tidak dibuat' : url ? 'Kode QRIS ada di halaman pembayaran' : s.payError ? 'Tagihan belum bisa dibuat' : 'Menyiapkan tagihan…',\n    payUrl: url, openPay: () => { if (url) window.open(url, '_blank', 'noopener'); else if (sim) RA.toast('Mode uji: pakai tombol simulasi di bawah.'); },\n    bank: s.bank, setBank: e => { this.setState({ bank: e.target.value, pm: null, pay: null }); setTimeout(() => this.prepare()); },\n    banks: [['BNI', 'BNI', 'bni'], ['BRI', 'BRI', 'bri'], ['MANDIRI', 'Mandiri', 'mandiri'], ['BSI', 'BSI', 'bsi'], ['PERMATA', 'Permata', 'permata'], ['CIMB', 'CIMB Niaga', 'cimb-niaga']].map(([id, name, f]) => ({ name, logo: 'img/pay/' + f + '.svg', on: s.bank === id ? 'true' : 'false',\n      pick: () => { if (s.bank === id) return; this.setState({ bank: id, pay: null, pm: s.pm ? Object.assign({}, s.pm, { va_number: null }) : null }); setTimeout(() => this.prepare()); },\n      style: 'height: 52px; border-radius: 12px; cursor: pointer; display: flex; align-items: center; justify-content: center; background: #FFFFFF; ' + (s.bank === id ? 'border: 2px solid #077A70; box-shadow: 0 0 0 3px #E3F7F5;' : 'border: 1px solid #D5D9E0;') })),\n    vaNumber: s.pm && s.pm.va_number ? s.pm.va_number : '', vaText: s.pm && s.pm.va_number ? s.pm.va_number : sim ? 'Mode uji' : s.payError ? 'Belum bisa dibuat' : 'Membuat nomor VA…', vaSize: s.pm && s.pm.va_number ? '18px' : '14px',\n    copyVa: () => { try { navigator.clipboard.writeText(s.pm.va_number); } catch (e) {} RA.toast('Nomor VA disalin'); },\n    sim, simulate: this.act(this.simulate), busy: !!s.busy, simLabel: s.busy ? 'Memproses…' : 'Simulasikan pembayaran masuk', payError: s.payError,\n    methodLabel: labels[pp.method] || 'pembayaran online',\n    paidText: (pp.amount != null ? RA.rp(pp.amount) + ' via ' + (labels[pp.method] || 'pembayaran online') + '. ' : '') + 'Bukti bayar juga dikirim ke emailmu.',\n    pickupCode: b.pickup_code || '—', code: b.code,\n    codeNote: 'Tunjukkan kode ini ke staf saat ambil.' + (RA.setting('ktp_original_deposit') === true ? ' KTP asli dititipkan di cabang sampai unit kembali.' : ''),\n    pickText: RA.dayTime(b.start_at), placeText: place,\n    saveCal: () => this.ics(),\n    mapsHref: br.maps_url || (br.lat != null ? 'https://www.google.com/maps?q=' + br.lat + ',' + br.lng : 'https://www.google.com/maps/search/' + encodeURIComponent('Rentalaja ' + (br.address || br.name || '')))\n  };\n}\n}\n</script>\n</body>\n</html>\n"}