{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Tiket keluhan</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0}\na{color:#1F2B4D}a:hover{color:#000}\nbutton:disabled{opacity:.55;cursor:not-allowed}\n</style>\n</helmet>\n<div style=\"width: 390px; height: 1400px; box-sizing: border-box; background: #F4F6F9; color: #1F2B4D; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; display: flex; flex-direction: column; position: relative; overflow: hidden\">\n\n  <header style=\"display: flex; align-items: center; justify-content: space-between; padding: 14px 16px; background: #FFFFFF\">\n    <img src=\"logo.png\" alt=\"Rentalaja\" style=\"height: 28px; width: auto; display: block\">\n    <div style=\"text-align: right\"><div style=\"font-size: 14px; font-weight: 800\">Tiket keluhan</div><div style=\"font-size: 12px; color: #4A5468\">{{sub}}</div></div>\n  </header>\n\n  <section style=\"padding: 14px 16px 0; display: flex; flex-direction: column; gap: 12px\">\n    <div role=\"tablist\" style=\"display: flex; gap: 6px; overflow-x: auto; padding-bottom: 2px\"><sc-for list=\"{{tabs}}\" as=\"t\"><button type=\"button\" role=\"tab\" aria-selected=\"{{t.on}}\" onClick=\"{{t.pick}}\" style=\"{{t.style}}\">{{t.label}}<sc-if value=\"{{t.n}}\"><span style=\"margin-left: 6px; min-width: 18px; height: 18px; padding: 0 5px; box-sizing: border-box; border-radius: 9px; background: {{t.nbg}}; color: #FFFFFF; font-size: 11px; display: inline-flex; align-items: center; justify-content: center\">{{t.n}}</span></sc-if></button></sc-for></div>\n    <sc-if value=\"{{canNew}}\"><button type=\"button\" onClick=\"{{toggleNew}}\" style=\"height: 46px; border-radius: 12px; border: 1.5px dashed #077A70; background: #FFFFFF; color: #077A70; font: 800 14px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">{{newLabel}}</button></sc-if>\n\n    <sc-if value=\"{{newOpen}}\"><div style=\"background: #FFFFFF; border-radius: 20px; padding: 16px; display: flex; flex-direction: column; gap: 10px\">\n      <div style=\"font-size: 15px; font-weight: 800\">Keluhan baru dari pelanggan</div>\n      <input type=\"text\" placeholder=\"Kode booking (kalau ada), mis. RA-2611-0010\" value=\"{{nf.code}}\" onInput=\"{{nf.setCode}}\" style=\"{{inp}}; text-transform: uppercase\">\n      <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 8px\"><input type=\"text\" placeholder=\"Nama pelanggan\" value=\"{{nf.name}}\" onInput=\"{{nf.setName}}\" style=\"{{inp}}\"><input type=\"tel\" placeholder=\"No. HP\" value=\"{{nf.phone}}\" onInput=\"{{nf.setPhone}}\" style=\"{{inp}}\"></div>\n      <div style=\"font-size: 12px; font-weight: 800; color: #4A5468\">Jenis keluhan</div>\n      <div style=\"display: flex; flex-wrap: wrap; gap: 6px\"><sc-for list=\"{{cats}}\" as=\"c\"><button type=\"button\" onClick=\"{{c.pick}}\" style=\"{{c.style}}\">{{c.label}}</button></sc-for></div>\n      <div style=\"font-size: 12px; color: #077A70; font-weight: 700\">{{routeHint}}</div>\n      <div style=\"font-size: 12px; font-weight: 800; color: #4A5468\">Tingkat urgensi</div>\n      <div style=\"display: grid; grid-template-columns: repeat(2, 1fr); gap: 6px\"><sc-for list=\"{{prios}}\" as=\"c\"><button type=\"button\" onClick=\"{{c.pick}}\" style=\"{{c.style}}\">{{c.label}}</button></sc-for></div>\n      <textarea rows=\"3\" placeholder=\"Isi keluhan, mis. motor mogok di Cipanas, pelanggan minta unit pengganti\" value=\"{{nf.summary}}\" onInput=\"{{nf.setSummary}}\" style=\"{{inp}}; height: auto; padding: 10px 12px; resize: vertical\"></textarea>\n      <button type=\"button\" onClick=\"{{create}}\" disabled=\"{{busy}}\" style=\"height: 50px; border-radius: 12px; border: none; background: #09BEAF; color: #1F2B4D; font: 800 15px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">Buat tiket</button>\n    </div></sc-if>\n\n    <sc-if value=\"{{empty}}\"><div style=\"background: #FFFFFF; border-radius: 16px; padding: 18px 14px; font-size: 13px; line-height: 19px; color: #4A5468; text-align: center\">{{empty}}</div></sc-if>\n\n    <sc-for list=\"{{list}}\" as=\"t\">\n    <div style=\"background: #FFFFFF; border-radius: 20px; box-shadow: 0 2px 10px rgba(31,43,77,0.05); padding: 14px 16px; display: flex; flex-direction: column; gap: 8px; border: 2px solid {{t.border}}\">\n      <button type=\"button\" onClick=\"{{t.pick}}\" style=\"all: unset; cursor: pointer; display: flex; flex-direction: column; gap: 6px\">\n        <div style=\"display: flex; justify-content: space-between; gap: 8px; align-items: center\"><b style=\"font-size: 14px\">{{t.code}} · {{t.cat}}</b><span style=\"{{t.slaChip}}\">{{t.sla}}</span></div>\n        <div style=\"font-size: 13px; line-height: 18px\">{{t.summary}}</div>\n        <div style=\"font-size: 12px; color: #4A5468\">{{t.meta}}</div>\n        <sc-if value=\"{{t.escText}}\"><div style=\"font-size: 12px; font-weight: 800; color: #A12A1F\">{{t.escText}}</div></sc-if>\n        <div style=\"display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; padding-top: 2px\"><sc-for list=\"{{t.steps}}\" as=\"p\"><div style=\"display: flex; flex-direction: column; gap: 3px\"><span style=\"height: 4px; border-radius: 2px; background: {{p.bg}}\"></span><span style=\"font-size: 10px; font-weight: 700; color: {{p.fg}}\">{{p.label}}</span></div></sc-for></div>\n      </button>\n      <sc-if value=\"{{t.sel}}\"><div style=\"display: flex; flex-direction: column; gap: 12px; border-top: 1px solid #EEF0F3; padding-top: 10px\">\n        <sc-if value=\"{{t.waCust}}\"><div style=\"display: flex; gap: 8px; flex-wrap: wrap\"><a href=\"{{t.waCust}}\" target=\"_blank\" rel=\"noopener\" style=\"{{btnO}}\">WA pelanggan</a></div></sc-if>\n\n        <div style=\"font-size: 13px; font-weight: 800\">Tugas per divisi</div>\n        <sc-if value=\"{{noTask}}\"><div style=\"font-size: 12px; color: #6B7486\">Memuat tugas…</div></sc-if>\n        <sc-for list=\"{{tasks}}\" as=\"k\">\n        <div style=\"border: 1px solid #E3E6EB; border-left: 4px solid {{k.stripe}}; border-radius: 12px; padding: 10px 12px; display: flex; flex-direction: column; gap: 6px; background: {{k.bg}}\">\n          <div style=\"display: flex; justify-content: space-between; gap: 8px; align-items: center\"><b style=\"font-size: 13px\">{{k.label}}</b><span style=\"{{k.chip}}\">{{k.state}}</span></div>\n          <sc-if value=\"{{k.reason}}\"><div style=\"font-size: 12px; line-height: 17px\">{{k.reason}}</div></sc-if>\n          <div style=\"font-size: 11.5px; color: #6B7486\">{{k.meta}}</div>\n          <sc-if value=\"{{k.note}}\"><div style=\"font-size: 12px; line-height: 17px; color: #1E6B45\">{{k.note}}</div></sc-if>\n          <sc-if value=\"{{k.canAct}}\"><div style=\"display: flex; gap: 6px; flex-wrap: wrap\">\n            <sc-if value=\"{{k.canStart}}\"><button type=\"button\" onClick=\"{{k.start}}\" disabled=\"{{busy}}\" style=\"{{btnP}}\">Mulai kerjakan</button></sc-if>\n            <sc-if value=\"{{k.isComp}}\" not><button type=\"button\" onClick=\"{{k.openDone}}\" style=\"{{btnO}}\">Selesai</button><button type=\"button\" onClick=\"{{k.openOper}}\" style=\"{{btnO}}\">Oper</button></sc-if>\n            <sc-if value=\"{{k.canDecide}}\"><button type=\"button\" onClick=\"{{k.approve}}\" disabled=\"{{busy}}\" style=\"{{btnP}}\">Setujui</button><button type=\"button\" onClick=\"{{k.openReject}}\" style=\"{{btnO}}\">Tolak</button></sc-if>\n            <sc-if value=\"{{k.canCancel}}\"><button type=\"button\" onClick=\"{{k.openCancel}}\" style=\"{{btnX}}\">Batalkan</button></sc-if>\n          </div></sc-if>\n          <sc-if value=\"{{k.formOpen}}\"><div style=\"display: flex; flex-direction: column; gap: 8px; padding-top: 4px\">\n            <sc-if value=\"{{k.isOper}}\"><div style=\"display: flex; flex-wrap: wrap; gap: 6px\"><sc-for list=\"{{operDivs}}\" as=\"v\"><button type=\"button\" onClick=\"{{v.pick}}\" style=\"{{v.style}}\">{{v.label}}</button></sc-for></div>\n              <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 6px\"><button type=\"button\" onClick=\"{{fm.setDone}}\" style=\"{{fm.doneStyle}}\">Tugas saya selesai</button><button type=\"button\" onClick=\"{{fm.setKeep}}\" style=\"{{fm.keepStyle}}\">Tetap jalan (paralel)</button></div></sc-if>\n            <textarea rows=\"2\" placeholder=\"{{k.formPh}}\" value=\"{{fm.note}}\" onInput=\"{{fm.setNote}}\" style=\"{{inp}}; height: auto; padding: 10px 12px; resize: vertical\"></textarea>\n            <div style=\"display: grid; grid-template-columns: 1fr 2fr; gap: 8px\"><button type=\"button\" onClick=\"{{closeForm}}\" style=\"{{btnO}}; justify-content: center\">Batal</button><button type=\"button\" onClick=\"{{submitForm}}\" disabled=\"{{busy}}\" style=\"{{btnP}}; justify-content: center\">{{k.formBtn}}</button></div>\n          </div></sc-if>\n        </div>\n        </sc-for>\n\n        <sc-if value=\"{{t.canAdd}}\"><div style=\"display: flex; flex-direction: column; gap: 8px; background: #F6F7F9; border-radius: 12px; padding: 10px 12px\">\n          <div style=\"font-size: 12px; font-weight: 800; color: #4A5468\">Tambah tugas ke divisi lain</div>\n          <div style=\"display: flex; flex-wrap: wrap; gap: 6px\"><sc-for list=\"{{addDivs}}\" as=\"v\"><button type=\"button\" onClick=\"{{v.pick}}\" style=\"{{v.style}}\">{{v.label}}</button></sc-for></div>\n          <sc-if value=\"{{af.div}}\"><input type=\"text\" placeholder=\"Apa yang perlu dikerjakan\" value=\"{{af.note}}\" onInput=\"{{af.setNote}}\" style=\"{{inp}}\"><button type=\"button\" onClick=\"{{addTask}}\" disabled=\"{{busy}}\" style=\"{{btnP}}; justify-content: center; height: 42px\">Kirim tugas</button></sc-if>\n        </div></sc-if>\n\n        <sc-if value=\"{{t.canComp}}\"><div style=\"display: flex; flex-direction: column; gap: 8px; background: #F6F7F9; border-radius: 12px; padding: 10px 12px\">\n          <div style=\"font-size: 12px; font-weight: 800; color: #4A5468\">Kompensasi untuk pelanggan</div>\n          <div style=\"display: flex; flex-wrap: wrap; gap: 6px\"><sc-for list=\"{{compKinds}}\" as=\"v\"><button type=\"button\" onClick=\"{{v.pick}}\" style=\"{{v.style}}\">{{v.label}}</button></sc-for></div>\n          <sc-if value=\"{{cf.kind}}\">\n            <sc-if value=\"{{cf.needAmt}}\"><input type=\"number\" inputmode=\"numeric\" placeholder=\"{{cf.amtPh}}\" value=\"{{cf.amount}}\" onInput=\"{{cf.setAmount}}\" style=\"{{inp}}\"></sc-if>\n            <input type=\"text\" placeholder=\"Alasan (opsional)\" value=\"{{cf.note}}\" onInput=\"{{cf.setNote}}\" style=\"{{inp}}\">\n            <div style=\"font-size: 11.5px; color: #6B7486\">Sampai 1 hari sewa disetujui Manajer Operasional. Di atas itu otomatis ke CEO.</div>\n            <button type=\"button\" onClick=\"{{compReq}}\" disabled=\"{{busy}}\" style=\"{{btnP}}; justify-content: center; height: 42px\">Ajukan kompensasi</button>\n          </sc-if>\n        </div></sc-if>\n\n        <div style=\"font-size: 13px; font-weight: 800\">Riwayat</div>\n        <div style=\"background: #F6F7F9; border-radius: 12px; padding: 10px 12px; display: flex; flex-direction: column; gap: 8px; max-height: 260px; overflow-y: auto\">\n          <sc-for list=\"{{msgs}}\" as=\"m\"><div style=\"font-size: 12px; line-height: 17px\"><b>{{m.who}}</b> <span style=\"color: #6B7486\">{{m.at}}</span><div>{{m.body}}</div></div></sc-for>\n          <sc-if value=\"{{noMsg}}\"><div style=\"font-size: 12px; color: #6B7486\">Belum ada riwayat.</div></sc-if>\n        </div>\n        <sc-if value=\"{{t.canNote}}\"><div style=\"display: grid; grid-template-columns: 1fr auto; gap: 8px\"><input type=\"text\" placeholder=\"Tulis catatan / perkembangan\" value=\"{{note}}\" onInput=\"{{setNote}}\" style=\"{{inp}}\"><button type=\"button\" onClick=\"{{addNote}}\" disabled=\"{{busy}}\" style=\"{{btnO}}; height: 44px\">Simpan</button></div></sc-if>\n\n        <sc-if value=\"{{t.canFb}}\"><div style=\"background: #FFF6E0; border-radius: 12px; padding: 12px; display: flex; flex-direction: column; gap: 8px\">\n          <div style=\"font-size: 13px; line-height: 19px; color: #5C3600\"><b>Semua tugas selesai. Tanyakan ke pelanggan:</b> apakah sudah puas? Tiket ditutup kalau nilainya 4–5. Kalau 1–3, tiket dibuka lagi dan tugas dikirim ulang.</div>\n          <sc-if value=\"{{t.waSurvey}}\"><a href=\"{{t.waSurvey}}\" target=\"_blank\" rel=\"noopener\" style=\"{{btnO}}; align-self: flex-start\">Tanya kepuasan via WA</a></sc-if>\n          <div style=\"display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px\"><sc-for list=\"{{scores}}\" as=\"c\"><button type=\"button\" onClick=\"{{c.pick}}\" style=\"{{c.style}}\">{{c.label}}</button></sc-for></div>\n          <input type=\"text\" placeholder=\"Komentar pelanggan (opsional)\" value=\"{{fbNote}}\" onInput=\"{{setFbNote}}\" style=\"{{inp}}\">\n          <button type=\"button\" onClick=\"{{feedback}}\" disabled=\"{{busy}}\" style=\"height: 46px; border-radius: 12px; border: none; background: #1F2B4D; color: #FFFFFF; font: 800 14px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">Catat jawaban pelanggan</button>\n        </div></sc-if>\n        <sc-if value=\"{{t.closedText}}\"><div style=\"background: #E4F2EA; border-radius: 12px; padding: 12px; font-size: 13px; color: #1E6B45; font-weight: 700\">{{t.closedText}}</div></sc-if>\n      </div></sc-if>\n    </div>\n    </sc-for>\n    <div style=\"font-size: 12px; line-height: 17px; color: #4A5468; padding-bottom: 8px\">Alur: keluhan masuk → tugas otomatis ke divisi sesuai jenis keluhan → divisi mengerjakan atau mengoper → semua tugas selesai → CS tanya kepuasan pelanggan → tiket ditutup bila puas (4–5). Lewat batas waktu: naik ke Manajer Operasional, lalu CEO.</div>\n  </section>\n</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{\"$preview\":{\"width\":390,\"height\":1400}}'>\nconst DIVS = [['teknisi', 'Teknisi'], ['runner', 'Runner'], ['kasir', 'Kasir'], ['cs', 'CS'], ['keuangan', 'Keuangan'], ['housekeeping', 'Housekeeping'], ['jeep', 'Jeep'], ['manajer_ops', 'Manajer Ops']];\nconst DLABEL = { teknisi: 'Teknisi', runner: 'Runner', kasir: 'Kasir', cs: 'CS', keuangan: 'Keuangan', housekeeping: 'Housekeeping', jeep: 'Koordinator Jeep', manajer_ops: 'Manajer Ops', admin: 'Admin sistem', ceo: 'CEO' };\nconst CATS = [['Unit bermasalah', 'teknisi'], ['Pengantaran', 'runner'], ['Pembayaran', 'kasir'], ['Kebersihan kamar', 'housekeeping'], ['Sopir / jeep', 'jeep'], ['Pelayanan', 'manajer_ops'], ['Kecelakaan / kehilangan', 'manajer_ops'], ['Lainnya', 'cs']];\nconst PRIO = { urgent: 'Darurat', high: 'Tinggi', normal: 'Normal', low: 'Rendah' };\nclass Component extends DCLogic {\nstate = { tab: null, rows: null, tk: {}, mine: [], sel: null, tasks: null, msgs: [], newOpen: false, nf: { code: '', name: '', phone: '', cat: 'Unit bermasalah', prio: 'normal', summary: '' }, form: null, fm: { note: '', div: '', keep: false }, af: { div: '', note: '' }, cf: { kind: '', amount: '', note: '' }, note: '', score: 0, fbNote: '' };\nisCs() { return RA.can('mgmt.complaints') || RA.can('pos.bookings'); }\nasync componentDidMount() {\n  await RA.staff();\n  if (!RA_ALIVE(this)) return;\n  this.setState({ tab: this.isCs() ? 'aksi' : 'saya' });\n  this.stop = RA.poll(this, () => this.reload(), 60000);\n  if (this.params && this.params.new) this.setState({ newOpen: true });\n}\ncomponentWillUnmount() { if (this.stop) this.stop(); }\nasync reload() {\n  const [{ data }, mine] = await Promise.all([\n    RA.from('tickets').select('*,customers(name,phone),bookings(code)').order('created_at', { ascending: false }).limit(300),\n    RA.call('tk_list', { p_ticket: null }).catch(() => [])\n  ]);\n  const rows = data || [], ids = rows.filter(r => r.status !== 'closed').map(r => r.id).slice(0, 200);\n  const tk = {};\n  if (ids.length) { const r = await RA.from('ticket_tasks').select('ticket_id,division,status,esc_level').in('ticket_id', ids); (r.data || []).forEach(x => { (tk[x.ticket_id] = tk[x.ticket_id] || []).push(x); }); }\n  if (!RA_ALIVE(this)) return;\n  this.setState({ rows, tk, mine: mine || [] });\n  const want = this.params && this.params.id;\n  if (want && !this._opened) { this._opened = true; const t = rows.find(x => x.id === want); if (t) { if ((mine || []).some(m => m.ticket_id === t.id)) this.setState({ tab: 'saya' }); else if (this.isCs()) { const late = (t.sla_due_at && new Date(t.sla_due_at) < new Date()) || (tk[t.id] || []).some(x => (x.status === 'open' || x.status === 'doing') && x.esc_level > 0); this.setState({ tab: t.status === 'closed' ? 'selesai' : t.status === 'resolved' ? 'puas' : t.status === 'open' || late ? 'aksi' : 'proses' }); } await this.pick(t, true); } }\n  else if (this.state.sel) this.loadDetail(this.state.sel);\n}\nasync loadDetail(id) {\n  const [tasks, m] = await Promise.all([RA.call('tk_list', { p_ticket: id }).catch(() => []), RA.from('ticket_messages').select('author,body,at').eq('ticket_id', id).order('at')]);\n  if (RA_ALIVE(this) && this.state.sel === id) this.setState({ tasks: tasks || [], msgs: m.data || [] });\n}\nasync pick(t, force) {\n  if (this.state.sel === t.id && !force) { this.setState({ sel: null }); return; }\n  this.setState({ sel: t.id, tasks: null, msgs: [], note: '', score: 0, fbNote: '', form: null, af: { div: '', note: '' }, cf: { kind: '', amount: '', note: '' } });\n  await this.loadDetail(t.id);\n}\ncur() { return (this.state.rows || []).find(x => x.id === this.state.sel); }\nasync after(msg) { RA.ok(msg); this.setState({ form: null, fm: { note: '', div: '', keep: false }, note: '' }); await this.reload(); }\nasync create() {\n  const f = this.state.nf;\n  const r = await RA.fn('kasir', { action: 'ticket_new', booking_code: f.code.trim() || null, customer_name: f.name.trim() || null, customer_phone: f.phone.trim() || null, category: f.cat, priority: f.prio, summary: f.summary });\n  const div = (CATS.find(c => c[0] === f.cat) || [])[1] || 'cs';\n  this.setState({ newOpen: false, nf: { code: '', name: '', phone: '', cat: 'Unit bermasalah', prio: 'normal', summary: '' }, tab: 'aksi' });\n  await this.reload(); const t = (this.state.rows || []).find(x => x.id === r.id); if (t) await this.pick(t, true);\n  RA.ok('Tiket ' + r.code + ' dibuat. Tugas otomatis ke ' + DLABEL[div] + '.');\n}\nasync start(k) { await RA.call('tk_start', { p_task: k.id }); await this.after('Tugas diambil. Batas selesai tetap berjalan.'); }\nasync approve(k) { await RA.call('tk_comp_decide', { p_task: k.id, p_ok: true, p_note: '' }); await this.after('Kompensasi disetujui'); }\nasync submitForm() {\n  const f = this.state.form, m = this.state.fm; if (!f) return;\n  if (f.mode === 'done') { await RA.call('tk_done', { p_task: f.id, p_note: m.note }); await this.after('Tugas selesai'); }\n  else if (f.mode === 'oper') { if (!m.div) throw new Error('Pilih divisi tujuan.'); await RA.call('tk_handoff', { p_task: f.id, p_div: m.div, p_reason: m.note, p_keep: !!m.keep }); await this.after('Dioper ke ' + DLABEL[m.div]); }\n  else if (f.mode === 'reject') { await RA.call('tk_comp_decide', { p_task: f.id, p_ok: false, p_note: m.note }); await this.after('Kompensasi ditolak'); }\n  else if (f.mode === 'cancel') { await RA.call('tk_cancel', { p_task: f.id, p_reason: m.note }); await this.after('Tugas dibatalkan'); }\n}\nasync addTask() { const t = this.cur(), a = this.state.af; await RA.call('tk_add_task', { p_ticket: t.id, p_div: a.div, p_reason: a.note }); this.setState({ af: { div: '', note: '' } }); await this.after('Tugas dikirim ke ' + DLABEL[a.div]); }\nasync compReq() {\n  const t = this.cur(), c = this.state.cf;\n  const r = await RA.call('tk_comp_request', { p_ticket: t.id, p_kind: c.kind, p_amount: c.kind === 'free_day' ? null : Number(c.amount) || 0, p_note: c.note });\n  this.setState({ cf: { kind: '', amount: '', note: '' } }); await this.after('Kompensasi diajukan ke ' + DLABEL[r.division]);\n}\nasync addNote() {\n  const t = this.cur(), b = String(this.state.note || '').trim(); if (b.length < 2) throw new Error('Tulis catatannya.');\n  const me = RA.me() || {}, st = RA._staff || {};\n  const { error } = await RA.from('ticket_messages').insert({ ticket_id: t.id, author: st.name || 'Staf', by_user: me.id, body: b.slice(0, 1000) });\n  if (error) throw new Error(error.message);\n  await this.after('Catatan tersimpan');\n}\nasync feedback() {\n  const t = this.cur(); if (!this.state.score) throw new Error('Pilih nilai 1–5 dari pelanggan.');\n  const r = await RA.fn('kasir', { action: 'ticket_feedback', ticket_id: t.id, score: this.state.score, note: this.state.fbNote });\n  await this.after(r.closed ? 'Pelanggan puas, tiket ditutup' : 'Belum puas: tiket dibuka lagi dan tugas dikirim ulang');\n}\nrenderVals() {\nconst s = this.state, now = new Date(), me = (RA.me() || {}).id, cs = this.isCs();\nconst chip = (bg, fg) => 'display: inline-flex; align-items: center; height: 22px; padding: 0 8px; border-radius: 11px; font-size: 11px; font-weight: 800; white-space: nowrap; background: ' + bg + '; color: ' + fg;\nconst pill = (on, red) => 'height: 36px; padding: 0 12px; border-radius: 18px; border: 1px solid ' + (on ? (red ? '#A12A1F' : '#1F2B4D') : '#D5D9E0') + '; background: ' + (on ? (red ? '#A12A1F' : '#1F2B4D') : '#FFFFFF') + '; color: ' + (on ? '#FFFFFF' : '#1F2B4D') + '; font: 700 12px \\'Plus Jakarta Sans\\', sans-serif; cursor: pointer; white-space: nowrap; flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center';\nconst rows = s.rows || [];\nconst dur = m => { m = Math.abs(Math.round(m)); return m < 60 ? m + ' mnt' : m < 2880 ? Math.round(m / 60) + ' jam' : Math.round(m / 1440) + ' hari'; };\nconst tasksOf = t => s.tk[t.id] || [];\nconst openT = t => tasksOf(t).filter(x => x.status