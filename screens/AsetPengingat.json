{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Pengingat kendaraan</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0}\n.cp-card{background:#FFFFFF;border-radius:20px;box-shadow:0 2px 12px rgba(31,43,77,.06);padding:16px;display:flex;flex-direction:column;gap:12px}\n.cp-in{height:50px;box-sizing:border-box;border:2px solid #CDEFEA;border-radius:14px;padding:0 14px;font:700 16px 'Plus Jakarta Sans',sans-serif;color:#1F2B4D;background:#FFFFFF;width:100%}\n.cp-btn{height:50px;border:0;border-radius:14px;background:linear-gradient(135deg,#12B5A6,#077A70);color:#FFFFFF;font:800 15px 'Plus Jakarta Sans',sans-serif;cursor:pointer;display:flex;align-items:center;justify-content:center;text-decoration:none;width:100%}\n.cp-btn2{height:46px;border:1.5px solid #E3E7ED;border-radius:14px;background:#FFFFFF;color:#1F2B4D;font:800 14px 'Plus Jakarta Sans',sans-serif;cursor:pointer;display:flex;align-items:center;justify-content:center;text-decoration:none}\n.cp-st{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}\n.cp-st div{background:#F6F7F9;border-radius:14px;padding:10px 12px}\n.cp-st b{display:block;font-size:20px;line-height:26px}\n.cp-st span{font-size:12px;color:#4A5468}\n.cp-kv{display:flex;justify-content:space-between;gap:10px;font-size:13.5px;padding:9px 0;border-bottom:1px solid #EEF0F3}\n.cp-kv:last-child{border-bottom:0}.cp-kv span{color:#5B6577}.cp-kv b{text-align:right}\n.cp-rad{display:flex;align-items:center;gap:10px;min-height:48px;border:1.5px solid #E3E7ED;border-radius:14px;padding:0 14px;font:700 14px 'Plus Jakarta Sans',sans-serif;color:#1F2B4D;background:#FFFFFF;cursor:pointer;text-align:left;width:100%}\n.cp-rad i{width:18px;height:18px;border-radius:50%;border:2px solid #B4BCC8;flex:none;box-sizing:border-box}\n.cp-rad.on{border-color:#077A70;background:#F2FBFA}.cp-rad.on i{border:6px solid #077A70}\n</style>\n</helmet>\n<div style=\"min-height: 100vh; box-sizing: border-box; background: #F4F6F9; color: #1F2B4D; font-family: 'Plus Jakarta Sans', system-ui, sans-serif\">\n <main style=\"max-width: 760px; margin: 0 auto; padding: 18px 16px 28px; display: flex; flex-direction: column; gap: 14px\">\n  <div><div style=\"font-size: 13px; font-weight: 700; color: #5B6577\">{{scope}}</div><h1 style=\"margin: 2px 0 0; font-size: 26px; line-height: 32px\">Pengingat kendaraan</h1>\n   <div style=\"font-size: 13px; color: #4A5468; margin-top: 4px\">Servis, oli, pajak, dan GPS semua motor &amp; mobil. Yang lewat atau mendekati jatuh tempo muncul di sini.</div></div>\n  <div style=\"display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px\">\n   <div style=\"background: #FFFFFF; border-radius: 18px; padding: 14px; border: 1.5px solid #F6C9C4\"><div style=\"font-size: 13px; font-weight: 700\">Lewat</div><b style=\"font-size: 28px; color: #C0392B\">{{k.lewat}}</b></div>\n   <div style=\"background: #FFFFFF; border-radius: 18px; padding: 14px\"><div style=\"font-size: 13px; font-weight: 700\">≤ 14 hari</div><b style=\"font-size: 28px; color: #9A5B00\">{{k.dekat}}</b></div>\n   <div style=\"background: #FFFFFF; border-radius: 18px; padding: 14px\"><div style=\"font-size: 13px; font-weight: 700\">Aman</div><b style=\"font-size: 28px\">{{k.aman}}</b></div>\n  </div>\n  <sc-if value=\"{{gap}}\"><div style=\"background: #FFF6E5; color: #7A4B00; border-radius: 14px; padding: 12px 14px; font-size: 13.5px; line-height: 19px; font-weight: 700\">{{gap}}</div></sc-if>\n  <div style=\"display: flex; gap: 6px; overflow-x: auto\"><sc-for list=\"{{tabs}}\" as=\"t\"><button type=\"button\" onClick=\"{{t.pick}}\" style=\"{{t.style}}\">{{t.label}}</button></sc-for></div>\n  <section class=\"cp-card\" style=\"padding: 4px 16px\">\n   <sc-if value=\"{{loading}}\"><div style=\"padding: 16px 0; text-align: center; color: #4A5468\">Memuat…</div></sc-if>\n   <sc-if value=\"{{empty}}\"><div style=\"padding: 16px 0; text-align: center; color: #1E6B45; font-weight: 700\">{{empty}}</div></sc-if>\n   <sc-for list=\"{{rows}}\" as=\"r\"><a href=\"{{r.href}}\" style=\"display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 13px 0; border-bottom: 1px solid #EEF0F3; text-decoration: none; color: #1F2B4D\">\n    <span style=\"min-width: 0\"><b style=\"display: block; font-size: 15px\">{{r.label}}</b><span style=\"font-size: 13px; color: #4A5468\">{{r.sub}}</span></span>\n    <span style=\"{{r.chip}}\">{{r.tag}}</span></a></sc-for>\n  </section>\n  <section class=\"cp-card\" style=\"gap: 8px\"><div style=\"display: flex; justify-content: space-between; align-items: baseline\"><b style=\"font-size: 16px\">Data kendaraan</b><span style=\"font-size: 12px; color: #6B7486\">ketuk untuk isi GPS, km, pajak</span></div>\n   <input class=\"cp-in\" style=\"border-color: #E3E7ED; height: 44px; font-size: 14px\" type=\"search\" placeholder=\"Cari plat / kode unit\" value=\"{{vq}}\" onInput=\"{{setVq}}\">\n   <sc-for list=\"{{vlist}}\" as=\"v\"><a href=\"{{v.href}}\" style=\"display: flex; justify-content: space-between; gap: 10px; padding: 10px 0; border-bottom: 1px solid #EEF0F3; text-decoration: none; color: #1F2B4D; font-size: 13.5px\"><span><b>{{v.label}}</b> · {{v.product}}<br><span style=\"color: #6B7486; font-size: 12.5px\">{{v.branch}}</span></span><span style=\"font-size: 12px; color: {{v.c}}; font-weight: 700; text-align: right\">{{v.miss}}</span></a></sc-for>\n  </section>\n  <a class=\"cp-btn2\" href=\"{{waHref}}\" target=\"_blank\" rel=\"noopener\">Kirim ringkasan pengingat ke WA</a>\n  <div style=\"font-size: 12px; line-height: 17px; color: #6B7486\">Jadwal servis &amp; oli mengikuti aturan di Perawatan preventif (per kategori). Pajak dan plat dari data unit. Password akun GPS tidak disimpan di aplikasi.</div>\n </main>\n</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{\"$preview\":{\"width\":390,\"height\":844}}'>\nclass Component extends DCLogic {\nstate = { r: null, tab: 'all', units: null, vq: '' };\nasync componentDidMount() { await RA.staff(); this.load(); }\nasync load() {\n  try {\n    const [r, u] = await Promise.all([RA.call('vehicle_reminders', { p_days: 14 }),\n      RA.from('units').select('id,code,asset_no,plate_or_serial,odometer_km,stnk_tax_due,branches(name),products(name,categories(slug))').is('archived_at', 'null').not('status', 'in', '(draft,inactive)').limit(2000)]);\n    if (!RA_ALIVE(this)) return;\n    this.setState({ r, units: (u.data || []).filter(x => x.products && x.products.categories && ['motor', 'mobil'].indexOf(x.products.categories.slug) > -1) });\n  } catch (e) { RA.err(e); this.setState({ r: { items: [], err: 1 } }); }\n}\nrenderVals() {\n  const s = this.state, r = s.r, now = new Date();\n  const chip = on => 'flex: none; height: 38px; padding: 0 16px; border-radius: 19px; cursor: pointer; font: 800 13.5px \\'Plus Jakarta Sans\\', sans-serif; ' + (on ? 'border: 0; background: #1F2B4D; color: #FFFFFF' : 'border: 1.5px solid #E3E7ED; background: #FFFFFF; color: #1F2B4D');\n  const tabs = [['all', 'Semua'], ['servis', 'Servis'], ['oli', 'Oli'], ['gps', 'GPS'], ['pajak', 'Pajak']].map(([k, l]) => ({ label: l, style: chip(s.tab === k), pick: () => this.setState({ tab: k }) }));\n  const items = ((r && r.items) || []).filter(i => s.tab === 'all' || i.kind === s.tab);\n  const tag = i => { if (i.what === 'GPS offline') return 'offline'; if (i.km_left != null && (i.days_left == null || i.km_left <= 0 || i.km_left / 30 < i.days_left)) return i.km_left <= 0 ? 'lewat ' + (-i.km_left).toLocaleString('id-ID') + ' km' : i.km_left.toLocaleString('id-ID') + ' km lagi'; return i.days_left <= 0 ? 'lewat ' + (-i.days_left) + ' hari' : i.days_left + ' hari lagi'; };\n  const rows = items.slice(0, 80).map(i => ({ label: i.label, sub: i.what + ' · ' + (i.product || '') + (i.branch ? ' · ' + i.branch : ''), tag: tag(i), href: 'AsetGps.dc.html?id=' + i.unit_id,\n    chip: 'flex: none; height: 28px; padding: 0 10px; border-radius: 14px; font-size: 12.5px; font-weight: 800; display: flex; align-items: center; white-space: nowrap; ' + (i.sev === 'lewat' ? 'background: #FDE8E6; color: #C0392B' : 'background: #FFF0DC; color: #9A5B00') }));\n  const U = s.units || []; const q = String(s.vq || '').toLowerCase().replace(/\\s/g, '');\n  const vlist = U.filter(u => !q || [u.code, u.asset_no, u.plate_or_serial].join('|').toLowerCase().replace(/\\s/g, '').indexOf(q) > -1).slice(0, q ? 30 : 8).map(u => { const miss = [u.odometer_km == null ? 'km' : '', !u.stnk_tax_due ? 'pajak' : ''].filter(Boolean);\n    return { label: u.plate_or_serial || u.asset_no || u.code, product: (u.products || {}).name || '', branch: (u.branches || {}).name || '—', href: 'AsetGps.dc.html?id=' + u.id, miss: miss.length ? 'belum isi ' + miss.join(', ') : 'lengkap ✓', c: miss.length ? '#B46A00' : '#1E7A3F' }; });\n  const gap = r && !r.err ? [r.no_km ? r.no_km + ' kendaraan belum ada km' : '', r.no_tax ? r.no_tax + ' belum ada tanggal pajak' : '', r.vehicles - r.gps_set ? (r.vehicles - r.gps_set) + ' belum ada data GPS' : ''].filter(Boolean) : [];\n  const lines = ((r && r.items) || []).slice(0, 15).map(i => '• ' + i.label + ' — ' + i.what + ': ' + tag(i));\n  return {\n    scope: 'Aset · semua cabang · ' + RA.HARIL[now.getDay()] + ', ' + RA.date(now), tabs, rows, loading: !r, empty: r && !rows.length ? '✓ Tidak ada yang lewat atau mendekati jatuh tempo.' : '',\n    k: { lewat: r ? String(r.lewat || 0) : '…', dekat: r ? String(r.dekat || 0) : '…', aman: r ? String(r.aman || 0) : '…' },\n    gap: gap.length ? 'Pengingat belum akurat: ' + gap.join(', ') + '. Isi lewat Data kendaraan di bawah atau Lengkapi data unit.' : '',\n    vq: s.vq, setVq: e => this.setState({ vq: e.target.value }), vlist,\n    waHref: 'https://wa.me/?text=' + encodeURIComponent('Pengingat kendaraan ' + RA.date(now) + '\\nLewat: ' + ((r && r.lewat) || 0) + ' · ≤14 hari: ' + ((r && r.dekat) || 0) + '\\n' + (lines.join('\\n') || 'Tidak ada yang jatuh tempo.'))\n  };\n}\n}\n</script>\n</body>\n</html>\n"}