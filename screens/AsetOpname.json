{"full": "<!doctype html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<title>Stok opname</title>\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0}\nbutton{font-family:inherit}\nbutton:disabled{opacity:.55;cursor:not-allowed}\n[data-aui]{min-height:100vh;box-sizing:border-box;background:#F4F6F9;color:#1F2B4D;font-family:'Plus Jakarta Sans',system-ui,sans-serif}\n[data-in]{max-width:1240px;margin:0 auto;box-sizing:border-box;padding:14px 16px 24px;display:flex;flex-direction:column;gap:12px}\n[data-card]{background:#FFFFFF;border-radius:16px;box-shadow:0 1px 3px rgba(31,43,77,.07);padding:14px;display:flex;flex-direction:column;gap:10px}\n[data-h]{font-size:15px;font-weight:800;display:flex;justify-content:space-between;align-items:center;gap:8px}\n[data-mut]{font-size:12px;color:#5B6577}\n[data-seg]{display:flex;flex-wrap:wrap;gap:6px}\n[data-seg] button{height:32px;padding:0 12px;border-radius:16px;border:1px solid #D5D9E0;background:#FFFFFF;color:#1F2B4D;font:700 12.5px 'Plus Jakarta Sans',sans-serif;cursor:pointer}\n[data-seg] button[aria-pressed=\"true\"]{background:#1F2B4D;border-color:#1F2B4D;color:#FFFFFF}\nselect,input[type=text]{height:44px;width:100%;box-sizing:border-box;border:1px solid #D5D9E0;border-radius:12px;padding:0 12px;font:500 15px 'Plus Jakarta Sans',sans-serif;color:#1F2B4D;background:#FFFFFF}\n[data-btn]{height:42px;padding:0 14px;border-radius:11px;border:0;font:800 13px 'Plus Jakarta Sans',sans-serif;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:6px;text-decoration:none;white-space:nowrap}\n[data-s4]{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}\n[data-s4] button{background:#F6F7F9;border-radius:12px;padding:10px 12px;border:2px solid transparent;text-align:left;cursor:pointer;font:inherit;color:#1F2B4D}\n[data-s4] button[aria-pressed=\"true\"]{border-color:#1F2B4D;background:#FFFFFF}\n[data-s4] b{display:block;font-size:22px;line-height:26px}\n[data-s4] span{font-size:12px;font-weight:700}\n[data-row]{display:flex;align-items:center;gap:10px;padding:10px 0;border-top:1px solid #EEF0F3}\n[data-row]:first-child{border-top:0}\n[data-pill]{display:inline-flex;align-items:center;height:22px;padding:0 9px;border-radius:11px;font-size:11.5px;font-weight:800;white-space:nowrap}\n[data-cols]{display:flex;flex-direction:column;gap:12px}\n@media (min-width:1000px){\n  [data-in]{padding:20px 24px 32px}\n  [data-cols]{display:grid;grid-template-columns:380px minmax(0,1fr);align-items:start}\n  [data-s4]{grid-template-columns:repeat(2,minmax(0,1fr))}\n}\n@media print{[data-noprint]{display:none !important}}\n</style>\n</helmet>\n<div data-aui=\"1\"><div data-in=\"1\">\n  <sc-if value=\"{{isList}}\">\n    <div><div style=\"font-size: 20px; font-weight: 800\">Stok opname</div><div data-mut=\"1\">Cocokkan unit yang tercatat dengan yang benar-benar ada di cabang</div></div>\n    <div data-cols=\"1\">\n      <div data-card=\"1\" data-noprint=\"1\">\n        <div data-h=\"1\">Mulai stok opname</div>\n        <label style=\"display: flex; flex-direction: column; gap: 5px; font-size: 12px; font-weight: 700; color: #4A5468\">Cabang<select onChange=\"{{setBr}}\"><sc-for list=\"{{brOpts}}\" as=\"o\"><option value=\"{{o.k}}\">{{o.label}}</option></sc-for></select></label>\n        <label style=\"display: flex; flex-direction: column; gap: 5px; font-size: 12px; font-weight: 700; color: #4A5468\">Kategori<select onChange=\"{{setCat}}\"><sc-for list=\"{{catOpts}}\" as=\"o\"><option value=\"{{o.k}}\">{{o.label}}</option></sc-for></select></label>\n        <button type=\"button\" data-btn=\"1\" onClick=\"{{start}}\" disabled=\"{{busy}}\" style=\"background: #09BEAF; color: #1F2B4D\">Mulai — buat daftar yang seharusnya ada</button>\n        <span data-mut=\"1\">Unit yang sedang disewa otomatis dicatat \"Sedang disewa\". Sisanya scan QR stiker atau ketik nomor aset/plat satu per satu.</span>\n      </div>\n      <div data-card=\"1\">\n        <div data-h=\"1\">Riwayat<span data-mut=\"1\">{{auditCount}}</span></div>\n        <sc-if value=\"{{loading}}\"><span data-mut=\"1\">Memuat…</span></sc-if>\n        <sc-if value=\"{{noAudit}}\"><span data-mut=\"1\" style=\"font-size: 13px\">Belum pernah stok opname. Mulai dari cabang yang paling ramai.</span></sc-if>\n        <div><sc-for list=\"{{audits}}\" as=\"a\"><button type=\"button\" data-row=\"1\" onClick=\"{{a.open}}\" style=\"width: 100%; background: none; border-left: 0; border-right: 0; border-bottom: 0; text-align: left; cursor: pointer; font: inherit; color: #1F2B4D\"><span style=\"flex: 1; min-width: 0\"><b style=\"font-size: 14px; display: block\">{{a.code}} · {{a.branch}}</b><span data-mut=\"1\">{{a.sub}}</span><div style=\"height: 6px; border-radius: 3px; background: #EEF0F3; overflow: hidden; margin-top: 6px\"><div style=\"height: 100%; width: {{a.w}}; background: {{a.bar}}\"></div></div></span><span data-pill=\"1\" style=\"background: {{a.pbg}}; color: {{a.pfg}}\">{{a.st}}</span></button></sc-for></div>\n      </div>\n    </div>\n  </sc-if>\n\n  <sc-if value=\"{{isAudit}}\">\n    <button type=\"button\" data-noprint=\"1\" onClick=\"{{back}}\" style=\"align-self: flex-start; height: 36px; padding: 0 12px; border-radius: 18px; border: 1px solid #D5D9E0; background: #FFFFFF; color: #1F2B4D; font: 800 13px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">‹ Semua stok opname</button>\n    <sc-if value=\"{{a}}\">\n      <div style=\"display: flex; justify-content: space-between; align-items: flex-end; gap: 10px; flex-wrap: wrap\"><div><div data-mut=\"1\">{{a.sub}}</div><div style=\"font-size: 20px; font-weight: 800\">{{a.title}}</div></div><span data-pill=\"1\" style=\"background: {{a.pbg}}; color: {{a.pfg}}; height: 26px\">{{a.st}}</span></div>\n      <div data-cols=\"1\">\n        <div style=\"display: flex; flex-direction: column; gap: 12px\">\n          <div data-card=\"1\">\n            <div style=\"display: flex; justify-content: space-between; font-size: 13px; font-weight: 800\"><span>{{a.progTxt}}</span><span>{{a.pct}}</span></div>\n            <div style=\"height: 10px; border-radius: 5px; background: #EEF0F3; overflow: hidden\"><div style=\"height: 100%; width: {{a.pct}}; background: #09BEAF\"></div></div>\n            <div data-s4=\"1\"><sc-for list=\"{{a.stats}}\" as=\"x\"><button type=\"button\" aria-pressed=\"{{x.on}}\" onClick=\"{{x.pick}}\"><b style=\"color: {{x.c}}\">{{x.n}}</b><span>{{x.l}}</span></button></sc-for></div>\n          </div>\n          <sc-if value=\"{{a.open}}\"><div data-card=\"1\" data-noprint=\"1\">\n            <div data-h=\"1\">Scan unit</div>\n            <div style=\"display: flex; gap: 8px\"><input type=\"text\" aria-label=\"Kode unit\" placeholder=\"Nomor aset / kode / plat, lalu Enter\" value=\"{{code}}\" onInput=\"{{setCode}}\" onKeyDown=\"{{enter}}\" autocomplete=\"off\"><button type=\"button\" data-btn=\"1\" onClick=\"{{submit}}\" disabled=\"{{busy}}\" style=\"background: #1F2B4D; color: #FFFFFF\">Cek</button></div>\n            <label data-btn=\"1\" style=\"background: #09BEAF; color: #1F2B4D; cursor: pointer\">Scan QR pakai kamera<input type=\"file\" accept=\"image/*\" capture=\"environment\" onChange=\"{{camera}}\" style=\"display: none\"></label>\n            <sc-if value=\"{{last}}\"><div style=\"background: {{last.bg}}; color: {{last.fg}}; border-radius: 12px; padding: 10px 12px; font-size: 13.5px; line-height: 19px\"><b>{{last.title}}</b><br>{{last.sub}}</div></sc-if>\n            <span data-mut=\"1\">Pakai pemindai QR (USB/Bluetooth) juga bisa: arahkan kursor ke kotak lalu scan.</span>\n          </div></sc-if>\n          <sc-if value=\"{{a.open}}\"><button type=\"button\" data-btn=\"1\" data-noprint=\"1\" onClick=\"{{close}}\" disabled=\"{{busy}}\" style=\"background: #1F2B4D; color: #FFFFFF; height: 46px\">{{a.closeTxt}}</button></sc-if>\n          <sc-if value=\"{{a.closedNote}}\"><div data-card=\"1\" style=\"font-size: 13px; line-height: 19px\">{{a.closedNote}}</div></sc-if>\n        </div>\n        <div data-card=\"1\">\n          <div data-h=\"1\">{{a.listTitle}}<span data-mut=\"1\">{{a.listN}}</span></div>\n          <sc-if value=\"{{a.listEmpty}}\"><span data-mut=\"1\" style=\"font-size: 13px\">{{a.listEmpty}}</span></sc-if>\n          <div><sc-for list=\"{{a.items}}\" as=\"r\"><div data-row=\"1\">\n            <span style=\"flex: 1; min-width: 0\"><b style=\"font-size: 13.5px; display: block\">{{r.unit}}</b><span data-mut=\"1\">{{r.sub}}</span></span>\n            <span data-pill=\"1\" style=\"background: {{r.pbg}}; color: {{r.pfg}}\">{{r.st}}</span>\n            <sc-if value=\"{{r.ok}}\"><button type=\"button\" data-noprint=\"1\" onClick=\"{{r.ok}}\" style=\"height: 32px; padding: 0 10px; border-radius: 9px; border: 0; background: #E3F7F5; color: #077A70; font: 800 12px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">Ada</button></sc-if>\n            <sc-if value=\"{{r.miss}}\"><button type=\"button\" data-noprint=\"1\" onClick=\"{{r.miss}}\" style=\"height: 32px; padding: 0 10px; border-radius: 9px; border: 0; background: #FDECEA; color: #A12A1F; font: 800 12px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">Tidak ada</button></sc-if>\n            <sc-if value=\"{{r.undo}}\"><button type=\"button\" data-noprint=\"1\" onClick=\"{{r.undo}}\" style=\"height: 32px; padding: 0 10px; border-radius: 9px; border: 0; background: #EEF0F3; color: #1F2B4D; font: 800 12px 'Plus Jakarta Sans', sans-serif; cursor: pointer\">Ulang</button></sc-if>\n          </div></sc-for></div>\n        </div>\n      </div>\n    </sc-if>\n  </sc-if>\n</div></div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script data-props='{\"$preview\":{\"width\":390,\"height\":844}}'>\nclass Component extends DCLogic {\nstate = { id: null, l: null, d: null, br: '', cat: '', code: '', last: null, f: 'pending', busy: false };\nasync componentDidMount() { await RA.staff(); const p = RA.params(); if (p.id) { this.setState({ id: p.id }); await this.loadAudit(p.id); } await this.loadList(); }\nasync loadList() { try { const l = await RA.call('audit_view', { p_audit: null }); if (RA_ALIVE(this)) this.setState({ l, br: this.state.br || ((l.branches || [])[0] || {}).id || '' }); } catch (e) { RA.err(e); } }\nasync loadAudit(id) { try { const d = await RA.call('audit_view', { p_audit: id }); if (RA_ALIVE(this) && this.state.id === id) this.setState({ d }); } catch (e) { RA.err(e); } }\nopen(id) { this.setState({ id, d: null, last: null, f: 'pending', code: '' }); try { history.replaceState(null, '', '#/AsetOpname?id=' + id); } catch (e) {} this.loadAudit(id); }\nback() { this.setState({ id: null, d: null }); try { history.replaceState(null, '', '#/AsetOpname'); } catch (e) {} this.loadList(); }\nasync start() {\n  if (!this.state.br) { RA.toast('Pilih cabang'); return; } this.setState({ busy: true });\n  try { const id = await RA.call('audit_start', { p_branch: this.state.br, p_cat: this.state.cat || null }); this.open(id); } catch (e) { RA.err(e); }\n  this.setState({ busy: false });\n}\nasync scan(code) {\n  code = String(code || '').trim(); if (!code || this.state.busy) return; this.setState({ busy: true });\n  try { const r = await RA.call('audit_scan', { p_audit: this.state.id, p_code: code });\n    this.setState({ code: '', last: r.result === 'cocok' ? { bg: '#E3F7F5', fg: '#077A70', title: (r.again ? 'Sudah tercatat: ' : '✓ Cocok: ') + r.unit, sub: r.again ? 'Unit ini sudah dicek sebelumnya.' : 'Tercatat ada di cabang ini.' } : { bg: '#FFF4E5', fg: '#8A4B00', title: 'Tak terduga: ' + r.unit, sub: 'Tercatat di ' + (r.home || 'cabang lain') + '. Akan dilaporkan saat stok opname ditutup.' } });\n    if (navigator.vibrate) navigator.vibrate(r.result === 'cocok' ? 40 : [60, 60, 60]);\n    await this.loadAudit(this.state.id);\n  } catch (e) { this.setState({ last: { bg: '#FDECEA', fg: '#A12A1F', title: 'Tidak ditemukan', sub: (e && e.message) || 'Kode tidak dikenal' } }); }\n  this.setState({ busy: false });\n}\nasync camera(e) {\n  const f = e.target.files && e.target.files[0]; e.target.value = ''; if (!f) return;\n  if (!('BarcodeDetector' in window)) { RA.toast('Pemindai QR belum didukung di HP ini. Ketik nomor aset atau plat.'); return; }\n  try { const bmp = await createImageBitmap(f); const codes = await new window.BarcodeDetector({ formats: ['qr_code'] }).detect(bmp); const v = codes[0] && codes[0].rawValue;\n    if (!v) { RA.toast('QR tidak terbaca. Coba lagi lebih dekat atau ketik kodenya.'); return; } await this.scan(v); } catch (er) { RA.err(er); }\n}\nasync mark(u, res) { try { await RA.call('audit_mark', { p_audit: this.state.id, p_unit: u, p_result: res }); await this.loadAudit(this.state.id); } catch (e) { RA.err(e); } }\nasync close() {\n  const d = this.state.d; const it = d.items || []; const pend = it.filter(i => !i.result).length, ex = it.filter(i => i.result === 'tak_terduga').length, ms = it.filter(i => i.result === 'hilang').length;\n  if (!confirm('Tutup stok opname?\\n\\n' + (pend ? pend + ' unit belum dicek akan dicatat TIDAK ADA.\\n' : '') + (pend + ms) + ' unit tidak ada dan ' + ex + ' unit tak terduga dikirim ke owner untuk diputuskan.')) return;\n  this.setState({ busy: true });\n  try { const r = await RA.call('audit_close', { p_audit: this.state.id, p_note: null }); RA.ok('Ditutup: ' + r.hilang + ' tidak ada, ' + r.tak_terduga + ' tak terduga — dikirim ke Persetujuan'); await this.loadAudit(this.state.id); } catch (e) { RA.err(e); }\n  this.setState({ busy: false });\n}\nrenderVals() {\nconst s = this.state, NAVY = '#1F2B4D', RED = '#A12A1F', AMB = '#8A4B00', TEAL = '#077A70';\nconst RES = { cocok: ['Cocok', '#E3F7F5', TEAL], hilang: ['Tidak ada', '#FDECEA', RED], tak_terduga: ['Tak terduga', '#FFF4E5', AMB], disewa: ['Sedang disewa', '#EEF0F3', NAVY] };\nconst first = (arr, k) => arr.filter(o => o.k === k).concat(arr.filter(o => o.k !== k));\nconst l = s.l || {}; const brOpts = first((l.branches || []).map(b => ({ k: b.id, label: b.n })), s.br), catOpts = first([{ k: '', label: 'Semua kategori' }].concat((l.cats || []).map(c => ({ k: c.slug, label: c.n }))), s.cat);\nconst CN = {}; (l.cats || []).forEach(c => { CN[c.slug] = c.n; });\nconst o = { isList: !s.id, isAudit: !!s.id, busy: !!s.busy, brOpts, catOpts, setBr: e => this.setState({ br: e.target.value }), setCat: e => this.setState({ cat: e.target.value }), start: () => this.start(), back: () => this.back(),\n  loading: !s.l, noAudit: s.l && !(l.audits || []).length, auditCount: s.l ? (l.audits || []).length + ' kali' : '',\n  audits: (l.audits || []).map(a => { const done = a.n ? Math.round(100 * (a.n - a.pending) / a.n) : 0, op = a.status === 'open';\n    return { code: a.code, branch: a.branch, sub: (a.cat ? (CN[a.cat] || a.cat) : 'Semua kategori') + ' · ' + RA.date(a.at) + ' · ' + (op ? done + '% dicek' : a.ok + ' cocok, ' + a.miss + ' tidak ada, ' + a.extra + ' tak terduga'), w: (op ? done : 100) + '%', bar: !op && (a.miss || a.extra) ? '#E5534B' : '#09BEAF', st: op ? 'Berjalan' : 'Selesai', pbg: op ? '#FFF4E5' : '#E3F7F5', pfg: op ? AMB : TEAL, open: () => this.open(a.id) }; }),\n  code: s.code, setCode: e => this.setState({ code: e.target.value }), enter: e => { if (e.key === 'Enter') { e.preventDefault && e.preventDefault(); this.scan(s.code); } }, submit: () => this.scan(s.code), camera: e => this.camera(e), close: () => this.close(), last: s.last, a: null };\nif (s.id && s.d && s.d.audit) {\n  const au = s.d.audit, it = s.d.items || [], op = au.status === 'open';\n  const exp = it.filter(i => i.expected), cnt = k => it.filter(i => (k === 'pending' ? !i.result : i.result === k)).length;\n  const checked = exp.filter(i => i.result).length, pct = exp.length ? Math.round(100 * checked / exp.length) : 0;\n  const F = [['pending', 'Belum dicek', op ? NAVY : RED], ['cocok', 'Cocok', TEAL], ['hilang', 'Tidak ada', RED], ['tak_terduga', 'Tak terduga', AMB], ['disewa', 'Sedang disewa', NAVY]];\n  const f = s.f; const list = it.filter(i => f === 'all' ? true : f === 'pending' ? !i.result : i.result === f);\n  o.a = { title: au.code + ' · ' + au.branch, sub: (au.cat ? (CN[au.cat] || au.cat) : 'Semua kategori') + ' · mulai ' + RA.dayTime(au.at), open: op, st: op ? 'Berjalan' : 'Selesai', pbg: op ? '#FFF4E5' : '#E3F7F5', pfg: op ? AMB : TEAL,\n    pct: pct + '%', progTxt: checked + ' dari ' + exp.length + ' unit sudah dicek',\n    stats: F.slice(0, 4).map(([k, lb, c]) => ({ n: String(cnt(k)), l: lb, c, on: f === k ? 'true' : 'false', pick: () => this.setState({ f: k }) })),\n    closeTxt: 'Tutup & laporkan selisih' + (cnt('pending') ? ' (' + cnt('pending') + ' belum dicek)' : ''),\n    closedNote: op ? '' : 'Ditutup ' + RA.dayTime(au.closed_at) + '. ' + cnt('hilang') + ' unit tidak ada dan ' + cnt('tak_terduga') + ' unit tak terduga sudah dikirim ke Persetujuan owner. ' + cnt('disewa') + ' unit sedang disewa saat opname.',\n    listTitle: (F.find(x => x[0] === f) || ['', 'Semua'])[1], listN: list.length + ' unit', listEmpty: list.length ? '' : (f === 'pending' ? '✓ Semua unit sudah dicek.' : 'Kosong.'),\n    items: list.slice(0, 300).map(i => { const R = RES[i.result] || ['Belum dicek', '#EEF0F3', '#5B6577'];\n      return { unit: i.unit, sub: [i.asset_no, i.plate, i.result === 'tak_terduga' ? 'tercatat di ' + i.home : '', i.at ? RA.dayTime(i.at) + (i.by ? ' · ' + i.by : '') : ''].filter(Boolean).join(' · '), st: R[0], pbg: R[1], pfg: R[2],\n        ok: op && !i.result ? () => this.mark(i.unit_id, 'cocok') : null, miss: op && !i.result ? () => this.mark(i.unit_id, 'hilang') : null, undo: op && i.expected && i.result && i.result !== 'disewa' ? () => this.mark(i.unit_id, null) : null }; }) };\n  o.a.stats.push({ n: String(cnt('disewa')), l: 'Sedang disewa', c: NAVY, on: f === 'disewa' ? 'true' : 'false', pick: () => this.setState({ f: 'disewa' }) });\n  o.a.stats.push({ n: String(it.length), l: 'Semua', c: NAVY, on: f === 'all' ? 'true' : 'false', pick: () => this.setState({ f: 'all' }) });\n}\nreturn o;\n}\n}\n</script>\n</body>\n</html>\n"}