<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE properties SYSTEM 'http://java.sun.com/dtd/properties.dtd'>
<properties>
    <entry key='database.driver'>org.h2.Driver</entry>
    <entry key='database.url'>jdbc:h2:./data/database</entry>
    <entry key='database.user'>sa</entry>
    <entry key='database.password'></entry>

    <!-- Hanya buka protokol yang dipakai -->
    <entry key='protocols.enable'>gt06,huabao,h02</entry>

    <!-- Alat yang belum terdaftar ikut diterima, supaya cukup kirim SMS lalu data langsung masuk -->
    <entry key='database.registerUnknown'>true</entry>

    <!-- Kirim setiap posisi ke Rentalaja (edge function gps-ingest) -->
    <entry key='forward.enable'>true</entry>
    <entry key='forward.type'>json</entry>
    <entry key='forward.url'>https://shrvzlltysnbmgpkhjjg.supabase.co/functions/v1/gps-ingest</entry>
    <!-- Ganti TOKEN dengan token dari aplikasi: Pengingat kendaraan → Sambungkan GPS live → Tampilkan URL & token -->
    <entry key='forward.header'>Authorization: Bearer TOKEN</entry>
    <entry key='forward.retry.enable'>true</entry>
    <entry key='forward.retry.limit'>1000</entry>

    <!-- Hitung km total per alat (dipakai odometer & km per sewa) -->
    <entry key='filter.enable'>true</entry>
    <entry key='filter.invalid'>true</entry>
    <entry key='filter.zero'>true</entry>
    <entry key='filter.duplicate'>true</entry>

    <!-- Simpan riwayat 60 hari di server Traccar -->
    <entry key='database.historyDays'>60</entry>
</properties>
